@inject ApiClient Api
@inject ImprimanteTickets Tickets
@inject SessionPoste Session
@inject HistoriqueNavigation Historique

@* Le patient rembourse tout ou partie de sa dette : l'argent entre dans la caisse ouverte du poste *@
@* EnLigne : partie de la Caisse (colonne d'actions à gauche), sans voile ni « Fermer » ; sinon fenêtre par-dessus l'écran *@
<div class="@(EnLigne ? "partie-caisse" : "voile")" role="@(EnLigne ? null : "dialog")" aria-modal="@(EnLigne ? null : "true")" aria-labelledby="t-credit">
    <section class="panneau @(EnLigne ? "partie-caisse-panneau" : "fenetre-annulation")">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px">
            <h2 id="t-credit">Encaisser une dette</h2>
            @if (!EnLigne) { <button type="button" class="btn" @onclick="OnFerme">Fermer</button> }
        </div>

        @if (recu is { } r)
        {
            <div class="succes" role="status">
                Reçu n° @r.Numero : @Libelles.Dinars(r.Montant, 2) encaissés (@Libelles.ModePaiement(r.Mode)) de @r.Patient.
                Reste dû : @Libelles.Dinars(r.ResteDu, 2).
            </div>
            @if (messageImpression is not null) { <div class="@(impressionOk ? "info-bandeau" : "erreur")" role="status">@messageImpression</div> }
            <div class="filtres">
                <button type="button" class="btn" disabled="@enCours" @onclick="ImprimerAsync">Imprimer le reçu</button>
                <button type="button" class="btn btn-principal" @onclick="OnFerme">Terminer</button>
            </div>
        }
        else if (situation is not { } s)
        {
            <div class="champ">
                <label for="c-recherche">Patient (nom ou téléphone)</label>
                <input id="c-recherche" type="search" placeholder="Tous les patients qui ont un crédit" @bind="recherche" @bind:event="oninput" @bind:after="RechercherApresSaisieAsync" />
            </div>
            @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
            @if (patients.Count == 0 && charge)
            {
                <p class="vide" style="margin: 0">Aucun patient avec un crédit en cours.</p>
            }
            @* Patients en crédit : par page, filtrés par le serveur (règle des listes) ; la liste défile dans son cadre *@
            <div class="liste-ventes cadre-defilant">
                @foreach (var p in patients)
                {
                    <button type="button" class="ligne-vente" @onclick="() => ChoisirAsync(p.Id)">
                        <span><strong>@p.Nom</strong>@(p.Telephone is { } t ? $" · {t}" : "")<br /><span class="detail">@(p.DerniereVente is { } d ? $"dernier crédit le {Libelles.DateHeureLocale(d)}" : p.Regularisation is { } rg ? $"Régularisation Chifa ({rg})" : "crédit repris de l’ancien logiciel")</span></span>
                        <span class="montant-du">@Libelles.Dinars(p.Solde, 2)</span>
                    </button>
                }
            </div>
            <Pagination Total="totalPatients" Numero="pagePatients" Taille="taillePatients" Libelle="Pages des patients en crédit" OnChange="p => ChargerPatientsAsync(p.Numero, p.Taille)" />
        }
        else
        {
            @* Situation du patient dans un cadre défilant (2026-11-15) : relevé déplié, ventes et correction défilent ici, la page reste à 0
               et le montant, le mode et « Encaisser » restent visibles dessous *@
            @* cadre-unique : seul ce bloc défile, ses tableaux n'ont pas de hauteur propre (pas de barres imbriquées) *@
            <div class="carte cadre-defilant cadre-unique">
                <strong><LienContact Type="patient" Id="s.Patient.Id" Nom="@s.Patient.Nom" /></strong>@(s.Patient.Telephone is { } t ? $" · {t}" : "")
                · doit <strong class="montant-du">@Libelles.Dinars(s.Patient.Solde, 2)</strong>@(s.Patient.Plafond > 0 ? $" (plafond {Libelles.Dinars(s.Patient.Plafond)})" : "")
                <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => situation = null">Changer de patient</button>
                @if (s.DetteReprise > 0)
                {
                    <p class="detail" style="margin: 8px 0 0">Dette d’avant les ventes à crédit du logiciel : @Libelles.Dinars(s.DetteReprise, 2) à l’origine, soldée en premier par les règlements.</p>
                }
                @if (s.Ventes.Count > 0)
                {
                    @* Le patient peut solder toute une facture (2026-11-15) : la case coche ou décoche toutes ses ventes encore dues *@
                    @if (FacturesDues.Count > 0)
                    {
                        <div class="filtres" style="margin-top: 8px">
                            @foreach (var f in FacturesDues)
                            {
                                <label style="display: inline-flex; align-items: center; gap: 4px">
                                    <input type="checkbox" checked="@FactureCochee(f)" @onchange="e => CocherFacture(f, e.Value is true)" />
                                    toute la facture @f
                                </label>
                            }
                        </div>
                    }
                    <div class="tableau-cadre" style="margin-top: 8px">
                        <table class="tableau" style="min-width: 0">
                            <thead><tr><th scope="col">Solder</th><th scope="col">Vente à crédit</th><th scope="col">Montant</th><th scope="col">Réglé</th><th scope="col">Reste dû</th></tr></thead>
                            <tbody>
                                @foreach (var v in s.Ventes)
                                {
                                    <tr>
                                        <td>@if (v.Reste > 0 && v.Id > 0) { <input type="checkbox" aria-label="@($"Solder la vente {v.Numero}")" checked="@cochees.Contains(v.Id)" @onchange="e => Cocher(v.Id, e.Value is true)" /> }</td>
                                        <td class="nom">@v.Numero@if (v.Facture is { } fac) { <span class="detail"> · facture @fac</span> }@if (v.Remise is { } rv) { <span class="detail"> · @rv</span> }<br /><span class="detail">@Libelles.DateHeureLocale(v.Date)</span></td>
                                        <td>@Libelles.Dinars(v.Montant, 2)</td>
                                        <td>@Libelles.Dinars(v.Regle, 2)</td>
                                        <td>@if (v.Reste > 0) { <strong class="montant-du">@Libelles.Dinars(v.Reste, 2)</strong> } else { <span class="pastille ok">Soldée</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="detail" style="margin: 4px 0 0">Le montant réglé solde les ventes cochées (par défaut les plus anciennes jusqu’au montant ; le patient peut en choisir d’autres). Sans vente cochée, ou au-delà de leur reste, la dette la plus ancienne est soldée d’abord.</p>
                }
                @if (releveTotal > 0)
                {
                    <details style="margin-top: 8px">
                        <summary>Relevé de la dette (@releveTotal mouvement(s))</summary>
                        <div class="filtres-liste" role="search" aria-label="Filtrer le relevé" style="margin-top: 8px">
                            <div class="champ" style="flex: 1 1 220px"><label for="rp-patient">Patient (nom ou téléphone)</label>
                                <input id="rp-patient" type="search" placeholder="@s.Patient.Nom" @bind="recherchePatientReleve" @bind:event="oninput" @bind:after="ChercherPatientReleveAsync" />
                            </div>
                            <div class="champ" style="flex: 0 0 230px"><label for="rp-type">Mouvement</label>
                                <select id="rp-type" @bind="releveType" @bind:after="FiltrerReleveAsync">
                                    <option value="">Tous</option>
                                    @foreach (var (valeur, libelle) in TypesMouvement) { <option value="@valeur">@libelle</option> }
                                </select>
                            </div>
                            <div class="champ" style="flex: 0 0 160px"><label for="rp-type-du">Du</label><input id="rp-type-du" type="date" @bind="releveDu" @bind:after="FiltrerReleveAsync" /></div>
                            <div class="champ" style="flex: 0 0 160px"><label for="rp-type-au">Au</label><input id="rp-type-au" type="date" @bind="releveAu" @bind:after="FiltrerReleveAsync" /></div>
                            @if (FiltreReleveActif) { <button type="button" class="btn" @onclick="EffacerFiltresReleveAsync">Tout afficher</button> }
                        </div>
                        @if (patientsReleve.Count > 0)
                        {
                            <div class="liste-ventes" style="margin-top: 8px">
                                @foreach (var p in patientsReleve)
                                {
                                    <button type="button" class="ligne-vente" @onclick="() => ChangerPatientReleveAsync(p.Id)">
                                        <span><strong>@p.Nom</strong>@(p.Telephone is { } tel ? $" · {tel}" : "")</span>
                                        <span class="@(p.Solde > 0 ? "montant-du" : null)">@Libelles.Dinars(p.Solde, 2)</span>
                                    </button>
                                }
                            </div>
                        }
                        else if (patientCherche)
                        {
                            <p class="detail" style="margin: 8px 0 0">Aucun patient avec un relevé pour cette recherche.</p>
                        }
                        <div class="tableau-cadre" style="margin-top: 8px">
                            <table class="tableau" style="min-width: 0">
                                <thead><tr><th scope="col">Date</th><th scope="col">Mouvement</th><th scope="col">Montant</th><th scope="col">Dette après</th><th scope="col">Par</th></tr></thead>
                                <tbody>
                                    @foreach (var m in mouvements)
                                    {
                                        <tr>
                                            <td>@Libelles.DateHeureLocale(m.Date)</td>
                                            @if (RegularisationChifa(m) is { } regul)
                                            {
                                                <td>@regul</td>
                                            }
                                            else
                                            {
                                                <td>@LibelleMouvement(m.Type, m.Employe)@if (m.Vente is { } ticket) { <span class="detail"> · @ticket</span> }@if (m.Remise is { } rm) { <span class="detail"> · @rm</span> }@if (m.Reference is { } reference && reference != LibelleMouvement(m.Type, m.Employe)) { <br /><span class="detail">@Libelles.ReferenceReleve(reference)</span> }</td>
                                            }
                                            <td class="@(m.Montant > 0 ? "texte-urgent" : null)"><strong>@(m.Montant > 0 ? "+" : "−") @Libelles.Dinars(Math.Abs(m.Montant), 2)</strong></td>
                                            <td>@Libelles.Dinars(m.SoldeApres, 2)</td>
                                            <td><LienContact Type="employe" Id="m.EmployeId" Nom="@(m.Employe ?? "—")" />@if (m.Poste is { } poste) { <br /><span class="detail">@poste</span> }</td>
                                        </tr>
                                    }
                                    @if (mouvements.Count == 0) { <tr><td colspan="5" class="vide">Aucun mouvement pour ces filtres.</td></tr> }
                                </tbody>
                            </table>
                        </div>
                        <Pagination Total="mouvementsTotal" Numero="mouvementsPage" Taille="mouvementsTaille" Libelle="Pages du relevé" OnChange="p => ChargerMouvementsAsync(p.Numero, p.Taille)" />
                    </details>
                }
                @if (avoirMouvements.Count > 0)
                {
                    @* Avoir du patient (script 106) : relevé séparé de la dette, jamais confondu avec elle *@
                    <details style="margin-top: 8px">
                        <summary>Avoir du patient : @Libelles.Dinars(soldeAvoir, 2) (@avoirTotal mouvement@(avoirTotal > 1 ? "s" : ""))</summary>
                        <div class="tableau-cadre" style="margin-top: 4px">
                            <table class="tableau" style="min-width: 0">
                                <thead><tr><th scope="col">Date</th><th scope="col">Mouvement</th><th scope="col">Montant</th><th scope="col">Avoir après</th></tr></thead>
                                <tbody>
                                    @foreach (var m in avoirMouvements)
                                    {
                                        <tr>
                                            <td>@Libelles.DateHeureLocale(m.CreeLe.UtcDateTime)</td>
                                            <td class="nom">@LibelleAvoir(m.Origine)@(m.NumeroVente is { } nv ? $" · {nv}" : "")@(m.BonSortie is { } b ? $" · bon {b}" : "")</td>
                                            <td>@(m.Type == "credit" ? "+ " : "− ")@Libelles.Dinars(m.Montant, 2)</td>
                                            <td>@Libelles.Dinars(m.SoldeApres, 2)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <Pagination Total="avoirTotal" Numero="avoirPage" Taille="avoirTaille" Libelle="Pages de l’avoir" OnChange="p => ChargerAvoirAsync(p.Numero, p.Taille)" />
                    </details>
                }
                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px">
                    <button type="button" class="btn" disabled="@enCours" @onclick="ImprimerReleveAsync">Imprimer le relevé (PDF)</button>
                    @if (Session.A("role.titulaire"))
                    {
                        <button type="button" class="btn" @onclick="() => correction = !correction">Corriger la dette…</button>
                    }
                </div>
                @if (correction)
                {
                    <div class="achats-ligne" style="align-items: flex-end; margin-top: 8px">
                        <div class="champ" style="flex: 0 0 180px"><label for="c-nouvelle" class="requis">Nouvelle dette (DA)</label><input id="c-nouvelle" data-champ="nouvelle_dette" type="number" min="0" step="0.01" @bind="nouvelleDette" /></div>
                        <div class="champ" style="flex: 1 1 260px"><label for="c-motif" class="requis">Motif de la correction</label><input id="c-motif" data-champ="motif_correction" type="text" maxlength="300" @bind="motifCorrection" /></div>
                        <button type="button" class="btn btn-danger" disabled="@enCours" @onclick="CorrigerAsync">Enregistrer la correction</button>
                    </div>
                    <p class="detail" style="margin: 4px 0 0">Réservé au titulaire. La correction est inscrite au relevé et au journal, avec votre nom et le motif.</p>
                }
            </div>
            @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
            <div class="achats-ligne" style="align-items: flex-end">
                <div class="champ" style="flex: 0 0 200px">
                    <label for="c-montant" class="requis">Montant réglé (DA)</label>
                    <input id="c-montant" data-champ="montant" type="number" min="0.01" max="@s.Patient.Solde.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" @bind="montant" @bind:after="CocherParDefaut" />
                </div>
                <div class="filtres" role="radiogroup" aria-label="Mode de règlement">
                    @foreach (var (code, libelle) in Modes)
                    {
                        <button type="button" role="radio" class="puce" aria-pressed="@(mode == code ? "true" : "false")" aria-checked="@(mode == code ? "true" : "false")" @onclick="() => mode = code">@libelle</button>
                    }
                    @* Avoir du patient (script 106) : jamais confondu avec la dette ; utilisable jusqu'à son solde *@
                    @if (soldeAvoir > 0)
                    {
                        <button type="button" role="radio" class="puce" aria-pressed="@(mode == "avoir" ? "true" : "false")" aria-checked="@(mode == "avoir" ? "true" : "false")"
                                @onclick="ChoisirAvoir">Avoir (@Libelles.Dinars(soldeAvoir, 2))</button>
                    }
                </div>
            </div>
            @if (soldeAvoir > 0)
            {
                <p class="detail" style="margin: 0">Avoir du patient : <strong>@Libelles.Dinars(soldeAvoir, 2)</strong> (argent que la pharmacie lui doit, séparé de sa dette).</p>
            }
            @if (MessageSurplus is { } surplus) { <div class="info-bandeau" role="status">@surplus</div> }
            @* Patient sans dette (2026-11-15) : rien à encaisser, bouton grisé avec l'explication *@
            @if (s.Patient.Solde <= 0)
            {
                <p class="detail" style="margin: 0" id="c-sans-dette">Ce patient ne doit rien : il n’y a pas de dette à encaisser.</p>
            }
            <button type="button" class="btn btn-principal" disabled="@(enCours || s.Patient.Solde <= 0)" aria-describedby="@(s.Patient.Solde <= 0 ? "c-sans-dette" : null)" @onclick="EncaisserAsync">Encaisser @Libelles.Dinars(montant, 2)</button>
        }
    </section>
</div>

@code {
    private static string LibelleMouvement(string type, string? employe) => type switch
    {
        "ouverture" => "Dette à la mise en place du relevé", "reprise" => "Dette reprise de l’ancien logiciel", "vente_credit" => "Vente à crédit",
        "remboursement" => "Encaissement de dette", "retour" => "Retour de produits", "annulation" => "Vente annulée",
        _ => employe is null ? "Correction hors logiciel" : "Correction par le titulaire"
    };

    // Mouvement né d'une régularisation Chifa (recette du 2026-11-15, D7) : « Régularisation Chifa (T-…) », ni reprise ni correction
    // du titulaire (même règle que RegularisationPartOrganisme.LibelleReleve côté serveur, relevé PDF)
    private static string? RegularisationChifa(MouvementCreditDto m) =>
        m.Reference is { } r && r.StartsWith("Régularisation part organisme Chifa", StringComparison.Ordinal)
            ? m.Vente is { } v ? $"Régularisation Chifa ({v})" : "Régularisation Chifa"
            : null;

    /// <summary>Patient à ouvrir directement (depuis sa fiche contact) ; sinon la liste des patients en crédit.</summary>
    [Parameter] public long? PatientId { get; set; }
    /// <summary>Affiché comme partie de la Caisse (pas de voile ni de « Fermer » : la colonne d'actions ramène à la vente).</summary>
    [Parameter] public bool EnLigne { get; set; }
    [Parameter] public EventCallback OnFerme { get; set; }
    /// <summary>Prévient la caisse qu'un règlement est entré (attendu de caisse).</summary>
    [Parameter] public EventCallback OnEncaisse { get; set; }

    private static readonly (string, string)[] Modes = [("especes", "Espèces"), ("carte", "Carte"), ("cheque", "Chèque")];
    private string? recherche, erreur, messageImpression;
    private string mode = "especes";
    private decimal montant;
    private decimal soldeAvoir;
    private List<AvoirMouvementDto> avoirMouvements = [];
    private int avoirTotal, avoirPage = 1, avoirTaille = Pagination.TailleParDefaut;

    private async Task ChargerAvoirAsync(int numero, int taille)
    {
        if (situation is null) { (soldeAvoir, avoirMouvements, avoirTotal) = (0, [], 0); return; }
        var (a, _) = await Api.AvoirPatientAsync(situation.Patient.Id, numero, taille);
        soldeAvoir = a?.Solde ?? 0;
        (avoirMouvements, avoirTotal, avoirPage, avoirTaille) = (a?.Mouvements.Lignes.ToList() ?? [], a?.Mouvements.Total ?? 0, numero, taille);
    }

    private static string LibelleAvoir(string origine) => origine switch
    {
        "annulation_vente" => "Annulation de vente", "retour_client" => "Retour de produits", "trop_paye_regularisation" => "Trop-payé de régularisation", "saisie" => "Saisie",
        "paiement" => "Utilisé en paiement", "remboursement" => "Remboursé", _ => origine
    };

    /// <summary>Payer avec l'avoir : le montant proposé est au plus le solde de l'avoir.</summary>
    private void ChoisirAvoir()
    {
        mode = "avoir";
        if (montant > soldeAvoir) { montant = soldeAvoir; CocherParDefaut(); }
    }
    private List<PatientEnCreditDto> patients = [];
    private SituationCreditDto? situation;
    private RecuCreditDto? recu;
    // Relevé de dette paginé : la fiche apporte la première page, les suivantes sont chargées à la demande
    private List<MouvementCreditDto> mouvements = [];
    private int mouvementsTotal, mouvementsPage = 1, mouvementsTaille = Pagination.TailleParDefaut;

    // Filtres du relevé : appliqués par le serveur ; changer de tiers garde la période et le type choisis
    private int releveTotal;
    private DateOnly? releveDu, releveAu;
    private string releveType = "";
    private bool FiltreReleveActif => releveDu is not null || releveAu is not null || releveType != "";
    private Task FiltrerReleveAsync() => ChargerMouvementsAsync(1, mouvementsTaille);
    private Task EffacerFiltresReleveAsync() { (releveDu, releveAu, releveType) = (null, null, ""); return FiltrerReleveAsync(); }
    private static readonly (string, string)[] TypesMouvement =
    [
        ("vente_credit", "Vente à crédit"), ("remboursement", "Encaissement de dette"), ("retour", "Retour de produits"), ("annulation", "Vente annulée"),
        ("correction", "Correction"), ("reprise", "Dette reprise de l’ancien logiciel"), ("ouverture", "Dette à la mise en place du relevé")
    ];

    // Choix du patient depuis le filtre du relevé : on change de patient sans quitter le relevé
    private string? recherchePatientReleve;
    private List<PatientEnCreditDto> patientsReleve = [];
    private bool patientCherche;
    private int requetePatientReleve;

    private async Task ChercherPatientReleveAsync()
    {
        var n = ++requetePatientReleve;
        await Task.Delay(TimeSpan.FromMilliseconds(250));
        if (n != requetePatientReleve) return;
        if (string.IsNullOrWhiteSpace(recherchePatientReleve)) { (patientsReleve, patientCherche) = ([], false); return; }
        var (liste, _) = await Api.PatientsEnCreditAsync(recherchePatientReleve);
        if (n != requetePatientReleve) return;
        (patientsReleve, patientCherche) = (liste.Where(p => p.Id != situation?.Patient.Id).Take(6).ToList(), true);
    }

    private async Task ChangerPatientReleveAsync(long id)
    {
        requetePatientReleve++;
        (recherchePatientReleve, patientsReleve, patientCherche) = (null, [], false);
        await ChoisirAsync(id);
    }

    private async Task ChargerMouvementsAsync(int numero, int taille)
    {
        if (situation is null) return;
        var (p, e) = await Api.MouvementsCreditAsync(situation.Patient.Id, numero, taille, releveDu, releveAu, releveType);
        if (e is not null) { erreur = e; return; }
        (mouvements, mouvementsTotal, mouvementsPage, mouvementsTaille) = (p!.Lignes.ToList(), p.Total, p.Numero, p.Taille);
    }

    private bool correction;
    private decimal nouvelleDette;
    private string? motifCorrection;

    private async Task ImprimerReleveAsync()
    {
        if (situation is null) return;
        (enCours, erreur) = (true, null);
        try
        {
            var (contenu, nom, e) = await Api.ReleveCreditAsync(situation.Patient.Id);
            if (e is not null) { erreur = e; return; }
            var doc = await Documents.RangerAsync(Api, "Credits", nom!, contenu!);
            Documents.Ouvrir(doc.CheminLocal);
            erreur = doc.Erreur;
        }
        catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException) { erreur = $"Relevé non enregistré : {ex.Message}"; }
        finally { enCours = false; }
    }

    private async Task CorrigerAsync()
    {
        if (situation is null) return;
        (enCours, erreur) = (true, null);
        try
        {
            if (await Api.CorrigerCreditAsync(situation.Patient.Id, nouvelleDette, motifCorrection) is { } e) { erreur = e; return; }
            (correction, motifCorrection) = (false, null);
            await ChoisirAsync(situation.Patient.Id);
        }
        finally { enCours = false; }
    }
    private bool charge, enCours, impressionOk;
    private int requete;

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : patient ouvert, filtres et page de son relevé retrouvés tels qu'ils étaient
        Historique.Suivre("credit", e =>
        {
            e.Mettre("patient", situation?.Patient.Id); e.Mettre("recherche", recherche); e.Mettre("du", releveDu); e.Mettre("au", releveAu);
            e.Mettre("type", releveType); e.Mettre("page", mouvementsPage); e.Mettre("taille", mouvementsTaille);
            e.Mettre("page_patients", pagePatients); e.Mettre("taille_patients", taillePatients);
        });
        var r = Historique.Restaurer("credit");
        if (r is not null)
            (recherche, releveDu, releveAu, releveType, mouvementsTaille) = (r.Texte("recherche") ?? recherche, r.Date("du"), r.Date("au"), r.Texte("type") ?? "", r.Entier("taille") ?? mouvementsTaille);
        if ((r?.Long("patient") ?? PatientId) is > 0 and var p) await ChoisirAsync(p);
        if (situation is not null && r?.Entier("page") is > 1 and var pr) await ChargerMouvementsAsync(pr, mouvementsTaille);
        await ChargerPatientsAsync(r?.Entier("page_patients") ?? 1, r?.Entier("taille_patients") ?? taillePatients);
    }

    private async Task RechercherApresSaisieAsync()
    {
        var n = ++requete;
        await Task.Delay(TimeSpan.FromMilliseconds(250));
        if (n == requete) await RechercherAsync();
    }

    private Task RechercherAsync() => ChargerPatientsAsync(1, taillePatients);

    private int totalPatients, pagePatients = 1, taillePatients = Pagination.TailleParDefaut;

    /// <summary>Patients en crédit (plus grosses dettes d'abord), une page ; recherche sur le nom ou le début du téléphone.</summary>
    private async Task ChargerPatientsAsync(int numero, int taille)
    {
        var n = ++requete;
        var (p, e) = await Api.PatientsEnCreditPageAsync(recherche, numero, taille);
        if (n != requete) return;
        if (p is { Lignes.Count: 0 } && numero > 1) { await ChargerPatientsAsync(1, taille); return; }
        (patients, erreur, charge) = (p?.Lignes.ToList() ?? [], e, true);
        if (p is not null) (totalPatients, pagePatients, taillePatients) = (p.Total, p.Numero, p.Taille);
    }

    private async Task ChoisirAsync(long id)
    {
        var (s, e) = await Api.SituationCreditAsync(id);
        (situation, erreur) = (s, e);
        montant = s?.Patient.Solde ?? 0;
        (nouvelleDette, correction) = (s?.Patient.Solde ?? 0, false);
        (mouvements, mouvementsTotal, mouvementsPage) = (s?.Mouvements?.ToList() ?? [], s?.MouvementsTotal ?? 0, 1);
        releveTotal = s?.MouvementsTotal ?? 0;
        CocherParDefaut();
        // Avoir du patient (script 106), affiché à part de la dette
        await ChargerAvoirAsync(1, avoirTaille);
        if (mode == "avoir" && soldeAvoir <= 0) mode = "especes";
        // La fiche apporte la première page sans filtre : rechargée avec les filtres et la taille de page en cours
        if (s is not null && (FiltreReleveActif || mouvementsTaille != Pagination.TailleParDefaut)) await ChargerMouvementsAsync(1, mouvementsTaille);
    }

    // Ventes à solder choisies par le patient (2026-11-15) : par défaut les plus anciennes jusqu'à couvrir le montant
    private HashSet<long> cochees = [];

    // Même règle que RegleReglementCredit.VentesParDefaut (domaine, non référencé par le poste)
    private void CocherParDefaut()
    {
        cochees = [];
        var couvert = 0m;
        foreach (var v in (situation?.Ventes ?? []).Where(v => v.Reste > 0 && v.Id > 0).OrderBy(v => v.Date).ThenBy(v => v.Id))
        {
            if (couvert >= montant) break;
            cochees.Add(v.Id);
            couvert += v.Reste;
        }
    }

    private void Cocher(long venteId, bool coche)
    {
        if (coche) cochees.Add(venteId); else cochees.Remove(venteId);
    }

    private IEnumerable<VenteACreditDto> VentesDues => (situation?.Ventes ?? []).Where(v => v.Reste > 0 && v.Id > 0);

    /// <summary>Factures qui reprennent au moins une vente encore due (case « toute la facture »).</summary>
    private List<string> FacturesDues => VentesDues.Where(v => v.Facture is not null).Select(v => v.Facture!).Distinct().Order().ToList();

    private bool FactureCochee(string facture) => VentesDues.Where(v => v.Facture == facture).All(v => cochees.Contains(v.Id));

    private void CocherFacture(string facture, bool coche)
    {
        foreach (var v in VentesDues.Where(v => v.Facture == facture)) Cocher(v.Id, coche);
    }

    /// <summary>
    /// Surplus annoncé avant d'encaisser (2026-11-15) : montant au-delà du reste des ventes cochées, imputé par le serveur au plus ancien
    /// (dette reprise d'abord, puis la plus ancienne vente non cochée). Même règle que RegleReglementCredit.Surplus (domaine).
    /// </summary>
    private string? MessageSurplus
    {
        get
        {
            if (situation is not { } s || cochees.Count == 0 || montant <= 0) return null;
            var dues = VentesDues.OrderBy(v => v.Date).ThenBy(v => v.Id).ToList();
            var surplus = montant - dues.Where(v => cochees.Contains(v.Id)).Sum(v => v.Reste);
            if (surplus <= 0) return null;
            var repriseRestante = s.Patient.Solde - dues.Sum(v => v.Reste);
            var cible = repriseRestante > 0 ? "la dette reprise de l’ancien logiciel"
                : dues.FirstOrDefault(v => !cochees.Contains(v.Id)) is { } a ? $"vente {a.Numero} du {Libelles.DateHeureLocale(a.Date)}" : null;
            return cible is null ? null
                : $"Surplus de {Libelles.Dinars(surplus, 2)} : il soldera la dette la plus ancienne ({cible}). Cochez d’autres ventes si le patient préfère.";
        }
    }

    private async Task EncaisserAsync()
    {
        if (situation is null) return;
        if (montant <= 0 || montant > situation.Patient.Solde) { erreur = Api.SignalerChamp("montant", $"Montant entre 0,01 et {Libelles.Dinars(situation.Patient.Solde, 2)}."); return; }
        if (mode == "avoir" && montant > soldeAvoir) { erreur = Api.SignalerChamp("montant", $"Avoir insuffisant (solde : {Libelles.Dinars(soldeAvoir, 2)})."); return; }
        enCours = true;
        var (r, e) = await Api.ReglerCreditAsync(situation.Patient.Id, new ReglementCreditRequete(montant, mode, cochees.ToList()));
        enCours = false;
        if (e is not null) { erreur = e; return; }
        recu = r;
        await OnEncaisse.InvokeAsync();
    }

    /// <summary>Reçu imprimé comme un ticket (imprimante du poste) : montant, mode, reste dû ; sans le nom du patient.</summary>
    private async Task ImprimerAsync()
    {
        if (recu is null) return;
        enCours = true;
        if (Tickets.ImprimanteFichier)
        {
            // Imprimante qui enregistre un fichier (PDF…) : reçu produit par le serveur et ouvert à l'écran, sans « Enregistrer sous » (2026-11-15)
            try
            {
                var (pdf, nom, ePdf) = await Api.RecuCreditPdfAsync(recu.Numero, Tickets.LargeurMm);
                if (ePdf is null) Documents.OuvrirSurCePoste("Tickets", nom ?? $"recu_{recu.Numero}.pdf", pdf!);
                (impressionOk, messageImpression) = (ePdf is null,
                    ePdf ?? $"Reçu {recu.Numero} ouvert à l’écran (l’imprimante de ce poste enregistre un fichier au lieu d’imprimer).");
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                (impressionOk, messageImpression) = (false, $"Reçu {recu.Numero} non ouvert : {ex.Message}");
            }
            finally { enCours = false; }
            return;
        }
        var t = new TicketDto(recu.Numero, DateTime.UtcNow, Session.NomComplet ?? "", null, "validee", null, null,
            [new LigneTicketDto($"Encaissement de dette (reste dû {Libelles.Dinars(recu.ResteDu, 2)})", 1, recu.Montant, recu.Montant, 0)],
            recu.Montant, 0, 0, recu.Montant, recu.Mode, Session.NomPharmacie, null, null, null);
        var e = await Tickets.ImprimerAsync(t);
        enCours = false;
        (impressionOk, messageImpression) = (e is null, e ?? "Reçu envoyé à l’imprimante.");
    }
}
