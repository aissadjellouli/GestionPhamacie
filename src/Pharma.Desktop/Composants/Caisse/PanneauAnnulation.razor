@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique

@* Vente encaissée : annulation complète (récente par le caissier, ancienne validée sur place)
   ou retour de produits par le patient (le pharmacien choisit : remis en stock ou à détruire) *@
@* EnLigne : partie de la Caisse (colonne d'actions à gauche), sans voile ni « Fermer » ; sinon fenêtre par-dessus l'écran *@
<div class="@(EnLigne ? "partie-caisse" : "voile")" role="@(EnLigne ? null : "dialog")" aria-modal="@(EnLigne ? null : "true")" aria-labelledby="t-annulation">
    <section class="panneau @(EnLigne ? "partie-caisse-panneau" : "fenetre-annulation")">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px">
            <h2 id="t-annulation">@(mode == "retour" ? "Retour de produits" : "Annuler une vente ou faire un retour")</h2>
            @if (!EnLigne) { <button type="button" class="btn" @onclick="OnFerme">Fermer</button> }
        </div>

        @if (message is not null)
        {
            <div class="succes" role="status">@message</div>
            <button type="button" class="btn btn-principal" @onclick="OnFerme">Terminer</button>
        }
        else
        {
            @if (choisie is null)
            {
                <div class="champ">
                    <label for="a-numero">N° de ticket (vide : dernières ventes de cette caisse)</label>
                    <div style="display: flex; gap: 8px">
                        <input id="a-numero" type="search" placeholder="ex. T-000012" @bind="numero" @bind:event="oninput" @onkeydown="ToucheRecherche" style="flex: 1" />
                        <button type="button" class="btn" @onclick="RechercherAsync">Chercher</button>
                    </div>
                </div>
                <div class="champ" role="group" aria-label="Retrouver la vente par la boîte rapportée">
                    <label for="a-boite">Sans ticket : scannez la boîte rapportée</label>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center">
                        <input id="a-boite" data-champ="code_boite" type="search" placeholder="Code-barres, Data Matrix ou étiquette de la pharmacie"
                               @bind="codeBoite" @bind:event="oninput" @onkeydown="ToucheBoite" style="flex: 2 1 240px" />
                        <input id="a-lot" type="text" aria-label="N° de lot imprimé sur la boîte (facultatif)" placeholder="N° de lot (facultatif)" @bind="lotBoite" style="flex: 1 1 130px" />
                        <label for="a-jours" style="display: flex; gap: 6px; align-items: center">Sur
                            <input id="a-jours" type="number" min="1" max="365" @bind="joursBoite" style="width: 72px" /> jours</label>
                        <button type="button" class="btn" disabled="@enCours" @onclick="ChercherParBoiteAsync">Chercher les ventes</button>
                    </div>
                    @if (clientBoite is { } cb)
                    {
                        <p class="detail" style="margin: 0">Ventes de <strong>@cb.Nom @cb.Prenom</strong> seulement.
                            <button type="button" class="lien" @onclick="() => (clientBoite, ventes, recherche) = (null, [], false)">Client sans nom</button></p>
                    }
                    else
                    {
                        <p class="detail" style="margin: 0">Client sans nom : seules les ventes faites sans patient sont proposées (jamais celles d’un autre patient).
                            <button type="button" class="lien" @onclick="() => saisieClientBoite = !saisieClientBoite">Le client donne son nom</button></p>
                        @if (saisieClientBoite)
                        {
                            <div style="display: flex; gap: 8px">
                                <input type="search" data-champ="client_boite" aria-label="Nom ou téléphone du client" placeholder="Nom ou téléphone du client"
                                       @bind="rechercheClientBoite" @bind:event="oninput" style="flex: 1" />
                                <button type="button" class="btn" @onclick="ChercherClientBoiteAsync">Rechercher</button>
                            </div>
                            @foreach (var c in clientsBoite)
                            {
                                <div><button type="button" class="lien" @onclick="() => ChoisirClientBoite(c)">@c.Nom @c.Prenom</button> <span class="detail">@c.Telephone</span></div>
                            }
                        }
                    }
                </div>
            }
            @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

            @if (choisie is null)
            {
                @if (resultatBoite is { } rb)
                {
                    <div class="info-bandeau" role="status">
                        @if (rb.Exacte)
                        {
                            <text>Boîte retrouvée : elle a été vendue sur la vente ci-dessous.</text>
                        }
                        else
                        {
                            <text>@rb.Ventes.Count vente(s) de @rb.Produit@(rb.Lot is { } lb ? $", lot {lb}" : "") sur les @joursBoite derniers jours@(clientBoite is { } c ? $", de {c.Nom} {c.Prenom}" : ", sans patient"). Choisissez celle du client (date, heure, montant).</text>
                        }
                        @if (rb.Note is { } note) { <br /><span class="detail">@note</span> }
                    </div>
                }
                @if (ventes.Count == 0 && recherche)
                {
                    <p class="vide" style="margin: 0">Aucune vente trouvée.</p>
                }
                <div class="liste-ventes cadre-defilant">
                    @foreach (var v in ventes)
                    {
                        <button type="button" class="ligne-vente @(v.Statut == "annulee" ? "annulee" : null)" disabled="@(v.Statut != "validee")" @onclick="() => Choisir(v)">
                            <span><strong>@v.Numero</strong> · @Libelles.DateHeureLocale(v.Date) · @v.Vendeur@(v.Patient is { } p ? $" · {p}" : "")@(v.Remise is { } rv ? $" · {rv}" : "")
                                @if (resultatBoite is not null)
                                {
                                    <br /><span class="detail">@string.Join(", ", v.Lignes.Select(l => $"{l.Quantite} × {l.Produit}{(l.Lot is { } lo ? $" (lot {lo})" : "")}"))</span>
                                }
                            </span>
                            <span>@(v.Statut == "annulee" ? "Annulée" : Libelles.Dinars(v.Total, 2))</span>
                        </button>
                    }
                </div>
                @* Ventes de la caisse ouverte : par page, filtrées par le serveur (règle des listes) ; la recherche par boîte garde sa liste *@
                @if (resultatBoite is null && recherche)
                {
                    <Pagination Total="totalVentes" Numero="pageVentes" Taille="tailleVentes" Libelle="Pages des ventes" OnChange="p => ChargerVentesAsync(p.Numero, p.Taille)" />
                }
            }
            else
            {
                var v = choisie;
                <div class="carte">
                    <strong>@v.Numero</strong> · @Libelles.DateHeureLocale(v.Date) · vendu par <LienContact Type="employe" Id="v.VendeurId" Nom="@v.Vendeur" />@if (v.Patient is { } p) { <text> · </text><LienContact Type="patient" Id="v.PatientId" Nom="@p" /> }@if (v.Remise is { } rv) { <text> · @rv</text> }
                    <ul style="margin: 8px 0">
                        @foreach (var l in v.Lignes) { <li>@l.Quantite × @l.Produit · @Libelles.Dinars(l.Montant, 2)</li> }
                    </ul>
                    Total @Libelles.Dinars(v.Total, 2)@(v.PartOrganisme > 0 ? $" · part organisme {Libelles.Dinars(v.PartOrganisme, 2)}" : "")
                    · payé par le patient @Libelles.Dinars(v.PartPatient, 2) (@Libelles.ModePaiement(v.Mode))
                    <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="ChangerDeVente">Changer de vente</button>
                </div>

                @if (v.DansUnBordereau)
                {
                    <div class="erreur" role="alert">Cette vente figure déjà sur un bordereau envoyé à l’organisme : l’annulation ou le retour passe par la régularisation Chifa.</div>
                }
                else if (mode is null)
                {
                    <div class="filtres" role="group" aria-label="Que faire de cette vente ?">
                        <button type="button" class="btn" @onclick='() => ChoisirMode("annulation")'>Annuler toute la vente</button>
                        <button type="button" class="btn" @onclick='() => ChoisirModeAsync("retour")'>Retour de produits (partiel)</button>
                    </div>
                }
                else if (mode == "annulation")
                {
                    <div class="@(v.CaisseOuverte ? "info-bandeau" : "avertissement")" role="note">
                        @if (v.CaisseOuverte)
                        {
                            <text>Vente récente (sa caisse est encore ouverte) : annulation directe.</text>
                        }
                        else if (Session.A("caisse.annuler_vente"))
                        {
                            <text>Vente d’une caisse déjà clôturée : vous avez le droit de l’annuler. L’argent rendu sort de la caisse ouverte de ce poste.</text>
                        }
                        else
                        {
                            <text>Vente d’une caisse déjà clôturée : le pharmacien ou l’assistant doit valider avec son code. L’argent rendu sort de la caisse ouverte de ce poste.</text>
                        }
                    </div>
                    @ChampMotif
                    @if (ValidationRequise) { @ChampValidation }
                    @if (v.FactureNumero is { } facture)
                    {
                        <div class="info-bandeau" role="note">Vente portée sur la facture @facture : retirez-la d’abord de la facture (Factures : rejet puis correction), ou faites un retour.</div>
                    }
                    @ChampDette
                    @if (v.RegularisationSort == "charge_patient")
                    {
                        <div class="avertissement" role="note" style="display: flex; flex-direction: column; gap: 4px">
                            <div>Part organisme régularisée à la charge du patient : @(v.RegularisationDue > 0 ? $"{Libelles.Dinars(v.RegularisationDue, 2)} encore dus, annulés (jamais remboursés)." : "rien n’est encore dû.")</div>
                            @if (v.RegularisationTropPaye > 0)
                            {
                                <div><strong>Ce patient a payé @Libelles.Dinars(v.RegularisationTropPaye, 2) de cette régularisation.</strong>
                                    @(autresDettes.Count > 0 ? $" Il doit encore {Libelles.Dinars(autresDettes.Sum(d => d.Reste), 2)} sur d’autres ventes : choisissez avec lui." : " Il n’a pas d’autre dette : il est remboursé par le tiroir.")</div>
                                @foreach (var d in autresDettes)
                                {
                                    <label style="display: flex; gap: 8px; align-items: center">
                                        <span style="flex: 1">Solder @d.Numero du @d.Date.ToLocalTime().ToString("dd/MM/yyyy") (reste @Libelles.Dinars(d.Reste, 2))</span>
                                        <input type="number" min="0" max="@d.Reste" step="0.01" style="width: 110px" aria-label="Montant imputé sur @d.Numero"
                                               value="@(imputationsTropPaye.GetValueOrDefault(d.Id))" @onchange="e => ImputerTropPaye(d.Id, e.Value)" />
                                    </label>
                                }
                                <div>Rembourser le patient par le tiroir (« Remboursement d’un client », bon de sortie) : <strong>@Libelles.Dinars(RembourseTropPaye, 2)</strong></div>
                            }
                        </div>
                    }
                    <button type="button" class="btn btn-danger" disabled="@(enCours || v.FactureNumero is not null)" @onclick="AnnulerAsync">
                        Annuler la vente@(ARenduAffiche is > 0 ? $" et rendre {Libelles.Dinars(ARenduAffiche.Value, 2)}" + (v.Mode is "credit" or "especes" ? " en espèces" : "") : DetteAProposer && solderDette == true ? " (déduite de la dette, rien à rendre)" : "")
                    </button>
                }
                else if (retour is not null)
                {
                    <div class="info-bandeau" role="note">
                        Pour chaque produit rapporté : quantité, puis remis en stock (boîte intacte) ou à détruire. Laisser à 0 ce qui n’est pas rendu.
                        Refuser le retour : @(EnLigne ? "« Changer de vente », ou quittez la rubrique sans enregistrer." : "fermez simplement cette fenêtre.")
                    </div>
                    @foreach (var s in saisies)
                    {
                        var l = s.Ligne;
                        var reste = l.QuantiteVendue - l.DejaRendue;
                        <div class="carte ligne-retour">
                            <div><strong>@l.Produit</strong> <span class="detail">lot @l.NumeroLot · @l.QuantiteVendue vendue(s)@(l.DejaRendue > 0 ? $", {l.DejaRendue} déjà rendue(s)" : "")</span></div>
                            @if (reste <= 0)
                            {
                                <span class="detail">Tout a déjà été rendu.</span>
                            }
                            else
                            {
                                <div class="achats-ligne" style="align-items: flex-end">
                                    @if (l.Boites.Count == 0)
                                    {
                                        <div class="champ" style="flex: 0 0 140px">
                                            <label for="q-@l.LigneVenteId">Rendue(s) (0 à @reste)</label>
                                            <input id="q-@l.LigneVenteId" type="number" min="0" max="@reste" @bind="s.Quantite" />
                                        </div>
                                    }
                                    else
                                    {
                                        <fieldset class="boites-retour">
                                            <legend>Boîtes rendues (n° de série ou étiquette)</legend>
                                            @foreach (var b in l.Boites)
                                            {
                                                <label class="case"><input type="checkbox" checked="@s.Boites.Contains(b.Id)" @onchange="e => BasculerBoite(s, b.Id, e)" /><span>@b.NumeroSerie</span></label>
                                            }
                                        </fieldset>
                                    }
                                    <div class="filtres" role="radiogroup" aria-label="@($"Destination de {l.Produit}")">
                                        <label class="case"><input type="radio" name="d-@l.LigneVenteId" checked="@(s.Destination == "stock")" @onchange='() => s.Destination = "stock"' /><span>Remettre en stock</span></label>
                                        <label class="case"><input type="radio" name="d-@l.LigneVenteId" checked="@(s.Destination == "destruction")" @onchange='() => s.Destination = "destruction"' /><span>À détruire</span></label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @ChampMotif
                    @if (ValidationRequise) { @ChampValidation }
                    @ChampDette
                    <button type="button" class="btn btn-danger" disabled="@(enCours || ARendre is null)" @onclick="EnregistrerRetourAsync">
                        Enregistrer le retour@(ARenduAffiche is > 0 ? $" et rendre {Libelles.Dinars(ARenduAffiche.Value, 2)}" : DetteAProposer && solderDette == true ? " (déduit de la dette, rien à rendre)" : "")
                    </button>
                }
            }
        }
    </section>
</div>

@code {
    [Parameter] public string? NumeroInitial { get; set; }
    /// <summary>Affiché comme partie de la Caisse (pas de voile ni de « Fermer » : la colonne d'actions ramène à la vente).</summary>
    [Parameter] public bool EnLigne { get; set; }
    [Parameter] public EventCallback OnFerme { get; set; }
    /// <summary>Prévient la caisse qu'une vente a été annulée ou reprise (stock, attendu de caisse).</summary>
    [Parameter] public EventCallback OnAnnulee { get; set; }

    private sealed class SaisieRetour(LigneRetournableDto ligne)
    {
        public LigneRetournableDto Ligne { get; } = ligne;
        public int Quantite { get; set; }
        public HashSet<long> Boites { get; } = [];
        public string Destination { get; set; } = "stock";
        public int Rendue => Ligne.Boites.Count > 0 ? Boites.Count : Math.Clamp(Quantite, 0, Ligne.QuantiteVendue - Ligne.DejaRendue);
    }

    private string? numero, motif, validateur, code, erreur, message;
    private string? mode;   // null : choix ; « annulation » ; « retour »
    private List<VenteAnnulableDto> ventes = [];
    private List<VendeurComptoirDto> validateurs = [];
    private VenteAnnulableDto? choisie;
    private VenteRetournableDto? retour;
    private List<SaisieRetour> saisies = [];
    private bool recherche, enCours, controle;

    private string DroitRequis => mode == "retour" ? "caisse.retour_especes" : "caisse.annuler_vente";
    // Retour entièrement déduit de la dette avec l'accord du client : rien ne sort de la caisse, le caissier valide seul
    private bool ValidationRequise => mode == "retour" ? !Session.A(DroitRequis) && !DeductionTotale : choisie is { CaisseOuverte: false } && !Session.A(DroitRequis);
    private bool DeductionTotale => DetteAProposer && solderDette == true && accordClient && ARenduAffiche == 0;
    private bool AccordManque => controle && DetteAProposer && solderDette == true && !accordClient;

    /// <summary>Le client accepte que le remboursement soit retiré de sa dette (jamais sans son accord).</summary>
    private bool accordClient;

    // Remboursement sans ticket : boîte rapportée, période, lot, client nommé ou non
    private string? codeBoite, lotBoite, rechercheClientBoite;
    private int joursBoite = 7;
    private PatientDto? clientBoite;
    private bool saisieClientBoite;
    private List<PatientDto> clientsBoite = [];
    private VentesParBoiteDto? resultatBoite;

    private async Task ToucheBoite(KeyboardEventArgs e) { if (e.Key == "Enter") await ChercherParBoiteAsync(); }

    private async Task ChercherParBoiteAsync()
    {
        (erreur, choisie, mode, resultatBoite) = (null, null, null, null);
        if (string.IsNullOrWhiteSpace(codeBoite)) { erreur = Api.SignalerChamp("code_boite", "Scannez la boîte rapportée (ou tapez son code-barres)."); return; }
        enCours = true;
        var (r, e) = await Api.VentesParBoiteAsync(codeBoite, Math.Clamp(joursBoite, 1, 365), clientBoite?.Id, lotBoite);
        enCours = false;
        if (e is not null) { erreur = e; return; }
        (resultatBoite, ventes, recherche) = (r, r!.Ventes.ToList(), true);
        if (r.Exacte && ventes is [{ Statut: "validee" } seule]) Choisir(seule);
    }

    private async Task ChercherClientBoiteAsync()
    {
        if ((rechercheClientBoite?.Trim().Length ?? 0) < 2) { erreur = Api.SignalerChamp("client_boite", "Tapez au moins 2 caractères du nom ou du téléphone."); return; }
        string? e;
        (clientsBoite, e) = await Api.RechercherPatientsAsync(rechercheClientBoite!.Trim());
        erreur = e ?? (clientsBoite.Count == 0 ? "Aucun patient de ce nom : cherchez parmi les ventes sans patient." : null);
    }

    private void ChoisirClientBoite(PatientDto c) => (clientBoite, saisieClientBoite, clientsBoite, ventes, recherche, resultatBoite) = (c, false, [], [], false, null);
    private bool MotifManque => controle && (motif?.Trim().Length ?? 0) < 3;
    private bool ValidateurManque => controle && ValidationRequise && string.IsNullOrEmpty(validateur);
    private bool CodeManque => controle && ValidationRequise && CodeComptoirSaisie.Erreur(code, nouveauCode: false) is not null;

    /// <summary>Part payée par le patient pour les boîtes rendues (même calcul que le serveur) ; null si rien n'est rendu.</summary>
    // Estimation affichée : même calcul que le serveur (prix des lignes avant remise, ramené à ce que le patient a payé)
    private decimal? ARendre => saisies.Sum(s => s.Rendue) == 0 || retour is null ? null
        : saisies.Sum(s => s.Ligne.QuantiteVendue == 0 ? 0
            : Math.Round(Math.Round(s.Ligne.MontantPatient * s.Rendue / s.Ligne.QuantiteVendue, 2, MidpointRounding.AwayFromZero) * RatioPaye, 2, MidpointRounding.AwayFromZero));

    private decimal RatioPaye => retour?.Lignes.Sum(l => l.MontantPatient) is > 0 and var brut ? Math.Min(retour.Vente.PartPatient / brut, 1m) : 1m;

    /// <summary>Le patient de la vente doit de l'argent par ailleurs : le caissier choisit de déduire le remboursement de sa dette, ou de le rendre.</summary>
    private bool? solderDette;
    // Vente sans patient : patient qui s'est nommé au retour, pour vérifier sa dette
    private PatientDto? patientDette;
    private string? rechercheDette;
    private List<PatientDto> patientsTrouves = [];
    private bool rechercheDetteFaite;
    // Vente traitée : annulation (vente choisie) ou retour (vente du retour)
    private bool EnAnnulation => mode == "annulation" && choisie is not null;
    private string? ModeVente => EnAnnulation ? choisie!.Mode : retour?.Vente.Mode;
    private bool VenteSansPatient => EnAnnulation ? choisie is { Mode: not "credit", Patient: null } : retour is { Vente: { Mode: not "credit", Patient: null } };
    private decimal DetteConnue => VenteSansPatient ? patientDette?.SoldeCredit ?? 0 : EnAnnulation ? choisie!.SoldeCreditPatient : retour?.Vente.SoldeCreditPatient ?? 0;
    /// <summary>Argent que l'opération rendrait au patient : annulation (calculé par le serveur) ou retour (boîtes rendues).</summary>
    private decimal? MontantARendre => EnAnnulation ? choisie!.ARendreAnnulation : ARendre;

    private async Task ToucheRechercheDette(KeyboardEventArgs e) { if (e.Key == "Enter") await ChercherPatientDetteAsync(); }

    private async Task ChercherPatientDetteAsync()
    {
        (erreur, patientDette, solderDette) = (null, null, null);
        if ((rechercheDette?.Trim().Length ?? 0) < 2) { erreur = Api.SignalerChamp("recherche_patient", "Tapez au moins 2 caractères du nom ou du téléphone du patient."); return; }
        string? e;
        (patientsTrouves, e) = await Api.RechercherPatientsAsync(rechercheDette!.Trim());
        if (e is not null) { erreur = e; return; }
        rechercheDetteFaite = true;
    }
    private bool DetteAProposer => ModeVente is not null and not "credit" && DetteConnue > 0 && MontantARendre is > 0;
    /// <summary>Argent rendu au patient, affiché sur le bouton : le surplus si la dette est soldée ; vente à crédit : calcul du serveur.</summary>
    private decimal? ARenduAffiche => MontantARendre is not { } a || ModeVente is null ? null
        : ModeVente == "credit" ? (EnAnnulation ? a : null)
        : DetteAProposer && solderDette == true ? Math.Max(a - DetteConnue, 0) : a;

    /// <summary>
    /// Patient qui doit de l'argent : déduire le remboursement de sa dette, ou le rendre (annulation comme retour).
    /// Vente sans patient : rappel de demander au patient s'il a un crédit, et recherche de sa dette.
    /// </summary>
    private RenderFragment ChampDette => __builder =>
    {
        if (ModeVente == "credit" && (EnAnnulation ? choisie!.DetteEffaceeAnnulation : Math.Min(Math.Max(retour?.Vente.SoldeCreditPatient ?? 0, 0), ARendre ?? 0)) is > 0 and var efface)
        {
            var rendu = (MontantARendre ?? 0) - (EnAnnulation ? 0 : efface);
            <div class="info-bandeau" role="note" data-champ="dette_effacee">
                <strong>Vente à crédit.</strong> La dette de cette vente, @Libelles.Dinars(efface, 2), sera effacée de la dette du patient
                (il ne l’avait pas payée).@if (EnAnnulation ? choisie!.ARendreAnnulation > 0 : rendu > 0) { <text> Ce qu’il avait déjà remboursé, @Libelles.Dinars(EnAnnulation ? choisie!.ARendreAnnulation : rendu, 2), lui est rendu en espèces.</text> }
            </div>
        }
        if (VenteSansPatient && MontantARendre is > 0)
                    {
                        @* Vente sans patient : rappel au vendeur. Si le patient accepte de se nommer, le logiciel vérifie sa dette *@
                        <div class="info-bandeau" role="note">
                            <strong>Vente sans patient identifié.</strong> Avant de rendre l’argent, demandez au patient s’il a un crédit en cours à la pharmacie.
                            S’il accepte de donner son nom ou son téléphone, recherchez-le : le logiciel vérifie sa dette.
                            <div style="display: flex; gap: 8px; margin-top: 8px">
                                <input type="search" data-champ="recherche_patient" aria-label="Nom ou téléphone du patient" placeholder="Nom ou téléphone du patient" @bind="rechercheDette" @bind:event="oninput" @onkeydown="ToucheRechercheDette" style="flex: 1" />
                                <button type="button" class="btn" disabled="@enCours" @onclick="ChercherPatientDetteAsync">Vérifier sa dette</button>
                            </div>
                            @if (patientDette is { } pd)
                            {
                                <p style="margin: 8px 0 0"><strong>@pd.Nom @pd.Prenom</strong>@(pd.Telephone is { } t ? $" · {t}" : "") :
                                    @(pd.SoldeCredit > 0 ? $"doit {Libelles.Dinars(pd.SoldeCredit, 2)}" : "aucune dette").
                                    <button type="button" class="lien" @onclick="() => (patientDette, solderDette) = (null, null)">Changer</button></p>
                            }
                            else if (rechercheDetteFaite)
                            {
                                @if (patientsTrouves.Count == 0) { <p style="margin: 8px 0 0">Aucun patient de ce nom dans le logiciel : aucune dette connue.</p> }
                                @foreach (var trouve in patientsTrouves)
                                {
                                    <div style="margin-top: 6px">
                                        <button type="button" class="lien" @onclick="() => (patientDette, solderDette) = (trouve, null)">@trouve.Nom @trouve.Prenom</button>
                                        <span class="detail">@trouve.Telephone · @(trouve.SoldeCredit > 0 ? $"doit {Libelles.Dinars(trouve.SoldeCredit, 2)}" : "aucune dette")</span>
                                    </div>
                                }
                            }
                        </div>
                    }
        if (DetteAProposer && MontantARendre is { } aRendre)
                    {
                        var dette = DetteConnue;
                        var deduit = Math.Min(dette, aRendre);
                        <fieldset class="conflit-lot" role="radiogroup" aria-label="Remboursement et dette du patient">
                            <legend><strong>Ce patient doit @Libelles.Dinars(dette, 2).</strong> Que faire des @Libelles.Dinars(aRendre, 2) @(mode == "retour" ? "du retour" : "de l’annulation") ?</legend>
                            <label class="case"><input type="radio" name="solder-dette" checked="@(solderDette == true)" @onchange="() => solderDette = true" />
                                <span>Les déduire de sa dette : dette ramenée à @Libelles.Dinars(dette - deduit, 2)@(aRendre > deduit ? $", et {Libelles.Dinars(aRendre - deduit, 2)} rendus au patient" : ", rien à rendre")</span></label>
                            <label class="case"><input type="radio" name="solder-dette" checked="@(solderDette == false)" @onchange="() => solderDette = false" />
                                <span>Rendre @Libelles.Dinars(aRendre, 2) au patient : sa dette reste de @Libelles.Dinars(dette, 2)</span></label>
                            @if (solderDette == true)
                            {
                                <label class="case @Obligatoire.Classe(AccordManque)" data-champ="accord_client" aria-invalid="@Obligatoire.Aria(AccordManque)">
                                    <input type="checkbox" checked="@accordClient" @onchange="async e => { accordClient = e.Value is true; await ChargerValidateursAsync(); }" />
                                    <span><strong>Le client accepte</strong> que le remboursement soit déduit de sa dette (obligatoire)</span></label>
                            }
                        </fieldset>
                    }
    };

    private RenderFragment ChampMotif => __builder =>
    {
        <div class="champ">
            <label for="a-motif" class="requis">Motif</label>
            <input id="a-motif" type="text" maxlength="300" placeholder="@(mode == "retour" ? "ex. traitement arrêté, mauvais dosage" : "ex. erreur de produit, patient a renoncé")"
                   @bind="motif" @bind:event="oninput" class="@Obligatoire.Classe(MotifManque)" aria-invalid="@Obligatoire.Aria(MotifManque)" />
        </div>
    };

    private RenderFragment ChampValidation => __builder =>
    {
        <div class="achats-ligne">
            <div class="champ" style="flex: 2 1 220px">
                <label for="a-valideur" class="requis">Validé par</label>
                <select id="a-valideur" @bind="validateur" class="@Obligatoire.Classe(ValidateurManque)" aria-invalid="@Obligatoire.Aria(ValidateurManque)">
                    <option value="">Choisir…</option>
                    @foreach (var val in validateurs) { <option value="@val.Identifiant">@val.NomComplet</option> }
                </select>
            </div>
            <div class="champ" style="flex: 1 1 140px">
                <label for="a-code" class="requis">Son code comptoir</label>
                <input id="a-code" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="off"
                       onbeforeinput="@CodeComptoirSaisie.FiltreChiffres" @bind="code" @bind:event="oninput"
                       class="@Obligatoire.Classe(CodeManque)" aria-invalid="@Obligatoire.Aria(CodeManque)" />
            </div>
        </div>
        @if (validateurs.Count == 0)
        {
            <p class="detail" style="margin: 0">Aucun pharmacien ou assistant n’a encore choisi de code comptoir (en haut de l’écran, « Mon code comptoir »).</p>
        }
    };

    private int totalVentes, pageVentes = 1, tailleVentes = Pagination.TailleParDefaut;

    protected override async Task OnInitializedAsync()
    {
        numero = NumeroInitial;
        // « ← Retour » : page de la liste des ventes retrouvée
        Historique.Suivre("annulation", e => { e.Mettre("page", pageVentes); e.Mettre("taille", tailleVentes); });
        var r = Historique.Restaurer("annulation");
        if (r is not null) (pageVentes, tailleVentes) = (r.Entier("page") ?? 1, r.Entier("taille") ?? tailleVentes);
        await ChargerVentesAsync(NumeroInitial is null ? pageVentes : 1, tailleVentes);
        if (ventes.Count == 1 && NumeroInitial is not null && ventes[0].Statut == "validee") Choisir(ventes[0]);
    }

    private async Task ToucheRecherche(KeyboardEventArgs e) { if (e.Key == "Enter") await RechercherAsync(); }

    private Task RechercherAsync() => ChargerVentesAsync(1, tailleVentes);

    /// <summary>Ventes de la caisse ouverte du poste, par page ; avec un n° de ticket, cette vente seule.</summary>
    private async Task ChargerVentesAsync(int numeroPage, int taille)
    {
        (erreur, choisie, mode, resultatBoite) = (null, null, null, null);
        var (p, e) = await Api.VentesAnnulablesPageAsync(numero, numeroPage, taille);
        if (p is null) { (ventes, erreur) = ([], e); return; }
        if (p.Lignes.Count == 0 && numeroPage > 1) { await ChargerVentesAsync(1, taille); return; }
        (ventes, totalVentes, pageVentes, tailleVentes, recherche) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille, true);
    }

    private void Choisir(VenteAnnulableDto v)
    {
        (choisie, mode, retour, saisies, motif, validateur, code, controle, erreur) = (v, null, null, [], null, null, null, false, null);
        (solderDette, patientDette, rechercheDette, patientsTrouves, rechercheDetteFaite, accordClient) = (null, null, null, [], false, false);
    }

    private void ChangerDeVente() => (choisie, mode, retour, erreur) = (null, null, null, null);

    private async Task ChargerValidateursAsync()
    {
        // Retour : la validation peut redevenir nécessaire (accord retiré) ; la liste est chargée dès que l'employé n'a pas le droit
        if (mode == "retour" ? Session.A(DroitRequis) || validateurs.Count > 0 : !ValidationRequise) return;
        (validateurs, _) = mode == "retour" ? await Api.ValidateursRetourAsync() : await Api.ValidateursAnnulationAsync();
    }

    // Trop-payé d'une régularisation annulée (script 098) : choix du patient, autres dettes soldées (plus anciennes par défaut) et le reste remboursé
    private List<VenteACreditDto> autresDettes = [];
    private readonly Dictionary<long, decimal> imputationsTropPaye = [];
    private decimal RembourseTropPaye => Math.Max(0, (choisie?.RegularisationTropPaye ?? 0) - imputationsTropPaye.Values.Sum());

    private void ImputerTropPaye(long vente, object? valeur)
    {
        var reste = autresDettes.FirstOrDefault(d => d.Id == vente)?.Reste ?? 0;
        var autres = imputationsTropPaye.Where(i => i.Key != vente).Sum(i => i.Value);
        var m = decimal.TryParse(valeur?.ToString()?.Replace(',', '.'), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var x) ? x : 0;
        imputationsTropPaye[vente] = Math.Clamp(m, 0, Math.Min(reste, Math.Max(0, (choisie?.RegularisationTropPaye ?? 0) - autres)));
    }

    private async Task ChargerAutresDettesAsync()
    {
        autresDettes = [];
        imputationsTropPaye.Clear();
        if (choisie is not { RegularisationTropPaye: > 0, PatientId: { } patient } v) return;
        var (s, _) = await Api.SituationCreditAsync(patient);
        autresDettes = (s?.Ventes ?? []).Where(d => d.Id != v.Id && d.Reste > 0).OrderBy(d => d.Date).ToList();
        // Par défaut (comme « Encaisser une dette ») : les plus anciennes soldées jusqu'à couvrir le trop-payé
        var reste = v.RegularisationTropPaye;
        foreach (var d in autresDettes)
        {
            if (reste <= 0) break;
            var part = Math.Min(d.Reste, reste);
            imputationsTropPaye[d.Id] = part;
            reste -= part;
        }
    }

    private async void ChoisirMode(string m)
    {
        mode = m;
        (solderDette, patientDette, rechercheDette, patientsTrouves, rechercheDetteFaite, accordClient) = (null, null, null, [], false, false);
        if (m == "annulation") await ChargerAutresDettesAsync();
        await ChargerValidateursAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChoisirModeAsync(string m)
    {
        mode = m;
        var (r, e) = await Api.VenteRetournableAsync(choisie!.Id);
        if (e is not null) { (erreur, mode) = (e, null); return; }
        retour = r;
        (solderDette, patientDette, rechercheDette, patientsTrouves, rechercheDetteFaite, accordClient) = (null, null, null, [], false, false);
        saisies = r!.Lignes.Select(l => new SaisieRetour(l)).ToList();
        await ChargerValidateursAsync();
    }

    private static void BasculerBoite(SaisieRetour s, long boite, ChangeEventArgs e)
    {
        if (e.Value is true) s.Boites.Add(boite); else s.Boites.Remove(boite);
    }

    private string? Controler()
    {
        controle = true;
        return MotifManque ? "Indiquez le motif."
            : AccordManque ? "Pour déduire le remboursement de sa dette, le client doit l’accepter : cochez son accord, ou rendez-lui l’argent."
            : ValidateurManque ? "Choisissez le pharmacien ou l’assistant qui valide."
            : CodeManque ? "Tapez son code comptoir (4 à 6 chiffres)." : null;
    }

    private async Task AnnulerAsync()
    {
        if ((erreur = Controler()) is not null || choisie is null) return;
        enCours = true;
        if (DetteAProposer && solderDette is null) { erreur = "Ce patient doit de l’argent : choisissez de déduire le remboursement de sa dette, ou de le rendre."; enCours = false; return; }
        var (r, e) = await Api.AnnulerVenteAsync(choisie.Id, new AnnulationVenteRequete(motif, ValidationRequise ? validateur : null, ValidationRequise ? code : null,
            DetteAProposer && solderDette == true, DetteAProposer && solderDette == true ? patientDette?.Id : null, DetteAProposer && solderDette == true && accordClient,
            choisie.RegularisationTropPaye > 0 ? imputationsTropPaye.Where(i => i.Value > 0).Select(i => new ImputationTropPayeDto(i.Key, i.Value)).ToList() : null,
            choisie.RegularisationTropPaye > 0 ? RembourseTropPaye : null));
        (enCours, code) = (false, null);
        if (e is not null) { erreur = e; return; }
        message = $"Vente {r!.Numero} annulée{(r.ValidePar is { } p ? $", validée par {p}" : "")}."
                  + (r.DetteDiminuee > 0 ? $" Dette du patient diminuée de {Libelles.Dinars(r.DetteDiminuee, 2)}." : "")
                  + (r.ARendre > 0 ? $" À rendre au patient : {Libelles.Dinars(r.ARendre, 2)} ({Libelles.ModePaiement(r.Mode)})." : r.DetteDiminuee > 0 ? " Rien à rendre." : "")
                  + (r.RegularisationDetteAnnulee > 0 ? $" Régularisation de part organisme annulée : {Libelles.Dinars(r.RegularisationDetteAnnulee, 2)} retirés de sa dette." : "")
                  + (r.RegularisationImputee > 0 ? $" Trop-payé de la régularisation déduit de ses autres dettes : {Libelles.Dinars(r.RegularisationImputee, 2)}." : "")
                  + (r.RegularisationRembourse > 0 ? $" Trop-payé de la régularisation rendu par le tiroir : {Libelles.Dinars(r.RegularisationRembourse, 2)} (bon {r.BonSortieNumero})." : "")
                  + " Stock remis sur les mêmes lots.";
        await OnAnnulee.InvokeAsync();
    }

    private async Task EnregistrerRetourAsync()
    {
        if ((erreur = Controler()) is not null || choisie is null) return;
        var lignes = saisies.Where(s => s.Rendue > 0)
            .Select(s => new LigneRetourClientDto(s.Ligne.LigneVenteId, s.Rendue, s.Destination, s.Ligne.Boites.Count > 0 ? s.Boites.ToList() : null)).ToList();
        if (lignes.Count == 0) { erreur = "Indiquez au moins un produit rendu."; return; }
        if (DetteAProposer && solderDette is null) { erreur = "Ce patient doit de l’argent : choisissez de déduire le remboursement de sa dette, ou de le rendre."; return; }
        enCours = true;
        var (r, e) = await Api.RetourClientAsync(choisie.Id, new RetourClientRequete(motif, lignes, ValidationRequise ? validateur : null, ValidationRequise ? code : null,
            DetteAProposer && solderDette == true, DetteAProposer && solderDette == true ? patientDette?.Id : null, DetteAProposer && solderDette == true && accordClient));
        (enCours, code) = (false, null);
        if (e is not null) { erreur = e; return; }
        message = $"Retour enregistré sur la vente {r!.Numero}{(r.ValidePar is { } p ? $", validé par {p}" : "")} : "
                  + $"{r.RemisEnStock} boîte(s) remise(s) en stock, {r.ADetruire} à détruire."
                  + (r.DetteDiminuee > 0 ? $" Dette du patient diminuée de {Libelles.Dinars(r.DetteDiminuee, 2)}." : "")
                  + (r.ARendre > 0 ? $" À rendre au patient : {Libelles.Dinars(r.ARendre, 2)} ({Libelles.ModePaiement(r.Mode)})." : r.DetteDiminuee > 0 ? " Rien à rendre." : "");
        await OnAnnulee.InvokeAsync();
    }
}
