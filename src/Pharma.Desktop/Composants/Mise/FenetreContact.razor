@implements IDisposable
@inject FichesContact Fiches
@inject ApiClient Api
@inject SessionPoste Session
@inject NavigationManager Nav
@inject HistoriqueNavigation Historique

@* Fenêtre unique de la fiche contact, posée dans la mise en page : coordonnées, situation, raccourcis vers les écrans du tiers.
   Coordonnées d'un patient, d'un grossiste ou d'une entreprise modifiables ici, selon les droits ; fiche complète d'un patient
   (identité, assurance, plafond de crédit) modifiable avec le droit de vendre, comme sa création à la caisse.
   Fermeture : « Fermer », la touche Échap ou un clic à côté, sauf pendant une modification (pour ne pas perdre la saisie). *@
@if (Fiches.Ouverte is { } o)
{
    <div class="voile voile-contact" role="dialog" aria-modal="true" aria-labelledby="t-contact" tabindex="-1" @ref="fenetre"
         @onkeydown="Touche" @onkeydown:stopPropagation="true" @onclick="ClicACote" @onclick:stopPropagation="true">
        <section class="panneau fenetre-contact" @onclick:stopPropagation="true">
            <div class="titre-fenetre">
                <div>
                    <h2 id="t-contact">@(fiche?.Nom ?? o.Nom)</h2>
                    <p class="sous-titre">@(fiche?.Precision ?? Libelles.TypeContact(o.Type))@(fiche is { Actif: false } ? " · inactif" : "")</p>
                </div>
                <button type="button" class="btn" @onclick="Fiches.Fermer">Fermer</button>
            </div>

            @if (erreur is not null)
            {
                <div class="erreur" role="alert">@erreur</div>
            }
            else if (fiche is null)
            {
                <Chargement />
            }
            else if (patient is not null)
            {
                <h3>Modifier la fiche du patient</h3>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 200px"><label for="fp-nom" class="etiquette-champ requis">Nom</label>
                        <input id="fp-nom" data-champ="nom_patient" type="text" maxlength="120" @bind="patient.Nom" /></div>
                    <div class="champ" style="flex: 1 1 200px"><label for="fp-prenom">Prénom</label>
                        <input id="fp-prenom" type="text" maxlength="120" @bind="patient.Prenom" /></div>
                    <div class="champ" style="flex: 0 1 170px"><label for="fp-naiss">Date de naissance</label>
                        <input id="fp-naiss" data-champ="date_naissance" type="date" @bind="patient.DateNaissance" /></div>
                </div>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 180px"><label for="fp-tel">Téléphone</label>
                        <input id="fp-tel" data-champ="telephone" type="tel" maxlength="30" @bind="patient.Telephone" /></div>
                    <div class="champ" style="flex: 1 1 240px"><label for="fp-mail">E-mail</label>
                        <input id="fp-mail" data-champ="email" type="email" maxlength="120" @bind="patient.Email" /></div>
                </div>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 200px"><label for="fp-org">Organisme</label>
                        <select id="fp-org" @bind="patient.OrganismeId">
                            <option value="">Aucun (non assuré)</option>
                            @foreach (var org in organismes)
                            {
                                <option value="@org.Id">@org.Nom</option>
                            }
                        </select></div>
                    <div class="champ" style="flex: 1 1 180px"><label for="fp-assure">N° d’assuré</label>
                        <input id="fp-assure" type="text" maxlength="40" @bind="patient.NumAssure" /></div>
                    <div class="champ" style="flex: 0 1 160px"><label for="fp-plafond">Plafond de crédit (DA)</label>
                        <input id="fp-plafond" data-champ="plafond" type="number" min="0" step="1" @bind="patient.PlafondCredit" /></div>
                </div>
                <label class="case"><input type="checkbox" @bind="patient.Chronique" /> Malade chronique</label>
                <p class="detail" style="margin: 0">Dette actuelle : @Libelles.Dinars(patient.SoldeCredit, 2) (elle ne se modifie pas ici : règlement ou correction depuis le relevé de dette). Chaque changement est inscrit au journal.</p>
                @if (erreurSaisie is not null) { <div class="erreur" role="alert">@erreurSaisie</div> }
                <div class="filtres">
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerPatientAsync">Enregistrer</button>
                    <button type="button" class="btn" disabled="@enCours" @onclick="() => (patient, erreurSaisie) = (null, null)">Annuler</button>
                </div>
            }
            else if (saisie is not null)
            {
                <h3>Modifier les coordonnées</h3>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 180px"><label for="fc-tel">Téléphone</label>
                        <input id="fc-tel" data-champ="telephone" type="tel" maxlength="30" @bind="saisie.Telephone" /></div>
                    <div class="champ" style="flex: 1 1 240px"><label for="fc-mail">E-mail</label>
                        <input id="fc-mail" data-champ="email" type="email" maxlength="120" @bind="saisie.Email" /></div>
                </div>
                @if (fiche.Type != "patient")
                {
                    <div class="champ"><label for="fc-adr">Adresse</label><input id="fc-adr" data-champ="adresse" type="text" maxlength="300" @bind="saisie.Adresse" /></div>
                }
                @if (fiche.Type == "client")
                {
                    <div class="champ" style="max-width: 220px"><label for="fc-delai">Délai de paiement (jours)</label>
                        <input id="fc-delai" data-champ="delai_paiement" type="number" min="1" max="365" @bind="saisie.DelaiPaiementJours" /></div>
                }
                <p class="detail" style="margin: 0">Toutes ces informations sont facultatives ; l’e-mail est utile pour joindre @(fiche.Type == "patient" ? "le patient" : fiche.Type == "grossiste" ? "le grossiste" : "l’entreprise"). La modification est inscrite au journal.</p>
                @if (erreurSaisie is not null) { <div class="erreur" role="alert">@erreurSaisie</div> }
                <div class="filtres">
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">Enregistrer</button>
                    <button type="button" class="btn" disabled="@enCours" @onclick="() => (saisie, erreurSaisie) = (null, null)">Annuler</button>
                </div>
            }
            else
            {
                @if (message is not null) { <div class="succes" role="status">@message</div> }
                <h3>Coordonnées</h3>
                @if (fiche.Coordonnees.Count == 0)
                {
                    <p class="detail" style="margin: 0">
                        @(fiche.CoordonneesMasquees ? "Les coordonnées d’un employé ne sont visibles que par lui-même et par le titulaire." : "Aucune coordonnée enregistrée.")
                    </p>
                }
                else
                {
                    <dl class="fiche-infos">
                        @foreach (var i in fiche.Coordonnees)
                        {
                            <dt>@i.Libelle</dt>
                            <dd>
                                @switch (i.Genre)
                                {
                                    case "telephone":
                                        <strong>@i.Valeur</strong>
                                        break;
                                    case "email":
                                        <a href="@($"mailto:{i.Valeur}")">@i.Valeur</a>
                                        break;
                                    case "manquant":
                                        <span class="pastille attention">@i.Valeur</span>
                                        break;
                                    default:
                                        @i.Valeur
                                        break;
                                }
                                @if (i.Genre is "telephone" or "email")
                                {
                                    <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => CopierAsync(i.Valeur)">Copier</button>
                                }
                            </dd>
                        }
                    </dl>
                }

                @if (fiche.Situation.Count > 0)
                {
                    <h3>Situation</h3>
                    <dl class="fiche-infos">
                        @foreach (var i in fiche.Situation)
                        {
                            <dt>@i.Libelle</dt>
                            <dd class="@(i.Genre == "montant_du" ? "montant-du" : null)">@i.Valeur</dd>
                        }
                    </dl>
                }

                @if (Raccourcis.Count > 0 || fiche.Modifiable || FichePatientModifiable)
                {
                    <div class="filtres">
                        @if (FichePatientModifiable)
                        {
                            <button type="button" class="btn" disabled="@enCours" @onclick="ModifierPatientAsync">Modifier la fiche du patient</button>
                        }
                        else if (fiche.Modifiable)
                        {
                            <button type="button" class="btn" @onclick="Modifier">Modifier les coordonnées</button>
                        }
                        @foreach (var (libelle, route) in Raccourcis)
                        {
                            <button type="button" class="btn" @onclick="() => Aller(route)">@libelle</button>
                        }
                    </div>
                }
                @if (copie is not null) { <p class="detail" role="status" style="margin: 0">@copie</p> }
            }
        </section>
    </div>
}

@code {
    private ElementReference fenetre;
    private FicheContactDto? fiche;
    private string? erreur, copie, message, erreurSaisie;
    private (string Type, long Id)? chargee;
    private bool aFocaliser, enCours;

    private sealed class Saisie
    {
        public string? Telephone { get; set; }
        public string? Email { get; set; }
        public string? Adresse { get; set; }
        public int? DelaiPaiementJours { get; set; }
    }
    private Saisie? saisie;

    // ---- Fiche complète d'un patient ----
    private sealed class SaisiePatient
    {
        public long Id { get; init; }
        public string Nom { get; set; } = "";
        public string? Prenom { get; set; }
        public DateOnly? DateNaissance { get; set; }
        public string? Telephone { get; set; }
        public string? Email { get; set; }
        public string? NumAssure { get; set; }
        public long? OrganismeId { get; set; }
        public bool Chronique { get; set; }
        public decimal PlafondCredit { get; set; }
        public decimal SoldeCredit { get; init; }
    }
    private SaisiePatient? patient;
    private List<OrganismeDto> organismes = [];

    private bool FichePatientModifiable => fiche?.Type == "patient" && Session.A("caisse.vendre");

    private async Task ModifierPatientAsync()
    {
        if (fiche is null) return;
        (enCours, erreurSaisie, message, copie) = (true, null, null, null);
        try
        {
            var (f, e) = await Api.FichePatientAsync(fiche.Id);
            if (f is null) { erreurSaisie = e ?? "Patient introuvable."; return; }
            if (organismes.Count == 0) organismes = (await Api.OrganismesAsync()).Item1;
            patient = new SaisiePatient
            {
                Id = f.Id, Nom = f.Nom, Prenom = f.Prenom, DateNaissance = f.DateNaissance, Telephone = f.Telephone, Email = f.Email,
                NumAssure = f.NumAssure, OrganismeId = f.OrganismeId, Chronique = f.Chronique, PlafondCredit = f.PlafondCredit, SoldeCredit = f.SoldeCredit
            };
        }
        finally { enCours = false; }
    }

    private async Task EnregistrerPatientAsync()
    {
        if (fiche is null || patient is not { } p) return;
        (enCours, erreurSaisie) = (true, null);
        try
        {
            var e = await Api.ModifierPatientAsync(new FichePatientDto(p.Id, p.Nom, p.Prenom, p.DateNaissance, p.Telephone, p.Email, p.NumAssure,
                p.OrganismeId, p.Chronique, p.PlafondCredit));
            if (e is not null) { erreurSaisie = e; return; }
            var (f, err) = await Api.ContactAsync(fiche.Type, fiche.Id);
            (fiche, erreur, patient, message) = (f ?? fiche, err, null, "Fiche du patient enregistrée.");
        }
        finally { enCours = false; }
    }

    private void Modifier()
    {
        if (fiche?.Saisie is not { } s) return;
        (saisie, erreurSaisie, message, copie) = (new Saisie { Telephone = s.Telephone, Email = s.Email, Adresse = s.Adresse, DelaiPaiementJours = s.DelaiPaiementJours }, null, null, null);
    }

    private async Task EnregistrerAsync()
    {
        if (fiche is null || saisie is null) return;
        (enCours, erreurSaisie) = (true, null);
        try
        {
            var e = await Api.ModifierCoordonneesContactAsync(fiche.Type, fiche.Id, new CoordonneesContactDto(saisie.Telephone, saisie.Email, saisie.Adresse, saisie.DelaiPaiementJours));
            if (e is not null) { erreurSaisie = e; return; }
            var (f, err) = await Api.ContactAsync(fiche.Type, fiche.Id);
            (fiche, erreur, saisie, message) = (f ?? fiche, err, null, "Coordonnées enregistrées.");
        }
        finally { enCours = false; }
    }

    // Pendant une modification, un clic à côté ou Échap ne ferme pas la fiche : la saisie serait perdue
    private void ClicACote() { if (saisie is null && patient is null) Fiches.Fermer(); }

    // La fiche se ferme quand on change d'écran ou que la session se ferme : elle ne reste jamais sur un autre écran ni sur
    // l'écran de connexion (données d'un employé, d'un patient)
    protected override void OnInitialized()
    {
        Fiches.Changee += Rafraichir;
        Nav.LocationChanged += SurNavigation;
        Session.AvantFermeture += Fiches.Fermer;
    }

    public void Dispose()
    {
        Fiches.Changee -= Rafraichir;
        Nav.LocationChanged -= SurNavigation;
        Session.AvantFermeture -= Fiches.Fermer;
    }

    // Changement d'écran : la fiche se ferme ; après un « Retour », celle qui était ouverte sur l'écran retrouvé se rouvre
    private void SurNavigation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (Fiches.Ouverte is not null) Fiches.Fermer();
        if (Historique.PrendreFicheARouvrir() is { } f) Fiches.Ouvrir(f.Type, f.Id, f.Nom);
    }

    private void Rafraichir() => _ = InvokeAsync(async () =>
    {
        if (Fiches.Ouverte is not { } o) { (fiche, erreur, copie, chargee, saisie, patient, message, erreurSaisie) = (null, null, null, null, null, null, null, null); StateHasChanged(); return; }
        if (chargee == (o.Type, o.Id)) return;
        (fiche, erreur, copie, chargee, aFocaliser, saisie, patient, message, erreurSaisie) = (null, null, null, (o.Type, o.Id), true, null, null, null, null);
        StateHasChanged();
        var (f, e) = await Api.ContactAsync(o.Type, o.Id);
        if (chargee != (o.Type, o.Id)) return;   // une autre fiche a été demandée entre-temps
        (fiche, erreur) = (f, e);
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool premierRendu)
    {
        if (!aFocaliser || Fiches.Ouverte is null) return;
        aFocaliser = false;
        try { await fenetre.FocusAsync(); } catch (InvalidOperationException) { }
    }

    private void Touche(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (saisie is not null || patient is not null) (saisie, patient, erreurSaisie) = (null, null, null);   // Échap annule d'abord la modification
        else Fiches.Fermer();
    }

    // La fiche reste ouverte jusqu'au changement d'écran : l'historique la retient et « Retour » la rouvre
    private void Aller(string route) => Nav.NavigateTo(route);

    private async Task CopierAsync(string valeur)
    {
        try
        {
            System.Windows.Clipboard.SetText(valeur);
            copie = $"« {valeur} » copié.";
        }
        catch (System.Runtime.InteropServices.ExternalException) { copie = "Copie impossible : le presse-papiers est occupé, réessayez."; }
        await Task.CompletedTask;
    }

    /// <summary>Écrans du tiers que l'employé a le droit d'ouvrir.</summary>
    private List<(string Libelle, string Route)> Raccourcis
    {
        get
        {
            var liste = new List<(string, string)>();
            if (fiche is null) return liste;
            var nom = Uri.EscapeDataString(fiche.Nom);
            switch (fiche.Type)
            {
                case "patient":
                    if (Session.A("caisse.vendre")) liste.Add(("Relevé de dette", $"caisse?credit={fiche.Id}"));
                    if (Session.A("factures.gerer")) liste.Add(("Factures", $"factures?q={nom}"));
                    break;
                case "grossiste":
                    if (Session.A("achats.regler")) liste.Add(("Règlements et relevé", $"achats?onglet=reglements&grossiste={fiche.Id}"));
                    if (Session.A("achats.commander") || Session.A("achats.receptionner")) liste.Add(("Bons de commande", $"achats?onglet=commandes&grossiste={fiche.Id}"));
                    break;
                case "organisme":
                case "client":
                    if (Session.A("factures.gerer")) liste.Add(("Factures", $"factures?q={nom}"));
                    break;
                case "employe":
                    if (Session.A("admin.parametres")) liste.Add(("Journal des actions", $"admin/caisse?employe={nom}"));
                    if (Session.A("admin.utilisateurs")) liste.Add(("Utilisateurs et droits", "admin/droits"));
                    break;
            }
            return liste;
        }
    }
}
