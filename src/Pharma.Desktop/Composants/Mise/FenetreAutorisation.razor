@implements IDisposable
@inject DemandesAutorisation Demandes
@inject SessionPoste Session
@inject ApiClient Api
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Routing

@* « Faire autoriser » : action refusée faute de droit ; un employé qui a ce droit l'autorise avec son code comptoir.
   L'action est alors rejouée et inscrite au journal avec son nom (« autorisé par »). *@
@if (Demandes.EnCours is { } d)
{
    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-autorisation">
        <section class="panneau" style="max-width: @(d.Detail is null ? "520px" : "760px"); width: 100%">
            <h2 id="t-autorisation">Faire autoriser</h2>
            <div class="bandeau-attention" role="note">@d.Message</div>
            @if (d.Detail is { } detail && detail.Lignes.Count > 0)
            {
                @* Détail facultatif de la demande (ex. prix des lignes d'un volet Chifa) : ce que le valideur autorise *@
                <div class="tableau-cadre" style="max-height: 240px; overflow: auto">
                    <table class="tableau" style="min-width: 0">
                        <caption style="text-align: left; font-weight: 600">@detail.Titre</caption>
                        <thead><tr>@foreach (var c in detail.Colonnes) { <th scope="col">@c</th> }</tr></thead>
                        <tbody>
                            @foreach (var l in detail.Lignes)
                            {
                                <tr>@foreach (var v in l) { <td>@v</td> }</tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="champ">
                <label for="au-valideur" class="requis">Autorisé par</label>
                <select id="au-valideur" data-champ="valideur" @bind="valideur">
                    <option value="">Choisir…</option>
                    @foreach (var v in valideurs) { <option value="@v.Reference">@v.NomComplet</option> }
                </select>
            </div>
            <div class="champ">
                <label for="au-code" class="requis">Son code comptoir</label>
                <input id="au-code" data-champ="code_autorisation" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="off"
                       onbeforeinput="@CodeComptoirSaisie.FiltreChiffres" @bind="code" @bind:event="oninput" @onkeydown="ToucheAsync" />
            </div>
            @if (valideurs.Count == 0 && charge)
            {
                <p class="detail" style="margin: 0">
                    @if (d.Seuil is { } seuil)
                    {
                        <text>Aucun employé dont le maximum de remise atteint @seuil.ToString("0.##") % n’a de code comptoir (« Mon code comptoir », en haut de l’écran).</text>
                    }
                    else
                    {
                        <text>Aucun employé qui a ce droit n’a encore choisi de code comptoir (« Mon code comptoir », en haut de l’écran).</text>
                    }
                </p>
            }
            <div class="filtres">
                <button type="button" class="btn btn-principal" disabled="@(string.IsNullOrEmpty(valideur) || CodeComptoirSaisie.Erreur(code, nouveauCode: false) is not null)"
                        @onclick="Autoriser">Autoriser</button>
                <button type="button" class="btn" @onclick="() => Demandes.Repondre(null)">Annuler</button>
            </div>
        </section>
    </div>
}

@code {
    private List<ValideurDto> valideurs = [];
    private string? valideur, code;
    private bool charge;
    private DemandesAutorisation.Demande? chargee;

    // Session fermée (déconnexion, changement d'utilisateur, inactivité) : la demande en cours est abandonnée, la fenêtre et
    // la liste des employés habilités ne restent pas sur l'écran de connexion
    // Changement d'écran : la demande appartient à l'écran quitté, elle est annulée (la fenêtre ne suit pas la navigation)
    protected override void OnInitialized() { Demandes.Changee += Rafraichir; Session.AvantFermeture += Abandonner; Nav.LocationChanged += Navigation; }
    public void Dispose() { Demandes.Changee -= Rafraichir; Session.AvantFermeture -= Abandonner; Nav.LocationChanged -= Navigation; }
    private void Abandonner() { if (Demandes.EnCours is not null) Demandes.Repondre(null); }
    private void Navigation(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(Abandonner);

    private void Rafraichir() => _ = InvokeAsync(async () =>
    {
        if (Demandes.EnCours is { } d && !ReferenceEquals(d, chargee))
        {
            (chargee, code, charge) = (d, null, false);
            StateHasChanged();
            // Remise refusée : seuls les employés dont le maximum de remise couvre le pourcentage demandé (d.Seuil)
            (valideurs, _) = await Api.ValideursAsync(d.Permission, d.Seuil);
            valideur = valideurs.Count == 1 ? valideurs[0].Reference : valideur;
            charge = true;
        }
        StateHasChanged();
    });

    private void Autoriser()
    {
        if (string.IsNullOrEmpty(valideur) || code is null) return;
        Demandes.Repondre((valideur, code));
        code = null;
    }

    private Task ToucheAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Autoriser();
        return Task.CompletedTask;
    }
}
