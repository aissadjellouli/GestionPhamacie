@inject ApiClient Api
@inject IdentitePoste Identite
@implements IDisposable

@* Liste des postes autorisés (2026-11-24) : sur l'écran de connexion, un PC non autorisé (non prouvé) ne voit que la saisie du code donné par le titulaire.
   Preuve toujours exigée (décision du titulaire du 2026-11-27, script 174) : plus de bandeau « Plus tard », le formulaire de connexion de l'employé
   n'apparaît (Connexion.razor) qu'une fois le poste autorisé ; l'état est rendu au parent par EtatChange. Saisie gardée après un refus. *@
@if (etat is { Prouve: false })
{
    <form class="carte autorisation-poste" @onsubmit="ValiderAsync" aria-labelledby="t-autoriser-poste">
        <h2 id="t-autoriser-poste" style="margin: 0">Autoriser ce poste</h2>
        <p class="detail" style="margin: 0">@Texte</p>
        <div class="champ">
            <label for="ap-code" class="requis">Code du poste</label>
            <input id="ap-code" type="text" autocomplete="off" maxlength="9" placeholder="XXXX-XXXX" autofocus @bind="code" @bind:event="oninput"
                   class="@Obligatoire.Classe(controle && string.IsNullOrWhiteSpace(code))" aria-invalid="@Obligatoire.Aria(controle && string.IsNullOrWhiteSpace(code))" />
        </div>
        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        <div class="actions-fenetre" style="margin-top: 0">
            <button class="btn btn-principal" type="submit" disabled="@enCours">Autoriser</button>
        </div>
    </form>
}
@if (autorise is not null) { <div class="succes" role="status">Poste autorisé : « @autorise ».</div> }

@code {
    /// <summary>
    /// État du poste rendu au parent : vrai = poste prouvé (connexion possible), faux = PC non autorisé (seule la saisie du code est montrée),
    /// null = état inconnu (serveur injoignable : le formulaire de connexion reste montré, il affichera l'erreur du serveur).
    /// </summary>
    [Parameter] public EventCallback<bool?> EtatChange { get; set; }

    public const string TexteNonAutorise = "Ce PC doit d'abord être autorisé : demandez un code au titulaire (Administration › Postes autorisés).";

    private EtatPosteAutoriseDto? etat;
    private bool enCours, controle;
    private string code = "";
    private string? erreur, autorise;

    private string Texte => (etat?.Refus ?? Identite.DernierRefus) switch
    {
        "poste_revoque" => "Ce poste a été révoqué ou remplacé par le titulaire : il doit être autorisé de nouveau. " + TexteNonAutorise,
        "preuve_horloge" => "L’heure de ce PC est trop éloignée de celle du serveur : réglez l’horloge du PC, puis relancez le logiciel.",
        "poste_non_prouve" when Identite.Enrole => "Ce poste n’a pas pu prouver son identité : faites-le autoriser de nouveau. " + TexteNonAutorise,
        _ => TexteNonAutorise
    };

    protected override async Task OnInitializedAsync()
    {
        Identite.Changee += Relire;
        await LireEtatAsync();
    }

    private async Task LireEtatAsync()
    {
        etat = await Api.EtatAutorisationPosteAsync();
        await EtatChange.InvokeAsync(etat?.Prouve);
    }

    private void Relire() => _ = InvokeAsync(async () =>
    {
        try
        {
            await LireEtatAsync();
            StateHasChanged();
        }
        catch (Exception e) { App.NoterErreur(e); }
    });

    private async Task ValiderAsync()
    {
        controle = true;
        if (string.IsNullOrWhiteSpace(code)) { erreur = "Tapez le code donné par le titulaire."; return; }
        (enCours, erreur) = (true, null);
        try
        {
            erreur = await Api.AutoriserCePosteAsync(code.Trim());
            if (erreur is not null) return;
            autorise = Identite.Nom;
            (code, controle) = ("", false);
            await LireEtatAsync();
        }
        finally { enCours = false; }
    }

    public void Dispose() => Identite.Changee -= Relire;
}
