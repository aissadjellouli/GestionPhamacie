@inject ApiClient Api
@inject SessionPoste Session

@* Classement d'un produit : catégorie (médicament, dermo-cosmétique, hygiène…) pour les totaux « médicaments » et « autres produits »
   de la caisse, et liste I ou II d'un psychotrope, qui fixe son SHP. Droit de créer un produit. *@

<section class="panneau" aria-labelledby="t-classement">
    <div>
        <h2 id="t-classement">Catégorie des produits</h2>
        <p class="sous-titre">
            La catégorie sépare les médicaments des autres produits (dermo-cosmétique, hygiène, bébé et maman…) sur la caisse, le ticket et les rapports.
            Pour un psychotrope, indiquez sa liste (I ou II) : elle fixe son SHP, 2,50 DA ou 1,50 DA par boîte (0 tant qu’elle n’est pas indiquée).
        </p>
    </div>
    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }
    @if (!Session.A("catalogue.creer"))
    {
        <p class="detail" style="margin: 0">Le classement d’un produit demande le droit de créer un produit.</p>
    }
    else
    {
        <div class="achats-ligne">
            <ChoixProduit Id="cl-produit" Libelle="Produit" Style="flex: 1 1 320px" OnChoisi="ChoisirAsync" OnEfface="() => courant = null" />
        </div>
        @if (courant is { } c)
        {
            <div class="carte" style="display: flex; flex-direction: column; gap: 10px">
                <strong>@c.Nom</strong>
                <span class="detail">Classe : @Libelles.Classe(c.Classe)</span>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 260px">
                        <label for="cl-cat">Catégorie</label>
                        <select id="cl-cat" data-champ="categorie" @bind="categorie">
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Code">@cat.Libelle@(cat.Medicament ? "" : " (autre produit)")</option>
                            }
                        </select>
                    </div>
                    @if (c.Classe == "psychotrope")
                    {
                        <div class="champ" style="flex: 0 1 220px">
                            <label for="cl-liste">Liste du psychotrope (SHP)</label>
                            <select id="cl-liste" data-champ="liste_psychotrope" @bind="liste">
                                <option value="">À indiquer (SHP 0)</option>
                                <option value="liste_i">Liste I (SHP 2,50 DA)</option>
                                <option value="liste_ii">Liste II (SHP 1,50 DA)</option>
                            </select>
                        </div>
                    }
                    <button type="button" class="btn btn-principal" style="align-self: flex-end" disabled="@enCours" @onclick="EnregistrerAsync">Enregistrer</button>
                </div>
            </div>
        }
    }
</section>

@code {
    private List<CategorieProduitDto> categories = [];
    private ClassementProduitDto? courant;
    private string categorie = "medicament";
    private string liste = "";
    private bool enCours;
    private string? erreur, message;

    protected override async Task OnInitializedAsync() => (categories, erreur) = await Api.CategoriesProduitsAsync();

    private async Task ChoisirAsync(ProduitDto p)
    {
        (erreur, message) = (null, null);
        var (c, e) = await Api.ClassementProduitAsync(p.Id);
        (courant, erreur) = (c, e);
        if (c is not null) (categorie, liste) = (c.Categorie, c.ListePsychotrope ?? "");
    }

    private async Task EnregistrerAsync()
    {
        if (courant is not { } produit) return;
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var e = await Api.ModifierClassementProduitAsync(produit.ProduitId, categorie, string.IsNullOrEmpty(liste) ? null : liste);
            if (e is not null) { erreur = e; return; }
            message = $"« {produit.Nom} » classé : {categories.FirstOrDefault(x => x.Code == categorie)?.Libelle ?? categorie}.";
            (courant, _) = await Api.ClassementProduitAsync(produit.ProduitId);
        }
        finally { enCours = false; }
    }
}
