@implements IDisposable
@inject ApiClient Api
@inject SessionPoste Session
@inject NavigationManager Nav
@inject ReglagesPoste Reglages
@inject ConfigurationPoste Configuration
@inject ImprimanteTickets Tickets
@inject IJSRuntime JS

@* Barre d'état en bas de la fenêtre (charte graphique, « Barre d'état », maquette validée le 2026-11-21). Fixes, toujours affichés : liaison
   au serveur, poste et vendeur connecté, date et heure (version dans l'infobulle). Ponctuelles, au centre, seulement s'il y a une
   information : pastilles (PastillesBarre) ; un clic ouvre l'écran correspondant pour qui y a droit. Avant la connexion : fixes seulement
   (et l'imprimante de tickets en échec). *@
@if (InjoignableTropLongtemps)
{
    @* Serveur injoignable plus de N secondes (poste.json, DelaiServeurInjoignableSecondes) : consigne claire (2026-11-16) *@
    <div class="bandeau-attention" role="alert" style="position: fixed; left: 0; right: 0; bottom: 32px; z-index: 50; margin: 0">
        @if (LiaisonServeur.MessagePrincipal(Api.Liaison) is { } refus)
        {
            @refus
        }
        else
        {
            <text>Serveur injoignable : vérifiez le PC serveur ou basculez sur le 2e serveur (procédure « 2e serveur » ou « PC serveur en panne »).</text>
        }
        @if (Reglages.Actuelles.AdresseApiSecours is { Length: > 0 } secours && !basculeFaite)
        {
            <button type="button" class="btn" style="margin-left: 8px" disabled="@verificationSecours" @onclick="BasculerPosteAsync">Basculer sur le 2e serveur (@secours) sur ce poste</button>
        }
        @if (basculeFaite) { <strong> Poste réglé sur le 2e serveur : fermez puis rouvrez Tracodex Officine.</strong> }
        @if (LiaisonServeur.MessageSecours(etatSecours) is { } messageSecours) { <strong data-champ="message_secours" style="display: block; margin-top: 6px">@messageSecours</strong> }
    </div>
}
else if (attenteSync is { Affiche: true, Depuis: { } depuisSync })
{
    @* Synchronisation en attente (conception § 8) : même emplacement que « Serveur injoignable », jamais bloquant (aucun bouton, rien ne
       couvre l'écran de travail au-delà de cette ligne) ; titulaire et rôles ayant le droit « sync.suivre » ; seuil réglé dans
       Administration › Synchronisation › Supervision *@
    <div class="bandeau-attention" role="status" data-zone="synchronisation-attente" style="position: fixed; left: 0; right: 0; bottom: 32px; z-index: 50; margin: 0">
        Synchronisation en attente depuis @QuandSync(Local(depuisSync)) (@attenteSync.Operations opération@(attenteSync.Operations > 1 ? "s" : "")). Le travail n’est pas affecté ; les opérations partent dès que le serveur central répond.
    </div>
}
<footer class="barre-etat" aria-label="État du poste">
    @* Éléments fixes, toujours affichés (texte gris) : liaison au serveur, poste et vendeur connecté, date et heure à droite *@
    <button type="button" class="element-etat @(serveurJoignable == false ? "anormal" : null)" data-zone="serveur" title="Vérifier la liaison avec le serveur maintenant"
            @onclick="VerifierServeurAsync">
        <span class="voyant @(serveurJoignable switch { true => "ok", false => "ko", _ => null })" aria-hidden="true"></span>
        @(serveurJoignable switch { true => "Connecté", false => "Serveur injoignable", _ => "Serveur…" })
    </button>
    @if (Identite is { Length: > 0 } identite)
    {
        <span class="element-etat identite-etat" data-zone="identite" title="@identite">@identite</span>
    }
    @if (demo is { Actif: true })
    {
        @* Serveur de démonstration (GET /api/demo) : mention permanente, sans bouton pour la masquer, avant comme après la connexion *@
        <span class="element-etat demo" role="status" data-zone="demonstration" title="Serveur de démonstration : toutes les données sont fictives">@(demo.Libelle ?? "Démonstration — données fictives")</span>
    }

    @* Pastilles (PastillesBarre) : seulement s'il y a une information ; cliquables vers l'écran pour qui a le droit de l'ouvrir. Dès qu'une
       pastille orange ou rouge s'affiche, les grises se regroupent dans « À traiter (N) » (liste fermée par Échap ou un clic dehors). *@
    <div class="pastilles-etat" data-zone="pastilles">
        @foreach (var p in affichage.Visibles)
        {
            @Rendu(p)
        }
    </div>
    @if (affichage.Regroupe)
    {
        @* Hors de la zone des pastilles (qui coupe ce qui dépasse) : la liste s'ouvre au-dessus de la barre sans être coupée *@
        <span class="groupe-etat" @onkeydown="ToucheGroupeAsync">
            <button type="button" class="pastille groupe @affichage.NiveauGroupe" data-zone="a-traiter" aria-haspopup="dialog" aria-controls="liste-a-traiter"
                    aria-expanded="@(listeOuverte ? "true" : "false")" @ref="boutonGroupe" @onclick="BasculerListe">À traiter (@affichage.ATraiter.Count) ▾</button>
            @if (listeOuverte)
            {
                <span class="fond-liste-etat" aria-hidden="true" @onclick="FermerListe"></span>
                <span id="liste-a-traiter" class="liste-etat" role="dialog" aria-label="À traiter">
                    @foreach (var p in affichage.ATraiter)
                    {
                        @Rendu(p)
                    }
                </span>
            }
        </span>
    }

    @if (messageOuvert && message is { } m)
    {
        @* Reste du lot S7.3 : petite fenêtre du message du titulaire à distance (pastille « Message »), posée au-dessus de la barre comme la
           liste « À traiter » ; fermée par Échap, un clic dehors ou « Fermer ». « Ne plus afficher » : titulaire de l'officine seulement. *@
        <span class="fond-liste-etat" aria-hidden="true" @onclick="FermerFenetreMessage"></span>
        <div id="fenetre-message-etat" class="fenetre-message-etat" role="dialog" aria-labelledby="titre-message-etat" data-zone="fenetre-message"
             @onkeydown="ToucheMessageAsync">
            <strong id="titre-message-etat">Message du titulaire (à distance)</strong>
            <p class="texte-message-etat" data-zone="texte-message">@m.Texte</p>
            <span class="detail-message-etat">Affiché sur tous les postes jusqu’au @Local(m.JusquAu).ToString("dddd dd/MM à HH:mm", Fr) · reçu le @Local(m.RecuLe).ToString("dd/MM à HH:mm", Fr)</span>
            @if (erreurMessage is { } erreur)
            {
                <span class="erreur-message-etat" role="alert">@erreur</span>
            }
            <span class="actions-message-etat">
                @if (Session.A("admin.parametres"))
                {
                    <button type="button" class="btn btn-contour" @onclick='() => Aller("admin/synchronisation?rubrique=ordres")'>Ordres du central</button>
                }
                @if (m.PeutFermer)
                {
                    <button type="button" class="btn btn-contour" data-zone="ne-plus-afficher" disabled="@fermetureEnCours" @onclick="NePlusAfficherAsync">Ne plus afficher</button>
                }
                <button type="button" class="btn btn-principal" @ref="boutonFermerMessage" @onclick="FermerFenetreMessage">Fermer</button>
            </span>
        </div>
    }

    @* Date et heure, raccourcies quand les pastilles sont regroupées (la barre reste sur une ligne en 1366×768) ; version dans l'infobulle *@
    <span class="element-etat droite" data-zone="date" title="Tracodex Officine v@(Version)">@PastillesBarre.Date(maintenant, affichage.Regroupe)</span>
</footer>

@code {
    private static readonly System.Globalization.CultureInfo Fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
    // Année.mois de la livraison, plus le correctif du mois s'il y en a un (2026.11, 2026.11.1…)
    private static readonly string Version = typeof(BarreEtat).Assembly.GetName().Version is { } v
        ? (v.Build > 0 ? $"{v.Major}.{v.Minor:00}.{v.Build}" : $"{v.Major}.{v.Minor:00}") : "?";

    private bool? serveurJoignable;
    private DateTime? injoignableDepuis;
    private bool basculeFaite;
    private bool InjoignableTropLongtemps => injoignableDepuis is { } d
        && DateTime.Now - d >= TimeSpan.FromSeconds(Reglages.Actuelles.DelaiServeurInjoignableSecondes ?? ReglagesPoste.DelaiInjoignableParDefaut);

    private bool verificationSecours;
    private EtatLiaison etatSecours = EtatLiaison.Joignable;

    /// <summary>
    /// Bascule de ce poste : seulement si l'API du 2e serveur répond (elle ne démarre qu'une fois sa base promue par le script de
    /// bascule : jamais un poste dirigé vers une copie en lecture seule). L'adresse de secours devient alors l'adresse de l'API
    /// (poste.json), prise au prochain démarrage.
    /// </summary>
    private async Task BasculerPosteAsync()
    {
        var a = Reglages.Actuelles;
        if (a.AdresseApiSecours is not { Length: > 0 } secours) return;
        (verificationSecours, etatSecours) = (true, EtatLiaison.Joignable);
        StateHasChanged();
        try { etatSecours = await ApiClient.VerifierApiAsync(secours); }
        finally { verificationSecours = false; }
        if (etatSecours != EtatLiaison.Joignable) return;
        var v = System.Text.Json.JsonSerializer.Deserialize<ReglagesPoste.Valeurs>(System.Text.Json.JsonSerializer.Serialize(a))!;
        v.AdresseApi = a.AdresseApiSecours;
        basculeFaite = Reglages.Enregistrer(v) is null;
    }
    private EtatPosteDto? etat;
    private AttenteSynchronisationDto? attenteSync;
    private EtatLiaisonsPosteDto? liaisons;
    private CompteursBarreDto? compteurs;
    private int? secondesAvantDeconnexion;

    // Pastilles recalculées à chaque rendu (état du serveur, du poste, droits de l'employé connecté)
    private AffichageBarre affichage = new([], []);
    private bool listeOuverte;
    private ElementReference boutonGroupe;

    /// <summary>Poste (nom déclaré, sinon nom de l'ordinateur, comme la caisse) et vendeur connecté ; avant la connexion : le poste seul.</summary>
    private string Identite => PastillesBarre.Identite(Configuration.NomCourt, Session.EstConnecte ? Session.NomComplet : null);

    protected override void OnParametersSet() => Recalculer();

    protected override bool ShouldRender() { Recalculer(); return true; }

    private void Recalculer()
    {
        var connecte = Session.EstConnecte;
        affichage = PastillesBarre.Calculer(new EtatBarre(serveurJoignable == true && connecte, maintenant, Session.A,
            connecte ? etat : null, connecte ? liaisons : null, connecte ? compteurs : null, connecte ? secondesAvantDeconnexion : null,
            Tickets.DerniereErreur, connecte ? message : null));
        if (!affichage.Regroupe) listeOuverte = false;
        if (!connecte || message is null) messageOuvert = false;
    }

    private RenderFragment Rendu(Pastille p) =>
        @<text>@if (p.Lien is { } lien)
        {
            <button type="button" class="pastille @p.Niveau" data-zone="pastille-@p.Cle" title="@p.Titre" @onclick="() => Aller(lien)">@p.Libelle</button>
        }
        else
        {
            <span class="pastille @p.Niveau" data-zone="pastille-@p.Cle" title="@p.Titre">@p.Libelle</span>
        }</text>;

    private void Aller(string lien)
    {
        listeOuverte = false;
        // Pastille du message : sa petite fenêtre, sans changer d'écran
        if (lien == PastillesBarre.LienMessage)
        {
            (messageOuvert, erreurMessage, focaliserMessage) = (true, null, true);
            return;
        }
        messageOuvert = false;
        Nav.NavigateTo(lien);
    }

    // ---- Reste du lot S7.3 : message du titulaire à distance ----
    private MessageCentralDto? message;
    private bool messageOuvert;
    private bool fermetureEnCours;
    private string? erreurMessage;
    private ElementReference boutonFermerMessage;
    private bool focaliserMessage;

    private void FermerFenetreMessage() => messageOuvert = false;

    private void ToucheMessageAsync(KeyboardEventArgs k)
    {
        if (k.Key == "Escape") messageOuvert = false;
    }

    /// <summary>Fenêtre du message tout juste ouverte : le curseur va sur « Fermer » (Échap la ferme ensuite).</summary>
    protected override async Task OnAfterRenderAsync(bool premierRendu)
    {
        if (!focaliserMessage || !messageOuvert) return;
        focaliserMessage = false;
        try { await boutonFermerMessage.FocusAsync(); }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException) { }
    }

    /// <summary>Titulaire de l'officine : le message n'est plus affiché sur aucun poste (journal des actions au serveur).</summary>
    private async Task NePlusAfficherAsync()
    {
        if (message is not { } m) return;
        fermetureEnCours = true;
        try
        {
            erreurMessage = await Api.FermerMessageCentralAsync(m.Id);
            if (erreurMessage is null) (message, messageOuvert) = (null, false);
        }
        finally { fermetureEnCours = false; }
    }

    private void BasculerListe() => listeOuverte = !listeOuverte;
    private void FermerListe() => listeOuverte = false;

    private async Task ToucheGroupeAsync(KeyboardEventArgs k)
    {
        if (k.Key != "Escape" || !listeOuverte) return;
        listeOuverte = false;
        try { await boutonGroupe.FocusAsync(); }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException) { }
    }

    private EtatDemoDto? demo;
    private DateTime maintenant = DateTime.Now;
    private PeriodicTimer? minuterie;
    private int tours;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += SurNavigation;
        Session.Changee += SurSession;
        Session.CaisseChangee += SurSession;
        Tickets.EtatChange += SurImprimante;
        await ActualiserAsync(complet: true);
        _ = BouclerAsync();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= SurNavigation;
        Session.Changee -= SurSession;
        Session.CaisseChangee -= SurSession;
        Tickets.EtatChange -= SurImprimante;
        minuterie?.Dispose();
    }

    // Serveur, heure et déconnexion automatique toutes les 15 secondes ; caisse, sauvegarde, liaisons et compteurs toutes les minutes
    // (et à chaque changement d'écran)
    private async Task BouclerAsync()
    {
        minuterie = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await minuterie.WaitForNextTickAsync())
                await InvokeAsync(async () => { await ActualiserAsync(complet: ++tours % 4 == 0); StateHasChanged(); });
        }
        catch (ObjectDisposedException) { }
    }

    private async Task ActualiserAsync(bool complet)
    {
        maintenant = DateTime.Now;
        serveurJoignable = await Api.ServeurJoignableAsync();
        injoignableDepuis = serveurJoignable == false ? injoignableDepuis ?? DateTime.Now : null;
        // Mode démonstration : relu à chaque tour complet (une erreur garde l'état connu : la mention ne disparaît pas sur un incident)
        if (serveurJoignable == true && (complet || demo is null) && await Api.EtatDemoAsync() is ({ } d, null)) demo = d;
        if (complet && serveurJoignable == true && Session.EstConnecte)
        {
            var (e, erreur) = await Api.EtatPosteAsync();
            if (erreur is null) etat = e;
            // Bandeau de synchronisation : lecture seule, une erreur de lecture le masque sans rien bloquer
            var (a, erreurSync) = await Api.AttenteSynchronisationAsync();
            attenteSync = erreurSync is null ? a : null;
            // Liaisons central et 2e serveur : même rythme (tour complet) ; une erreur de lecture n'affiche rien
            var (l, erreurLiaisons) = await Api.EtatLiaisonsPosteAsync();
            liaisons = erreurLiaisons is null ? l : null;
            // Compteurs des pastilles (une seule lecture, filtrée par les droits au serveur) ; super admin : aucun compteur d'employé
            if (!Session.SuperAdmin)
            {
                var (c, erreurCompteurs) = await Api.CompteursBarreAsync();
                compteurs = erreurCompteurs is null ? c : null;
                // Message du titulaire à distance : même rythme ; une erreur de lecture garde le message connu (pas de clignotement)
                var (mc, erreurMessageLu) = await Api.MessageCentralAsync();
                if (erreurMessageLu is null) message = mc;
            }
        }
        if (!Session.EstConnecte) (etat, attenteSync, liaisons, compteurs) = (null, null, null, null);
        if (!Session.EstConnecte) message = null;
        secondesAvantDeconnexion = await SecondesAvantDeconnexionAsync();
    }

    /// <summary>
    /// Temps restant avant la déconnexion automatique (même mesure que MiseEnPage : inactivité vue par la page) ; null sans déconnexion
    /// automatique ou si la page ne répond pas.
    /// </summary>
    private async Task<int?> SecondesAvantDeconnexionAsync()
    {
        if (!Session.EstConnecte || Session.DeconnexionMinutes <= 0) return null;
        try { return Session.DeconnexionMinutes * 60 - await JS.InvokeAsync<int>("pharma.inactiviteSecondes"); }
        catch (Exception e) when (e is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException) { return null; }
    }

    private void SurImprimante() => _ = InvokeAsync(StateHasChanged);

    private async Task VerifierServeurAsync()
    {
        serveurJoignable = null;
        StateHasChanged();
        await ActualiserAsync(complet: true);
    }

    private void SurNavigation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () => { await ActualiserAsync(complet: true); StateHasChanged(); });

    private void SurSession() => _ = InvokeAsync(async () => { await ActualiserAsync(complet: true); StateHasChanged(); });

    // ---- Libellés ----
    private static DateTime Local(DateTime d) => d.Kind == DateTimeKind.Utc ? d.ToLocalTime() : d;

    private static string QuandSync(DateTime d) =>
        DateTime.Now - d < TimeSpan.FromHours(24) ? $"{d:HH:mm}" : $"le {d:dd/MM à HH:mm}";
}
