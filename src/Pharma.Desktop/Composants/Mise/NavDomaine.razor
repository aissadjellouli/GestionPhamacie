@implements IDisposable
@inject SessionPoste Session
@inject NavigationManager Nav
@inject CompteursAttente Compteurs

@* Menu de gauche (navigation en deux niveaux, docs/navigation.md) : les écrans du domaine de l'écran affiché (Services/Domaines),
   l'écran affiché déplié avec ses rubriques (ChildContent, fournies par l'écran). Domaine d'un seul écran (Caisse, Achats) :
   les rubriques seules. Hors domaine (Accueil, Guide) : les rubriques seules aussi. Compteur du travail en attente à côté
   d'un écran (CompteursAttente). *@
<nav class="nav-laterale" aria-label="@Libelle">
    @if (domaine is null || ecrans.Count <= 1)
    {
        @ChildContent
    }
    else
    {
        @* Rubriques repliables homogènes (2026-11-27) : le nom du domaine et l'écran affiché déplié sont des boutons qui replient ou
           déplient leurs entrées (GroupeMenu) ; un écran replié reste un lien vers l'écran *@
        <GroupeMenu Cle="@($"domaine:{domaine.Libelle}")" Titre="@domaine.Libelle" ContientActif="@(ecran is not null)">
            @foreach (var e in ecrans)
            {
                var attente = Compteurs.Ecran(e.Lien);
                if (e == ecran && ChildContent is not null)
                {
                    <GroupeMenu Cle="@($"ecran:{e.Lien}")" Titre="@e.Libelle" Complement="@Compteur(attente)" Variante="ecran" Courant="true" ContientActif="true">
                        <div class="nav-rubriques">@ChildContent</div>
                    </GroupeMenu>
                }
                else
                {
                    @* Écran à rubriques, replié : chevron « › » (décision du 2026-11-27 : tout menu dépliable porte son chevron, à tout niveau) *@
                    <a href="@e.Lien" class="@(e == ecran ? "active" : null)" aria-current="@(e == ecran ? "page" : null)">@if (e.AvecRubriques) {<span class="chevron-menu" aria-hidden="true"></span>}@e.Libelle@Compteur(attente)</a>
                }
            }
        </GroupeMenu>
    }
</nav>

@code {
    /// <summary>Nom du menu pour les lecteurs d'écran (ex. « Rubriques de l'inventaire »).</summary>
    [Parameter] public string Libelle { get; set; } = "Écrans et rubriques";
    /// <summary>Rubriques de l'écran affiché ; sans rubriques, l'écran est un simple lien actif de la liste.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Domaines.Domaine? domaine;
    private Domaines.Ecran? ecran;
    private List<Domaines.Ecran> ecrans = [];

    private static RenderFragment Compteur((int Nombre, bool Urgent)? attente) => b =>
    {
        if (attente is not { } a) return;
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", a.Urgent ? "compteur" : "compteur neutre");
        b.AddAttribute(2, "aria-label", $"{a.Nombre} en attente");
        b.AddContent(3, a.Nombre);
        b.CloseElement();
    };

    protected override void OnInitialized() => Compteurs.Change += SurCompteurs;
    private void SurCompteurs() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Compteurs.Change -= SurCompteurs;

    protected override void OnParametersSet()
    {
        (domaine, ecran) = Domaines.De(Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/'));
        ecrans = domaine?.Permis(Session).ToList() ?? [];
    }
}
