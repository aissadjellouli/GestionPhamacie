@inject NavigationManager Nav

@* Aide en contexte (docs/navigation.md) : « ? » à côté du titre de l'écran ; quelques lignes sur ce qu'on y fait, les raccourcis,
   et le lien vers le Guide. Placée dans le h1 de chaque écran de domaine (test NavigationTests). Échap ferme. *@
@if (Textes.TryGetValue(Cle, out var aide))
{
    @if (Libelle is null)
    {
        <button type="button" class="bouton-aide" title="Aide de cet écran" aria-label="@($"Aide : {aide.Titre}")" aria-expanded="@(ouverte ? "true" : "false")"
                @onclick="() => ouverte = !ouverte">?</button>
    }
    else
    {
        @* Écran sans titre (Caisse) : l'aide est un lien du menu *@
        <button type="button" class="lien-bouton lien-aide" aria-expanded="@(ouverte ? "true" : "false")" @onclick="() => ouverte = !ouverte"><span class="bouton-aide" aria-hidden="true">?</span> @Libelle</button>
    }
    @if (ouverte)
    {
        <aside class="panneau-aide" role="dialog" aria-label="@($"Aide : {aide.Titre}")" @onkeydown="Touche" tabindex="-1">
            <h2>Aide · @aide.Titre</h2>
            <ul>
                @foreach (var p in aide.Points) { <li>@p</li> }
            </ul>
            <p class="detail">Raccourcis : Ctrl + K rechercher · Ctrl + Maj + lettre du domaine · Alt + ← retour · Échap fermer ou effacer.</p>
            <div class="pied-aide">
                <button type="button" class="btn" @onclick='() => { ouverte = false; Nav.NavigateTo("guide"); }'>Guide complet</button>
                <button type="button" class="btn" @onclick="() => ouverte = false">Fermer</button>
            </div>
        </aside>
    }
}

@code {
    /// <summary>Écran (chemin sans « / » : « inventaire », « stock/registre »… ; vide : Alertes).</summary>
    [Parameter, EditorRequired] public string Cle { get; set; } = "";
    /// <summary>Texte du lien (écran sans titre, ex. « Aide de la caisse ») ; sans texte : le rond « ? » à côté du titre.</summary>
    [Parameter] public string? Libelle { get; set; }

    private bool ouverte;
    private void Touche(KeyboardEventArgs e) { if (e.Key == "Escape") ouverte = false; }

    private sealed record Aide(string Titre, string[] Points);

    private static readonly Dictionary<string, Aide> Textes = new()
    {
