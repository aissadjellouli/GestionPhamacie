@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique

@* Remises automatiques (2026-11-14) : pourcentage décidé par le titulaire (ou un employé à qui il en a donné le droit) pour un produit ou
   une catégorie, sur une période ; la caisse l'applique d'elle-même en vente libre, jamais sur un produit remboursable. Sur un
   médicament, la réduction est enregistrée comme don partiel du reste à charge. Liste courte : filtrée et paginée sur le poste. *@
@if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
@if (message is not null) { <div class="succes" role="status">@message</div> }
@if (Peut && fiche is null)
{
    <div><button type="button" class="btn" @onclick="Nouvelle">Nouvelle remise automatique</button></div>
}
@if (fiche is { } f)
{
    <section class="panneau" aria-labelledby="t-remise-auto">
        <h2 id="t-remise-auto">@(f.Id is null ? "Nouvelle remise automatique" : "Modifier la remise automatique")</h2>
        <div class="filtres" role="group" aria-label="Remise sur">
            <button type="button" class="puce" aria-pressed="@(f.SurProduit ? "true" : "false")" @onclick="() => f.SurProduit = true">Un produit</button>
            <button type="button" class="puce" aria-pressed="@(!f.SurProduit ? "true" : "false")" @onclick="() => f.SurProduit = false">Une catégorie</button>
        </div>
        <div class="achats-ligne">
            @if (f.SurProduit)
            {
                @if (f.ProduitNom is { } nom)
                {
                    <div class="champ" style="flex: 2 1 300px"><span class="etiquette-champ requis">Produit</span>
                        <span>@nom <button type="button" class="lien-bouton" @onclick="() => (f.ProduitId, f.ProduitNom) = (null, null)">Changer</button></span></div>
                }
                else
                {
                    <ChoixProduit Id="ra-produit" Libelle="Produit (non remboursable)" Requis="true" Style="flex: 2 1 300px"
                                  OnChoisi="p => (f.ProduitId, f.ProduitNom) = (p.Id, p.NomCommercial)" OnEfface="() => (f.ProduitId, f.ProduitNom) = (null, null)" />
                }
            }
            else
            {
                <div class="champ" style="flex: 2 1 260px">
                    <label for="ra-cat" class="requis">Catégorie</label>
                    <select id="ra-cat" data-champ="cible_remise" @bind="f.Categorie">
                        <option value="">Choisir…</option>
                        @foreach (var c in categories) { <option value="@c.Code">@c.Libelle@(c.Medicament ? " (don partiel)" : "")</option> }
                    </select>
                </div>
            }
            <div class="champ" style="flex: 0 1 120px">
                <label for="ra-pct" class="requis">Remise (%)</label>
                <input id="ra-pct" data-champ="pourcentage_remise" type="text" inputmode="numeric" maxlength="3" autocomplete="off"
                       value="@(f.Pourcentage?.ToString(System.Globalization.CultureInfo.InvariantCulture))" onfocus="this.select()"
                       onbeforeinput="@CodeComptoirSaisie.FiltreChiffres" @onchange="e => f.Pourcentage = int.TryParse(CodeComptoirSaisie.Chiffres(e.Value?.ToString()), out var v) ? Math.Min(v, 100) : null" />
            </div>
            <div class="champ" style="flex: 0 1 160px"><label for="ra-debut" class="requis">Du</label><input id="ra-debut" data-champ="debut_remise" type="date" @bind="f.Debut" /></div>
            <div class="champ" style="flex: 0 1 160px"><label for="ra-fin" class="requis">Au (inclus)</label><input id="ra-fin" data-champ="fin_remise" type="date" @bind="f.Fin" /></div>
            <div class="champ" style="flex: 2 1 220px"><label for="ra-motif">Motif</label><input id="ra-motif" data-champ="motif_remise" type="text" maxlength="200" @bind="f.Motif" placeholder="ex. promotion solaire" /></div>
        </div>
        <p class="detail" style="margin: 0">En vente libre seulement, jamais sur un produit remboursable. La remise d’un produit l’emporte sur celle de sa catégorie.
            Sur un médicament, la réduction est enregistrée comme don partiel du reste à charge.</p>
        <div class="filtres">
            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">@(f.Id is null ? "Créer" : "Enregistrer")</button>
            <button type="button" class="btn" @onclick="() => fiche = null">Annuler</button>
        </div>
    </section>
}

<div class="filtres-liste" role="search" aria-label="Filtrer les remises automatiques">
    <div class="champ" style="flex: 1 1 240px"><label for="fra-texte">Produit, catégorie ou motif</label>
        <input id="fra-texte" type="search" autocomplete="off" @bind="fTexte" @bind:event="oninput" @bind:after="() => page = 1" /></div>
    <div class="champ" style="flex: 0 0 200px"><label for="fra-etat">État</label>
        <select id="fra-etat" @bind="fEtat" @bind:after="() => page = 1">
            <option value="actives">En cours et à venir</option>
            <option value="en_cours">En cours</option>
            <option value="a_venir">À venir</option>
            <option value="finies">Terminées ou arrêtées</option>
            <option value="">Toutes</option>
        </select></div>
    @if (FiltreActif) { <button type="button" class="btn" @onclick="EffacerFiltres">Tout afficher</button> }
</div>
<section class="tableau-cadre" aria-label="Remises automatiques">
    <table class="tableau" style="min-width: 0">
        <thead><tr><th scope="col">Sur</th><th scope="col" class="nombre">Remise</th><th scope="col">Période</th><th scope="col">État</th><th scope="col">Décidée par</th><th scope="col">Motif</th><th scope="col"><span class="visuellement-cache">Actions</span></th></tr></thead>
        <tbody>
            @if (Filtres.Count == 0)
            {
                <tr><td colspan="7" class="vide">@(chargee ? (FiltreActif ? "Aucune remise automatique pour ces filtres." : "Aucune remise automatique.") : "Chargement…")</td></tr>
            }
            @foreach (var r in PageCourante)
            {
                <tr>
                    <td class="nom">@(r.Produit is { } p ? p : $"Catégorie : {r.CategorieLibelle}")</td>
                    <td class="nombre">@r.Pourcentage.ToString("0") %</td>
                    <td>du @Libelles.Date(r.Debut) au @Libelles.Date(r.Fin)</td>
                    <td><span class="pastille @(r.Etat switch { "en_cours" => "ok", "a_venir" => "info", _ => "" })">@EtatLibelle(r)</span></td>
                    <td>@r.CreePar</td>
                    <td>@(r.Motif ?? "—")</td>
                    <td style="white-space: nowrap">
                        @if (Peut && r.Etat is "en_cours" or "a_venir")
                        {
                            <button type="button" class="lien-bouton" @onclick="() => Modifier(r)">Modifier</button>
                            @if (aArreter == r.Id)
                            {
                                <button type="button" class="btn btn-danger" disabled="@enCours" @onclick="() => ArreterAsync(r)">Confirmer l’arrêt</button>
                                <button type="button" class="lien-bouton" @onclick="() => aArreter = null">Annuler</button>
                            }
                            else
                            {
                                <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => aArreter = r.Id">Arrêter</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
<Pagination Total="Filtres.Count" Numero="page" Taille="taille" Libelle="Pages des remises automatiques" OnChange="p => (page, taille) = (p.Numero, p.Taille)" />
@if (!Peut)
{
    <p class="detail" style="margin: 0">Les remises automatiques sont décidées par le titulaire, ou par un employé à qui il en donne le droit (Utilisateurs et droits).</p>
}

@code {
    private sealed class Fiche
    {
        public long? Id { get; init; }
        public bool SurProduit { get; set; } = true;
        public long? ProduitId { get; set; }
        public string? ProduitNom { get; set; }
        public string? Categorie { get; set; }
        public int? Pourcentage { get; set; }
        public DateOnly Debut { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly Fin { get; set; } = DateOnly.FromDateTime(DateTime.Today).AddDays(30);
        public string? Motif { get; set; }
    }

    private bool Peut => Session.A("caisse.remises_auto");
    private List<RemiseAutomatiqueDto> remises = [];
    private List<CategorieProduitDto> categories = [];
    private Fiche? fiche;
    private long? aArreter;
    private string? erreur, message;
    private bool enCours, chargee;

    private string fTexte = "", fEtat = "actives";
    private int page = 1, taille = Pagination.TailleParDefaut;
    private bool FiltreActif => fTexte.Trim() != "" || fEtat != "actives";
    private void EffacerFiltres() => (fTexte, fEtat, page) = ("", "actives", 1);
    private List<RemiseAutomatiqueDto> Filtres => remises.Where(r =>
        (fEtat switch
        {
            "actives" => r.Etat is "en_cours" or "a_venir",
            "finies" => r.Etat is "terminee" or "arretee",
            "" => true,
            _ => r.Etat == fEtat
        })
        && RechercheTexte.Contient(fTexte, r.Produit, r.CategorieLibelle, r.Motif))
        .ToList();
    private List<RemiseAutomatiqueDto> PageCourante =>
        Filtres.Skip((Math.Min(page, Math.Max(1, (Filtres.Count + taille - 1) / taille)) - 1) * taille).Take(taille).ToList();

    private static string EtatLibelle(RemiseAutomatiqueDto r) => r.Etat switch
    {
        "en_cours" => "En cours",
        "a_venir" => "À venir",
        "terminee" => "Terminée",
        _ => $"Arrêtée{(r.ArreteePar is { } qui ? $" par {qui}" : "")}"
    };

    protected override async Task OnInitializedAsync()
    {
        // Filtres et page retenus par « ← Retour »
        Historique.Suivre("remises-auto", e => { e.Mettre("texte", fTexte); e.Mettre("etat", fEtat); e.Mettre("page", page); e.Mettre("taille", taille); });
        if (Historique.Restaurer("remises-auto") is { } r)
            (fTexte, fEtat, page, taille) = (r.Texte("texte") ?? "", r.Texte("etat") ?? "actives", r.Entier("page") ?? 1, r.Entier("taille") ?? taille);
        (categories, _) = await Api.CategoriesProduitsAsync();
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        (remises, erreur) = await Api.RemisesAutomatiquesAsync();
        chargee = true;
    }

    private void Nouvelle() => (fiche, message, erreur) = (new Fiche(), null, null);

    private void Modifier(RemiseAutomatiqueDto r) => (fiche, message, erreur) = (new Fiche
    {
        Id = r.Id, SurProduit = r.ProduitId is not null, ProduitId = r.ProduitId, ProduitNom = r.Produit, Categorie = r.Categorie,
        Pourcentage = (int)r.Pourcentage, Debut = r.Debut, Fin = r.Fin, Motif = r.Motif
    }, null, null);

    private async Task EnregistrerAsync()
    {
        if (fiche is not { } f) return;
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var saisie = new RemiseAutomatiqueSaisieDto(f.SurProduit ? f.ProduitId : null, f.SurProduit ? null : (string.IsNullOrEmpty(f.Categorie) ? null : f.Categorie),
                f.Pourcentage ?? 0, f.Debut, f.Fin, f.Motif);
            erreur = f.Id is { } id ? await Api.ModifierRemiseAutomatiqueAsync(id, saisie) : (await Api.CreerRemiseAutomatiqueAsync(saisie)).Item2;
            if (erreur is not null) return;
            message = f.Id is null ? "Remise automatique créée : la caisse l’applique dès le premier jour." : "Remise automatique enregistrée.";
            fiche = null;
            await ChargerAsync();
        }
        finally { enCours = false; }
    }

    private async Task ArreterAsync(RemiseAutomatiqueDto r)
    {
        (enCours, erreur, message, aArreter) = (true, null, null, null);
        try
        {
            erreur = await Api.ArreterRemiseAutomatiqueAsync(r.Id);
            if (erreur is not null) return;
            message = $"Remise sur {(r.Produit ?? r.CategorieLibelle)} arrêtée : elle ne s’applique plus aux ventes suivantes.";
            await ChargerAsync();
        }
        finally { enCours = false; }
    }
}
