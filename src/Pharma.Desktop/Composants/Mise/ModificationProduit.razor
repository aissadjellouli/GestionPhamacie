@inject ApiClient Api
@inject SessionPoste Session

@* Modification d'un produit du catalogue (droit de créer un produit ; le prix public demande le droit de modifier un prix).
   La classe réglementaire se confirme dans Administration › Nomenclature. *@
@if (Session.A("catalogue.creer"))
{
    <section class="panneau" aria-labelledby="t-modif-produit">
        <div>
            <h2 id="t-modif-produit">Modifier un produit</h2>
            <p class="sous-titre">Nom, DCI, dosage, forme, code-barres, prix, TVA, remboursement ; un produit désactivé n’est plus proposé à la vente ni aux commandes.</p>
        </div>
        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }
        <div class="achats-ligne">
            <ChoixProduit Id="mp-produit" PremierSurEntree="false" Libelle="Produit (désactivés compris)" InclureInactifs="true" Style="flex: 1 1 320px" OnChoisi="ChoisirAsync" OnEfface="() => fiche = null" />
        </div>
        @if (fiche is { } f)
        {
            <div class="achats-ligne">
                <div class="champ" style="flex: 1 1 220px"><label for="mp-nom" class="requis">Nom commercial</label><input id="mp-nom" data-champ="nom_commercial" type="text" maxlength="120" @bind="f.NomCommercial" /></div>
                @* DCI et forme : valeurs déjà connues proposées pendant la frappe (DCI du référentiel, formes déjà saisies), texte libre accepté *@
                <ChampSuggestions TItem="string" Id="mp-dci" Mode="ModeSuggestions.ValeurLibre" Rechercher="Api.DciAsync" TexteDe="d => d" Libelle="DCI"
                                  LibelleListe="DCI existantes" Style="flex: 3 1 300px" @bind-Valeur="f.Dci" />
                <div class="champ" style="flex: 0 1 130px"><label for="mp-dosage">Dosage</label><input id="mp-dosage" type="text" @bind="f.Dosage" /></div>
                <ValeursSaisies Id="mp-forme" Champ="forme_produit" Libelle="Forme" Style="flex: 2 1 220px" ValeursDeDepart="FicheNouveauProduit.FormesUsuelles" @bind-Valeur="f.Forme" />
            </div>
            <div class="achats-ligne">
                <div class="champ" style="flex: 1 1 170px"><label for="mp-cb">Code-barres</label><input id="mp-cb" data-champ="code_barre" type="text" inputmode="numeric" @bind="f.CodeBarre" /></div>
                <div class="champ" style="flex: 0 1 150px" title="@(Session.A("prix.modifier") ? null : "Droit « modifier un prix de vente » nécessaire")">
                    <label for="mp-prix" class="requis">Prix public (DA)</label>
                    <input id="mp-prix" data-champ="prix_public" type="number" min="0" step="0.01" disabled="@(!Session.A("prix.modifier"))" @bind="f.PrixPublic" />
                </div>
                @* Tarif de référence et remboursement : même droit que le prix public (le serveur le revérifie) *@
                <div class="champ" style="flex: 0 1 160px" title="@(Session.A("prix.modifier") ? null : "Droit « modifier un prix de vente » nécessaire")"><label for="mp-tarif" class="@(f.Remboursable ? "requis" : null)">Tarif de référence (DA)</label><input id="mp-tarif" data-champ="tarif_reference" type="number" min="0" step="0.01" disabled="@(!Session.A("prix.modifier"))" @bind="f.TarifReference" /></div>
                <div class="champ" style="flex: 0 1 100px"><label for="mp-tva">TVA (%)</label><input id="mp-tva" data-champ="tva" type="number" min="0" max="100" step="0.01" @bind="f.TauxTva" /></div>
                <div class="champ" style="flex: 0 1 130px"><span class="etiquette-champ">Prix public HT</span><span style="line-height: 44px">@(f.PrixPublic > 0 ? Libelles.Dinars(Math.Round(f.PrixPublic / (1 + f.TauxTva / 100m), 2, MidpointRounding.AwayFromZero), 2) : "—")</span></div>
                <label class="case" style="align-self: center" title="@(Session.A("prix.modifier") ? null : "Droit « modifier un prix de vente » nécessaire")"><input type="checkbox" disabled="@(!Session.A("prix.modifier"))" @bind="f.Remboursable" /><span>Remboursable</span></label>
                <label class="case" style="align-self: center"><input type="checkbox" @bind="f.Actif" /><span>Actif</span></label>
            </div>
            @* Contenance (unités par boîte, facultative) : sert à l'alerte « quantité anormale » du registre ; vide : valeur de la nomenclature si elle est lisible *@
            <div class="achats-ligne" style="align-items: center">
                <div class="champ" style="flex: 0 1 210px" title="Facultatif, 1 à 10000. Vide : la valeur de la nomenclature nationale est utilisée si elle est lisible.">
                    <label for="mp-contenance">Contenance (unités par boîte)</label>
                    <input id="mp-contenance" data-champ="contenance" type="number" min="1" max="10000" step="1"
                           placeholder="@(f.ContenanceNomenclature?.ToString() ?? "")" @bind="f.Contenance" />
                </div>
                <p class="detail" style="margin: 0; flex: 1 1 400px">
                    Nomenclature : @(f.ConditionnementNomenclature ?? "aucun conditionnement")
                    @(f.ContenanceNomenclature is { } cn ? $" → {cn} unités (utilisées si la contenance est vide)" : f.ConditionnementNomenclature is null ? "" : " → non lisible, rien n’est retenu")
                    · Classe : @Libelles.Classe(f.Classe) (se confirme dans Administration › Nomenclature).
                </p>
            </div>
            @* Indications thérapeutiques (script 104) : recherche au comptoir par indication (« toux », « fièvre ») *@
            <div class="achats-ligne" style="align-items: flex-end">
                <ChampSuggestions TItem="IndicationDto" @ref="champIndication" Id="mp-indication" Rechercher="ChercherIndicationsAsync" TexteDe="i => i.Libelle"
                                  Libelle="Ajouter une indication" LibelleAucun="résultat" ComplementAucun=" parmi les indications actives" LibelleListe="Indications proposées" Style="flex: 0 1 280px"
                                  OnChoisi="AjouterIndication" data-champ="indications" placeholder="ex. toux, fièvre" />
                <div style="flex: 1 1 320px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-height: 44px" aria-label="Indications du produit">
                    @if (indications.Count == 0) { <span class="detail">Aucune indication.</span> }
                    @foreach (var i in indications)
                    {
                        <button type="button" class="puce" aria-pressed="true" title="Retirer cette indication" @onclick="() => indications.Remove(i)">@i.Libelle@(i.Actif ? "" : " (désactivée)") ×</button>
                    }
                </div>
            </div>
            <div class="filtres">
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">Enregistrer</button>
                <button type="button" class="btn" @onclick="() => fiche = null">Annuler</button>
            </div>
        }
    </section>
}

@code {
    private sealed class Fiche
    {
        public long Id { get; init; }
        public string NomCommercial { get; set; } = "";
        public string? Dci { get; set; }
        public string? Dosage { get; set; }
        public string? Forme { get; set; }
        public string? CodeBarre { get; set; }
        public decimal PrixPublic { get; set; }
        public decimal? TarifReference { get; set; }
        public bool Remboursable { get; set; }
        public decimal TauxTva { get; set; }
        public bool Actif { get; set; } = true;
        public string Classe { get; init; } = "libre";
        public int? Contenance { get; set; }
        public int? ContenanceNomenclature { get; init; }
        public string? ConditionnementNomenclature { get; init; }
    }

    private Fiche? fiche;
    private string? erreur, message;
    private bool enCours;
    private List<IndicationDto> indications = [];
    private ChampSuggestions<IndicationDto>? champIndication;

    /// <summary>Indications actives qui contiennent la saisie, sauf celles déjà associées au produit.</summary>
    private async Task<(List<IndicationDto>, string?)> ChercherIndicationsAsync(string q)
    {
        var (p, e) = await Api.IndicationsAsync(true, q, 1, ChampSuggestions<IndicationDto>.Maximum + indications.Count);
        return (p?.Lignes.Where(i => indications.All(x => x.Id != i.Id)).ToList() ?? [], e);
    }

    /// <summary>Indication choisie : ajoutée au produit, le champ est vidé pour la suivante.</summary>
    private void AjouterIndication(IndicationDto i)
    {
        if (indications.All(x => x.Id != i.Id)) indications.Add(i);
        champIndication?.Afficher("");
    }

    private async Task ChoisirAsync(ProduitDto p)
    {
        (erreur, message) = (null, null);
        indications = [];
        champIndication?.Afficher("");
        var (f, e) = await Api.FicheProduitAsync(p.Id);
        erreur = e;
        if (f is not null)
        {
            var (liste, ei) = await Api.IndicationsDuProduitAsync(p.Id);
            indications = liste;
            erreur ??= ei;
        }
        fiche = f is null ? null : new Fiche
        {
            Id = f.Id, NomCommercial = f.NomCommercial, Dci = f.Dci, Dosage = f.Dosage, Forme = f.Forme, CodeBarre = f.CodeBarre, PrixPublic = f.PrixPublic,
            TarifReference = f.TarifReference, Remboursable = f.Remboursable, TauxTva = f.TauxTva, Actif = f.Actif, Classe = f.Classe,
            Contenance = f.Contenance, ContenanceNomenclature = f.ContenanceNomenclature, ConditionnementNomenclature = f.ConditionnementNomenclature
        };
    }

    private async Task EnregistrerAsync()
    {
        if (fiche is not { } f) return;
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var (information, e) = await Api.ModifierProduitAsync(new FicheProduitModifiableDto(f.Id, f.NomCommercial, f.Dci, f.Dosage, f.Forme, f.CodeBarre, f.PrixPublic,
                f.TarifReference, f.Remboursable, f.TauxTva, f.Actif, f.Classe, f.Contenance));
            if (e is not null) { erreur = e; return; }
            if (await Api.AssocierIndicationsAsync(f.Id, indications.Select(i => i.Id).ToList()) is { } ei)
            {
                erreur = $"Produit enregistré, mais pas ses indications : {ei}";
                return;
            }
            message = $"« {f.NomCommercial.Trim()} » enregistré.{(information is null ? "" : " " + information)}";
            fiche = null;
        }
        finally { enCours = false; }
    }
}
