        new("Conflits de n° de facture Chifa", "admin/conflits-facture-chifa", "role.titulaire"),
        new("Prestations", "admin/prestations", "catalogue.creer"),
        new("Indications thérapeutiques", "admin/indications", "catalogue.creer"),
        new("Imprimantes et étiquettes", "admin/imprimantes", "admin.parametres"),
        new("Sauvegardes", "admin/sauvegardes", "admin.sauvegardes"),
        new("2e serveur", "admin/second-serveur", "role.titulaire"),
