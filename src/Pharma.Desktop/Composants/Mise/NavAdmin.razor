@inject SessionPoste Session

@* Menu latéral de l'administration : chaque rubrique selon le droit de l'employé.
   Menu à deux niveaux : sous la rubrique affichée, ses sous-rubriques (adresse admin/…?rubrique=…), une partie à la fois,
   pour que l'écran reste fixe (docs/charte-graphique.md). *@
@if (!Session.SuperAdmin)
{
<nav class="admin-nav" aria-label="Rubriques d’administration">
    @foreach (var r in Rubriques)
    {
        if (r.Lien is null)
        {
            <span class="nav-inactif" aria-disabled="true" title="@r.Raison">@r.Libelle</span>
        }
        else if (!Session.A(r.Permission!))
        {
            <span class="nav-inactif" aria-disabled="true" title="@(r.Permission switch { "role.titulaire" => "Réservé au pharmacien titulaire", "role.super_admin" => "Réservé au super admin (connexion super admin)", _ => $"Droit « {r.Permission} » nécessaire" })">@r.Libelle</span>
        }
        else
        {
            var actif = r.Lien == Actif;
            <a href="@r.Lien" class="@(actif ? "active" : null)" aria-current="@(actif && SousRubriques(r.Lien).Count == 0 ? "page" : null)">@r.Libelle</a>
            @if (actif)
            {
                var sous = SousRubriques(r.Lien);
                foreach (var (id, libelle) in sous)
                {
                    var courante = id == RubriqueCourante(r.Lien, Rubrique);
                    <a href="@(id == sous[0].Id ? r.Lien : $"{r.Lien}?rubrique={id}")" class="sous-rubrique @(courante ? "active" : null)" aria-current="@(courante ? "page" : null)">@libelle</a>
                }
            }
        }
    }
</nav>
}

@code {
    /// <summary>Lien de la rubrique affichée (ex. « admin/seuils »).</summary>
    [Parameter] public string Actif { get; set; } = "";
    /// <summary>Sous-rubrique demandée dans l'adresse (?rubrique=…) ; vide ou inconnue : la première.</summary>
    [Parameter] public string? Rubrique { get; set; }

    private sealed record Rubrique_(string Libelle, string? Lien, string? Permission, string? Raison = null);

    public static readonly IReadOnlyList<(string Lien, string Permission)> Accessibles =
    [
        ("admin/seuils", "admin.parametres"),
        ("admin/droits", "admin.utilisateurs"),
        ("admin/caisse", "admin.parametres"),
        ("admin/controle-interne", "role.titulaire"),
        ("admin/imprimantes", "admin.parametres"),
        ("admin/emplacements", "admin.parametres"),
        ("admin/pharmacie", "admin.parametres"),
        ("admin/notifications", "role.titulaire"),
        ("admin/sauvegardes", "admin.sauvegardes"),
        ("admin/reprise", "role.super_admin"),
        ("admin/nomenclature", "role.titulaire")
    ];

    private static readonly Rubrique_[] Rubriques =
    [
        new("Alertes et seuils", "admin/seuils", "admin.parametres"),
        new("Utilisateurs et droits", "admin/droits", "admin.utilisateurs"),
        new("Caisse et contrôle", "admin/caisse", "admin.parametres"),
        new("Contrôle interne", "admin/controle-interne", "role.titulaire"),
        new("Emplacements", "admin/emplacements", "admin.parametres"),
        new("Imprimantes et étiquettes", "admin/imprimantes", "admin.parametres"),
        new("Sauvegardes", "admin/sauvegardes", "admin.sauvegardes"),
        new("Notifications au titulaire", "admin/notifications", "role.titulaire"),
        new("Reprise de données", "admin/reprise", "role.super_admin"),
        new("Nomenclature nationale", "admin/nomenclature", "role.titulaire"),
        new("Langue et pharmacie", "admin/pharmacie", "admin.parametres")
    ];

    /// <summary>Sous-rubriques de chaque écran d'administration (second niveau du menu) ; la première est ouverte par défaut.</summary>
    private static readonly Dictionary<string, (string Id, string Libelle)[]> Sous = new()
    {
        ["admin/seuils"] = [("peremption", "Péremption"), ("exceptions", "Exceptions par produit"), ("stock", "Stock et lots délaissés"), ("produits", "Seuils par produit")],
        ["admin/droits"] = [("utilisateurs", "Utilisateurs"), ("roles", "Droits par rôle")],
        ["admin/caisse"] = [("regles", "Règles"), ("journal", "Journal des actions sensibles")],
        ["admin/imprimantes"] = [("tickets", "Tickets et afficheur"), ("etiquettes", "Étiquettes")],
        ["admin/sauvegardes"] = [("reglages", "Réglages"), ("journal", "Journal des sauvegardes")],
        ["admin/notifications"] = [("envoi", "E-mail et SMS"), ("destinataires", "Destinataires"), ("fiche", "Ajouter ou modifier"), ("file", "File d’attente")],
        ["admin/nomenclature"] = [("version", "Version et catégories"), ("verifier", "Produits à vérifier")],
        ["admin/pharmacie"] = [("pharmacie", "Pharmacie et langue"), ("organismes", "Organismes payeurs"), ("medecins", "Médecins prescripteurs")]
    };

    private static IReadOnlyList<(string Id, string Libelle)> SousRubriques(string lien) => Sous.TryGetValue(lien, out var s) ? s : [];

    /// <summary>Sous-rubrique affichée par un écran : celle de l'adresse si elle existe, sinon la première (vide sans sous-rubriques).</summary>
    public static string RubriqueCourante(string lien, string? demandee)
    {
        var s = SousRubriques(lien);
        return s.Count == 0 ? "" : s.Any(x => x.Id == demandee) ? demandee! : s[0].Id;
    }

    /// <summary>Libellé de la sous-rubrique affichée, pour le titre de l'écran (« Sauvegardes · Journal des sauvegardes »).</summary>
    public static string Libelle(string lien, string? demandee)
    {
        var id = RubriqueCourante(lien, demandee);
        return SousRubriques(lien).FirstOrDefault(x => x.Id == id).Libelle ?? "";
    }
}
