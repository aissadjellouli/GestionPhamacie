@inject SessionPoste Session
@inject IJSRuntime JS

@* Menu latéral de l'administration : chaque rubrique selon le droit de l'employé.
   Menu à deux niveaux : sous la rubrique affichée, ses sous-rubriques (adresse admin/…?rubrique=…), une partie à la fois,
   pour que l'écran reste fixe (docs/charte-graphique.md). *@
@if (!Session.SuperAdmin)
{
<nav @ref="menu" class="admin-nav" aria-label="Rubriques d’administration">
    @foreach (var r in Rubriques)
    {
        // Écran à venir ou sans droit (ex. reprise de données : super admin) : absent du menu, pas grisé (docs/navigation.md)
        if (r.Lien is null || !Session.A(r.Permission!))
        {
            continue;
        }
        else
        {
            var actif = r.Lien == Actif;
            IReadOnlyList<(string Id, string Libelle)> sous = actif ? SousRubriques(r.Lien) : [];
            @if (sous.Count > 0)
            {
                @* Écran affiché qui a des sous-rubriques : son nom devient un titre de groupe non cliquable (comme dans les autres menus) ;
                   seule la sous-rubrique affichée porte le bandeau ambre *@
                <span class="nav-groupe-titre">@r.Libelle</span>
            }
            else
            {
                <a href="@r.Lien" class="@(actif ? "active" : null)" aria-current="@(actif ? "page" : null)">@r.Libelle</a>
            }
            @if (sous.Count > 0)
            {
                foreach (var (id, libelle) in sous)
                {
                    var courante = id == RubriqueCourante(r.Lien, Rubrique);
                    <a href="@(id == sous[0].Id ? r.Lien : $"{r.Lien}?rubrique={id}")" class="sous-rubrique @(courante ? "active" : null)" aria-current="@(courante ? "page" : null)">@libelle</a>
                }
            }
        }
    }
</nav>
}

@code {
    private ElementReference menu;
    private string? lienVu;

    // Lien affiché toujours visible dans le menu de gauche (bandeau ambre), même en bas d'un long menu ou en fenêtre basse :
    // le menu défile jusqu'à lui dès le rendu, à chaque changement d'écran ou de sous-rubrique (docs/charte-graphique.md)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var lien = $"{Actif}?{RubriqueCourante(Actif, Rubrique)}";
        if (Session.SuperAdmin || lien == lienVu) return;
        lienVu = lien;
        try { await JS.InvokeVoidAsync("pharma.voirLienActif", menu); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    /// <summary>Lien de la rubrique affichée (ex. « admin/seuils »).</summary>
    [Parameter] public string Actif { get; set; } = "";
    /// <summary>Sous-rubrique demandée dans l'adresse (?rubrique=…) ; vide ou inconnue : la première.</summary>
    [Parameter] public string? Rubrique { get; set; }

    private sealed record Rubrique_(string Libelle, string? Lien, string? Permission, string? Raison = null);

