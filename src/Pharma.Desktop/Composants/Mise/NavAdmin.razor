        ["admin/imprimantes"] = [("tickets", "Tickets et afficheur"), ("etiquettes", "Étiquettes"), ("serveur", "Serveur et PC de secours")],
        ["admin/sauvegardes"] = [("reglages", "Réglages"), ("secours", "Copie de secours"), ("journal", "Journal des sauvegardes")],
