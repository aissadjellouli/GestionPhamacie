@inject SessionPoste Session
@inject IJSRuntime JS

@* Menu latéral de l'administration : chaque rubrique selon le droit de l'employé.
   Menu à deux niveaux : sous la rubrique affichée, ses sous-rubriques (adresse admin/…?rubrique=…), une partie à la fois,
   pour que l'écran reste fixe (docs/charte-graphique.md). *@
@if (!Session.SuperAdmin)
{
<nav @ref="menu" class="admin-nav" aria-label="Rubriques d’administration">
    @* Écrans regroupés par thème repliable (revue d'ergonomie du 2026-11-27, n° 8) : le thème de l'écran affiché est ouvert, les autres
       repliés ; un clic sur un thème l'ouvre ou le ferme (GroupeMenu, état gardé tant que le poste est ouvert). Le menu tient ainsi
       sans défiler à 1 366 × 768. Thème sans écran permis : absent. *@
    @foreach (var (theme, rubriques) in Themes)
    {
        // PC non autorisé (titulaire, décision du 2026-11-27) : seuls les écrans de l'Administration permis sur ce PC (Services/AdministrationSeule)
        var permises = rubriques.Where(r => r.Lien is not null && Session.A(r.Permission!)
                                            && (!Session.AdministrationSeule || AdministrationSeule.PeutOuvrir(r.Lien))).ToList();
        if (permises.Count == 0) continue;
        <GroupeMenu Cle="@($"admin-theme:{theme}")" Titre="@theme" Variante="theme" OuvertParDefaut="false" ContientActif="@permises.Any(r => r.Lien == Actif)">
            @foreach (var r in permises)
            {
                var actif = r.Lien == Actif;
                IReadOnlyList<(string Id, string Libelle)> sous = actif ? SousRubriques(r.Lien!) : [];
                @if (sous.Count > 0)
                {
                    @* Écran affiché qui a des sous-rubriques : son nom devient un titre qui replie ou déplie ses sous-rubriques
                       (rubriques repliables homogènes, 2026-11-27) ; seule la sous-rubrique affichée porte le bandeau ambre *@
                    <GroupeMenu Cle="@($"admin-ecran:{r.Lien}")" Titre="@r.Libelle" ContientActif="true">
                        @foreach (var (id, libelle) in sous)
                        {
                            var courante = id == RubriqueCourante(r.Lien!, Rubrique);
                            <a href="@(id == sous[0].Id ? r.Lien : $"{r.Lien}?rubrique={id}")" class="sous-rubrique @(courante ? "active" : null)" aria-current="@(courante ? "page" : null)">@libelle</a>
                        }
                    </GroupeMenu>
                }
                else
                {
                    @* Écran à sous-rubriques, replié : chevron « › » (tout menu dépliable porte son chevron, à tout niveau) *@
                    <a href="@r.Lien" class="@(actif ? "active" : null)" aria-current="@(actif ? "page" : null)">@if (SousRubriques(r.Lien!).Count > 0) {<span class="chevron-menu" aria-hidden="true"></span>}@r.Libelle</a>
                }
            }
        </GroupeMenu>
    }
</nav>
}

@code {
    private ElementReference menu;
    private string? lienVu;

    // Lien affiché toujours visible dans le menu de gauche (bandeau ambre), même en bas d'un long menu ou en fenêtre basse :
    // le menu défile jusqu'à lui dès le rendu, à chaque changement d'écran ou de sous-rubrique (docs/charte-graphique.md)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var lien = $"{Actif}?{RubriqueCourante(Actif, Rubrique)}";
        if (Session.SuperAdmin || lien == lienVu) return;
        lienVu = lien;
        try { await JS.InvokeVoidAsync("pharma.voirLienActif", menu); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

