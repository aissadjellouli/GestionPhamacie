        ["admin/nomenclature"] = [("version", "Version et catégories"), ("verifier", "Produits à vérifier"), ("classer", "Produits à classer")],
        ["admin/psychotropes"] = [("alertes", "Alertes du registre"), ("antibiotiques", "Suivi des antibiotiques")],
        ["admin/pharmacie"] = [("pharmacie", "Pharmacie et langue"), ("organismes", "Organismes payeurs"), ("medecins", "Médecins prescripteurs")]
    };

    private static IReadOnlyList<(string Id, string Libelle)> SousRubriques(string lien) => Sous.TryGetValue(lien, out var s) ? s : [];

    /// <summary>Sous-rubrique affichée par un écran : celle de l'adresse si elle existe, sinon la première (vide sans sous-rubriques).</summary>
    public static string RubriqueCourante(string lien, string? demandee)
    {
        var s = SousRubriques(lien);
        return s.Count == 0 ? "" : s.Any(x => x.Id == demandee) ? demandee! : s[0].Id;
    }

    /// <summary>Nom d'un écran d'administration (« admin/droits » → « Utilisateurs et droits ») ; null s'il n'est pas dans le menu.</summary>
    public static string? LibelleEcran(string lien) => Rubriques.FirstOrDefault(r => r.Lien == lien)?.Libelle;

    /// <summary>Libellé de la sous-rubrique affichée, pour le titre de l'écran (« Sauvegardes · Journal des sauvegardes »).</summary>
    public static string Libelle(string lien, string? demandee)
    {
        var id = RubriqueCourante(lien, demandee);
        return SousRubriques(lien).FirstOrDefault(x => x.Id == id).Libelle ?? "";
    }
}
