@inherits LayoutComponentBase
@implements IDisposable
@inject SessionPoste Session
@inject ConfigurationPoste Poste
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HistoriqueNavigation Historique
@inject TachesLaissees Taches
@inject CompteursAttente Compteurs

<header class="entete">
    <div class="entete-interieur">
        @* Logo : retour à l'accueil de l'employé (tableau de bord, ou Caisse pour le vendeur) *@
        <a class="marque" href="@(Session.EstConnecte && !Session.SuperAdmin ? Domaines.Accueil(Session) : null)" title="@($"{Poste.NomLogiciel} · {SousTitre} · Accueil")">
            <img class="logo" src="img/logo.svg" alt="" aria-hidden="true" />
            <div class="marque-textes">
                <span class="marque-nom">@Poste.NomLogiciel</span>
                <span class="marque-poste">@SousTitre</span>
            </div>
        </a>
        @if (Session.EstConnecte && Session.SuperAdmin)
        {
            @* Super admin : ses seuls écrans ; aucun écran des employés *@
            <nav class="nav" aria-label="Navigation du super admin">
                <a href="admin/restauration" class="@Actif("admin/restauration")" aria-current="@Courant("admin/restauration")">Restauration</a>
                <a href="admin/reprise" class="@Actif("admin/reprise")" aria-current="@Courant("admin/reprise")">Reprise de données</a>
                <a href="admin/profils-reprise" class="@Actif("admin/profils-reprise")" aria-current="@Courant("admin/profils-reprise")">Profils de reprise</a>
            </nav>
            <div class="utilisateur">
                <span>Connecté : @Session.NomComplet</span>
                <button type="button" class="lien-bouton" @onclick="SeDeconnecter">Se déconnecter</button>
            </div>
        }
        else if (Session.EstConnecte)
        {
            @* Retour à l'écran précédent avec son état (aussi Alt + ← et le bouton précédent de la souris) *@
            <button type="button" class="lien-bouton bouton-retour" disabled="@(!Historique.PeutRevenir)" @onclick="Historique.Retour"
                    title="@(Historique.EcranPrecedent is { } ecranPrecedent ? $"Revenir à {ecranPrecedent}, tel que vous l’avez laissé (Alt + ←)" : "Aucun écran précédent")"
                    aria-label="@(Historique.EcranPrecedent is { } p ? $"Retour à l’écran précédent : {p}" : "Retour : aucun écran précédent")"><span class="fleche" aria-hidden="true">←</span><span class="libelle-retour">@(Historique.EcranPrecedent ?? "Retour")</span></button>

            @* Menu en deux niveaux (docs/navigation.md) : en haut les domaines (Services/Domaines), à gauche leurs écrans (NavDomaine) ;
               un domaine sans écran permis n'apparaît pas. Raccourci : Ctrl + Maj + la lettre affichée (poste.js). *@
            <nav class="nav" aria-label="Navigation principale">
                @foreach (var d in Domaines.Tous.Where(d => d.Visible(Session)))
                {
                    var actif = DomaineCourant == d;
                    <a href="@d.Lien(Session)" class="@(actif ? "active" : null)" aria-current="@(actif ? "page" : null)" data-touche="@d.Touche"
                       title="@($"{d.Libelle} (Ctrl + Maj + {d.Touche})")">
                        @d.Libelle
                        @if (d.Id == "stock" && urgentes > 0 && Chemin != "")
                        {
                            <span class="compteur" aria-label="@($"{urgentes} alertes urgentes")">@urgentes</span>
                        }
                        else if (Compteurs.Domaine(d.Id) is { } attente)
                        {
                            @* Travail en attente du domaine (réceptions et bons en brouillon ; factures à encaisser et sommes en alerte) *@
                            <span class="compteur @(attente.Urgent ? null : "neutre")" aria-label="@($"{attente.Nombre} en attente")">@attente.Nombre</span>
                        }
                        <span class="touche" aria-hidden="true">⇧@d.Touche</span>
                    </a>
                }
            </nav>
            <button type="button" class="bouton-recherche" @onclick="() => rechercheOuverte = true" title="Rechercher un écran, un produit, un patient (Ctrl + K)"
                    aria-label="Rechercher partout (Ctrl + K)"><span aria-hidden="true">⌕</span><span class="texte-recherche"> Rechercher…</span> <span class="touche" aria-hidden="true">Ctrl K</span></button>

            <div class="outils-utilisateur">
                @if (PremiereRubriqueAdmin is { } lienAdmin)
                {
                    <a href="@lienAdmin" class="nav-icone @ActifPrefixe("admin")" aria-current="@(Chemin.StartsWith("admin") ? "page" : null)"
                       title="Administration" aria-label="Administration">⚙</a>
                }
                <div class="nav-groupe" @onkeydown="ToucheMenu">
                    <button type="button" class="bouton-utilisateur" aria-haspopup="true" aria-expanded="@(menuOuvert == "utilisateur" ? "true" : "false")"
                            @onclick="@(() => Basculer("utilisateur"))">@Session.NomComplet<span class="chevron" aria-hidden="true"></span></button>
                    @if (menuOuvert == "utilisateur")
                    {
                        <div class="menu-panneau menu-droite" aria-label="Mon compte">
                            @if (Session.ParCode)
                            {
                                <span class="inactif" title="Connecté par code comptoir : écrans du comptoir seulement"><span class="badge-code">code comptoir</span></span>
                            }
                            else
                            {
                                <a href="mon-code" @onclick="FermerMenus">Mon code comptoir</a>
                                <a href="mot-de-passe" @onclick="FermerMenus">Mot de passe</a>
                            }
                            <button type="button" class="bouton-affichage" @onclick="ChangerAffichageAsync"
                                    title="Affichage : Automatique (suit Windows), Clair ou Sombre. Cliquer pour changer ; votre choix est retenu."
                                    aria-label="@($"Affichage : {LibelleAffichage}. Changer l’affichage")">Affichage : @SymboleAffichage @LibelleAffichage</button>
                            @* Zoom de tout l'écran (80 à 150 %), retenu par le poste : il dépend de la taille de l'écran *@
                            <div class="ligne-zoom" role="group" aria-label="Zoom de l’écran">
                                <span>Zoom</span>
                                <button type="button" class="bouton-zoom" disabled="@(zoom <= ZoomMin)" @onclick="() => ZoomerAsync(-10)" aria-label="Réduire le zoom">−</button>
                                <button type="button" class="valeur-zoom" @onclick="() => ZoomerAsync(100 - zoom)" title="Revenir à 100 %" aria-label="@($"Zoom {zoom} %, revenir à 100 %")">@zoom %</button>
                                <button type="button" class="bouton-zoom" disabled="@(zoom >= ZoomMax)" @onclick="() => ZoomerAsync(10)" aria-label="Agrandir le zoom">+</button>
                            </div>
                            <a href="guide" @onclick="FermerMenus" title="Ce qu’il faut essayer, et vos remarques">Guide et retours</a>
                            <hr />
                            <button type="button" @onclick="ChangerUtilisateur" title="La caisse du poste reste ouverte">Changer d’utilisateur</button>
                            <button type="button" @onclick="SeDeconnecter">Se déconnecter</button>
                        </div>
                    }
                </div>
                <button type="button" class="lien-bouton bouton-changer" @onclick="ChangerUtilisateur" title="Changer d’utilisateur : la caisse du poste reste ouverte" aria-label="Changer d’utilisateur"><span class="fleche" aria-hidden="true">⇄</span>Changer</button>
            </div>
        }
    </div>
</header>
@* « ⇄ Changer » avec une caisse ouverte : relève proposée avant de passer la main *@
@if (proposerReleve)
{
    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-releve-changer" tabindex="-1" @onkeydown="ToucheReleve">
        <section class="panneau fenetre-releve">
            <h2 id="t-releve-changer">Faire la relève avant de changer d’utilisateur ?</h2>
            <p style="margin: 0">La caisse de ce poste est ouverte. Avant de passer la main, vous pouvez faire la relève : vous comptez
                le tiroir, la caisse est clôturée puis rouverte aussitôt avec l’argent compté. Ainsi, chacun répond seulement de sa propre période.</p>
            <p class="detail" style="margin: 0">La relève est facultative.</p>
            <div style="display: flex; gap: 8px; flex-wrap: wrap">
                <button type="button" class="btn btn-principal" @onclick="FaireReleve">Faire la relève</button>
                <button type="button" class="btn" disabled="@changementEnCours" @onclick="ConfirmerChangementAsync">Changer sans relève</button>
                <button type="button" class="btn" @onclick="() => proposerReleve = false">Annuler</button>
            </div>
        </section>
    </div>
}
@* « ⇄ Changer » alors que la vente de la Caisse n'a pas pu être mise en attente (serveur injoignable…) : rien n'est fermé,
   le panier reste affiché ; l'employé réessaie ou reste sur la vente (docs/regles-metier.md, 2026-11-21) *@
@if (echecChangement is not null)
{
    <div class="voile" role="alertdialog" aria-modal="true" aria-labelledby="t-echec-changer" aria-describedby="d-echec-changer" tabindex="-1" @onkeydown="ToucheEchecChangement">
        <section class="panneau fenetre-releve">
            <h2 id="t-echec-changer">Changement d’utilisateur impossible : la vente n’est pas mise en attente</h2>
            <div class="erreur" role="alert">@echecChangement</div>
            <p id="d-echec-changer">Le panier en cours n’a pas pu être confié au serveur. Pour ne pas le perdre, vous restez connecté et le panier
                reste affiché à la Caisse. Vérifiez que le PC serveur est allumé et relié, puis réessayez ; ou restez sur la vente pour la terminer.</p>
            <p class="detail">Le poste ne garde aucune copie du panier : tant qu’il n’est pas mis en attente sur le serveur, ne fermez pas le logiciel.</p>
            <div class="actions">
                <button type="button" class="btn btn-principal" disabled="@changementEnCours" @onclick="ConfirmerChangementAsync">@(changementEnCours ? "Nouvel essai…" : "Réessayer")</button>
                <button type="button" class="btn" disabled="@changementEnCours" @onclick="ResterSurLaVente">Rester sur la vente</button>
            </div>
        </section>
    </div>
}
@* Menu ouvert : un clic à côté le ferme (voile transparent sous l'en-tête) *@
@if (menuOuvert is not null)
{
    <div class="menu-voile" @onclick="FermerMenus"></div>
}
<main>
    @if (Session.EstConnecte && Session.DoitChangerMotDePasse && !Chemin.StartsWith("mot-de-passe", StringComparison.Ordinal))
    {
        @* Mot de passe provisoire : rien d'autre tant qu'il n'est pas changé *@
        <Redirection Vers="mot-de-passe" />
    }
    else if (Session.EstConnecte || EstPageConnexion)
    {
        @* Erreur imprévue dans un écran : elle s'affiche ici au lieu d'arrêter le poste ; le reste du logiciel reste utilisable *@
        <ErrorBoundary @ref="garde">
            <ChildContent>
                @if (messageAcces is not null) { <div class="bandeau-attention" role="alert" style="margin: 16px 24px 0">@messageAcces</div> }
                @if (Session.EstConnecte && !Session.SuperAdmin && !bandeauMasque && Taches.Visibles(Session) is { Count: > 0 } laissees)
                {
                    @* Tâches longues laissées au « Changer d'utilisateur » : le nouvel employé les reprend sans rien refaire *@
                    <section class="bandeau-taches" aria-labelledby="t-taches">
                        <h2 id="t-taches">Tâches laissées en cours sur ce poste</h2>
                        <ul>
                            @foreach (var t in laissees)
                            {
                                <li>
                                    <span><strong>@t.Libelle</strong> <span class="detail">· laissée par @t.LaisseePar à @t.Le.ToString("HH:mm")</span></span>
                                    <button type="button" class="btn btn-principal" @onclick="() => ReprendreTache(t)">Reprendre</button>
                                </li>
                            }
                        </ul>
                        <div><button type="button" class="lien-bouton" @onclick="() => bandeauMasque = true">Plus tard</button> <span class="detail">(la liste reste gardée sur ce poste)</span></div>
                    </section>
                }
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <div class="erreur" role="alert">
                    <p style="margin: 0 0 8px"><strong>Cet écran a rencontré une erreur imprévue.</strong> Ce qui était déjà enregistré sur le serveur le reste : rechargez l’écran et vérifiez avant de recommencer.</p>
                    <p class="detail" style="margin: 0 0 8px">@exception.GetType().Name : @exception.Message</p>
                    <button type="button" class="btn" @onclick="() => garde?.Recover()">Recharger l’écran</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
        <FenetreContact />
        @if (Session.EstConnecte && !Session.SuperAdmin)
        {
            <RechercheGlobale @bind-Ouverte="rechercheOuverte" />
        }
        <BarreChargement />
        <FenetreAutorisation />
        <SignalementChamps />
    }
    else
    {
        <Redirection Vers="connexion" />
    }
</main>
<BarreEtat />

@code {
    private int urgentes;
    private PeriodicTimer? minuterie;

    private string Chemin => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');

    /// <summary>Nom enregistré en base, sinon réglage du poste (PHARMA_PHARMACIE), puis nom du poste.</summary>
    private string SousTitre => (Session.NomPharmacie ?? Poste.Pharmacie) is { } nom ? $"{nom} · {Poste.Poste}" : Poste.Poste;

    private string? PremiereRubriqueAdmin =>
        NavAdmin.Accessibles.FirstOrDefault(r => Session.A(r.Permission)).Lien;
    private bool EstPageConnexion => Chemin.StartsWith("connexion", StringComparison.Ordinal);

    private string? Actif(params string[] chemins) => chemins.Contains(Chemin) ? "active" : null;
    private string? Courant(params string[] chemins) => chemins.Contains(Chemin) ? "page" : null;
    private string? ActifPrefixe(params string[] prefixes) => prefixes.Any(p => Chemin.StartsWith(p, StringComparison.Ordinal)) ? "active" : null;
    private bool EstActif(string[] chemins) => chemins.Any(c => Chemin == c || Chemin.StartsWith(c + "/", StringComparison.Ordinal));

    // ---- Domaine affiché (menu du haut) et recherche partout (Ctrl + K, ouverte par poste.js ou le bouton) ----
    private Domaines.Domaine? DomaineCourant => Domaines.De(Chemin).Domaine;
    private bool rechercheOuverte;

    // ---- Menu déroulant du compte de l'employé ----
    private string? menuOuvert;
    private void Basculer(string cle) => menuOuvert = menuOuvert == cle ? null : cle;
    private void FermerMenus() => menuOuvert = null;
    private void ToucheMenu(KeyboardEventArgs e) { if (e.Key == "Escape") FermerMenus(); }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += SurNavigation;
        Session.Changee += SurSession;
        Historique.Demarrer();
        Historique.Change += SurHistorique;
        Taches.Change += SurTaches;
        Compteurs.Change += SurCompteurs;
        Api.AlertesModifiees += SurSession;
        await CompterUrgentesAsync();
        _ = SurveillerInactiviteAsync();
    }

    private async Task CompterUrgentesAsync()
    {
        if (!Session.EstConnecte || Session.SuperAdmin) { urgentes = 0; return; }
        var (compte, erreur) = await Api.AlertesUrgentesAsync();
        urgentes = erreur is null ? compte?.Nombre ?? 0 : 0;
        await Compteurs.ActualiserAsync();   // travail en attente : au plus toutes les 30 s (aussitôt pour un nouvel employé)
    }

    private void SurCompteurs() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Déconnexion automatique (paramètre de caisse) : vérifiée toutes les 15 secondes.</summary>
    private async Task SurveillerInactiviteAsync()
    {
        minuterie = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await minuterie.WaitForNextTickAsync())
            {
                if (!Session.EstConnecte || Session.DeconnexionMinutes <= 0) continue;
                var secondes = await JS.InvokeAsync<int>("pharma.inactiviteSecondes");
                if (secondes < Session.DeconnexionMinutes * 60) continue;
                await InvokeAsync(() =>
                {
                    Session.Fermer($"Déconnexion automatique après {Session.DeconnexionMinutes} minutes d’inactivité.");
                    Nav.NavigateTo("connexion");
                });
            }
        }
        catch (ObjectDisposedException) { /* fenêtre fermée */ }
        catch (JSDisconnectedException) { /* fenêtre fermée */ }
    }

    private ErrorBoundary? garde;

    // Écrans réservés à un droit (comme le menu) : sans ce droit, retour à l'accueil avec le droit nécessaire.
    // Liste commune avec les tuiles navigables (AccesEcrans, 2026-11-21) : une tuile n'est un lien que vers un écran permis.
    private static string[] EcransSuperAdmin => AccesEcrans.EcransSuperAdmin;
    private string? messageAcces;

    private bool VerifierAcces()
    {
        if (!Session.EstConnecte || EstPageConnexion) return true;
        // Super admin : seulement ses écrans
        if (Session.SuperAdmin)
        {
            if (EcransSuperAdmin.Contains(Chemin)) return true;
            Nav.NavigateTo(EcransSuperAdmin[0], replace: true);
            return false;
        }
        var (chemin, droits) = AccesEcrans.Reserve(Chemin);
        if (chemin is null || droits.Any(Session.A)) return true;
        messageAcces = droits.All(d => d == "role.titulaire")
            ? "Écran réservé au pharmacien titulaire."
            : droits.All(d => d == "role.super_admin")
            ? "Écran réservé au super admin (bouton « Connexion super admin » de l’écran de connexion)."
            : $"Écran réservé : le droit « {string.Join(" » ou « ", droits.Select(Libelles.Droit))} » est nécessaire. Demandez-le au titulaire.";
        redirectionAcces = Domaines.Accueil(Session);
        Nav.NavigateTo(redirectionAcces, replace: true);
        return false;
    }

    /// <summary>Accueil où l'employé vient d'être renvoyé (écran refusé) : le message y reste affiché, puis s'efface à l'écran suivant.</summary>
    private string? redirectionAcces;

    private async void SurNavigation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Changer d'écran efface l'erreur affichée par le précédent et ferme les menus déroulants
        garde?.Recover();
        menuOuvert = null;
        var refuse = !VerifierAcces();
        if (!refuse) { if (Chemin == redirectionAcces) redirectionAcces = null; else messageAcces = null; }
        await CompterUrgentesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void SurSession()
    {
        if (!Session.EstConnecte) bandeauMasque = false;   // le prochain employé connecté voit les tâches laissées
        // Documents de l'ancien dossier du poste (ou restés au poste, serveur injoignable) : envoyés à la GED du serveur
        if (Session.EstConnecte && !Session.DoitChangerMotDePasse && !Session.SuperAdmin) _ = Documents.MigrerAsync(Api);
        await CompterUrgentesAsync();
        await InvokeAsync(async () => { await AppliquerAffichageAsync(); StateHasChanged(); });
    }

    // ---- Affichage clair, sombre ou automatique (choix de l'employé) ----
    private DotNetObjectReference<MiseEnPage>? reference;
    private string? affichageApplique;

    private string LibelleAffichage => Session.Affichage switch { "clair" => "Clair", "sombre" => "Sombre", _ => "Automatique" };
    private string SymboleAffichage => Session.Affichage switch { "clair" => "☀", "sombre" => "☾", _ => "◐" };

    protected override async Task OnAfterRenderAsync(bool premierAffichage)
    {
        if (!premierAffichage) return;
        reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pharma.affichage.suivre", reference);
        await JS.InvokeVoidAsync("pharma.retour.suivre", reference);
        zoom = await JS.InvokeAsync<int>("pharma.zoom.lire");
        StateHasChanged();
        await AppliquerAffichageAsync();
    }

    private async Task AppliquerAffichageAsync()
    {
        if (reference is null || affichageApplique == Session.Affichage) return;
        affichageApplique = Session.Affichage;
        try { BarreDeTitre.Appliquer(await JS.InvokeAsync<bool>("pharma.affichage.appliquer", Session.Affichage)); }
        catch (JSDisconnectedException) { /* fenêtre fermée */ }
    }

    private void SurHistorique() => _ = InvokeAsync(StateHasChanged);

    // ---- Zoom de l'écran (menu à son nom), retenu par le poste ----
    private const int ZoomMin = 80, ZoomMax = 150;
    private int zoom = 100;

    private async Task ZoomerAsync(int pas)
    {
        zoom = Math.Clamp(zoom + pas, ZoomMin, ZoomMax);
        await JS.InvokeVoidAsync("pharma.zoom.appliquer", zoom);
    }

    // ---- Tâches laissées au « Changer d'utilisateur » (bandeau) ----
    private bool bandeauMasque;
    private void SurTaches() { bandeauMasque = false; _ = InvokeAsync(StateHasChanged); }

    private void ReprendreTache(TacheLaissee t)
    {
        Taches.Choisir(t);
        var ecran = TachesLaissees.Ecran(t);
        // Déjà sur l'écran visé : il est rouvert pour qu'il reprenne la tâche à son ouverture
        if (Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/') == ecran) Nav.NavigateTo("");
        Nav.NavigateTo(ecran);
    }

    /// <summary>Alt + ← ou bouton précédent de la souris (poste.js).</summary>
    [JSInvokable]
    public void Retour() => Historique.Retour();

    /// <summary>Windows passe en clair ou en sombre (mode Automatique) : la barre de titre suit.</summary>
    [JSInvokable]
    public void SurChangementAffichage(bool sombre) => BarreDeTitre.Appliquer(sombre);

    /// <summary>Automatique → Clair → Sombre → Automatique ; enregistré pour l'employé.</summary>
    private async Task ChangerAffichageAsync()
    {
        var suivant = Session.Affichage switch { "auto" => "clair", "clair" => "sombre", _ => "auto" };
        Session.DefinirAffichage(suivant);
        await Api.DefinirAffichageAsync(suivant);
    }

    private void SeDeconnecter()
    {
        Session.Fermer();
        Nav.NavigateTo("connexion");
    }

    // Caisse partagée : l'employé suivant reprend la main par son code, sans fermer la caisse.
    // Caisse ouverte sur le poste : la relève est d'abord proposée (facultative), pour que chacun réponde de sa période.
    private bool proposerReleve;

    private async Task ChangerUtilisateur()
    {
        FermerMenus();
        if (!Session.ReleveFaite && Session.A("caisse.vendre"))
        {
            var (etat, _) = await Api.EtatCaisseAsync();
            if (etat?.SessionId is not null) { proposerReleve = true; return; }
        }
        await ConfirmerChangementAsync();
    }

    // Vente de la Caisse non mise en attente (serveur injoignable, encaissement en cours) : message bloquant, la session reste ouverte
    private string? echecChangement;
    private bool changementEnCours;

    private async Task ConfirmerChangementAsync()
    {
        proposerReleve = false;
        if (changementEnCours) return;
        changementEnCours = true;
        try { echecChangement = await Session.PreparerChangementUtilisateurAsync(); }
        finally { changementEnCours = false; }
        if (echecChangement is not null) return;
        Session.Fermer($"{Session.NomComplet} a quitté le poste. La caisse reste ouverte.", changementUtilisateur: true);
        Nav.NavigateTo("connexion");
    }

    private void FaireReleve()
    {
        proposerReleve = false;
        Nav.NavigateTo("cloture?releve=true");
    }

    private void ToucheReleve(KeyboardEventArgs e) { if (e.Key == "Escape") proposerReleve = false; }

    private void ResterSurLaVente() => echecChangement = null;

    private void ToucheEchecChangement(KeyboardEventArgs e) { if (e.Key == "Escape") ResterSurLaVente(); }

    public void Dispose()
    {
        minuterie?.Dispose();
        Nav.LocationChanged -= SurNavigation;
        Session.Changee -= SurSession;
        Api.AlertesModifiees -= SurSession;
        Historique.Change -= SurHistorique;
        Taches.Change -= SurTaches;
        Compteurs.Change -= SurCompteurs;
        reference?.Dispose();
    }
}
