@inject ApiClient Api

@* Médecins prescripteurs (créés à la caisse) : recherche et correction du nom, de la spécialité et des coordonnées
   (téléphone, e-mail, adresse, n° d'ordre, code CNAS : facultatifs, 2026-11-15). *@
<section class="panneau" aria-labelledby="t-medecins">
    <div>
        <h2 id="t-medecins">Médecins prescripteurs</h2>
        <p class="sous-titre">Créés à la caisse au fil des ordonnances. Corrigez ici un nom mal saisi, la spécialité ou les coordonnées ; le registre garde le lien avec chaque ordonnance.</p>
    </div>
    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }
    <div class="champ" style="max-width: 420px">
        <label for="md-recherche">Rechercher un médecin (2 lettres au moins)</label>
        <input id="md-recherche" type="search" autocomplete="off" @bind="recherche" @bind:event="oninput" @bind:after="ChercherAsync" />
    </div>
    @if (edition is { } e)
    {
        <div class="sous-formulaire fiche-medecin" role="group" aria-label="Correction du médecin">
            <input type="text" aria-label="Nom du médecin (obligatoire)" data-champ="nom_medecin" placeholder="Nom *" maxlength="120" @bind="e.Nom" />
            <input type="text" aria-label="Spécialité" data-champ="specialite" placeholder="Spécialité" maxlength="120" @bind="e.Specialite" />
            <input type="text" aria-label="Téléphone" data-champ="telephone" placeholder="Téléphone" maxlength="30" @bind="e.Telephone" />
            <input type="email" aria-label="E-mail" data-champ="email" placeholder="E-mail" maxlength="120" @bind="e.Email" />
            <input type="text" aria-label="Adresse" data-champ="adresse_medecin" placeholder="Adresse" maxlength="300" @bind="e.Adresse" />
            <input type="text" aria-label="N° d’inscription à l’Ordre" data-champ="numero_ordre" placeholder="N° d’ordre" maxlength="30" @bind="e.NumeroOrdre" />
            <input type="text" aria-label="Code CNAS (Chifa)" data-champ="code_cnas" placeholder="Code CNAS" maxlength="30" @bind="e.CodeCnas" />
            <div class="actions">
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">Enregistrer</button>
                <button type="button" class="btn" @onclick="() => edition = null">Annuler</button>
            </div>
        </div>
    }
    @if (medecins.Count > 0)
    {
        @* Résultats bornés par le serveur (20 au plus, recherche par nom) : pas de pagination *@
        <div class="tableau-cadre">
            <table class="tableau" style="min-width: 0">
                <thead><tr><th scope="col">Nom</th><th scope="col">Spécialité</th><th scope="col">Téléphone</th><th scope="col">N° d’ordre</th><th scope="col">Code CNAS</th>
                    <th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
                <tbody>
                    @foreach (var m in medecins)
                    {
                        <tr>
                            <td class="nom" title="@(string.Join(" · ", new[] { m.Email, m.Adresse }.Where(x => !string.IsNullOrWhiteSpace(x))))">@m.Nom</td>
                            <td>@(m.Specialite ?? "—")</td>
                            <td>@(m.Telephone ?? "—")</td>
                            <td>@(m.NumeroOrdre ?? "—")</td>
                            <td>@(m.CodeCnas ?? "—")</td>
                            <td><button type="button" class="lien-bouton" @onclick="() => Editer(m)">Modifier</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private sealed class Edition
    {
        public long Id { get; init; }
        public string Nom { get; set; } = "";
        public string? Specialite { get; set; }
        public string? Telephone { get; set; }
        public string? Email { get; set; }
        public string? Adresse { get; set; }
        public string? NumeroOrdre { get; set; }
        public string? CodeCnas { get; set; }
    }

    private string recherche = "";
    private List<MedecinDto> medecins = [];
    private Edition? edition;
    private string? erreur, message;
    private bool enCours;

    private void Editer(MedecinDto m) => (edition, erreur, message) = (new Edition
    {
        Id = m.Id, Nom = m.Nom, Specialite = m.Specialite, Telephone = m.Telephone, Email = m.Email, Adresse = m.Adresse,
        NumeroOrdre = m.NumeroOrdre, CodeCnas = m.CodeCnas
    }, null, null);

    private async Task ChercherAsync()
    {
        if (recherche.Trim().Length < 2) { medecins = []; return; }
        (medecins, erreur) = await Api.RechercherMedecinsAsync(recherche.Trim());
    }

    private async Task EnregistrerAsync()
    {
        if (edition is not { } e || enCours) return;
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var err = await Api.ModifierMedecinAsync(e.Id, new NouveauMedecinDto(e.Nom, e.Specialite, e.Telephone, e.Adresse, e.Email, e.NumeroOrdre, e.CodeCnas));
            if (err is not null) { erreur = err; return; }
            message = $"Médecin « {e.Nom.Trim()} » enregistré.";
            edition = null;
            await ChercherAsync();
        }
        finally { enCours = false; }
    }
}
