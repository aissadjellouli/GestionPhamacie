@inject ApiClient Api
@inject HistoriqueNavigation Historique

@* Organismes payeurs (tiers payant et factures) : CNAS, CASNOS, organisme des militaires… Modification réservée au titulaire. *@
<section class="panneau" aria-labelledby="t-organismes">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px">
        <div>
            <h2 id="t-organismes">Organismes payeurs</h2>
            <p class="sous-titre">Proposés au tiers payant de la caisse et destinataires des factures. Adresse et NIF sont imprimés sur leurs factures.</p>
        </div>
        <button type="button" class="btn" @onclick="() => edition = new Edition()">Ajouter un organisme</button>
    </div>
    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }
    @if (edition is { } e)
    {
        <div class="achats-ligne">
            <div class="champ" style="flex: 0 0 120px"><label for="o-code" class="requis">Sigle</label><input id="o-code" data-champ="sigle" type="text" maxlength="20" @bind="e.Code" /></div>
            <div class="champ" style="flex: 1 1 260px"><label for="o-nom" class="requis">Nom</label><input id="o-nom" data-champ="nom_organisme" type="text" @bind="e.Nom" /></div>
            <div class="champ" style="flex: 1 1 220px"><label for="o-adr">Adresse</label><input id="o-adr" type="text" @bind="e.Adresse" /></div>
            <div class="champ" style="flex: 0 0 180px"><label for="o-nif">NIF</label><input id="o-nif" type="text" @bind="e.Nif" /></div>
            <div class="champ" style="flex: 0 0 180px"><label for="o-tel">Téléphone</label><input id="o-tel" data-champ="telephone" type="tel" maxlength="30" @bind="e.Telephone" /></div>
            <div class="champ" style="flex: 1 1 220px"><label for="o-mail">E-mail</label><input id="o-mail" data-champ="email" type="email" maxlength="120" @bind="e.Email" /></div>
            <div class="champ" style="flex: 0 0 170px"><label for="o-delai">Délai de paiement (jours)</label><input id="o-delai" data-champ="delai_paiement" type="number" min="1" max="365" @bind="e.DelaiPaiementJours" /></div>
        </div>
        <label class="case"><input type="checkbox" @bind="e.Actif" /><span>Actif (proposé à la caisse)</span></label>
        <div class="filtres">
            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">Enregistrer</button>
            <button type="button" class="btn" @onclick="() => edition = null">Annuler</button>
        </div>
    }
    @* Tableau filtré et paginé par le serveur (règle des listes, 2026-11-15) ; caché le temps de la saisie d'une fiche (écran fixe) *@
    @if (edition is null)
    {
    <div class="filtres-liste" role="search" aria-label="Filtrer les organismes payeurs">
        <div class="champ" style="flex: 1 1 240px"><label for="fo-texte">Sigle, nom, adresse, téléphone ou NIF</label>
            <input id="fo-texte" type="search" autocomplete="off" value="@fTexte" @oninput="RechercheAsync" /></div>
        <div class="champ" style="flex: 0 0 170px"><label for="fo-etat">État</label>
            <select id="fo-etat" @bind="fEtat" @bind:after="() => ChargerAsync(1, taille)"><option value="">Tous</option><option value="actif">Actifs</option><option value="inactif">Inactifs</option></select></div>
        @if (FiltreActif) { <button type="button" class="btn" @onclick="ToutAfficherAsync">Tout afficher</button> }
    </div>
    <div class="tableau-cadre">
        <table class="tableau">
            <thead><tr><th scope="col">Sigle</th><th scope="col">Nom</th><th scope="col">Adresse</th><th scope="col">Téléphone</th><th scope="col">NIF</th><th scope="col">Délai de paiement</th><th scope="col">État</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
            <tbody>
                @foreach (var o in organismes)
                {
                    <tr>
                        <td><strong>@o.Code</strong></td><td><LienContact Type="organisme" Id="o.Id" Nom="@o.Nom" /></td><td>@(o.Adresse ?? "—")</td><td>@(o.Telephone ?? "—")</td><td>@(o.Nif ?? "—")</td><td>@o.DelaiPaiementJours j</td>
                        <td>@(o.Actif ? "Actif" : "Inactif")</td>
                        <td><button type="button" class="lien-bouton" @onclick="() => Modifier(o)">Modifier</button></td>
                    </tr>
                }
                @if (organismes.Count == 0 && erreur is null) { <tr><td colspan="8" class="vide">@(FiltreActif ? "Aucun organisme pour ces filtres." : "Aucun organisme payeur.")</td></tr> }
            </tbody>
        </table>
    </div>
    <Pagination Total="total" Numero="page" Taille="taille" Libelle="Pages des organismes payeurs" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
    }
</section>

@code {
    private sealed class Edition
    {
        public long? Id { get; init; }
        public string Code { get; set; } = "";
        public string Nom { get; set; } = "";
        public string? Adresse { get; set; }
        public string? Nif { get; set; }
        public string? Telephone { get; set; }
        public string? Email { get; set; }
        public bool Actif { get; set; } = true;
        public int DelaiPaiementJours { get; set; } = 30;
    }

    private List<OrganismeFicheDto> organismes = [];
    private Edition? edition;
    private string? erreur, message;
    private bool enCours;

    private int total, page = 1, taille = Pagination.TailleParDefaut, saisie;
    private string fTexte = "", fEtat = "";
    private bool FiltreActif => fTexte.Trim() != "" || fEtat != "";

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : filtres et page retrouvés
        Historique.Suivre("organismes", e => { e.Mettre("texte", fTexte); e.Mettre("etat", fEtat); e.Mettre("page", page); e.Mettre("taille", taille); });
        if (Historique.Restaurer("organismes") is { } h)
            (fTexte, fEtat, page, taille) = (h.Texte("texte") ?? "", h.Texte("etat") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
        await ChargerAsync(page, taille);
    }

    private Task ToutAfficherAsync() { (fTexte, fEtat) = ("", ""); return ChargerAsync(1, taille); }

    private async Task RechercheAsync(ChangeEventArgs a)
    {
        fTexte = a.Value?.ToString() ?? "";
        var n = ++saisie;
        await Task.Delay(250);
        if (n == saisie) await ChargerAsync(1, taille);
    }

    private async Task ChargerAsync(int numero, int nouvelleTaille)
    {
        var (p, e) = await Api.OrganismesFichesPageAsync(fEtat, fTexte.Trim(), numero, nouvelleTaille);
        if (p is null) { erreur ??= e; return; }
        (organismes, total, page, taille) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille);
    }

    private void Modifier(OrganismeFicheDto o) =>
        edition = new Edition { Id = o.Id, Code = o.Code, Nom = o.Nom, Adresse = o.Adresse, Nif = o.Nif, Actif = o.Actif, Telephone = o.Telephone, Email = o.Email, DelaiPaiementJours = o.DelaiPaiementJours };

    private async Task EnregistrerAsync()
    {
        if (edition is not { } e) return;
        (enCours, erreur, message) = (true, null, null);
        var (_, err) = await Api.EnregistrerOrganismeAsync(new OrganismeFicheDto(e.Id, e.Code, e.Nom, e.Adresse, e.Nif, e.Actif, e.Telephone, e.Email, e.DelaiPaiementJours));
        enCours = false;
        if (err is not null) { erreur = err; return; }
        message = $"Organisme « {e.Code} » enregistré.";
        edition = null;
        await ChargerAsync(page, taille);
    }
}
