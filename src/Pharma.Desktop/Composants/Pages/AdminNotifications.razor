@page "/admin/notifications"
@inject ApiClient Api
@inject HistoriqueNavigation Historique
@inject NavigationManager Nav

<div class="page admin">
    <NavAdmin Actif="admin/notifications" Rubrique="@Rubrique" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Notifications au titulaire · @NavAdmin.Libelle("admin/notifications", Rubrique)</h1>
                <p class="sous-titre">Rapport du soir par e-mail, alertes urgentes par SMS. Réservé au pharmacien titulaire.</p>
            </div>
            @* Seule la rubrique « E-mail et SMS » porte des réglages (recette 2026-11-15) *@
            @if (rubrique == "envoi") { <button type="button" class="btn btn-principal" disabled="@(r is null || enCours)" @onclick="EnregistrerAsync">Enregistrer les réglages</button> }
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }
        <div class="bandeau-attention" role="note">Aucune donnée de patient ni d’ordonnance n’est envoyée : chiffres, employés et noms de produits seulement.</div>

        @if (r is not null)
        {
            @if (rubrique == "envoi")
            {
            <section class="panneau" aria-labelledby="t-smtp">
                <h2 id="t-smtp">E-mail (serveur SMTP de la pharmacie)</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 2 1 220px"><label for="n-serveur" class="@(string.IsNullOrWhiteSpace(r.SmtpExpediteur) ? null : "requis")">Serveur SMTP</label><input id="n-serveur" type="text" placeholder="ex. smtp.fournisseur.dz" @ref="champServeur" @bind="r.SmtpServeur" @bind:event="oninput"
                        class="@Obligatoire.Classe(ServeurManquant)" aria-invalid="@Obligatoire.Aria(ServeurManquant)" />
                        @if (ServeurManquant) { <span class="message-champ">Avec une adresse d’expéditeur, le serveur SMTP est obligatoire.</span> }</div>
                    <div class="champ" style="flex: 0 0 110px"><label for="n-port">Port</label><input id="n-port" data-champ="smtp_port" type="number" min="1" max="65535" @bind="r.SmtpPort" /></div>
                    <label class="case" style="flex: 0 0 auto; align-self: center"><input type="checkbox" @bind="r.SmtpTls" /><span>Connexion chiffrée (TLS)</span></label>
                </div>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 220px"><label for="n-exp" class="@(string.IsNullOrWhiteSpace(r.SmtpServeur) ? null : "requis")">Adresse de l’expéditeur</label><input id="n-exp" data-champ="smtp_expediteur" type="email" @ref="champExpediteur" @bind="r.SmtpExpediteur" @bind:event="oninput"
                        class="@Obligatoire.Classe(ExpediteurManquant)" aria-invalid="@Obligatoire.Aria(ExpediteurManquant)" />
                        @if (ExpediteurManquant) { <span class="message-champ">Avec un serveur SMTP, l’adresse de l’expéditeur est obligatoire.</span> }</div>
                    <div class="champ" style="flex: 1 1 200px"><label for="n-id">Identifiant</label><input id="n-id" type="text" autocomplete="off" @bind="r.SmtpIdentifiant" /></div>
                    <div class="champ" style="flex: 1 1 200px">
                        @* Boutons sur la ligne du libellé (liens de la hauteur du texte) : le champ reste aligné sur l'identifiant et l'e-mail *@
                        <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px; white-space: nowrap">
                            <label for="n-mdp">Mot de passe</label>
                            @if (motDePasseEnregistre && !changementMotDePasse)
                            {
                                <button type="button" class="lien-bouton" disabled="@enCours" @onclick="ChangerMotDePasse">Changer</button>
                            }
                            else
                            {
                                <span style="display: flex; gap: 10px">
                                    <button type="button" class="lien-bouton" disabled="@(enCours || string.IsNullOrEmpty(nouveauMotDePasse))" @onclick="EnregistrerMotDePasseAsync">Enregistrer</button>
                                    @if (changementMotDePasse)
                                    {
                                        <button type="button" class="lien-bouton" disabled="@enCours" @onclick="AnnulerChangementMotDePasse">Annuler</button>
                                    }
                                </span>
                            }
                        </div>
                        @if (motDePasseEnregistre && !changementMotDePasse)
                        {
                            @* Mot de passe déjà enregistré : jamais réaffiché, champ grisé ; le changer est un geste volontaire *@
                            <input id="n-mdp" type="text" value="Enregistré, chiffré" disabled />
                        }
                        else
                        {
                            <input id="n-mdp" type="password" autocomplete="new-password" data-champ="smtp_mot_de_passe" @ref="champMotDePasse"
                                   placeholder="@(motDePasseEnregistre ? "nouveau mot de passe" : "mot de passe du compte d’envoi")" @bind="nouveauMotDePasse" @bind:event="oninput" />
                        }
                    </div>
                </div>
            </section>

            <section class="panneau" aria-labelledby="t-sms">
                <h2 id="t-sms">SMS (modem GSM branché sur le serveur)</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 160px"><label for="n-com">Port du modem</label><input id="n-com" type="text" placeholder="ex. COM3 ; vide = pas de SMS" @bind="r.ModemPort" /></div>
                    <div class="champ" style="flex: 0 0 220px"><label for="n-seuil">SMS si écart de caisse au-delà de (DA)</label><input id="n-seuil" data-champ="sms_seuil" type="number" min="0" placeholder="seuil de la caisse" @bind="r.SmsSeuilEcart" /></div>
                    <div class="champ" style="flex: 0 0 180px"><label for="n-heure">Heure du rapport e-mail</label><input id="n-heure" type="time" @bind="r.HeureRapport" /></div>
                </div>
                @* Deux cases sur une ligne : la rubrique tient dans la fenêtre (écran fixe, recette 2026-11-15) *@
                <div style="display: flex; flex-wrap: wrap; gap: 8px 32px">
                    <label class="case"><input type="checkbox" @bind="r.SmsLotBloque" /><span>SMS quand un lot est bloqué ou rappelé</span></label>
                    <label class="case"><input type="checkbox" @bind="r.SmsSauvegarde" /><span>SMS quand une sauvegarde échoue ou que le disque externe est absent</span></label>
                </div>
                <label class="case"><input type="checkbox" @bind="r.SignalerSansDestinataire" /><span>Signaler à mon accueil une alerte (ou le rapport du soir) partie vers aucun destinataire vérifié ; une alerte bloquée par une panne y est toujours signalée</span></label>
                <p class="detail" style="margin: 0">Dernier rapport envoyé : @(dernierRapport is { } d ? Libelles.Date(d) : "jamais") ·
                    <button type="button" class="lien" disabled="@enCours" @onclick="RapportMaintenantAsync">envoyer le rapport du jour maintenant</button></p>
            </section>
            }
        }

        @if (rubrique == "formulaire-sms")
        {
            @* Texte du formulaire d'accord SMS des patients (2026-11-16) : imprimé depuis la fiche patient ou « Patients en attente » *@
            <section class="panneau" aria-labelledby="t-formulaire-sms" style="display: flex; flex-direction: column; gap: 8px">
                <h2 id="t-formulaire-sms">Formulaire d’accord SMS des patients</h2>
                <p class="detail" style="margin: 0">Imprimé avec l’en-tête de la pharmacie, le nom et le téléphone du patient, la date, la signature et le cachet.
                    Texte à faire valider (loi 18-07, ANPDP). Vide : texte par défaut.@(texteFormulaireParDefaut ? " Texte par défaut en cours." : "")</p>
                <textarea id="n-formulaire-sms" data-champ="texte_formulaire_sms" rows="12" maxlength="4000" aria-labelledby="t-formulaire-sms" @bind="texteFormulaire"></textarea>
                <div style="display: flex; gap: 8px">
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => EnregistrerTexteFormulaireAsync(false)">Enregistrer le texte</button>
                    <button type="button" class="btn" disabled="@enCours" @onclick="() => EnregistrerTexteFormulaireAsync(true)">Revenir au texte par défaut</button>
                </div>
            </section>
        }

        @if (rubrique == "destinataires")
        {
        <section class="panneau" aria-labelledby="t-dest">
            <h2 id="t-dest">Destinataires</h2>
            <p class="detail" style="margin: 0">Seules ces personnes reçoivent les messages, et seulement après vérification : envoyez un test, puis cochez « vérifié » quand la personne l’a reçu.</p>
            <div class="tableau-cadre">
                <table class="tableau" style="min-width: 760px">
                    <thead><tr><th scope="col">Nom</th><th scope="col">E-mail</th><th scope="col">Mobile</th><th scope="col">Messages</th><th scope="col">État</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var d in destinataires)
                        {
                            <tr>
                                <td class="nom">@d.Nom</td>
                                <td>@(d.CanalEmail ? d.Email : "—")</td>
                                <td>@(d.CanalSms ? d.Telephone : "—")</td>
                                <td class="detail">@string.Join(", ", d.Types.Select(LibelleType))</td>
                                <td><span class="pastille @(d.Actif ? d.Valide ? "ok" : "attention" : "")">@(d.Actif ? d.Valide ? "Vérifié" : "À vérifier" : "Désactivé")</span></td>
                                <td>
                                    <div style="display: flex; gap: 6px; flex-wrap: wrap">
                                        <button type="button" class="btn" disabled="@(enCours || !d.Actif)" @onclick="() => TestAsync(d)">Test</button>
                                        @if (d.Valide)
                                        {
                                            <button type="button" class="btn" disabled="@(enCours || !d.Actif)" @onclick="() => ValiderAsync(d, false)">Retirer la vérification</button>
                                        }
                                        else
                                        {
                                            @* Vérification par code : envoyé au destinataire, saisi ici par le titulaire *@
                                            <button type="button" class="btn" disabled="@(enCours || !d.Actif)" @onclick="() => EnvoyerCodeAsync(d)">@(codeEnvoyeA == d.Id ? "Renvoyer un code" : "Vérifier")</button>
                                            @if (codeEnvoyeA == d.Id)
                                            {
                                                <label class="visuellement-cache" for="code-@d.Id">Code reçu par @d.Nom</label>
                                                <input id="code-@d.Id" style="width: 9ch" inputmode="numeric" maxlength="6" autocomplete="one-time-code"
                                                       placeholder="Code reçu" data-champ="code" @bind="codeSaisi" @bind:event="oninput" />
                                                <button type="button" class="btn btn-principal" disabled="@(enCours || string.IsNullOrWhiteSpace(codeSaisi))" @onclick="() => VerifierCodeAsync(d)">Valider le code</button>
                                            }
                                        }
                                        <button type="button" class="btn" disabled="@enCours" @onclick="() => Editer(d)">Modifier</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (destinataires.Count == 0)
                        {
                            <tr><td colspan="6" class="vide">Aucun destinataire : ajoutez le titulaire ci-dessous.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div><a href="admin/notifications?rubrique=fiche" class="btn" @onclick="() => (fiche, controleDest) = (new(), false)">Ajouter un destinataire</a></div>
        </section>
        }

        @if (rubrique == "fiche")
        {
        <section class="panneau" aria-labelledby="t-fiche">
            <h2 id="t-fiche">@(fiche.Id is null ? "Ajouter un destinataire" : $"Modifier {fiche.Nom}")</h2>
            <div class="achats-ligne">
                <div class="champ" style="flex: 1 1 180px"><label for="d-nom" class="requis">Nom</label><input id="d-nom" data-champ="nom_destinataire" type="text" @ref="champNomDest" @bind="fiche.Nom" @bind:event="oninput"
                    class="@Obligatoire.Classe(NomDestManquant)" aria-invalid="@Obligatoire.Aria(NomDestManquant)" /></div>
                <div class="champ" style="flex: 1 1 220px"><label for="d-mail" class="@(fiche.CanalEmail ? "requis" : null)">E-mail</label><input id="d-mail" data-champ="email" type="email" @ref="champMail" @bind="fiche.Email" @bind:event="oninput"
                    class="@Obligatoire.Classe(MailManquant)" aria-invalid="@Obligatoire.Aria(MailManquant)" /></div>
                <div class="champ" style="flex: 1 1 160px"><label for="d-tel" class="@(fiche.CanalSms ? "requis" : null)">Mobile</label><input id="d-tel" data-champ="telephone" type="tel" placeholder="06 61 00 00 00" @ref="champTel" @bind="fiche.Telephone" @bind:event="oninput"
                    class="@Obligatoire.Classe(TelManquant)" aria-invalid="@Obligatoire.Aria(TelManquant)" /></div>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px 18px">
                <span class="etiquette-champ requis">Envoi</span>
                <label class="case"><input type="checkbox" @bind="fiche.CanalEmail" /><span>par e-mail</span></label>
                <label class="case"><input type="checkbox" @bind="fiche.CanalSms" /><span>par SMS</span></label>
                <label class="case"><input type="checkbox" @bind="fiche.Actif" /><span>actif</span></label>
            </div>
            @if (CanalManquant) { <span class="message-champ">Choisissez au moins un canal : e-mail ou SMS.</span> }
            <div style="display: flex; flex-wrap: wrap; gap: 6px 18px">
                <span class="etiquette-champ requis">Messages</span>
                @foreach (var t in TypesAbonnables)
                {
                    <label class="case"><input type="checkbox" checked="@fiche.Types.Contains(t)" @onchange="e => Basculer(t, e)" /><span>@LibelleType(t)</span></label>
                }
            </div>
            @if (TypesManquants) { <span class="message-champ">Choisissez au moins un type de message.</span> }
            <div style="display: flex; gap: 8px">
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerDestinataireAsync">@(fiche.Id is null ? "Ajouter" : "Enregistrer")</button>
                <button type="button" class="btn" @onclick="AnnulerFiche">Annuler</button>
            </div>
        </section>
        }

        @if (rubrique == "file")
        {
        <section class="panneau" aria-labelledby="t-file">
            <div style="display: flex; justify-content: space-between; align-items: center">
                <h2 id="t-file">File d’attente</h2>
                <button type="button" class="btn" @onclick="() => ChargerFileAsync()">Actualiser</button>
            </div>
            <p class="detail" style="margin: 0">Sans internet ou sans modem, chaque message est réessayé après 1, 5, 15 puis 60 minutes, ensuite toutes les heures, pendant 7 jours.</p>
            <div class="filtres-liste" role="search" aria-label="Filtrer la file d’attente" style="margin-top: 8px">
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 220px"><label for="f-type">Objet</label>
                        <select id="f-type" data-champ="type" @bind="fileType" @bind:after="FiltrerFileAsync">
                            <option value="">Tous</option>
                            @foreach (var t in TypesFile) { <option value="@t">@LibelleTypeFile(t)</option> }
                        </select></div>
                    <div class="champ" style="flex: 0 0 160px"><label for="f-statut">Statut</label>
                        <select id="f-statut" data-champ="statut" @bind="fileStatut" @bind:after="FiltrerFileAsync">
                            <option value="">Tous</option>
                            @foreach (var s in StatutsFile) { <option value="@s">@LibelleStatut(s)</option> }
                        </select></div>
                    <div class="champ" style="flex: 0 0 160px"><label for="f-du">Du</label><input id="f-du" type="date" @bind="fileDu" @bind:after="FiltrerFileAsync" /></div>
                    <div class="champ" style="flex: 0 0 160px"><label for="f-au">Au</label><input id="f-au" type="date" data-champ="au" @bind="fileAu" @bind:after="FiltrerFileAsync" /></div>
                    @if (FiltreFileActif) { <button type="button" class="btn" style="align-self: end" @onclick="EffacerFiltresFileAsync">Tout afficher</button> }
                </div>
            </div>
            <div class="tableau-cadre">
                <table class="tableau" style="min-width: 760px">
                    <thead><tr><th scope="col">Créé</th><th scope="col">Canal</th><th scope="col">Destinataire</th><th scope="col">Objet / texte</th><th scope="col">Statut</th></tr></thead>
                    <tbody>
                        @foreach (var m in file)
                        {
                            <tr>
                                <td>@Libelles.DateHeureLocale(m.CreeLe)</td>
                                <td>@(m.Canal == "sms" ? "SMS" : "E-mail")</td>
                                <td>@m.Destinataire<br /><span class="detail">@m.Adresse</span></td>
                                <td>@(m.Objet ?? m.Corps)</td>
                                <td>
                                    <span class="pastille @(m.Statut == "envoye" ? "ok" : m.Statut == "echec" ? "urgent" : "attention")">@LibelleStatut(m.Statut)</span>
                                    @if (m.DerniereErreur is not null) { <br /><span class="detail">@m.DerniereErreur</span> }
                                    @if (m.Statut == "en_attente" && m.ProchaineTentative is { } p) { <br /><span class="detail">essai n° @(m.Tentatives + 1) à @p.ToLocalTime().ToString("HH:mm")</span> }
                                </td>
                            </tr>
                        }
                        @if (file.Count == 0) { <tr><td colspan="5" class="vide">@(FiltreFileActif ? "Aucun message pour ces filtres." : "Aucun message.")</td></tr> }
                    </tbody>
                </table>
            </div>
            <Pagination Total="fileTotal" Numero="filePage" Taille="fileTaille" Libelle="Pages de la file d’attente" OnChange="p => ChargerFileAsync(p.Numero, p.Taille)" />
        </section>
        }
    </div>
</div>

@code {
    /// <summary>Sous-rubrique dans l'adresse (admin/notifications?rubrique=…) : une partie à la fois, l'écran reste fixe.</summary>
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => NavAdmin.RubriqueCourante("admin/notifications", Rubrique);

    private sealed class Reglages
    {
        public string? SmtpServeur { get; set; }
        public int SmtpPort { get; set; } = 587;
        public bool SmtpTls { get; set; } = true;
        public string? SmtpExpediteur { get; set; }
        public string? SmtpIdentifiant { get; set; }
        public string? ModemPort { get; set; }
        public TimeOnly HeureRapport { get; set; } = new(21, 0);
        public decimal? SmsSeuilEcart { get; set; }
        public bool SmsLotBloque { get; set; } = true;
        public bool SmsSauvegarde { get; set; } = true;
        public bool SignalerSansDestinataire { get; set; } = true;
    }

    private sealed class Fiche
    {
        public long? Id { get; set; }
        public string? Nom { get; set; }
        public string? Email { get; set; }
        public string? Telephone { get; set; }
        public bool CanalEmail { get; set; } = true;
        public bool CanalSms { get; set; } = true;
        public bool Actif { get; set; } = true;
        public HashSet<string> Types { get; set; } = [.. TypesAbonnables];
    }

    private static readonly string[] TypesAbonnables = ["rapport_quotidien", "ecart_caisse", "lot_bloque", "sauvegarde", "ecart_inventaire", "lot_delaisse", "surveillance", "synchronisation"];

    private Reglages? r;
    private bool motDePasseEnregistre;
    private DateOnly? dernierRapport;
    private string? nouveauMotDePasse;
    private List<DestinataireDto> destinataires = [];
    private List<MessageSortantDto> file = [];
    private Fiche fiche = new();
    private bool enCours;
    private string? erreur, message;

    private string? texteFormulaire;
    private bool texteFormulaireParDefaut;

    private async Task ChargerTexteFormulaireAsync()
    {
        var (t, e) = await Api.TexteFormulaireSmsAsync();
        if (t is null) { erreur ??= e; return; }
        (texteFormulaire, texteFormulaireParDefaut) = (t.Texte, t.ParDefaut);
    }

    private async Task EnregistrerTexteFormulaireAsync(bool parDefaut) => await Executer(async () =>
    {
        var e = await Api.EnregistrerTexteFormulaireSmsAsync(parDefaut ? null : texteFormulaire);
        if (e is not null) return e;
        await ChargerTexteFormulaireAsync();
        message = parDefaut ? "Texte par défaut du formulaire rétabli." : "Texte du formulaire d’accord SMS enregistré.";
        return null;
    });

    protected override async Task OnInitializedAsync()
    {
        await ChargerReglagesAsync();
        await ChargerTexteFormulaireAsync();
        (destinataires, _) = await Api.DestinatairesAsync();
        // « ← Retour » : filtres et page de la file d'attente retrouvés tels qu'ils étaient
        Historique.Suivre("notifications", e =>
        {
            e.Mettre("type", fileType); e.Mettre("statut", fileStatut); e.Mettre("du", fileDu); e.Mettre("au", fileAu);
            e.Mettre("page", filePage); e.Mettre("taille", fileTaille);
        });
        if (Historique.Restaurer("notifications") is { } retour)
        {
            (fileType, fileStatut, fileDu, fileAu) = (retour.Texte("type") ?? "", retour.Texte("statut") ?? "", retour.Date("du"), retour.Date("au"));
            await ChargerFileAsync(retour.Entier("page") ?? 1, retour.Entier("taille") ?? fileTaille);
        }
        else await ChargerFileAsync();
    }

    private async Task ChargerReglagesAsync()
    {
        var (d, e) = await Api.ReglagesNotificationAsync();
        if (e is not null) { erreur = e; return; }
        r = new Reglages
        {
            SmtpServeur = d!.SmtpServeur, SmtpPort = d.SmtpPort, SmtpTls = d.SmtpTls, SmtpExpediteur = d.SmtpExpediteur, SmtpIdentifiant = d.SmtpIdentifiant,
            ModemPort = d.ModemPort, HeureRapport = d.HeureRapport, SmsSeuilEcart = d.SmsSeuilEcart, SmsLotBloque = d.SmsLotBloque, SmsSauvegarde = d.SmsSauvegarde,
            SignalerSansDestinataire = d.SignalerSansDestinataire
        };
        (motDePasseEnregistre, dernierRapport) = (d.MotDePasseEnregistre, d.DernierRapport);
    }

    // File d'attente : paginée et filtrée par le serveur, comme les autres listes ; un nouvel envoi garde la page et les filtres
    private int fileTotal, filePage = 1, fileTaille = Pagination.TailleParDefaut;
    private string fileType = "", fileStatut = "";
    private DateOnly? fileDu, fileAu;
    private bool FiltreFileActif => fileType != "" || fileStatut != "" || fileDu is not null || fileAu is not null;
    private static readonly string[] StatutsFile = ["en_attente", "envoye", "echec"];
    private static IEnumerable<string> TypesFile => TypesAbonnables.Append("test");
    private static string LibelleTypeFile(string t) => t == "test" ? "Test et code de vérification" : LibelleType(t);

    private Task ChargerFileAsync() => ChargerFileAsync(filePage, fileTaille);
    private Task FiltrerFileAsync() => ChargerFileAsync(1, fileTaille);
    private Task EffacerFiltresFileAsync() { (fileType, fileStatut, fileDu, fileAu) = ("", "", null, null); return FiltrerFileAsync(); }

    private async Task ChargerFileAsync(int page, int taille)
    {
        var (p, e) = await Api.FileMessagesAsync(page, taille, fileType, fileStatut, fileDu, fileAu);
        if (e is not null) { erreur = e; return; }
        // Page au-delà de la fin (messages purgés, filtre plus étroit) : retour à la première
        if (p!.Lignes.Count == 0 && page > 1) { await ChargerFileAsync(1, taille); return; }
        (file, fileTotal, filePage, fileTaille) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille);
    }

    // Champs obligatoires : SMTP (serveur et expéditeur vont ensemble), destinataire (nom, canal, adresse du canal, type)
    private bool controleSmtp, controleDest;
    private ElementReference champServeur, champExpediteur, champNomDest, champMail, champTel;
    private bool ServeurManquant => controleSmtp && r is not null && string.IsNullOrWhiteSpace(r.SmtpServeur) && !string.IsNullOrWhiteSpace(r.SmtpExpediteur);
    private bool ExpediteurManquant => controleSmtp && r is not null && string.IsNullOrWhiteSpace(r.SmtpExpediteur) && !string.IsNullOrWhiteSpace(r.SmtpServeur);
    private bool NomDestManquant => Obligatoire.Manque(controleDest, fiche.Nom);
    private bool CanalManquant => controleDest && !fiche.CanalEmail && !fiche.CanalSms;
    private bool MailManquant => controleDest && fiche.CanalEmail && string.IsNullOrWhiteSpace(fiche.Email);
    private bool TelManquant => controleDest && fiche.CanalSms && string.IsNullOrWhiteSpace(fiche.Telephone);
    private bool TypesManquants => controleDest && fiche.Types.Count == 0;

    private async Task EnregistrerAsync() => await Executer(async () =>
    {
        controleSmtp = true;
        const string smtpIncomplet = "Renseignez à la fois le serveur SMTP et l’adresse de l’expéditeur, ou aucun des deux.";
        if (ServeurManquant) { await champServeur.FocusAsync(); return smtpIncomplet; }
        if (ExpediteurManquant) { await champExpediteur.FocusAsync(); return smtpIncomplet; }
        var e = await Api.ModifierReglagesNotificationAsync(new ModificationReglagesNotificationDto(r!.SmtpServeur, r.SmtpPort, r.SmtpTls, r.SmtpExpediteur,
            r.SmtpIdentifiant, string.IsNullOrEmpty(nouveauMotDePasse) ? null : nouveauMotDePasse, r.ModemPort, r.HeureRapport, r.SmsSeuilEcart, r.SmsLotBloque, r.SmsSauvegarde,
            r.SignalerSansDestinataire));
        if (e is not null) return e;
        (nouveauMotDePasse, changementMotDePasse) = (null, false);
        controleSmtp = false;
        await ChargerReglagesAsync();
        message = "Réglages enregistrés." + (motDePasseEnregistre ? " Mot de passe chiffré sur ce serveur." : "");
        return null;
    });

    // Mot de passe d'envoi : enregistré → champ grisé et « Changer le mot de passe » ; sinon champ actif et « Enregistrer le mot de passe »
    private bool changementMotDePasse;
    private ElementReference champMotDePasse;

    private async Task ChangerMotDePasse()
    {
        (changementMotDePasse, nouveauMotDePasse) = (true, null);
        StateHasChanged();
        await Task.Yield();
        try { await champMotDePasse.FocusAsync(); } catch (InvalidOperationException) { }
    }

    private void AnnulerChangementMotDePasse() => (changementMotDePasse, nouveauMotDePasse) = (false, null);

    private async Task EnregistrerMotDePasseAsync() => await Executer(async () =>
    {
        if (string.IsNullOrEmpty(nouveauMotDePasse)) return "Saisissez le mot de passe du compte d’envoi.";
        // Les autres réglages sont renvoyés tels qu'ils sont à l'écran : seul le mot de passe change
        var e = await Api.ModifierReglagesNotificationAsync(new ModificationReglagesNotificationDto(r!.SmtpServeur, r.SmtpPort, r.SmtpTls, r.SmtpExpediteur,
            r.SmtpIdentifiant, nouveauMotDePasse, r.ModemPort, r.HeureRapport, r.SmsSeuilEcart, r.SmsLotBloque, r.SmsSauvegarde, r.SignalerSansDestinataire));
        if (e is not null) return e;
        (nouveauMotDePasse, changementMotDePasse) = (null, false);
        await ChargerReglagesAsync();
        message = "Mot de passe enregistré, chiffré sur ce serveur.";
        return null;
    });

    private async Task EnregistrerDestinataireAsync() => await Executer(async () =>
    {
        controleDest = true;
        if (NomDestManquant) { await champNomDest.FocusAsync(); return "Le nom du destinataire est obligatoire."; }
        if (CanalManquant) return "Choisissez au moins un canal : e-mail ou SMS.";
        if (MailManquant) { await champMail.FocusAsync(); return "Indiquez l’adresse e-mail du destinataire."; }
        if (TelManquant) { await champTel.FocusAsync(); return "Indiquez le numéro de mobile du destinataire."; }
        if (TypesManquants) return "Choisissez au moins un type de message.";
        var (_, e) = await Api.EnregistrerDestinataireAsync(fiche.Id,
            new SaisieDestinataireDto(fiche.Nom, fiche.Email, fiche.Telephone, fiche.CanalEmail, fiche.CanalSms, fiche.Types.ToList(), fiche.Actif));
        if (e is not null) return e;
        message = $"{fiche.Nom} enregistré. Envoyez-lui un message de test pour vérifier l’adresse.";
        fiche = new();
        controleDest = false;
        (destinataires, _) = await Api.DestinatairesAsync();
        Nav.NavigateTo("admin/notifications?rubrique=destinataires");   // retour à la liste, où se fait le test d'envoi
        return null;
    });

    private async Task TestAsync(DestinataireDto d) => await Executer(async () =>
    {
        var (n, e) = await Api.EnvoyerTestAsync(d.Id);
        if (e is not null) return e;
        message = $"{n!.Nombre} message(s) de test mis en file pour {d.Nom}.";
        await ChargerFileAsync();
        return null;
    });

    // Vérification par code : destinataire à qui un code vient d'être envoyé, et code saisi
    private long? codeEnvoyeA;
    private string? codeSaisi;

    private async Task EnvoyerCodeAsync(DestinataireDto d) => await Executer(async () =>
    {
        var (n, e) = await Api.EnvoyerCodeVerificationAsync(d.Id);
        if (e is not null) return e;
        (codeEnvoyeA, codeSaisi) = (d.Id, null);
        message = $"Code de vérification envoyé à {d.Nom} ({n!.Nombre} message(s), valable 15 minutes). Saisissez le code qu’il a reçu.";
        await ChargerFileAsync();
        return null;
    });

    private async Task VerifierCodeAsync(DestinataireDto d) => await Executer(async () =>
    {
        var e = await Api.VerifierCodeDestinataireAsync(d.Id, codeSaisi ?? "");
        if (e is not null) return e;
        (codeEnvoyeA, codeSaisi) = (null, null);
        message = $"{d.Nom} est vérifié : il recevra les alertes de la pharmacie.";
        (destinataires, _) = await Api.DestinatairesAsync();
        return null;
    });

    private async Task ValiderAsync(DestinataireDto d, bool valide) => await Executer(async () =>
    {
        var e = await Api.ValiderDestinataireAsync(d.Id, valide);
        if (e is not null) return e;
        (destinataires, _) = await Api.DestinatairesAsync();
        return null;
    });

    private async Task RapportMaintenantAsync() => await Executer(async () =>
    {
        var (n, e) = await Api.EnvoyerRapportMaintenantAsync();
        if (e is not null) return e;
        message = n!.Nombre == 0 ? "Aucun destinataire vérifié n’est abonné au rapport." : $"Rapport du jour mis en file ({n.Nombre} e-mail(s)).";
        await ChargerFileAsync();
        return null;
    });

    private void Editer(DestinataireDto d)
    {
        controleDest = false;
        fiche = new Fiche
        {
            Id = d.Id, Nom = d.Nom, Email = d.Email, Telephone = d.Telephone, CanalEmail = d.CanalEmail, CanalSms = d.CanalSms, Actif = d.Actif, Types = [.. d.Types]
        };
        Nav.NavigateTo("admin/notifications?rubrique=fiche");   // fiche dans sa sous-rubrique : la liste reste fixe
    }

    private void AnnulerFiche()
    {
        (fiche, controleDest) = (new(), false);
        Nav.NavigateTo("admin/notifications?rubrique=destinataires");
    }

    private void Basculer(string type, ChangeEventArgs e)
    {
        if (e.Value is true) fiche.Types.Add(type); else fiche.Types.Remove(type);
    }

    private static string LibelleType(string t) => t switch
    {
        "rapport_quotidien" => "Rapport du soir", "ecart_caisse" => "Écart de caisse", "lot_bloque" => "Lot bloqué", "sauvegarde" => "Sauvegarde", "ecart_inventaire" => "Écart d’inventaire", "lot_delaisse" => "Ancien lot délaissé", "surveillance" => "Contrôle interne", "synchronisation" => "Synchronisation", _ => t
    };

    private static string LibelleStatut(string s) => s switch { "envoye" => "Envoyé", "echec" => "Abandonné", _ => "En attente" };

    private async Task Executer(Func<Task<string?>> action)
    {
        (enCours, erreur, message) = (true, null, null);
        try { erreur = await action(); }
        finally { enCours = false; }
    }
}
