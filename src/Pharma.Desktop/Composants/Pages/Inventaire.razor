@page "/inventaire"
@inject ApiClient Api
@inject SessionPoste Session
@inject NavigationManager Nav
@inject HistoriqueNavigation Historique

@* Écran fixe : rubriques dans le menu vertical (rubrique dans l'adresse : inventaire?rubrique=…) ; les tableaux défilent dans leur cadre *@
<div class="page avec-menu">
    <NavDomaine Libelle="Rubriques de l’inventaire">
        @foreach (var r in Rubriques.Where(r => r.Permis))
        {
            var n = r.Id == "ecarts" ? tableau?.EcartsAValider.Count ?? 0 : 0;
            <a href="@(r.Id == "comptage" ? "inventaire" : $"inventaire?rubrique={r.Id}")" class="@(r.Id == rubrique ? "active" : null)" aria-current="@(r.Id == rubrique ? "page" : null)">@r.Libelle@if (n > 0) { <span class="compteur">@n</span> }</a>
        }
    </NavDomaine>

    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>Inventaire · @Rubriques.First(r => r.Id == rubrique).Libelle<AideEcran Cle="inventaire" /></h1>
            <p class="sous-titre">Inventaire tournant (un rayon par jour) ou complet (tous les rayons), compté à l’aveugle. Les petits écarts sont corrigés tout de suite, les gros attendent le titulaire.</p>
        </div>
    </div>

    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }

    @if (tableau is null)
    {
        <Chargement />
    }
    else
    {
        @if (rubrique == "ecarts" && tableau.EcartsAValider.Count == 0)
        {
            <p class="vide">Aucun écart à valider.</p>
            <ActionSuivante Libelle="Aller au comptage du rayon proposé" Lien="inventaire" />
        }
        @if (rubrique == "ecarts" && tableau.EcartsAValider.Count > 0)
        {
            <section class="panneau" aria-labelledby="t-ecarts">
                <h2 id="t-ecarts">Écarts à valider par le titulaire (@tableau.EcartsAValider.Count)</h2>
                <div class="filtres-liste" role="search" aria-label="Filtrer les écarts">
                    <div class="champ" style="flex: 1 1 220px"><label for="fe-texte">Produit ou lot</label>
                        <input id="fe-texte" type="search" autocomplete="off" @bind="fEcartTexte" @bind:event="oninput" @bind:after="() => pageEcarts = 1" /></div>
                    <div class="champ" style="flex: 0 0 200px"><label for="fe-rayon">Rayon</label>
                        <select id="fe-rayon" @bind="fEcartRayon" @bind:after="() => pageEcarts = 1">
                            <option value="">Tous</option>
                            @foreach (var ry in tableau.EcartsAValider.Select(x => x.Rayon).Distinct().Order()) { <option value="@ry">@ry</option> }
                        </select></div>
                    @if (fEcartTexte.Trim() != "" || fEcartRayon != "") { <button type="button" class="btn" @onclick="() => (fEcartTexte, fEcartRayon, pageEcarts) = (string.Empty, string.Empty, 1)">Tout afficher</button> }
                </div>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 760px">
                        <thead><tr><th scope="col">Produit</th><th scope="col">Rayon</th><th scope="col">Théorique</th><th scope="col">Compté</th><th scope="col">Écart</th><th scope="col">Compté par</th><th scope="col"></th></tr></thead>
                        <tbody>
                            @foreach (var e in EcartsFiltres.Skip((pageEcarts - 1) * tailleEcarts).Take(tailleEcarts))
                            {
                                <tr>
                                    <td><span class="nom"><LienProduit Texte="@e.Produit" /></span><br /><span class="detail">lot <LienProduit Texte="@e.NumeroLot" Lot="true" /></span></td>
                                    <td>@e.Rayon</td>
                                    <td>@e.Theorique</td>
                                    <td>@e.Compte</td>
                                    <td class="@(e.Ecart < 0 ? "texte-urgent" : null)"><strong>@Signe(e.Ecart)</strong><br /><span class="detail">@Libelles.Dinars(e.ValeurEcart, 2)</span></td>
                                    <td>@e.ComptePar<br /><span class="detail">@Libelles.DateHeureLocale(e.CompteLe)</span></td>
                                    <td>
                                        @if (EstTitulaire)
                                        {
                                            <div style="display: flex; gap: 6px; flex-wrap: wrap">
                                                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => DeciderAsync(e, true)">Valider</button>
                                                <button type="button" class="btn" disabled="@enCours" @onclick="() => DeciderAsync(e, false)" title="Le stock ne change pas : faites recompter">Refuser</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="detail">En attente du titulaire</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (EcartsFiltres.Count == 0) { <tr><td colspan="7" class="vide">Aucun écart pour ces filtres.</td></tr> }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="EcartsFiltres.Count" Numero="pageEcarts" Taille="tailleEcarts" Libelle="Pages des écarts" OnChange="p => (pageEcarts, tailleEcarts) = (p.Numero, p.Taille)" />
            </section>
        }

        @if (rubrique == "complet")
        {
            <PanneauInventaireComplet OnCompter="CompterRayonAsync" />
        }
        @if (rubrique == "sensibles")
        {
            @if (tableau.Sensibles is not { Produits: > 0 })
            {
                <p class="vide">Aucun produit sensible : le titulaire les choisit dans Contrôle interne.</p>
                <ActionSuivante Libelle="Choisir les produits sensibles" Lien="surveillance?onglet=sensibles" Droits='["role.titulaire"]' />
            }
            @if (tableau.Sensibles is { Produits: > 0 } sens)
            {
                @* Produits sensibles (choisis par le titulaire dans Surveillance) : comptés à part, régulièrement *@
                <section class="panneau" aria-labelledby="t-sensibles">
                    <h2 id="t-sensibles">Produits sensibles</h2>
                    <p style="margin: 0">@sens.Produits produit(s) sensible(s) · dernier comptage : @(sens.Dernier is { } d ? Libelles.DateHeureLocale(d) : "jamais")</p>
                    <div>
                        @if (Session.A("stock.ajuster"))
                        {
                            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="CompterSensiblesAsync">
                                @(sens.EnCoursId is not null ? "Reprendre le comptage des produits sensibles" : "Compter les produits sensibles")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn" disabled title="Droit « stock.ajuster » nécessaire">Compter les produits sensibles</button>
                        }
                    </div>
                </section>
            }
        }
        @if (rubrique != "comptage") { }
        else if (inventaire is null)
        {
            <section class="panneau" aria-labelledby="t-jour">
                <h2 id="t-jour">Rayon à compter</h2>
                @if (tableau.Rayons.Count == 0)
                {
                    <p class="vide">Aucun emplacement : créez les rayons dans Administration, Emplacements, puis rangez les produits.</p>
                    <ActionSuivante Libelle="Créer les emplacements" Lien="admin/emplacements" Droits='["admin.parametres"]' />
                }
                else
                {
                    <div class="achats-ligne">
                        <div class="champ" style="flex: 0 0 280px">
                            <label for="i-rayon">Rayon @(rayonChoisi == tableau.RayonPropose ? "(proposé aujourd’hui)" : "")</label>
                            <select id="i-rayon" class="selection" @bind="rayonChoisi">
                                @foreach (var r in tableau.Rayons)
                                {
                                    <option value="@r.Rayon">Rayon @r.Rayon · @r.NombreLots lot(s)@(r.EnCoursId is not null ? " · en cours" : "")</option>
                                }
                            </select>
                        </div>
                        @if (Session.A("stock.ajuster"))
                        {
                            <button type="button" class="btn btn-principal" disabled="@(enCours || Choisi?.NombreLots == 0)" @onclick="CommencerAsync">
                                @(Choisi?.EnCoursId is not null ? "Reprendre le comptage" : "Commencer le comptage")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn" disabled title="Droit « stock.ajuster » nécessaire">Commencer le comptage</button>
                        }
                    </div>
                    @if (Choisi is { } c)
                    {
                        <p class="detail" style="margin: 0">
                            Dernier inventaire : @(c.DernierInventaire is { } d ? Libelles.DateLocale(d) : "jamais") ·
                            @c.NombreLots lot(s) en stock@(c.LotsDateAVerifier > 0 ? $", dont {c.LotsDateAVerifier} à date à vérifier (reprise)" : "").
                            Comptez toutes les boîtes de chaque lot, réserve comprise.
                        </p>
                    }
                }
            </section>
        }
        else if (inventaire.Statut == "en_cours")
        {
            var comptes = inventaire.Lignes.Count(l => l.Compte is not null);
            <section class="panneau" aria-labelledby="t-comptage">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap">
                    <h2 id="t-comptage">Comptage du rayon @inventaire.Rayon</h2>
                    <span class="pastille @(comptes == inventaire.Lignes.Count ? "ok" : "attention")">@comptes / @inventaire.Lignes.Count lot(s) compté(s)</span>
                </div>
                <p class="detail" style="margin: 0">Comptage à l’aveugle : le stock du logiciel n’est montré qu’à la fin. Scannez chaque boîte (étiquette interne ou Data Matrix) ou saisissez le nombre ; 0 si le lot est introuvable.</p>
                <div class="champ" style="max-width: 520px">
                    <label for="i-scan">Scanner une boîte</label>
                    <input id="i-scan" type="text" autocomplete="off" placeholder="Une boîte de plus sur la ligne de son lot" @bind="scan" @onkeydown="ToucheScanAsync" />
                </div>
                @if (infoScan is not null) { <p class="detail" role="status" style="margin: 0">@infoScan</p> }
                <div class="filtres-liste" role="search" aria-label="Filtrer les lots à compter">
                    <div class="champ" style="flex: 1 1 220px"><label for="fl-texte">Produit, lot ou emplacement</label>
                        <input id="fl-texte" type="search" autocomplete="off" @bind="fLigneTexte" @bind:event="oninput" @bind:after="() => pageLignes = 1" /></div>
                    <div class="champ" style="flex: 0 0 190px"><label for="fl-etat">Lots</label>
                        <select id="fl-etat" @bind="fLigneEtat" @bind:after="() => pageLignes = 1">
                            <option value="">Tous</option>
                            <option value="a_compter">À compter</option>
                            <option value="comptes">Comptés</option>
                            <option value="date">Date à vérifier</option>
                        </select></div>
                    @if (fLigneTexte.Trim() != "" || fLigneEtat != "") { <button type="button" class="btn" @onclick="() => (fLigneTexte, fLigneEtat, pageLignes) = (string.Empty, string.Empty, 1)">Tout afficher</button> }
                </div>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 760px">
                        <thead><tr><th scope="col">Produit</th><th scope="col">Où chercher</th><th scope="col">Péremption</th><th scope="col">Boîtes comptées</th></tr></thead>
                        <tbody>
                            @foreach (var l in LignesFiltrees.Skip((pageLignes - 1) * tailleLignes).Take(tailleLignes))
                            {
                                <tr class="@(l.Compte is not null ? "ligne-comptee" : null)">
                                    <td><span class="nom">@l.Produit</span><br /><span class="detail">lot @l.NumeroLot</span></td>
                                    <td>@if (l.Emplacement is not null) { <span class="code-emplacement">@l.Emplacement</span> }</td>
                                    <td>
                                        @Libelles.Date(l.DatePeremption)
                                        @if (l.DateAVerifier)
                                        {
                                            <br /><span class="pastille attention">Date à vérifier</span>
                                            <br /><input type="date" aria-label="Date de péremption lue sur la boîte de @l.Produit" value="@l.DateVerifiee?.ToString("yyyy-MM-dd")"
                                                         @onchange="e => DateLue(l, e)" />
                                        }
                                    </td>
                                    <td>
                                        <input type="number" min="0" style="width: 110px" aria-label="Boîtes comptées de @l.Produit lot @l.NumeroLot"
                                               value="@l.Compte" @onchange="e => CompterAsync(l, e)" />
                                    </td>
                                </tr>
                            }
                            @if (LignesFiltrees.Count == 0) { <tr><td colspan="4" class="vide">Aucun lot pour ces filtres.</td></tr> }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="LignesFiltrees.Count" Numero="pageLignes" Taille="tailleLignes" Libelle="Pages des lots à compter" OnChange="p => (pageLignes, tailleLignes) = (p.Numero, p.Taille)" />
                <div style="display: flex; gap: 8px; flex-wrap: wrap">
                    <button type="button" class="btn btn-principal" disabled="@(enCours || comptes < inventaire.Lignes.Count)" @onclick="TerminerAsync"
                            title="@(comptes < inventaire.Lignes.Count ? "Comptez d’abord tous les lots" : null)">Terminer l’inventaire</button>
                    <button type="button" class="btn" disabled="@enCours" @onclick="AnnulerAsync">Abandonner</button>
                    <button type="button" class="btn" @onclick="() => inventaire = null">Plus tard</button>
                </div>
            </section>
        }
        else
        {
            <section class="panneau" aria-labelledby="t-resultat">
                <h2 id="t-resultat">Résultat du rayon @inventaire.Rayon</h2>
                @if (bilan is not null)
                {
                    <div class="tuiles" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr))">
                        @* Tuiles navigables (2026-11-21) : les trois premières filtrent le tableau du résultat ci-dessous (filtre appliqué :
                           bordure verte), « À valider » ouvre les écarts à valider *@
                        <button type="button" class="tuile tuile-lien" aria-pressed="@(fResultatStatut == "" ? "true" : "false")" title="Affiche tous les lots comptés dans le tableau ci-dessous"
                                @onclick='() => FiltrerResultat("")'><span class="tuile-libelle">Lots comptés</span><span class="tuile-valeur petite">@bilan.Lignes</span></button>
                        <button type="button" class="tuile tuile-lien" aria-pressed="@(fResultatStatut == "conforme" ? "true" : "false")" title="Affiche les lots conformes dans le tableau ci-dessous"
                                @onclick='() => FiltrerResultat("conforme")'><span class="tuile-libelle">Conformes</span><span class="tuile-valeur petite">@bilan.Conformes</span></button>
                        <button type="button" class="tuile tuile-lien" aria-pressed="@(fResultatStatut == "ajuste" ? "true" : "false")" title="Affiche les lots corrigés tout de suite dans le tableau ci-dessous"
                                @onclick='() => FiltrerResultat("ajuste")'><span class="tuile-libelle">Corrigés tout de suite</span><span class="tuile-valeur petite">@bilan.Ajustes</span></button>
                        <TuileLien Lien="inventaire?rubrique=ecarts" Infobulle="Ouvre les écarts à valider"><span class="tuile-libelle">À valider (titulaire)</span><span class="tuile-valeur petite @(bilan.AValider > 0 ? "attention" : null)">@bilan.AValider</span></TuileLien>
                    </div>
                }
                <div class="filtres-liste" role="search" aria-label="Filtrer le résultat">
                    <div class="champ" style="flex: 1 1 220px"><label for="fr-texte">Produit ou lot</label>
                        <input id="fr-texte" type="search" autocomplete="off" @bind="fLigneTexte" @bind:event="oninput" @bind:after="() => pageLignes = 1" /></div>
                    <label class="case" style="align-self: end"><input type="checkbox" @bind="fAvecEcart" @bind:after="() => pageLignes = 1" /><span>Avec un écart seulement</span></label>
                    @if (fLigneTexte.Trim() != "" || fAvecEcart || fResultatStatut != "") { <button type="button" class="btn" @onclick='() => (fLigneTexte, fAvecEcart, fResultatStatut, pageLignes) = (string.Empty, false, "", 1)'>Tout afficher</button> }
                    @* Écran fixe (2026-11-15) : le bouton est sur la ligne des filtres, plus sous le tableau *@
                    <button type="button" class="btn" style="margin-left: auto; align-self: end" @onclick="FermerResultatAsync">Rayon suivant</button>
                </div>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 760px">
                        <thead><tr><th scope="col">Produit</th><th scope="col">Théorique</th><th scope="col">Compté</th><th scope="col">Écart</th><th scope="col">Suite</th></tr></thead>
                        <tbody>
                            @foreach (var l in ResultatFiltre.Skip((pageLignes - 1) * tailleLignes).Take(tailleLignes))
                            {
                                <tr>
                                    <td><span class="nom"><LienProduit Texte="@l.Produit" /></span><br /><span class="detail">lot <LienProduit Texte="@l.NumeroLot" Lot="true" />@(l.DateVerifiee is { } dv ? $" · péremption vérifiée {Libelles.Date(dv)}" : "")</span></td>
                                    <td>@l.Theorique</td>
                                    <td>@l.Compte</td>
                                    <td>@(l.Ecart is { } e && e != 0 ? $"{Signe(e)} ({Libelles.Dinars(l.ValeurEcart ?? 0, 2)})" : "—")</td>
                                    <td><span class="pastille @ClasseStatut(l.Statut)">@LibelleStatut(l.Statut)</span></td>
                                </tr>
                            }
                            @if (ResultatFiltre.Count == 0) { <tr><td colspan="5" class="vide">Aucun lot pour ces filtres.</td></tr> }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="ResultatFiltre.Count" Numero="pageLignes" Taille="tailleLignes" Libelle="Pages du résultat" OnChange="p => (pageLignes, tailleLignes) = (p.Numero, p.Taille)" />
                @if (aEtiqueter.Count > 0)
                {
                    <h3 style="margin: 8px 0 0">Boîtes sans étiquette dans ce rayon (@aEtiqueter.Sum(l => l.BoitesSansIdentite))</h3>
                    <p class="detail" style="margin: 0">Profitez du passage dans le rayon : imprimez et collez une étiquette sur chaque boîte, elle sera reliée à son lot et à son grossiste.</p>
                    <EtiquetagerLots Lots="@aEtiqueter" />
                }
            </section>
        }

        @if (rubrique == "seuils" && EstTitulaire)
        {
            @* Mutualisation (lot M7) : seuils fixés ou proposés par le serveur central *@
            <ReglageCentral Table="parametre_inventaire" OnAdopte="ChargerAsync" />
            <fieldset class="panneau" aria-labelledby="t-seuils" disabled="@Fixe">
                <h2 id="t-seuils">Seuils de correction automatique (titulaire)</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 200px"><label for="i-sb">Seuil d’écart (boîtes)</label><input id="i-sb" type="number" min="0" @bind="seuilBoites" /></div>
                    <div class="champ" style="flex: 0 0 240px"><label for="i-sm">Seuil d’écart (DA, prix d’achat)</label><input id="i-sm" type="number" min="0" step="0.01" @bind="seuilMontant" /></div>
                    <button type="button" class="btn" disabled="@(enCours || Fixe)" @onclick="EnregistrerSeuilsAsync">Enregistrer</button>
                </div>
                <p class="detail" style="margin: 0">Un écart est corrigé tout de suite s’il reste strictement sous les deux seuils ; un écart égal à un seuil, ou au-delà, attend votre validation et vous êtes prévenu (Notifications, « Écart d’inventaire »).</p>
            </fieldset>
        }

        @if (rubrique == "historique")
        {
        @* Historique complet, filtré et paginé par le serveur (règle des listes) *@
        <div class="filtres-liste" role="search" aria-label="Filtrer l’historique des inventaires">
            <div class="champ" style="flex: 0 0 200px"><label for="fh-rayon">Rayon</label>
                <select id="fh-rayon" @bind="fHistRayon" @bind:after="PremierePageHistoriqueAsync">
                    <option value="">Tous</option>
                    @foreach (var ry in tableau.Rayons.Select(x => x.Rayon).Order()) { <option value="@ry">@ry</option> }
                </select></div>
            <div class="champ" style="flex: 0 0 170px"><label for="fh-statut">État</label>
                <select id="fh-statut" @bind="fHistStatut" @bind:after="PremierePageHistoriqueAsync">
                    <option value="">Tous</option>
                    <option value="en_cours">En cours</option>
                    <option value="termine">Terminé</option>
                    <option value="annule">Abandonné</option>
                </select></div>
            <div class="champ" style="flex: 0 0 160px"><label for="fh-du">Du</label><input id="fh-du" type="date" @bind="fHistDu" @bind:after="PremierePageHistoriqueAsync" /></div>
            <div class="champ" style="flex: 0 0 160px"><label for="fh-au">Au</label><input id="fh-au" type="date" @bind="fHistAu" @bind:after="PremierePageHistoriqueAsync" /></div>
            @if (FiltreHistoriqueActif) { <button type="button" class="btn" @onclick="ToutHistoriqueAsync">Tout afficher</button> }
        </div>
        <section class="tableau-cadre" aria-label="Derniers inventaires">
            <table class="tableau" style="min-width: 0">
                <thead><tr><th scope="col">Date</th><th scope="col">Rayon</th><th scope="col">Par</th><th scope="col">Lots</th><th scope="col">Écarts</th><th scope="col">Valeur des écarts</th><th scope="col">État</th></tr></thead>
                <tbody>
                    @foreach (var h in historique)
                    {
                        <tr>
                            <td>@Libelles.DateHeureLocale(h.CommenceLe)</td>
                            <td>@h.Rayon</td>
                            <td>@h.CommencePar</td>
                            <td>@h.Lignes</td>
                            <td>@h.Ecarts@(h.AValider > 0 ? $" (dont {h.AValider} à valider)" : "")</td>
                            <td>@Libelles.Dinars(h.ValeurEcarts, 2)</td>
                            <td><span class="pastille @(h.Statut == "termine" ? "ok" : h.Statut == "en_cours" ? "attention" : "info")">@(h.Statut switch { "termine" => "Terminé", "en_cours" => "En cours", _ => "Abandonné" })</span></td>
                        </tr>
                    }
                    @if (historique.Count == 0)
                    {
                        <tr><td colspan="7" class="vide">@(FiltreHistoriqueActif ? "Aucun inventaire pour ces filtres." : "Aucun inventaire pour l’instant.")
                            @if (!FiltreHistoriqueActif) { <ActionSuivante Libelle="Commencer un comptage" Lien="inventaire" /> }</td></tr>
                    }
                </tbody>
            </table>
        </section>
        <Pagination Total="totalHistorique" Numero="pageHistorique" Taille="tailleHistorique" Libelle="Pages de l’historique des inventaires" OnChange="p => ChargerHistoriqueAsync(p.Numero, p.Taille)" />
        }
    }
    </div>
</div>

@code {
    private TableauInventaireDto? tableau;
    private InventaireDto? inventaire;
    private BilanInventaireDto? bilan;
    private List<LotAEtiqueterDto> aEtiqueter = [];
    private string? rayonChoisi, scan, infoScan, erreur, message;
    /// <summary>Seuils fixés par le serveur central (table parametre_inventaire imposée).</summary>
    private bool Fixe => Api.ReglageCentral("parametre_inventaire").Impose;
    private int seuilBoites;
    private decimal seuilMontant;
    private bool enCours;
    private readonly Dictionary<long, DateOnly?> datesLues = [];

    private bool EstTitulaire => Session.A("role.titulaire");

    private sealed record RubriqueInventaire(string Id, string Libelle, bool Permis = true);
    private RubriqueInventaire[] Rubriques =>
    [
        new("comptage", "Comptage du rayon"), new("complet", "Inventaire complet"), new("sensibles", "Produits sensibles"),
        new("ecarts", "Écarts à valider"), new("historique", "Derniers inventaires"), new("seuils", "Seuils de correction", EstTitulaire)
    ];
    // Rubrique dans l'adresse ; un comptage commencé ailleurs (complet, sensibles, produit) s'ouvre dans « Comptage du rayon »
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => Rubriques.FirstOrDefault(r => r.Id == Rubrique && r.Permis)?.Id ?? "comptage";
    private RayonInventaireDto? Choisi => tableau?.Rayons.FirstOrDefault(r => r.Rayon == rayonChoisi);

    /// <summary>Depuis l'alerte « ancien lot délaissé » : inventaire de ce produit (tous ses lots), lancé par le titulaire.</summary>
    [SupplyParameterFromQuery(Name = "produit")] public long? Produit { get; set; }

    // ---- Listes paginées et filtrées (règle des listes) ; « ← Retour » retrouve filtres et pages ----
    // Écarts à valider, feuille de comptage et résultat : à l'écran (listes complètes) ; historique : par le serveur
    private string fEcartTexte = "", fEcartRayon = "", fLigneTexte = "", fLigneEtat = "", fHistRayon = "", fHistStatut = "";
    private bool fAvecEcart;
    // Tuiles du résultat (2026-11-21) : « conforme », « ajuste » ou vide (tous les lots comptés)
    private string fResultatStatut = "";
    private void FiltrerResultat(string statut) => (fResultatStatut, pageLignes) = (statut, 1);
    private DateOnly? fHistDu, fHistAu;
    private int pageEcarts = 1, tailleEcarts = Pagination.TailleParDefaut, pageLignes = 1, tailleLignes = Pagination.TailleParDefaut,
        pageHistorique = 1, tailleHistorique = Pagination.TailleParDefaut, totalHistorique;
    private List<InventaireResumeDto> historique = [];

    private List<EcartAValiderDto> EcartsFiltres => (tableau?.EcartsAValider ?? []).Where(e => RechercheTexte.Contient(fEcartTexte, e.Produit, e.NumeroLot)
        && (fEcartRayon == "" || e.Rayon == fEcartRayon)).ToList();
    private List<LigneInventaireDto> LignesFiltrees => (inventaire?.Lignes ?? []).Where(l => RechercheTexte.Contient(fLigneTexte, l.Produit, l.NumeroLot, l.Emplacement)
        && fLigneEtat switch { "a_compter" => l.Compte is null, "comptes" => l.Compte is not null, "date" => l.DateAVerifier, _ => true }).ToList();
    private List<LigneInventaireDto> ResultatFiltre => (inventaire?.Lignes ?? []).Where(l => RechercheTexte.Contient(fLigneTexte, l.Produit, l.NumeroLot)
        && (!fAvecEcart || l.Ecart is { } e && e != 0) && (fResultatStatut == "" || l.Statut == fResultatStatut)).ToList();

    private bool FiltreHistoriqueActif => fHistRayon != "" || fHistStatut != "" || fHistDu is not null || fHistAu is not null;
    private Task PremierePageHistoriqueAsync() => ChargerHistoriqueAsync(1, tailleHistorique);
    private Task ToutHistoriqueAsync() { (fHistRayon, fHistStatut, fHistDu, fHistAu) = ("", "", null, null); return PremierePageHistoriqueAsync(); }

    private async Task ChargerHistoriqueAsync(int numero, int taille)
    {
        var (p, e) = await Api.HistoriqueInventairesAsync(fHistRayon, fHistStatut, fHistDu, fHistAu, numero, taille);
        if (p is null) { erreur ??= e; return; }
        if (p.Lignes.Count == 0 && numero > 1) { await ChargerHistoriqueAsync(1, taille); return; }
        (historique, totalHistorique, pageHistorique, tailleHistorique, historiqueAJour) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille, true);
    }

    // L'historique n'est lu que lorsque sa rubrique est affichée ; après un changement (écart décidé, inventaire terminé…) il est relu à la prochaine visite
    private bool historiqueAJour;
    private async Task ChargerHistoriqueSiAfficheAsync()
    {
        if (rubrique == "historique" && !historiqueAJour) await ChargerHistoriqueAsync(pageHistorique, tailleHistorique);
    }

    protected override Task OnParametersSetAsync() => tableau is null ? Task.CompletedTask : ChargerHistoriqueSiAfficheAsync();

    protected override async Task OnInitializedAsync()
    {
        Historique.Suivre("inventaire", e =>
        {
            e.Mettre("ecart_texte", fEcartTexte); e.Mettre("ecart_rayon", fEcartRayon); e.Mettre("page_ecarts", pageEcarts); e.Mettre("taille_ecarts", tailleEcarts);
            e.Mettre("h_rayon", fHistRayon); e.Mettre("h_statut", fHistStatut); e.Mettre("h_du", fHistDu); e.Mettre("h_au", fHistAu);
            e.Mettre("page_h", pageHistorique); e.Mettre("taille_h", tailleHistorique);
        });
        if (Historique.Restaurer("inventaire") is { } h)
        {
            (fEcartTexte, fEcartRayon, pageEcarts, tailleEcarts) = (h.Texte("ecart_texte") ?? "", h.Texte("ecart_rayon") ?? "", h.Entier("page_ecarts") ?? 1, h.Entier("taille_ecarts") ?? tailleEcarts);
            (fHistRayon, fHistStatut, fHistDu, fHistAu) = (h.Texte("h_rayon") ?? "", h.Texte("h_statut") ?? "", h.Date("h_du"), h.Date("h_au"));
            (pageHistorique, tailleHistorique) = (h.Entier("page_h") ?? 1, h.Entier("taille_h") ?? tailleHistorique);
        }
        await ChargerAsync();
        if (Produit is > 0 && EstTitulaire)
            await Executer(async () =>
            {
                var (id, e) = await Api.CommencerInventaireProduitAsync(Produit.Value);
                return e ?? await OuvrirAsync(id!.Id);
            });
    }

    private async Task ChargerAsync()
    {
        string? e;
        (tableau, e) = await Api.TableauInventaireAsync();
        if (e is not null) { erreur = e; return; }
        rayonChoisi ??= tableau!.RayonPropose ?? tableau.Rayons.FirstOrDefault()?.Rayon;
        historiqueAJour = false;
        await ChargerHistoriqueSiAfficheAsync();
        (seuilBoites, seuilMontant) = (tableau!.Parametres.SeuilBoites, tableau.Parametres.SeuilMontant);
    }

    private async Task CompterSensiblesAsync() => await Executer(async () =>
    {
        var (id, e) = await Api.CommencerInventaireSensiblesAsync();
        return e ?? await OuvrirAsync(id!.Id);
    });

    private async Task CompterRayonAsync(string rayon)
    {
        rayonChoisi = rayon;
        await CommencerAsync();
    }

    private async Task CommencerAsync() => await Executer(async () =>
    {
        var (id, e) = await Api.CommencerInventaireAsync(rayonChoisi!);
        if (e is null) datesLues.Clear();
        if (e is not null) return e;
        return await OuvrirAsync(id!.Id);
    });

    private async Task<string?> OuvrirAsync(long id)
    {
        var (d, e) = await Api.InventaireAsync(id);
        if (e is not null) return e;
        // Filtres et page remis à zéro seulement pour une autre feuille ou le passage au résultat ;
        // une relecture après un comptage ou un scan garde filtres et page
        if (inventaire?.Id != d!.Id || inventaire.Statut != d.Statut)
            (fLigneTexte, fLigneEtat, fAvecEcart, fResultatStatut, pageLignes) = ("", "", false, "", 1);
        inventaire = d;
        if (rubrique != "comptage") Nav.NavigateTo("inventaire");
        if (d!.Statut == "termine")
        {
            var lots = d.Lignes.Select(l => l.LotId).ToHashSet();
            var (liste, _) = await Api.LotsAEtiqueterAsync();
            aEtiqueter = liste.Where(l => lots.Contains(l.LotId) && l.BoitesSansIdentite > 0).ToList();
        }
        return null;
    }

    private void DateLue(LigneInventaireDto l, ChangeEventArgs e) =>
        datesLues[l.Id] = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null;

    private async Task CompterAsync(LigneInventaireDto l, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var n)) return;
        await Executer(async () =>
        {
            var err = await Api.CompterLotAsync(inventaire!.Id, l.Id, n, datesLues.GetValueOrDefault(l.Id) ?? l.DateVerifiee);
            if (err is not null) return err;
            return await OuvrirAsync(inventaire.Id);
        });
    }

    private async Task ToucheScanAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(scan)) return;
        var code = scan;
        scan = null;
        var (r, err) = await Api.ScannerInventaireAsync(inventaire!.Id, code);
        infoScan = err ?? $"{r!.Produit} · lot {r.NumeroLot} : {r.Compte} boîte(s) comptée(s).";
        if (err is null) await OuvrirAsync(inventaire.Id);
    }

    private async Task TerminerAsync() => await Executer(async () =>
    {
        // Dates lues sur les boîtes mais pas encore envoyées (saisies sans changer la quantité)
        foreach (var (ligneId, date) in datesLues.Where(d => d.Value is not null))
        {
            // Ligne absente de ce comptage (saisie restée d'un comptage précédent) : ignorée
            if (inventaire!.Lignes.FirstOrDefault(x => x.Id == ligneId) is not { } l) continue;
            if (l.DateVerifiee != date && l.Compte is { } c)
                if (await Api.CompterLotAsync(inventaire.Id, ligneId, c, date) is { } err) return err;
        }
        var (b, e) = await Api.TerminerInventaireAsync(inventaire!.Id);
        if (e is not null) return e;
        bilan = b;
        message = b!.AValider > 0
            ? $"Inventaire terminé : {b.Ajustes} écart(s) corrigé(s), {b.AValider} en attente du titulaire (prévenu)."
            : $"Inventaire terminé : {b.Ajustes} écart(s) corrigé(s), aucun en attente.";
        await ChargerAsync();
        return await OuvrirAsync(inventaire.Id);
    });

    private async Task AnnulerAsync() => await Executer(async () =>
    {
        var e = await Api.AnnulerInventaireAsync(inventaire!.Id);
        if (e is not null) return e;
        (inventaire, message) = (null, "Comptage abandonné : rien n’a été modifié dans le stock.");
        datesLues.Clear();   // dates lues sur les boîtes du comptage abandonné : elles ne valent pas pour le suivant
        await ChargerAsync();
        return null;
    });

    private async Task FermerResultatAsync()
    {
        (inventaire, bilan, rayonChoisi, message, aEtiqueter) = (null, null, null, null, []);
        datesLues.Clear();
        await ChargerAsync();
    }

    private async Task DeciderAsync(EcartAValiderDto e, bool valider) => await Executer(async () =>
    {
        var err = await Api.DeciderEcartAsync(e.LigneId, valider);
        if (err is not null) return err;
        message = valider ? $"{e.Produit} : écart {Signe(e.Ecart)} validé, stock corrigé." : $"{e.Produit} : écart refusé, stock inchangé : faites recompter.";
        await ChargerAsync();
        return null;
    });

    private async Task EnregistrerSeuilsAsync() => await Executer(async () =>
    {
        var e = await Api.ParametresInventaireAsync(new ParametresInventaireDto(seuilBoites, seuilMontant));
        if (e is not null) return e;
        message = "Seuils enregistrés.";
        return null;
    });

    private static string Signe(int n) => n > 0 ? $"+{n}" : n.ToString();

    private static string LibelleStatut(string s) => s switch
    {
        "conforme" => "Conforme", "ajuste" => "Corrigé", "a_valider" => "À valider", "valide" => "Validé", "refuse" => "Refusé, à recompter", _ => s
    };

    private static string ClasseStatut(string s) => s switch
    {
        "conforme" or "ajuste" or "valide" => "ok", "a_valider" => "attention", "refuse" => "urgent", _ => "info"
    };

    private async Task Executer(Func<Task<string?>> action)
    {
        (enCours, erreur) = (true, null);
        try { erreur = await action(); }
        finally { enCours = false; }
    }
}
