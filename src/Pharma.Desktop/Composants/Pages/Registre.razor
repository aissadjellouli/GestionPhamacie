@page "/stock/registre"
@inject ApiClient Api
@inject HistoriqueNavigation Historique

@* Écran fixe : inscriptions et balance mensuelle en deux rubriques (menu vertical) ; le tableau défile dans son cadre *@
<div class="page avec-menu">
    <nav class="nav-laterale" aria-label="Rubriques du registre">
        <a href="stock/registre" class="@(rubrique == "inscriptions" ? "active" : null)" aria-current="@(rubrique == "inscriptions" ? "page" : null)">Inscriptions @if (NombreInscriptions is { } n) { <span class="compteur neutre">@n</span> }</a>
        <a href="stock/registre?rubrique=balance" class="@(rubrique == "balance" ? "active" : null)" aria-current="@(rubrique == "balance" ? "page" : null)">Balance mensuelle</a>
        <span class="nav-groupe-titre">Autres écrans du stock</span>
        <a href="stock" class="sous-rubrique">Stock</a>
        <a href="tracabilite" class="sous-rubrique">Traçabilité et rappel de lot</a>
        <a href="inventaire" class="sous-rubrique">Inventaire</a>
    </nav>

    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>Registre des psychotropes · @(rubrique == "balance" ? "Balance mensuelle" : "Inscriptions")</h1>
            <p class="sous-titre">Entrées et sorties des psychotropes et stupéfiants, numérotées et non modifiables, avec la balance mensuelle.</p>
        </div>
    </div>

    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (fichier is not null)
    {
        <div class="succes" role="status">Fichier rangé : @(emplacement ?? fichier) <button type="button" class="lien-bouton" @onclick="() => Documents.Ouvrir(fichier)">Ouvrir</button></div>
    }

    <section aria-label="Filtres">
        <div class="filtres-liste" role="search" aria-label="Filtrer le registre">
            <div class="champ" style="flex: 2 1 260px">
                <label for="r-produit">Produit</label>
                <select id="r-produit" @bind="produitId" @bind:after="ChargerAsync">
                    <option value="">Tous les produits sous registre</option>
                    @foreach (var p in produits) { <option value="@p.Id">@p.Nom</option> }
                </select>
            </div>
            <div class="champ" style="flex: 0 0 170px"><label for="r-du">Du</label><input id="r-du" type="date" @bind="du" @bind:after="ChargerAsync" /></div>
            <div class="champ" style="flex: 0 0 170px"><label for="r-au">Au</label><input id="r-au" type="date" @bind="au" @bind:after="ChargerAsync" /></div>
            @if (rubrique == "inscriptions")
            {
                <div class="champ" style="flex: 0 0 220px"><label for="r-operation">Opération</label>
                    <select id="r-operation" @bind="operation" @bind:after="PremierePageAsync">
                        <option value="">Toutes</option>
                        @foreach (var o in operations) { <option value="@o.Code">@o.Libelle</option> }
                    </select></div>
            }
            @if (operation != "" && rubrique == "inscriptions") { <button type="button" class="btn" @onclick="ToutesOperationsAsync">Tout afficher</button> }
            @* Exports sur la ligne des filtres (écran fixe : pas de ligne de boutons en plus) ; ils prennent tout le registre du produit et de la période *@
            <button type="button" class="btn" disabled="@(registre is null || enCours || ExportTropLong)" title="@(ExportTropLong ? "Un an au plus par fichier" : null)" @onclick='() => ExporterAsync("pdf")'>Exporter en PDF</button>
            <button type="button" class="btn" disabled="@(registre is null || enCours || ExportTropLong)" title="@(ExportTropLong ? "Un an au plus par fichier" : null)" @onclick='() => ExporterAsync("csv")'>Exporter pour Excel</button>
        </div>
        @if (ExportTropLong)
        {
            <p class="detail" style="margin: 8px 0 0">Export : un an au plus par fichier. Réduisez la période pour exporter (un fichier par année).</p>
        }
        @if (registre?.NomsMasques == true)
        {
            <p class="detail" style="margin: 8px 0 0">Noms des patients et des porteurs abrégés : seul le titulaire les voit en entier.</p>
        }
    </section>

    @if (registre is null)
    {
        <Chargement />
    }
    else if (rubrique == "inscriptions")
    {
        <section aria-label="Inscriptions">
            @if (inscriptions.Count == 0)
            {
                <p class="vide" style="margin: 0">@(operation == "" ? "Aucune inscription sur la période." : "Aucune inscription pour ces filtres.")</p>
            }
            else
            {
                <div class="tableau-cadre">
                    <table class="tableau tableau-registre">
                        <thead>
                            <tr>
                                <th scope="col">N°</th><th scope="col">Date</th><th scope="col">Produit · lot</th><th scope="col">Opération</th>
                                <th scope="col" class="nombre">Entrée</th><th scope="col" class="nombre">Sortie</th>
                                <th scope="col" class="nombre">Solde produit</th><th scope="col" class="nombre">Solde lot</th>
                                <th scope="col">Patient · porteur</th><th scope="col">Médecin · ordonnance</th><th scope="col">Référence · grossiste</th><th scope="col">Employé</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in inscriptions)
                            {
                                <tr>
                                    <td>@l.Numero</td>
                                    <td>@Libelles.DateHeureLocale(l.Date)</td>
                                    <td><span class="nom">@l.Produit</span><br /><span class="detail">lot @l.NumeroLot</span></td>
                                    <td>@l.Operation</td>
                                    <td class="nombre">@l.Entree</td>
                                    <td class="nombre">@l.Sortie</td>
                                    <td class="nombre"><strong>@(l.SoldeProduit?.ToString() ?? "—")</strong></td>
                                    <td class="nombre">@l.SoldeLot</td>
                                    <td>
                                        <LienContact Type="patient" Id="l.PatientId" Nom="@(l.Patient ?? "")" />
                                        @if (l.PorteurNom is not null)
                                        {
                                            <br /><span class="detail">Porteur : @l.PorteurNom, @l.PorteurAdresse, pièce @l.PorteurPiece</span>
                                        }
                                    </td>
                                    <td>@l.Medecin @if (l.Ordonnance is not null) { <br /><span class="detail">n° @l.Ordonnance</span> }</td>
                                    <td>@l.Reference @if (l.Fournisseur is not null) { <br /><span class="detail">@l.Fournisseur</span> }</td>
                                    <td>@l.Employe</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <Pagination Total="totalInscriptions" Numero="pageInscriptions" Taille="tailleInscriptions" Libelle="Pages des inscriptions" OnChange="p => ChargerInscriptionsAsync(p.Numero, p.Taille)" />
        </section>
    }
    else
    {
        <section aria-label="Balance mensuelle">
            @if (registre.Balance.Count == 0)
            {
                <p class="vide" style="margin: 0">Pas de mouvement sur la période.</p>
            }
            else
            {
                <div class="tableau-cadre">
                    <table class="tableau">
                        <thead><tr><th scope="col">Produit</th><th scope="col">Mois</th><th scope="col" class="nombre">Entrées</th><th scope="col" class="nombre">Sorties</th><th scope="col" class="nombre">Solde fin de mois</th></tr></thead>
                        <tbody>
                            @foreach (var b in registre.Balance.Skip((pageBalance - 1) * tailleBalance).Take(tailleBalance))
                            {
                                <tr><td>@b.Produit</td><td>@($"{b.Mois:00}/{b.Annee}")</td><td class="nombre">@b.Entrees</td><td class="nombre">@b.Sorties</td><td class="nombre">@(b.SoldeFin?.ToString() ?? "—")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="registre.Balance.Count" Numero="pageBalance" Taille="tailleBalance" Libelle="Pages de la balance" OnChange="p => (pageBalance, tailleBalance) = (p.Numero, p.Taille)" />
            }
        </section>
    }
    </div>
</div>

@code {
    // Rubrique dans l'adresse (stock/registre?rubrique=balance) : « Retour » y revient
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => Rubrique == "balance" ? "balance" : "inscriptions";
    private int? NombreInscriptions => registre?.Inscriptions;
    // Consultation sans limite de durée ; un export (PDF ou CSV) porte sur un an au plus : un fichier par année
    private const int JoursMaxExport = 366;
    private bool ExportTropLong => au.DayNumber - du.DayNumber >= JoursMaxExport;

    // Inscriptions : paginées et filtrées par le serveur (produit, période, opération)
    private List<LigneRegistreDto> inscriptions = [];
    private List<CodeLibelleDto> operations = [];
    private string operation = "";
    private int totalInscriptions, pageInscriptions = 1, tailleInscriptions = Pagination.TailleParDefaut;
    // Balance mensuelle : paginée à l'écran (elle suit déjà le produit et la période choisis)
    private int pageBalance = 1, tailleBalance = Pagination.TailleParDefaut;

    private Task PremierePageAsync() => ChargerInscriptionsAsync(1, tailleInscriptions);
    private Task ToutesOperationsAsync() { operation = ""; return PremierePageAsync(); }

    private async Task ChargerInscriptionsAsync(int numero, int taille)
    {
        var (r, e) = await Api.InscriptionsRegistreAsync(produitId, du, au, operation, numero, taille);
        if (r is null) { erreur ??= e; return; }
        if (r.Page.Lignes.Count == 0 && numero > 1) { await ChargerInscriptionsAsync(1, taille); return; }
        (inscriptions, totalInscriptions, pageInscriptions, tailleInscriptions, operations) = (r.Page.Lignes.ToList(), r.Page.Total, r.Page.Numero, r.Page.Taille, r.Operations.ToList());
        if (operation != "" && operations.All(o => o.Code != operation)) { operation = ""; await ChargerInscriptionsAsync(1, taille); }
    }

    private List<ProduitRegistreDto> produits = [];
    private long? produitId;
    private DateOnly du = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly au = DateOnly.FromDateTime(DateTime.Today);
    private RegistreDto? registre;
    private string? erreur, fichier, emplacement;
    private bool enCours;

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : produit, période, opération et page retrouvés tels qu'ils étaient
        Historique.Suivre("registre", e =>
        {
            e.Mettre("produit", produitId); e.Mettre("du", du); e.Mettre("au", au); e.Mettre("operation", operation);
            e.Mettre("page", pageInscriptions); e.Mettre("taille", tailleInscriptions);
            e.Mettre("page_balance", pageBalance); e.Mettre("taille_balance", tailleBalance);
        });
        var r = Historique.Restaurer("registre");
        if (r is not null)
        {
            produitId = r.Long("produit");
            (du, au, operation) = (r.Date("du") ?? du, r.Date("au") ?? au, r.Texte("operation") ?? "");
            (pageInscriptions, tailleInscriptions) = (r.Entier("page") ?? 1, r.Entier("taille") ?? tailleInscriptions);
            (pageBalance, tailleBalance) = (r.Entier("page_balance") ?? 1, r.Entier("taille_balance") ?? tailleBalance);
        }
        (produits, erreur) = await Api.ProduitsRegistreAsync();
        await ChargerAsync(pageInscriptions);
    }

    // Produit ou période changés : registre (balance, nombre), première page des inscriptions et de la balance
    private Task ChargerAsync()
    {
        pageBalance = 1;
        return ChargerAsync(1);
    }

    private async Task ChargerAsync(int pageVoulue)
    {
        (erreur, fichier) = (null, null);
        var (r, e) = await Api.RegistreAsync(produitId, du, au);
        if (e is not null) { erreur = e; return; }
        registre = r;
        await ChargerInscriptionsAsync(pageVoulue, tailleInscriptions);
    }

    private async Task ExporterAsync(string format)
    {
        (erreur, fichier, enCours) = (null, null, true);
        try
        {
            var (contenu, nom, e) = await Api.ExporterRegistreAsync(produitId, du, au, format);
            if (e is not null) { erreur = e; return; }
            var doc = await Documents.RangerAsync(Api, "Registre", nom!, contenu!);
            (fichier, emplacement, erreur) = (doc.CheminLocal, doc.Emplacement, doc.Erreur);
            Documents.Ouvrir(fichier);
        }
        catch (Exception ex) { erreur = $"Fichier impossible à ouvrir : {ex.Message}"; }
        finally { enCours = false; }
    }
}
