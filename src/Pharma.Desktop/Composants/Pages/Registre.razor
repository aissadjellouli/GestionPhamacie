@page "/stock/registre"
@inject ApiClient Api
@inject HistoriqueNavigation Historique
@inject SessionPoste Session

@* Écran fixe : inscriptions et balance mensuelle en deux rubriques (menu vertical) ; le tableau défile dans son cadre *@
<div class="page avec-menu">
    <NavDomaine Libelle="Rubriques du registre">
        <a href="stock/registre" class="@(rubrique == "inscriptions" ? "active" : null)" aria-current="@(rubrique == "inscriptions" ? "page" : null)">Inscriptions @if (NombreInscriptions is { } n) { <span class="compteur neutre">@n</span> }</a>
        <a href="stock/registre?rubrique=balance" class="@(rubrique == "balance" ? "active" : null)" aria-current="@(rubrique == "balance" ? "page" : null)">Balance mensuelle</a>
        <a href="stock/registre?rubrique=forcages" class="@(rubrique == "forcages" ? "active" : null)" aria-current="@(rubrique == "forcages" ? "page" : null)">Alertes forcées</a>
    </NavDomaine>

    <div class="contenu-rubrique">
    @if (rubrique == "forcages")
    {
        <ForcagesPsychotropes />
    }
    else
    {
    <div class="titre-page">
        <div>
            <h1>Registre des psychotropes · @(rubrique == "balance" ? "Balance mensuelle" : "Inscriptions")<AideEcran Cle="stock/registre" /></h1>
            <p class="sous-titre">Entrées et sorties des psychotropes et stupéfiants, numérotées et non modifiables, avec la balance mensuelle.</p>
        </div>
    </div>

    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (fichier is not null)
    {
        <div class="succes" role="status">Fichier rangé : @(emplacement ?? fichier) <button type="button" class="lien-bouton" @onclick="() => Documents.Ouvrir(fichier)">Ouvrir</button></div>
    }

    <section aria-label="Filtres">
        <div class="filtres-liste" role="search" aria-label="Filtrer le registre">
            <div class="champ" style="flex: 2 1 260px">
                <label for="r-produit">Produit</label>
                <select id="r-produit" @bind="produitId" @bind:after="ChargerAsync">
                    <option value="">Tous les produits sous registre</option>
                    @foreach (var p in produits) { <option value="@p.Id">@p.Nom</option> }
                </select>
            </div>
            <div class="champ" style="flex: 0 0 170px"><label for="r-du">Du</label><input id="r-du" type="date" @bind="du" @bind:after="ChargerAsync" /></div>
            <div class="champ" style="flex: 0 0 170px"><label for="r-au">Au</label><input id="r-au" type="date" @bind="au" @bind:after="ChargerAsync" /></div>
            @if (rubrique == "inscriptions")
            {
                <div class="champ" style="flex: 0 0 220px"><label for="r-operation">Opération</label>
                    <select id="r-operation" @bind="operation" @bind:after="PremierePageAsync">
                        <option value="">Toutes</option>
                        @foreach (var o in operations) { <option value="@o.Code">@o.Libelle</option> }
                    </select></div>
            }
            @if (operation != "" && rubrique == "inscriptions") { <button type="button" class="btn" @onclick="ToutesOperationsAsync">Tout afficher</button> }
            @* Exports sur la ligne des filtres (écran fixe : pas de ligne de boutons en plus) ; ils prennent tout le registre du produit et de la période *@
            @* Export d'inspection (lot 8) : prescripteur (médecin choisi, ChoixMedecin) et patient (« Extrait » sur une ligne) en plus ; sceau de la période dans le fichier *@
            <ChoixMedecin Id="r-prescripteur" Libelle="Prescripteur (export)" Style="flex: 1 1 280px" Choix="@prescripteur?.Nom"
                          OnChoisi="m => prescripteur = m" OnEfface="() => prescripteur = null" />
            @if (patientExport is { } pe)
            {
                <span class="pastille" title="Export limité à ce patient">@pe.Nom <button type="button" class="lien-bouton" aria-label="Retirer le filtre patient" @onclick="() => patientExport = null">×</button></span>
            }
            <button type="button" class="btn" disabled="@(registre is null || enCours || ExportTropLong)" title="@(ExportTropLong ? "Un an au plus par fichier" : null)" @onclick='() => ExporterAsync("pdf")'>PDF</button>
            <button type="button" class="btn" disabled="@(registre is null || enCours || ExportTropLong)" title="@(ExportTropLong ? "Un an au plus par fichier" : "Classeur Excel (.xlsx)")" @onclick='() => ExporterAsync("xlsx")'>Excel</button>
            <button type="button" class="btn" disabled="@(registre is null || enCours || ExportTropLong)" title="@(ExportTropLong ? "Un an au plus par fichier" : "Texte séparé par des points-virgules")" @onclick='() => ExporterAsync("csv")'>CSV</button>
        </div>
        @if (ExportTropLong)
        {
            <p class="detail" style="margin: 8px 0 0">Export : un an au plus par fichier. Réduisez la période pour exporter (un fichier par année).</p>
        }
        @if (registre?.NomsMasques == true)
        {
            <p class="detail" style="margin: 8px 0 0">Noms des patients et des porteurs abrégés : seul le titulaire les voit en entier.</p>
        }
    </section>

    @if (registre is null)
    {
        <Chargement />
    }
    else if (rubrique == "inscriptions")
    {
        <section aria-label="Inscriptions">
            @if (inscriptions.Count == 0)
            {
                <p class="vide" style="margin: 0">@(operation == "" ? "Aucune inscription sur la période." : "Aucune inscription pour ces filtres.")</p>
                @if (operation == "")
                {
                    <ActionSuivante Libelle="Voir les 12 derniers mois" Action="DouzeDerniersMoisAsync" />
                }
            }
            else
            {
                @* Tableau compact (ergonomie 2026-11-27, propositions 2 et 16) : une ligne par inscription, sans défilement horizontal ;
                   Entrée et Sortie en une colonne signée, soldes produit et lot ensemble, patient et médecin (ou grossiste et référence)
                   ensemble, actions en fin de ligne. Ordre du serveur : n° croissant (indiqué dans l'en-tête). Texte coupé par « … »,
                   complet en infobulle. *@
                <div class="tableau-cadre">
                    <table class="tableau tableau-registre tableau-compact">
                        <thead>
                            <tr>
                                <th scope="col" aria-sort="ascending" title="Trié par n° croissant">N° ↑</th><th scope="col">Date</th>
                                <th scope="col" class="principal">Produit · lot</th><th scope="col">Mouvement</th>
                                <th scope="col" class="nombre" title="Solde du produit, puis solde du lot">Solde · lot</th>
                                <th scope="col">Patient · médecin ou grossiste</th><th scope="col">Employé</th>
                                <th scope="col"><span class="visuellement-cache">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in inscriptions)
                            {
                                var tiers = Tiers(l);
                                <tr>
                                    <td>@l.Numero</td>
                                    <td title="@Libelles.DateHeureLocale(l.Date)">@l.Date.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                    <td class="principal" title="@($"{l.Produit} · lot {l.NumeroLot}")"><span class="nom"><LienProduit Texte="@l.Produit" /></span><span class="detail">lot <LienProduit Texte="@l.NumeroLot" Lot="true" /></span></td>
                                    <td title="@l.Operation"><span class="coupe coupe-s"><strong>@Mouvement(l)</strong> <span class="detail">@l.Operation</span></span></td>
                                    <td class="nombre"><strong>@(l.SoldeProduit?.ToString() ?? "—")</strong><span class="detail">@l.SoldeLot</span></td>
                                    <td title="@tiers.Infobulle"><span class="coupe coupe-m">
                                        @if (l.Patient is not null) { <LienContact Type="patient" Id="l.PatientId" Nom="@l.Patient" /> }
                                        @if (tiers.Detail is not null) { <span class="detail">@tiers.Detail</span> }
                                    </span></td>
                                    <td><span class="coupe coupe-xs" title="@l.Employe">@l.Employe</span></td>
                                    <td class="actions-ligne">
                                        @if (l.Annulation is not null) { <span class="pastille urgent" title="@l.Annulation">Annulée</span> }
                                        else if (Session.A("role.titulaire")) { <button type="button" class="lien-bouton" title="Annuler l’écriture n° @l.Numero" aria-label="Annuler l’écriture n° @l.Numero" @onclick="() => annulation = (l.Numero, l.Produit, (string?)null)">Annuler</button> }
                                        @if (l.PatientId is { } pid) { <button type="button" class="lien-bouton" title="Extrait patient : exporter seulement les lignes de ce patient" aria-label="Extrait patient : @(l.Patient ?? pid.ToString())" @onclick="() => patientExport = (pid, l.Patient ?? pid.ToString())">Extrait</button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <Pagination Total="totalInscriptions" Numero="pageInscriptions" Taille="tailleInscriptions" Libelle="Pages des inscriptions" OnChange="p => ChargerInscriptionsAsync(p.Numero, p.Taille)" />
        </section>
    }
    else
    {
        <section aria-label="Balance mensuelle">
            @if (registre.Balance.Count == 0)
            {
                <p class="vide" style="margin: 0">Pas de mouvement sur la période.</p>
            }
            else
            {
                <div class="tableau-cadre">
                    <table class="tableau">
                        <thead><tr><th scope="col">Produit</th><th scope="col">Mois</th><th scope="col" class="nombre" title="Solde d’ouverture du registre (stock repris), distinct des entrées">Solde reporté</th><th scope="col" class="nombre">Entrées</th><th scope="col" class="nombre">Sorties</th><th scope="col" class="nombre">Solde fin de mois</th></tr></thead>
                        <tbody>
                            @foreach (var b in registre.Balance.Skip((pageBalance - 1) * tailleBalance).Take(tailleBalance))
                            {
                                <tr><td>@b.Produit</td><td>@($"{b.Mois:00}/{b.Annee}")</td><td class="nombre">@b.SoldeReporte</td><td class="nombre">@b.Entrees</td><td class="nombre">@b.Sorties</td><td class="nombre">@(b.SoldeFin?.ToString() ?? "—")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="registre.Balance.Count" Numero="pageBalance" Taille="tailleBalance" Libelle="Pages de la balance" OnChange="p => (pageBalance, tailleBalance) = (p.Numero, p.Taille)" />
            }
        </section>
    }
    }
    </div>
</div>

@if (annulation is { } an)
{
    @* Correction par écriture d'annulation (titulaire) : la ligne reste au registre, marquée « annulée » avec le motif *@
    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-annulation-registre">
        <section class="panneau" style="width: min(620px, 96vw); display: flex; flex-direction: column; gap: 10px">
            <h2 id="t-annulation-registre" style="margin: 0">Annuler l’écriture n° @an.Numero · @an.Produit</h2>
            <p class="detail" style="margin: 0">La ligne n’est jamais modifiée ni supprimée : elle est marquée annulée, avec votre nom et le motif, dans le registre et son journal protégé.
                Le stock se corrige par un retour ou un écart d’inventaire, qui s’inscrivent au registre.</p>
            <div class="champ"><label for="an-motif">Motif (5 caractères au moins)</label><input id="an-motif" type="text" maxlength="500" @bind="motifAnnulation" @bind:event="oninput" /></div>
            @if (erreurAnnulation is not null) { <div class="erreur" role="alert">@erreurAnnulation</div> }
            <div class="actions" style="display: flex; gap: 8px; justify-content: flex-end">
                <button type="button" class="btn" disabled="@enCours" @onclick="() => (annulation, motifAnnulation, erreurAnnulation) = (null, null, null)">Fermer</button>
                <button type="button" class="btn btn-principal" disabled="@(enCours || (motifAnnulation?.Trim().Length ?? 0) < 5)" @onclick="AnnulerEcritureAsync">Annuler l’écriture</button>
            </div>
        </section>
    </div>
}

@code {
    // Rubrique dans l'adresse (stock/registre?rubrique=balance) : « Retour » y revient
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => Rubrique is "balance" or "forcages" ? Rubrique! : "inscriptions";

    // Export d'inspection (lot 8) et annulation d'écriture (titulaire)
    /// <summary>Médecin choisi pour l'export : l'export filtre sur son identifiant (jamais sur une partie du nom).</summary>
    private MedecinDto? prescripteur;
    private (long Id, string Nom)? patientExport;
    private (long Numero, string Produit, string? Motif)? annulation;
    private string? motifAnnulation, erreurAnnulation;

    private async Task AnnulerEcritureAsync()
    {
        if (annulation is not { } an) return;
        (enCours, erreurAnnulation) = (true, null);
        erreurAnnulation = await Api.AnnulerEcritureRegistreAsync(an.Numero, motifAnnulation!.Trim());
        enCours = false;
        if (erreurAnnulation is not null) return;
        (annulation, motifAnnulation) = (null, null);
        await ChargerInscriptionsAsync(pageInscriptions, tailleInscriptions);
    }
    private int? NombreInscriptions => registre?.Inscriptions;

    /// <summary>Entrée et sortie en une colonne signée (+ entrée, − sortie) ; les deux si une ligne porte les deux.</summary>
    private static string Mouvement(LigneRegistreDto l) => (l.Entree, l.Sortie) switch
    {
        ({ } e, { } so) when e != 0 && so != 0 => $"+{e} / −{so}",
        ({ } e, _) when e != 0 => $"+{e}",
        (_, { } so) when so != 0 => $"−{so}",
        _ => "0"
    };

    /// <summary>
    /// Colonne regroupée : après le patient, le médecin et l'ordonnance (sortie) ou la référence et le grossiste (entrée) en petit ;
    /// porteur et durée de traitement dans l'infobulle (texte complet), le mot « porteur » restant visible.
    /// </summary>
    private static (string? Detail, string Infobulle) Tiers(LigneRegistreDto l)
    {
        var morceaux = new List<string>();
        if (l.PorteurNom is not null) morceaux.Add("porteur");
        if (l.Medecin is not null) morceaux.Add(l.Ordonnance is null ? l.Medecin : $"{l.Medecin}, ord. {l.Ordonnance}");
        if (l.Reference is not null || l.Fournisseur is not null) morceaux.Add(string.Join(" · ", new[] { l.Reference, l.Fournisseur }.OfType<string>()));
        var infobulle = new List<string>();
        if (l.Patient is not null) infobulle.Add($"Patient : {l.Patient}");
        if (l.PorteurNom is not null) infobulle.Add($"Porteur : {l.PorteurNom}, {l.PorteurAdresse}, pièce {l.PorteurPiece}");
        if (l.DureeTraitementJours is { } dt) infobulle.Add($"Traitement : {dt} jours");
        if (l.Medecin is not null) infobulle.Add($"Médecin : {l.Medecin}{(l.Ordonnance is null ? "" : $", ordonnance n° {l.Ordonnance}")}");
        if (l.Reference is not null) infobulle.Add($"Référence : {l.Reference}");
        if (l.Fournisseur is not null) infobulle.Add($"Grossiste : {l.Fournisseur}");
        return (morceaux.Count == 0 ? null : string.Join(" · ", morceaux), string.Join(" / ", infobulle));
    }
    // Consultation sans limite de durée ; un export (PDF ou CSV) porte sur un an au plus : un fichier par année
    private const int JoursMaxExport = 366;
    private bool ExportTropLong => au.DayNumber - du.DayNumber >= JoursMaxExport;

    // Inscriptions : paginées et filtrées par le serveur (produit, période, opération)
    private List<LigneRegistreDto> inscriptions = [];
    private List<CodeLibelleDto> operations = [];
    private string operation = "";
    private int totalInscriptions, pageInscriptions = 1, tailleInscriptions = Pagination.TailleParDefaut;
    // Balance mensuelle : paginée à l'écran (elle suit déjà le produit et la période choisis)
    private int pageBalance = 1, tailleBalance = Pagination.TailleParDefaut;

    private Task PremierePageAsync() => ChargerInscriptionsAsync(1, tailleInscriptions);
    /// <summary>Période vide : proposée sur les 12 derniers mois (jusqu'à aujourd'hui).</summary>
    private Task DouzeDerniersMoisAsync()
    {
        (du, au) = (DateOnly.FromDateTime(DateTime.Today).AddMonths(-12).AddDays(1), DateOnly.FromDateTime(DateTime.Today));
        return ChargerAsync();
    }
    private Task ToutesOperationsAsync() { operation = ""; return PremierePageAsync(); }

    private async Task ChargerInscriptionsAsync(int numero, int taille)
    {
        var (r, e) = await Api.InscriptionsRegistreAsync(produitId, du, au, operation, numero, taille);
        if (r is null) { erreur ??= e; return; }
        if (r.Page.Lignes.Count == 0 && numero > 1) { await ChargerInscriptionsAsync(1, taille); return; }
        (inscriptions, totalInscriptions, pageInscriptions, tailleInscriptions, operations) = (r.Page.Lignes.ToList(), r.Page.Total, r.Page.Numero, r.Page.Taille, r.Operations.ToList());
        if (operation != "" && operations.All(o => o.Code != operation)) { operation = ""; await ChargerInscriptionsAsync(1, taille); }
    }

    private List<ProduitRegistreDto> produits = [];
    private long? produitId;
    private DateOnly du = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly au = DateOnly.FromDateTime(DateTime.Today);
    private RegistreDto? registre;
    private string? erreur, fichier, emplacement;
    private bool enCours;

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : produit, période, opération et page retrouvés tels qu'ils étaient
        Historique.Suivre("registre", e =>
        {
            e.Mettre("produit", produitId); e.Mettre("du", du); e.Mettre("au", au); e.Mettre("operation", operation);
            e.Mettre("page", pageInscriptions); e.Mettre("taille", tailleInscriptions);
            e.Mettre("page_balance", pageBalance); e.Mettre("taille_balance", tailleBalance);
        });
        var r = Historique.Restaurer("registre");
        if (r is not null)
        {
            produitId = r.Long("produit");
            (du, au, operation) = (r.Date("du") ?? du, r.Date("au") ?? au, r.Texte("operation") ?? "");
            (pageInscriptions, tailleInscriptions) = (r.Entier("page") ?? 1, r.Entier("taille") ?? tailleInscriptions);
            (pageBalance, tailleBalance) = (r.Entier("page_balance") ?? 1, r.Entier("taille_balance") ?? tailleBalance);
        }
        (produits, erreur) = await Api.ProduitsRegistreAsync();
        await ChargerAsync(pageInscriptions);
    }

    // Produit ou période changés : registre (balance, nombre), première page des inscriptions et de la balance
    private Task ChargerAsync()
    {
        pageBalance = 1;
        return ChargerAsync(1);
    }

    private async Task ChargerAsync(int pageVoulue)
    {
        (erreur, fichier) = (null, null);
        var (r, e) = await Api.RegistreAsync(produitId, du, au);
        if (e is not null) { erreur = e; return; }
        registre = r;
        await ChargerInscriptionsAsync(pageVoulue, tailleInscriptions);
    }

    private async Task ExporterAsync(string format)
    {
        (erreur, fichier, enCours) = (null, null, true);
        try
        {
            var (contenu, nom, e) = await Api.ExporterRegistreAsync(produitId, du, au, format, patientExport?.Id, medecin: prescripteur?.Id);
            if (e is not null) { erreur = e; return; }
            var doc = await Documents.RangerAsync(Api, "Registre", nom!, contenu!);
            (fichier, emplacement, erreur) = (doc.CheminLocal, doc.Emplacement, doc.Erreur);
            Documents.Ouvrir(fichier);
        }
        catch (Exception ex) { erreur = $"Fichier impossible à ouvrir : {ex.Message}"; }
        finally { enCours = false; }
    }
}
