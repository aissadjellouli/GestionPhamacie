@page "/admin/nomenclature"
@inject ApiClient Api
@inject HistoriqueNavigation Historique

<div class="page admin">
    <NavAdmin Actif="admin/nomenclature" Rubrique="@Rubrique" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Nomenclature nationale · @NavAdmin.Libelle("admin/nomenclature", Rubrique)</h1>
                <p class="sous-titre">Liste officielle des médicaments enregistrés en Algérie (ministère de l’Industrie pharmaceutique), pour créer les produits et repérer les psychotropes.</p>
            </div>
            <div class="actions">
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="ImporterAsync">@(enCours ? "Import en cours…" : "Importer le fichier Excel…")</button>
            </div>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (rubrique == "version")
        {
        <section class="panneau" aria-labelledby="t-version">
            <h2 id="t-version">Version chargée</h2>
            @if (etat is null)
            {
                <Chargement />
            }
            else if (etat.Version is not { } v)
            {
                <p class="vide" style="margin: 0">Aucune nomenclature importée. Téléchargez le fichier Excel sur le site du ministère (miph.gov.dz, « Nomenclature nationale des produits pharmaceutiques ») puis importez-le ici.</p>
            }
            else
            {
                <div class="tuiles-nomenclature">
                    <div><span class="detail">Version</span><strong>@v.Libelle</strong></div>
                    <div><span class="detail">En vigueur</span><strong>@v.EnVigueur.ToString("N0")</strong></div>
                    <div><span class="detail">Non renouvelés</span><strong>@v.NonRenouveles.ToString("N0")</strong></div>
                    <div><span class="detail">Retirés</span><strong>@v.Retraits.ToString("N0")</strong></div>
                </div>
                <p class="detail" style="margin: 8px 0 0">Fichier « @v.Fichier », importé le @Libelles.DateHeureLocale(v.ImporteeLe) par @v.ImporteePar. Un nouvel import remplace cette version.</p>
            }
            <p class="detail" style="margin: 8px 0 0">
                Psychotropes reconnus par leur DCI (arrêté interministériel du 11 août 2021, JO n° 61) : buprénorphine, tramadol, clonazépam,
                prégabaline, trihexyphénidyle, clorazépate, midazolam, zolpidem.
            </p>
        </section>
        }

        @if (etat is not null)
        {
            @if (rubrique == "verifier")
            {
            <section class="panneau" aria-labelledby="t-verif">
                <h2 id="t-verif">Produits du catalogue à vérifier</h2>
                @if (etat.AVerifier.Count == 0)
                {
                    <p class="vide" style="margin: 0">Rien à signaler : aucun psychotrope ou stupéfiant mal classé, aucun produit retiré, non renouvelé ou absent de la nomenclature dans le catalogue.</p>
                }
                else
                {
                    @* Produits à vérifier : filtrés et paginés à l'écran (règle des listes) ; le tableau défile dans son cadre *@
                    <div class="filtres-liste" role="search" aria-label="Filtrer les produits à vérifier">
                        <div class="champ" style="flex: 1 1 240px"><label for="fn-texte">Produit, DCI ou n° d’enregistrement</label>
                            <input id="fn-texte" type="search" autocomplete="off" placeholder="Ex. alprazolam" @bind="fTexte" @bind:event="oninput" @bind:after="() => page = 1" /></div>
                        <div class="champ" style="flex: 0 0 240px"><label for="fn-motif">Motif</label>
                            <select id="fn-motif" @bind="fMotif" @bind:after="() => page = 1">
                                <option value="">Tous</option>
                                @foreach (var (codeMotif, libelle) in Motifs.Where(m => etat.AVerifier.Any(p => p.Motif == m.Code))) { <option value="@codeMotif">@libelle</option> }
                            </select></div>
                        @if (FiltreActif) { <button type="button" class="btn" @onclick="ToutAfficher">Tout afficher</button> }
                    </div>
                    <div class="tableau-cadre">
                        <table class="tableau" style="min-width: 760px">
                            <thead><tr><th scope="col">Produit</th><th scope="col">N° d’enregistrement</th><th scope="col">Classe actuelle</th><th scope="col">Nomenclature</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
                            <tbody>
                                @foreach (var p in AVerifierFiltres.Skip((page - 1) * taille).Take(taille))
                                {
                                    <tr>
                                        <td><span class="nom">@p.Nom</span> <span class="detail">@p.Dosage @p.Forme</span><br /><span class="detail">@p.Dci</span></td>
                                        <td>@(p.NumEnregistrement ?? "—")</td>
                                        <td>@Libelles.Classe(p.Classe)</td>
                                        <td>
                                            @if (p.Motif == "classe")
                                            {
                                                @* Classe proposée : la plus stricte de la DCI (substance surveillée) et de la nomenclature ; un psychotrope peut être à passer en stupéfiant *@
                                                <span class="pastille urgent" title="Classe donnée par la DCI (substance surveillée) ou la nomenclature (n° d’enregistrement), la plus stricte des deux">Classe à corriger : @Libelles.Classe(p.ClasseProposee).ToLowerInvariant()</span>
                                            }
                                            else if (p.Motif == "repris")
                                            {
                                                <span class="pastille urgent" title="Créé par la reprise des données sans n° d’enregistrement (la nomenclature ne peut pas proposer sa classe), ou classé d’office psychotrope ou stupéfiant d’après sa DCI quand un employé l’a créé ou lui a donné cette DCI">À vérifier, vente bloquée</span>
                                            }
                                            else if (p.Motif == "absent")
                                            {
                                                <span class="pastille attention" title="Le n° d’enregistrement du produit n’est pas dans la nomenclature chargée">Absent de la nomenclature</span>
                                            }
                                            else
                                            {
                                                <span class="pastille attention">@Libelles.SituationNomenclature(p.Situation)</span>
                                            }
                                        </td>
                                        <td>
                                            @if (p.Motif == "classe" && p.ClasseProposee is { } proposee)
                                            {
                                                <div style="display: flex; flex-wrap: wrap; gap: 6px">
                                                    <button type="button" class="btn" disabled="@enCours" @onclick="() => AppliquerAsync(p, proposee)">Classer « @Libelles.Classe(proposee) »</button>
                                                    @* Le titulaire garde la classe actuelle en connaissance de cause : confirmation mémorisée, un employé ne la change plus *@
                                                    <button type="button" class="btn" disabled="@enCours" title="Garder cette classe : un employé ne pourra plus la changer, sauf en changeant la DCI" @onclick="() => AppliquerAsync(p, p.Classe)">Confirmer « @Libelles.Classe(p.Classe) »</button>
                                                </div>
                                            }
                                            else if (p.Motif == "repris")
                                            {
                                                <span class="detail">Vérifiez la boîte, puis confirmez sa classe pour autoriser la vente :</span>
                                                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px">
                                                    @foreach (var classe in ClassesReglementaires)
                                                    {
                                                        <button type="button" class="btn" disabled="@enCours" @onclick="() => AppliquerAsync(p, classe)">@Libelles.Classe(classe)</button>
                                                    }
                                                </div>
                                            }
                                            else if (p.Motif == "absent")
                                            {
                                                <span class="detail">Vérifier le n° d’enregistrement (erreur de saisie ?) ou le statut du médicament auprès du ministère</span>
                                            }
                                            else
                                            {
                                                <span class="detail">À vérifier avant de recommander</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (AVerifierFiltres.Count == 0) { <tr><td colspan="5" class="vide">Aucun produit à vérifier pour ces filtres.</td></tr> }
                            </tbody>
                        </table>
                    </div>
                    <Pagination Total="AVerifierFiltres.Count" Numero="page" Taille="taille" Libelle="Pages des produits à vérifier" OnChange="p => (page, taille) = (p.Numero, p.Taille)" />
                }
            </section>
            }
        }

        @if (rubrique == "version")
        {
        <ClassementProduits />
        }
    </div>
</div>

@code {
    /// <summary>Sous-rubrique dans l'adresse (admin/nomenclature?rubrique=…) : une partie à la fois, l'écran reste fixe.</summary>
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => NavAdmin.RubriqueCourante("admin/nomenclature", Rubrique);

    private EtatNomenclatureDto? etat;
    private string? erreur, message;
    private bool enCours;
    private static readonly string[] ClassesReglementaires = ["libre", "liste_i", "liste_ii", "psychotrope", "stupefiant"];

    // Produits à vérifier : filtres et page (à l'écran) ; « ← Retour » les retrouve
    private static readonly (string Code, string Libelle)[] Motifs =
        [("classe", "Classe à corriger"), ("repris", "À vérifier (reprise ou classe d’office)"), ("absent", "Absent de la nomenclature"), ("situation", "Retiré ou non renouvelé")];
    private string fTexte = "", fMotif = "";
    private int page = 1, taille = Pagination.TailleParDefaut;
    private bool FiltreActif => fTexte.Trim() != "" || fMotif != "";
    private List<ProduitAVerifierDto> AVerifierFiltres => (etat?.AVerifier ?? []).Where(p => RechercheTexte.Contient(fTexte, p.Nom, p.Dci, p.NumEnregistrement)
        && (fMotif == "" || p.Motif == fMotif || (fMotif == "situation" && p.Motif is not ("classe" or "repris" or "absent")))).ToList();
    private void ToutAfficher() => (fTexte, fMotif, page) = ("", "", 1);

    protected override async Task OnInitializedAsync()
    {
        Historique.Suivre("nomenclature", e => { e.Mettre("texte", fTexte); e.Mettre("motif", fMotif); e.Mettre("page", page); e.Mettre("taille", taille); });
        if (Historique.Restaurer("nomenclature") is { } h)
            (fTexte, fMotif, page, taille) = (h.Texte("texte") ?? "", h.Texte("motif") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        string? e;
        (etat, e) = await Api.EtatNomenclatureAsync();
        if (e is not null) erreur = e;
    }

    private async Task ImporterAsync()
    {
        (erreur, message) = (null, null);
        var chemin = Dialogues.ChoisirFichier("Fichier Excel de la nomenclature nationale", "Classeur Excel (*.xlsx)|*.xlsx");
        if (chemin is null) return;
        enCours = true;
        StateHasChanged();
        VersionNomenclatureDto? v;
        string? e;
        try { (v, e) = await Api.ImporterNomenclatureAsync(chemin); }
        finally { enCours = false; }
        if (e is not null) { erreur = e; return; }
        message = $"« {v!.Libelle} » importée : {v.EnVigueur:N0} médicaments en vigueur, {v.NonRenouveles:N0} non renouvelés, {v.Retraits:N0} retirés.";
        await ChargerAsync();
    }

    private async Task AppliquerAsync(ProduitAVerifierDto p, string classe)
    {
        (erreur, message, enCours) = (null, null, true);
        erreur = await Api.ChangerClasseProduitAsync(p.ProduitId, classe);
        enCours = false;
        if (erreur is null)
        {
            message = Libelles.EstSousRegistre(classe)
                ? $"{p.Nom} classé « {Libelles.Classe(classe)} » : ordonnance et registre exigés à la vente."
                : $"{p.Nom} classé « {Libelles.Classe(classe)} » : le produit peut être vendu.";
            await ChargerAsync();
        }
    }
}
