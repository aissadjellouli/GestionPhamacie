@page "/patients"
@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique
@inject FichesContact Fiches

@* Patients › « Fichier des patients » (2026-11-18) : tous les patients, filtrés et paginés par le serveur ; écran fixe, seul le tableau
   défile. Droits : ceux de la recherche de patients et de la fiche patient (droit de vendre) ; le filtre « à crédit » et la colonne de
   la dette suivent le droit qui montre déjà la dette d'un patient (ListerFichierPatients.DroitCredit). Le nom ouvre la fiche patient. *@
<div class="page avec-menu">
    <NavDomaine Libelle="Écrans des patients" />
    <div class="contenu-rubrique">
        <div class="titre-page">
            <div>
                <h1>Fichier des patients<AideEcran Cle="patients" /></h1>
                <p class="sous-titre">Tous les patients de l’officine : cliquez sur un nom pour ouvrir et modifier sa fiche.</p>
            </div>
            @* « Nouveau patient » (ergonomie 2026-11-27, proposition 14) : même fiche et même route qu'à la caisse (POST api/patients,
               droit de vendre), pour saisir un patient au téléphone ou hors vente *@
            @if (Session.A("caisse.vendre"))
            {
                <button type="button" class="btn btn-principal" @onclick="OuvrirNouveauAsync">Nouveau patient</button>
            }
        </div>
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

        <div class="filtres-liste" role="search" aria-label="Filtrer la liste">
            <div class="champ" style="flex: 1 1 200px"><label for="fp-texte">Nom, prénom, n° d’assuré, téléphone</label>
                <input id="fp-texte" type="search" data-champ="texte" maxlength="100" @bind="texte" @bind:event="oninput" @bind:after="() => ChargerAsync(1, taille)" /></div>
            <div class="champ" style="flex: 0 1 150px"><label for="fp-org">Organisme</label>
                <select id="fp-org" data-champ="organisme" @bind="filtreOrganisme" @bind:after="() => ChargerAsync(1, taille)">
                    <option value="">Tous</option>
                    <option value="aucun">Non assuré</option>
                    @foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }
                </select></div>
            <div class="champ" style="flex: 0 1 130px"><label for="fp-chronique">Malade chronique</label>
                <select id="fp-chronique" data-champ="chronique" @bind="filtreChronique" @bind:after="() => ChargerAsync(1, taille)">
                    <option value="">Tous</option><option value="oui">Oui</option><option value="non">Non</option>
                </select></div>
            @if (VoitCredit)
            {
                <div class="champ" style="flex: 0 1 130px"><label for="fp-credit">Crédit</label>
                    <select id="fp-credit" data-champ="credit" @bind="filtreCredit" @bind:after="() => ChargerAsync(1, taille)">
                        <option value="">Tous</option><option value="oui">À crédit</option><option value="non">Sans crédit</option>
                    </select></div>
            }
            <div class="champ" style="flex: 0 1 230px"><label for="fp-droits">Droits Chifa</label>
                <select id="fp-droits" data-champ="droits" @bind="filtreDroits" @bind:after="() => ChargerAsync(1, taille)">
                    <option value="">Tous</option><option value="expires_ou_bientot">Expirés ou bientôt expirés</option>
                    <option value="expires">Expirés</option><option value="bientot">Bientôt expirés</option>
                </select></div>
            <div class="champ" style="flex: 0 1 120px"><label for="fp-sms">Accord SMS</label>
                <select id="fp-sms" data-champ="sms" @bind="filtreSms" @bind:after="() => ChargerAsync(1, taille)">
                    <option value="">Tous</option><option value="oui">Oui</option><option value="non">Non</option>
                </select></div>
        </div>

        <div class="tableau-cadre">
            <table class="tableau">
                <thead><tr><th scope="col">Patient</th><th scope="col">Téléphone</th><th scope="col">Organisme</th><th scope="col">N° d’assuré</th>
                    <th scope="col">Droits jusqu’au</th><th scope="col">Chronique</th><th scope="col">Accord SMS</th>
                    @if (VoitCredit) { <th scope="col" class="nombre">Dette</th> }</tr></thead>
                <tbody>
                    @if (liste is null) { <tr><td colspan="@Colonnes"><Chargement /></td></tr> }
                    else
                    {
                        @foreach (var p in liste.Lignes)
                        {
                            <tr>
                                <td><LienContact Type="patient" Id="p.Id" Nom="@($"{p.Nom} {p.Prenom}".Trim())" /></td>
                                <td style="white-space: nowrap">@(p.Telephone ?? "—")</td>
                                <td>@(p.Organisme ?? "—")</td>
                                <td>@(p.NumAssure ?? "—")</td>
                                <td>@(p.DateFinDroit is { } fin ? Libelles.Date(fin) : "—")
                                    @if (p.EtatDroits is { } etat)
                                    {
                                        <br /><span class="pastille @(etat == "expires" ? "urgent" : "attention")">@(etat == "expires" ? "expirés" : "bientôt expirés")</span>
                                    }</td>
                                <td>@(p.Chronique ? "Oui" : "Non")</td>
                                <td>@(p.ConsentementSms ? "Oui" : "Non")</td>
                                @if (VoitCredit)
                                {
                                    <td class="nombre"><span class="@(p.SoldeCredit is > 0 ? "montant-du" : null)">@(p.SoldeCredit is > 0 ? Libelles.Dinars(p.SoldeCredit, 2) : "—")</span></td>
                                }
                            </tr>
                        }
                        @if (liste.Lignes.Count == 0) { <tr><td colspan="@Colonnes" class="vide">@(FiltreActif ? "Aucun patient ne répond à ces filtres." : "Aucun patient enregistré : « Nouveau patient » en haut à droite, ou à la caisse.")</td></tr> }
                    }
                </tbody>
            </table>
        </div>
        <Pagination Total="@(liste?.Total ?? 0)" Numero="@(liste?.Numero ?? 1)" Taille="taille" Occupe="enCours"
                    Libelle="Pages du fichier des patients" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
    </div>
</div>

@if (nouveau is { } np)
{
    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-nouveau-patient">
        <section class="panneau fenetre-nouveau-patient">
            <h2 id="t-nouveau-patient">Nouveau patient</h2>
            @* Mêmes champs qu'à la caisse ; après un refus, la saisie reste (seul le message change) *@
            <div class="sous-formulaire fiche-medecin" role="group" aria-label="Nouveau patient">
                <input type="text" aria-label="Nom (obligatoire)" data-champ="nom_patient" placeholder="Nom *" @ref="champNom" @bind="np.Nom" @bind:event="oninput"
                       class="@Obligatoire.Classe(NomManquant)" aria-invalid="@Obligatoire.Aria(NomManquant)" />
                <input type="text" aria-label="Prénom" placeholder="Prénom" @bind="np.Prenom" />
                <input type="text" aria-label="Téléphone" data-champ="telephone" placeholder="Téléphone" @bind="np.Telephone" />
                <input type="email" aria-label="E-mail (facultatif)" data-champ="email" placeholder="E-mail" maxlength="120" @bind="np.Email" />
                <input type="text" aria-label="N° d’assuré" placeholder="N° d’assuré" @bind="np.NumAssure" />
                <select class="selection" aria-label="Organisme" @bind="np.OrganismeId">
                    <option value="0">Sans organisme</option>
                    @foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }
                </select>
                <input type="number" min="0" aria-label="Plafond de crédit (DA)" data-champ="plafond" placeholder="Plafond de crédit (DA)" @bind="np.Plafond" />
                @if (NomManquant) { <span class="message-champ fiche-pleine-largeur">Le nom du patient est obligatoire.</span> }
                @if (erreurNouveau is not null) { <div class="erreur" role="alert">@erreurNouveau</div> }
                @if (patientExistant is { } existant)
                {
                    <span class="message-champ fiche-pleine-largeur">
                        Ce n° d’assuré est celui de @($"{existant.Nom} {existant.Prenom}".Trim()).
                        <button type="button" class="lien-bouton" @onclick="OuvrirPatientExistant">Ouvrir sa fiche</button>
                    </span>
                }
                <div class="actions">
                    <button type="button" class="btn btn-principal" disabled="@enCreation" @onclick="CreerAsync">Créer</button>
                    <button type="button" class="btn" disabled="@enCreation" @onclick="FermerNouveau">Annuler</button>
                </div>
            </div>
        </section>
    </div>
}

@code {
    // ---- Nouveau patient (proposition 14) : mêmes champs que la fiche de la caisse ----
    private sealed class NouveauPatientSaisie
    {
        public string Nom { get; set; } = "";
        public string? Prenom { get; set; }
        public string? Telephone { get; set; }
        public string? Email { get; set; }
        public string? NumAssure { get; set; }
        public long OrganismeId { get; set; }
        public decimal Plafond { get; set; }
    }
    private NouveauPatientSaisie? nouveau;
    private bool controleNouveau, enCreation, focaliserNom;
    private string? erreurNouveau, message;
    private PatientDto? patientExistant;
    private ElementReference champNom;
    private bool NomManquant => nouveau is not null && Obligatoire.Manque(controleNouveau, nouveau.Nom);

    private async Task OuvrirNouveauAsync()
    {
        // Plafond de crédit proposé : celui réglé par le titulaire (Administration › Caisse), comme à la caisse ; 0 s'il est illisible
        var (etat, _) = await Api.EtatCaisseAsync();
        nouveau = new NouveauPatientSaisie { Nom = texte?.Trim() ?? "", Plafond = etat?.PlafondCreditDefaut ?? 0 };
        (controleNouveau, erreurNouveau, patientExistant, message, focaliserNom) = (false, null, null, null, true);
    }

    private void FermerNouveau() => (nouveau, controleNouveau, erreurNouveau, patientExistant) = (null, false, null, null);

    private void OuvrirPatientExistant()
    {
        if (patientExistant is not { } p) return;
        FermerNouveau();
        Fiches.Ouvrir("patient", p.Id, $"{p.Nom} {p.Prenom}".Trim());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focaliserNom || nouveau is null) return;
        focaliserNom = false;
        await champNom.FocusAsync();
    }

    private async Task CreerAsync()
    {
        if (nouveau is not { } np) return;
        controleNouveau = true;
        if (NomManquant) { await champNom.FocusAsync(); return; }
        (enCreation, erreurNouveau, patientExistant) = (true, null, null);
        try
        {
            var saisie = new NouveauPatientDto(np.Nom.Trim(), np.Prenom, np.Telephone, np.NumAssure,
                np.OrganismeId > 0 ? np.OrganismeId : null, np.Plafond, np.Email);
            var (cree, err) = await Api.CreerPatientAsync(saisie);
            if (err is not null)
            {
                // Saisie gardée : seul le message s'affiche ; n° d'assuré déjà pris (script 089) : la fiche existante est proposée
                erreurNouveau = err;
                patientExistant = err.StartsWith("N° d’assuré déjà utilisé par ", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(saisie.NumAssure)
                    ? (await Api.RechercherPatientsAsync(saisie.NumAssure.Trim())).Item1.FirstOrDefault() : null;
                return;
            }
            var nom = $"{saisie.Nom} {saisie.Prenom}".Trim();
            FermerNouveau();
            message = $"« {nom} » ajouté au fichier des patients.";
            await ChargerAsync(liste?.Numero ?? 1, taille);
            // Sa fiche s'ouvre, pour compléter le reste (adresse, chronique, accord SMS…)
            Fiches.Ouvrir("patient", cree!.Id, nom);
        }
        finally { enCreation = false; }
    }

    private PageDto<PatientFichierDto>? liste;
    private List<OrganismeDto> organismes = [];
    private string? texte;
    private string filtreOrganisme = "", filtreChronique = "", filtreCredit = "", filtreDroits = "", filtreSms = "";
    private int taille = Pagination.TailleParDefaut;
    private bool enCours;
    private string? erreur;
    private int demande;

    /// <summary>Même droit que l'API (ListerFichierPatients.DroitCredit) : celui qui montre déjà la dette d'un patient.</summary>
    private bool VoitCredit => Session.A("caisse.vendre");
    private int Colonnes => VoitCredit ? 8 : 7;
    private bool FiltreActif => !string.IsNullOrWhiteSpace(texte) || filtreOrganisme != "" || filtreChronique != "" || filtreCredit != ""
                                || filtreDroits != "" || filtreSms != "";

    private static readonly string[] Droits = ["expires_ou_bientot", "expires", "bientot"];

    protected override async Task OnInitializedAsync()
    {
        Historique.Suivre("patients", e =>
        {
            e.Mettre("texte", texte); e.Mettre("organisme", filtreOrganisme); e.Mettre("chronique", filtreChronique);
            e.Mettre("credit", filtreCredit); e.Mettre("droits", filtreDroits); e.Mettre("sms", filtreSms);
            e.Mettre("page", liste?.Numero ?? 1); e.Mettre("taille", taille);
        });
        var numero = 1;
        if (Historique.Restaurer("patients") is { } h)
        {
            texte = h.Texte("texte");
            filtreOrganisme = h.Texte("organisme") ?? "";
            filtreChronique = OuiNon(h.Texte("chronique"));
            filtreCredit = OuiNon(h.Texte("credit"));
            filtreDroits = h.Texte("droits") is { } d && Droits.Contains(d) ? d : "";
            filtreSms = OuiNon(h.Texte("sms"));
            (numero, taille) = (h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
        }
        (organismes, var e) = await Api.OrganismesAsync();
        erreur = e;
        await ChargerAsync(numero, taille);
    }

    private static string OuiNon(string? v) => v is "oui" or "non" ? v : "";
    private static bool? Booleen(string v) => v switch { "oui" => true, "non" => false, _ => null };

    private async Task ChargerAsync(int numero, int t)
    {
        // Saisie au clavier : seule la dernière demande est affichée
        var n = ++demande;
        enCours = true;
        taille = t;
        var (p, e) = await Api.FichierPatientsAsync(texte, filtreOrganisme == "" ? null : filtreOrganisme, Booleen(filtreChronique),
            VoitCredit ? Booleen(filtreCredit) : null, filtreDroits == "" ? null : filtreDroits, Booleen(filtreSms), numero, t);
        if (n != demande) return;
        (liste, erreur, enCours) = (p ?? liste, e, false);
    }
}
