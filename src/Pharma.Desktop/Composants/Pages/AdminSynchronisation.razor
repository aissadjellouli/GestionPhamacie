@page "/admin/synchronisation"
@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique

@* Synchronisation avec le serveur central (2026-11-16, lot S2, script 128) : état de l'envoi, réglages (activer, adresse, options),
   activation de ce serveur par code, chargement complet (lot S6 : progression, « Recharger toutes les données »). Droit admin.parametres. Écran fixe : une sous-rubrique à la fois, aucun défilement de page. *@
<div class="page admin">
    <NavAdmin Actif="admin/synchronisation" Rubrique="@Rubrique" />

    <div class="admin-contenu">
        <div class="titre-page titre-actions-cote">
            <div>
                <h1>Synchronisation · @NavAdmin.Libelle("admin/synchronisation", Rubrique)</h1>
                <p class="sous-titre">Copie des données de l’officine vers le serveur central, envoyée par l’officine environ chaque minute. Une coupure d’Internet n’a aucun effet sur le travail.</p>
            </div>
            <div class="actions">
                <button type="button" class="btn" disabled="@enCours" @onclick="ChargerAsync">Actualiser</button>
                @if (t is { Active: true, Activee: true })
                {
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnvoyerAsync">Synchroniser maintenant</button>
                }
            </div>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (t is not null && rubrique == "etat")
        {
            @if (t.BaseEnLectureSeule) { <div class="bandeau-attention" role="status">Base en lecture seule (2e serveur en veille) : seul le serveur principal envoie.</div> }
            @if (t.LotsAutresEpoques > 0) { <div class="bandeau-attention" role="status">@t.LotsAutresEpoques lot(s) d’une époque précédente jamais accusé(s) : à examiner avec l’éditeur (non renvoyés automatiquement).</div> }
            @if (t.DerniereErreur is { } de) { <div class="bandeau-attention" role="status">Dernière erreur@(t.DerniereErreurLe is { } dl ? $" ({Libelles.DateHeureLocale(dl)})" : "") : @de</div> }
            @* Bandeaux toujours visibles ; les deux panneaux dans un cadre défilant (hauteur posée par poste.js) : la page reste fixe même avec
               plusieurs bandeaux, un message ou une fenêtre basse (docs/charte-graphique.md, écran fixe) *@
            <div class="cadre-defilant" style="display: flex; flex-direction: column; gap: 20px">
            <section class="panneau" aria-labelledby="s-etat">
                <h2 id="s-etat">État</h2>
                <div class="achats-ligne ligne-lecture">
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Synchronisation</span>
                        <span class="pastille @(t.Active ? "ok" : "attention")">@(t.Active ? "activée" : "désactivée")</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Ce serveur</span>
                        <span class="pastille @(t.Activee ? "ok" : "attention")">@(t.Activee ? "activé (certificat)" : "non activé")</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Dernier envoi</span><span>@Date(t.DernierEnvoi)</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Dernier accusé</span><span>@(t.DernierAccuse > 0 ? $"lot {t.DernierAccuse} · {Date(t.DernierAccuseLe)}" : "aucun")</span></div>
                </div>
                <div class="achats-ligne ligne-lecture">
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">En attente</span><span>@t.LignesEnAttente opération(s) · @t.LotsEnAttente lot(s) non accusé(s)</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Lots constitués</span><span>@t.DernierLot (époque @t.Epoque, @t.VersionContrat)</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Certificat</span>
                        <span class="pastille @Echeance.Classe">@Echeance.Texte</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Code de l’officine</span><span class="detail">@(t.OfficineId ?? "—")</span></div>
                </div>
                <p class="detail" style="margin: 0">Rien n’est retiré de l’attente sans accusé du serveur central ; après une coupure, l’envoi reprend au premier lot non accusé. Le nom des patients n’est jamais envoyé (code à la place).</p>
            </section>
            <section class="panneau" aria-labelledby="s-chargement">
                <h2 id="s-chargement">Chargement complet</h2>
                <div class="achats-ligne ligne-lecture">
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Dernier chargement</span>
                        <span class="pastille @Chargement.Classe">@Chargement.Texte</span></div>
                    <div class="champ" style="flex: 2 1 320px"><span class="etiquette-champ">Progression</span><span>@Progression</span></div>
                    <div class="champ" style="flex: 0 0 auto; align-self: flex-end; flex-direction: row; gap: 8px">
                        @if (confirmerRecharge)
                        {
                            <span class="texte-urgent" style="align-self: center"><strong>Tout renvoyer au serveur central ?</strong></span>
                            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="RechargerAsync">Confirmer</button>
                            <button type="button" class="btn" disabled="@enCours" @onclick="() => confirmerRecharge = false">Annuler</button>
                        }
                        else
                        {
                            <button type="button" class="btn" disabled="@(enCours || !t.Active || !t.Activee || t.BaseEnLectureSeule || ChargementEnCours)" @onclick="() => confirmerRecharge = true">Recharger toutes les données</button>
                        }
                    </div>
                </div>
                <p class="detail" style="margin: 0">Renvoie l’état actuel de chaque donnée envoyée (mêmes codes et mêmes retraits que d’habitude), par lots, sans arrêter le travail ; les modifications faites pendant l’envoi suivent dans l’ordre. Le serveur central signale, sans les effacer, les données qu’il a et que l’officine n’a plus.</p>
            </section>
            </div>
        }

        @if (t is not null && rubrique == "reglages")
        {
            <section class="panneau" aria-labelledby="s-reglages">
                <h2 id="s-reglages">Réglages</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 2 1 360px"><label for="s-adresse">Adresse du serveur central</label>
                        <input id="s-adresse" data-champ="adresse" type="text" placeholder="https://serveur-central:5090" @bind="adresse" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 1 1 260px"><label for="s-textes">Textes libres (motifs, commentaires)</label>
                        <select id="s-textes" data-champ="textes_libres" @bind="textesLibres">
                            <option value="filtres">Envoyés filtrés (courriels, téléphones, n°, noms masqués)</option>
                            <option value="retires">Jamais envoyés</option>
                        </select></div>
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center">
                    <label class="case"><input type="checkbox" @bind="active" /><span>Synchronisation activée</span></label>
                    <label class="case"><input type="checkbox" @bind="envoyerMedecins" /><span>Envoyer les médecins (nom, spécialité, wilaya)</span></label>
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">Enregistrer</button>
                </div>
                <p class="detail" style="margin: 0">Désactivée, rien n’est inscrit ni envoyé. Activée sans activation de ce serveur, les modifications sont gardées en attente et partiront après l’activation.</p>
                <h3 style="margin: 12px 0 4px">Données nominatives envoyées (réglées par le serveur central)</h3>
                <ul data-zone="familles-envoyees" style="margin: 0; padding-left: 18px">
                    @foreach (var (cle, f) in Pharma.Shared.FamillesNominativesSync.Familles)
                    {
                        var envoyee = t.FamillesEnvoyees?.Contains(cle) == true;
                        <li data-famille="@cle">@(envoyee ? "✔ Envoyées" : "✘ Non envoyées") : @f.Libelle</li>
                    }
                </ul>
                <p class="detail" style="margin: 0">
                    <span data-zone="reglage-recu">@(t.FamillesLuesLe is { } lu ? $"Réglage reçu le {lu.ToLocalTime():dd/MM/yyyy HH:mm} (version {t.FamillesVersion})." : "Réglage jamais reçu : aucune donnée nominative n’est envoyée tant qu’il n’est pas connu.")</span>
                    Lecture seule : le réglage se fait au serveur central et descend par la synchronisation ; une donnée non envoyée ne quitte jamais l’officine.
                </p>
            </section>
        }

        @if (t is { Supervision: { } sv } && rubrique == "supervision")
        {
            @* Lot S3 : bandeau des postes, alertes au titulaire, purge de la file d'envoi. Deux panneaux dans un cadre défilant (page fixe). *@
            <div class="cadre-defilant" style="display: flex; flex-direction: column; gap: 20px">
            <section class="panneau" aria-labelledby="s-supervision">
                <h2 id="s-supervision">Bandeau des postes et alertes</h2>
                <div class="achats-ligne ligne-lecture">
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">En attente d’envoi</span>
                        <span data-zone="attente">@(sv.AttenteOperations == 0 ? "rien" : $"{sv.AttenteOperations} opération(s) depuis {Date(sv.AttenteDepuis)}")</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Erreur d’envoi</span>
                        <span data-zone="erreur-envoi">@(sv.ErreurDepuisLe is { } ed ? $"depuis {Date(ed)}{(sv.ErreurNature == "quota" ? " (quota refusé par le serveur central)" : "")}" : "aucune")</span></div>
                </div>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 200px"><label for="s-bandeau">Bandeau sur les postes après (minutes)</label>
                        <input id="s-bandeau" data-champ="bandeau_minutes" type="number" min="1" max="10080" @bind="bandeauMinutes" /></div>
                    <div class="champ" style="flex: 1 1 200px"><label for="s-retard">Alerte de retard après (heures)</label>
                        <input id="s-retard" data-champ="retard_heures" type="number" min="1" max="720" @bind="retardHeures" /></div>
                    <div class="champ" style="flex: 1 1 200px"><label for="s-erreur">Alerte d’erreur persistante après (minutes)</label>
                        <input id="s-erreur" data-champ="erreur_minutes" type="number" min="1" max="10080" @bind="erreurMinutes" /></div>
                </div>
                <p class="detail" style="margin: 0">Valeurs de départ : 60 min, 24 h, 60 min. Le bandeau « en attente depuis… » s’affiche au titulaire et aux rôles qui ont le droit « Voir le bandeau de synchronisation » (Droits par rôle), si la synchronisation est activée ; il ne bloque jamais.
                    Alertes (retard, erreur persistante, certificat à moins de 30 jours de l’échéance, quota refusé) par e-mail ou SMS aux destinataires abonnés à « Synchronisation » (Notifications), au plus une par heure et par sujet.</p>
            </section>
            <section class="panneau" aria-labelledby="s-purge">
                <h2 id="s-purge">Purge de la file d’envoi</h2>
                <div class="achats-ligne ligne-lecture">
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Dernière purge</span>
                        <span data-zone="derniere-purge">@(sv.Purge.DernierePurgeLe is { } dp ? $"{Date(dp)} · {sv.Purge.DernieresLignes} ligne(s)" : "jamais")</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Lots purgés</span>
                        <span data-zone="lots-purges">@(sv.Purge.DernierLotPurge > 0 ? $"jusqu’au lot {sv.Purge.DernierLotPurge} (époque {sv.Purge.EpoquePurge}) · {sv.Purge.TotalLignes} ligne(s) au total" : "aucun")</span></div>
                    <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">File gardée</span>
                        <span data-zone="file-gardee">@(sv.Purge.LignesGardees is { } lg ? $"environ {lg} ligne(s)" : "taille inconnue") · @Taille(sv.Purge.OctetsFile)</span></div>
                </div>
                @if (sv.Purge.DerniereErreur is { } pe) { <div class="bandeau-attention" role="status">Dernière purge en erreur : @pe</div> }
                <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end">
                    <label class="case"><input type="checkbox" data-champ="purge_active" @bind="purgeActive" /><span>Purger les lots accusés</span></label>
                    <div class="champ" style="flex: 0 1 260px"><label for="s-purge-jours">Conserver les lots accusés (jours)</label>
                        <input id="s-purge-jours" data-champ="purge_jours" type="number" min="1" max="365" @bind="purgeJours" /></div>
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerSupervisionAsync">Enregistrer</button>
                </div>
                <p class="detail" style="margin: 0">Valeur de départ : 30 jours. Seules les lignes de lots accusés sont retirées (jamais une ligne en attente ni celles d’un chargement en cours). Si le serveur central perd un lot après sa purge, il reçoit un rechargement complet, demandé automatiquement.</p>
            </section>
            </div>
        }

        @if (t is not null && rubrique == "integrite")
        {
            @* Lot S4 : vérification d'intégrité faite par le serveur central (résumé reçu par la voie descendante). Lecture seule, rien à corriger
               ici. Résumé compact (champs), puis le tableau des 20 dernières anomalies au plus (borné par le central) : seul ce tableau défile,
               hauteur ajustée par pharma.tableaux (page fixe). *@
            <div style="display: flex; flex-direction: column; gap: 16px" data-zone="integrite-centrale">
            @if (t.IntegriteCentrale is not { } ic)
            {
                <section class="panneau" aria-labelledby="s-integrite">
                    <h2 id="s-integrite">Vérification par le serveur central</h2>
                    <p class="detail" style="margin: 0" data-zone="integrite-absente">Aucune vérification reçue du serveur central : la synchronisation est désactivée, ou le serveur central n’a pas encore vérifié les données de l’officine.</p>
                </section>
            }
            else
            {
                <section class="panneau" aria-labelledby="s-integrite">
                    <h2 id="s-integrite">Vérification par le serveur central</h2>
                    <div class="achats-ligne ligne-lecture">
                        <div class="champ" style="flex: 1 1 160px"><span class="etiquette-champ">État</span>
                            <span><span class="pastille @ClasseIntegrite(ic.Statut)" data-zone="integrite-statut">@LibelleIntegrite(ic.Statut)</span></span></div>
                        <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Dernière vérification</span>
                            <span data-zone="integrite-verifiee">@Date(ic.VerifieLe)</span></div>
                        <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Dernière vérification complète</span>
                            <span>@Date(ic.CompleteLe)</span></div>
                        <div class="champ" style="flex: 1 1 200px"><span class="etiquette-champ">Sceaux</span>
                            <span data-zone="integrite-sceaux">@ic.SceauxOk ancré(s)@(ic.SceauxAttente > 0 ? $" · {ic.SceauxAttente} en attente" : "")@(ic.SceauxIncoherents > 0 ? $" · {ic.SceauxIncoherents} incohérent(s)" : "")</span></div>
                        <div class="champ" style="flex: 1 1 160px"><span class="etiquette-champ">Tickets vérifiés</span>
                            <span>@(ic.TicketsVerifiesJusquA is { } tv && tv > 0 ? $"jusqu’au n° {tv}" : "—")</span></div>
                    </div>
                    <div class="achats-ligne ligne-lecture">
                        @foreach (var c in ic.Chaines)
                        {
                            <div class="champ" style="flex: 1 1 320px" data-journal="@c.Journal"><span class="etiquette-champ">@LibelleJournal(c.Journal)@(c.Cle == "officine" ? "" : $" ({c.Cle})")</span>
                                <span><span class="pastille @ClasseIntegrite(c.Statut == "rupture" ? "anomalie" : c.Statut)">@LibelleChaine(c.Statut)</span>
                                    @c.DernierRang ligne(s) vérifiée(s) · @(c.Mode == "complet" ? "empreintes recalculées" : "rangs et chaînage")@(c.NonVerifiables > 0 ? $" · {c.NonVerifiables} au texte filtré" : "")</span></div>
                        }
                        @if (ic.Chaines.Count == 0) { <div class="champ"><span class="etiquette-champ">Journaux</span><span>aucun reçu pour l’instant</span></div> }
                    </div>
                    <p class="detail" style="margin: 0">Registre : noms des porteurs non envoyés, rangs et chaînage vérifiés. Motif filtré avant l’envoi : ligne comptée à part. Un manque : anomalie après 24 h.</p>
                </section>
                <section class="panneau" aria-labelledby="s-anomalies">
                    <h2 id="s-anomalies">Anomalies constatées (@ic.AnomaliesTotal)</h2>
                    <div class="tableau-cadre" data-zone="integrite-anomalies">
                        <table class="tableau" style="min-width: 0">
                            <thead><tr><th scope="col" class="nombre">N°</th><th scope="col">Constatée le</th><th scope="col">Nature</th><th scope="col">Journal</th><th scope="col">Rang ou pièce</th><th scope="col">Détail</th></tr></thead>
                            <tbody>
                                @foreach (var a in ic.Anomalies)
                                {
                                    <tr data-anomalie="@a.Id">
                                        <td class="nombre">@a.Id</td>
                                        <td>@Date(a.DetecteeLe)</td>
                                        <td class="nom">@a.Libelle</td>
                                        <td>@LibelleJournal(a.Journal)</td>
                                        <td>@(a.Rang is { } rg ? $"rang {rg}" : a.Ligne ?? "—")</td>
                                        <td class="detail">@(a.Detail ?? "—")</td>
                                    </tr>
                                }
                                @if (ic.Anomalies.Count == 0) { <tr><td colspan="6" class="vide">Aucune anomalie.</td></tr> }
                            </tbody>
                        </table>
                    </div>
                    <p class="detail" style="margin: 0">Les 20 plus récentes. Ne rien corriger, prévenir l’éditeur. Alerte à chaque nouvelle anomalie (abonnés à « Synchronisation »).</p>
                </section>
            }
            </div>
        }

        @if (t is not null && rubrique == "ordres")
        {
            @* Lots S5.1 et S5.5 : ordres envoyés par le serveur central. Liste paginée et filtrée (règle des listes) ; seul le tableau défile.
               Confirmation et refus réservés au titulaire (fenêtre) ; un ordre « à confirmer » ne change rien tant qu'il n'est pas confirmé. *@
            <div class="filtres-liste" role="search" aria-label="Filtrer les ordres du serveur central">
                <div class="champ" style="flex: 0 0 220px"><label for="or-statut">État</label>
                    <select id="or-statut" data-champ="statut" @bind="fStatut" @bind:after="PremierePageOrdresAsync">
                        <option value="">Tous</option>
                        <option value="a_confirmer">À confirmer</option>
                        <option value="a_appliquer">À appliquer</option>
                        <option value="applique">Appliqués</option>
                        <option value="refuse">Refusés</option>
                        <option value="expire">Expirés</option>
                        <option value="annule">Annulés</option>
                    </select></div>
                <p class="detail" style="margin: 0; align-self: center" data-zone="ordres-a-confirmer">@TexteAConfirmer</p>
            </div>
            <section class="tableau-cadre" aria-label="Ordres du serveur central" data-zone="ordres">
                <table class="tableau" style="min-width: 0">
                    <thead><tr><th scope="col">Reçu le</th><th scope="col">Ordre</th><th scope="col">Détail</th><th scope="col">Auteur</th><th scope="col">Expire le</th><th scope="col">État</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
                    <tbody>
                        @foreach (var o in ordres)
                        {
                            <tr data-ordre="@o.Id">
                                <td>@Date(o.RecuLe)</td>
                                <td class="nom">@o.Libelle</td>
                                <td>@o.Resume @if (o.Motif is { } mo) { <br /><span class="detail">@mo</span> }</td>
                                <td>@o.Auteur</td>
                                <td>@Date(o.ExpireLe)</td>
                                <td><span class="pastille @ClasseOrdre(o.Statut)">@LibelleOrdre(o.Statut)</span></td>
                                <td>
                                    @if (o.Statut == "a_confirmer" && EstTitulaire)
                                    {
                                        <div style="display: flex; gap: 8px">
                                            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => OuvrirConfirmation(o)">Confirmer</button>
                                            <button type="button" class="btn" disabled="@enCours" @onclick="() => OuvrirRefus(o)">Refuser</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        @if (ordres.Count == 0 && erreur is null) { <tr><td colspan="7" class="vide">Aucun ordre du serveur central pour ce filtre.</td></tr> }
                    </tbody>
                </table>
            </section>
            <Pagination Total="ordresTotal" Numero="ordresPage" Taille="ordresTaille" Libelle="Pages des ordres du serveur central" OnChange="p => ChargerOrdresAsync(p.Numero, p.Taille)" />
            <p class="detail" style="margin: 0">Le blocage d’un employé s’applique tout de suite ; création, modification, déblocage et droits attendent la confirmation du titulaire. Un ordre est refusé si la valeur a changé ici depuis son envoi, et expire après 7 jours.</p>
        }

        @if (ordreOuvert is { } oo)
        {
            <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-ordre">
                <section class="panneau" style="max-width: 620px; width: 100%">
                    <h2 id="t-ordre">@(action == "confirmer" ? "Confirmer" : "Refuser") : @oo.Libelle</h2>
                    <p style="margin: 0 0 4px">@oo.Resume</p>
                    <p class="detail" style="margin: 0 0 8px">Envoyé par @oo.Auteur le @Date(oo.CreeLe) ; expire le @Date(oo.ExpireLe).</p>
                    @if (erreurFenetre is not null) { <div class="erreur" role="alert">@erreurFenetre</div> }
                    @if (action == "confirmer" && oo.DemandeMotDePasse)
                    {
                        <div class="champ"><label for="or-mdp" class="requis">Mot de passe provisoire du nouvel employé</label>
                            <input id="or-mdp" data-champ="mot_de_passe" type="password" autocomplete="new-password" @bind="motDePasse" @bind:event="oninput" /></div>
                        <div class="champ"><label for="or-mdp2" class="requis">Mot de passe provisoire (confirmation)</label>
                            <input id="or-mdp2" type="password" autocomplete="new-password" aria-invalid="@(motDePasse2 != "" && motDePasse != motDePasse2 ? "true" : null)" @bind="motDePasse2" @bind:event="oninput" /></div>
                        <p class="detail" style="margin: 0">L’employé devra le changer à sa première connexion. Il n’est jamais envoyé au serveur central.</p>
                    }
                    @if (action == "refuser")
                    {
                        <div class="champ"><label for="or-motif" class="requis">Motif du refus (envoyé au serveur central)</label>
                            <input id="or-motif" data-champ="motif" type="text" maxlength="300" autocomplete="off" @bind="motifRefus" @bind:event="oninput" /></div>
                    }
                    <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 12px">
                        <button type="button" class="btn" disabled="@enCours" @onclick="Fermer">Annuler</button>
                        <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="ValiderOrdreAsync">@(action == "confirmer" ? "Confirmer et appliquer" : "Refuser l’ordre")</button>
                    </div>
                </section>
            </div>
        }

        @if (t is not null && rubrique == "reglages-mutualises")
        {
            @* Lot M7 : état des 11 tables de réglages que le serveur central peut fixer (imposé) ou proposer. Liste fermée de 11 lignes (bornée par nature), seul le cadre défile. *@
            <p class="detail" style="margin: 0">Réglages que le serveur central peut fixer pour toutes les officines (« fixé ») ou proposer (« proposé » : votre valeur est gardée tant que vous ne l’adoptez pas, depuis l’écran du réglage).
                @(t.Active ? "" : "La synchronisation est désactivée : tous les réglages sont modifiables ici, les valeurs du serveur central ne s’appliquent plus.")</p>
            <div class="tableau-cadre" data-zone="reglages-mutualises">
                <table class="tableau" style="min-width: 0">
                    <thead><tr><th scope="col">Réglage</th><th scope="col">Mode</th><th scope="col" class="nombre">Version reçue</th><th scope="col" class="nombre">Version appliquée</th><th scope="col">État</th><th scope="col">Reçu le</th><th scope="col">Motif du refus</th></tr></thead>
                    <tbody>
                        @foreach (var g in reglagesMutualises)
                        {
                            <tr data-table="@g.Table">
                                <td class="nom"><a href="@Ecran(g.Table)">@g.Libelle</a></td>
                                <td><span class="pastille @ClasseMode(g)">@LibelleMode(g)</span></td>
                                <td class="nombre">@(g.VersionRecue?.ToString() ?? "—")</td>
                                <td class="nombre">@(g.VersionAppliquee?.ToString() ?? "—")</td>
                                <td><span class="pastille @ClasseEtat(g.Etat)">@LibelleEtat(g.Etat)</span></td>
                                <td>@(g.RecuLe is { } rl ? Libelles.DateHeureLocale(rl) : "—")</td>
                                <td class="detail">@(g.MotifRejet ?? "—")</td>
                            </tr>
                        }
                        @if (reglagesMutualises.Count == 0) { <tr><td colspan="7" class="vide">@(erreur is null ? "Aucun réglage." : "Réglages illisibles.")</td></tr> }
                    </tbody>
                </table>
            </div>
        }

        @if (t is not null && rubrique == "activation")
        {
            <section class="panneau" aria-labelledby="s-activation">
                <h2 id="s-activation">Activer ce serveur</h2>
                <p class="detail" style="margin: 0">@(t.Activee ? $"Ce serveur est activé (certificat {t.EmpreinteCertificat}…, échéance {Date(t.EcheanceCertificat)}). Un nouveau code remplace le certificat." : "Saisissez le code d’activation remis par l’éditeur (usage unique, valable 24 h). Le 2e serveur de l’officine a son propre code.")</p>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 2 1 420px"><label for="s-code" class="requis">Code d’activation</label>
                        <input id="s-code" data-champ="code" type="text" autocomplete="off" placeholder="XXXXX-XXXXX-XXXXX-XXXXX.0123…" @bind="code" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 0 0 auto; align-self: flex-end"><button type="button" class="btn btn-principal" disabled="@(enCours || string.IsNullOrWhiteSpace(t.Adresse))" @onclick="ActiverAsync">Activer</button></div>
                </div>
                @if (string.IsNullOrWhiteSpace(t.Adresse)) { <p class="detail" style="margin: 0">Réglez d’abord l’adresse du serveur central (sous-rubrique Réglages).</p> }
                <p class="detail" style="margin: 0">La clé privée de ce serveur est créée ici et ne le quitte jamais ; le certificat est valable 3 ans et renouvelé automatiquement avant l’échéance.</p>
            </section>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => NavAdmin.RubriqueCourante("admin/synchronisation", Rubrique);

    private EtatSynchronisationDto? t;
    private bool active, envoyerMedecins;
    private string? adresse;
    private string textesLibres = "filtres";
    private int bandeauMinutes = 60, retardHeures = 24, erreurMinutes = 60, purgeJours = 30;
    private bool purgeActive = true;
    private string code = "";
    private bool enCours;
    private string? erreur, message;

    protected override Task OnInitializedAsync() => ChargerAsync();

    private List<ReglageMutualiseDto> reglagesMutualises = [];

    // Lot M7 : écran où se règle chacune des 11 tables
    private static string Ecran(string table) => table switch
    {
        "parametre_fiscal" => "admin/reglage-fiscal",
        "regle_alerte_psychotrope" => "admin/psychotropes",
        "parametre_tracabilite" => "admin/reglage-tracabilite",
        "parametre_serialisation" => "admin/serialisation",
        "parametre_substitution" => "achats?onglet=substitution",
        "motif_reglable" => "admin/motifs",
        "parametre_formulaire_sms" => "admin/notifications?rubrique=formulaire-sms",
        "parametre_surveillance" => "admin/controle-interne",
        "parametre_alerte" => "admin/seuils",
        "parametre_inventaire" => "inventaire?rubrique=seuils",
        _ => "stock?rubrique=remises"
    };

    private static string LibelleMode(ReglageMutualiseDto g) => g.Mode switch
    {
        "impose" => "Fixé par le serveur central",
        "propose" => "Proposé par le serveur central",
        _ => g.ModeRecu is "impose" or "propose" ? "Local (synchronisation désactivée)" : "Local"
    };

    private static string ClasseMode(ReglageMutualiseDto g) => g.Mode switch { "impose" => "attention", "propose" => "info", _ => "" };

    private static string LibelleEtat(string etat) => etat switch
    {
        "applique" => "Appliqué", "non_adopte" => "Non adopté", "rejete" => "Refusé", _ => "Aucun"
    };

    private static string ClasseEtat(string etat) => etat switch { "applique" => "ok", "non_adopte" => "info", "rejete" => "urgent", _ => "" };

    // Lu quand la sous-rubrique s'affiche (le lien du menu ne recrée pas l'écran), relu par « Actualiser »
    private string? reglagesCharges;

    protected override async Task OnParametersSetAsync()
    {
        if (rubrique != "ordres") ordresCharges = false;
        else if (!ordresCharges)
        {
            ordresCharges = true;
            Historique.Suivre("ordres-central", e => { e.Mettre("statut", fStatut); e.Mettre("page", ordresPage); e.Mettre("taille", ordresTaille); });
            if (Historique.Restaurer("ordres-central") is { } h)
                (fStatut, ordresPage, ordresTaille) = (h.Texte("statut") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? ordresTaille);
            await ChargerOrdresAsync(ordresPage, ordresTaille);
        }
        if (rubrique != "reglages-mutualises") { reglagesCharges = null; return; }
        if (reglagesCharges is null) await ChargerReglagesMutualisesAsync();
    }

    private async Task ChargerReglagesMutualisesAsync()
    {
        reglagesCharges = rubrique;
        var (liste, el) = await Api.ReglagesMutualisesAsync();
        reglagesMutualises = liste;
        erreur = el;
    }

    private async Task ChargerAsync()
    {
        if (rubrique == "reglages-mutualises") await ChargerReglagesMutualisesAsync();
        if (rubrique == "ordres") await ChargerOrdresAsync(ordresPage, ordresTaille);
        var (d, e) = await Api.SynchronisationAsync();
        if (d is null) { erreur = e; return; }
        (t, active, adresse, textesLibres, envoyerMedecins, erreur) = (d, d.Active, d.Adresse, d.TextesLibres, d.EnvoyerMedecins, null);
        if (d.Supervision is { } s) (bandeauMinutes, retardHeures, erreurMinutes, purgeActive, purgeJours) = (s.BandeauMinutes, s.RetardHeures, s.ErreurMinutes, s.PurgeActive, s.PurgeJours);
    }

    private static string Taille(long octets) => octets switch
    {
        >= 1_073_741_824 => $"{octets / 1_073_741_824.0:0.#} Go",
        >= 1_048_576 => $"{octets / 1_048_576.0:0.#} Mo",
        _ => $"{Math.Max(1, octets / 1024)} Ko"
    };

    private Task EnregistrerSupervisionAsync() => Executer(async () =>
    {
        var e = await Api.ReglerSupervisionSynchronisationAsync(new ReglagesSupervisionSynchronisationDto(bandeauMinutes, retardHeures, erreurMinutes, purgeActive, purgeJours));
        if (e is not null) return e;
        message = "Réglages de supervision et de purge enregistrés.";
        await ChargerAsync();
        return null;
    });

    private static string Date(DateTime? d) => d is { } v ? Libelles.DateHeureLocale(v) : "jamais";

    // Lots S5.1 et S5.5 : ordres du serveur central
    private List<OrdreCentralDto> ordres = [];
    private int ordresTotal, ordresPage = 1, ordresTaille = Pagination.TailleParDefaut, aConfirmer;
    private string fStatut = "";
    private bool ordresCharges;
    private OrdreCentralDto? ordreOuvert;
    private string action = "", motDePasse = "", motDePasse2 = "", motifRefus = "";
    private string? erreurFenetre;
    private bool EstTitulaire => Session.A("role.titulaire");
    private string TexteAConfirmer => aConfirmer == 0 ? "Aucun ordre n’attend de confirmation."
        : $"{aConfirmer} ordre(s) à confirmer{(EstTitulaire ? "" : " par le titulaire")}.";

    private Task PremierePageOrdresAsync() => ChargerOrdresAsync(1, ordresTaille);

    private async Task ChargerOrdresAsync(int page, int taille)
    {
        (ordresPage, ordresTaille) = (page, taille);
        var (p, e) = await Api.OrdresCentrauxAsync(fStatut == "" ? null : fStatut, page, taille);
        if (p is null) { erreur = e; return; }
        (ordres, ordresTotal, aConfirmer) = (p.Page.Lignes.ToList(), p.Page.Total, p.AConfirmer);
    }

    private void OuvrirConfirmation(OrdreCentralDto o) => Ouvrir(o, "confirmer");
    private void OuvrirRefus(OrdreCentralDto o) => Ouvrir(o, "refuser");
    private void Ouvrir(OrdreCentralDto o, string quoi) => (ordreOuvert, action, motDePasse, motDePasse2, motifRefus, erreurFenetre) = (o, quoi, "", "", "", null);
    private void Fermer() => (ordreOuvert, motDePasse, motDePasse2, erreurFenetre) = (null, "", "", null);

    private async Task ValiderOrdreAsync()
    {
        if (ordreOuvert is not { } o) return;
        if (action == "confirmer" && o.DemandeMotDePasse && motDePasse != motDePasse2) { erreurFenetre = "Les deux mots de passe sont différents."; return; }
        enCours = true;
        try
        {
            var e = action == "confirmer" ? await Api.ConfirmerOrdreCentralAsync(o.Id, o.DemandeMotDePasse ? motDePasse : null)
                                          : await Api.RefuserOrdreCentralAsync(o.Id, motifRefus);
            if (e is not null) { erreurFenetre = e; await ChargerOrdresAsync(ordresPage, ordresTaille); return; }
            message = action == "confirmer" ? "Ordre confirmé et appliqué." : "Ordre refusé ; le refus est envoyé au serveur central.";
            Fermer();
            await ChargerOrdresAsync(ordresPage, ordresTaille);
        }
        finally { enCours = false; }
    }

    private static string LibelleOrdre(string statut) => statut switch
    {
        "a_confirmer" => "À confirmer", "a_appliquer" => "À appliquer", "applique" => "Appliqué", "refuse" => "Refusé",
        "expire" => "Expiré", "annule" => "Annulé", _ => statut
    };

    private static string ClasseOrdre(string statut) => statut switch
    {
        "a_confirmer" => "attention", "a_appliquer" => "info", "applique" => "ok", "refuse" => "urgent", _ => ""
    };

    // Lot S4 : intégrité au central
    private static string ClasseIntegrite(string statut) => statut switch { "ok" => "ok", "attente" => "info", "anomalie" => "urgent", _ => "" };
    private static string LibelleIntegrite(string statut) => statut switch { "ok" => "Aucune anomalie", "attente" => "En attente de données", "anomalie" => "Anomalie", _ => statut };
    private static string LibelleChaine(string statut) => statut switch { "ok" => "Intacte", "attente" => "En attente", "rupture" => "Rompue", _ => statut };
    private static string LibelleJournal(string journal) => journal switch
    {
        "journal_vente" => "Journal des ventes",
        "journal_registre_psychotrope" => "Registre des psychotropes",
        "sceau_integrite" => "Sceaux",
        _ => journal
    };

    private (string Classe, string Texte) Echeance => t?.EcheanceCertificat switch
    {
        null => ("attention", "aucun"),
        { } e when e <= DateTime.UtcNow => ("urgent", $"échu le {e.ToLocalTime():dd/MM/yyyy}"),
        { } e when e <= DateTime.UtcNow.AddDays(60) => ("attention", $"échéance {e.ToLocalTime():dd/MM/yyyy}"),
        { } e => ("ok", $"valable jusqu’au {e.ToLocalTime():dd/MM/yyyy}")
    };

    // Lot S6 : chargement complet (activation, demande, réactivation, lots manquants au serveur central)
    private bool confirmerRecharge;
    private ChargementSynchronisationDto? C => t?.Chargement;
    private bool ChargementEnCours => C is { Etat: "demande" or "constitution" or "pret" or "annonce" };

    private static string Motif(string m) => m switch
    {
        "activation" => "activation",
        "demande" => "demande",
        "reactivation" => "réactivation",
        "lots_manquants" => "lots perdus par le serveur central",
        _ => m
    };

    private (string Classe, string Texte) Chargement => C switch
    {
        null => ("attention", "aucun"),
        { Etat: "termine", AbsentesCentral: > 0 } c => ("attention", $"n° {c.Numero} terminé le {Date(c.TermineLe)} · {c.AbsentesCentral} donnée(s) absente(s) ici signalée(s)"),
        { Etat: "termine" } c => ("ok", $"n° {c.Numero} terminé le {Date(c.TermineLe)}"),
        { Etat: "remplace" } c => ("attention", $"n° {c.Numero} remplacé"),
        { } c => ("attention", $"n° {c.Numero} en cours ({Motif(c.Motif)})")
    };

    private string Progression => C switch
    {
        null => "—",
        { Etat: "demande" } => "en attente du prochain passage d’envoi",
        { Etat: "constitution", TablesTotal: > 0 } c => $"préparation : {c.TablesFaites} / {c.TablesTotal} tables",
        { Etat: "constitution" } => "préparation de l’instantané",
        { } c when c.LignesTotal == 0 => c.Etat == "termine" ? "aucune donnée à envoyer" : "annonce au serveur central",
        { } c => $"{c.LignesAccusees} / {c.LignesTotal} lignes accusées ({100 * c.LignesAccusees / c.LignesTotal} %)"
    };

    private Task RechargerAsync() => Executer(async () =>
    {
        confirmerRecharge = false;
        var e = await Api.RechargerSynchronisationAsync();
        if (e is not null) return e;
        message = "Rechargement complet demandé : il part au prochain passage d’envoi (« Synchroniser maintenant » pour le lancer tout de suite).";
        await ChargerAsync();
        return null;
    });

    private Task EnregistrerAsync() => Executer(async () =>
    {
        var e = await Api.ReglerSynchronisationAsync(new ReglagesSynchronisationDto(active, adresse, textesLibres, envoyerMedecins));
        if (e is not null) return e;
        message = "Réglages de synchronisation enregistrés.";
        await ChargerAsync();
        return null;
    });

    private Task ActiverAsync() => Executer(async () =>
    {
        var e = await Api.ActiverSynchronisationAsync(code);
        if (e is not null) return e;
        code = "";
        message = "Ce serveur est activé auprès du serveur central.";
        await ChargerAsync();
        return null;
    });

    private Task EnvoyerAsync() => Executer(async () =>
    {
        var (r, e) = await Api.EnvoyerSynchronisationAsync();
        if (r is null) return e;
        message = r.Erreur is null ? (r.Arret ?? $"{r.LotsAccuses} lot(s) accusé(s) par le serveur central.") : null;
        await ChargerAsync();
        return r.Erreur;
    });

    private async Task Executer(Func<Task<string?>> action)
    {
        (enCours, erreur, message) = (true, null, null);
        try { erreur = await action(); }
        finally { enCours = false; }
    }
}
