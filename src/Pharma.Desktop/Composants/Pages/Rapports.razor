@page "/rapports"
@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique

@* Écran fixe : une rubrique à la fois, menu vertical à gauche (docs/charte-graphique.md) ; la rubrique est dans l'adresse
   (rapports?rubrique=…). La période choisie reste la même d'une rubrique à l'autre. *@
<div class="page avec-menu">
    <NavDomaine Libelle="Rubriques des rapports">
        @foreach (var x in Rubriques)
        {
            if (x.Groupe is { } g)
            {
                <span class="nav-groupe-titre">@g</span>
            }
            else
            {
                var nombre = Compteur(x.Id);
                <a href="@($"rapports?rubrique={x.Id}")" class="sous-rubrique @(x.Id == rubrique ? "active" : null)" aria-current="@(x.Id == rubrique ? "page" : null)">
                    @x.Libelle@if (nombre > 0) { <span class="compteur neutre">@nombre</span> }
                </a>
            }
        }
    </NavDomaine>

    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>Rapports · @Courante.Libelle<AideEcran Cle="rapports" /></h1>
            <p class="sous-titre">@(rapport?.Libelle ?? "Chargement…")</p>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            <button type="button" class="btn" disabled="@(rapport is null || enCours)" @onclick='() => ExporterAsync("pdf")'>Exporter en PDF</button>
            <button type="button" class="btn" disabled="@(rapport is null || enCours)" @onclick='() => ExporterAsync("excel")'>Exporter pour Excel</button>
        </div>
    </div>

    <div class="rapport-filtres">
        <div class="filtres" role="group" aria-label="Période">
            @foreach (var (code, libelle) in Periodes)
            {
                <button type="button" class="puce" aria-pressed="@(periode == code ? "true" : "false")" @onclick="() => ChoisirAsync(code)">@libelle</button>
            }
        </div>
        @if (periode == "dates")
        {
            <div class="filtres dates-rapport" role="group" aria-label="Dates choisies">
                <label for="rapport-du">Du</label>
                <input id="rapport-du" type="date" max="@Aujourdhui.ToString("yyyy-MM-dd")" @bind="du" @bind:after="ChargerAsync" />
                <label for="rapport-au">au</label>
                <input id="rapport-au" type="date" max="@Aujourdhui.ToString("yyyy-MM-dd")" @bind="au" @bind:after="ChargerAsync" />
            </div>
        }
        else
        {
            <div class="filtres dates-rapport" role="group" aria-label="Aller à une date">
                <label for="rapport-date">Aller au</label>
                <input id="rapport-date" type="date" max="@Aujourdhui.ToString("yyyy-MM-dd")" @bind="reference" @bind:after="ChargerAsync" />
            </div>
        }
        <div class="filtres" role="group" aria-label="Changer de période">
            <button type="button" class="puce" disabled="@(rapport is null)" @onclick="() => DeplacerAsync(-1)" aria-label="Période précédente">‹ Précédent</button>
            <button type="button" class="puce" @onclick="AujourdhuiAsync">Aujourd’hui</button>
            <button type="button" class="puce" disabled="@(rapport is null || rapport.Au >= Aujourdhui)" @onclick="() => DeplacerAsync(+1)" aria-label="Période suivante">Suivant ›</button>
        </div>
    </div>

    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }

    @if (rapport is { } r)
    {
        @if (rubrique == "synthese")
        {
        <div class="tuiles">
            <div class="tuile">
                <span class="tuile-libelle">Chiffre d’affaires</span>
                <span class="tuile-valeur">@Libelles.Dinars(r.Synthese.ChiffreAffaires)</span>
                <span class="tuile-pied">@r.Synthese.NombreVentes vente(s) · remises @Libelles.Dinars(r.Synthese.Remises)</span>
                @if (r.Synthese.VentesAutres > 0)
                {
                    <span class="tuile-pied">médicaments @Libelles.Dinars(r.Synthese.VentesMedicaments) · autres produits @Libelles.Dinars(r.Synthese.VentesAutres)</span>
                }
                @if (r.Synthese.Shp > 0)
                {
                    <span class="tuile-pied">dont SHP @Libelles.Dinars(r.Synthese.Shp, 2)</span>
                }
                @if (r.Synthese.Retours > 0)
                {
                    <span class="tuile-pied" title="Un retour client diminue le chiffre du jour où il est enregistré">dont @r.Synthese.Retours retour(s) client : − @Libelles.Dinars(r.Synthese.MontantRetours, 2)</span>
                }
            </div>
            <div class="tuile">
                <span class="tuile-libelle">Part Chifa à recevoir</span>
                <span class="tuile-valeur">@Libelles.Dinars(r.Synthese.PartOrganismes)</span>
                <span class="tuile-pied">tiers payant (CNAS, CASNOS)</span>
            </div>
            <div class="tuile">
                <span class="tuile-libelle">Crédits clients accordés</span>
                <span class="tuile-valeur">@Libelles.Dinars(r.Synthese.CreditsAccordes)</span>
                <span class="tuile-pied">@r.Synthese.Annulations vente(s) annulée(s)</span>
            </div>
            @if (r.Marge is { } m)
            {
                <div class="tuile">
                    <span class="tuile-libelle">Marge brute</span>
                    <span class="tuile-valeur">@Libelles.Dinars(m.Montant)</span>
                    <span class="tuile-pied">@(m.Taux is { } t ? $"{t:0.0} % du CA HT" : "pas de vente") · coût @Libelles.Dinars(m.CoutAchat)</span>
                </div>
            }
            @if (r.Sorties is { } so)
            {
                <div class="tuile">
                    <span class="tuile-libelle">Pertes et dons</span>
                    <span class="tuile-valeur">@(so.Total.Valeur is { } vs ? Libelles.Dinars(vs) : $"{so.Total.Boites} boîte(s)")</span>
                    <span class="tuile-pied">@so.Total.Perimes périmée(s) · @so.Total.Casses cassée(s) · @so.Total.Dons donnée(s)@(so.Total.Valeur is null ? "" : " · au prix d’achat HT")</span>
                </div>
            }
            @if (r.ApresSorties is { } a)
            {
                <div class="tuile" title="Marge brute moins la valeur d’achat HT des boîtes périmées, cassées ou données, moins la TVA à reverser sur ces boîtes">
                    <span class="tuile-libelle">Marge après pertes et dons</span>
                    <span class="tuile-valeur">@Libelles.Dinars(a.Montant)</span>
                    <span class="tuile-pied">marge brute @Libelles.Dinars(a.MargeBrute) − pertes et dons @Libelles.Dinars(a.PertesHt, 2)</span>
                    <span class="tuile-pied">− TVA à reverser @Libelles.Dinars(a.TvaAReverser, 2)@(r.Tva is { Perime: false, Casse: false, Don: false } ? " (aucun motif réglé)" : "")</span>
                </div>
            }
        </div>
        <p class="pied-page">
            Ventes validées seulement, remises déduites. Marge brute : chiffre d’affaires hors TVA moins le coût d’achat HT des boîtes vendues,
            au prix réel de chaque boîte identifiée, sinon au prix de son lot. Marge après pertes et dons : marge brute moins la valeur d’achat HT
            des boîtes périmées, cassées ou données, moins la TVA à reverser sur ces boîtes selon le réglage de la rubrique « TVA à reverser ».
        </p>
        }

        @if (rubrique == "ventes")
        {
        <div class="rapport-colonnes">
            @if (r.ParJour.Count <= 1)
            {
                <section class="panneau"><h2>Ventes par jour</h2><p class="vide">Période d’un seul jour : choisissez la semaine ou le mois pour voir l’évolution.</p></section>
            }
            @if (r.ParJour.Count > 1)
            {
                var max = Math.Max(1m, r.ParJour.Max(j => j.ChiffreAffaires));
                <section class="panneau" aria-labelledby="t-jours">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px">
                        <h2 id="t-jours">@(r.ParSemaine ? "Ventes par semaine" : "Ventes par jour")</h2>
                        <button type="button" class="lien" @onclick="() => tableauJours = !tableauJours">@(tableauJours ? "Voir le graphique" : "Voir en tableau")</button>
                    </div>
                    @if (tableauJours)
                    {
                        <div class="tableau-cadre">
                        <table class="tableau" style="min-width: 0">
                            <thead><tr><th scope="col">@(r.ParSemaine ? "Semaine du" : "Jour")</th><th scope="col">Ventes</th><th scope="col">Chiffre d’affaires</th></tr></thead>
                            <tbody>
                                @foreach (var j in r.ParJour)
                                {
                                    <tr><td>@Jour(j.Date, true)</td><td>@j.NombreVentes</td><td>@Libelles.Dinars(j.ChiffreAffaires)</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <div class="histogramme" role="img" aria-label="@($"Chiffre d’affaires par {(r.ParSemaine ? "semaine" : "jour")}, maximum {Libelles.Dinars(max)}. Le détail est disponible en tableau.")">
                            <div class="histogramme-echelle" aria-hidden="true"><span>@Libelles.Dinars(max)</span><span>0</span></div>
                            <div class="histogramme-barres" style="--colonnes: @r.ParJour.Count">
                                @foreach (var j in r.ParJour)
                                {
                                    <div class="histogramme-colonne" title="@($"{Jour(j.Date, true)} : {Libelles.Dinars(j.ChiffreAffaires)}, {j.NombreVentes} vente(s)")">
                                        <div class="histogramme-zone">
                                            <div class="histogramme-barre" style="height: @Pourcent(j.ChiffreAffaires, max)"></div>
                                        </div>
                                        <span class="histogramme-jour">@Jour(j.Date, false)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>
            }

            <section class="panneau" aria-labelledby="t-top">
                <h2 id="t-top">Produits les plus vendus</h2>
                @if (r.TopProduits.Count == 0)
                {
                    <p class="vide">Aucune vente sur la période.</p>
                }
                else
                {
                    var maxQ = r.TopProduits.Max(p => p.Quantite);
                    <ol class="classement">
                        @foreach (var p in r.TopProduits)
                        {
                            <li title="@($"{p.Produit} : {p.Quantite} boîte(s), {Libelles.Dinars(p.ChiffreAffaires)}")">
                                <span class="classement-nom">@p.Produit</span>
                                <span class="classement-piste"><span class="classement-barre" style="width: @Pourcent(p.Quantite, maxQ)"></span></span>
                                <span class="classement-valeur">@p.Quantite</span>
                            </li>
                        }
                    </ol>
                    <p class="detail" style="margin: 0">Nombre de boîtes vendues.</p>
                }
            </section>
        </div>
        }

        @if (rubrique == "clotures")
        {
        <section class="panneau" aria-labelledby="t-clo">
            <h2 id="t-clo">Clôtures de caisse</h2>
            @* Paginées et filtrées par le serveur ; listes préremplies avec les employés et postes de la période *@
            <div class="filtres-liste" role="search" aria-label="Filtrer les clôtures">
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 220px"><label for="clo-employe">Employé</label>
                        <select id="clo-employe" data-champ="employe" @bind="clotEmploye" @bind:after="FiltrerCloturesAsync">
                            <option value="">Tous</option>
                            @foreach (var e in clotures?.Employes ?? []) { <option value="@e">@e</option> }
                        </select></div>
                    <div class="champ" style="flex: 0 0 180px"><label for="clo-poste">Poste</label>
                        <select id="clo-poste" data-champ="poste" @bind="clotPoste" @bind:after="FiltrerCloturesAsync">
                            <option value="">Tous</option>
                            @foreach (var p in clotures?.Postes ?? []) { <option value="@p">@p</option> }
                        </select></div>
                    @if (clotures?.EcartsVisibles == true)
                    {
                        <label class="case" style="align-self: end"><input type="checkbox" @bind="clotEcart" @bind:after="FiltrerCloturesAsync" /><span>Avec un écart seulement</span></label>
                    }
                    @if (FiltreCloturesActif) { <button type="button" class="btn" style="align-self: end" @onclick="ToutesLesCloturesAsync">Tout afficher</button> }
                </div>
            </div>
            <div class="tableau-cadre">
                <table class="tableau" style="min-width: 0">
                    <thead>
                        <tr>
                            <th scope="col">Employé</th><th scope="col">Session</th>
                            @if (r.EcartsVisibles) { <th scope="col">Attendu</th> }
                            <th scope="col">Compté</th>
                            @if (r.EcartsVisibles) { <th scope="col">Écart</th> }
                            <th scope="col">Annulations</th><th scope="col">Remises</th><th scope="col">Retours</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in clotures?.Page.Lignes ?? [])
                        {
                            <tr>
                                <td class="nom"><LienContact Type="employe" Id="c.EmployeId" Nom="@c.Employe" /><br /><span class="detail">@c.Poste</span></td>
                                <td>@Libelles.DateHeureLocale(c.OuverteLe)<br /><span class="detail">clôturée @(c.FermeeLe is { } f ? Libelles.DateHeureLocale(f) : "—")</span></td>
                                @if (r.EcartsVisibles) { <td>@Libelles.Dinars(c.Attendu ?? 0)</td> }
                                <td>@Libelles.Dinars(c.Compte ?? 0)</td>
                                @if (r.EcartsVisibles)
                                {
                                    <td class="@((c.Ecart ?? 0) < 0 ? "texte-urgent" : null)"><strong>@Signe(c.Ecart ?? 0)</strong></td>
                                }
                                <td>@c.Annulations</td>
                                <td>@c.Remises</td>
                                <td>@c.Retours</td>
                            </tr>
                        }
                        @if ((clotures?.Page.Total ?? 0) == 0)
                        {
                            <tr><td colspan="@(r.EcartsVisibles ? 8 : 6)" class="vide">@(FiltreCloturesActif ? "Aucune clôture pour ces filtres." : "Aucune clôture de caisse sur la période.")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pagination Total="clotures?.Page.Total ?? 0" Numero="clotPage" Taille="clotTaille" Libelle="Pages des clôtures" OnChange="p => ChargerCloturesAsync(p.Numero, p.Taille)" />
            @if (!r.EcartsVisibles)
            {
                <p class="detail" style="margin: 0">L’attendu et l’écart sont réservés au droit « Voir les écarts de caisse ».</p>
            }
        </section>
        }

        @if (rubrique == "retours")
        {
            var retours = r.Retours ?? [];
            <section class="panneau" aria-labelledby="t-retours">
                <h2 id="t-retours">Retours clients</h2>
                <p class="detail" style="margin: 0 0 8px">Un retour diminue le chiffre du jour où il est enregistré. La recette du jour de la vente ne change pas : le retour y figure pour information.</p>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 760px">
                        <thead><tr><th scope="col">Vente</th><th scope="col">Produits rendus</th><th scope="col">Retour</th><th scope="col">Montant</th><th scope="col">Effet sur le chiffre</th></tr></thead>
                        <tbody>
                            @foreach (var x in retours.Skip((pageRetours - 1) * tailleRetours).Take(tailleRetours))
                            {
                                <tr>
                                    <td class="nom">@x.Ticket<br /><span class="detail">@Libelles.DateHeureLocale(x.DateVente) · vendu par <LienContact Type="employe" Id="x.VendeurId" Nom="@x.Vendeur" /></span></td>
                                    <td>@x.Produits</td>
                                    <td>@Libelles.DateHeureLocale(x.DateRetour)<br /><span class="detail">@x.Poste · enregistré par <LienContact Type="employe" Id="x.EmployeId" Nom="@x.Employe" /></span></td>
                                    <td><strong>− @Libelles.Dinars(x.Montant, 2)</strong>@if (x.DetteDiminuee > 0){<br /><span class="detail">dont @Libelles.Dinars(x.DetteDiminuee, 2) déduits de la dette du patient</span>}</td>
                                    <td>
                                        @if (x.DeduitDansLaPeriode) { <span class="pastille attention">Déduit sur cette période</span> }
                                        else { <span class="pastille info" title="La recette de cette période ne change pas">Déduit le @Libelles.DateLocale(x.DateRetour), pas sur cette période</span> }
                                    </td>
                                </tr>
                            }
                            @if (retours.Count == 0)
                            {
                                <tr><td colspan="5" class="vide">Aucun retour client sur la période.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="retours.Count" Numero="pageRetours" Taille="tailleRetours" Libelle="Pages des retours clients" OnChange="p => (pageRetours, tailleRetours) = (p.Numero, p.Taille)" />
            </section>
        }

        @if (r.Sorties is { } sorties && rubrique is "pertes" or "pertes-detail")
        {
            var valeur = sorties.Total.Valeur is not null;
            <section class="panneau" aria-labelledby="t-sorties">
                <h2 id="t-sorties" class="visuellement-cache">Sorties de stock sans vente</h2>
                <p class="detail" style="margin: 0 0 8px">Boîtes périmées, cassées, données ou remises en échantillon pendant la période@(valeur ? ", au prix d’achat HT retenu le jour de la sortie" : "").
                    Ce ne sont pas des mouvements d’argent : elles n’apparaissent pas en trésorerie.</p>
                @if (rubrique == "pertes")
                {
                <div class="rapport-colonnes">
                    @foreach (var (id, titre, totaux) in new[] { ("t-sorties-employes", "Par employé", sorties.ParEmploye), ("t-sorties-produits", "Par produit", sorties.ParProduit) })
                    {
                        <div>
                            <h3 id="@id">@titre</h3>
                            <div class="tableau-cadre">
                                <table class="tableau" style="min-width: 0" aria-labelledby="@id">
                                    <thead><tr><th scope="col">@(titre == "Par employé" ? "Employé" : "Produit")</th><th scope="col">Périmés</th><th scope="col">Casses</th><th scope="col">Dons</th>@if (valeur) { <th scope="col">Valeur HT</th> }</tr></thead>
                                    <tbody>
                                        @foreach (var t in totaux)
                                        {
                                            <tr><td class="nom">@t.Cle</td><td>@t.Perimes</td><td>@t.Casses</td><td>@t.Dons</td>@if (valeur) { <td>@Libelles.Dinars(t.Valeur ?? 0, 2)</td> }</tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
                }
                else
                {
                <h3 id="t-sorties-detail" class="visuellement-cache">Détail</h3>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 760px" aria-labelledby="t-sorties-detail">
                        <thead><tr><th scope="col">Date</th><th scope="col">Produit</th><th scope="col">Motif</th><th scope="col">Boîtes</th>@if (valeur) { <th scope="col">Valeur HT</th> }<th scope="col">Employé et raison</th></tr></thead>
                        <tbody>
                            @foreach (var s in sorties.Detail.Skip((pageSorties - 1) * tailleSorties).Take(tailleSorties))
                            {
                                <tr>
                                    <td>@Libelles.DateHeureLocale(s.Date)</td>
                                    <td class="nom">@s.Produit<br /><span class="detail">lot @s.Lot</span></td>
                                    <td><span class="pastille @(s.Motif == "echantillon" ? "info" : "attention")">@MotifSortie(s.Motif)</span></td>
                                    <td>@s.Quantite</td>
                                    @if (valeur) { <td>@Libelles.Dinars(s.Valeur ?? 0, 2)</td> }
                                    <td><LienContact Type="employe" Id="s.EmployeId" Nom="@s.Employe" />@if (!string.IsNullOrWhiteSpace(s.Reference)) {<br /><span class="detail">@s.Reference</span>}</td>
                                </tr>
                            }
                            @if (sorties.Detail.Count == 0)
                            {
                                <tr><td colspan="@(valeur ? 6 : 5)" class="vide">Aucune sortie sans vente sur la période.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="sorties.Detail.Count" Numero="pageSorties" Taille="tailleSorties" Libelle="Pages des sorties" OnChange="p => (pageSorties, tailleSorties) = (p.Numero, p.Taille)" />
                }
                @if (!valeur)
                {
                    <p class="detail" style="margin: 0">La valeur d’achat est réservée au droit « Voir les prix d’achat et les marges ».</p>
                }
            </section>
        }

        @if (r.ApresSorties is not null && r.Tva is not null && rubrique == "tva")
        {
            var titulaire = Session.A("role.titulaire");
            <section class="panneau" aria-labelledby="t-tva-sorties">
                <h2 id="t-tva-sorties">TVA à reverser sur les pertes et dons</h2>
                <p class="detail" style="margin: 0 0 8px">
                    Pour chaque motif, la TVA payée à l’achat de la boîte est-elle à reverser ? Réglez-le selon l’avis de votre comptable.
                    Elle est alors retirée de la marge après pertes et dons (prix d’achat HT × taux de TVA du produit ; 0 pour un produit sans TVA).
                </p>
                <div class="filtres" role="group" aria-label="Motifs dont la TVA est reversée">
                    <label class="case"><input type="checkbox" checked="@tvaPerime" disabled="@(!titulaire || enCours)" @onchange="e => tvaPerime = (bool)e.Value!" /><span>Périmés détruits</span></label>
                    <label class="case"><input type="checkbox" checked="@tvaCasse" disabled="@(!titulaire || enCours)" @onchange="e => tvaCasse = (bool)e.Value!" /><span>Casses</span></label>
                    <label class="case"><input type="checkbox" checked="@tvaDon" disabled="@(!titulaire || enCours)" @onchange="e => tvaDon = (bool)e.Value!" /><span>Dons et échantillons</span></label>
                    @if (titulaire)
                    {
                        <button type="button" class="btn" disabled="@(enCours || (tvaPerime, tvaCasse, tvaDon) == (r.Tva.Perime, r.Tva.Casse, r.Tva.Don))" @onclick="EnregistrerTvaAsync">Enregistrer</button>
                    }
                </div>
                @if (!titulaire)
                {
                    <p class="detail" style="margin: 0">Réglage réservé au titulaire.</p>
                }
            </section>
        }
    }
    else if (erreur is null) { <Chargement Texte="Calcul du rapport…" /> }
    </div>
</div>

@code {
    /// <summary>Rubriques du menu vertical, dans l'ordre ; Groupe : titre de groupe. Pertes et dons : seulement si le rapport les contient (droit).</summary>
    private sealed record RubriqueRapport(string Id, string Libelle, string? Groupe = null);
    private RubriqueRapport[] Rubriques =>
    [
        new("", "", "Activité"),
        new("synthese", "Synthèse"),
        new("ventes", "Ventes"),
        new("clotures", "Clôtures de caisse"),
        new("retours", "Retours clients"),
        .. rapport?.Sorties is null ? Array.Empty<RubriqueRapport>() :
        [
            new("", "", "Pertes et dons"),
            new("pertes", "Récapitulatif"),
            new("pertes-detail", "Détail des sorties"),
            .. rapport.ApresSorties is not null && rapport.Tva is not null ? [new RubriqueRapport("tva", "TVA à reverser")] : Array.Empty<RubriqueRapport>()
        ]
    ];

    /// <summary>Rubrique demandée dans l'adresse (rapports?rubrique=…) ; inconnue ou non permise : la synthèse.</summary>
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique = "synthese";
    // Pertes et dons demandées dans l'adresse : leur titre s'affiche déjà pendant le calcul du rapport (le menu attend le rapport, qui dit le droit)
    private static readonly Dictionary<string, string> LibellesPertes = new() { ["pertes"] = "Récapitulatif", ["pertes-detail"] = "Détail des sorties", ["tva"] = "TVA à reverser" };
    private RubriqueRapport Courante => Rubriques.FirstOrDefault(x => x.Groupe is null && x.Id == rubrique)
        ?? (LibellesPertes.TryGetValue(rubrique, out var l) ? new RubriqueRapport(rubrique, l) : Rubriques[1]);
    protected override void OnParametersSet() => ChoisirRubrique();
    private void ChoisirRubrique() => rubrique = Rubrique is { } v && Rubriques.Any(x => x.Groupe is null && x.Id == v) ? v
        : rapport is null && Rubrique is "pertes" or "pertes-detail" or "tva" ? Rubrique : "synthese";

    /// <summary>Nombre affiché à côté de la rubrique (gris, pour information) : lignes de la période.</summary>
    private int Compteur(string id) => id switch
    {
        "clotures" => clotures?.Page.Total ?? 0,
        "retours" => rapport?.Retours?.Count ?? 0,
        "pertes-detail" => rapport?.Sorties?.Detail.Count ?? 0,
        _ => 0
    };

    // Retours clients et détail des sorties : listes de la période, paginées à l'écran
    private int pageRetours = 1, tailleRetours = Pagination.TailleParDefaut, pageSorties = 1, tailleSorties = Pagination.TailleParDefaut;

    private static readonly (string Code, string Libelle)[] Periodes = [("jour", "Jour"), ("semaine", "Semaine"), ("mois", "Mois"), ("dates", "Dates choisies")];
    private static readonly System.Globalization.CultureInfo Fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");

    private RapportActiviteDto? rapport;
    private string periode = "semaine";
    private DateOnly reference = DateOnly.FromDateTime(DateTime.Now);
    // Dates choisies : par défaut, du début du mois à aujourd'hui
    private DateOnly du = new(DateTime.Now.Year, DateTime.Now.Month, 1), au = DateOnly.FromDateTime(DateTime.Now);
    private bool enCours, tableauJours;
    private string? erreur, message;

    private static DateOnly Aujourdhui => DateOnly.FromDateTime(DateTime.Now);

    protected override Task OnInitializedAsync()
    {
        ChoisirRubrique();   // titre et rubrique justes dès le premier affichage, pendant le calcul du rapport
        // « ← Retour » : période, date et tableau par jour retrouvés tels qu'ils étaient
        Historique.Suivre("rapports", e =>
        {
            e.Mettre("periode", periode); e.Mettre("reference", reference); e.Mettre("du", du); e.Mettre("au", au); e.Mettre("jours", tableauJours);
        });
        if (Historique.Restaurer("rapports") is { } r)
            (periode, reference, du, au, tableauJours) = (r.Texte("periode") ?? periode, r.Date("reference") ?? reference, r.Date("du") ?? du, r.Date("au") ?? au, r.Oui("jours"));
        return ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        enCours = true;
        try
        {
            var (r, e) = await Api.RapportAsync(periode, reference, du, au);
            // Dates refusées (fin avant début, futur, plus d'un an) : le message s'affiche, le rapport précédent reste
            if (r is not null)
            {
                rapport = r;
                (pageRetours, pageSorties) = (1, 1);
                ChoisirRubrique();   // pertes et dons : rubriques connues une fois le rapport chargé (droit)
                if (r.Tva is { } t) (tvaPerime, tvaCasse, tvaDon) = (t.Perime, t.Casse, t.Don);
                await ChargerCloturesAsync(1, clotTaille);
            }
            erreur = e;
        }
        finally { enCours = false; }
    }

    // ---- Clôtures de caisse de la période : paginées et filtrées par le serveur (employé, poste, avec un écart seulement) ----
    private CloturesPageDto? clotures;
    private string clotEmploye = "", clotPoste = "";
    private bool clotEcart;
    private int clotPage = 1, clotTaille = Pagination.TailleParDefaut;
    private bool FiltreCloturesActif => clotEmploye != "" || clotPoste != "" || clotEcart;

    private async Task ChargerCloturesAsync(int numero, int taille)
    {
        var (c, e) = await Api.CloturesRapportAsync(periode, reference, du, au, clotEmploye, clotPoste, clotEcart, numero, taille);
        if (e is not null) { erreur ??= e; return; }
        if (c!.Page.Lignes.Count == 0 && numero > 1) { await ChargerCloturesAsync(1, taille); return; }
        (clotures, clotPage, clotTaille) = (c, c.Page.Numero, c.Page.Taille);
    }

    private Task FiltrerCloturesAsync() => ChargerCloturesAsync(1, clotTaille);
    private Task ToutesLesCloturesAsync() { (clotEmploye, clotPoste, clotEcart) = ("", "", false); return FiltrerCloturesAsync(); }

    private bool tvaPerime, tvaCasse, tvaDon;

    private async Task EnregistrerTvaAsync()
    {
        message = null;
        var e = await Api.TvaSortiesAsync(new TvaSortiesDto(tvaPerime, tvaCasse, tvaDon));
        if (e is not null) { erreur = e; return; }
        await ChargerAsync();
        message = "Réglage de la TVA à reverser enregistré : la marge après pertes et dons est recalculée.";
    }

    private Task ChoisirAsync(string code) { (periode, message) = (code, null); return ChargerAsync(); }
    private Task AujourdhuiAsync()
    {
        (reference, message) = (Aujourdhui, null);
        if (periode == "dates") (du, au) = (Aujourdhui, Aujourdhui);
        return ChargerAsync();
    }

    /// <summary>Période précédente ou suivante : le jour juste avant le début, ou juste après la fin.</summary>
    private Task DeplacerAsync(int sens)
    {
        if (rapport is null) return Task.CompletedTask;
        if (periode == "dates")
        {
            // Même durée, juste avant ou juste après
            var jours = au.DayNumber - du.DayNumber + 1;
            (du, au, message) = (du.AddDays(sens * jours), au.AddDays(sens * jours), null);
            return ChargerAsync();
        }
        (reference, message) = (sens < 0 ? rapport.Du.AddDays(-1) : rapport.Au.AddDays(1), null);
        return ChargerAsync();
    }

    private async Task ExporterAsync(string format)
    {
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var (contenu, nom, e) = await Api.ExporterRapportAsync(periode, reference, du, au, format);
            if (e is not null) { erreur = e; return; }
            var doc = await Documents.RangerAsync(Api, "Rapports", nom!, contenu!);
            (message, erreur) = ($"Rapport rangé : {doc.Emplacement}", doc.Erreur);
            Documents.Ouvrir(doc.CheminLocal);
        }
        finally { enCours = false; }
    }

    private string Jour(DateOnly d, bool complet) =>
        rapport?.ParSemaine == true ? (complet ? $"Semaine du {d.ToString("dd/MM/yyyy", Fr)}" : d.ToString("dd/MM", Fr))
        : complet ? d.ToString("dddd dd/MM", Fr)
        : periode == "mois" ? d.Day.ToString()
        : periode == "dates" && rapport is { } r && r.Au.DayNumber - r.Du.DayNumber > 6 ? d.ToString("d/M", Fr)
        : d.ToString("ddd", Fr).TrimEnd('.');

    private static string Pourcent(decimal valeur, decimal max) =>
        (max <= 0 ? 0 : Math.Round(valeur / max * 100, 1)).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string MotifSortie(string motif) => motif switch { "perime" => "Périmé", "casse" => "Casse", "echantillon" => "Don ou échantillon", _ => motif };
    private static string Signe(decimal n) => n > 0 ? $"+{Libelles.Dinars(n)}" : Libelles.Dinars(n);
}
