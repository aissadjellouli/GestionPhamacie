@page "/surveillance/risques"
@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique

@* Écran fixe, menu vertical du contrôle interne à gauche : un tableau à la fois (surveillance/risques, ?rubrique=jours) ; la période est commune *@
<div class="page avec-menu">
    <NavControleInterne Actif="@(jours ? "surveillance/risques?rubrique=jours" : "surveillance/risques")" />

    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>Pertes et vigilance · @(jours ? "Jour par jour" : "Par employé")<AideEcran Cle="surveillance/risques" /></h1>
            <OptionNonIncluse Pack="A" />
            <p class="sous-titre">Les pertes rapprochées des jours, des postes et des employés présents : une perte qui revient quand la même personne travaille saute aux yeux. Visible du titulaire seul.</p>
        </div>
    </div>

    @if (!Session.A("role.titulaire"))
    {
        <div class="erreur" role="alert">Écran réservé au pharmacien titulaire.</div>
    }
    else
    {
        <div class="filtres-liste" role="search" aria-label="Période">
            <div class="champ" style="flex: 0 0 160px"><label for="r-du">Du</label><input id="r-du" data-champ="periode" type="date" @bind="du" @bind:after="ChargerAsync" /></div>
            <div class="champ" style="flex: 0 0 160px"><label for="r-au">Au</label><input id="r-au" type="date" @bind="au" @bind:after="ChargerAsync" /></div>
            @foreach (var (jours, libelle) in new[] { (7, "7 jours"), (30, "30 jours"), (90, "90 jours") })
            {
                <button type="button" class="puce" aria-pressed="@(Duree == jours ? "true" : "false")" @onclick="() => PeriodeAsync(jours)">@libelle</button>
            }
        </div>
        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

        @if (tableau is { } t)
        {
            var signales = t.Employes.Count(e => e.Signale);
            @if (!jours)
            {
            <section class="panneau" aria-labelledby="t-employes">
                <div>
                    <h2 id="t-employes" class="visuellement-cache">Par employé, du @Libelles.Date(t.Du) au @Libelles.Date(t.Au)</h2>
                    <p class="detail" style="margin: 0">Perte du jour : manque de caisse aux clôtures et boîtes manquantes ajustées en inventaire (au prix d’achat). Un employé est signalé quand il y a eu au moins @t.JoursPerteMin jours de perte en sa présence et que la perte moyenne les jours où il est là atteint @t.Facteur.ToString("0.#") fois celle des jours où il n’est pas là (au moins @t.JoursAbsentMin jours sans lui pour comparer).</p>
                </div>
                @if (signales > 0)
                {
                    <div class="bandeau-attention" role="alert">@signales employé(s) signalé(s) : les pertes sont nettement plus fortes les jours où ils travaillent. C’est un indice, pas une preuve : croisez avec les anomalies et le journal.</div>
                }
                @* 1366 × 768 (2026-11-18) : titre du panneau pour les lecteurs d'écran seulement (le titre de la page et la période le
                   disent déjà), cellules resserrées (11 colonnes sans défilement horizontal), cadre de 200 px au moins : écran à 0 px *@
                <div class="tableau-cadre" data-hauteur-min="200">
                    <table class="tableau tableau-serre" style="min-width: 0">
                        <thead><tr><th scope="col">Employé</th><th scope="col">Jours présent</th><th scope="col">Jours avec perte</th><th scope="col">Perte moyenne présent / absent</th><th scope="col">Manque à ses clôtures</th><th scope="col">Anomalies</th><th scope="col">Annulations · retours</th><th scope="col">Remises</th><th scope="col">Crédits accordés</th><th scope="col">Codes demandés · donnés</th><th scope="col">Casses · dons · ajustées</th></tr></thead>
                        <tbody>
                            @foreach (var e in t.Employes.Skip((pageEmployes - 1) * tailleEmployes).Take(tailleEmployes))
                            {
                                <tr>
                                    <td><span class="nom">@e.Nom</span>@if (!e.Actif) {<br /><span class="detail">compte désactivé</span>}
                                        @if (e.Signale) {<br /><span class="pastille urgent">Pertes en sa présence</span>}</td>
                                    <td>@e.JoursPresent</td>
                                    <td>@e.JoursAvecPerte@if (e.PerteEnPresence > 0) {<br /><span class="detail">@Libelles.Dinars(e.PerteEnPresence, 2)</span>}</td>
                                    <td>@Libelles.Dinars(e.MoyennePresent, 2) / @Libelles.Dinars(e.MoyenneAbsent, 2)</td>
                                    <td>@(e.ManqueCaisse > 0 ? Libelles.Dinars(e.ManqueCaisse, 2) : "—")<br /><span class="detail">@e.Clotures clôture(s)</span></td>
                                    <td>@e.Anomalies@if (e.Urgentes > 0) {<br /><span class="detail">dont @e.Urgentes urgente(s)</span>}</td>
                                    <td>@e.Annulations · @e.RetoursClients</td>
                                    <td>@e.Remises</td>
                                    <td>@(e.Credits > 0 ? Libelles.Dinars(e.Credits, 2) : "—")</td>
                                    <td>@e.AutorisationsDemandees · @e.AutorisationsDonnees</td>
                                    <td>@e.Casses · @e.Echantillons · @e.BoitesAjustees</td>
                                </tr>
                            }
                            @if (t.Employes.Count == 0)
                            {
                                <tr><td colspan="11" class="vide">Aucun employé sur cette période.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="t.Employes.Count" Numero="pageEmployes" Taille="tailleEmployes" Libelle="Pages des employés" OnChange="p => (pageEmployes, tailleEmployes) = (p.Numero, p.Taille)" />
            </section>
            }
            else
            {

            <section class="panneau" aria-labelledby="t-jours">
                <div>
                    <h2 id="t-jours" class="visuellement-cache">Jour par jour</h2>
                    <p class="sous-titre">Journées d’activité de la période, de la plus récente à la plus ancienne. Total des pertes : @Libelles.Dinars(t.Jours.Sum(j => j.Manque + j.PerteStock), 2).</p>
                </div>
                @* 1366 × 768 (2026-11-18) : titre pour les lecteurs d'écran seulement (le titre de la page le dit), cadre de 200 px au moins *@
                <div class="tableau-cadre" data-hauteur-min="200">
                    <table class="tableau">
                        <thead><tr><th scope="col">Jour</th><th scope="col">Perte</th><th scope="col">Écart de caisse</th><th scope="col">Boîtes manquantes ajustées</th><th scope="col">Boîtes fantômes</th><th scope="col">Anomalies</th><th scope="col">Présents</th><th scope="col">Postes</th></tr></thead>
                        <tbody>
                            @foreach (var j in t.Jours.Skip((pageJours - 1) * tailleJours).Take(tailleJours))
                            {
                                var perte = j.Manque + j.PerteStock;
                                <tr>
                                    <td>@Libelles.Date(j.Jour)</td>
                                    <td>@if (perte > 0) {<span class="pastille @(perte >= SeuilFort ? "urgent" : "attention")">@Libelles.Dinars(perte, 2)</span>} else {<span>—</span>}</td>
                                    <td>@(j.Ecart != 0 ? Libelles.Dinars(j.Ecart, 2) : "—")</td>
                                    <td>@(j.BoitesAjustees > 0 ? $"{j.BoitesAjustees} ({Libelles.Dinars(j.PerteStock, 2)})" : "—")</td>
                                    <td>@(j.ValeurFantomes > 0 ? Libelles.Dinars(j.ValeurFantomes, 2) : "—")</td>
                                    <td>@(j.Anomalies > 0 ? $"{j.Anomalies}" + (j.Urgentes > 0 ? $" (dont {j.Urgentes} urgente(s))" : "") : "—")</td>
                                    <td>@(j.Employes.Count > 0 ? string.Join(", ", j.Employes) : "—")</td>
                                    <td>@(j.Postes.Count > 0 ? string.Join(", ", j.Postes) : "—")</td>
                                </tr>
                            }
                            @if (t.Jours.Count == 0)
                            {
                                <tr><td colspan="8" class="vide">Aucune activité sur cette période.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Total="t.Jours.Count" Numero="pageJours" Taille="tailleJours" Libelle="Pages des jours" OnChange="p => (pageJours, tailleJours) = (p.Numero, p.Taille)" />
                <p class="detail" style="margin: 0">Une perte d’inventaire apparaît le jour du comptage, pas le jour où la boîte a disparu : sur une longue période, regardez la tendance plutôt qu’un jour isolé. Présence : connexion, vente, ouverture de caisse ou action inscrite au journal ce jour-là.</p>
            </section>
            }
        }
        else if (erreur is null) { <Chargement Texte="Calcul des risques…" /> }
    }
    </div>
</div>

@code {
    /// <summary>Tableau affiché : par employé (défaut) ou jour par jour (?rubrique=jours).</summary>
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private bool jours => Rubrique == "jours";

    private TableauRisquesDto? tableau;
    private DateOnly? du, au;
    private string? erreur;
    private int pageEmployes = 1, tailleEmployes = Pagination.TailleParDefaut, pageJours = 1, tailleJours = Pagination.TailleParDefaut;

    /// <summary>Perte d'un jour mise en rouge : au moins le double de la perte moyenne des jours de perte de la période.</summary>
    private decimal SeuilFort => tableau?.Jours.Where(j => j.Manque + j.PerteStock > 0).Select(j => j.Manque + j.PerteStock).DefaultIfEmpty(0).Average() * 2 ?? 0;

    private int? Duree => du is { } d && au is { } a && a == DateOnly.FromDateTime(DateTime.Today) ? a.DayNumber - d.DayNumber + 1 : null;

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : période et pages des deux tableaux retrouvées telles qu'elles étaient
        Historique.Suivre("risques", e =>
        {
            e.Mettre("du", du); e.Mettre("au", au); e.Mettre("pageEmployes", pageEmployes); e.Mettre("tailleEmployes", tailleEmployes);
            e.Mettre("pageJours", pageJours); e.Mettre("tailleJours", tailleJours);
        });
        if (Historique.Restaurer("risques") is { } r && r.Date("du") is { } d && r.Date("au") is { } a)
        {
            (du, au) = (d, a);
            await ChargerAsync();
            (pageEmployes, tailleEmployes) = (r.Entier("pageEmployes") ?? 1, r.Entier("tailleEmployes") ?? tailleEmployes);
            (pageJours, tailleJours) = (r.Entier("pageJours") ?? 1, r.Entier("tailleJours") ?? tailleJours);
        }
        else await PeriodeAsync(30);
    }

    private Task PeriodeAsync(int jours)
    {
        au = DateOnly.FromDateTime(DateTime.Today);
        du = au.Value.AddDays(-(jours - 1));
        return ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        if (!Session.A("role.titulaire")) return;
        (tableau, erreur) = await Api.RisquesAsync(du, au);
        (pageEmployes, pageJours) = (1, 1);
    }
}
