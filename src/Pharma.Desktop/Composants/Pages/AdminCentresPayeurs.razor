@page "/admin/centres-payeurs"
@inject ApiClient Api
@inject HistoriqueNavigation Historique

@* Centres payeurs Chifa (2026-11-15, script 100) : centres de la CNAS et de la CASNOS, code libre de 1 à 10 caractères unique par organisme
   (D-2). Ajout, libellé, désactivation ; jamais de suppression. Écran fixe : seul le tableau défile (docs/charte-graphique.md). *@
<div class="page admin">
    <NavAdmin Actif="admin/centres-payeurs" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Centres payeurs Chifa</h1>
                <p class="sous-titre">Centres de la CNAS et de la CASNOS, choisis sur les ventes Chifa (un bordereau par centre). Un centre utilisé n’est jamais supprimé : désactivé, il n’est plus proposé.</p>
            </div>
            <button type="button" class="btn btn-principal" @onclick="Ajouter">Ajouter un centre</button>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (fiche is not null)
        {
            <section class="panneau" aria-labelledby="t-fiche-centre">
                <h2 id="t-fiche-centre">@(fiche.Id is null ? "Nouveau centre payeur" : $"Modifier le centre {fiche.CodeInitial}")</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 200px">
                        <label for="c-org" class="requis">Organisme</label>
                        <select id="c-org" data-champ="organisme" @bind="fiche.OrganismeId">
                            @foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }
                        </select>
                    </div>
                    <div class="champ" style="flex: 0 0 160px"><label for="c-code" class="requis">Code</label>
                        <input id="c-code" data-champ="code" type="text" maxlength="10" @bind="fiche.Code" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 2 1 280px"><label for="c-nom" class="requis">Libellé</label>
                        <input id="c-nom" data-champ="nom" type="text" maxlength="120" @bind="fiche.Nom" @bind:event="oninput" /></div>
                </div>
                @if (fiche.Id is not null)
                {
                    <label class="case"><input type="checkbox" data-champ="actif" @bind="fiche.Actif" /><span>Centre proposé (décoché : désactivé, plus proposé sur les ventes)</span></label>
                }
                <div style="display: flex; gap: 8px">
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">@(fiche.Id is null ? "Créer" : "Enregistrer")</button>
                    <button type="button" class="btn" @onclick="() => fiche = null">Annuler</button>
                </div>
            </section>
        }

        @if (fiche is null)
        {
            <div class="filtres-liste" role="search" aria-label="Filtrer les centres payeurs">
                <div class="champ" style="flex: 0 0 200px"><label for="fc-org">Organisme</label>
                    <select id="fc-org" @bind="fOrganisme" @bind:after="PremierePageAsync">
                        <option value="">Tous</option>
                        @foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }
                    </select></div>
                <div class="champ" style="flex: 1 1 220px"><label for="fc-texte">Code ou libellé</label>
                    <input id="fc-texte" type="search" autocomplete="off" value="@fTexte" @oninput="RechercheAsync" /></div>
                <div class="champ" style="flex: 0 0 170px"><label for="fc-etat">État</label>
                    <select id="fc-etat" @bind="fEtat" @bind:after="PremierePageAsync"><option value="">Tous</option><option value="actif">Proposés</option><option value="inactif">Désactivés</option></select></div>
                @if (fOrganisme is not null || fTexte.Trim() != "" || fEtat != "") { <button type="button" class="btn" @onclick="ToutAfficherAsync">Tout afficher</button> }
            </div>
            <section class="tableau-cadre" aria-label="Centres payeurs">
                <table class="tableau" style="min-width: 0">
                    <thead><tr><th scope="col">Organisme</th><th scope="col">Code</th><th scope="col">Libellé</th><th scope="col">État</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
                    <tbody>
                        @foreach (var c in centres)
                        {
                            <tr>
                                <td>@c.OrganismeCode</td>
                                <td>@c.Code</td>
                                <td>@c.Nom</td>
                                <td><span class="pastille @(c.Actif ? "ok" : "info")">@(c.Actif ? "Proposé" : "Désactivé")</span></td>
                                <td><button type="button" class="btn" @onclick="() => Editer(c)">Modifier</button></td>
                            </tr>
                        }
                        @if (centres.Count == 0 && erreur is null) { <tr><td colspan="5" class="vide">Aucun centre payeur pour ces filtres.</td></tr> }
                    </tbody>
                </table>
            </section>
            <Pagination Total="total" Numero="page" Taille="taille" Libelle="Pages des centres payeurs" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
    </div>
</div>

@code {
    private sealed class Fiche
    {
        public long? Id { get; init; }
        public string? CodeInitial { get; init; }
        public long OrganismeId { get; set; }
        public string? Code { get; set; }
        public string? Nom { get; set; }
        public bool Actif { get; set; } = true;
    }

    private List<OrganismeDto> organismes = [];
    private List<CentrePayeurDto> centres = [];
    private Fiche? fiche;
    private bool enCours;
    private string? erreur, message;
    private int total, page = 1, taille = Pagination.TailleParDefaut, saisie;
    private long? fOrganisme;
    private string fTexte = "", fEtat = "";

    protected override async Task OnInitializedAsync()
    {
        Historique.Suivre("centres-payeurs", e => { e.Mettre("texte", fTexte); e.Mettre("etat", fEtat); e.Mettre("page", page); e.Mettre("taille", taille); });
        if (Historique.Restaurer("centres-payeurs") is { } h)
            (fTexte, fEtat, page, taille) = (h.Texte("texte") ?? "", h.Texte("etat") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
        // Organismes Chifa seulement : CNAS et CASNOS
        var (o, e) = await Api.OrganismesAsync();
        organismes = o.Where(x => x.Code.Trim().ToUpperInvariant() is "CNAS" or "CASNOS").OrderBy(x => x.Code).ToList();
        erreur = e;
        await ChargerAsync(page, taille);
    }

    private Task PremierePageAsync() => ChargerAsync(1, taille);
    private Task ToutAfficherAsync() { (fOrganisme, fTexte, fEtat) = (null, "", ""); return PremierePageAsync(); }

    private async Task RechercheAsync(ChangeEventArgs a)
    {
        fTexte = a.Value?.ToString() ?? "";
        var n = ++saisie;
        await Task.Delay(250);
        if (n == saisie) await PremierePageAsync();
    }

    private async Task ChargerAsync(int numero, int nouvelleTaille)
    {
        var (p, e) = await Api.CentresPayeursAsync(fOrganisme, fEtat switch { "actif" => true, "inactif" => false, _ => null }, fTexte.Trim(), numero, nouvelleTaille);
        if (p is null) { erreur ??= e; return; }
        (centres, total, page, taille) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille);
    }

    private void Ajouter() =>
        (fiche, erreur, message) = (new Fiche { OrganismeId = fOrganisme ?? organismes.FirstOrDefault()?.Id ?? 0 }, null, null);

    private void Editer(CentrePayeurDto c) => (fiche, erreur, message) =
        (new Fiche { Id = c.Id, CodeInitial = c.Code, OrganismeId = c.OrganismeId, Code = c.Code, Nom = c.Nom, Actif = c.Actif }, null, null);

    private async Task EnregistrerAsync()
    {
        if (fiche is null) return;
        if (string.IsNullOrWhiteSpace(fiche.Code) || string.IsNullOrWhiteSpace(fiche.Nom)) { (erreur, message) = ("Indiquez le code et le libellé.", null); return; }
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var e = await Api.EnregistrerCentrePayeurAsync(fiche.Id, new CentrePayeurSaisie(fiche.OrganismeId, fiche.Code.Trim(), fiche.Nom.Trim(), fiche.Actif));
            if (e is not null) { erreur = e; return; }
            message = $"Centre {fiche.Code.Trim()} enregistré.";
            fiche = null;
            await ChargerAsync(page, taille);
        }
        finally { enCours = false; }
    }
}
