@page "/admin/postes"
@implements IDisposable
@inject ApiClient Api
@inject HistoriqueNavigation Historique

@* Liste des postes autorisés (2026-11-24, script 167, docs/taches/2026-11-24-postes-autorises) : le titulaire autorise chaque poste (code à usage unique),
   le renomme, change son PC ou le révoque. Titulaire seul. Écran fixe : seul le tableau défile ; tableau paginé et filtré par le serveur ;
   code, autorisation, renommage, révocation et passage en « exigé » dans une fenêtre au-dessus de l'écran (docs/charte-graphique.md). *@
<div class="page admin">
    <NavAdmin Actif="admin/postes" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Postes autorisés</h1>
                @* Résultat d'une action à la place du sous-titre (2026-11-26) : empilé sous le titre, il faisait déborder l'écran de 37 px à 1 366 × 768
                   (tableau déjà à sa hauteur minimale) ; à la même place, la hauteur de l'écran ne change pas *@
                @if (erreur is not null) { <p class="sous-titre texte-urgent" role="alert" data-champ="resultat">@erreur</p> }
                else if (message is not null) { <p class="sous-titre texte-reussite" role="status" data-champ="resultat">@message</p> }
                else { <p class="sous-titre">Seuls les postes autorisés ici prouvent leur identité au serveur : un PC autorisé ne peut pas être imité par un autre, même avec le même nom.</p> }
            </div>
            <button type="button" class="btn btn-principal" @onclick="OuvrirAutorisation">Autoriser un poste</button>
        </div>

        @if (reglages is not null)
        {
            <section class="panneau postes-reglage" aria-labelledby="t-reglage-postes">
                <h2 id="t-reglage-postes" class="visuellement-cache">Réglage de la liste</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 230px"><label for="pa-mode">Preuve des postes</label>
                        <select id="pa-mode" data-champ="mode" @bind="mode">
                            <option value="transition">En transition</option>
                            <option value="exige">Exigée pour tous</option>
                            <option value="inactif">Désactivée</option>
                        </select></div>
                    <div class="champ" style="flex: 0 0 150px"><label for="pa-max">Postes au plus</label>
                        <input id="pa-max" data-champ="maximumPostes" type="number" min="1" max="200" @bind="maximum" /></div>
                    <div class="champ" style="flex: 0 0 170px"><label for="pa-duree">Code valable (min)</label>
                        <input id="pa-duree" data-champ="dureeCodeMinutes" type="number" min="5" max="60" @bind="duree" /></div>
                    <button type="button" class="btn" disabled="@(enCours || !ReglageModifie)" @onclick="EnregistrerReglagesAsync">Enregistrer</button>
                    <p class="detail" style="flex: 1 1 260px; margin: 0">@ExpliquerMode(reglages.Mode)</p>
                </div>
            </section>
        }

        <div class="filtres-liste" role="search" aria-label="Filtrer les postes">
            <div class="champ" style="flex: 1 1 220px"><label for="pa-texte">Nom ou ordinateur</label>
                <input id="pa-texte" type="search" autocomplete="off" value="@fTexte" @oninput="RechercheAsync" /></div>
            <div class="champ" style="flex: 0 0 190px"><label for="pa-statut">Statut</label>
                <select id="pa-statut" @bind="fStatut" @bind:after="PremierePageAsync">
                    <option value="">Tous</option><option value="actif">Autorisés</option><option value="en_attente">En attente du code</option><option value="revoque">Révoqués</option>
                </select></div>
            @if (fTexte.Trim() != "" || fStatut != "") { <button type="button" class="btn" @onclick="ToutAfficherAsync">Tout afficher</button> }
        </div>
        <section class="tableau-cadre" aria-label="Postes autorisés">
            <table class="tableau" style="min-width: 0">
                <thead><tr>
                    <th scope="col">Poste</th><th scope="col">Statut</th><th scope="col">Autorisé le</th><th scope="col">Dernière preuve</th>
                    <th scope="col">Ordinateur</th><th scope="col">Empreinte</th><th scope="col"><span class="visuellement-cache">Actions</span></th>
                </tr></thead>
                <tbody>
                    @foreach (var p in liste)
                    {
                        <tr>
                            <td>@p.Nom</td>
                            <td><span class="pastille @Pastille(p.Statut)">@Statut(p)</span></td>
                            <td>@Date(p.EnroleLe)</td>
                            <td>@Date(p.DernierePreuveLe)</td>
                            <td>@(p.Ordinateur ?? "—")</td>
                            <td><code>@(p.EmpreinteCle ?? "—")</code></td>
                            <td class="actions-ligne">
                                @if (p.Statut != "revoque")
                                {
                                    <button type="button" class="lien-bouton" @onclick="() => OuvrirRenommage(p)">Renommer</button>
                                    @if (p.Statut == "en_attente") { <button type="button" class="lien-bouton" disabled="@enCours" @onclick="() => NouveauCodeAsync(p)">Nouveau code</button> }
                                    @if (p.Statut == "actif") { <button type="button" class="lien-bouton" disabled="@enCours" @onclick="() => RemplacerAsync(p)">Remplacer le PC</button> }
                                    <button type="button" class="lien-bouton" @onclick="() => OuvrirRevocation(p)">Révoquer</button>
                                }
                                else { <span class="detail">@p.MotifRevocation</span> }
                            </td>
                        </tr>
                    }
                    @if (liste.Count == 0 && erreur is null) { <tr><td colspan="7" class="vide">Aucun poste pour ces filtres.</td></tr> }
                </tbody>
            </table>
        </section>
        <Pagination Total="total" Numero="page" Taille="taille" Libelle="Pages des postes" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        <p class="pied-page">Sur le PC à autoriser, cliquez « Autoriser ce poste » à l’écran de connexion et tapez le code. Un PC volé ou perdu se révoque ici : il est refusé dans les 30 secondes. Seuls les postes autorisés comptent pour la bascule automatique vers le 2e serveur.</p>
    </div>
</div>

@if (fenetre is not null)
{
    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-fenetre-poste" @onkeydown="Touche">
        <section class="panneau" style="max-width: 560px; width: 100%">
            @switch (fenetre)
            {
                case Fenetre.Autoriser:
                    <h2 id="t-fenetre-poste">Autoriser un poste</h2>
                    <p class="detail" style="margin: 0 0 8px">Donnez au poste le nom qui apparaîtra sur les caisses, tickets et rapports (ex. « CAISSE-1 »). Un code à usage unique s’affichera ensuite.</p>
                    @if (erreurFenetre is not null) { <div class="erreur" role="alert">@erreurFenetre</div> }
                    <div class="champ"><label for="pa-nom" class="requis">Nom du poste</label>
                        <input id="pa-nom" data-champ="nom" type="text" maxlength="100" autofocus @bind="saisieNom" @bind:event="oninput"
                               class="@Obligatoire.Classe(controle && string.IsNullOrWhiteSpace(saisieNom))" aria-invalid="@Obligatoire.Aria(controle && string.IsNullOrWhiteSpace(saisieNom))" /></div>
                    @if (reglages?.NomsSansPreuve is { Count: > 0 } noms)
                    {
                        <p class="detail" style="margin: 0">Noms vus récemment sans preuve : @string.Join(", ", noms.Take(8).Select(n => n.Nom))</p>
                    }
                    <div class="actions-fenetre">
                        <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="AutoriserAsync">Créer le code</button>
                        <button type="button" class="btn" @onclick="Fermer">Annuler</button>
                    </div>
                    break;
                case Fenetre.Code when codeCree is not null:
                    <h2 id="t-fenetre-poste">Code du poste « @codeCree.Nom »</h2>
                    <p class="detail" style="margin: 0 0 8px">À taper sur ce poste, à l’écran de connexion (« Autoriser ce poste »). Il ne sert qu’une fois et ne sera plus affiché.</p>
                    <p class="code-enrolement" aria-live="polite">@codeCree.Code</p>
                    <p class="@(Restant > TimeSpan.Zero ? "info-bandeau" : "erreur")" role="status">@(Restant > TimeSpan.Zero ? $"Valable encore {Restant:mm\\:ss}" : "Code expiré : donnez un nouveau code au poste.")</p>
                    <div class="actions-fenetre"><button type="button" class="btn btn-principal" @onclick="Fermer">Fermer</button></div>
                    break;
                case Fenetre.Renommer when cible is not null:
                    <h2 id="t-fenetre-poste">Renommer « @cible.Nom »</h2>
                    <p class="detail" style="margin: 0 0 8px">Refusé tant que la caisse du poste est ouverte ou qu’il reste des ventes ou réceptions en attente sous son nom. L’historique garde l’ancien nom.</p>
                    @if (erreurFenetre is not null) { <div class="erreur" role="alert">@erreurFenetre</div> }
                    <div class="champ"><label for="pa-renom" class="requis">Nouveau nom</label>
                        <input id="pa-renom" data-champ="nom" type="text" maxlength="100" autofocus @bind="saisieNom" @bind:event="oninput"
                               class="@Obligatoire.Classe(controle && string.IsNullOrWhiteSpace(saisieNom))" aria-invalid="@Obligatoire.Aria(controle && string.IsNullOrWhiteSpace(saisieNom))" /></div>
                    <div class="actions-fenetre">
                        <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="RenommerAsync">Renommer</button>
                        <button type="button" class="btn" @onclick="Fermer">Annuler</button>
                    </div>
                    break;
                case Fenetre.Revoquer when cible is not null:
                    <h2 id="t-fenetre-poste">Révoquer « @cible.Nom »</h2>
                    <p class="detail" style="margin: 0 0 8px">Le PC est refusé dans les 30 secondes et ses connexions sont coupées. Le nom redevient libre. Irréversible : pour le réutiliser, autorisez-le de nouveau.</p>
                    @if (erreurFenetre is not null) { <div class="erreur" role="alert">@erreurFenetre</div> }
                    <div class="champ"><label for="pa-motif" class="requis">Motif (PC volé, perdu, remplacé…)</label>
                        <input id="pa-motif" data-champ="motif" type="text" maxlength="200" autofocus @bind="saisieMotif" @bind:event="oninput"
                               class="@Obligatoire.Classe(controle && saisieMotif.Trim().Length < 5)" aria-invalid="@Obligatoire.Aria(controle && saisieMotif.Trim().Length < 5)" /></div>
                    <div class="actions-fenetre">
                        <button type="button" class="btn btn-danger" disabled="@enCours" @onclick="RevoquerAsync">Révoquer</button>
                        <button type="button" class="btn" @onclick="Fermer">Annuler</button>
                    </div>
                    break;
                case Fenetre.Exiger:
                    <h2 id="t-fenetre-poste">Exiger la preuve pour tous les postes</h2>
                    <p class="detail" style="margin: 0 0 8px">Un poste non autorisé ne pourra plus se connecter ; un employé déjà connecté sur un tel poste devra se reconnecter après l’autorisation du poste.</p>
                    @if (reglages?.NomsSansPreuve is { Count: > 0 } restants)
                    {
                        <div class="bandeau-attention" role="alert">Postes vus ces 30 derniers jours et encore non autorisés : @string.Join(", ", restants.Select(n => n.Nom)). Ils seront refusés.</div>
                    }
                    else { <p class="info-bandeau">Aucun poste non autorisé n’a été vu ces 30 derniers jours.</p> }
                    @if (erreurFenetre is not null) { <div class="erreur" role="alert">@erreurFenetre</div> }
                    <div class="actions-fenetre">
                        <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => EnregistrerReglagesAsync(true)">Exiger la preuve</button>
                        <button type="button" class="btn" @onclick="Fermer">Annuler</button>
                    </div>
                    break;
            }
        </section>
    </div>
}

@code {
    private enum Fenetre { Autoriser, Code, Renommer, Revoquer, Exiger }

    private List<PosteAutoriseDto> liste = [];
    private ReglagesPostesDto? reglages;
    private string mode = "transition";
    private int maximum = 20, duree = 15;
    private bool enCours, controle;
    private string? erreur, message, erreurFenetre;
    private int total, page = 1, taille = Pagination.TailleParDefaut, saisie;
    private string fTexte = "", fStatut = "";
    private Fenetre? fenetre;
    private PosteAutoriseDto? cible;
    private CodeEnrolementDto? codeCree;
    private string saisieNom = "", saisieMotif = "";
    private System.Threading.Timer? minuteur;

    private bool ReglageModifie => reglages is not null && (mode != reglages.Mode || maximum != reglages.MaximumPostes || duree != reglages.DureeCodeMinutes);
    private TimeSpan Restant => codeCree is null ? TimeSpan.Zero : codeCree.ExpireLe.ToUniversalTime() - DateTime.UtcNow is var r && r > TimeSpan.Zero ? r : TimeSpan.Zero;

    protected override async Task OnInitializedAsync()
    {
        Historique.Suivre("postes-autorises", e => { e.Mettre("texte", fTexte); e.Mettre("statut", fStatut); e.Mettre("page", page); e.Mettre("taille", taille); });
        if (Historique.Restaurer("postes-autorises") is { } h)
            (fTexte, fStatut, page, taille) = (h.Texte("texte") ?? "", h.Texte("statut") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
        await ChargerReglagesAsync();
        await ChargerAsync(page, taille);
    }

    private async Task ChargerReglagesAsync()
    {
        var (r, e) = await Api.ReglagesPostesAsync();
        if (r is null) { erreur ??= e; return; }
        (reglages, mode, maximum, duree) = (r, r.Mode, r.MaximumPostes, r.DureeCodeMinutes);
    }

    private Task PremierePageAsync() => ChargerAsync(1, taille);
    private Task ToutAfficherAsync() { (fTexte, fStatut) = ("", ""); return PremierePageAsync(); }

    private async Task RechercheAsync(ChangeEventArgs a)
    {
        fTexte = a.Value?.ToString() ?? "";
        var n = ++saisie;
        await Task.Delay(250);
        if (n == saisie) await PremierePageAsync();
    }

    private async Task ChargerAsync(int numero, int nouvelleTaille)
    {
        var (p, e) = await Api.PostesAutorisesAsync(fStatut == "" ? null : fStatut, fTexte.Trim(), numero, nouvelleTaille);
        if (p is null) { erreur ??= e; return; }
        (liste, total, page, taille) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille);
    }

    private static string ExpliquerMode(string m) => m switch
    {
        "exige" => "Preuve exigée : un poste non autorisé est refusé.",
        "inactif" => "Preuve désactivée : les postes ne sont pas vérifiés (comme avant la liste) et la bascule compte les postes connectés.",
        _ => "Transition : un poste non autorisé fonctionne encore, avec un bandeau, mais ne compte pas pour la bascule. Passez à « Exigée » une fois tous les postes autorisés."
    };

    private static string Pastille(string statut) => statut switch { "actif" => "ok", "en_attente" => "attention", _ => "info" };

    private static string Statut(PosteAutoriseDto p) => p.Statut switch
    {
        "actif" => "Autorisé",
        "en_attente" => p.Generation > 1 ? "PC à remplacer" : "En attente du code",
        _ => "Révoqué"
    };

    private static string Date(DateTime? d) => d is { } v ? v.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—";

    private async Task EnregistrerReglagesAsync() => await EnregistrerReglagesAsync(false);

    private async Task EnregistrerReglagesAsync(bool confirme)
    {
        if (reglages is null) return;
        if (mode == "exige" && reglages.Mode != "exige" && !confirme)
        {
            (fenetre, erreurFenetre) = (Fenetre.Exiger, null);
            return;
        }
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var e = await Api.ModifierReglagesPostesAsync(new ReglagesPostesDto(mode, maximum, duree));
            if (e is not null)
            {
                if (fenetre == Fenetre.Exiger) erreurFenetre = e; else erreur = e;
                return;
            }
            fenetre = null;
            message = "Réglage des postes enregistré (appliqué par chaque serveur dans les 30 secondes).";
            await ChargerReglagesAsync();
        }
        finally { enCours = false; }
    }

    private void OuvrirAutorisation() => (fenetre, saisieNom, erreurFenetre, controle, message) = (Fenetre.Autoriser, "", null, false, null);

    private void OuvrirRenommage(PosteAutoriseDto p) => (fenetre, cible, saisieNom, erreurFenetre, controle, message) = (Fenetre.Renommer, p, p.Nom, null, false, null);

    private void OuvrirRevocation(PosteAutoriseDto p) => (fenetre, cible, saisieMotif, erreurFenetre, controle, message) = (Fenetre.Revoquer, p, "", null, false, null);

    private async Task AutoriserAsync()
    {
        controle = true;
        if (string.IsNullOrWhiteSpace(saisieNom)) { erreurFenetre = "Indiquez le nom du poste."; return; }
        (enCours, erreurFenetre) = (true, null);
        try
        {
            var (c, e) = await Api.AutoriserPosteAsync(saisieNom.Trim());
            if (c is null) { erreurFenetre = e; return; }
            MontrerCode(c);
            await ChargerAsync(page, taille);
        }
        finally { enCours = false; }
    }

    private async Task NouveauCodeAsync(PosteAutoriseDto p)
    {
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var (c, e) = await Api.NouveauCodePosteAsync(p.Id);
            if (c is null) { erreur = e; return; }
            MontrerCode(c);
            await ChargerAsync(page, taille);
        }
        finally { enCours = false; }
    }

    private async Task RemplacerAsync(PosteAutoriseDto p)
    {
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var (c, e) = await Api.RemplacerPostePcAsync(p.Id);
            if (c is null) { erreur = e; return; }
            MontrerCode(c);
            await ChargerAsync(page, taille);
        }
        finally { enCours = false; }
    }

    private async Task RenommerAsync()
    {
        controle = true;
        if (cible is null) return;
        if (string.IsNullOrWhiteSpace(saisieNom)) { erreurFenetre = "Indiquez le nouveau nom."; return; }
        (enCours, erreurFenetre) = (true, null);
        try
        {
            var e = await Api.RenommerPosteAsync(cible.Id, saisieNom.Trim());
            if (e is not null) { erreurFenetre = e; return; }
            message = $"Poste « {cible.Nom} » renommé en « {saisieNom.Trim()} ».";
            fenetre = null;
            await ChargerAsync(page, taille);
            // Ce poste-ci renommé : il reprend tout de suite son nom auprès du serveur (les autres postes, à leur prochain écran de connexion)
            await Api.EtatAutorisationPosteAsync();
        }
        finally { enCours = false; }
    }

    private async Task RevoquerAsync()
    {
        controle = true;
        if (cible is null) return;
        if (saisieMotif.Trim().Length < 5) { erreurFenetre = "Motif obligatoire (5 caractères au moins)."; return; }
        (enCours, erreurFenetre) = (true, null);
        try
        {
            var e = await Api.RevoquerPosteAsync(cible.Id, saisieMotif.Trim());
            if (e is not null) { erreurFenetre = e; return; }
            message = $"Poste « {cible.Nom} » révoqué.";
            fenetre = null;
            await ChargerAsync(page, taille);
        }
        finally { enCours = false; }
    }

    // Code affiché avec un compte à rebours (relu chaque seconde)
    private void MontrerCode(CodeEnrolementDto c)
    {
        (codeCree, fenetre, erreurFenetre) = (c, Fenetre.Code, null);
        minuteur?.Dispose();
        minuteur = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Fermer()
    {
        (fenetre, cible, erreurFenetre, controle) = (null, null, null, false);
        if (codeCree is not null) { codeCree = null; minuteur?.Dispose(); minuteur = null; }
        if (reglages is not null && mode == "exige" && reglages.Mode != "exige") mode = reglages.Mode;
    }

    // Échap ferme la fenêtre sauf saisie en cours
    private void Touche(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !enCours) Fermer();
    }

    public void Dispose() => minuteur?.Dispose();
}
