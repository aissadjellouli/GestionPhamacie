@page "/admin/reglage-tracabilite"
@inject ApiClient Api
@inject SessionPoste Session

@* Traçabilité des boîtes (lot M7, D8, titulaire) : scan obligatoire de chaque boîte vendue, et cas où le patient doit être identifié à la vente
   (jamais, psychotropes et stupéfiants, ordonnance, toujours). La base refuse la vente qui ne respecte pas le réglage (déclencheur du script 007).
   Chaque modification est inscrite au journal avec la valeur avant et après. Peut être fixé ou proposé par le serveur central (bandeau commun). *@
<div class="page admin">
    <NavAdmin Actif="admin/reglage-tracabilite" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Traçabilité</h1>
                <p class="sous-titre">Réservé au titulaire · chaque modification est inscrite au journal (valeur avant et après)</p>
            </div>
            <button type="button" class="btn btn-principal" disabled="@(p is null || enCours || Fixe)" @onclick="EnregistrerAsync">Enregistrer</button>
        </div>

        @if (!Session.A("role.titulaire"))
        {
            <div class="erreur" role="alert">Écran réservé au pharmacien titulaire.</div>
        }
        else
        {
            @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
            @if (message is not null) { <div class="succes" role="status">@message</div> }
            <ReglageCentral Table="parametre_tracabilite" OnAdopte="ChargerAsync" />

            @if (p is not null)
            {
                <fieldset class="panneau" aria-labelledby="t-tracabilite" disabled="@Fixe">
                    <div>
                        <h2 id="t-tracabilite">Boîtes et patients à la vente</h2>
                        <p class="sous-titre">La caisse refuse d’encaisser une vente qui ne respecte pas ces réglages.</p>
                    </div>
                    <label class="case"><input type="checkbox" data-champ="boite_obligatoire" @bind="p.BoiteObligatoire" /><span>Chaque boîte vendue doit être scannée</span></label>
                    <p class="detail" style="margin: 0">À n’activer qu’une fois tout le stock identifié (Stock › Étiquettes), sinon la caisse serait bloquée.</p>
                    <div class="champ" style="max-width: 520px">
                        <label for="t-patient" class="requis">Patient identifié obligatoire</label>
                        <select id="t-patient" data-champ="patient_obligatoire" @bind="p.PatientObligatoire">
                            <option value="jamais">Jamais</option>
                            <option value="psychotrope">Pour les psychotropes et stupéfiants</option>
                            <option value="ordonnance">Pour une ordonnance et pour les psychotropes et stupéfiants</option>
                            <option value="toujours">Pour toutes les ventes</option>
                        </select>
                    </div>
                </fieldset>
            }
            else if (erreur is null) { <Chargement /> }
        }
        <p class="pied-page">Sans serveur central, ces réglages se font ici. Avec un serveur central, il peut les fixer pour toutes les officines (« Fixé par le serveur central ») ou les proposer.</p>
    </div>
</div>

@code {
    private sealed class Saisie
    {
        public bool BoiteObligatoire { get; set; }
        public string PatientObligatoire { get; set; } = "ordonnance";
    }

    private Saisie? p;
    private bool enCours;
    private string? erreur, message;

    /// <summary>Réglages fixés par le serveur central (table parametre_tracabilite imposée).</summary>
    private bool Fixe => Api.ReglageCentral("parametre_tracabilite").Impose;

    protected override async Task OnInitializedAsync()
    {
        if (Session.A("role.titulaire")) await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        var (d, e) = await Api.ParametreTracabiliteAsync();
        erreur = e;
        if (d is not null) p = new Saisie { BoiteObligatoire = d.BoiteObligatoire, PatientObligatoire = d.PatientObligatoire };
    }

    private async Task EnregistrerAsync()
    {
        if (p is null) return;
        (enCours, erreur, message) = (true, null, null);
        try
        {
            erreur = await Api.EnregistrerParametreTracabiliteAsync(new ParametreTracabiliteDto(p.BoiteObligatoire, p.PatientObligatoire));
            if (erreur is not null) return;
            message = "Réglages de traçabilité enregistrés.";
            await ChargerAsync();
        }
        finally { enCours = false; }
    }
}
