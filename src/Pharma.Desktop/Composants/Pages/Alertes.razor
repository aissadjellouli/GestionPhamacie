@page "/"
@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique

@* Écran fixe : menu vertical à gauche (vue d'ensemble, puis les listes d'alertes) ; la liste défile dans son cadre *@
<div class="page avec-menu">
    <NavDomaine Libelle="Rubriques des alertes">
        <a href="?rubrique=ensemble" class="@(rubrique == "ensemble" ? "active" : null)" aria-current="@(rubrique == "ensemble" ? "page" : null)">Vue d’ensemble</a>
        <span class="nav-groupe-titre">Alertes ouvertes</span>
        @foreach (var f in Filtres)
        {
            <a href="@($"?rubrique={f.Id}")" class="sous-rubrique @(rubrique == f.Id ? "active" : null)" aria-current="@(rubrique == f.Id ? "page" : null)">
                @f.Libelle<span class="@(f.Id == "urgent" && f.Nombre > 0 ? "compteur" : "compteur neutre")">@f.Nombre</span>
            </a>
        }
        @if (donnees is not null)
        {
            <div class="nav-resume"><span class="detail">Valeur à risque</span><strong class="@(ValeurARisque > 0 ? "montant-du" : null)">@Libelles.Dinars(ValeurARisque)</strong></div>
        }
    </NavDomaine>

    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>Alertes du jour@(rubrique == "ensemble" ? "" : $" · {Filtres.First(f => f.Id == rubrique).Libelle}")<AideEcran Cle="" /></h1>
            <p class="sous-titre">@Libelles.Aujourdhui() · triées par urgence puis par montant en jeu</p>
        </div>
        @if (Session.A("admin.parametres"))
        {
            <a href="admin/seuils" class="btn">Paramètres des seuils</a>
        }
        else
        {
            <button type="button" class="btn" disabled title="Réservé au titulaire">Paramètres des seuils</button>
        }
    </div>

    @if (erreur is not null)
    {
        <div class="erreur" role="alert">@erreur</div>
    }
    else if (alertes is null)
    {
        <Chargement Texte="Chargement des alertes…" />
    }
    else if (rubrique == "ensemble")
    {
        <section class="tuiles" aria-label="Indicateurs">
            <div class="tuile">
                <span class="tuile-libelle">Valeur à risque (péremption)</span>
                <span class="tuile-valeur @(ValeurARisque > 0 ? "urgent" : null)">@Libelles.Dinars(ValeurARisque)</span>
                <span class="tuile-note">au prix d’achat</span>
            </div>
            <div class="tuile">
                <span class="tuile-libelle">Lots périmés à retirer</span>
                <span class="tuile-valeur">@Compter("perime")</span>
                <span class="tuile-note">vente bloquée automatiquement</span>
            </div>
            <div class="tuile">
                <span class="tuile-libelle">Ruptures</span>
                <span class="tuile-valeur">@Compter("rupture")</span>
                <span class="tuile-note">commande suggérée dans l’alerte</span>
            </div>
            <div class="tuile">
                <span class="tuile-libelle">Stock critique</span>
                <span class="tuile-valeur">@Compter("stock_critique")</span>
                <span class="tuile-note">commande suggérée dans l’alerte</span>
            </div>
        </section>

        @if (indicateurs is { } ind)
        {
            <section class="tuiles" aria-label="Péremptions à venir et règlements">
                @foreach (var h in ind.Peremption)
                {
                    <div class="tuile">
                        <span class="tuile-libelle">Périment dans @h.Jours jours</span>
                        <span class="tuile-valeur @(h.Jours <= 30 && h.Lots > 0 ? "urgent" : null)">@h.Lots lot(s)</span>
                        <span class="tuile-note">@h.Boites boîte(s) · @Libelles.Dinars(h.Valeur) au prix d’achat</span>
                    </div>
                }
                @if (ind.ReglementsAPreparer is { } nb)
                {
                    <div class="tuile">
                        <span class="tuile-libelle">Règlements grossistes à préparer</span>
                        <span class="tuile-valeur @(nb > 0 ? "urgent" : null)">@nb</span>
                        <span class="tuile-note">@Libelles.Dinars(ind.MontantAPreparer ?? 0) · factures en retard et effets à payer sous 7 jours
                            @if (nb > 0) { <br /><a href="achats?onglet=reglements">Préparer les règlements</a> }</span>
                    </div>
                }
            </section>
        }

        <p class="pied-page">Les listes d’alertes sont dans le menu à gauche : urgentes, péremption, stock, ou toutes.</p>
    }
    else
    {

        @if (confirmation is not null)
        {
            <div class="succes" role="status">@confirmation</div>
        }

        @if (Visibles.Count == 0)
        {
            <div class="carte vide">@(Filtres.First(f => f.Id == filtre).Libelle) : RAS, aucune alerte ouverte. Le stock est en ordre.</div>
        }
        else
        {
            <section class="liste cadre-defilant" aria-label="Liste des alertes">
                @foreach (var a in Visibles)
                {
                    <article class="carte alerte">
                        <div class="alerte-corps">
                            <div class="alerte-entete">
                                <span class="pastille @Libelles.ClasseNiveau(a.Niveau)">@Libelles.Niveau(a.Niveau)</span>
                                <span class="etiquette-type">@Libelles.TypeAlerte(a)</span>
                            </div>
                            <h2 class="alerte-titre">@Libelles.TitreAlerte(a)</h2>
                            <p class="alerte-detail">@Libelles.DetailAlerte(a)</p>
                            @if (a.Emplacement is not null)
                            {
                                <p class="alerte-detail" style="margin: 0">Rangé : <span class="code-emplacement">@a.Emplacement</span></p>
                            }
                        </div>
                        @if (a.ValeurDzd is { } valeur && Libelles.LibelleValeur(a) is { } libelle)
                        {
                            <div class="alerte-valeur">
                                <span>@libelle</span>
                                <span>@Libelles.Dinars(valeur)</span>
                            </div>
                        }
                        @if (enEdition != a.Id)
                        {
                            <div class="actions">
                                @if (Libelles.ActionAlerte(a) is { } action)
                                {
                                    if (LienAction(a) is { } lien)
                                    {
                                        <a class="btn btn-principal" href="@lien">@action</a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-principal" disabled title="@RaisonActionIndisponible(a)">@action</button>
                                    }
                                }
                                <button type="button" class="btn" @onclick="() => Ouvrir(a, Mode.Reporter)">Reporter</button>
                                <button type="button" class="btn" @onclick="() => Ouvrir(a, Mode.Traiter)">Traité</button>
                            </div>
                        }
                        else
                        {
                            <div class="action-en-cours">
                                @if (mode == Mode.Reporter)
                                {
                                    <div class="champ">
                                        <label for="report-@a.Id">Faire réapparaître l’alerte le</label>
                                        <input id="report-@a.Id" type="date" @bind="dateReport" min="@Demain.ToString("yyyy-MM-dd")" />
                                    </div>
                                }
                                else
                                {
                                    <div class="champ" style="flex: 1 1 320px">
                                        <label for="action-@a.Id">Action prise (facultatif)</label>
                                        <input id="action-@a.Id" type="text" @bind="actionPrise" maxlength="200"
                                               placeholder="@(Libelles.ActionAlerte(a) ?? "Ex. mis en avant en vitrine")" />
                                    </div>
                                }
                                <div class="actions">
                                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => ConfirmerAsync(a)">
                                        @(mode == Mode.Reporter ? "Reporter" : "Marquer traitée")
                                    </button>
                                    <button type="button" class="btn" disabled="@enCours" @onclick="Annuler">Annuler</button>
                                </div>
                                @if (erreurAction is not null) { <div class="erreur" role="alert" style="flex-basis: 100%">@erreurAction</div> }
                            </div>
                        }
                    </article>
                }
            </section>
            <Pagination Total="total" Numero="page" Taille="taille" Libelle="Pages des alertes" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
    }
    </div>
</div>

@code {
    /// <summary>Lien vers les Achats pour les actions disponibles, selon les droits de l'employé.</summary>
    private string? LienAction(AlerteDto a) => a.Type switch
    {
        "perime" when a.LotId is { } lotPerime && Session.A("stock.declarer_perime") => $"stock?sortie={lotPerime}",
        "rupture" or "stock_critique" when Session.A("achats.commander") =>
            $"achats?onglet=commandes&produit={a.ProduitId}&nom={Uri.EscapeDataString(a.Produit)}",
        "peremption" or "risque_ecoulement" when a.LotId is { } lot && Session.A("achats.retour_fournisseur") =>
            $"achats?onglet=retours&lot={lot}&motif=peremption_proche",
        // Produit qui ne se vend plus : le ranger plus en vue (emplacement de vente au comptoir)
        "dormant" when Session.A("stock.ajuster") => $"stock?ranger={a.ProduitId}",
        // Ancien lot délaissé (titulaire seul) : inventaire de tous les lots du produit
        "lot_delaisse" when Session.A("role.titulaire") => $"inventaire?produit={a.ProduitId}",
        _ => null
    };

    private static string RaisonActionIndisponible(AlerteDto a) => a.Type switch
    {
        "rupture" or "stock_critique" => "Droit « achats.commander » nécessaire",
        "peremption" or "risque_ecoulement" => "Droit « achats.retour_fournisseur » nécessaire",
        "perime" => "Droit « stock.declarer_perime » nécessaire",
        "dormant" => "Droit « stock.ajuster » nécessaire",
        "lot_delaisse" => "Réservé au pharmacien titulaire",
        _ => "Aucune action pour cette alerte"
    };

    private List<AlerteDto>? alertes;
    private string? erreur;
    private string filtre = "toutes";
    // Rubrique dans l'adresse (?rubrique=…) : vue d'ensemble ou une liste d'alertes ; « Retour » y revient
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique = "ensemble";
    private static readonly string[] Listes = ["toutes", "urgent", "peremption", "stock"];

    protected override async Task OnParametersSetAsync()
    {
        var voulue = Listes.Contains(Rubrique) ? Rubrique! : "ensemble";
        if (voulue == rubrique) return;
        rubrique = voulue;
        confirmation = null;
        if (Listes.Contains(rubrique) && filtre != rubrique) await ChoisirFiltreAsync(rubrique);
    }

    private sealed record Filtre(string Id, string Libelle, int Nombre);

    private enum Mode { Reporter, Traiter }

    private long? enEdition;
    private Mode mode;
    private DateOnly dateReport;
    private string actionPrise = "";
    private string? erreurAction;
    private string? confirmation;
    private bool enCours;

    private static DateOnly Demain => DateOnly.FromDateTime(DateTime.Today.AddDays(1));

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : filtre et page des alertes retrouvés tels qu'ils étaient
        Historique.Suivre("alertes", e => { e.Mettre("filtre", filtre); e.Mettre("page", page); e.Mettre("taille", taille); });
        var r = Historique.Restaurer("alertes");
        if (r?.Texte("filtre") is { } f) filtre = f;
        // La rubrique de l'adresse choisit la liste
        rubrique = Listes.Contains(Rubrique) ? Rubrique! : "ensemble";
        if (Listes.Contains(rubrique)) filtre = rubrique;
        await ChargerAsync(r?.Entier("page") ?? 1, r?.Entier("taille") ?? taille);
    }

    private IndicateursAlertesDto? indicateurs;

    // Liste paginée et filtrée par le serveur ; tuiles et onglets comptés sur toutes les alertes ouvertes (AlertesPageDto)
    private AlertesPageDto? donnees;
    private int total, page = 1, taille = Pagination.TailleParDefaut;

    private Task ChargerAsync() => ChargerAsync(page, taille);
    private Task ChoisirFiltreAsync(string id) { filtre = id; return ChargerAsync(1, taille); }

    private async Task ChargerAsync(int numero, int nouvelleTaille)
    {
        var (p, e) = await Api.AlertesPageAsync(filtre, numero, nouvelleTaille);
        if (e is not null) { erreur = e; return; }
        // Page au-delà de la fin (alerte traitée ou reportée) : retour à la première
        if (p!.Page.Lignes.Count == 0 && numero > 1) { await ChargerAsync(1, nouvelleTaille); return; }
        (donnees, alertes, total, page, taille, erreur) = (p, p.Page.Lignes.ToList(), p.Page.Total, p.Page.Numero, p.Page.Taille, null);
        (indicateurs, _) = await Api.IndicateursAlertesAsync();
    }

    private void Ouvrir(AlerteDto a, Mode m)
    {
        (enEdition, mode, erreurAction, confirmation) = (a.Id, m, null, null);
        dateReport = DateOnly.FromDateTime(DateTime.Today.AddDays(7));
        actionPrise = "";
    }

    private void Annuler() => (enEdition, erreurAction) = (null, null);

    private async Task ConfirmerAsync(AlerteDto a)
    {
        enCours = true;
        erreurAction = mode == Mode.Reporter
            ? await Api.ReporterAlerteAsync(a.Id, dateReport)
            : await Api.TraiterAlerteAsync(a.Id, actionPrise);
        enCours = false;
        if (erreurAction is not null) return;

        confirmation = mode == Mode.Reporter
            ? $"« {Libelles.TitreAlerte(a)} » reportée au {Libelles.Date(dateReport)}."
            : $"« {Libelles.TitreAlerte(a)} » marquée traitée.";
        enEdition = null;
        await ChargerAsync();
    }

    private int Compter(string type) => donnees?.ParType.GetValueOrDefault(type) ?? 0;


    private decimal ValeurARisque => donnees?.ValeurARisque ?? 0;

    private IEnumerable<Filtre> Filtres =>
        new[] { ("toutes", "Toutes"), ("urgent", "Urgentes"), ("peremption", "Péremption"), ("stock", "Stock") }
            .Select(f => new Filtre(f.Item1, f.Item2, donnees?.ParFiltre.GetValueOrDefault(f.Item1) ?? 0));

    private List<AlerteDto> Visibles => alertes ?? [];
}
