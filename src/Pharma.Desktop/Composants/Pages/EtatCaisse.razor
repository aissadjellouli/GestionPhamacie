@page "/caisse/etat"
@inject ApiClient Api

@* État intermédiaire de la caisse du poste : depuis l'ouverture, sans compter ni clôturer. Comptage aveugle strict : ni espèces,
   ni total, ni attendu ; le tiroir se compte par un comptage intermédiaire (écran de clôture, mode intermédiaire). *@
<div class="page avec-menu">
    <NavCaisse Actif="caisse/etat" OuverteLe="etat?.OuverteLe" OuvertePar="@etat?.OuvertePar" Fond="etat?.FondCaisse" Poste="@etat?.Poste" CaisseOuverte="@(!caisseFermee)" />
    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>État de la caisse<AideEcran Cle="caisse/etat" /></h1>
            <p class="sous-titre">Depuis l’ouverture de la caisse du poste, sans compter ni clôturer</p>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            @* « Retour à la caisse » retiré (2026-11-27) : doublon du « ← » de l'en-tête ; l'action claire est « Aller à la vente » *@
            @if (etat is not null)
            {
                <a href="cloture?intermediaire=true" class="btn btn-principal">Faire un comptage intermédiaire</a>
                <a href="caisse" class="btn">Aller à la vente</a>
            }
        </div>
    </div>

    @if (caisseFermee)
    {
        <CaisseFermee Explication="L’état de la caisse (ventes, paiements par mode, comptages intermédiaires) s’affiche ici une fois la caisse ouverte." />
    }
    else if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (etat is null && erreur is null && !caisseFermee) { <Chargement Texte="Chargement de l’état de la caisse…" /> }

    @if (etat is { } e)
    {
        <p class="detail" style="margin: 0">@e.Poste · ouverte le @Libelles.DateHeureLocale(e.OuverteLe)@(e.OuvertePar is { } par ? $" par {par}" : "") · fond de caisse @Libelles.Dinars(e.FondCaisse, 2)</p>

        <section class="tuiles tuiles-etat-caisse" aria-label="Récapitulatif depuis l’ouverture">
            @* Tuiles navigables (2026-11-21) : chacune ouvre l'écran qui la détaille, si l'employé peut l'ouvrir ; sinon chiffre seul *@
            <TuileLien Lien="rapports?rubrique=ventes" Infobulle="Ouvre les rapports › Ventes"><span class="tuile-libelle">Ventes</span><span class="tuile-valeur">@e.NombreVentes</span><span class="tuile-note">ventes validées</span></TuileLien>
            <TuileLien Lien="rapports?rubrique=ventes" Infobulle="Ouvre les rapports › Ventes"><span class="tuile-libelle">Carte</span><span class="tuile-valeur">@Libelles.Dinars(e.Carte, 2)</span><span class="tuile-note">net des remboursements</span></TuileLien>
            <TuileLien Lien="tresorerie?rubrique=cheques" Infobulle="Ouvre la trésorerie › Chèques à remettre"><span class="tuile-libelle">Chèque</span><span class="tuile-valeur">@Libelles.Dinars(e.Cheque, 2)</span><span class="tuile-note">net des remboursements</span></TuileLien>
            <TuileLien Lien="dettes?onglet=patient" Infobulle="Ouvre Dettes et créances › Patients"><span class="tuile-libelle">Crédit</span><span class="tuile-valeur">@Libelles.Dinars(e.Credit, 2)</span><span class="tuile-note">ventes à crédit</span></TuileLien>
            <TuileLien Lien="factures" Infobulle="Ouvre les factures (part des organismes à facturer)"><span class="tuile-libelle">Tiers payant</span><span class="tuile-valeur">@Libelles.Dinars(e.TiersPayant, 2)</span><span class="tuile-note">part des organismes</span></TuileLien>
            @if (e.Avoir != 0)
            {
                @* Avoirs des patients (script 106) : jamais des espèces, hors tiroir *@
                <TuileLien Lien="rapports?rubrique=ventes" Infobulle="Ouvre les rapports › Ventes"><span class="tuile-libelle">Avoir</span><span class="tuile-valeur">@Libelles.Dinars(e.Avoir, 2)</span><span class="tuile-note">payé par avoir, hors tiroir</span></TuileLien>
            }
        </section>
        <div class="info-bandeau" role="note">
            Comptage aveugle : les espèces, le total et le montant attendu dans le tiroir ne sont pas affichés.
            Pour connaître l’argent du tiroir, faites un comptage intermédiaire : il est enregistré, et l’écart s’affiche comme à la clôture, pour qui peut le voir.
        </div>

        <div class="colonnes">
            <section class="panneau" aria-labelledby="t-employes">
                <h2 id="t-employes">Ventes par employé</h2>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 0">
                        <thead><tr><th scope="col">Employé</th><th scope="col" class="nombre">Ventes</th></tr></thead>
                        <tbody>
                            @foreach (var v in e.ParEmploye) { <tr><td>@v.Employe</td><td class="nombre">@v.Ventes</td></tr> }
                            @if (e.ParEmploye.Count == 0) { <tr><td colspan="2" class="vide">Aucune vente depuis l’ouverture.<ActionSuivante Libelle="Aller à la vente" Lien="caisse" Droits='["caisse.vendre"]' /></td></tr> }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="panneau" aria-labelledby="t-comptages-inter">
                <h2 id="t-comptages-inter">Comptages intermédiaires</h2>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 0">
                        <thead><tr><th scope="col">Le</th><th scope="col">Compté par</th><th scope="col" class="nombre">Compté</th>@if (e.PeutVoirEcart) { <th scope="col" class="nombre">Écart</th> }</tr></thead>
                        <tbody>
                            @foreach (var c in e.Comptages)
                            {
                                <tr>
                                    <td style="white-space: nowrap">@Libelles.DateHeureLocale(c.Le)</td>
                                    <td>@c.Employe</td>
                                    <td class="nombre">@Libelles.Dinars(c.Compte, 2)</td>
                                    @if (e.PeutVoirEcart)
                                    {
                                        <td class="nombre" style="color: @(c.Ecart < 0 ? "var(--urgent)" : "var(--accent-texte)")">@(c.Ecart > 0 ? "+" : "")@Libelles.Dinars(c.Ecart ?? 0, 2)</td>
                                    }
                                </tr>
                            }
                            @if (e.Comptages.Count == 0) { <tr><td colspan="@(e.PeutVoirEcart ? 4 : 3)" class="vide">Aucun comptage intermédiaire depuis l’ouverture.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    }
    </div>
</div>

@code {
    private EtatIntermediaireDto? etat;
    private string? erreur;
    /// <summary>Le poste n'a pas de caisse ouverte (lu par l'état de la caisse) : état vide neutre au lieu de l'erreur du serveur.</summary>
    private bool caisseFermee;

    protected override async Task OnInitializedAsync()
    {
        // Caisse fermée : même état vide que la clôture (2026-11-27). L'état de la caisse est lu d'abord ; s'il est illisible, l'état
        // intermédiaire est demandé quand même et son message s'affiche comme avant.
        var (caisse, _) = await Api.EtatCaisseAsync();
        if (caisse is { SessionId: null }) { caisseFermee = true; return; }
        (etat, erreur) = await Api.EtatIntermediaireAsync();
    }
}
