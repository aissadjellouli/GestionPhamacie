@page "/admin/restauration"
@implements IDisposable
@inject ApiClient Api
@inject SessionPoste Session

<div class="page page-serree">
    <div class="titre-page">
        <div>
            <h1>Restauration</h1>
            <p class="sous-titre">Base de données et documents de la GED, depuis les sauvegardes du disque externe ou de la GED du serveur. Rien n’est jamais supprimé : l’ancienne base est gardée sous un autre nom.</p>
        </div>
        @if (Session.SuperAdmin)
        {
            <button type="button" class="btn" disabled="@(actualisation || EnCours)" @onclick="ActualiserAsync">@(actualisation ? "Actualisation…" : "Actualiser")</button>
        }
    </div>
    @if (actualise is not null) { <p class="detail" role="status" style="margin: 0">@actualise</p> }

    @if (!Session.SuperAdmin)
    {
        <div class="erreur" role="alert">Réservé au super admin : déconnectez-vous, puis « Connexion super admin » sur l’écran de connexion.</div>
    }
    else
    {
        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

        @* Écran fixe (2026-11-16) : sauvegardes de la base à gauche (seul le tableau défile), suivi et GED à droite *@
        <div class="restauration-colonnes">
            @if (choix is { } c)
            {
                <section class="panneau" aria-labelledby="t-base">
                    <h2 id="t-base">Base de données</h2>
                    <p style="margin: 0">
                        Base en service : <strong>@c.NomBase</strong> @(c.BaseExiste ? "" : "(absente : la sauvegarde choisie la recréera)") ·
                        disque externe : @(c.DossierExterne is null ? "dossier des sauvegardes non réglé" : c.DisqueBranche ? c.DossierExterne : $"{c.DossierExterne} (non branché)")
                    </p>
                    @if (c.Sauvegardes.Count == 0)
                    {
                        <p class="detail" style="margin: 0">Aucune sauvegarde trouvée : branchez le disque externe des sauvegardes, puis « Actualiser ».</p>
                    }
                    else
                    {
                        @* Sauvegardes trouvées : filtrées par période et paginées à l'écran (règle des listes) *@
                        <div class="filtres-liste" role="search" aria-label="Filtrer les sauvegardes">
                            <div class="champ" style="flex: 0 0 160px"><label for="fr-du">Du</label><input id="fr-du" type="date" @bind="fDu" @bind:after="() => page = 1" /></div>
                            <div class="champ" style="flex: 0 0 160px"><label for="fr-au">Au</label><input id="fr-au" type="date" @bind="fAu" @bind:after="() => page = 1" /></div>
                            @if (fDu is not null || fAu is not null) { <button type="button" class="btn" @onclick="() => (fDu, fAu, page) = (null, null, 1)">Tout afficher</button> }
                        </div>
                        <div class="tableau-cadre">
                            <table class="tableau" style="min-width: 0">
                                <thead><tr><th scope="col">Sauvegarde du</th><th scope="col">Emplacement</th><th scope="col">Fichier</th><th scope="col" class="nombre">Taille</th><th scope="col"></th></tr></thead>
                                <tbody>
                                    @foreach (var s in Filtrees(c.Sauvegardes).Skip((page - 1) * taille).Take(taille))
                                    {
                                        <tr>
                                            <td>@Libelles.DateHeureLocale(s.Date)</td><td>@s.Emplacement</td>
                                            <td class="detail">@System.IO.Path.GetFileName(s.Fichier)</td>
                                            <td class="nombre">@((s.Taille / 1048576.0).ToString("N1")) Mo</td>
                                            <td><button type="button" class="btn btn-danger" disabled="@EnCours" @onclick="() => DemanderBase(s)">Restaurer</button></td>
                                        </tr>
                                    }
                                    @if (Filtrees(c.Sauvegardes).Count == 0) { <tr><td colspan="5" class="vide">Aucune sauvegarde sur cette période.</td></tr> }
                                </tbody>
                            </table>
                        </div>
                        <Pagination Total="Filtrees(c.Sauvegardes).Count" Numero="page" Taille="taille" Libelle="Pages des sauvegardes" OnChange="p => (page, taille) = (p.Numero, p.Taille)" />
                    }
                </section>
            }
            <div class="restauration-droite">
                @if (etat is { Type: not null } e)
                {
                <section class="panneau" aria-labelledby="t-suivi" aria-live="polite">
                    <h2 id="t-suivi">@(e.Type == "base" ? "Restauration de la base" : "Restauration de la GED") · @(e.EnCours ? "en cours…" : e.Erreur is null ? "terminée" : "échouée")</h2>
                    <ol class="detail" style="margin: 0; padding-left: 20px">
                        @foreach (var etape in e.Etapes) { <li>@etape</li> }
                    </ol>
                    @if (e.Resultat is not null) { <div class="succes" role="status">@e.Resultat</div> }
                    @if (e.Erreur is not null) { <div class="erreur" role="alert">@e.Erreur</div> }
                </section>
                }
                @if (choix is not null)
                {
                <section class="panneau" aria-labelledby="t-ged">
                    <h2 id="t-ged">Documents de la GED</h2>
                    @if (choix.SourceGed is { } source)
                    {
                        <p style="margin: 0">Copie trouvée : <strong>@source</strong>. Les documents absents ou plus anciens au serveur sont recopiés ; rien n’est supprimé et les documents plus récents du serveur sont gardés.</p>
                        <div><button type="button" class="btn btn-danger" disabled="@EnCours" @onclick="DemanderGed">Recopier les documents de la GED</button></div>
                    }
                    else
                    {
                        <p class="detail" style="margin: 0">Copie de la GED introuvable : branchez le disque externe des sauvegardes (sous-dossier GED).</p>
                    }
                </section>
                }
            </div>
        </div>
    }
</div>

<FenetreValidationSuperAdmin Demande="validation" Fermee="() => validation = null" />

@code {
    // Sauvegardes trouvées : période et page (à l'écran)
    private DateOnly? fDu, fAu;
    private int page = 1, taille = Pagination.TailleParDefaut;
    private List<SauvegardeDisponibleDto> Filtrees(IEnumerable<SauvegardeDisponibleDto> sauvegardes) => sauvegardes.Where(s =>
        DateOnly.FromDateTime(s.Date.ToLocalTime()) is var d && (fDu is null || d >= fDu) && (fAu is null || d <= fAu)).ToList();

    private ChoixRestaurationDto? choix;
    private EtatRestaurationDto? etat;
    private string? erreur;
    private FenetreValidationSuperAdmin.DemandeSuperAdmin? validation;
    private PeriodicTimer? suivi;

    private bool EnCours => etat?.EnCours == true;

    protected override async Task OnInitializedAsync()
    {
        // Pas de « ← Retour » : l'écran n'est jamais rouvert (HistoriqueNavigation.JamaisRouverts), période et page repartent à zéro
        if (!Session.SuperAdmin) return;
        (etat, _) = await Api.EtatRestaurationAsync();
        await ChargerAsync();
        if (EnCours) _ = SuivreAsync();
    }

    private async Task ChargerAsync()
    {
        string? e;
        (choix, e) = await Api.ChoixRestaurationAsync();
        erreur = e;
    }

    // « Actualiser » : sauvegardes, disque externe et dernière restauration relus ; l'heure montre que c'est fait
    private bool actualisation;
    private string? actualise;

    private async Task ActualiserAsync()
    {
        actualisation = true;
        try
        {
            var (e, _) = await Api.EtatRestaurationAsync();
            if (e is not null) etat = e;
            await ChargerAsync();
            actualise = erreur is not null ? null
                : $"Liste actualisée à {DateTime.Now:HH:mm:ss} : {choix!.Sauvegardes.Count} sauvegarde(s), disque externe " +
                  (choix.DossierExterne is null ? "non réglé." : choix.DisqueBranche ? "branché." : "non branché.");
            if (EnCours) _ = SuivreAsync();
        }
        finally { actualisation = false; }
    }

    private void DemanderBase(SauvegardeDisponibleDto s)
    {
        var date = Libelles.DateHeureLocale(s.Date);
        validation = new("restauration.base", $"Restaurer la base depuis la sauvegarde du {date}",
            $"La base « {choix!.NomBase} » va être REMPLACÉE par la sauvegarde du {date} ({s.Emplacement}). Toutes les opérations faites après cette date " +
            "(ventes, réceptions, règlements…) seront absentes et à ressaisir. Pendant la restauration, les postes sont mis en attente. " +
            "La base actuelle n’est pas supprimée : elle est gardée sous un autre nom, et une copie de sécurité est faite avant.",
            () => LancerAsync(() => Api.RestaurerBaseAsync(s.Fichier)));
    }

    private void DemanderGed()
    {
        validation = new("restauration.ged", "Restaurer les documents de la GED",
            $"Les documents de « {choix!.SourceGed} » vont être recopiés dans la GED du serveur : ceux qui manquent ou y sont plus anciens. " +
            "Rien n’est supprimé ; un document plus récent au serveur est gardé.",
            () => LancerAsync(Api.RestaurerGedAsync));
    }

    /// <summary>Restauration lancée (validée par code) : le serveur la fait en tâche de fond, l'écran suit les étapes.</summary>
    private async Task<string?> LancerAsync(Func<Task<(EtatRestaurationDto?, string?)>> lancer)
    {
        var (e, err) = await lancer();
        if (err is not null) return err;
        etat = e;
        _ = SuivreAsync();
        return null;
    }

    private async Task SuivreAsync()
    {
        suivi?.Dispose();
        suivi = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await suivi.WaitForNextTickAsync())
            {
                var (e, _) = await Api.EtatRestaurationAsync();
                if (e is not null) etat = e;
                if (!EnCours)
                {
                    await ChargerAsync();
                    await InvokeAsync(StateHasChanged);
                    break;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException) { /* écran quitté */ }
    }

    public void Dispose() => suivi?.Dispose();
}
