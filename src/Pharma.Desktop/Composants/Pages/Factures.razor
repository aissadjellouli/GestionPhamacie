@page "/factures"
@inject ApiClient Api
@inject SessionPoste Session
@inject NavigationManager Nav
@inject HistoriqueNavigation Historique
@inject TachesLaissees Taches

<div class="page avec-menu">
    <NavDomaine Libelle="Écrans des finances" />
    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>Factures<AideEcran Cle="factures" /></h1>
            <p class="sous-titre">Patients, entreprises et organismes : ventes, ordonnances, lignes libres ; rejets, corrections, avoirs et suivi des encaissements</p>
        </div>
        <button type="button" class="btn btn-principal" @onclick="() => Editer(Nouvelle, null)">Nouvelle facture</button>
    </div>

    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }

    @if (mode is not null)
    {
        <EditeurFacture @key="cleEditeur" Mode="@mode" Origine="origine" Reprise="@repriseFacture" OnFerme="() => (mode, repriseFacture) = (null, null)" OnTermine="TermineAsync" />
    }

    <!-- Filtres -->
    <div class="filtres" role="tablist" aria-label="Suivi">
        @foreach (var (code, libelle) in Suivis)
        {
            <button type="button" role="tab" class="puce" aria-selected="@(suivi == code ? "true" : "false")" aria-pressed="@(suivi == code ? "true" : "false")"
                    @onclick="() => ChoisirSuivi(code)">@libelle</button>
        }
    </div>
    <div class="achats-ligne" style="align-items: flex-end">
        <div class="champ" style="flex: 1 1 220px"><label for="l-q">N° ou destinataire</label><input id="l-q" type="search" @bind="recherche" @bind:after="PremierePageAsync" /></div>
        <div class="champ" style="flex: 0 0 170px"><label for="l-dest">Destinataire</label>
            <select id="l-dest" @bind="filtreDestinataire" @bind:after="PremierePageAsync"><option value="">Tous</option><option value="patient">Patients</option><option value="entreprise">Entreprises</option><option value="organisme">Organismes</option></select></div>
        <div class="champ" style="flex: 0 0 160px"><label for="l-du">Du</label><input id="l-du" type="date" @bind="du" @bind:after="PremierePageAsync" /></div>
        <div class="champ" style="flex: 0 0 160px"><label for="l-au">Au</label><input id="l-au" type="date" @bind="au" @bind:after="PremierePageAsync" /></div>
    </div>

    <div class="tableau-cadre">
        <table class="tableau">
            <thead><tr><th scope="col">N°</th><th scope="col">Établie le</th><th scope="col">Échéance</th><th scope="col">Destinataire</th><th scope="col" class="nombre">TTC</th><th scope="col" class="nombre">Payé / réglé</th>
                <th scope="col" class="nombre">Reste</th><th scope="col">État</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
            <tbody>
                @foreach (var f in factures)
                {
                    <tr class="@(detail?.Resume.Id == f.Id ? "ligne-choisie" : null)">
                        <td style="white-space: nowrap"><strong>@f.Numero</strong>@(f.Version > 1 ? $" v{f.Version}" : "")</td>
                        <td>@f.Date.ToString("dd/MM/yyyy")</td>
                        <td style="white-space: nowrap">
                            @if (f.Echeance is { } echeance)
                            {
                                var echue = f.Reste > 0 && f.Statut != "remplacee" && !f.HorsSuivi && echeance < DateOnly.FromDateTime(DateTime.Today);
                                <span class="@(echue ? "texte-urgent" : null)">@echeance.ToString("dd/MM/yyyy")</span>
                                @if (echue) { <br /><span class="pastille urgent">Échue</span> }
                            }
                            else { <span>—</span> }
                        </td>
                        @{ var cf = Libelles.ContactFacture(f.Destinataire, f.PatientId, f.ClientId, f.OrganismeId); }
                        <td><LienContact Type="@cf.Type" Id="cf.Id" Nom="@f.DestinataireNom" /><br /><span class="detail">@Destinataire(f.Destinataire)</span></td>
                        <td class="nombre" style="white-space: nowrap">@Libelles.Dinars(f.Ttc, 2)</td>
                        <td class="nombre" style="white-space: nowrap">@Libelles.Dinars(f.Type == "avoir" || f.Statut == "remplacee" ? f.DejaPaye + f.Regle + f.Avoirs : f.Ttc - f.Reste, 2)</td>
                        <td class="nombre" style="white-space: nowrap">@(f.Type == "avoir" ? "—" : Libelles.Dinars(f.Reste, 2))</td>
                        <td>@Etat(f)</td>
                        <td><button type="button" class="lien-bouton" @onclick="() => OuvrirAsync(f.Id)">Ouvrir</button></td>
                    </tr>
                }
                @if (factures.Count == 0) { <tr><td colspan="9" class="vide">Aucune facture.</td></tr> }
            </tbody>
            @if (totalReste > 0 && factures.Count > 0)
            {
                <tfoot><tr><th scope="row" colspan="6">Reste à encaisser, toutes pages (@total.ToString("N0") ligne(s), factures : @Libelles.Dinars(totalTtc, 2) TTC)</th><td class="nombre"><strong>@Libelles.Dinars(totalReste, 2)</strong></td><td colspan="2"></td></tr></tfoot>
            }
        </table>
    </div>
    <Pagination Total="total" Numero="page" Taille="taille" Occupe="enCours" Libelle="Pages des factures" OnChange="p => AllerPageAsync(p.Numero, p.Taille)" />

    @if (detail is { } d)
    {
        var r = d.Resume;
        @* Facture ouverte dans une fenêtre au-dessus de la liste : Fermer, ou un clic à côté de la fenêtre, y ramène *@
        <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-detail" tabindex="-1" @ref="fenetre" @onkeydown="ToucheFenetre" @onclick="ClicACote">
        <section class="panneau fenetre-facture" @onclick:stopPropagation="true">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px">
                <h2 id="t-detail">@(r.Type == "avoir" ? "Avoir" : "Facture") @r.Numero@(versionVue is { } vv && vv != r.Version ? $" · version {vv} (historique)" : r.Version > 1 ? $" · version {r.Version}" : "")</h2>
                <div class="filtres">
                    <button type="button" class="btn" @onclick="() => PdfAsync(d)">Imprimer (PDF)</button>
                    <button type="button" class="btn" @onclick="FermerDetail">Fermer</button>
                </div>
            </div>
            @* Résultat des actions faites dans la fenêtre (rejet, avoir, suivi) : affiché ici, la liste est masquée derrière *@
            @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
            @if (message is not null)
            {
                <div class="succes" role="status" data-champ="confirmation">
                    @message
                    @if (pdfOuvert is { } pdf) { <button type="button" class="lien-bouton" @onclick="() => Documents.Ouvrir(pdf)">Ouvrir de nouveau</button> }
                </div>
            }
            @{ var cd =Libelles.ContactFacture(r.Destinataire, d.PatientId, d.ClientId, r.OrganismeId); }
            <p style="margin: 0"><strong><LienContact Type="@cd.Type" Id="cd.Id" Nom="@r.DestinataireNom" /></strong> · @Destinataire(r.Destinataire) · établie le @r.Date.ToString("dd/MM/yyyy")@(r.Echeance is { } ech ? $" · échéance le {ech:dd/MM/yyyy}" : "") · par <LienContact Type="employe" Id="d.EmployeId" Nom="@d.Employe" /></p>
            @if (d.DestinataireInfos is { } inf) { <p class="detail" style="margin: 0; white-space: pre-line">@inf</p> }
            <p style="margin: 0">@Etat(r)</p>
            @if (r.HorsSuivi) { <div class="info-bandeau" role="status">Hors suivi de trésorerie : @r.MotifHorsSuivi</div> }
            @if (r.MotifRejet is { } mr)
            {
                @if (r.Reste > 0) { <div class="erreur" role="status">Rejetée : @mr</div> }
                else { <div class="info-bandeau" role="status">Payée en entier après son rejet (« @mr ») : elle est soldée. Le rejet reste dans l’historique.</div> }
            }

            <div class="tableau-cadre">
                <table class="tableau">
                    <thead><tr><th scope="col">Désignation</th><th scope="col" class="nombre">Qté</th><th scope="col" class="nombre">P.U. TTC</th><th scope="col" class="nombre">TVA</th><th scope="col" class="nombre">Montant TTC</th></tr></thead>
                    <tbody>
                        @foreach (var l in d.Lignes)
                        {
                            <tr><td>@l.Designation</td><td class="nombre">@l.Quantite.ToString("0.##")</td><td class="nombre">@Libelles.Dinars(l.PrixUnitaireTtc, 2)</td>
                                <td class="nombre">@l.TauxTva.ToString("0.##") %</td><td class="nombre" style="white-space: nowrap">@Libelles.Dinars(l.MontantTtc, 2)</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th scope="row" colspan="4">Total HT · TVA</th><td class="nombre">@Libelles.Dinars(d.Ht, 2) · @Libelles.Dinars(d.Tva, 2)</td></tr>
                        <tr><th scope="row" colspan="4">Total TTC</th><td class="nombre"><strong>@Libelles.Dinars(r.Ttc, 2)</strong></td></tr>
                        @if (r.Type == "facture")
                        {
                            @if (r.DejaPaye > 0) { <tr><th scope="row" colspan="4">Déjà payé au comptoir</th><td class="nombre">@Libelles.Dinars(r.DejaPaye, 2)</td></tr> }
                            @if (d.RegleParDette > 0) { <tr><th scope="row" colspan="4">Déjà réglé par le patient sur sa dette (ventes à crédit)</th><td class="nombre">@Libelles.Dinars(d.RegleParDette, 2)</td></tr> }
                            @if (r.Regle > 0) { <tr><th scope="row" colspan="4">Règlements de la facture</th><td class="nombre">@Libelles.Dinars(r.Regle, 2)</td></tr> }
                            @if (r.Avoirs > 0) { <tr><th scope="row" colspan="4">Avoirs</th><td class="nombre">− @Libelles.Dinars(r.Avoirs, 2)</td></tr> }
                            <tr><th scope="row" colspan="4">Reste à payer</th><td class="nombre"><strong>@Libelles.Dinars(r.Reste, 2)</strong></td></tr>
                        }
                    </tfoot>
                </table>
            </div>

            @if (historique.Count > 0 && (versionVue is null || versionVue == r.Version))
            {
                <h3 class="sous-titre-panneau">Historique</h3>
                <div class="tableau-cadre">
                    <table class="tableau" style="min-width: 0">
                        <thead><tr><th scope="col">Date</th><th scope="col">Événement</th><th scope="col" class="nombre">Montant</th><th scope="col">Par</th></tr></thead>
                        <tbody>
                            @foreach (var h in historique)
                            {
                                <tr>
                                    <td style="white-space: nowrap">@Libelles.DateHeureLocale(h.Date)</td>
                                    <td>@h.Libelle@if (h.Detail is { } det) { <br /><span class="detail">@det</span> }</td>
                                    <td class="nombre" style="white-space: nowrap">@(h.Montant is { } m ? Libelles.Dinars(m, 2) : "")</td>
                                    <td>@if (h.Employe is { } emp) { <LienContact Type="employe" Id="h.EmployeId" Nom="@emp" /> } else { <span>—</span> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (d.Versions.Count > 0)
            {
                <p class="detail" style="margin: 0">Versions précédentes :
                    @foreach (var v in d.Versions)
                    {
                        <button type="button" class="lien-bouton" style="margin-left: 6px" @onclick="() => OuvrirAsync(r.Id, v)">version @v</button>
                    }
                    @if (versionVue is not null && versionVue != r.Version) { <button type="button" class="lien-bouton" style="margin-left: 6px" @onclick="() => OuvrirAsync(r.Id)">version en vigueur</button> }
                </p>
            }

            @if (r.Type == "facture" && (versionVue is null || versionVue == r.Version))
            {
                <h3 class="sous-titre-panneau">Actions</h3>
                <div class="achats-ligne" style="align-items: flex-end">
                    <div class="champ" style="flex: 1 1 260px"><label for="a-motif">Motif (rejet, levée du rejet, avoir, retrait du suivi)</label><input id="a-motif" data-champ="motif" type="text" maxlength="300" @bind="motifAction" /></div>
                    @if (r.Statut != "remplacee")
                    {
                        <div class="champ" style="flex: 0 0 150px"><label for="a-avoir">Montant de l’avoir</label><input id="a-avoir" data-champ="montant_avoir" type="number" min="0.01" step="0.01" @bind="montantAvoir" /></div>
                    }
                </div>
                <div class="filtres">
                    @if (r.Statut == "emise")
                    {
                        <button type="button" class="btn" disabled="@enCours" @onclick="RejeterAsync">Enregistrer un rejet</button>
                    }
                    @if (r.Statut == "rejetee")
                    {
                        <button type="button" class="btn" disabled="@enCours" @onclick="LeverRejetAsync">Lever le rejet</button>
                    }
                    @* Payée en entier (soldée) : correction et remplacement réservés au titulaire *@
                    @if (r.Statut == "rejetee" && (r.Reste > 0 || Session.A("role.titulaire")))
                    {
                        <button type="button" class="btn btn-principal" @onclick="() => Editer(Correction, d)">Corriger (même numéro)</button>
                        <button type="button" class="btn" @onclick="() => Editer(Remplacement, d)">Remplacer par une nouvelle facture</button>
                    }
                    @if (r.Statut != "remplacee")
                    {
                        <button type="button" class="btn" disabled="@(enCours || montantAvoir <= 0)" @onclick="AvoirAsync">Émettre un avoir</button>
                        <button type="button" class="btn" disabled="@enCours" @onclick="SuiviAsync">@(r.HorsSuivi ? "Remettre dans le suivi de trésorerie" : "Retirer du suivi de trésorerie")</button>
                    }
                </div>
            }
        </section>
        </div>
    }
</div>
</div>

@code {
    private const string Nouvelle = "nouvelle", Correction = "correction", Remplacement = "remplacement";
    private static readonly (string?, string)[] Suivis =
        [(null, "Toutes"), ("a_encaisser", "À encaisser"), ("echues", "Échues"), ("soldees", "Soldées"), ("rejetees", "Rejetées"), ("hors_suivi", "Hors suivi"), ("avoirs", "Avoirs")];

    private List<FactureResumeDto> factures = [];
    // Liste paginée : total et montants calculés par le serveur sur toutes les factures qui répondent aux filtres
    private int total, page = 1, taille = Pagination.TailleParDefaut;
    private decimal totalTtc, totalReste;
    private FactureDetailDto? detail, origine;
    private int? versionVue;
    private string? suivi, recherche, filtreDestinataire, erreur, message, mode, motifAction;
    private DateOnly? du, au;
    private decimal montantAvoir;
    private List<EvenementFactureDto> historique = [];
    private bool enCours;
    private int cleEditeur;

    // Arrivée depuis une fiche contact : liste filtrée sur le nom du tiers
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    private string? qApplique;
    private bool initialise;

    // Onglet de suivi dans l'adresse (factures?suivi=…) : chaque onglet est un écran pour « ← Retour »
    [SupplyParameterFromQuery(Name = "suivi")] public string? Suivi { get; set; }
    private void ChoisirSuivi(string? code) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("suivi", code));

    protected override async Task OnInitializedAsync()
    {
        (recherche, qApplique, suivi) = (Q, Q, Suivi);
        // « ← Retour » : filtres, page et facture ouverte retrouvés tels qu'ils étaient
        Historique.Suivre("factures", e =>
        {
            e.Mettre("recherche", recherche); e.Mettre("destinataire", filtreDestinataire); e.Mettre("du", du); e.Mettre("au", au);
            e.Mettre("page", page); e.Mettre("taille", taille); e.Mettre("detail", detail?.Resume.Id); e.Mettre("version", versionVue);
            // Éditeur ouvert (nouvelle facture, correction, remplacement) : rouvert au retour, sa saisie est retenue par l'éditeur
            e.Mettre("editeur", mode); e.Mettre("origine", origine?.Resume.Id); e.Mettre("versionOrigine", origine?.Resume.Version);
        });
        var r = Historique.Restaurer("factures");
        if (r is not null)
        {
            (recherche, filtreDestinataire, du, au) = (r.Texte("recherche"), r.Texte("destinataire"), r.Date("du"), r.Date("au"));
            (page, taille) = (r.Entier("page") ?? 1, r.Entier("taille") ?? taille);
        }
        await ChargerAsync();
        if (r?.Long("detail") is { } id) await OuvrirAsync(id, r.Entier("version"));
        if (r?.Texte("editeur") is { } m)
        {
            FactureDetailDto? o = null;
            if (r.Long("origine") is { } oid) (o, _) = await Api.FactureAsync(oid, r.Entier("versionOrigine"));
            if (r.Long("origine") is null || o is not null) Editer(m, o);
        }
        else
        {
            Historique.Restaurer("editeur-facture");   // éditeur fermé quand on est parti : son ancienne saisie est écartée
            // Bandeau « tâches laissées » : facture en préparation laissée par l'employé précédent, rouverte telle quelle
            if (Taches.PrendreChoisie("facture") is { } t && System.Text.Json.JsonSerializer.Deserialize<FactureLaissee>(t.Contenu) is { } f)
            {
                FactureDetailDto? o = null;
                if (f.OrigineId is { } oid) (o, _) = await Api.FactureAsync(oid, f.OrigineVersion);
                if (f.OrigineId is null || o is not null)
                {
                    Editer(f.Mode, o);
                    (repriseFacture, message) = (f.Preparation, $"Facture en préparation reprise : {t.LaisseePar} l’a laissée en changeant d’utilisateur.");
                }
            }
        }
        initialise = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!initialise) return;
        if (Q != qApplique) { (recherche, qApplique) = (Q, Q); await PremierePageAsync(); }
        if (Suivi != suivi) { suivi = Suivi; await PremierePageAsync(); }
    }

    /// <summary>Un filtre a changé : retour à la première page.</summary>
    private Task PremierePageAsync() { page = 1; return ChargerAsync(); }

    private Task AllerPageAsync(int numero, int nouvelleTaille) { (page, taille) = (numero, nouvelleTaille); return ChargerAsync(); }

    private async Task ChargerAsync()
    {
        var (p, e) = await Api.FacturesPageAsync(recherche, string.IsNullOrEmpty(filtreDestinataire) ? null : filtreDestinataire, suivi, du, au, page, taille);
        // Un rechargement réussi efface l'erreur précédente ; une erreur d'action en cours (déjà affichée) est gardée
        if (e is not null) { erreur ??= e; return; }
        // Page au-delà de la fin (une facture de moins après une action) : retour à la précédente
        if (p!.Page.Lignes.Count == 0 && page > 1) { page--; await ChargerAsync(); return; }
        (factures, total, page, totalTtc, totalReste) = (p.Page.Lignes.ToList(), p.Page.Total, p.Page.Numero, p.TotalTtc, p.TotalReste);
    }


    private async Task OuvrirAsync(long id, int? version = null)
    {
        var (d, e) = await Api.FactureAsync(id, version);
        if (e is not null) { erreur = e; return; }
        (detail, versionVue, motifAction, montantAvoir) = (d, version ?? d!.Resume.Version, null, 0);
        donnerFocus = true;
        (historique, _) = await Api.HistoriqueFactureAsync(id);
    }

    private void FermerDetail() => (detail, erreur, message, pdfOuvert) = (null, null, null, null);

    /// <summary>Copie locale du dernier PDF ouvert (bouton « Ouvrir » du message de confirmation).</summary>
    private string? pdfOuvert;

    // Fenêtre de la facture : Échap la ferme ; un clic à côté aussi, sauf si un motif ou un montant est en cours de saisie
    private ElementReference fenetre;
    private bool donnerFocus;

    private void ToucheFenetre(KeyboardEventArgs e) { if (e.Key == "Escape") FermerDetail(); }

    private void ClicACote() { if (string.IsNullOrWhiteSpace(motifAction) && montantAvoir == 0) FermerDetail(); }

    protected override async Task OnAfterRenderAsync(bool premierAffichage)
    {
        // Le focus va à la fenêtre à son ouverture, pour que la touche Échap y arrive
        if (!donnerFocus || detail is null) return;
        donnerFocus = false;
        await fenetre.FocusAsync();
    }

    /// <summary>Préparation laissée par l'employé précédent, transmise une fois à l'éditeur.</summary>
    private string? repriseFacture;

    private void Editer(string m, FactureDetailDto? d)
    {
        repriseFacture = null;   // une ouverture normale ne reprend jamais une préparation laissée (la reprise la repose après)
        // Correction ou remplacement : la fenêtre de la facture se ferme, l'éditeur prend sa place dans la page
        detail = null;
        (mode, origine, erreur, message, pdfOuvert) = (m, d, null, null, null);
        cleEditeur++;
    }

    private async Task TermineAsync((long Id, string Numero) f)
    {
        message = mode switch
        {
            "correction" => $"Facture {f.Numero} corrigée (nouvelle version).",
            "remplacement" => $"Facture {f.Numero} émise ; la facture {origine?.Resume.Numero} est marquée « remplacée », hors comptabilité.",
            _ => $"Facture {f.Numero} émise."
        };
        mode = null;
        await ChargerAsync();
        await OuvrirAsync(f.Id);
        if (detail is not null) await PdfAsync(detail);
    }

    private async Task PdfAsync(FactureDetailDto d)
    {
        var version = versionVue is { } v && v != d.Resume.Version ? v : (int?)null;
        var (contenu, nom, e) = await Api.FacturePdfAsync(d.Resume.Id, d.Resume.Numero, version);
        (erreur, message, pdfOuvert) = (null, null, null);
        if (e is not null) { erreur = e; return; }
        try
        {
            var doc = await Documents.RangerAsync(Api, "Factures", nom!, contenu!);
            Documents.Ouvrir(doc.CheminLocal);
            // Confirmation visible : la visionneuse PDF peut s'ouvrir derrière le logiciel
            (pdfOuvert, erreur) = (doc.CheminLocal, doc.Erreur);
            message = doc.CheminGed is not null
                ? $"Facture {d.Resume.Numero}{(version is { } n ? $" (version {n})" : "")} enregistrée dans la GED ({doc.CheminGed}) et ouverte."
                : $"Facture {d.Resume.Numero} ouverte.";
        }
        catch (Exception ex) { erreur = $"Facture impossible à ouvrir : {ex.Message}"; }
    }

    private Task LeverRejetAsync() => Agir(() => Api.LeverRejetFactureAsync(detail!.Resume.Id, motifAction), "Rejet levé : la facture est de nouveau émise.");
    private Task RejeterAsync() => Agir(() => Api.RejeterFactureAsync(detail!.Resume.Id, motifAction), "Rejet enregistré : corrigez la facture ou remplacez-la.");

    private Task AvoirAsync() => Agir(async () => (await Api.AvoirFactureAsync(detail!.Resume.Id, montantAvoir, motifAction)).Item2, "Avoir émis.");

    private Task SuiviAsync()
    {
        var retirer = !detail!.Resume.HorsSuivi;
        return Agir(() => Api.SuiviFactureAsync(detail.Resume.Id, retirer, motifAction),
            retirer ? "Facture retirée du suivi de trésorerie (elle reste valable)." : "Facture remise dans le suivi de trésorerie.");
    }

    private async Task Agir(Func<Task<string?>> action, string succes)
    {
        (enCours, erreur, message, pdfOuvert) = (true, null, null, null);
        var e = await action();
        enCours = false;
        if (e is not null) { erreur = e; return; }
        message = succes;
        var id = detail!.Resume.Id;
        await ChargerAsync();
        await OuvrirAsync(id);
    }

    private static string Destinataire(string d) => d switch { "organisme" => "Organisme", "entreprise" => "Entreprise", _ => "Patient" };

    private static string Etat(FactureResumeDto f) => f.Type == "avoir"
        ? $"Avoir sur {f.OrigineNumero}"
        : f.Statut switch
        {
            "rejetee" => f.Reste <= 0 && !f.HorsSuivi ? "Soldée (après un rejet)" : "Rejetée",
            "remplacee" => $"Remplacée par {f.RemplaceeParNumero} (non comptabilisée)",
            _ => (f.HorsSuivi ? "Hors suivi" : f.Reste <= 0 ? "Soldée" : "À encaisser") + (f.RemplaceNumero is { } x ? $" · remplace {x}" : "")
        };
}
