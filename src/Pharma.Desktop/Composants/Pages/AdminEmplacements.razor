@page "/admin/emplacements"
@inject ApiClient Api
@inject HistoriqueNavigation Historique

<div class="page admin">
    <NavAdmin Actif="admin/emplacements" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Emplacements</h1>
                <p class="sous-titre">Rayons, étagères et tiroirs de la pharmacie, et la réserve. Les produits se rangent depuis l’écran Stock.</p>
            </div>
            <button type="button" class="btn btn-principal" @onclick="() => (fiche, controle) = (new(), false)">Ajouter un emplacement</button>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (fiche is not null)
        {
            <section class="panneau" aria-labelledby="t-fiche-empl">
                <h2 id="t-fiche-empl">@(fiche.Id is null ? "Nouvel emplacement" : $"Modifier {fiche.CodeInitial}")</h2>
                <div class="achats-ligne">
                    @* Rayon : saisie libre ; les rayons font une lettre, donc TOUS les rayons existants sont proposés, triés, dès l'entrée dans
                       le champ puis filtrés à la frappe (ValeursSaisies « rayon_emplacement », minimum de 0 lettre fixé par le serveur, droit
                       admin.parametres) ; un nouveau rayon peut toujours être tapé *@
                    <ValeursSaisies @ref="champRayon" Id="e-rayon" Champ="rayon_emplacement" LettresMin="0" LibelleListe="Rayons existants" Libelle="Rayon" Requis="true" Style="flex: 0 0 110px"
                                    @bind-Valeur="fiche.Rayon" maxlength="10" placeholder="A"
                                    class="@Obligatoire.Classe(RayonManque)" Invalide="RayonManque" />
                    <div class="champ" style="flex: 0 0 110px"><label for="e-etagere">Étagère</label><input id="e-etagere" type="text" maxlength="10" placeholder="02" @bind="fiche.Etagere" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 0 0 110px"><label for="e-tiroir">Tiroir</label><input id="e-tiroir" type="text" maxlength="10" placeholder="3" @bind="fiche.Tiroir" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 2 1 240px"><label for="e-libelle">Libellé</label><input id="e-libelle" type="text" placeholder="ex. Antibiotiques, Réfrigérateur" @bind="fiche.Libelle" /></div>
                    <div class="champ" style="flex: 0 0 160px">
                        <label for="e-zone">Zone</label>
                        <select id="e-zone" data-champ="zone" @bind="fiche.Zone"><option value="vente">Vente</option><option value="reserve">Réserve</option></select>
                    </div>
                </div>
                <p class="detail" style="margin: 0">Code : <strong>@Apercu</strong></p>
                @if (fiche.Id is not null)
                {
                    <label class="case"><input type="checkbox" @bind="fiche.Actif" /><span>Emplacement utilisé (décoché : il n’est plus proposé pour ranger un produit)</span></label>
                }
                <div style="display: flex; gap: 8px">
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">@(fiche.Id is null ? "Créer" : "Enregistrer")</button>
                    <button type="button" class="btn" @onclick="() => fiche = null">Annuler</button>
                </div>
            </section>
        }

        @* Tableau filtré et paginé par le serveur (règle des listes, 2026-11-15) ; caché le temps de la saisie d'une fiche (écran fixe) *@
        @if (fiche is null)
        {
        <div class="filtres-liste" role="search" aria-label="Filtrer les emplacements">
            <div class="champ" style="flex: 1 1 240px"><label for="fe-texte">Code ou libellé</label>
                <input id="fe-texte" type="search" autocomplete="off" placeholder="Ex. A-02, réfrigérateur" value="@fTexte" @oninput="RechercheAsync" /></div>
            <div class="champ" style="flex: 0 0 170px"><label for="fe-zone">Zone</label>
                <select id="fe-zone" @bind="fZone" @bind:after="PremierePageAsync"><option value="">Toutes</option><option value="vente">Zone de vente</option><option value="reserve">Réserve</option></select></div>
            <div class="champ" style="flex: 0 0 170px"><label for="fe-etat">État</label>
                <select id="fe-etat" @bind="fEtat" @bind:after="PremierePageAsync"><option value="">Tous</option><option value="actif">Utilisés</option><option value="inactif">Désactivés</option></select></div>
            @if (FiltreActif) { <button type="button" class="btn" @onclick="ToutAfficherAsync">Tout afficher</button> }
        </div>
        <section class="tableau-cadre" aria-label="Emplacements">
            <table class="tableau" style="min-width: 0">
                <thead><tr><th scope="col">Emplacement</th><th scope="col">Zone</th><th scope="col">Libellé</th><th scope="col">Produits rangés</th><th scope="col">État</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
                <tbody>
                    @foreach (var e in emplacements)
                    {
                        <tr>
                            <td><span class="code-emplacement">@e.Code</span></td>
                            <td>@(e.Zone == "vente" ? "Zone de vente" : "Réserve")</td>
                            <td>@(e.Libelle ?? "—")</td>
                            <td>@e.NombreProduits</td>
                            <td><span class="pastille @(e.Actif ? "ok" : "info")">@(e.Actif ? "Utilisé" : "Désactivé")</span></td>
                            <td><button type="button" class="btn" @onclick="() => Editer(e)">Modifier</button></td>
                        </tr>
                    }
                    @if (emplacements.Count == 0 && erreur is null)
                    {
                        <tr><td colspan="6" class="vide">@(FiltreActif ? "Aucun emplacement pour ces filtres." : "Aucun emplacement : commencez par les rayons (A, B, C…) puis la réserve.")</td></tr>
                    }
                </tbody>
            </table>
        </section>
        <Pagination Total="total" Numero="page" Taille="taille" Libelle="Pages des emplacements" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
    </div>
</div>

@code {
    private sealed class Fiche
    {
        public long? Id { get; init; }
        public string? CodeInitial { get; init; }
        public string? Rayon { get; set; }
        public string? Etagere { get; set; }
        public string? Tiroir { get; set; }
        public string? Libelle { get; set; }
        public string Zone { get; set; } = "vente";
        public bool Actif { get; set; } = true;
    }

    private List<EmplacementDto> emplacements = [];
    private Fiche? fiche;
    private bool enCours;
    private string? erreur, message;

    private string Apercu => fiche is null ? "" : string.Join('-', new[] { fiche.Rayon, fiche.Etagere, fiche.Tiroir }
        .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!.Trim().ToUpperInvariant())) is { Length: > 0 } c ? c : "—";

    private int total, page = 1, taille = Pagination.TailleParDefaut, saisie;
    private string fTexte = "", fZone = "", fEtat = "";
    private bool FiltreActif => fTexte.Trim() != "" || fZone != "" || fEtat != "";

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : filtres et page retrouvés
        Historique.Suivre("emplacements", e => { e.Mettre("texte", fTexte); e.Mettre("zone", fZone); e.Mettre("etat", fEtat); e.Mettre("page", page); e.Mettre("taille", taille); });
        if (Historique.Restaurer("emplacements") is { } h)
            (fTexte, fZone, fEtat, page, taille) = (h.Texte("texte") ?? "", h.Texte("zone") ?? "", h.Texte("etat") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
        await ChargerAsync(page, taille);
    }

    private Task ChargerAsync() => ChargerAsync(page, taille);
    private Task PremierePageAsync() => ChargerAsync(1, taille);
    private Task ToutAfficherAsync() { (fTexte, fZone, fEtat) = ("", "", ""); return PremierePageAsync(); }

    private async Task RechercheAsync(ChangeEventArgs a)
    {
        fTexte = a.Value?.ToString() ?? "";
        var n = ++saisie;
        await Task.Delay(250);
        if (n == saisie) await PremierePageAsync();
    }

    private async Task ChargerAsync(int numero, int nouvelleTaille)
    {
        var (p, e) = await Api.EmplacementsPageAsync(fZone, fEtat, fTexte.Trim(), numero, nouvelleTaille);
        if (p is null) { erreur ??= e; return; }
        (emplacements, total, page, taille) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille);
    }

    private void Editer(EmplacementDto e) => (fiche, controle) = (new Fiche
    {
        Id = e.Id, CodeInitial = e.Code, Rayon = e.Rayon, Etagere = e.Etagere, Tiroir = e.Tiroir, Libelle = e.Libelle, Zone = e.Zone, Actif = e.Actif
    }, false);

    // Rayon en rouge s'il manque au clic sur Créer ou Enregistrer
    private bool controle;
    private ValeursSaisies? champRayon;
    private bool RayonManque => fiche is not null && Obligatoire.Manque(controle, fiche.Rayon);

    private async Task EnregistrerAsync()
    {
        controle = true;
        if (RayonManque)
        {
            (erreur, message) = ("Le rayon est obligatoire (ex. A).", null);
            if (champRayon is not null) await champRayon.FocusAsync();
            return;
        }
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var (_, e) = await Api.EnregistrerEmplacementAsync(fiche!.Id,
                new SaisieEmplacementDto(fiche.Rayon, fiche.Etagere, fiche.Tiroir, fiche.Libelle, fiche.Zone, fiche.Actif));
            if (e is not null) { erreur = e; return; }
            message = $"Emplacement {Apercu} enregistré.";
            (fiche, controle) = (null, false);
            await ChargerAsync();
        }
        finally { enCours = false; }
    }
}
