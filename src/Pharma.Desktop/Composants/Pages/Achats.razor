@page "/achats"
@inject SessionPoste Session
@inject NavigationManager Nav
@inject CompteursAttente Compteurs
@implements IDisposable

@* Écran fixe : menu vertical à gauche (règle « Écran fixe », docs/charte-graphique.md), une partie à la fois.
   L'adresse garde l'onglet (achats?onglet=…) et la partie affichée (&vue=…) : « Retour » y revient. Pour un même onglet, le composant
   reste le même d'une vue à l'autre (la réception en cours n'est pas perdue en passant à « En attente » ou « Historique »). *@
<div class="page avec-menu">
    <NavDomaine Libelle="Rubriques des achats">
        @* Rubrique sans droit : absente (pas grisée) ; groupe dont aucune rubrique n'est permise : absent aussi *@
        @for (var i = 0; i < Rubriques.Length; i++)
        {
            var r = Rubriques[i];
            if (r.Groupe is { } g)
            {
                if (Rubriques.Skip(i + 1).TakeWhile(x => x.Groupe is null).Any(x => x.Permis))
                {
                    <span class="nav-groupe-titre">@g</span>
                }
            }
            else if (r.Permis)
            {
                var active = r.Onglet == onglet && (r.Vue is null || r.Vue == vue);
                var attente = r.Vue switch { "attente" => Compteurs.Receptions, "bons" => Compteurs.Brouillons, _ => null };
                <a href="@Lien(r)" class="@(r.SousRubrique ? "sous-rubrique" : null) @(active ? "active" : null)" aria-current="@(active ? "page" : null)">
                    @r.Libelle@if (attente is > 0) { <span class="compteur neutre" aria-label="@($"{attente} en attente")">@attente</span> }
                </a>
            }
        }
    </NavDomaine>

    <div class="contenu-rubrique">
        <div class="titre-page">
            <div>
                <h1>Achats · @Courante.Libelle<AideEcran Cle="achats" /></h1>
                <p class="sous-titre">@Courante.SousTitre</p>
            </div>
        </div>

        @switch (onglet)
        {
            case "commandes":
                <OngletCommandes Vue="@vue" ProduitAAjouter="Produit" NomProduit="@Nom" CommandeOuverte="Commande" Grossiste="Grossiste" />
                break;
            case "receptions":
                <OngletReceptions Vue="@vue" CommandeId="Commande" />
                break;
            case "retours":
                <OngletRetours Vue="@vue" LotId="Lot" ProduitId="Produit" NumeroLot="@NumeroLot" Motif="@Motif" />
                break;
            case "reglements":
                <OngletReglements Grossiste="Grossiste" />
                break;
            case "commander":
                <OngletCommander />
                break;
            case "catalogues":
                <OngletCataloguesGrossistes />
                break;
            case "traites":
                <OngletTraites />
                break;
            case "ruptures":
                <OngletRuptures />
                break;
            case "patients-attente":
                <OngletPatientsAttente />
                break;
            case "substitution":
                <OngletSubstitution />
                break;
            default:
                <OngletGrossistes />
                break;
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "onglet")] public string? Onglet { get; set; }
    [SupplyParameterFromQuery(Name = "vue")] public string? Vue { get; set; }
    [SupplyParameterFromQuery(Name = "produit")] public long? Produit { get; set; }
    [SupplyParameterFromQuery(Name = "commande")] public long? Commande { get; set; }
    [SupplyParameterFromQuery(Name = "nom")] public string? Nom { get; set; }
    [SupplyParameterFromQuery(Name = "lot")] public long? Lot { get; set; }
    [SupplyParameterFromQuery(Name = "numeroLot")] public string? NumeroLot { get; set; }
    [SupplyParameterFromQuery(Name = "motif")] public string? Motif { get; set; }
    [SupplyParameterFromQuery(Name = "grossiste")] public long? Grossiste { get; set; }

    private string onglet = "commandes";
    private string vue = "";

    /// <summary>Entrée du menu : onglet et partie affichée (Vue), ou titre de groupe (Groupe).</summary>
    private sealed record Rubrique(string Onglet, string? Vue, string Libelle, string SousTitre, bool Permis = true, bool SousRubrique = false, string? Groupe = null);

    private bool PeutCommander => Session.A("achats.commander") || Session.A("achats.receptionner");

    private Rubrique[] Rubriques =>
    [
        new("", null, "", "", Groupe: "Commandes"),
        new("commandes", "a-commander", "À commander", "Ruptures et stocks critiques, ajout d’un produit au bon du grossiste", PeutCommander, true),
        new("commander", null, "Commander (multi-grossistes)", "Comparer les grossistes, répartir la commande : un bon par grossiste, envoi PDF ou e-mail", Session.A("achats.commander"), true),
        new("commandes", "bons", "Bons de commande", "Bons par grossiste et par statut : brouillon, envoyé, reçu en partie, reçu", PeutCommander, true),
        new("catalogues", null, "Catalogues des grossistes", "Import du catalogue et de la disponibilité de chaque grossiste (Excel ou CSV)", Session.A("achats.commander"), true),
        new("", null, "", "", Groupe: "Ruptures"),
        new("ruptures", null, "Ruptures chez les grossistes", "En rupture chez tous les grossistes, depuis quand, retours en stock", Session.A("achats.commander"), true),
        new("patients-attente", null, "Patients en attente", "Prévenir quand disponible : file des patients, alerte au retour du produit, SMS avec accord", Session.A("caisse.vendre"), true),
        new("substitution", null, "Substitution", "Équivalent exact seulement, liste blanche, fabriqué en Algérie", Session.A("admin.parametres"), true),
        new("", null, "", "", Groupe: "Réceptions"),
        new("receptions", "saisie", "Réceptionner", "Compter ou saisir une livraison", Session.A("achats.receptionner"), true),
        new("receptions", "attente", "En attente", "Réceptions mises en attente et livraisons comptées à facturer", Session.A("achats.receptionner"), true),
        new("receptions", "historique", "Historique", "Dernières réceptions et réimpression des étiquettes", Session.A("achats.receptionner"), true),
        new("", null, "", "", Groupe: "Retours"),
        new("retours", "preparer", "Préparer un retour", "Lots à rendre au grossiste : périmés, rappelés, abîmés", Session.A("achats.retour_fournisseur"), true),
        new("retours", "liste", "Retours fournisseurs", "Retours préparés, envoyés, et leurs avoirs", Session.A("achats.retour_fournisseur"), true),
        new("", null, "", "", Groupe: "Autres"),
        new("reglements", null, "Payer un grossiste", "Dette et relevé de chaque grossiste, paiements", Session.A("achats.regler"), true),
        new("traites", null, "Traites à payer", "Traites échues ou à 7 jours ; paiement confirmé par le titulaire", Session.A("achats.regler"), true),
        new("grossistes", null, "Grossistes", "Fiches des grossistes, dette et délai de reprise", true, true)
    ];

    private Rubrique Courante => Rubriques.FirstOrDefault(r => r.Groupe is null && r.Onglet == onglet && (r.Vue is null || r.Vue == vue))
                                 ?? Rubriques.First(r => r.Groupe is null && r.Onglet == onglet);

    private static string Lien(Rubrique r) => r.Vue is null ? $"achats?onglet={r.Onglet}" : $"achats?onglet={r.Onglet}&vue={r.Vue}";

    // Compteurs des rubriques (réceptions en attente, bons en brouillon) : relus par la mise en page
    protected override void OnInitialized() => Compteurs.Change += SurCompteurs;
    private void SurCompteurs() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Compteurs.Change -= SurCompteurs;

    protected override void OnParametersSet()
    {
        // Étiquettes internes : passées dans le domaine Stock (stock/etiquettes) ; une ancienne adresse y renvoie
        // (l'onglet affiché est quand même calculé ci-dessous : l'écran reste valide le temps de la redirection)
        if (Onglet == "etiquettes") Nav.NavigateTo(Lot is { } l ? $"stock/etiquettes?lot={l}" : "stock/etiquettes", replace: true);
        var voulu = Onglet ?? "commandes";
        // Premier onglet autorisé si celui demandé ne l'est pas
        onglet = Rubriques.FirstOrDefault(r => r.Groupe is null && r.Onglet == voulu && r.Permis)?.Onglet
                 ?? Rubriques.First(r => r.Groupe is null && r.Permis).Onglet;
        // Partie affichée : celle de l'adresse, sinon selon le lien d'origine (produit à commander, lot à retourner)
        vue = Vue ?? onglet switch
        {
            "commandes" => Produit is not null ? "a-commander" : "bons",
            "receptions" => "saisie",
            "retours" => Lot is not null || Produit is not null ? "preparer" : "liste",
            _ => ""
        };
    }
}
