    /// <summary>Les totaux viennent du serveur : mêmes règles que l'encaissement (tiers payant, remise).</summary>
    // Raison du lot servi quand un lot plus ancien est en stock (codes de Pharma.Domain.Ventes.RaisonLot)
    private const string RaisonPeremption = "peremption", RaisonIntrouvable = "introuvable", RaisonAbimee = "abimee", RaisonDemandeClient = "demande_client";

    private static string RaisonLotLibelle(string code) => code switch
    {
        RaisonPeremption => "péremption plus proche (vérifiée)",
        RaisonIntrouvable => "boîte de l’ancien lot introuvable",
        RaisonAbimee => "boîte de l’ancien lot abîmée",
        RaisonDemandeClient => "demande du client",
        _ => code
    };

    private async Task ChoisirRaisonAsync(LignePanier l, string? raison)
    {
        l.RaisonLot = raison;
        ligneAVoir = derniereAjoutee;   // l'encadré change de hauteur : la dernière ligne ajoutée reste dans le cadre
        await RecalculerAsync();
    }

    private async Task RecalculerAsync()
    {
        var numero = ++requeteCalcul;
        if (!lignes.Any(l => l.Lot is not null))
        {
            (apercu, erreurCalcul) = (null, null);
            Afficheur.Accueil();
            if (lignes.Count == 0) cleEncaissement = Guid.NewGuid();   // panier vidé : le prochain panier est une autre vente
            return;
        }
        var (resultat, err) = await Api.CalculerVenteAsync(Commande("especes"));
        if (numero != requeteCalcul) return;
        (apercu, erreurCalcul) = (resultat, err);
        // Prix de chaque boîte calculé par le serveur : PPA du lot (ou prix du catalogue) plus le SHP
        // Lot plus ancien en stock : raison à choisir, ou péremption plus proche vérifiée par le serveur (à valider)
        if (resultat?.Situations is { } situations)
        {
            var lignesLot = lignes.Where(l => l.Lot is not null).ToList();
            for (var i = 0; i < lignesLot.Count && i < situations.Count; i++)
            {
                var l = lignesLot[i];
                if (l.Situation?.Situation != situations[i].Situation || l.Situation?.LotId != situations[i].LotId) l.RaisonLot = null;
                l.Situation = situations[i];
            }
        }
        if (resultat?.PrixLignes is { } prix)
        {
            var avecLot = lignes.Where(l => l.Lot is not null).ToList();
            for (var i = 0; i < avecLot.Count && i < prix.Count; i++) avecLot[i].Prix = prix[i];
            for (var i = 0; i < avecLot.Count; i++) avecLot[i].Reduction = resultat.Reductions is { } r && i < r.Count ? r[i] : null;
        }
        // Afficheur client : lignes du panier et part à payer par le patient
        Afficheur.Panier(lignes.Where(l => l.Lot is not null).Select(l => (l.Nom, l.Quantite, l.Prix * l.Quantite)).ToList(), apercu?.PartPatient ?? 0);
    }

    // Ticket de la dernière vente, imprimé par Windows (imprimante du poste ou imprimante par défaut)
    private bool impressionEnCours, ticketImprime;
    private string? messageTicket;

    private async Task ImprimerTicketAsync()
    {
        // Vente gardée ici : le caissier peut scanner le produit suivant pendant l'impression (venteFaite repasse alors à null)
        if (venteFaite is not { } vente) return;
        (impressionEnCours, messageTicket) = (true, null);
        try
        {
            var (ticket, e) = await Api.TicketAsync(vente.VenteId);
            e ??= await Tickets.ImprimerAsync(ticket!, vente.Mode == "especes" ? vente.Rendu : null);
            ticketImprime = e is null;
            messageTicket = e ?? $"Ticket {vente.Numero} envoyé à l’imprimante{(Tickets.NomDeclare is { } n ? $" « {n} »" : " par défaut")}.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Une imprimante en panne ne fait jamais perdre le panier en cours
            messageTicket = $"Ticket {vente.Numero} non imprimé : {ex.Message}";
        }
        finally { impressionEnCours = false; }
    }

    private async Task EncaisserAsync(string modePaiement)
    {
        if (!PeutEncaisser) return;
        messageTicket = null;
        enCours = true;
        erreurEncaissement = null;
        var (vente, err) = await Api.EncaisserAsync(Commande(modePaiement));
        enCours = false;
        if (err is not null)
        {
            // Réponse trop lente : la vente est peut-être enregistrée. La clé du panier est gardée : un nouvel essai rend la vente
            // déjà enregistrée au lieu d'en créer une seconde
            erreurEncaissement = err == ApiClient.MessageDelaiDepasse
                ? "Le serveur met trop de temps à répondre : la vente est peut-être déjà enregistrée. Vérifiez les dernières ventes, "
                  + "ou encaissez de nouveau sans rien changer au panier : il ne sera jamais encaissé deux fois."
                : err;
            return;
        }

        venteFaite = vente;
        // Vente à crédit : rien n'est payé au comptoir, l'afficheur client remercie sans montant
        Afficheur.Paiement(vente!.PartPatient, vente.Mode == "especes" ? montantRecu : null, vente.Mode == "especes" ? vente.Rendu : 0,
            credit: vente.Mode == "credit");
        // Réglage du poste : ticket imprimé sans clic après chaque vente
        if (Tickets.Automatique) _ = InvokeAsync(async () => { await ImprimerTicketAsync(); StateHasChanged(); });
        ViderPanier();
    }

