    // ---- Disposition en trois parties (2026-11-15) ----
    /// <summary>Le bouton principal suit le mode choisi : « Crédit » demande en plus le patient.</summary>
    private bool PeutEncaisserMode => Bascule.VentesSuspendues ? false : mode == "credit" ? RaisonBlocageCredit is null : PeutEncaisser && !RecuInsuffisant;   // bouton ET F12
    private string? RaisonBlocageMode => Bascule.VentesSuspendues ? BasculeSecours.MessageIsole : mode == "credit" ? RaisonBlocageCredit : RaisonBlocage ?? RaisonRecuInsuffisant;

    /// <summary>Montant à payer en espèces (part du patient moins l'avoir utilisé).</summary>
    private decimal APayerEspeces => apercu is { } a ? Math.Max(0m, a.PartPatient - AvoirUtilise) : 0m;
    /// <summary>
    /// Espèces (2026-11-22, demande du titulaire) : dès qu'il reste à payer, le montant reçu est OBLIGATOIRE et doit couvrir le montant à
    /// payer (après remise, don et avoir), sinon « Encaisser » et F12 sont désactivés ; « Appoint exact » le remplit en un clic.
    /// Crédit, carte, chèque et don total (rien à payer) : non concernés.
    /// </summary>
    private bool RecuManquant => mode == "especes" && APayerEspeces > 0 && montantRecu is null;
    private bool RecuCourt => mode == "especes" && montantRecu is { } r && APayerEspeces > 0 && r < APayerEspeces;
    private bool RecuInsuffisant => RecuManquant || RecuCourt;
    private string? RaisonRecuInsuffisant =>
        RecuManquant ? "Saisissez le montant reçu (ou « Appoint exact »)"
        : RecuCourt ? $"Montant reçu insuffisant : il manque {Libelles.Dinars(APayerEspeces - montantRecu!.Value, 2)}"
        : null;
    private void AppointExact() => montantRecu = APayerEspeces;
    /// <summary>Psychotrope ou stupéfiant au panier : ordonnance obligatoire, sans exception par validation.</summary>
    private bool OrdonnanceObligatoire => apercu?.OrdonnanceRequise == true;
    /// <summary>
    /// Tiers payant (2026-11-15, même règle que le serveur, RegleMedecinTiersPayant) : l'organisme paie une partie, médecin obligatoire ;
    /// il ne paie rien (TiersSansPart), médecin facultatif mais vente sans ordonnance validée ; volet Chifa scanné : facultatif.
    /// </summary>
    private bool MedecinParLeTaux => tiersPayant && volet is null && (apercu?.PartOrganisme ?? 0) > 0;
    private bool TiersSansPart => tiersPayant && volet is null && apercu is not null && apercu.PartOrganisme <= 0;
    /// <summary>Médecin exigé : psychotrope, ou tiers payant au taux.</summary>
    private bool MedecinObligatoire => OrdonnanceObligatoire || MedecinParLeTaux;
    private bool AfficherMedecin => MedecinObligatoire || TiersSansPart || apercu?.SurOrdonnance == true || jetonScan is not null;
    /// <summary>Le panier exige le bloc client (patient, médecin, organisme) : il ne se réduit pas.</summary>
    private bool ClientExige => tiersPayant || patient is not null || nouveauPatient || PatientObligatoire || AfficherMedecin || PsychotropeInterdit;
    private bool clientDeplie;
    /// <summary>Tout ce que le panier exige du client est saisi (patient, médecin si attendu, organisme), sans saisie en cours.</summary>
    private bool ClientComplet => patient is not null && !nouveauPatient && nouveauMedecin is null && !PsychotropeInterdit && !PorteurDemande
        && (!MedecinObligatoire || medecin is not null) && (!tiersPayant || organismeId > 0) && !DureeManquante;
    /// <summary>Le bloc est en cours de saisie : il reste ouvert jusqu'au produit suivant ou à « Réduire ».</summary>
    private bool clientEdition;
    /// <summary>« Réduire » demandé : le bloc se résume même incomplet (ce qui manque est signalé) jusqu'à « Modifier ».</summary>
    private bool reduitDemande;
    private bool ClientResume => !clientEdition && (ClientComplet || reduitDemande) && (patient is not null || reduitDemande)
        && !nouveauPatient && nouveauMedecin is null;
    private void ReduireClient()
    {
        if (!ClientExige) { clientDeplie = false; return; }   // rien d'exigé : retour à la ligne « Ajouter un patient »
        (clientEdition, reduitDemande) = (false, true);
    }
    private void ModifierClient() => (clientEdition, reduitDemande) = (true, false);
    /// <summary>
    /// Repli automatique permis (2026-11-18) : bloc exigé par le panier, ouvert, hors saisie (ni « Modifier », ni patient ou médecin
    /// choisi depuis le dernier produit, ni fiche en création) et sans message à lire dans le bloc (psychotrope interdit, porteur).
    /// </summary>
    private bool RepliAutoPermis => ClientExige && !ClientResume && !clientEdition && !nouveauPatient && nouveauMedecin is null
        && !PsychotropeInterdit && !PorteurDemande;

    /// <summary>
    /// Écran trop court (1366 × 768, bandeau de lot…) : appelé par poste.js quand l'écran déborde encore avec le panier à sa hauteur
    /// minimale et que le curseur n'est pas dans le bloc client. Le bloc se résume en une ligne (ce qui manque y est signalé) ;
    /// « Modifier », F6 ou F5 le rouvrent, et il reste alors ouvert jusqu'au produit suivant.
    /// </summary>
    [JSInvokable]
    public Task ReplierClientAuto()
    {
        if (!RepliAutoPermis) return Task.CompletedTask;
        reduitDemande = true;
        return InvokeAsync(StateHasChanged);
    }
    /// <summary>Ce que le panier exige encore du client (patient, médecin, organisme) ; null : rien.</summary>
