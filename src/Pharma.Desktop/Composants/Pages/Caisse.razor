    /// Si la mise en attente échoue, ou pendant un encaissement, on reste sur la Caisse.
    /// </summary>
    private async Task<bool> QuitterAsync(string cible)
    {
        if (HistoriqueNavigation.Chemin(cible) == "caisse") return true;   // reste sur la Caisse (ex. relevé d'un crédit) : panier gardé
        venteMiseDeCoteEnPartant = null;
        if (lignes.Count == 0) return true;
        if (enCours) { erreurAttente = "Encaissement en cours : attendez la fin avant de quitter la caisse."; await InvokeAsync(StateHasChanged); return false; }
        if (cleEnDoute) { GarderPanierEnDoute(); return true; }   // jamais en attente : gardé en mémoire, rendu au retour
        enCours = true;
        try { derniereMiseEnAttente = null; await MettreDeCoteAsync(); }
        finally { enCours = false; }
        if (erreurAttente is not null || derniereMiseEnAttente is null)
        {
            erreurAttente ??= "La vente n'a pas pu être mise en attente : la caisse reste affichée pour ne pas perdre le panier.";
            await InvokeAsync(StateHasChanged);
            return false;
        }
        venteMiseDeCoteEnPartant = derniereMiseEnAttente;
        return true;
    }

    /// <summary>
    /// « Changer d'utilisateur » panier rempli (2026-11-21) : la vente est mise en attente sur le serveur AVANT la fermeture de la
    /// session, et la réponse est attendue. Réussite : le poste la retient pour le prochain employé connecté. Échec (serveur
    /// injoignable, délai dépassé) ou encaissement en cours : le panier reste affiché, la session reste ouverte et le message est
    /// renvoyé à l'en-tête, qui l'affiche dans une fenêtre bloquante (« Réessayer » / « Rester sur la vente »).
    /// Aucune copie locale du panier n'existe sur le poste : le serveur est la seule sauvegarde (ventes en attente).
    /// </summary>
    private async Task<string?> LaisserAuSuivantAsync()
    {
        if (!lignes.Any(l => l.Quantite > 0)) return null;
        if (enCours) return "Encaissement en cours : attendez la fin de l’encaissement avant de changer d’utilisateur.";
        if (cleEnDoute) { GarderPanierEnDoute(); await InvokeAsync(StateHasChanged); return null; }   // jamais en attente : rendu au suivant
        var quitte = Session.NomComplet ?? "l’employé précédent";
        enCours = true;
        try { derniereMiseEnAttente = null; await MettreDeCoteAsync(DemandeAttente($" · laissée par {quitte}")); }
        finally { enCours = false; }
        if (erreurAttente is not null || derniereMiseEnAttente is not { } id)
        {
            var echec = erreurAttente ?? "La vente n’a pas pu être mise en attente.";
            erreurAttente = "Changement d’utilisateur annulé : la vente n’a pas pu être mise en attente, le panier est resté affiché.";
            await InvokeAsync(StateHasChanged);
            return echec;
        }
        Session.RetenirVenteAReprendre(id, quitte);
        await InvokeAsync(StateHasChanged);
        return null;
    }

