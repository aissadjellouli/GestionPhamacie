    /// <summary>Organismes proposés au paiement : volet Chifa sur la vente, CNAS et CASNOS seulement (2026-11-15) ; sinon tous.</summary>
    private IEnumerable<OrganismeDto> OrganismesPaiement => volet is null ? organismes : organismes.Where(o => o.Code is "CNAS" or "CASNOS");
    private bool OrganismeAdmis(long id) => volet is null || OrganismesPaiement.Any(o => o.Id == id);

