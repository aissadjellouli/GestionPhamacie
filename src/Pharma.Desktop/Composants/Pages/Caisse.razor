    /// <summary>Frappe au clavier : recherche lancée 250 ms après la dernière touche (une seule requête par mot tapé).</summary>
    private async Task RechercherApresSaisieAsync()
    {
        var numero = ++requete;
        if (texte.Length > 0) (bandeau, bandeauProduit) = (null, null);   // nouvelle recherche : l'explication précédente n'a plus lieu d'être
        if (texte.Trim().Length < 2) { suggestions = []; return; }
        await Task.Delay(DelaiSaisie);
        if (numero == requete) await RechercherAsync();
    }

    internal static readonly TimeSpan DelaiSaisie = TimeSpan.FromMilliseconds(250);

    /// <summary>Recherche immédiate (Entrée après un scan).</summary>
    private async Task RechercherAsync()
    {
        var numero = ++requete;
        if (texte.Trim().Length < 2) { suggestions = []; return; }
        var (trouves, err) = await Api.RechercherAuComptoirAsync(texte);
        if (numero != requete) return;   // une frappe plus récente a déjà relancé la recherche
        (suggestions, erreur) = (trouves, err);
    }

    private async Task ToucheAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { suggestions = []; return; }
        if (e.Key != "Enter") return;
        // Le code lu est pris et la saisie vidée tout de suite, avant toute attente : le scan suivant peut déjà arriver.
        // La recherche de frappe en cours n'a plus d'objet.
        var code = texte.Trim();
        texte = "";
        ++requete;
        // Scans rapprochés : traités un par un, dans l'ordre, chacun avec son propre code
        await scansEnCours.WaitAsync();
        try { await TraiterCodeAsync(code); }
        finally { scansEnCours.Release(); }
    }

    /// <summary>Code lu (scan ou saisie suivie d'Entrée) : ne dépend ni de la saisie en cours ni des recherches de frappe.</summary>
    private async Task TraiterCodeAsync(string code)
    {
        // QR d'un volet Chifa (champs séparés par « ; », ou scanné en clavier QWERTY sur un poste AZERTY)
        if (code.Length >= 20 && (code.Contains(';') || code.Count(c => "&é\"'(-è_çà".Contains(c)) >= 5))
        {
            var (v, ev) = await Api.LireVoletChifaAsync(code);
            if (v is not null) { suggestions = []; await ReprendreVoletAsync(v); return; }
            if (code.Contains(';')) { (suggestions, erreur) = ([], ev); return; }
        }
        // Étiquette interne ou Data Matrix : la boîte désigne son lot, servi tel quel (contrôle de péremption)
        if (code.Length >= 8 && !code.Contains(' '))
        {
            var (boite, errBoite) = await Api.BoiteCaisseAsync(code);
            if (errBoite is not null) { (suggestions, erreur, bandeau) = ([], errBoite, null); return; }
            if (boite is not null) { await AjouterBoiteAsync(boite, viderSaisie: false); return; }
        }
        // Premier produit trouvé, s'il est en stock ; en rupture, la liste reste ouverte avec son remplaçant
        if (code.Length < 2) { suggestions = []; return; }
        var (trouves, err) = await Api.RechercherAuComptoirAsync(code);
        if (trouves.FirstOrDefault() is { Produit.Stock: > 0 } c)
        {
            await AjouterAsync(c.Produit.Id, c.Produit.NomCommercial, c.PrixServi, viderSaisie: false);
            return;
        }
        (suggestions, erreur) = (trouves, err);
        // Rien d'ajouté : la saisie revient pour être corrigée (sauf si un autre code est déjà en cours de saisie)
        if (texte.Length == 0) texte = code;
    }

    /// <param name="viderSaisie">Faux pour un code scanné : la saisie a déjà été vidée à l'Entrée et contient peut-être le scan suivant.</param>
    private async Task AjouterAsync(long produitId, string nom, decimal prix, int quantite = 1, bool viderSaisie = true)
    {
        if (viderSaisie) texte = "";
        (suggestions, erreur, bandeau, venteFaite) = ([], null, null, null);
        quantite = Math.Max(1, quantite);

        // Lignes du produit déjà au panier (une par lot) : on y ajoute d'abord, dans la limite de chaque lot.
        // Ce qui n'avait pas pu être servi (QuantiteDemandee) est repris avec la nouvelle quantité.
        var duProduit = lignes.Where(l => l.ProduitId == produitId && l.Lot is not null).ToList();
        var reste = quantite + duProduit.Sum(l => Math.Max(l.QuantiteDemandee - l.Quantite, 0));
        foreach (var l in duProduit)
        {
            var place = Math.Min(Math.Max(l.Lot!.Quantite - l.Quantite, 0), reste);
            l.Quantite += place;
            l.QuantiteDemandee = l.Quantite;
            reste -= place;
        }

        // Le reste est pris sur les lots suivants dans l'ordre FEFO : une ligne par lot
        var derniere = duProduit.LastOrDefault();
        while (reste > 0)
        {
            var reponse = await Api.LotFefoAsync(produitId, lignes.Where(l => l.ProduitId == produitId && l.Lot is not null).Select(l => l.Lot!.LotId));
            if (reponse.Erreur is not null) { erreur = reponse.Erreur; break; }
            if (reponse.Lot is not { } lot)
            {
                if (derniere is not null) break;   // plus d'autre lot vendable : le manque est signalé sur la dernière ligne
                // Rupture complète : la ligne est gardée sans lot, avec les équivalents
                derniere = new LignePanier
                {
                    ProduitId = produitId, Nom = nom, Prix = prix, Ecartes = reponse.Ecartes, QuantiteDemandee = reste, Quantite = reste,
                    Alternatives = (await Api.AlternativesAsync(produitId)).Item1
                };
                lignes.Add(derniere);
                // Rupture : l'explication est sur la ligne du panier (« Rupture de stock », lots écartés), pas dans un bandeau
                reste = 0;
                break;
            }
            var prise = Math.Min(reste, lot.Quantite);
            if (prise <= 0) break;   // lot annoncé vide : on n'insiste pas
            var premiere = derniere is null;
            derniere = new LignePanier
            {
                ProduitId = produitId, Nom = nom, Prix = prix, Lot = lot, Ecartes = reponse.Ecartes, StockProduit = lot.StockProduit,
                QuantiteDemandee = prise, Quantite = prise
            };
            lignes.Add(derniere);
            if (premiere) (bandeau, bandeauProduit) = (Expliquer(reponse), Expliquer(reponse) is null ? null : produitId);
            reste -= prise;
        }

        (ligneAVoir, derniereAjoutee, clientEdition) = (derniere, derniere, false);
        // Tous les lots vendables sont épuisés : toujours un équivalent quand le produit manque
        if (reste > 0 && derniere is not null)
        {
            derniere.QuantiteDemandee = derniere.Quantite + reste;
            await ProposerEquivalentSiManqueAsync(derniere);
        }
        await RecalculerAsync();
    }

    private async Task AjouterBoiteAsync(BoiteCaisseDto b, bool viderSaisie = true)
    {
        if (viderSaisie) texte = "";
        (suggestions, erreur, bandeau, venteFaite) = ([], null, null, null);
        if (b.BoiteId is { } dejaVue && lignes.Any(l => l.Boites.Contains(dejaVue)))
        {
            erreur = $"{b.Produit} : cette boîte est déjà au panier (même étiquette scannée deux fois).";
            return;
        }
        var existante = lignes.FirstOrDefault(l => l.ProduitId == b.ProduitId && l.Lot?.LotId == b.Lot.LotId);
        if (existante is not null)
        {
            if (b.BoiteId is { } id) existante.Boites.Add(id);
            if (existante.Quantite < existante.Lot!.Quantite) existante.Quantite++;
            existante.QuantiteDemandee = existante.Quantite;
            existante.StockProduit = b.StockProduit;
            existante.CouleurFefo ??= b.CouleurAvertissement;
            existante.AvertissementFefo ??= b.Avertissement;
            existante.LotConseille ??= b.LotConseille;
            existante.EmplacementConseille ??= b.Emplacement;
        }
        else
        {
            var ligne = new LignePanier
            {
                ProduitId = b.ProduitId, Nom = b.Produit, Prix = b.PrixPublic, Lot = b.Lot, StockProduit = b.StockProduit,
                BoiteScannee = true, AvertissementFefo = b.Avertissement, LotConseille = b.LotConseille, EmplacementConseille = b.Emplacement,
                CouleurFefo = b.CouleurAvertissement
            };
            if (b.BoiteId is { } id) ligne.Boites.Add(id);
            lignes.Add(ligne);
        }
        (ligneAVoir, clientEdition) = (existante ?? lignes[^1], false);
        derniereAjoutee = ligneAVoir;
        await RecalculerAsync();
    }

    /// <summary>Le caissier a pris une boîte du lot conseillé (qui périme avant) : c'est ce lot qui est vendu.</summary>
    private async Task ServirLotConseilleAsync(LignePanier l)
    {
        if (l.LotConseille is not { } conseille) return;
        var autre = lignes.FirstOrDefault(x => x != l && x.ProduitId == l.ProduitId && x.Lot?.LotId == conseille.LotId);
        // La boîte scannée reste en rayon : elle n'est plus rattachée à la vente
        if (autre is not null) { autre.Quantite = Math.Min(autre.Quantite + l.Quantite, conseille.Quantite); lignes.Remove(l); }
        else { l.Lot = conseille; l.Quantite = Math.Min(l.Quantite, conseille.Quantite); l.Boites.Clear(); }
        (l.AvertissementFefo, l.LotConseille, l.LotConseilleServi) = (null, null, true);
        await RecalculerAsync();
    }

    /// <summary>Stock du produit après cette vente (toutes les lignes du même produit).</summary>
    private int StockApresVente(LignePanier l) => Math.Max(0, l.StockProduit - lignes.Where(x => x.ProduitId == l.ProduitId).Sum(x => x.Quantite));

    private async Task ProposerEquivalentSiManqueAsync(LignePanier l)
    {
        if (l.QuantiteDemandee > l.Quantite && l.Alternatives.Count == 0)
            l.Alternatives = (await Api.AlternativesAsync(l.ProduitId)).Item1;
    }

