        Nav.NavigateTo("caisse");
    }

    protected override async Task OnInitializedAsync()
    {
        Session.AvantFermeture += PanierAbandonne;
        // Quitter la Caisse panier rempli (menu, lien, « Retour ») : la vente part en attente, « Retour » la reprend
        Historique.AvantDeQuitter("caisse", QuitterAsync);
        // La partie affichée (annulation, crédit) est dans l'adresse : « Retour » y revient d'elle-même
        Historique.Suivre("caisse", e => e.Mettre("attente", venteMiseDeCoteEnPartant));
        var retour = Historique.Restaurer("caisse");
        var aReprendre = retour?.Long("attente");
        (organismes, _) = await Api.OrganismesAsync();
        organismeId = OrganismeParDefaut;
        await ChargerEtatAsync();
        if (aReprendre is { } id) await ReprendreAuRetourAsync(id);
        // Vente laissée en attente au « Changer d'utilisateur » : reprise par l'employé qui se connecte ensuite sur ce poste
        else if (Session.A("caisse.vendre") && Session.PrendreVenteAReprendre() is { } laissee) await ReprendreLaisseeAsync(laissee.Id, laissee.LaisseePar);
    }

    // ---- Retour sur la Caisse : mise en attente automatique en partant, reprise en revenant ----
    private long? derniereMiseEnAttente, venteMiseDeCoteEnPartant;
    private string? messageRetour;

    /// <summary>
    /// Avant de quitter la Caisse : un panier rempli part en attente (rien n'est perdu, rien n'est signalé comme retiré).
    /// Si la mise en attente échoue, ou pendant un encaissement, on reste sur la Caisse.
    /// </summary>
    private async Task<bool> QuitterAsync(string cible)
    {
        if (HistoriqueNavigation.Chemin(cible) == "caisse") return true;   // reste sur la Caisse (ex. relevé d'un crédit) : panier gardé
        venteMiseDeCoteEnPartant = null;
        if (lignes.Count == 0) return true;
        if (enCours) { erreurAttente = "Encaissement en cours : attendez la fin avant de quitter la caisse."; await InvokeAsync(StateHasChanged); return false; }
        enCours = true;
        try { derniereMiseEnAttente = null; await MettreDeCoteAsync(); }
        finally { enCours = false; }
        if (erreurAttente is not null || derniereMiseEnAttente is null)
        {
            erreurAttente ??= "La vente n'a pas pu être mise en attente : la caisse reste affichée pour ne pas perdre le panier.";
            await InvokeAsync(StateHasChanged);
            return false;
        }
        venteMiseDeCoteEnPartant = derniereMiseEnAttente;
        return true;
    }

    /// <summary>Vente mise en attente au changement d'utilisateur : retenue par le poste pour le prochain employé connecté.</summary>
    private async Task RetenirPourLeSuivantAsync(Task<(long? Id, string? Erreur)> envoi, string quitte)
    {
        var (id, _) = await envoi;
        if (id is { } v) Session.RetenirVenteAReprendre(v, quitte);
    }

    /// <summary>Retour sur la Caisse : la vente mise en attente en partant est reprise, si personne ne l'a reprise entre-temps.</summary>
    private async Task ReprendreAuRetourAsync(long id)
    {
