    /// <summary>2026-11-16 : bandeau « produit redevenu disponible » relu toutes les 5 minutes tant que la Caisse est ouverte.</summary>
    public static readonly TimeSpan IntervalleAlertesDispo = TimeSpan.FromMinutes(5);
    private readonly CancellationTokenSource arretAlertesDispo = new();

    /// <summary>Boucle d'actualisation : arrêtée à la sortie de la page ; erreur réseau silencieuse ; rien pendant un encaissement.</summary>
    private async Task ActualiserAlertesDispoAsync()
    {
        using var minuterie = new PeriodicTimer(IntervalleAlertesDispo);
        try
        {
            while (await minuterie.WaitForNextTickAsync(arretAlertesDispo.Token))
            {
                if (enCours || !Session.A("caisse.vendre")) continue;
                try
                {
                    var (a, e) = await Api.AlertesDisponibiliteAsync();
                    if (e is null && !arretAlertesDispo.IsCancellationRequested) await InvokeAsync(() => { alertesDispo = a; StateHasChanged(); });
                }
                catch (Exception ex) when (ex is not OperationCanceledException) { }
            }
        }
        catch (OperationCanceledException) { }
    }

