    // ---- Retour sur la Caisse : mise en attente automatique en partant, reprise en revenant ----
    private long? derniereMiseEnAttente, venteMiseDeCoteEnPartant;
    private string? messageRetour;

    /// <summary>
    /// Avant de quitter la Caisse : un panier rempli part en attente (rien n'est perdu, rien n'est signalé comme retiré).
    /// Si la mise en attente échoue, ou pendant un encaissement, on reste sur la Caisse.
    /// </summary>
    private async Task<bool> QuitterAsync(string cible)
    {
        if (HistoriqueNavigation.Chemin(cible) == "caisse") return true;   // reste sur la Caisse (ex. relevé d'un crédit) : panier gardé
        venteMiseDeCoteEnPartant = null;
        if (lignes.Count == 0) return true;
        if (enCours) { erreurAttente = "Encaissement en cours : attendez la fin avant de quitter la caisse."; await InvokeAsync(StateHasChanged); return false; }
        enCours = true;
        try { derniereMiseEnAttente = null; await MettreDeCoteAsync(); }
        finally { enCours = false; }
        if (erreurAttente is not null || derniereMiseEnAttente is null)
        {
            erreurAttente ??= "La vente n'a pas pu être mise en attente : la caisse reste affichée pour ne pas perdre le panier.";
            await InvokeAsync(StateHasChanged);
            return false;
        }
        venteMiseDeCoteEnPartant = derniereMiseEnAttente;
        return true;
    }

