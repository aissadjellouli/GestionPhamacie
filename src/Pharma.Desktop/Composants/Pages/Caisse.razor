        MedecinObligatoire && medecin is null ? "médecin" : AfficherMedecin && medecin is null && jetonScan is null ? "médecin (attendu)" : null,
        tiersPayant && organismeId <= 0 ? "organisme" : null,
        DureeManquante ? "durée du traitement" : null   // psychotrope (script 153)
    }.Where(m => m is not null)) is { Length: > 0 } m2 ? m2 : null;
    private string OrganismeCode => organismes.FirstOrDefault(o => o.Id == organismeId)?.Code ?? "organisme";
    /// <summary>Fin de droits Chifa dépassée du patient, en tiers payant CNAS/CASNOS (script 102, D-4 : avertissement seul).</summary>
    private DateOnly? DroitsChifaExpires =>
        tiersPayant && OrganismeCode is "CNAS" or "CASNOS" && patient?.DateFinDroit is { } fin && fin < DateOnly.FromDateTime(DateTime.Now) ? fin : null;
    /// <summary>
    /// Vente à crédit : avertissement renforcé « Droits expirés et vente à crédit » en tiers payant CNAS/CASNOS aux droits expirés, et
    /// SANS tiers payant Chifa (2026-11-15) dès que la date de fin de droits du patient est dépassée ou dans les N jours ; jamais bloquant.
    /// </summary>
    private bool AlerteCreditDroits => DroitsChifaExpires is not null
        || (!(tiersPayant && EtatDroitsChifa.OrganismeChifa(OrganismeCode)) && EtatDroitsChifa.EtatCreditSansTiersPayant(patient?.DateFinDroit,
            DateOnly.FromDateTime(DateTime.Now), etat?.JoursAlerteFinDroit ?? EtatDroitsChifa.JoursAlerteParDefaut) is not null);
    /// <summary>Contrôle de fin de droits (2026-11-15) : absente, bientôt expirés (N jours, Administration › Caisse), expirés ; jamais bloquant.</summary>
    private EtatDroits EtatDroitsPatient => EtatDroitsChifa.Etat(tiersPayant && EtatDroitsChifa.OrganismeChifa(OrganismeCode) && patient is not null,
        patient?.DateFinDroit, DateOnly.FromDateTime(DateTime.Now), etat?.JoursAlerteFinDroit ?? EtatDroitsChifa.JoursAlerteParDefaut);
    private long? majFinDroitPatient, finDroitSaisiePatient;
