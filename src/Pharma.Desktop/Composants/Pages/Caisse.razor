        else if (e.Key == "Escape") await EnregistrerPatientVoletAsync(null);   // fermer : fiche créée quand même, à compléter
    }

    /// <summary>Crée (ou retrouve) la fiche de l'assuré du volet, puis la choisit pour la vente ; nom vide : nom provisoire.</summary>
    private async Task EnregistrerPatientVoletAsync(string? nom)
    {
        if (voletBrut is null) { patientVoletOuvert = false; return; }
        patientVoletEnCours = true;
        try
        {
            var lien = string.IsNullOrEmpty(lienPatientVolet) ? null : lienPatientVolet;
            var (p, err) = await Api.CreerPatientVoletAsync(voletBrut, string.IsNullOrWhiteSpace(nom) ? null : nom.Trim(), organismeId > 0 ? organismeId : null,
                lien, lien == "assure" ? null : principalPatientVolet);
            if (err is not null || p is null) { erreurPatientVolet = err ?? "Création du patient impossible."; return; }
            patientVoletOuvert = false;
            erreurPatientVolet = null;
            var organisme = organismes.FirstOrDefault(o => o.Id == p.OrganismeId);
            // Bandeau du volet : le patient créé remplace « patient inconnu » (E4, 2026-11-15)
            if (volet is { PatientId: null } vp) volet = vp with { PatientId = p.Id, Patient = p.Nom };
            await ChoisirPatientVoletAsync(new PatientDto(p.Id, p.Nom, null, null, p.NumAssure, p.OrganismeId, organisme?.Code, 0, 0));
        }
        finally { patientVoletEnCours = false; }
    }

