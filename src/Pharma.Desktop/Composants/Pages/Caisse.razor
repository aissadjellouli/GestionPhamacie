    /// <summary>Fin d'une annulation ou d'un règlement : retour à la vente (panier gardé).</summary>
    private void RetourVente()
    {
        creditPatientId = null;
        Nav.NavigateTo("caisse");
    }

    protected override async Task OnInitializedAsync()
    {
        _ = Offre.ChargerAsync();   // lot O6 : packs de l'offre (afficheur client : pack H), sans retarder l'ouverture de la caisse
        Session.AvantFermeture += PanierAbandonne;
        Bascule.Change += SurBascule;
        Panier.Abonner(MettreDeCoteBasculeAsync);
        // Wilayas (liste bornée) pour la wilaya du médecin choisi, quel que soit le chemin du choix (recherche, reprise, scan)
        _ = ChargerWilayasAsync();
        // « Changer d'utilisateur » panier rempli : la vente part en attente avant la fermeture de la session, réponse attendue
        Session.AvantChangementUtilisateur(LaisserAuSuivantAsync);
        // Quitter la Caisse panier rempli (menu, lien, « Retour ») : la vente part en attente, « Retour » la reprend
        Historique.AvantDeQuitter("caisse", QuitterAsync);
        // La partie affichée (annulation, crédit) est dans l'adresse : « Retour » y revient d'elle-même
        Historique.Suivre("caisse", e => e.Mettre("attente", venteMiseDeCoteEnPartant));
        var retour = Historique.Restaurer("caisse");
        var aReprendre = retour?.Long("attente");
        (organismes, _) = await Api.OrganismesAsync();
        organismeId = OrganismeParDefaut;
        await ChargerEtatAsync();
        if (Session.A("caisse.vendre")) (alertesDispo, _) = await Api.AlertesDisponibiliteAsync();
        _ = ActualiserAlertesDispoAsync();
        if (Session.A("caisse.vendre")) _ = SuivreAttenteEncaissementAsync();
        if (aReprendre is { } id) await ReprendreAuRetourAsync(id);
        // Vente laissée en attente au « Changer d'utilisateur » : reprise par l'employé qui se connecte ensuite sur ce poste
        else if (Session.A("caisse.vendre") && Session.PrendreVenteAReprendre() is { } laissee) await ReprendreLaisseeAsync(laissee.Id, laissee.LaisseePar);
        // Repli après une bascule (Q26) : panier gardé en mémoire, rendu à l'employé qui se reconnecte sur ce poste
        if (Session.A("caisse.vendre") && lignes.Count == 0 && Panier.Reprendre<PanierCapture>() is { } rendu) await RendrePanierBasculeAsync(rendu);
    }

    // ---- Bascule du poste sur le 2e serveur (lot V2-6) ----
    /// <summary>Panier mis de côté EN MÉMOIRE quand le nouveau serveur refuse le jeton (jamais sur disque) : lignes, clé d'encaissement, client, mode.</summary>
    /// <param name="CleEnDoute">Encaissement de ce panier interrompu par la panne : la vente est peut-être déjà enregistrée sous cette clé.</param>
    private sealed record PanierCapture(List<LignePanier> Lignes, Guid Cle, PatientDto? Patient, string Mode, decimal RemisePct, bool CleEnDoute = false);

    private Task MettreDeCoteBasculeAsync() => InvokeAsync(() =>
    {
        if (!lignes.Any(l => l.Quantite > 0)) return;
        ArreterRenvoi();
        Panier.Garder(new PanierCapture([.. lignes], cleEncaissement, patient, mode, remisePct, cleEnDoute));
        lignes.Clear();   // rien n'est signalé « retiré » : le panier est rendu à la reconnexion
    });

    /// <summary>
    /// Panier dont l'encaissement a été interrompu par la panne, quand on quitte la Caisse ou change d'utilisateur : jamais mis en attente
    /// (décision du titulaire, 2026-11-25), gardé EN MÉMOIRE sur ce poste avec sa clé, comme au repli ; rendu au retour sur la Caisse
    /// (même employé ou non). Le renvoi automatique s'arrête ; rien n'est signalé « retiré ».
    /// </summary>
    private void GarderPanierEnDoute()
    {
        ArreterRenvoi();
        Panier.Garder(new PanierCapture([.. lignes], cleEncaissement, patient, mode, remisePct, CleEnDoute: true));
        lignes.Clear();
    }

    private async Task RendrePanierBasculeAsync(PanierCapture p)
    {
        lignes.AddRange(p.Lignes);
        (cleEncaissement, patient, mode, remisePct, cleEnDoute) = (p.Cle, p.Patient, p.Mode, p.RemisePct, p.CleEnDoute);
