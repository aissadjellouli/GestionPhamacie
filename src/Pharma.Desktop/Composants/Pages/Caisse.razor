    private const string RaisonPeremption = "peremption", RaisonIntrouvable = "introuvable", RaisonAbimee = "abimee", RaisonDemandeClient = "demande_client";

    private static string RaisonLotLibelle(string code) => code switch
    {
        RaisonPeremption => "péremption plus proche (vérifiée)",
        RaisonIntrouvable => "boîte de l’ancien lot introuvable",
