    private List<LigneVoletChifaDto> codesAAssocier = [];
    private List<string> ecartsVolet = [];

    /// <summary>Volet scanné : tiers payant CNAS, assuré retrouvé, produits reconnus ajoutés avec leurs quantités ; écarts de prix signalés.</summary>
    private async Task ReprendreVoletAsync(VoletChifaDto v)
    {
        // Un seul volet par vente : un second scan du même volet n'ajoute pas les produits une seconde fois
        if (volet is { } deja)
        {
            erreur = deja.NumeroFacture == v.NumeroFacture
                ? $"Le volet Chifa n° {v.NumeroFacture} est déjà dans ce panier."
                : $"Un seul volet Chifa par vente : encaissez ou retirez d’abord le volet n° {deja.NumeroFacture}.";
            return;
        }
        (volet, voletBrut, codesAAssocier, ecartsVolet) = (v, v.Brut, [], []);
        tiersPayant = true;
        if (v.PatientId is { } pid)
        {
            patientTexte = v.PatientNumAssure ?? v.Assure;   // la recherche compare le n° d'assuré à l'identique
            (patients, _) = await Api.RechercherPatientsAsync(patientTexte);
            if (patients.FirstOrDefault(x => x.Id == pid) is { } trouve) await ChoisirPatientAsync(trouve);
            else (patients, patientTexte) = ([], "");
        }
        if (v.OrganismeId is { } org) organismeId = org;
        foreach (var l in v.Lignes)
        {
            if (l.ProduitId is not { } id) { codesAAssocier.Add(l); continue; }
            await AjouterAsync(id, l.Produit!, l.PrixCatalogue ?? l.PrixUnitaire, l.Quantite, viderSaisie: false);
            if (l.PrixCatalogue is { } pc && pc != l.PrixUnitaire)
                ecartsVolet.Add($"{l.Produit} : {Libelles.Dinars(l.PrixUnitaire, 2)} sur le volet, {Libelles.Dinars(pc, 2)} au catalogue.");
        }
        await RecalculerAsync();
    }

    /// <summary>Code Chifa inconnu : associé au produit choisi (retenu pour les prochains volets), puis ajouté au panier.</summary>
    private async Task AssocierCodeAsync(LigneVoletChifaDto c, ProduitDto p)
    {
        var e = await Api.AssocierCodeChifaAsync(c.Code, p.Id);
        if (e is not null) { erreur = e; return; }
        codesAAssocier.Remove(c);
        await AjouterAsync(p.Id, p.NomCommercial, p.PrixPublic, c.Quantite);
        if (p.PrixPublic != c.PrixUnitaire)
            ecartsVolet.Add($"{p.NomCommercial} : {Libelles.Dinars(c.PrixUnitaire, 2)} sur le volet, {Libelles.Dinars(p.PrixPublic, 2)} au catalogue.");
    }

    private void RetirerVolet() => (volet, voletBrut, codesAAssocier, ecartsVolet) = (null, null, [], []);

    private async Task ChoisirPatientAsync(PatientDto p)
    {
        (patient, patients, patientTexte, clientEdition) = (p, [], "", true);
        if (tiersPayant && p.OrganismeId is { } org) organismeId = org;
        await RecalculerAsync();
    }

