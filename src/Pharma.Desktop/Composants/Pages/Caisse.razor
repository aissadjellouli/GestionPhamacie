    internal static string DureeAttente(int secondes) => secondes >= 60 ? $"{secondes / 60} min {secondes % 60:00}" : $"{secondes} s";

    /// <summary>Attente relue toutes les 5 s jusqu'à ce que l'encaissement soit permis ; erreur réseau : bandeau retiré (la vente
    /// refusée dit pourquoi).</summary>
    private async Task SuivreAttenteEncaissementAsync()
    {
        try
        {
            while (!arretAttenteEncaissement.IsCancellationRequested)
            {
                var (a, e) = await Api.AttenteEncaissementAsync();
                var secondes = e is null ? a?.Secondes ?? 0 : 0;
                if (arretAttenteEncaissement.IsCancellationRequested) return;
                await InvokeAsync(() => { attenteEncaissement = secondes; StateHasChanged(); });
                if (secondes <= 0) return;
                await Task.Delay(TimeSpan.FromSeconds(Math.Min(5, secondes)), arretAttenteEncaissement.Token);
            }
        }
        catch (OperationCanceledException) { }
    }

