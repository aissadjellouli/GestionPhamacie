    /// <summary>
    /// Saisie de la remise : chiffres seulement, zéros de tête retirés (le 0 par défaut s'efface dès qu'on tape), champ vidé : 0 ;
    /// 2 chiffres au plus, sauf 100. Une saisie négative ou supérieure à 100 est refusée avec un message (la valeur précédente reste,
    /// elle n'est jamais ramenée à 0 en silence) ; le serveur revérifie.
    /// </summary>
    private async Task SaisieRemiseAsync(ChangeEventArgs e)
    {
        var brut = e.Value?.ToString() ?? "";
        var (valeur, refus) = SaisieRemise.Lire(brut);
        erreurRemise = refus;
        if (valeur is { } v) remisePct = v;
        // Affichage corrigé si la saisie a été retouchée (Blazor ne réécrit pas un champ dont la valeur rendue n'a pas changé)
        if (brut != RemiseTexte) await JS.InvokeVoidAsync("pharma.fixerValeur", champRemise, RemiseTexte);
    }

