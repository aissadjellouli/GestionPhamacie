    // ---- Motif de mise en attente (2026-11-15, script 094) : au bouton « Attente » seulement ;
    //      les mises en attente automatiques (départ de la caisse, changement d'utilisateur) restent sans motif ----
    private bool motifAttenteOuvert;
    private List<MotifReglableDto> motifsAttente = [];
    private string motifAttente = "";
    private string? texteAttente, erreurMotifAttente;
    private readonly HashSet<long> produitsDus = [];

    private async Task DemanderMotifAttenteAsync()
    {
        if (enCours || lignes.Count == 0) return;
        (motifAttenteOuvert, motifAttente, texteAttente, erreurMotifAttente) = (true, "", null, null);
        produitsDus.Clear();
