    /// <summary>Part payée par l'avoir : au plus le solde et au plus ce que paie le patient ; revérifiée par le serveur sous verrou.</summary>
    private decimal AvoirUtilise => AvoirDisponible && utiliserAvoir && mode != "credit"
        ? Math.Max(0, Math.Min(montantAvoirSaisi ?? soldeAvoirPatient, Math.Min(soldeAvoirPatient, apercu?.PartPatient ?? 0)))
        : 0;

    private async Task ChargerAvoirPatientAsync(long patientId)
    {
