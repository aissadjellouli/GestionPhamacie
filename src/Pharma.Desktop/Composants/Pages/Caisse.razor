        await RecalculerAsync();
    }

    private async Task ChangerAsync(LignePanier l, int delta)
    {
        if (l.Lot is { } lot && l.Quantite + delta > lot.Quantite) return;
        l.Quantite += delta;
        l.QuantiteDemandee = l.Quantite;   // réglage manuel : le caissier a tranché
        if (l.Quantite <= 0) { lignes.Remove(l); EffacerBandeauSiRetire(l.ProduitId); }
        if (delta < 0) SignalerRetrait(l, -delta);
        await RecalculerAsync();
    }

    /// <summary>
    /// Boîtes retirées du panier avant le paiement : signalées au serveur pour la surveillance de la caisse (titulaire). Sans attendre la
    /// réponse : la caisse ne doit pas ralentir ; un échec n'empêche pas de continuer la vente.
    /// </summary>
    private void SignalerRetrait(LignePanier l, int boites)
    {
        if (l.Lot is null || boites <= 0) return;
        _ = Api.SignalerCaisseAsync(new EvenementCaisseRequete("ligne_retiree", l.ProduitId, l.Lot.LotId, boites, l.Prix * boites));
    }

