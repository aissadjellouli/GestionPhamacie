@page "/caisse"
@implements IAsyncDisposable
@inject ApiClient Api
@inject SessionPoste Session
@inject ConfigurationPoste Poste
@inject AfficheurClient Afficheur
@inject OffrePoste Offre
@inject IJSRuntime JS
@inject ImprimanteTickets Tickets
@inject HistoriqueNavigation Historique
@inject NavigationManager Nav
@inject RemboursementsTiroir Remboursements
@inject VigiePoste Bascule
@inject PanierBascule Panier

@* Écran fixe (docs/charte-graphique.md) : colonne d'actions de caisse à gauche (NavCaisse), une partie à la fois dans l'adresse :
   la vente (caisse), l'annulation ou le retour (caisse?rubrique=annulation), le règlement d'un crédit (caisse?rubrique=credit).
   Passer d'une partie à l'autre garde le panier ; le panier défile dans son cadre. *@
<div class="page @(erreurEtat is null && etat?.SessionId is not null ? "avec-menu" : null)" style="padding-top: 24px">
    @if (erreurEtat is not null)
    {
        <div class="erreur" role="alert">@erreurEtat</div>
    }
    else if (etat is null)
    {
        <Chargement Texte="Chargement de la caisse…" />
    }
    else if (etat.SessionId is null)
    {
        <section class="panneau" style="max-width: 460px" aria-labelledby="t-ouvrir">
            <h2 id="t-ouvrir">Ouvrir la caisse</h2>
            <p class="sous-titre">Comptez le fond de caisse avant la première vente. La caisse reste à votre nom jusqu’à la clôture.</p>
            <div class="champ">
                <label for="fond">Fond de caisse (DA)</label>
                <input id="fond" type="number" min="0" step="1" @bind="fondCaisse" />
            </div>
            @if (erreurOuverture is not null) { <div class="erreur" role="alert">@erreurOuverture</div> }
            <button type="button" class="btn btn-principal btn-large" disabled="@enCours" @onclick="OuvrirAsync">Ouvrir la caisse</button>
        </section>
    }
    else
    {
        <NavCaisse Actif="@AdresseRubrique" OuverteLe="etat.OuverteLe" OuvertePar="@etat.OuvertePar" Fond="etat.FondCaisse" Poste="@etat.Poste" />
        <div class="contenu-rubrique">
        @if (rubrique == "annulation")
        {
            <PanneauAnnulation EnLigne="true" NumeroInitial="@annulationNumero" OnFerme="RetourVente" OnAnnulee="VenteAnnuleeAsync" />
        }
        else if (rubrique == "credit")
        {
            <PanneauCredit EnLigne="true" PatientId="creditPatientId" OnFerme="RetourVente" OnEncaisse="ChargerEtatAsync" />
        }
        else
        {
        @* Script 152 (2026-11-19) : au démarrage du serveur, l'encaissement attend que le serveur central confirme les n° de tickets
           (quelques secondes), au plus le délai réglé dans Synchronisation › Réglages *@
        @if (attenteEncaissement > 0)
        {
            <div class="bandeau-attention" role="status" data-champ="attente_encaissement">Contrôle de démarrage avec le serveur central : encaissement possible dans @DureeAttente(attenteEncaissement) au plus.</div>
        }

        @if (venteFaite is not null)
        {
            <div class="succes" role="status" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px">
                <strong>Vente @venteFaite.Numero encaissée : @Libelles.Dinars(venteFaite.MontantTotal, 2)</strong>
                @if (venteRenvoyee) { <span data-champ="vente_renvoyee">@RenvoiEncaissement.MessageRenvoyee</span> }
                @if (venteFaite.PartOrganisme > 0) { <span>part organisme @Libelles.Dinars(venteFaite.PartOrganisme, 2)</span> }
                @if (venteFaite.EcartChifaPatient > 0) { <span>Écart Chifa payé par le patient : @Libelles.Dinars(venteFaite.EcartChifaPatient, 2)</span> }
                @if (venteFaite.Mode == "especes" && venteFaite.Rendu > 0) { <span class="rendu-vente">Rendu : @Libelles.Dinars(venteFaite.Rendu, 2)</span> }
                @if (venteFaite.Mode == "credit") { <span>mise en crédit</span> }
                @if (venteFaite.PayeParAvoir > 0) { <span>payé par avoir : @Libelles.Dinars(venteFaite.PayeParAvoir, 2)</span> }
                <button type="button" class="btn" disabled="@impressionEnCours" @onclick="ImprimerTicketAsync">@(impressionEnCours ? "Impression…" : "Imprimer le ticket")</button>
                <button type="button" class="lien-bouton" @onclick="() => OuvrirAnnulation(venteFaite.Numero)">Annuler ou retour</button>
            </div>
            @if (venteFaite.CatalogueChifa is { } majCatalogue) { <div class="info-bandeau" role="status" data-champ="catalogue_chifa">@majCatalogue</div> }
            @if (messageTicket is not null) { <div class="@(ticketImprime ? "info-bandeau" : "erreur")" role="status">@messageTicket</div> }
        }
        @if (messageRattachement is not null)
        {
            <div class="succes" role="status" data-champ="volet_rattache" style="display: flex; gap: 12px; align-items: center">
                <span>@messageRattachement</span>
                @* Trop-payé « à rendre » (recette du 2026-11-15, D4) : sortie du tiroir pré-remplie, liée à la régularisation *@
                @if (rattacheARendre is { ARendre: > 0, PatientId: { } pid } ar && Session.A("caisse.ouvrir_tiroir"))
                {
                    <button type="button" class="btn" @onclick="() => RembourserRattachement(ar, pid)">Rembourser @Libelles.Dinars(ar.ARendre, 2)</button>
                }
                <button type="button" class="lien-bouton" @onclick="() => (messageRattachement, catalogueRattachement, rattacheARendre) = (null, null, null)">Fermer</button>
            </div>
            @if (catalogueRattachement is { } majCat) { <div class="info-bandeau" role="status" data-champ="catalogue_chifa">@majCat</div> }
        }
        @if (assureConflit is { } conflit && patient is { } choisiConflit)
        {
            <div class="bandeau" role="alert" data-champ="assure_volet" style="display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center">
                <strong>Le volet appartient à l’assuré @conflit.Assure, pas à @choisiConflit.Nom@(choisiConflit.NumAssure is { } na ? $" ({na})" : "").</strong>
                <button type="button" class="btn btn-principal" @onclick="PrendreAssureVoletAsync">Prendre l’assuré du volet</button>
                <button type="button" class="btn" @onclick="GarderPatientChoisiAsync">Garder @choisiConflit.Nom (journalisé)</button>
            </div>
        }
        @if (controlePsy is { } ctrlPsy && delivrancePsy is { } delPsy)
        {
            <FenetreAlertesPsychotropes Controle="ctrlPsy" Delivrance="delPsy" OnAbandon="AbandonnerPsy" OnForce="PsyForceesAsync" />
        }
        @if (rapprochement is { } rap && rapprochementTexte is { } texteVolet)
        {
            <FenetreRapprochementVolet Rapprochement="rap" Texte="@texteVolet" OnNouvelleVente="NouvelleVenteDepuisVoletAsync"
                                       OnRattache="VoletRattache" OnFerme="() => (rapprochement, rapprochementTexte, rapprochementVolet) = (null, null, null)" />
        }

        @* Caisse en trois parties (2026-11-15, maquettes validées) : 1 · le panier, 2 · le client et l'ordonnance (sous le panier,
           réduit à une ligne quand rien n'est exigé), 3 · le paiement seul à droite. Écran fixe : seul le panier défile. *@
        @if (renvoi is not null)
        {
            @* Encaissement en suspens (Q25) : panier et paiement figés (inert) jusqu'au renvoi automatique, même clé d'encaissement *@
            <div class="bandeau-attention" role="status" data-champ="renvoi_encaissement" style="display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center">
                <span style="flex: 1 1 320px; min-width: 0">@RenvoiEncaissement.MessageSuspens</span>
                <button type="button" class="btn" @onclick="AnnulerRenvoi">Annuler le renvoi automatique</button>
            </div>
        }
        <div class="colonnes caisse-vente" style="gap: 20px">
            <section class="colonne-principale" aria-label="Panier, client et ordonnance" inert="@(renvoi is not null)">
                @if (cameraOuverte)
                {
                    <div class="panneau camera">
                        <video id="camera-video" autoplay playsinline muted aria-label="Image de la caméra"></video>
                        <div class="actions">
                            <button type="button" class="btn btn-principal" @onclick="PrendrePhotoAsync">Prendre la photo</button>
                            <button type="button" class="btn" @onclick="FermerCameraAsync">Annuler</button>
                        </div>
                    </div>
                }

                @if (erreurScan is not null) { <div class="erreur" role="alert">@erreurScan</div> }

                @if (image is not null)
                {
                    <section class="ordonnance" aria-label="Ordonnance scannée">
                        <button type="button" class="ordonnance-image" title="Agrandir l’ordonnance" @onclick="() => imageAgrandie = true">
                            <img src="@image.UrlDonnees" alt="Ordonnance scannée" />
                        </button>
                        <div class="ordonnance-lignes">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px">
                                <div>
                                    <strong>Médicaments de l’ordonnance</strong><br />
                                    <span class="detail">@lignesOrdonnance.Count reconnu(s)@(lignesIgnorees > 0 ? $" · {lignesIgnorees} ligne(s) non reconnue(s) : vérifiez l’image" : "")</span>
                                </div>
                                <div class="actions">
                                    @if (lignesOrdonnance.Any(l => !l.Traitee))
                                    {
                                        <button type="button" class="btn btn-principal" @onclick="ToutAjouterAsync">Tout ajouter</button>
                                    }
                                    <button type="button" class="btn" @onclick="RetirerOrdonnanceAsync">Retirer l’ordonnance</button>
                                </div>
                            </div>
                            @if (lignesOrdonnance.Count == 0)
                            {
                                <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center">
                                    <p class="detail" style="margin: 0; flex: 1 1 240px">@(motifSaisieManuelle ?? "Aucun médicament reconnu") : saisissez les produits à la main en lisant l’image.</p>
                                    <button type="button" class="btn btn-principal" @onclick="OuvrirSaisieManuelleAsync">Saisir les produits à la main</button>
                                </div>
                            }
                            @foreach (var lo in lignesOrdonnance.Where(l => !l.Traitee))
                            {
                                <div class="ligne-ordonnance">
                                    <span class="detail">Lu : « @lo.Texte »</span>
                                    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center">
                                        <select class="selection" style="flex: 999 1 260px; min-width: 0" aria-label="Produit pour « @lo.Texte »" @bind="lo.ChoixId">
                                            @foreach (var c in lo.Candidats)
                                            {
                                                <option value="@c.ProduitId">@c.NomCommercial @c.Dosage · @(c.Stock > 0 ? $"stock {c.Stock}" : "rupture : équivalent proposé") · @Math.Round(c.Score * 100) %</option>
                                            }
                                        </select>
                                        <input type="number" min="1" style="width: 80px" aria-label="Nombre de boîtes" @bind="lo.Quantite" />
                                        <button type="button" class="btn btn-principal" @onclick="() => AjouterLigneOrdonnanceAsync(lo)">Ajouter</button>
                                        <button type="button" class="btn" @onclick="() => lo.Traitee = true">Écarter</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                    @if (imageAgrandie)
                    {
                        <div class="lecture-ordonnance" role="dialog" aria-modal="true" aria-label="Lecture de l’ordonnance" @onkeydown="ToucheLecture">
                            <div class="lecture-image">
                                <div class="lecture-outils" role="toolbar" aria-label="Affichage de l’ordonnance">
                                    <button type="button" class="btn btn-icone" title="Tourner à gauche" aria-label="Tourner à gauche" @onclick="() => rotation = (rotation + 270) % 360">↺</button>
                                    <button type="button" class="btn btn-icone" title="Tourner à droite" aria-label="Tourner à droite" @onclick="() => rotation = (rotation + 90) % 360">↻</button>
                                    <button type="button" class="btn btn-icone" title="Réduire" aria-label="Réduire" @onclick="() => zoom = Math.Max(0.5, zoom - 0.25)">−</button>
                                    <span class="detail">@Math.Round(zoom * 100) %</span>
                                    <button type="button" class="btn btn-icone" title="Agrandir" aria-label="Agrandir" @onclick="() => zoom = Math.Min(4, zoom + 0.25)">+</button>
                                </div>
                                <div class="lecture-defilement">
                                    <img src="@image.UrlDonnees" alt="Ordonnance" style="transform: rotate(@(rotation)deg); width: @(Math.Round(zoom * 100))%" />
                                </div>
                            </div>
                            <aside class="lecture-saisie" aria-label="Saisie des produits lus">
                                <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px">
                                    <strong>Produits lus sur l’ordonnance</strong>
                                    <button type="button" class="btn" @onclick="() => imageAgrandie = false">Fermer (Échap)</button>
                                </div>
                                @if (lignesOrdonnance.Count == 0)
                                {
                                    <div class="bandeau-attention" role="status">
                                        <strong>Lecture automatique impossible</strong><br />
                                        @(motifSaisieManuelle ?? "Aucun médicament reconnu sur l’image") : à vous de saisir les produits en lisant l’ordonnance.
                                    </div>
                                }
                                <p class="detail" style="margin: 0">Tapez le nom lu sur l’image ou la DCI (quelques lettres suffisent, les fautes sont tolérées), choisissez la quantité, puis ajoutez. Fermez quand l’ordonnance est complète.</p>
                                <div class="champ recherche">
                                    <label for="lecture-recherche">Produit</label>
                                    <input id="lecture-recherche" type="search" autocomplete="off" placeholder="Ex. sintrom" @ref="champLecture"
                                           @bind="lectureTexte" @bind:event="oninput" @bind:after="RechercherLectureAsync" />
                                </div>
                                @if (lectureSansResultat is { } cherche)
                                {
                                    <p class="detail texte-attention" role="status" style="margin: 0">Aucun produit du catalogue ne correspond à « @cherche ». Vérifiez l’orthographe ou cherchez par la DCI ; un produit absent du catalogue ne peut pas être vendu.</p>
                                }
                                <div class="champ">
                                    <label for="lecture-qte">Boîtes</label>
                                    <input id="lecture-qte" type="number" min="1" max="20" style="width: 100px" @bind="lectureQuantite" />
                                </div>
                                <ul class="liste-lecture" aria-label="Produits trouvés">
                                    @foreach (var p in lectureSuggestions)
                                    {
                                        <li>
                                            <button type="button" @onclick="() => AjouterDepuisLectureAsync(p)">
                                                <span><strong>@p.NomCommercial</strong><br /><span class="detail">@p.Dci @p.Dosage · @(p.Stock > 0 ? $"stock {p.Stock}" : "rupture : équivalent proposé")</span></span>
                                                <span>Ajouter</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                                @if (lectureAjouts.Count > 0)
                                {
                                    <div class="succes" role="status">Ajouté au panier : @string.Join(", ", lectureAjouts)</div>
                                }
                            </aside>
                        </div>
                    }
                }

                <!-- 1 · Panier : recherche du produit, mise en attente, ventes en attente du poste (gardées sur le serveur) -->
                <div class="ligne-scan">
                    <div class="champ recherche">
                        <label for="scan">1 · Panier@(lignes.Count > 0 ? $" · {NombreProduits} produit(s), {lignes.Where(l => !l.EstPrestation).Sum(l => l.Quantite)} boîte(s){(lignes.Any(l => l.EstPrestation) ? $", {lignes.Where(l => l.EstPrestation).Sum(l => l.Quantite)} prestation(s)" : "")}" : "") <span class="detail">F7</span></label>
                        <input id="scan" data-champ="volet_chifa" class="grand" type="search" placeholder="Scanner ou rechercher un produit : nom, DCI, code-barres" autofocus autocomplete="off"
                               role="combobox" aria-autocomplete="list" aria-expanded="@(suggestions.Count > 0 ? "true" : "false")" aria-controls="scan-liste"
                               aria-activedescendant="@(ActifScan >= 0 ? $"scan-opt-{ActifScan}" : null)"
                               @bind="texte" @bind:event="oninput" @bind:after="RechercherApresSaisieAsync" @onkeydown="ToucheAsync" />
                        @if (suggestions.Count > 0)
                        {
                            var numeroOption = 0;
                            @* Recherche au comptoir (2026-11-14) : produits en stock d'abord ; en rupture en bas, non sélectionnables, avec leur remplaçant
                               (équivalent exact le moins cher, sinon autre dosage ou forme à valider) ; même produit d'un autre laboratoire moins cher
                               suggéré sous le produit cherché, qui reste sélectionnable (demande explicite du client). Prix : prix servi. *@
                            @* Flèches haut et bas (2026-11-18) : parcourent les boutons sélectionnables dans l'ordre (produit, « moins cher », remplaçant),
                               même ordre que OptionsScan ; Entrée ajoute celui mis en avant, sinon Entrée garde son rôle (volet Chifa, boîte, 1er produit) *@
                            <ul class="suggestions suggestions-caisse" id="scan-liste" role="listbox" aria-label="Produits trouvés">
                                @foreach (var c in suggestions)
                                {
                                    var p = c.Produit;
                                    var optProduit = p.Stock > 0 ? numeroOption++ : -1;
                                    var optAutre = (p.Stock > 0 ? c.MoinsCher is not null : c.Remplacant is not null) ? numeroOption++ : -1;
                                    <li class="@(p.Stock <= 0 ? "en-rupture" : null)" role="none">
                                        @if (p.Stock > 0)
                                        {
                                            <button type="button" id="@($"scan-opt-{optProduit}")" role="option" aria-selected="@(optProduit == ActifScan ? "true" : "false")"
                                                    class="@(optProduit == ActifScan ? "actif" : null)" @onclick="() => AjouterAsync(p.Id, p.NomCommercial, c.PrixServi)">
                                                <span>
                                                    <strong>@p.NomCommercial</strong><br />
                                                    <span class="detail">@p.Dci @p.Dosage · stock @p.Stock@(Libelles.EstSousRegistre(p.Classe) ? " · ordonnance" : "")</span>
                                                </span>
                                                <span>@Libelles.Dinars(c.PrixServi, 2)</span>
                                            </button>
                                            @if (c.MoinsCher is { } m)
                                            {
                                                @* Étiquette sans le nom du médicament (même produit) : le laboratoire seulement (2026-11-14) *@
                                                <button type="button" id="@($"scan-opt-{optAutre}")" role="option" aria-selected="@(optAutre == ActifScan ? "true" : "false")"
                                                        class="suggestion-equivalent @(optAutre == ActifScan ? "actif" : null)" title="@m.NomCommercial" @onclick="() => AjouterAsync(m.ProduitId, m.NomCommercial, m.PrixPublic)">
                                                    <span>Moins cher · <strong>@(m.Laboratoire ?? "autre laboratoire")</strong> · stock @m.Stock</span>
                                                    <span>@Libelles.Dinars(m.PrixPublic, 2) (− @Libelles.Dinars(c.PrixServi - m.PrixPublic, 2))</span>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="suggestion-rupture" aria-disabled="true">
                                                <span>
                                                    <strong>@p.NomCommercial</strong><br />
                                                    <span class="detail">@p.Dci @p.Dosage</span>
                                                </span>
                                                <span class="alerte-rupture">Rupture de stock</span>
                                            </div>
                                            @if (c.Remplacant is { } r)
                                            {
                                                <button type="button" id="@($"scan-opt-{optAutre}")" role="option" aria-selected="@(optAutre == ActifScan ? "true" : "false")"
                                                        class="suggestion-equivalent @(optAutre == ActifScan ? "actif" : null)" @onclick="() => AjouterAsync(r.ProduitId, r.NomCommercial, r.PrixPublic)">
                                                    <span>Remplaçant : <strong>@r.NomCommercial</strong>@(r.Exact ? "" : r.ListeBlanche ? " (liste blanche du pharmacien)" : $" ({r.Dosage} {r.Forme}, à valider par le pharmacien)")@(r.FabricationLocale ? " · fabriqué en Algérie" : "") · stock @r.Stock</span>
                                                    <span>@Libelles.Dinars(r.PrixPublic, 2)</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="detail suggestion-aucun">Aucun remplaçant en stock.</span>
                                            }
                                        }
                                    </li>
                                }
                                @if (autresResultats)
                                {
                                    <li class="detail suggestion-autres" role="note" style="padding: 8px 12px">… autres résultats, précisez la recherche</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="actions-attente">
                        <button type="button" class="btn" data-champ="prestation" disabled="@enCours" @onclick="OuvrirPrestationsAsync" title="Vendre une prestation sans stock (prise de tension, glycémie, injection…)">+ Prestation</button>
                        <button type="button" class="btn" disabled="@(enCours || lignes.Count == 0 || cleEnDoute)" @onclick="DemanderMotifAttenteAsync" title="@(cleEnDoute ? MessageAttenteRefusee : "Mettre ce panier de côté pour servir un autre patient (motif demandé)")">⏸ Attente</button>
                        @if (attentes.Count > 0)
                        {
                            <button type="button" class="btn bouton-attentes" aria-expanded="@(attentesOuvertes ? "true" : "false")" @onclick="() => attentesOuvertes = !attentesOuvertes">
                                En attente (@attentes.Count) @(attentesOuvertes ? "▴" : "▾")
                            </button>
                        }
                        @if (attentesOuvertes && attentes.Count > 0)
                        {
                            @* Liste déroulante au-dessus du panier : un clic ailleurs la referme, elle ne reste plus sur la ligne du panier (recette 2026-11-15) *@
                            <div class="fond-attentes" aria-hidden="true" @onclick="() => attentesOuvertes = false"></div>
                            <div class="liste-attentes" role="group" aria-label="Ventes en attente">
                                @foreach (var v in attentes)
                                {
                                    <div class="vente-attente">
                                        <span>
                                            <strong>@v.Libelle</strong> · @v.Lignes produit(s) · <strong>@Libelles.Dinars(v.Total, 2)</strong><br />
                                            <span class="detail">mise en attente à @v.CreeLe.ToLocalTime().ToString("HH:mm") par @v.Employe</span>
                                            @* Motif (2026-11-15, script 094) ; « produit manquant » : produits dus au patient (aucune commande créée) *@
                                            @if (v.Motif is { } motifV) { <span class="motif-attente">Motif : @motifV</span> }
                                            @if (v.ProduitsDus is { Count: > 0 } dus)
                                            {
                                                <ul class="produits-dus" aria-label="Produits dus au patient">
                                                    @foreach (var d in dus) { <li>@d.Nom × @d.Quantite</li> }
                                                </ul>
                                            }
                                        </span>
                                        @if (aAbandonner == v.Id)
                                        {
                                            <button type="button" class="lien-bouton danger" @onclick="() => AbandonnerAsync(v)">Confirmer l’abandon</button>
                                            <button type="button" class="lien-bouton" @onclick="() => aAbandonner = null">Garder</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => ReprendreDepuisListeAsync(v)">Reprendre</button>
                                            <button type="button" class="btn btn-icone" aria-label="@($"Abandonner la vente en attente {v.Libelle}")" title="Abandonner" @onclick="() => aAbandonner = v.Id">×</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                @if (prestationsOuvert)
                {
                    @* Prestations (2026-11-15, script 105) : types actifs réglés dans Administration › Prestations ; seul le tableau défile *@
                    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-prestations">
                        <section class="panneau" style="max-width: 560px; width: 100%; display: flex; flex-direction: column; gap: 8px; max-height: 80vh">
                            <h2 id="t-prestations">Ajouter une prestation</h2>
                            <div class="champ">
                                <label for="pr-recherche">Code ou libellé</label>
                                <input id="pr-recherche" type="search" autocomplete="off" autofocus value="@prestationsTexte" @oninput="RechercherPrestationsAsync" />
                            </div>
                            @if (erreurPrestations is not null) { <div class="erreur" role="alert">@erreurPrestations</div> }
                            <div class="tableau-cadre" style="flex: 1 1 auto; min-height: 0">
                                <table class="tableau" style="min-width: 0">
                                    <thead><tr><th scope="col">Prestation</th><th scope="col">TVA</th><th scope="col">Prix</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
                                    <tbody>
                                        @foreach (var tp in prestations)
                                        {
                                            <tr>
                                                <td>@tp.Libelle <span class="detail">@tp.Code@(tp.Remboursable ? " · remboursable" : "")</span></td>
                                                <td>@tp.TauxTva.ToString("0.##") %</td>
                                                <td>@(tp.Prix > 0 ? Libelles.Dinars(tp.Prix, 2) : "à fixer")</td>
                                                <td><button type="button" class="btn btn-principal"
                                                            title="@(tp.Prix <= 0 ? "Prix à fixer dans Administration › Prestations" : null)"
                                                            @onclick="() => AjouterPrestationAsync(tp)">Ajouter</button></td>
                                            </tr>
                                        }
                                        @if (prestations.Count == 0 && erreurPrestations is null) { <tr><td colspan="4" class="vide">Aucune prestation active (Administration › Prestations).</td></tr> }
                                    </tbody>
                                </table>
                            </div>
                            <Pagination Total="prestationsTotal" Numero="prestationsPage" Taille="prestationsTaille" Libelle="Pages des prestations"
                                        OnChange="p => ChargerPrestationsAsync(p.Numero, p.Taille)" />
                            <div style="display: flex; justify-content: flex-end">
                                <button type="button" class="btn" @onclick="() => prestationsOuvert = false">Fermer</button>
                            </div>
                        </section>
                    </div>
                }
                @if (motifAttenteOuvert)
                {
                    @* Motif de mise en attente (2026-11-15, script 094) : liste réglée par le titulaire ; « Autre » avec texte ;
                       « produit manquant » : produits dus cochés parmi le panier (aucune commande créée) *@
                    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-motif-attente">
                        <section class="panneau attente-motif-panneau" style="max-width: 520px; width: 100%">
                            <h2 id="t-motif-attente">Mettre la vente en attente</h2>
                            <div class="champ">
                                <label for="ma-motif" class="requis">Motif</label>
                                <select id="ma-motif" data-champ="motif" @bind="motifAttente" autofocus>
                                    <option value="">— choisir —</option>
                                    @foreach (var m in motifsAttente) { <option value="@m.Code">@m.Libelle</option> }
                                </select>
                            </div>
                            @if (motifAttente == "autre")
                            {
                                <div class="champ"><label for="ma-texte" class="requis">Précisez</label>
                                    <input id="ma-texte" data-champ="motif_texte" type="text" maxlength="200" @bind="texteAttente" @bind:event="oninput" /></div>
                            }
                            @if (motifAttente == "produit_manquant")
                            {
                                <fieldset class="produits-a-cocher" data-champ="produits_dus">
                                    <legend class="requis">Produits dus au patient</legend>
                                    @foreach (var l in lignes.DistinctBy(x => x.ProduitId))
                                    {
                                        <label class="case"><input type="checkbox" checked="@produitsDus.Contains(l.ProduitId)"
                                            @onchange="e => CocherDu(l.ProduitId, e.Value is true)" /><span>@l.Nom × @lignes.Where(x => x.ProduitId == l.ProduitId).Sum(x => x.Quantite)</span></label>
                                    }
                                </fieldset>
                            }
                            @if (erreurMotifAttente is not null) { <div class="erreur" role="alert">@erreurMotifAttente</div> }
                            <div style="display: flex; gap: 8px">
                                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="MettreEnAttenteAsync">Mettre en attente</button>
                                <button type="button" class="btn" @onclick="() => motifAttenteOuvert = false">Annuler</button>
                            </div>
                        </section>
                    </div>
                }
                @if (erreurAttente is not null) { <div class="erreur" role="alert">@erreurAttente</div> }
                @if (messageRetour is not null) { <div class="info-bandeau" role="status">@messageRetour</div> }
                @* Lot 7 : produit attendu par un patient (ou dû d'une vente en attente) redevenu disponible *@
                @if (alertesDispo is { } ad && ad.Patients.Count + ad.VentesEnAttente.Count > 0)
                {
                    @* Seules les parties non nulles sont dites (2026-11-18 : « 0 patient à prévenir » laissait croire à un message sur les patients) ;
                       un seul produit dû : vente et produit nommés ; le lien mène à ce qui est signalé *@
                    <div class="info-bandeau" role="status" data-champ="patients_a_prevenir">
                        Produit redevenu disponible : @TexteDisponibilite(ad).
                        @if (ad.Patients.Count > 0)
                        {
                            <button type="button" class="lien-bouton" @onclick="() => patientsAttenteOuvert = true">Voir les patients en attente</button>
                        }
                        @if (ad.VentesEnAttente.Count > 0 && attentes.Count > 0)
                        {
                            <button type="button" class="lien-bouton" @onclick="() => attentesOuvertes = true">Voir les ventes en attente</button>
                        }
                    </div>
                }
                @if (patientsAttenteOuvert)
                {
                    @* Patients en attente depuis la Caisse (2026-11-16) : droit caisse.vendre seulement, sans accès aux Achats ; fenêtre
                       par-dessus la vente (le panier reste en place), patient de la vente en cours déjà choisi *@
                    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-patients-attente" @onkeydown="ToucheFenetrePatientsAttenteAsync">
                        <section class="panneau" style="width: min(1400px, 96vw); max-height: 86vh; overflow: auto; display: flex; flex-direction: column; gap: 10px">
                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px">
                                <h2 id="t-patients-attente" style="margin: 0">Patients en attente d’un produit</h2>
                                <button type="button" class="btn" @onclick="FermerPatientsAttente">Fermer</button>
                            </div>
                            <OngletPatientsAttente EnFenetre="true" PatientInitial="patient" />
                        </section>
                    </div>
                }

                @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

                @if (volet is not null && patientVoletOuvert)
                {
                    @* Volet prérempli (2026-11-15) : assuré inconnu, le vendeur saisit le nom du patient (ordonnance en main) ;
                       sans nom, fiche créée au nom provisoire « Assuré n°/suffixe », à compléter. La vente continue sans autre ressaisie. *@
                    <div class="voile" role="dialog" aria-modal="true" aria-labelledby="t-patient-volet" @onkeydown="TouchePatientVoletAsync">
                        <section class="panneau" style="max-width: 480px; width: 100%">
                            <h2 id="t-patient-volet">Nouveau patient du volet Chifa</h2>
                            <p style="margin: 0">Assuré inconnu : saisissez le nom du patient inscrit sur l’ordonnance.</p>
                            <div class="champ">
                                <label for="pv-nom">Nom du patient</label>
                                <input id="pv-nom" data-champ="nom_patient_volet" type="text" maxlength="120" autocomplete="off" autofocus
                                       @bind="nomPatientVolet" @bind:event="oninput" />
                            </div>
                            <div class="champ">
                                <label for="pv-assure">N° d’assuré@(RangAssure.Extraire(volet.Assure) is { } rangPv ? $" · rang {rangPv}" : "")</label>
                                <input id="pv-assure" type="text" readonly value="@volet.Assure" />
                            </div>
                            @* Ayant droit inconnu (2026-11-15) : lien proposé vide ; assuré principal proposé = fiche de même n° de base au lien « assuré » *@
                            <div class="achats-ligne">
                                <div class="champ" style="flex: 0 1 150px"><label for="pv-lien">Lien</label>
                                    <select id="pv-lien" data-champ="lien" @bind="lienPatientVolet">
                                        <option value="">Non renseigné</option>
                                        <option value="assure">Assuré</option>
                                        <option value="conjoint">Conjoint</option>
                                        <option value="enfant">Enfant</option>
                                        <option value="ascendant">Ascendant</option>
                                        <option value="autre">Autre</option>
                                    </select></div>
                                <div class="champ" style="flex: 1 1 220px"><label for="pv-principal">Assuré principal</label>
                                    <select id="pv-principal" data-champ="assure_principal" @bind="principalPatientVolet" disabled="@(lienPatientVolet == "assure")">
                                        <option value="">Aucun</option>
                                        @if (volet.AssurePrincipalProposeId is { } apid)
                                        {
                                            <option value="@apid">@volet.AssurePrincipalPropose</option>
                                        }
                                    </select></div>
                            </div>
                            <div class="champ">
                                <span>Organisme</span>
                                <div>
                                    @foreach (var o in organismes.Where(o => o.Code is "CNAS" or "CASNOS"))
                                    {
                                        <button type="button" class="puce" aria-pressed="@(o.Id == organismeId ? "true" : "false")"
                                                @onclick="() => organismeId = o.Id">@o.Code</button>
                                    }
                                </div>
                            </div>
                            @if (erreurPatientVolet is not null) { <div class="erreur" role="alert">@erreurPatientVolet</div> }
                            <div class="filtres">
                                <button type="button" class="btn btn-principal" disabled="@patientVoletEnCours" @onclick="() => EnregistrerPatientVoletAsync(nomPatientVolet)">Enregistrer</button>
                                <button type="button" class="btn" disabled="@patientVoletEnCours" title="Fiche créée au nom provisoire « Assuré n°/suffixe », à compléter"
                                        @onclick="() => EnregistrerPatientVoletAsync(null)">Passer</button>
                            </div>
                        </section>
                    </div>
                }

                @if (volet is not null)
                {
                    @* Volet Chifa scanné : vente reprise en tiers payant ; format du QR à confirmer avec l'éditeur de Chifa *@
                    @* Nombre de vignettes attendu en grand (2026-11-15) : somme des boîtes du volet, pour contrôler les vignettes collées *@
                    <div style="display: flex; gap: 8px; align-items: stretch">
                    <div class="vignettes-chifa" role="status" aria-label="@($"{VignettesChifa.Nombre(volet)} vignette(s) attendue(s)")"
                         title="Vignettes à coller : somme des boîtes des lignes du volet">
                        <span class="vignettes-nombre">@VignettesChifa.Nombre(volet)</span><span class="detail">vignette(s)</span>
                    </div>
                    <div class="info-bandeau" role="status" style="flex: 1 1 auto">
                        <strong>Volet Chifa n° @volet.NumeroFacture du @Libelles.Date(volet.DateFacture)</strong> · assuré @volet.Assure@(RangAssure.Extraire(volet.Assure) is { } rangBv ? $" (rang {rangBv})" : "")
                        · @(volet.Patient is { } nomPatient ? $"patient {nomPatient}" : patient is { } pv ? $"patient {pv.Nom}" : "patient inconnu")
                        · ordonnance @Libelles.Dinars(volet.MontantOrdonnance, 2)@(volet.DateSecondaire is { } dOrd ? $" du {Libelles.Date(dOrd)}" : "")
                        @* Organisme du volet (2026-11-15) : CNAS ou CASNOS (même carte Chifa, le QR ne le dit pas), changé en un clic *@
                        · organisme
                        @foreach (var o in organismes.Where(o => o.Code is "CNAS" or "CASNOS"))
                        {
                            <button type="button" class="puce" aria-pressed="@(o.Id == organismeId ? "true" : "false")"
                                    @onclick="() => ChoisirOrganismeVoletAsync(o.Id)">@o.Code</button>
                        }
                        <button type="button" class="lien-bouton" @onclick="RetirerVoletAsync">Retirer le volet</button>
                    </div>
                    </div>
                    @* Prix Chifa différent du nôtre (prix du lot servi) : ligne orange ; sous le seuil, aligné d'office ; au-delà, choix d'un ayant
                       droit prix.modifier, sinon le plus élevé d'office (le code d'un ayant droit permet de choisir, à l'encaissement) *@
                    @if (EcartsChifaAffiches is { Count: > 0 } ecarts)
                    {
                        <div class="bandeau-attention" role="status" data-champ="prix_chifa" style="display: flex; flex-direction: column; gap: 4px">
                            @if (ecarts.Where(e => e.AChoisir).Select(e => e.ProduitId).Distinct().Count() > 1)
                            {
                                <div style="display: flex; gap: 8px; flex-wrap: wrap">
                                    <button type="button" class="lien-bouton" @onclick="@(() => ChoisirToutChifaAsync(ChoixAligne))">Tout aligner sur Chifa</button>
                                    <button type="button" class="lien-bouton" @onclick="@(() => ChoisirToutChifaAsync(ChoixGarde))">Tout garder à notre prix</button>
                                </div>
                            }
                            @foreach (var e in ecarts)
                            {
                                var choisi = choixChifa.GetValueOrDefault(e.ProduitId);
                                <div style="display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center">
                                    <span style="flex: 1 1 320px"><strong>@e.Produit</strong> : prix Chifa @Libelles.Dinars(e.PrixChifa, 2), notre prix @Libelles.Dinars(e.NotrePrix, 2),
                                        écart @Libelles.Dinars(Math.Abs(e.PrixChifa - e.NotrePrix), 2) par boîte · @LibelleChoixChifa(e, choisi)</span>
                                    @if (e.AChoisir)
                                    {
                                        <button type="button" class="puce" aria-pressed="@(choisi == ChoixAligne ? "true" : "false")"
                                                title="@(Session.A("prix.modifier") ? "Ligne vendue au prix Chifa" : "Validé à l’encaissement par le code d’un employé qui peut modifier les prix")"
                                                @onclick="@(() => ChoisirChifaAsync(e.ProduitId, ChoixAligne))">S’aligner sur Chifa</button>
                                        <button type="button" class="puce" aria-pressed="@(choisi == ChoixGarde ? "true" : "false")"
                                                title="@(Session.A("prix.modifier") ? "La différence est à la charge du patient" : "Validé à l’encaissement par le code d’un employé qui peut modifier les prix")"
                                                @onclick="@(() => ChoisirChifaAsync(e.ProduitId, ChoixGarde))">Garder notre prix</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                @foreach (var c in codesAAssocier)
                {
                    <div class="bandeau-attention" role="status" data-champ="code_chifa" style="display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end">
                        <span style="flex: 1 1 260px">Code Chifa <strong>@c.Code</strong> (@c.Quantite boîte(s) à @Libelles.Dinars(c.PrixUnitaire, 2)) inconnu : choisissez le produit, il sera reconnu aux prochains volets.</span>
                        <ChoixProduit Id="@($"chifa-{c.Code}")" Libelle="Produit du code Chifa" Style="flex: 1 1 280px" OnChoisi="p => AssocierCodeAsync(c, p)" />
                    </div>
                }

                @if (bandeau is not null)
                {
                    <div class="bandeau" role="alert">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B42318" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 1px"><circle cx="12" cy="12" r="9"></circle><path d="M5.6 5.6l12.8 12.8"></path></svg>
                        <div>
                            <strong>@bandeau.Titre</strong>
                            @if (bandeau.Detail is not null) { <span>@bandeau.Detail</span> }
                        </div>
                    </div>
                }

                @if (lignes.Count == 0)
                {
                    <div class="carte vide">Panier vide : scannez une boîte ou recherchez un produit.</div>
                }
                else
                {
                    <div class="panier cadre-defilant cadre-prioritaire" data-champ="lignes">
                        @foreach (var l in lignes)
                        {
                            @if (l.EstPrestation)
                            {
                                @* Prestation (script 105) : sans lot ni stock, jamais prise en charge par l'organisme, pas de retour (annulation ou avoir) *@
                                <div class="panier-ligne" data-ligne="@lignes.IndexOf(l)">
                                    <div class="panier-produit">
                                        <span>@l.Nom</span>
                                        <span class="detail">Prestation · TVA @((l.TauxTva ?? 0).ToString("0.##")) % · sans stock</span>
                                    </div>
                                    <div class="quantite">
                                        <button type="button" class="btn btn-icone" aria-label="Retirer une prestation" @onclick="() => ChangerAsync(l, -1)">−</button>
                                        <span>× @l.Quantite</span>
                                        <button type="button" class="btn btn-icone" aria-label="Ajouter une prestation" disabled="@(l.Quantite >= 99)" @onclick="() => ChangerAsync(l, +1)">+</button>
                                    </div>
                                    @if (l.Reduction is { Montant: > 0 } redp)
                                    {
                                        <span class="montant montant-reduit" title="Remise">
                                            <s>@Libelles.Dinars(l.Prix * l.Quantite, 2)</s>
                                            <span class="reduction">remise −@redp.PctApplique.ToString("0") %</span>
                                            <strong>@Libelles.Dinars(l.Prix * l.Quantite - redp.Montant, 2)</strong>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="montant">@Libelles.Dinars(l.Prix * l.Quantite, 2)</span>
                                    }
                                </div>
                            }
                            else if (l.Lot is { } lot)
                            {
                                <div class="panier-ligne" data-ligne="@lignes.IndexOf(l)">
                                    <div class="panier-produit">
                                        <span>@l.Nom</span>
                                        <span>Lot servi @lot.NumeroLot · exp. @Libelles.Date(lot.DatePeremption) ·
                                            @if (l.LotConseilleServi) { <span class="fefo">lot conseillé (péremption proche)</span> } else if (l.BoiteScannee) { <span class="fefo">boîte scannée</span> } else if (lignes.FirstOrDefault(x => x.ProduitId == l.ProduitId && x.Lot is not null && !x.BoiteScannee) != l) { <span class="fefo">lot suivant (FEFO), le précédent ne suffit pas</span> } else { <span class="fefo">premier à expirer (FEFO)</span> }
                                        </span>
                                        <span class="stock-restant @(StockApresVente(l) == 0 ? "epuise" : null)">
                                            Stock : @l.StockProduit boîte(s) · reste @StockApresVente(l) après cette vente
                                        </span>
                                    </div>
                                    @if (l.AvertissementFefo is not null && l.LotConseille is { } conseille)
                                    {
                                        <div class="avertissement-fefo @l.CouleurFefo" role="alert">
                                            <span>@l.AvertissementFefo</span>
                                            <span class="detail">Lot @conseille.NumeroLot : @conseille.Quantite boîte(s) en stock@(l.EmplacementConseille is { } empl ? $" · rangé {empl}" : "") · fournisseur @conseille.Fournisseur</span>
                                            <div style="display: flex; gap: 8px; flex-wrap: wrap">
                                                <button type="button" class="btn btn-principal" @onclick="() => ServirLotConseilleAsync(l)">J’ai pris une boîte du lot @conseille.NumeroLot</button>
                                                <button type="button" class="btn" @onclick="() => { l.AvertissementFefo = null; l.LotConseille = null; }">Garder cette boîte</button>
                                            </div>
                                        </div>
                                    }
                                    @if (l.Situation is { Situation: "peremption" or "obligatoire" } sit)
                                    {
                                        @* Lot plus ancien en stock : raison vérifiée (à valider) ou à choisir ; inscrite avec la vente *@
                                        <div class="avertissement-fefo @(l.RaisonLot is null ? "orange" : "compact")" role="group" data-champ="raison_lot" aria-label="Raison du lot servi">
                                            <span>
                                                Lot plus ancien en stock : @sit.LotDelaisse@(sit.PeremptionDelaisse is { } pd ? $" (exp. {Libelles.Date(pd)})" : "").
                                                @if (l.RaisonLot is { } r) { <strong> Raison : @RaisonLotLibelle(r).</strong> }
                                            </span>
                                            @if (l.RaisonLot is null)
                                            {
                                                <div style="display: flex; gap: 8px; flex-wrap: wrap">
                                                    @if (sit.Situation == "peremption")
                                                    {
                                                        <span class="detail" style="flex-basis: 100%">Vérifié par le logiciel : ce lot périme avant le lot @sit.LotDelaisse.</span>
                                                        <button type="button" class="btn btn-principal" @onclick="() => ChoisirRaisonAsync(l, RaisonPeremption)">Valider : péremption plus proche</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="detail" style="flex-basis: 100%">Pourquoi servir ce lot ?</span>
                                                    }
                                                    <button type="button" class="btn" @onclick="() => ChoisirRaisonAsync(l, RaisonIntrouvable)">Boîte de l’ancien lot introuvable</button>
                                                    <button type="button" class="btn" @onclick="() => ChoisirRaisonAsync(l, RaisonAbimee)">Boîte abîmée</button>
                                                    <button type="button" class="btn" @onclick="() => ChoisirRaisonAsync(l, RaisonDemandeClient)">Demande du client</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button" class="lien-bouton" @onclick="() => ChoisirRaisonAsync(l, null)">Changer la raison</button>
                                            }
                                        </div>
                                    }
                                    <div class="quantite">
                                        <button type="button" class="btn btn-icone" aria-label="Retirer une boîte" @onclick="() => ChangerAsync(l, -1)">−</button>
                                        <span>× @l.Quantite</span>
                                        <button type="button" class="btn btn-icone" aria-label="Ajouter une boîte" disabled="@(l.Quantite >= lot.Quantite)" @onclick="() => ChangerAsync(l, +1)">+</button>
                                    </div>
                                    @if (l.Reduction is { Montant: > 0 } red)
                                    {
                                        @* Remise par produit (2026-11-14) : montant initial barré, pourcentage, net ; « don » sur un médicament *@
                                        <span class="montant montant-reduit" title="@(red.DonPartiel ? "Don partiel du reste à charge" : "Remise")">
                                            <s>@Libelles.Dinars(l.Prix * l.Quantite, 2)</s>
                                            <span class="reduction">@(red.DonPartiel ? "don" : "remise") −@red.PctApplique.ToString("0") %@(red.RemiseAutoPct > 0 ? " (auto)" : "")</span>
                                            <strong>@Libelles.Dinars(l.Prix * l.Quantite - red.Montant, 2)</strong>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="montant">@Libelles.Dinars(l.Prix * l.Quantite, 2)</span>
                                    }
                                    @if (l.QuantiteDemandee > l.Quantite)
                                    {
                                        <div class="manque">
                                            <span class="alerte-rupture">Stock insuffisant : il manque @(l.QuantiteDemandee - l.Quantite) boîte(s), aucun autre lot vendable de ce produit.</span>
                                            @foreach (var alt in l.Alternatives.Take(1))
                                            {
                                                <div class="alternative">
                                                    <span>@LibelleEquivalent(alt)</span>
                                                    <button type="button" class="btn btn-principal" @onclick="() => CompleterAsync(l, alt)">Compléter avec @(l.QuantiteDemandee - l.Quantite)</button>
                                                </div>
                                            }
                                            @if (l.Alternatives.Count == 0) { <span class="detail">Aucun équivalent de même DCI en stock.</span> }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="panier-ligne rupture" data-ligne="@lignes.IndexOf(l)">
                                    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px">
                                        <div class="panier-produit">
                                            <span>@l.Nom</span>
                                            <span class="alerte-rupture">Rupture de stock</span>
                                            @if (l.Ecartes.Count > 0)
                                            {
                                                <span class="detail">@string.Join(", ", l.Ecartes.Select(e => $"lot {e.NumeroLot} {(e.Raison == "bloque" ? "bloqué" : "périmé")}")) : à retirer du stock</span>
                                            }
                                        </div>
                                        <button type="button" class="btn" @onclick="() => RetirerAsync(l)">Retirer</button>
                                    </div>
                                    @foreach (var alt in l.Alternatives.Take(3))
                                    {
                                        <div class="alternative">
                                            <span>@LibelleEquivalent(alt)</span>
                                            <button type="button" class="btn btn-principal" @onclick="() => RemplacerAsync(l, alt)">Remplacer</button>
                                        </div>
                                    }
                                    @if (l.Alternatives.Count == 0) { <span class="detail">Aucun équivalent de même DCI en stock.</span> }
                                </div>
                            }
                        }
                    </div>
                }

                <!-- 2 · Client et ordonnance -->
                @* data-repli-auto : poste.js replie le bloc en une ligne si l'écran déborde encore, panier au minimum (2026-11-18, 1366 × 768) *@
                <section class="panneau bloc-client" aria-label="Client et ordonnance" data-repli-auto="@(RepliAutoPermis ? "1" : null)">
                    <div class="bloc-client-entete">
                        <strong>2 · Client et ordonnance</strong>
                        @* Titre et boutons sur la première rangée, la consigne (psychotrope, liste I ou II…) sur toute la rangée suivante
                           (2026-11-18 : à 1366 × 768, titre, consigne et boutons prenaient trois rangées) *@
                        <div class="bloc-client-actions">
                            @if (ClientOuvert && !ClientResume && !nouveauPatient && nouveauMedecin is null)
                            {
                                <button type="button" class="lien-bouton" title="Résumer le bloc en une ligne ; « Modifier » le rouvre" @onclick="ReduireClient">Réduire ▴</button>
                            }
                            <div class="filtres" role="group" aria-label="Type de vente">
                                <button type="button" class="puce" aria-pressed="@(!tiersPayant ? "true" : "false")" @onclick="() => ChoisirTiersPayantAsync(false)">Vente libre</button>
                                <button type="button" class="puce" aria-pressed="@(tiersPayant ? "true" : "false")" @onclick="() => ChoisirTiersPayantAsync(true)">Tiers payant</button>
                            </div>
                        </div>
                        @* Bloc réduit : pas d'étiquette (le résumé dit ce qui manque) *@
                        @if (ClientResume) { }
                        else if (OrdonnanceObligatoire)
                        {
                            <span class="indice requis">psychotrope : ordonnance obligatoire (médecin, patient)</span>
                        }
                        else if (TiersSansPart && medecin is null && jetonScan is null)
                        {
                            <span class="indice" role="note">
                                @(Session.A("caisse.vendre_sans_ordonnance")
                                    ? "L’organisme ne paie rien : médecin facultatif ; sans ordonnance, vente permise par votre droit (inscrite au journal)"
                                    : "L’organisme ne paie rien : médecin facultatif ; sans ordonnance, validation du titulaire ou d’un ayant droit (son code) à l’encaissement")
                            </span>
                        }
                        else if (SansOrdonnanceListe)
                        {
                            <span class="indice" role="note" data-champ="sans_ordonnance">
                                @(Session.A("caisse.vendre_sans_ordonnance")
                                    ? "Liste I ou II : médecin attendu ; sans ordonnance, vente permise par votre droit (inscrite au journal)"
                                    : "Liste I ou II : médecin attendu ; sans ordonnance, validation du titulaire ou d’un ayant droit (son code) à l’encaissement")
                            </span>
                        }
                        else if (!ClientOuvert)
                        {
                            <span class="detail">aucun patient, aucune ordonnance exigée</span>
                        }
                    </div>

                    @if (!ClientOuvert)
                    {
                        <div class="bloc-client-reduit">
                            <button type="button" class="lien-bouton" data-raccourci="patient" @onclick="() => clientDeplie = true">Ajouter un patient (F6)</button>
                            <span class="espace"></span>
                            <span class="detail">Ordonnance :</span>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ScannerOrdonnanceAsync">Scanner</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="OuvrirCameraAsync">Caméra</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ImporterOrdonnanceAsync">Fichier</button>
                            @if (lectureEnCours) { <span class="sous-titre" role="status">Lecture de l’ordonnance…</span> }
                        </div>
                    }
                    else if (ClientResume)
                    {
                        @* Tout ce qu'il faut est saisi (2026-11-15) : une ligne, le panier garde la place ; « Modifier » rouvre le bloc *@
                        <div class="bloc-client-reduit resume-client">
                            <span><strong>@(patient is null ? "Aucun patient" : $"{patient.Nom} {patient.Prenom}".Trim())</strong>@(tiersPayant ? $" · {OrganismeCode} {(resteSaisi is { } r ? $"reste {Libelles.Dinars(r, 2)}" : $"{taux} %")}" : "")@(medecin is not null ? $" · {medecin.Nom}" : "")@(medecin is not null || jetonScan is not null ? $" · ordonnance{(string.IsNullOrWhiteSpace(numeroOrdonnance) ? "" : " " + numeroOrdonnance.Trim())} du {datePrescription:dd/MM/yyyy}" : "")</span>
                            @if (ManqueClient is { } manque) { <span class="texte-attention">à compléter : @manque</span> }
                            <span class="espace"></span>
                            @* data-raccourci="client" : F6 et F5 rouvrent le bloc puis placent le curseur sur le patient ou le médecin (poste.js) *@
                            <button type="button" class="lien-bouton" data-raccourci="client" @onclick="ModifierClient">Modifier ▾</button>
                        </div>
                    }
                    else
                    {

                        <div class="bloc-client-grille @(AfficherMedecin ? "deux" : null)">
                            <!-- Patient -->
                            <div class="champ recherche">
                                @* « Nouveau patient » à droite du libellé (2026-11-15) : une ligne de moins dans la colonne de paiement *@
                                <div class="etiquette-ligne">
                                    <span class="etiquette-champ @(PatientObligatoire ? "requis" : null)">Patient @(PatientObligatoire ? "(obligatoire)" : "(facultatif)") <span class="detail">F6</span></span>
                                    @if (patient is null && !nouveauPatient)
                                    {
                                        <button type="button" class="lien-bouton" @onclick="OuvrirNouveauPatient">Nouveau patient</button>
                                    }
                                    else if (patient is not null)
                                    {
                                        @* 2026-11-16 : « Prévenir quand disponible » pour le patient de la vente, sans quitter la Caisse *@
                                        <button type="button" class="lien-bouton" data-champ="prevenir_dispo" title="Noter le patient en attente d’un produit en rupture (file des patients en attente)"
                                                @onclick="() => patientsAttenteOuvert = true">Prévenir quand disponible</button>
                                    }
                                </div>
                                @if (patient is not null)
                                {
                                    <div class="choix">
                                        <div>
                                            <strong><LienContact Type="patient" Id="patient.Id" Nom="@($"{patient.Nom} {patient.Prenom}".Trim())" /></strong><br />
                                            <span class="detail">
                                                @(patient.NumAssure is null ? "sans n° d’assuré" : $"Assuré {patient.NumAssure}")@if (patient.Organisme is { } org) { <text> · </text><LienContact Type="organisme" Id="patient.OrganismeId" Nom="@org" /> }
                                                · crédit @Libelles.Dinars(patient.SoldeCredit) / plafond @Libelles.Dinars(patient.PlafondCredit)
                                            </span>
                                            @* Droits Chifa expirés (script 102, D-4) : avertissement seulement, la vente n'est pas bloquée ; contrôle de fin de droits
                                               (2026-11-15) : « Mettre à jour la date » si expirés, date proche en orange, date absente signalée (saisie facultative) *@
                                            @if (DroitsChifaExpires is { } finDroit)
                                            {
                                                <br /><span class="detail" role="alert" data-champ="droits_chifa_expires" style="color: var(--danger, #b42318)">Droits Chifa expirés depuis le @Libelles.Date(finDroit) : vérifiez la carte (vente non bloquée).</span>
                                                @if (majFinDroitPatient != patient.Id)
                                                {
                                                    <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => { majFinDroitPatient = patient.Id; majFinDroitDate = null; erreurFinDroit = null; }">Mettre à jour la date</button>
                                                }
                                            }
                                            else if (EtatDroitsPatient == EtatDroits.BientotExpires && patient.DateFinDroit is { } bientot)
                                            {
                                                <br /><span class="detail texte-attention" role="status" data-champ="droits_chifa_bientot" style="color: var(--attention)">@EtatDroitsChifa.MessageBientot(bientot)</span>
                                            }
                                            else if (EtatDroitsPatient == EtatDroits.Absente)
                                            {
                                                <br /><label class="detail" for="fin-droit-caisse">Fin de droits (lue sur Chifa)</label>
                                                <input id="fin-droit-caisse" data-champ="fin_droit_caisse" type="date" style="width: auto; margin-left: 6px"
                                                       @bind="finDroitSaisie" @bind:after="() => finDroitSaisiePatient = patient.Id" />
                                                @if (finDroitSaisie is null || finDroitSaisiePatient != patient.Id)
                                                {
                                                    <span class="pastille attention" title="Facultatif : la date lue sur la carte Chifa est enregistrée sur la fiche à l’encaissement">à renseigner</span>
                                                }
                                            }
                                            @if (majFinDroitPatient == patient.Id && DroitsChifaExpires is not null)
                                            {
                                                <br /><label class="detail" for="maj-fin-droit">Nouvelle date de fin de droits</label>
                                                <input id="maj-fin-droit" data-champ="maj_fin_droit" type="date" style="width: auto; margin-left: 6px" @bind="majFinDroitDate" />
                                                <button type="button" class="lien-bouton" style="margin-left: 6px" disabled="@(majFinDroitDate is null)" @onclick="EnregistrerFinDroitAsync">Enregistrer</button>
                                                <button type="button" class="lien-bouton" style="margin-left: 6px" @onclick="() => majFinDroitPatient = null">Annuler</button>
                                                @if (erreurFinDroit is not null) { <br /><span class="detail" role="alert" style="color: var(--danger, #b42318)">@erreurFinDroit</span> }
                                            }
                                        </div>
                                        <button type="button" class="lien-bouton" @onclick="RetirerPatientAsync">Changer</button>
                                    </div>
                                }
                                else if (!nouveauPatient)
                                {
                                    @* Propositions pendant la frappe (composant commun ChoixPatient, 2026-11-18) : ↑ ↓ Entrée Échap, F6 y met le curseur *@
                                    <ChoixPatient @key="cleSaisieClient" Id="caisse-patient" Cadre="false" data-raccourci="patient" aria-label="Rechercher un patient"
                                                  class="@Obligatoire.Classe(PatientManquant)" Invalide="PatientManquant && alerterPatient" OnFocus="() => alerterPatient = false"
                                                  TexteInitial="@patientTexte" OnTexte="t => patientTexte = t" OnChoisi="ChoisirPatientAsync" />
                                }
                                else
                                {
                                    <span class="detail">Nouveau patient : complétez sa fiche ci-dessous.</span>
                                }
                            </div>
                            @if (AfficherMedecin)
                            {
                                <div class="champ recherche">
                                    @* « Nouveau médecin » à droite du libellé, comme « Nouveau patient » (2026-11-18) : le lien « Créer le médecin « … » » qui
                                       apparaissait sous le champ dès 2 lettres faisait bouger le bloc pendant la frappe *@
                                    <div class="etiquette-ligne">
                                        <span class="etiquette-champ @(MedecinObligatoire ? "requis" : null)" title="@(OrdonnanceObligatoire ? "Psychotrope ou stupéfiant : ordonnance obligatoire" : MedecinParLeTaux ? "Tiers payant : l’organisme paie une partie du médicament" : null)">Médecin@(MedecinObligatoire ? " (obligatoire)" : jetonScan is not null ? " (ordonnance scannée)" : "") <span class="detail">F5</span></span>
                                        @if (medecin is null && nouveauMedecin is null)
                                        {
                                            <button type="button" class="lien-bouton" title="Fiche du médecin, nom repris de la recherche" @onclick="OuvrirNouveauMedecin">Nouveau médecin</button>
                                        }
                                    </div>
                                    @if (medecin is not null)
                                    {
                                        @* Médecin choisi sur une ligne : nom et « Changer » ; la spécialité au survol *@
                                        <div class="choix medecin-choisi" title="@(string.IsNullOrWhiteSpace(medecin.Specialite) ? medecin.Nom : $"{medecin.Nom} · {medecin.Specialite}")">
                                            <strong>@medecin.Nom</strong>
                                            @* Wilaya du médecin (2026-11-22) : proposée d'après sa fiche, à choisir si la fiche n'en a pas, rectifiable ; enregistrée dans
                                               la fiche dès le choix (contrôle « hors zone » des psychotropes). Invisible tant qu'aucun médecin n'est choisi. *@
                                            <select @key="versionWilaya" class="wilaya-medecin @(string.IsNullOrEmpty(medecin.Wilaya) ? "manquant" : null)" aria-label="Wilaya d’exercice du médecin" data-champ="wilaya_medecin"
                                                    title="@(string.IsNullOrEmpty(medecin.Wilaya) ? "Wilaya du médecin à choisir : enregistrée dans sa fiche (contrôle « hors zone »)" : "Wilaya de la fiche du médecin : rectifiable, la fiche est mise à jour")"
                                                    value="@(medecin.Wilaya ?? "")" @onchange="ChangerWilayaMedecinAsync" disabled="@enregistrementWilaya">
                                                <option value="">Wilaya ?</option>
                                                @foreach (var w in wilayas) { <option value="@w.Code">@w.Code - @w.Nom</option> }
                                            </select>
                                            <button type="button" class="lien-bouton" @onclick="() => medecin = null">Changer</button>
                                        </div>
                                        @if (messageWilaya is not null)
                                        {
                                            <span class="detail" role="status">@messageWilaya</span>
                                        }
                                    }
                                    else
                                    {
                                        @* Propositions pendant la frappe (composant commun ChoixMedecin, 2026-11-18) : attente de frappe, réponses périmées ignorées *@
                                        <ChoixMedecin @key="cleSaisieClient" Id="caisse-medecin" Cadre="false" data-raccourci="medecin" aria-label="Rechercher le médecin prescripteur"
                                                      data-champ="nom_medecin" class="@Obligatoire.Classe(MedecinManquant)" Invalide="MedecinManquant && alerterMedecin"
                                                      OnFocus="() => alerterMedecin = false" TexteInitial="@medecinTexte" OnTexte="t => medecinTexte = t"
                                                      OnChoisi="ChoisirMedecinAsync" />
                                        @if (nouveauMedecin is not null)
                                        {
                                            <span class="detail">Nouveau médecin : complétez sa fiche ci-dessous.</span>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        @* Fiche du nouveau patient sur toute la largeur, quatre champs par ligne (recette 2026-11-15 : écran fixe en tiers payant) *@
                        @if (nouveauPatient && patient is null)
                        {
                        <div class="sous-formulaire fiche-medecin large" role="group" aria-label="Nouveau patient">
                            <input type="text" aria-label="Nom (obligatoire)" data-champ="nom_patient" placeholder="Nom *" @ref="champNomPatient" @bind="np.Nom" @bind:event="oninput"
                                   class="@Obligatoire.Classe(NomPatientManquant)" aria-invalid="@Obligatoire.Aria(NomPatientManquant)" />
                            <input type="text" aria-label="Prénom" placeholder="Prénom" @bind="np.Prenom" />
                            <input type="text" aria-label="Téléphone" data-champ="telephone" placeholder="Téléphone" @bind="np.Telephone" />
                            <input type="email" aria-label="E-mail (facultatif)" data-champ="email" placeholder="E-mail" maxlength="120" @bind="np.Email" />
                            <input type="text" aria-label="N° d’assuré" placeholder="N° d’assuré" @bind="np.NumAssure" />
                            <select class="selection" aria-label="Organisme" @bind="np.OrganismeId">
                                <option value="0">Sans organisme</option>
                                @foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }
                            </select>
                            <input type="number" min="0" aria-label="Plafond de crédit (DA)" data-champ="plafond" placeholder="Plafond de crédit (DA)" @bind="np.Plafond" />
                            @if (NomPatientManquant) { <span class="message-champ" style="grid-column: 1 / -1">Le nom du patient est obligatoire.</span> }
                            @if (patientExistant is { } existant)
                            {
                                <span class="message-champ" style="grid-column: 1 / -1">
                                    Ce n° d’assuré est celui de @($"{existant.Nom} {existant.Prenom}".Trim()).
                                    <button type="button" class="lien-bouton" @onclick="OuvrirPatientExistantAsync">Ouvrir sa fiche</button>
                                </span>
                            }
                            <div class="actions">
                                <button type="button" class="btn btn-principal" @onclick="CreerPatientAsync">Créer</button>
                                <button type="button" class="btn" @onclick="() => (nouveauPatient, controlePatient) = (false, false)">Annuler</button>
                            </div>
                        </div>
                        }
                        @if (nouveauMedecin is { } nm)
                        {
                            @* Fiche du nouveau médecin (2026-11-15) : nom obligatoire ; spécialité, téléphone, e-mail, adresse, n° d'ordre et
                               code CNAS facultatifs *@
                            <div class="sous-formulaire fiche-medecin large" role="group" aria-label="Nouveau médecin">
                                <input type="text" aria-label="Nom du médecin (obligatoire)" data-champ="nom_medecin" placeholder="Nom *" maxlength="120" @bind="nm.Nom" />
                                @* Valeurs déjà saisies proposées (spécialités des médecins), texte libre accepté *@
                                <ValeursSaisies Id="nm-specialite" Champ="specialite_medecin" @bind-Valeur="nm.Specialite" aria-label="Spécialité" data-champ="specialite"
                                                placeholder="Spécialité" maxlength="120" />
                                <input type="text" aria-label="Téléphone" data-champ="telephone" placeholder="Téléphone" maxlength="30" @bind="nm.Telephone" />
                                <input type="email" aria-label="E-mail" data-champ="email" placeholder="E-mail" maxlength="120" @bind="nm.Email" />
                                <input type="text" aria-label="Adresse" data-champ="adresse_medecin" placeholder="Adresse" maxlength="300" @bind="nm.Adresse" />
                                <input type="text" aria-label="N° d’inscription à l’Ordre" data-champ="numero_ordre" placeholder="N° d’ordre" maxlength="30" @bind="nm.NumeroOrdre" />
                                <input type="text" aria-label="Code CNAS (Chifa)" data-champ="code_cnas" placeholder="Code CNAS" maxlength="30" @bind="nm.CodeCnas" />
                                <select aria-label="Wilaya d’exercice" data-champ="wilaya_medecin" @bind="nm.Wilaya"
                                        title="@(string.IsNullOrEmpty(nm.Wilaya) ? "Wilaya à renseigner : sans elle, pas de contrôle « hors zone » des psychotropes" : null)">
                                    <option value="">Wilaya (à renseigner)</option>
                                    @foreach (var w in wilayas) { <option value="@w.Code">@w.Code - @w.Nom</option> }
                                </select>
                                @if (erreurMedecin is not null) { <div class="erreur" role="alert">@erreurMedecin</div> }
                                <div class="actions">
                                    <button type="button" class="btn btn-principal" disabled="@creationMedecin" @onclick="CreerMedecinAsync">Créer</button>
                                    <button type="button" class="btn" @onclick="() => (nouveauMedecin, erreurMedecin) = (null, null)">Annuler</button>
                                </div>
                            </div>
                        }
                        @if (PsychotropeInterdit)
                        {
                            <div class="erreur" role="alert">@MessagePsychotrope</div>
                        }

                        <div class="bloc-client-ordonnance">
                            @if (AfficherMedecin)
                            {
                                <div class="champ">
                                    <label for="date-prescription">Date de prescription</label>
                                    <input id="date-prescription" type="date" @bind="datePrescription" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="champ">
                                    <label for="numero-ordonnance">N° d’ordonnance</label>
                                    <input id="numero-ordonnance" type="text" @bind="numeroOrdonnance" />
                                </div>
                            }
                            <span class="espace"></span>
                            <span class="detail">Ordonnance :</span>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ScannerOrdonnanceAsync">Scanner</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="OuvrirCameraAsync">Caméra</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ImporterOrdonnanceAsync">Fichier</button>
                            @if (lectureEnCours) { <span class="sous-titre" role="status">Lecture…</span> }
                        </div>
                        <!-- Porteur différent du patient : inscrit au registre (arrêté du 29 juin 2013, art. 7) -->
                        @if (apercu?.OrdonnanceRequise == true)
                        {
                            <!-- Porteur différent du patient : inscrit au registre (arrêté du 29 juin 2013, art. 7) -->
                            @* Case cochée : curseur dans le nom ; champs en rouge tout de suite, bulle « À renseigner » seulement à F12 (2026-11-20) *@
                            <label class="case"><input type="checkbox" @bind="porteurAutre" @bind:after="() => focaliserPorteur = porteurAutre" /><span>Le porteur de l’ordonnance n’est pas le patient</span></label>
                            @if (porteurAutre)
                            {
                                <input type="text" aria-label="Nom et prénom du porteur" placeholder="Nom et prénom du porteur *" @bind="porteurNom" @bind:event="oninput" @ref="champPorteurNom"
                                       class="@Obligatoire.Classe(PorteurNomManque)" aria-invalid="@Obligatoire.Aria(PorteurNomManque && alerterPorteur)" @onfocus="() => alerterPorteur = false" />
                                <input type="text" aria-label="Adresse du porteur" placeholder="Adresse du porteur *" @bind="porteurAdresse" @bind:event="oninput"
                                       class="@Obligatoire.Classe(PorteurAdresseManque)" aria-invalid="@Obligatoire.Aria(PorteurAdresseManque && alerterPorteur)" @onfocus="() => alerterPorteur = false" />
                                <input type="text" aria-label="Pièce d’identité du porteur" placeholder="Pièce d’identité (type et n°) *" @bind="porteurPiece" @bind:event="oninput"
                                       class="@Obligatoire.Classe(PorteurPieceManque)" aria-invalid="@Obligatoire.Aria(PorteurPieceManque && alerterPorteur)" @onfocus="() => alerterPorteur = false" />
                            }
                            @* Durée du traitement (2026-11-16) : psychotrope ou stupéfiant seulement, OBLIGATOIRE depuis le 2026-11-19 (script 153) ;
                               inscrite au registre, comparée à la quantité délivrée (« quantité anormale ») et base de « patient encore sous traitement » *@
                            <div class="champ champ-ligne champ-ligne-colle" title="@(DureeManquante ? "Durée du traitement prescrite, obligatoire : inscrite au registre, comparée à la quantité délivrée et aux traitements en cours du patient" : "Durée du traitement, inscrite au registre")">
                                <label for="duree-traitement" class="etiquette-champ requis">Durée du traitement (jours, obligatoire)</label>
                                <input id="duree-traitement" type="number" min="1" max="3650" step="1" style="width: 80px" data-champ="duree_traitement"
                                       class="@Obligatoire.Classe(DureeManquante)" aria-invalid="@Obligatoire.Aria(DureeManquante && alerterDuree)"
                                       @onfocus="() => alerterDuree = false" @bind="dureeTraitement" @bind:event="oninput" />
                            </div>
                        }
                        @* « Remis à » (avec ordonnance) / « Pour » (sans ordonnance), 2026-11-15 : une ligne, la vente reste au nom du patient *@
                        @if (patient is not null)
                        {
                            <div class="champ champ-ligne remise-vente" title="@(AvecOrdonnance ? "Vente au nom du patient de l’ordonnance : personne qui récupère les médicaments" : "Vente au nom de celui qui commande : membre de la famille concerné")">
                                <label for="remise-vente">@(AvecOrdonnance ? "Remis à" : "Pour")</label>
                                @if (RemiseParPorteur)
                                {
                                    <span class="detail">@porteurNom (porteur de l’ordonnance)</span>
                                }
                                else
                                {
                                    <select id="remise-vente" class="selection" data-champ="remis_a pour" @bind="RemiseChoix">
                                        <option value="">@($"{patient?.Nom} {patient?.Prenom}".Trim()) @(AvecOrdonnance ? "(lui-même)" : "(pour lui-même)")</option>
                                        @foreach (var pr in proches) { <option value="@pr.Id">@pr.Nom@LienLibelle(pr.Lien)</option> }
                                        <option value="@RemiseAutreValeur">Autre personne…</option>
                                    </select>
                                    @if (remiseAutre)
                                    {
                                        <input type="text" aria-label="@(AvecOrdonnance ? "Nom de la personne qui récupère" : "Nom de la personne concernée")" placeholder="Nom et prénom" maxlength="200" data-champ="remis_a pour"
                                               @bind="remiseNom" @bind:event="oninput" />
                                    }
                                }
                            </div>
                        }
                    }
                </section>
            </section>

            <!-- 3 · Paiement -->
            <aside class="panneau colonne-laterale reglement" aria-label="Paiement" inert="@(renvoi is not null)">
                <strong>3 · Paiement</strong>
                @if (tiersPayant)
                {
                    @* Tiers payant (2026-11-15) : organisme, taux et reste à charge dans le paiement, au-dessus de la part de l'organisme *@
                    <div class="tiers-payant-paiement" role="group" aria-label="Tiers payant">
                        <div class="champ champ-ligne">
                            <label for="org">Organisme</label>
                            <select id="org" class="selection" @bind="organismeId" @bind:after="RecalculerAsync">
                                @foreach (var o in OrganismesPaiement) { <option value="@o.Id">@o.Code</option> }
                            </select>
                        </div>
                        <div class="champ champ-ligne">
                            <span class="etiquette-champ">Taux</span>
                            <div class="filtres" role="group" aria-label="Taux de remboursement">
                                <button type="button" class="puce" aria-pressed="@(taux == 80 ? "true" : "false")" @onclick="() => ChoisirTauxAsync(80)">80 %</button>
                                <button type="button" class="puce" aria-pressed="@(taux == 100 ? "true" : "false")" @onclick="() => ChoisirTauxAsync(100)">100 %</button>
                            </div>
                        </div>
                        <div class="champ champ-ligne">
                            <label for="reste-saisi">Reste à charge (DA)</label>
                            <input id="reste-saisi" data-champ="reste_a_charge" type="number" min="0" step="0.01" placeholder="Selon le taux"
                                   title="Laissez vide pour appliquer le taux de prise en charge" @bind="resteSaisi" @bind:after="RecalculerAsync" />
                        </div>
                        @if (resteSaisi is not null)
                        {
                            <p class="detail" style="margin: 0">Reste à charge saisi : le taux n’est pas appliqué, la part de l’organisme est la différence. Videz la case pour revenir au taux.</p>
                        }
                        @* Vente Chifa sans volet (script 089) : part organisme facturée par Chifa, jamais par le logiciel. N° de facture Chifa
                           facultatif (circuit « la caisse d'abord », 2026-11-15) : vide, la vente attend son volet, rattaché au scan du QR *@
                        @if (volet is null && OrganismeChifa)
                        {
                            <label class="case" data-champ="facturee_chifa">
                                <input type="checkbox" @bind="factureeChifa" @bind:after="ChargerMotifsSansVoletAsync" /><span>Facturée par Chifa (jamais refacturée par le logiciel)</span>
                            </label>
                            @if (factureeChifa)
                            {
                                <div class="champ champ-ligne">
                                    <label for="facture-chifa">N° de facture Chifa</label>
                                    <input id="facture-chifa" data-champ="facture_chifa" type="text" inputmode="numeric" maxlength="8" placeholder="8 chiffres · vide : volet à scanner ensuite"
                                           class="@Obligatoire.Classe(FactureChifaInvalide)" @onfocus="() => alerterChifa = false"
                                           aria-invalid="@Obligatoire.Aria(FactureChifaInvalide && (alerterChifa || numeroFactureChifa!.Any(c => !char.IsAsciiDigit(c))))"
                                           @bind="numeroFactureChifa" @bind:event="oninput" />
                                </div>
                                @if (FactureChifaEnAttente)
                                {
                                    <div class="champ champ-ligne">
                                        <label for="motif-sans-volet" class="requis">Motif sans n°</label>
                                        <select id="motif-sans-volet" data-champ="motif_sans_volet" @bind="motifSansVolet"
                                                class="@Obligatoire.Classe(string.IsNullOrEmpty(motifSansVolet))" @onfocus="() => alerterChifa = false"
                                                aria-invalid="@Obligatoire.Aria(string.IsNullOrEmpty(motifSansVolet) && alerterChifa)">
                                            <option value="">— Choisir —</option>
                                            @foreach (var m in motifsSansVolet) { <option value="@m.Code">@m.Libelle</option> }
                                        </select>
                                        @if (motifSansVolet == "autre")
                                        {
                                            <input data-champ="motif_sans_volet_texte" type="text" maxlength="200" placeholder="Préciser" @bind="texteSansVolet" @bind:event="oninput"
                                                   class="@Obligatoire.Classe(string.IsNullOrWhiteSpace(texteSansVolet))" />
                                        }
                                    </div>
                                    <p class="detail" role="status" style="margin: 0">Sans n° : la vente attendra son volet Chifa (Finances › Chifa) ; scannez le QR du volet après l’édition de la facture par Chifa.</p>
                                }
                            }
                        }
                    </div>
                    <div class="separateur"></div>
                }
                <ValidationProduitBloque Produits="@(apercu?.ProduitsBloques ?? [])" Operation="à la vente" Id="caisse" Accord="accordBlocage" OnChange="StateHasChanged" />
                @if (erreurCalcul is not null) { <div class="erreur" role="alert">@erreurCalcul</div> }
                <div class="ligne-total"><span>Total</span><span>@Libelles.Dinars(apercu?.MontantBrut ?? 0, 2)</span></div>
                @if (apercu is { } ap && ap.MontantBrut - ap.TotalMedicaments > 0)
                {
                    <div class="ligne-total detail"><span>Médicaments · autres</span><span style="white-space: nowrap">@Libelles.Dinars(ap.TotalMedicaments, 2) · @Libelles.Dinars(ap.MontantBrut - ap.TotalMedicaments, 2)</span></div>
                }
                @if ((apercu?.Shp ?? 0) > 0)
                {
                    <div class="ligne-total detail"><span>dont SHP (honoraire du pharmacien)</span><span>@Libelles.Dinars(apercu!.Shp, 2)</span></div>
                }
                @if (tiersPayant)
                {
                    <div class="ligne-total"><span>Part @(organismes.FirstOrDefault(o => o.Id == organismeId)?.Code ?? "organisme")</span><span>@Libelles.Dinars(apercu?.PartOrganisme ?? 0, 2)</span></div>
                }
                @* Remises et don partiel : une ligne chacun ; la part automatique est rappelée sur la première (colonne fixe, sans défilement) *@
                @if ((apercu?.MontantRemise ?? 0) > 0)
                {
                    <div class="ligne-total"><span>Remises@(apercu!.ReductionsAuto > 0 ? $" (dont auto {Libelles.Dinars(apercu.ReductionsAuto, 2)})" : "")</span><span>− @Libelles.Dinars(apercu.MontantRemise, 2)</span></div>
                }
                @if ((apercu?.MontantDon ?? 0) > 0)
                {
                    <div class="ligne-total"><span>Don partiel@(apercu!.MontantRemise == 0 && apercu.ReductionsAuto > 0 ? $" (dont auto {Libelles.Dinars(apercu.ReductionsAuto, 2)})" : "")</span><span>− @Libelles.Dinars(apercu.MontantDon, 2)</span></div>
                }
                @if ((apercu?.EcartChifaPatient ?? 0) > 0)
                {
                    <div class="ligne-total" data-champ="ecart_chifa"><span>Écart Chifa payé par le patient</span><span>@Libelles.Dinars(apercu!.EcartChifaPatient, 2)</span></div>
                }
                <div class="a-payer"><span>@(tiersPayant ? "À payer par le patient" : "À payer")</span><span>@Libelles.Dinars(apercu?.PartPatient ?? 0, 2)</span></div>

                <div class="filtres modes-paiement" role="group" aria-label="Mode de paiement">
                    @foreach (var (code, libelle) in Modes)
                    {
                        <button type="button" class="puce" aria-pressed="@(mode == code ? "true" : "false")" @onclick="() => mode = code">@libelle</button>
                    }
                    @* Crédit : un mode comme les autres (2026-11-15), grisé sans patient ; la raison au survol *@
                    <button type="button" class="puce" aria-pressed="@(mode == "credit" ? "true" : "false")" disabled="@(patient is null)"
                            title="@(patient is null ? "Choisissez d’abord le patient à qui la vente est accordée" : "Mettre la vente au crédit du patient")" @onclick="@(() => mode = "credit")">Crédit</button>
                </div>
                @* Avoir du patient (script 106) : affiché dès que le patient est choisi ; combinable avec espèces, carte ou chèque *@
                @if (AvoirDisponible)
                {
                    <div class="champ-ligne" data-champ="avoir" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px">
                        <label class="case" title="@(mode == "credit" ? "L’avoir ne se combine pas avec le crédit" : null)">
                            <input type="checkbox" checked="@utiliserAvoir" disabled="@(mode == "credit")" @onchange="e => utiliserAvoir = e.Value is true" />
                            <span>Avoir du patient : <strong>@Libelles.Dinars(soldeAvoirPatient, 2)</strong></span>
                        </label>
                        @if (utiliserAvoir && mode != "credit")
                        {
                            <input aria-label="Montant payé par l’avoir" type="number" min="0.01" step="0.01" style="width: 110px"
                                   value="@AvoirUtilise.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   @onchange="e => montantAvoirSaisi = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var m) ? m : null" />
                            <span class="detail">reste @Libelles.Dinars(Math.Max((apercu?.PartPatient ?? 0) - AvoirUtilise, 0), 2) en @Libelles.ModePaiement(mode)</span>
                            @* D5 (2026-11-15) : un montant saisi au-delà du solde (ou du montant à payer) est ramené, avec un message visible *@
                            @if (montantAvoirSaisi is { } saisiAvoir && saisiAvoir > soldeAvoirPatient)
                            {
                                <span class="texte-attention" role="alert" data-champ="avoir_ramene" style="flex-basis: 100%">Avoir insuffisant : montant ramené au solde disponible : @Libelles.Dinars(soldeAvoirPatient, 2)@(AvoirUtilise < soldeAvoirPatient ? $" (au plus le montant à payer, {Libelles.Dinars(AvoirUtilise, 2)})" : "").</span>
                            }
                            else if (montantAvoirSaisi is { } saisiPlafond && saisiPlafond > AvoirUtilise)
                            {
                                <span class="texte-attention" role="alert" data-champ="avoir_ramene" style="flex-basis: 100%">Montant ramené au montant à payer : @Libelles.Dinars(AvoirUtilise, 2).</span>
                            }
                        }
                    </div>
                }
                @if (mode == "credit" && patient is not null)
                {
                    <div class="credit-resume" role="status">
                        <span>Mis au crédit de <strong>@($"{patient.Nom} {patient.Prenom}".Trim())</strong> : <strong>@Libelles.Dinars(apercu?.PartPatient ?? 0, 2)</strong></span>
                        <span class="detail">Après la vente : @Libelles.Dinars(patient.SoldeCredit + (apercu?.PartPatient ?? 0), 2) / plafond @Libelles.Dinars(patient.PlafondCredit)</span>
                        @if (patient.SoldeCredit + (apercu?.PartPatient ?? 0) > patient.PlafondCredit)
                        {
                            <span class="texte-attention">Au-delà du plafond : le droit de dépasser le plafond (ou le code d’un collègue qui l’a) sera demandé.</span>
                        }
                        @* Contrôle de fin de droits (2026-11-15) : avertissement renforcé, journalisé par le serveur, jamais bloquant *@
                        @if (AlerteCreditDroits)
                        {
                            <strong role="alert" data-champ="droits_chifa_credit" style="color: var(--danger, #b42318)">@EtatDroitsChifa.MessageCreditSelon(patient?.DateFinDroit, DateOnly.FromDateTime(DateTime.Now))</strong>
                        }
                        @if (!Session.A("credit.accorder"))
                        {
                            <span class="detail">L’autorisation d’un employé qui a ce droit sera demandée (son code comptoir).</span>
                        }
                    </div>
                }
                else if (mode == "especes")
                {
                    @* Rendu mis en avant (2026-11-14), à côté du montant reçu : montant de cette vente seulement (aucun cumul :
                       comptage aveugle de la caisse) *@
                    <div class="paiement-especes">
                        <div class="champ">
                            <label for="recu">Montant reçu (DA)</label>
                            <input id="recu" type="number" min="0" step="1" @bind="montantRecu" @bind:event="oninput" placeholder="Obligatoire" data-champ="montant_recu"
                                   class="@Obligatoire.Classe(RecuInsuffisant)" aria-describedby="@(RecuInsuffisant ? "recu-manque" : null)" />
                            @* En rouge sans bulle ni déplacement du curseur pendant la frappe (charte « Erreurs de saisie ») *@
                            @if (RecuCourt)
                            {
                                <span id="recu-manque" class="detail texte-urgent">Il manque @Libelles.Dinars(APayerEspeces - montantRecu!.Value, 2)</span>
                            }
                            else if (RecuManquant)
                            {
                                <button type="button" id="recu-manque" class="lien-bouton" style="align-self: flex-start" title="Remplit le montant reçu avec le montant à payer"
                                        @onclick="AppointExact">Appoint exact (@Libelles.Dinars(APayerEspeces, 2))</button>
                            }
                        </div>
                        <div class="champ">
                            <span class="etiquette-champ">Rendu</span>
                            <strong class="rendu-caisse @(Rendu > 0 ? "a-rendre" : null)" role="status" aria-live="polite">@Libelles.Dinars(Rendu, 2)</strong>
                        </div>
                    </div>
                }

                @* « + Remise » (2026-11-15) : le champ s'ouvre à la demande, ou de lui-même quand une remise est saisie *@
                @if (!RemiseOuverte)
                {
                    <button type="button" class="lien-bouton" style="align-self: flex-start" @onclick="OuvrirRemiseAsync" title="Sur un produit de parapharmacie : une remise ; sur un médicament : un don partiel du reste à charge">+ Remise ou don</button>
                }
                else
                {
                    @* Remise du vendeur (2026-11-14) : proposée à tout vendeur ; au-delà de son maximum (réglé par le titulaire) ou sans le droit,
                       le code d'un collègue dont le maximum la couvre est demandé à l'encaissement. Sur un médicament, c'est un don partiel du
                       reste à charge (droit de don, sinon code d'un collègue qui l'a). Entier de 0 à 100 ; le 0 s'efface dès qu'on tape ;
                       champ vidé : 0. *@
                    <div class="champ champ-ligne">
                        <label for="remise" title="Sur la part du patient, hors SHP (honoraire du pharmacien) : remise sur la parapharmacie, don partiel sur un médicament">Remise ou don (%, hors SHP)</label>
                        <input id="remise" data-champ="remise" @ref="champRemise" type="text" inputmode="numeric" maxlength="3" autocomplete="off" value="@RemiseTexte"
                               onfocus="this.select()" onbeforeinput="@SaisieRemise.Filtre"
                               aria-invalid="@(erreurRemise is null ? null : "true")" @oninput="SaisieRemiseAsync" @onchange="RecalculerAsync" />
                        @if (remisePct > 0 && apercu?.Reductions?.Any(r => r.RemiseAutoPct > 0) == true)
                        {
                            <label class="case" title="Coché : votre remise s’ajoute à la remise automatique. Décoché : elle ne vaut que pour les produits sans remise automatique.">
                                <input type="checkbox" checked="@remiseAdditionnee" @onchange="ChoisirAdditionAsync" /><span>+ remise auto</span></label>
                        }
                    </div>
                    @if (erreurRemise is not null) { <div class="erreur" role="alert" data-erreur="remise">@erreurRemise</div> }
                    @if (remisePct > 0 && !Session.A("caisse.remise") && !Session.A("stock.donner"))
                    {
                        <p class="sous-titre">Le code d’un collègue qui en a le droit vous sera demandé à l’encaissement.</p>
                    }
                }

                @if (erreurEncaissement is not null) { <div class="erreur" role="alert">@erreurEncaissement</div> }
                <span class="espace"></span>
                <button type="button" class="btn btn-principal btn-large" disabled="@(!PeutEncaisserMode)" title="@RaisonBlocageMode" @onclick="() => EncaisserAsync(mode)">
                    @(mode == "credit" ? "Mettre en crédit (F12)" : "Encaisser (F12)")
                </button>
            </aside>
        </div>
        }
        </div>
    }
</div>

@code {
    private sealed class LignePanier
    {
        /// <summary>Réductions calculées par le serveur (remise automatique, remise du vendeur, don partiel sur un médicament).</summary>
        public ReductionLigneDto? Reduction { get; set; }
        /// <summary>Produit de la ligne ; 0 pour une prestation (TypePrestationId, sans produit ni lot).</summary>
        public required long ProduitId { get; init; }
        /// <summary>Prestation (script 105) : ligne sans produit, sans lot ni stock, au prix et à la TVA du type de prestation.</summary>
        public long? TypePrestationId { get; init; }
        public decimal? TauxTva { get; init; }
        public bool EstPrestation => TypePrestationId is not null;
        /// <summary>Ligne envoyée au serveur : produit avec un lot vendable, ou prestation.</summary>
        public bool Envoyee => Lot is not null || EstPrestation;
        public required string Nom { get; init; }
        /// <summary>Prix d'une boîte : celui calculé par le serveur (PPA du lot + SHP) dès le premier calcul.</summary>
        public required decimal Prix { get; set; }
        /// <summary>Alerte de lot plus ancien : rouge (lot proche de sa péremption) ou orange.</summary>
        public string? CouleurFefo { get; set; }
        public LotFefoDto? Lot { get; set; }
        /// <summary>Boîtes vendables du produit, tous lots (pour afficher le stock restant).</summary>
        public int StockProduit { get; set; }
        /// <summary>Lot de la boîte scannée (sinon lot FEFO choisi par le logiciel).</summary>
        public bool BoiteScannee { get; init; }
        /// <summary>Le caissier a pris une boîte du lot conseillé à la place de la boîte scannée.</summary>
        public bool LotConseilleServi { get; set; }
        /// <summary>Boîtes identifiées scannées (étiquette interne, n° de série) : rattachées à la vente pour le remboursement.</summary>
        public List<long> Boites { get; } = [];
        public string? AvertissementFefo { get; set; }
        /// <summary>Lot plus ancien en stock : raison à demander (SituationLotDto : peremption ou obligatoire), lot délaissé, raison retenue.</summary>
        public SituationLotDto? Situation { get; set; }
        public string? RaisonLot { get; set; }
        public LotFefoDto? LotConseille { get; set; }
        /// <summary>Où trouver une boîte du lot conseillé (emplacement ou réserve du produit).</summary>
        public string? EmplacementConseille { get; set; }
        public IReadOnlyList<LotEcarteDto> Ecartes { get; init; } = [];
        public IReadOnlyList<ProduitAlternatifDto> Alternatives { get; set; } = [];
        public int Quantite { get; set; } = 1;
        /// <summary>Boîtes voulues (ordonnance) : au-delà du stock du lot, un équivalent est proposé.</summary>
        public int QuantiteDemandee { get; set; } = 1;
    }

    /// <summary>Ligne lue sur l'ordonnance, en attente de validation par le caissier.</summary>
    private sealed class LigneOrdonnance
    {
        public required string Texte { get; init; }
        public required IReadOnlyList<ProduitCandidatDto> Candidats { get; init; }
        public long ChoixId { get; set; }
        public int Quantite { get; set; } = 1;
        public bool Traitee { get; set; }
    }

    private sealed class NouveauPatientSaisie
    {
        public string Nom { get; set; } = "";
        public string? Prenom { get; set; }
        public string? Telephone { get; set; }
        public string? Email { get; set; }
        public string? NumAssure { get; set; }
        public long OrganismeId { get; set; }
        public decimal Plafond { get; set; }
    }

    private sealed record Bandeau(string Titre, string? Detail);

    private static readonly (string, string)[] Modes = [("especes", "Espèces"), ("carte", "Carte"), ("cheque", "Chèque")];

    // Caisse
    private EtatCaisseDto? etat;
    private string? erreurEtat, erreurOuverture;
    private decimal fondCaisse;
    private bool enCours;

    // Panier
    private string texte = "";
    private List<ProduitComptoirDto> suggestions = [];
    private readonly List<LignePanier> lignes = [];
    private Bandeau? bandeau;
    /// <summary>Produit expliqué par le bandeau : le bandeau disparaît quand ce produit quitte le panier.</summary>
    private long? bandeauProduit;
    private string? erreur;
    private int requete;
    /// <summary>Une Entrée à la fois : deux scans rapprochés sont traités l'un après l'autre, chacun avec son propre code.</summary>
    private readonly SemaphoreSlim scansEnCours = new(1, 1);

    // Règlement
    private List<OrganismeDto> organismes = [];
    private bool tiersPayant;
    private long organismeId;
    /// <summary>Organisme proposé à l'ouverture de la caisse et à chaque nouveau panier : le premier de la liste.</summary>
    private long OrganismeParDefaut => organismes.FirstOrDefault()?.Id ?? 0;
    private const int TauxParDefaut = 80;
    private int taux = TauxParDefaut;
    /// <summary>Tiers payant : reste à charge fixé par le caissier (null : selon le taux).</summary>
    private decimal? resteSaisi;
    private PatientDto? patient;
