    /// <summary>Le crédit est rattaché à un patient (sa dette augmente) et demande le droit « credit.accorder ».</summary>
    private string? RaisonBlocageCredit =>
        !PeutEncaisser ? RaisonBlocage ?? "Encaissement en cours"
        : patient is null ? "Choisissez le patient à qui la vente est accordée"
        : null;

    // Arrivée depuis une fiche contact (« Relevé de dette ») : règlement de crédit ouvert sur le patient
    [SupplyParameterFromQuery(Name = "credit")] public long? Credit { get; set; }
    private long? creditPatientId, creditDemande;

    /// <summary>Partie affichée (caisse?rubrique=annulation|credit) ; vide : la vente.</summary>
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique = "";
    private string AdresseRubrique => rubrique == "" ? "caisse" : $"caisse?rubrique={rubrique}";

    protected override void OnParametersSet()
    {
        rubrique = Rubrique is "annulation" or "credit" ? Rubrique : Credit is > 0 ? "credit" : "";
        if (rubrique != "annulation") annulationNumero = null;
        if (Credit == creditDemande) return;
        creditDemande = Credit;
        if (Credit is > 0) creditPatientId = Credit;
