@page "/caisse"
@implements IAsyncDisposable
@inject ApiClient Api
@inject SessionPoste Session
@inject ConfigurationPoste Poste
@inject AfficheurClient Afficheur
@inject IJSRuntime JS
@inject ImprimanteTickets Tickets
@inject HistoriqueNavigation Historique
@inject NavigationManager Nav

@* Écran fixe (docs/charte-graphique.md) : colonne d'actions de caisse à gauche (NavCaisse), une partie à la fois dans l'adresse :
   la vente (caisse), l'annulation ou le retour (caisse?rubrique=annulation), le règlement d'un crédit (caisse?rubrique=credit).
   Passer d'une partie à l'autre garde le panier ; le panier défile dans son cadre. *@
<div class="page @(erreurEtat is null && etat?.SessionId is not null ? "avec-menu" : null)" style="padding-top: 24px">
    @if (erreurEtat is not null)
    {
        <div class="erreur" role="alert">@erreurEtat</div>
    }
    else if (etat is null)
    {
        <Chargement Texte="Chargement de la caisse…" />
    }
    else if (etat.SessionId is null)
    {
        <section class="panneau" style="max-width: 460px" aria-labelledby="t-ouvrir">
            <h2 id="t-ouvrir">Ouvrir la caisse</h2>
            <p class="sous-titre">Comptez le fond de caisse avant la première vente. La caisse reste à votre nom jusqu’à la clôture.</p>
            <div class="champ">
                <label for="fond">Fond de caisse (DA)</label>
                <input id="fond" type="number" min="0" step="1" @bind="fondCaisse" />
            </div>
            @if (erreurOuverture is not null) { <div class="erreur" role="alert">@erreurOuverture</div> }
            <button type="button" class="btn btn-principal btn-large" disabled="@enCours" @onclick="OuvrirAsync">Ouvrir la caisse</button>
        </section>
    }
    else
    {
        <NavCaisse Actif="@AdresseRubrique" OuverteLe="etat.OuverteLe" OuvertePar="@etat.OuvertePar" Fond="etat.FondCaisse" Poste="@etat.Poste" />
        <div class="contenu-rubrique">
        @if (rubrique == "annulation")
        {
            <PanneauAnnulation EnLigne="true" NumeroInitial="@annulationNumero" OnFerme="RetourVente" OnAnnulee="VenteAnnuleeAsync" />
        }
        else if (rubrique == "credit")
        {
            <PanneauCredit EnLigne="true" PatientId="creditPatientId" OnFerme="RetourVente" OnEncaisse="ChargerEtatAsync" />
        }
        else
        {

        @if (venteFaite is not null)
        {
            <div class="succes" role="status" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px">
                <strong>Vente @venteFaite.Numero encaissée : @Libelles.Dinars(venteFaite.MontantTotal, 2)</strong>
                @if (venteFaite.PartOrganisme > 0) { <span>part organisme @Libelles.Dinars(venteFaite.PartOrganisme, 2)</span> }
                @if (venteFaite.Mode == "especes" && venteFaite.Rendu > 0) { <span style="font-size: 18px; font-weight: 600">Rendu : @Libelles.Dinars(venteFaite.Rendu, 2)</span> }
                @if (venteFaite.Mode == "credit") { <span>mise en crédit</span> }
                <button type="button" class="btn" disabled="@impressionEnCours" @onclick="ImprimerTicketAsync">@(impressionEnCours ? "Impression…" : "Imprimer le ticket")</button>
                <button type="button" class="lien-bouton" @onclick="() => OuvrirAnnulation(venteFaite.Numero)">Annuler ou retour</button>
            </div>
            @if (messageTicket is not null) { <div class="@(ticketImprime ? "info-bandeau" : "erreur")" role="status">@messageTicket</div> }
        }

        @* Caisse en trois parties (2026-11-15, maquettes validées) : 1 · le panier, 2 · le client et l'ordonnance (sous le panier,
           réduit à une ligne quand rien n'est exigé), 3 · le paiement seul à droite. Écran fixe : seul le panier défile. *@
        <div class="colonnes caisse-vente" style="gap: 20px">
            <section class="colonne-principale" aria-label="Panier, client et ordonnance">
                @if (cameraOuverte)
                {
                    <div class="panneau camera">
                        <video id="camera-video" autoplay playsinline muted aria-label="Image de la caméra"></video>
                        <div class="actions">
                            <button type="button" class="btn btn-principal" @onclick="PrendrePhotoAsync">Prendre la photo</button>
                            <button type="button" class="btn" @onclick="FermerCameraAsync">Annuler</button>
                        </div>
                    </div>
                }

                @if (erreurScan is not null) { <div class="erreur" role="alert">@erreurScan</div> }

                @if (image is not null)
                {
                    <section class="ordonnance" aria-label="Ordonnance scannée">
                        <button type="button" class="ordonnance-image" title="Agrandir l’ordonnance" @onclick="() => imageAgrandie = true">
                            <img src="@image.UrlDonnees" alt="Ordonnance scannée" />
                        </button>
                        <div class="ordonnance-lignes">
                            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px">
                                <div>
                                    <strong>Médicaments de l’ordonnance</strong><br />
                                    <span class="detail">@lignesOrdonnance.Count reconnu(s)@(lignesIgnorees > 0 ? $" · {lignesIgnorees} ligne(s) non reconnue(s) : vérifiez l’image" : "")</span>
                                </div>
                                <div class="actions">
                                    @if (lignesOrdonnance.Any(l => !l.Traitee))
                                    {
                                        <button type="button" class="btn btn-principal" @onclick="ToutAjouterAsync">Tout ajouter</button>
                                    }
                                    <button type="button" class="btn" @onclick="RetirerOrdonnanceAsync">Retirer l’ordonnance</button>
                                </div>
                            </div>
                            @if (lignesOrdonnance.Count == 0)
                            {
                                <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center">
                                    <p class="detail" style="margin: 0; flex: 1 1 240px">@(motifSaisieManuelle ?? "Aucun médicament reconnu") : saisissez les produits à la main en lisant l’image.</p>
                                    <button type="button" class="btn btn-principal" @onclick="OuvrirSaisieManuelleAsync">Saisir les produits à la main</button>
                                </div>
                            }
                            @foreach (var lo in lignesOrdonnance.Where(l => !l.Traitee))
                            {
                                <div class="ligne-ordonnance">
                                    <span class="detail">Lu : « @lo.Texte »</span>
                                    <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center">
                                        <select class="selection" style="flex: 999 1 260px; min-width: 0" aria-label="Produit pour « @lo.Texte »" @bind="lo.ChoixId">
                                            @foreach (var c in lo.Candidats)
                                            {
                                                <option value="@c.ProduitId">@c.NomCommercial @c.Dosage · @(c.Stock > 0 ? $"stock {c.Stock}" : "rupture : équivalent proposé") · @Math.Round(c.Score * 100) %</option>
                                            }
                                        </select>
                                        <input type="number" min="1" style="width: 80px" aria-label="Nombre de boîtes" @bind="lo.Quantite" />
                                        <button type="button" class="btn btn-principal" @onclick="() => AjouterLigneOrdonnanceAsync(lo)">Ajouter</button>
                                        <button type="button" class="btn" @onclick="() => lo.Traitee = true">Écarter</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                    @if (imageAgrandie)
                    {
                        <div class="lecture-ordonnance" role="dialog" aria-modal="true" aria-label="Lecture de l’ordonnance" @onkeydown="ToucheLecture">
                            <div class="lecture-image">
                                <div class="lecture-outils" role="toolbar" aria-label="Affichage de l’ordonnance">
                                    <button type="button" class="btn btn-icone" title="Tourner à gauche" aria-label="Tourner à gauche" @onclick="() => rotation = (rotation + 270) % 360">↺</button>
                                    <button type="button" class="btn btn-icone" title="Tourner à droite" aria-label="Tourner à droite" @onclick="() => rotation = (rotation + 90) % 360">↻</button>
                                    <button type="button" class="btn btn-icone" title="Réduire" aria-label="Réduire" @onclick="() => zoom = Math.Max(0.5, zoom - 0.25)">−</button>
                                    <span class="detail">@Math.Round(zoom * 100) %</span>
                                    <button type="button" class="btn btn-icone" title="Agrandir" aria-label="Agrandir" @onclick="() => zoom = Math.Min(4, zoom + 0.25)">+</button>
                                </div>
                                <div class="lecture-defilement">
                                    <img src="@image.UrlDonnees" alt="Ordonnance" style="transform: rotate(@(rotation)deg); width: @(Math.Round(zoom * 100))%" />
                                </div>
                            </div>
                            <aside class="lecture-saisie" aria-label="Saisie des produits lus">
                                <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px">
                                    <strong>Produits lus sur l’ordonnance</strong>
                                    <button type="button" class="btn" @onclick="() => imageAgrandie = false">Fermer (Échap)</button>
                                </div>
                                @if (lignesOrdonnance.Count == 0)
                                {
                                    <div class="bandeau-attention" role="status">
                                        <strong>Lecture automatique impossible</strong><br />
                                        @(motifSaisieManuelle ?? "Aucun médicament reconnu sur l’image") : à vous de saisir les produits en lisant l’ordonnance.
                                    </div>
                                }
                                <p class="detail" style="margin: 0">Tapez le nom lu sur l’image ou la DCI (quelques lettres suffisent, les fautes sont tolérées), choisissez la quantité, puis ajoutez. Fermez quand l’ordonnance est complète.</p>
                                <div class="champ recherche">
                                    <label for="lecture-recherche">Produit</label>
                                    <input id="lecture-recherche" type="search" autocomplete="off" placeholder="Ex. sintrom" @ref="champLecture"
                                           @bind="lectureTexte" @bind:event="oninput" @bind:after="RechercherLectureAsync" />
                                </div>
                                @if (lectureSansResultat is { } cherche)
                                {
                                    <p class="detail texte-attention" role="status" style="margin: 0">Aucun produit du catalogue ne correspond à « @cherche ». Vérifiez l’orthographe ou cherchez par la DCI ; un produit absent du catalogue ne peut pas être vendu.</p>
                                }
                                <div class="champ">
                                    <label for="lecture-qte">Boîtes</label>
                                    <input id="lecture-qte" type="number" min="1" max="20" style="width: 100px" @bind="lectureQuantite" />
                                </div>
                                <ul class="liste-lecture" aria-label="Produits trouvés">
                                    @foreach (var p in lectureSuggestions)
                                    {
                                        <li>
                                            <button type="button" @onclick="() => AjouterDepuisLectureAsync(p)">
                                                <span><strong>@p.NomCommercial</strong><br /><span class="detail">@p.Dci @p.Dosage · @(p.Stock > 0 ? $"stock {p.Stock}" : "rupture : équivalent proposé")</span></span>
                                                <span>Ajouter</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                                @if (lectureAjouts.Count > 0)
                                {
                                    <div class="succes" role="status">Ajouté au panier : @string.Join(", ", lectureAjouts)</div>
                                }
                            </aside>
                        </div>
                    }
                }

                <!-- 1 · Panier : recherche du produit, mise en attente, ventes en attente du poste (gardées sur le serveur) -->
                <div class="ligne-scan">
                    <div class="champ recherche">
                        <label for="scan">1 · Panier@(lignes.Count > 0 ? $" · {NombreProduits} produit(s), {lignes.Sum(l => l.Quantite)} boîte(s)" : "") <span class="detail">F7</span></label>
                        <input id="scan" data-champ="volet_chifa" class="grand" type="search" placeholder="Scanner ou rechercher un produit : nom, DCI, code-barres" autofocus autocomplete="off"
                               @bind="texte" @bind:event="oninput" @bind:after="RechercherApresSaisieAsync" @onkeydown="ToucheAsync" />
                        @if (suggestions.Count > 0)
                        {
                            @* Recherche au comptoir (2026-11-14) : produits en stock d'abord ; en rupture en bas, non sélectionnables, avec leur remplaçant
                               (équivalent exact le moins cher, sinon autre dosage ou forme à valider) ; même produit d'un autre laboratoire moins cher
                               suggéré sous le produit cherché, qui reste sélectionnable (demande explicite du client). Prix : prix servi. *@
                            <ul class="suggestions suggestions-caisse" aria-label="Produits trouvés">
                                @foreach (var c in suggestions)
                                {
                                    var p = c.Produit;
                                    <li class="@(p.Stock <= 0 ? "en-rupture" : null)">
                                        @if (p.Stock > 0)
                                        {
                                            <button type="button" @onclick="() => AjouterAsync(p.Id, p.NomCommercial, c.PrixServi)">
                                                <span>
                                                    <strong>@p.NomCommercial</strong><br />
                                                    <span class="detail">@p.Dci @p.Dosage · stock @p.Stock@(Libelles.EstSousRegistre(p.Classe) ? " · ordonnance" : "")</span>
                                                </span>
                                                <span>@Libelles.Dinars(c.PrixServi, 2)</span>
                                            </button>
                                            @if (c.MoinsCher is { } m)
                                            {
                                                @* Étiquette sans le nom du médicament (même produit) : le laboratoire seulement (2026-11-14) *@
                                                <button type="button" class="suggestion-equivalent" title="@m.NomCommercial" @onclick="() => AjouterAsync(m.ProduitId, m.NomCommercial, m.PrixPublic)">
                                                    <span>Moins cher · <strong>@(m.Laboratoire ?? "autre laboratoire")</strong> · stock @m.Stock</span>
                                                    <span>@Libelles.Dinars(m.PrixPublic, 2) (− @Libelles.Dinars(c.PrixServi - m.PrixPublic, 2))</span>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="suggestion-rupture" aria-disabled="true">
                                                <span>
                                                    <strong>@p.NomCommercial</strong><br />
                                                    <span class="detail">@p.Dci @p.Dosage</span>
                                                </span>
                                                <span class="alerte-rupture">Rupture de stock</span>
                                            </div>
                                            @if (c.Remplacant is { } r)
                                            {
                                                <button type="button" class="suggestion-equivalent" @onclick="() => AjouterAsync(r.ProduitId, r.NomCommercial, r.PrixPublic)">
                                                    <span>Remplaçant : <strong>@r.NomCommercial</strong>@(r.Exact ? "" : $" ({r.Dosage} {r.Forme}, à valider par le pharmacien)") · stock @r.Stock</span>
                                                    <span>@Libelles.Dinars(r.PrixPublic, 2)</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="detail suggestion-aucun">Aucun remplaçant en stock.</span>
                                            }
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="actions-attente">
                        <button type="button" class="btn" disabled="@(enCours || lignes.Count == 0)" @onclick="MettreEnAttenteAsync" title="Mettre ce panier de côté pour servir un autre patient">⏸ Attente</button>
                        @if (attentes.Count > 0)
                        {
                            <button type="button" class="btn bouton-attentes" aria-expanded="@(attentesOuvertes ? "true" : "false")" @onclick="() => attentesOuvertes = !attentesOuvertes">
                                En attente (@attentes.Count) @(attentesOuvertes ? "▴" : "▾")
                            </button>
                        }
                        @if (attentesOuvertes && attentes.Count > 0)
                        {
                            <div class="liste-attentes" role="group" aria-label="Ventes en attente">
                                @foreach (var v in attentes)
                                {
                                    <div class="vente-attente">
                                        <span>
                                            <strong>@v.Libelle</strong> · @v.Lignes produit(s) · <strong>@Libelles.Dinars(v.Total, 2)</strong><br />
                                            <span class="detail">mise en attente à @v.CreeLe.ToLocalTime().ToString("HH:mm") par @v.Employe</span>
                                        </span>
                                        @if (aAbandonner == v.Id)
                                        {
                                            <button type="button" class="lien-bouton danger" @onclick="() => AbandonnerAsync(v)">Confirmer l’abandon</button>
                                            <button type="button" class="lien-bouton" @onclick="() => aAbandonner = null">Garder</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => ReprendreDepuisListeAsync(v)">Reprendre</button>
                                            <button type="button" class="btn btn-icone" aria-label="@($"Abandonner la vente en attente {v.Libelle}")" title="Abandonner" @onclick="() => aAbandonner = v.Id">×</button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                @if (erreurAttente is not null) { <div class="erreur" role="alert">@erreurAttente</div> }
                @if (messageRetour is not null) { <div class="info-bandeau" role="status">@messageRetour</div> }

                @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

                @if (volet is not null)
                {
                    @* Volet Chifa scanné : vente reprise en tiers payant ; format du QR à confirmer avec l'éditeur de Chifa *@
                    <div class="info-bandeau" role="status">
                        <strong>Volet Chifa n° @volet.NumeroFacture du @Libelles.Date(volet.DateFacture)</strong> · assuré @volet.Assure
                        · @(volet.Patient is { } nomPatient ? $"patient {nomPatient}" : "patient inconnu : créez-le avec ce n° d’assuré")
                        · ordonnance @Libelles.Dinars(volet.MontantOrdonnance, 2)
                        @foreach (var ec in ecartsVolet) { <br /><span>@ec</span> }
                        <button type="button" class="lien-bouton" @onclick="RetirerVolet">Retirer le volet</button>
                    </div>
                }
                @foreach (var c in codesAAssocier)
                {
                    <div class="bandeau-attention" role="status" data-champ="code_chifa" style="display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end">
                        <span style="flex: 1 1 260px">Code Chifa <strong>@c.Code</strong> (@c.Quantite boîte(s) à @Libelles.Dinars(c.PrixUnitaire, 2)) inconnu : choisissez le produit, il sera reconnu aux prochains volets.</span>
                        <ChoixProduit Id="@($"chifa-{c.Code}")" Libelle="Produit du code Chifa" Style="flex: 1 1 280px" OnChoisi="p => AssocierCodeAsync(c, p)" />
                    </div>
                }

                @if (bandeau is not null)
                {
                    <div class="bandeau" role="alert">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B42318" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none; margin-top: 1px"><circle cx="12" cy="12" r="9"></circle><path d="M5.6 5.6l12.8 12.8"></path></svg>
                        <div>
                            <strong>@bandeau.Titre</strong>
                            @if (bandeau.Detail is not null) { <span>@bandeau.Detail</span> }
                        </div>
                    </div>
                }

                @if (lignes.Count == 0)
                {
                    <div class="carte vide">Panier vide : scannez une boîte ou recherchez un produit.</div>
                }
                else
                {
                    <div class="panier cadre-defilant cadre-prioritaire">
                        @foreach (var l in lignes)
                        {
                            @if (l.Lot is { } lot)
                            {
                                <div class="panier-ligne" data-ligne="@lignes.IndexOf(l)">
                                    <div class="panier-produit">
                                        <span>@l.Nom</span>
                                        <span>Lot servi @lot.NumeroLot · exp. @Libelles.Date(lot.DatePeremption) ·
                                            @if (l.LotConseilleServi) { <span class="fefo">lot conseillé (péremption proche)</span> } else if (l.BoiteScannee) { <span class="fefo">boîte scannée</span> } else if (lignes.FirstOrDefault(x => x.ProduitId == l.ProduitId && x.Lot is not null && !x.BoiteScannee) != l) { <span class="fefo">lot suivant (FEFO), le précédent ne suffit pas</span> } else { <span class="fefo">premier à expirer (FEFO)</span> }
                                        </span>
                                        <span class="stock-restant @(StockApresVente(l) == 0 ? "epuise" : null)">
                                            Stock : @l.StockProduit boîte(s) · reste @StockApresVente(l) après cette vente
                                        </span>
                                    </div>
                                    @if (l.AvertissementFefo is not null && l.LotConseille is { } conseille)
                                    {
                                        <div class="avertissement-fefo @l.CouleurFefo" role="alert">
                                            <span>@l.AvertissementFefo</span>
                                            <span class="detail">Lot @conseille.NumeroLot : @conseille.Quantite boîte(s) en stock@(l.EmplacementConseille is { } empl ? $" · rangé {empl}" : "") · fournisseur @conseille.Fournisseur</span>
                                            <div style="display: flex; gap: 8px; flex-wrap: wrap">
                                                <button type="button" class="btn btn-principal" @onclick="() => ServirLotConseilleAsync(l)">J’ai pris une boîte du lot @conseille.NumeroLot</button>
                                                <button type="button" class="btn" @onclick="() => { l.AvertissementFefo = null; l.LotConseille = null; }">Garder cette boîte</button>
                                            </div>
                                        </div>
                                    }
                                    @if (l.Situation is { Situation: "peremption" or "obligatoire" } sit)
                                    {
                                        @* Lot plus ancien en stock : raison vérifiée (à valider) ou à choisir ; inscrite avec la vente *@
                                        <div class="avertissement-fefo @(l.RaisonLot is null ? "orange" : "compact")" role="group" data-champ="raison_lot" aria-label="Raison du lot servi">
                                            <span>
                                                Lot plus ancien en stock : @sit.LotDelaisse@(sit.PeremptionDelaisse is { } pd ? $" (exp. {Libelles.Date(pd)})" : "").
                                                @if (l.RaisonLot is { } r) { <strong> Raison : @RaisonLotLibelle(r).</strong> }
                                            </span>
                                            @if (l.RaisonLot is null)
                                            {
                                                <div style="display: flex; gap: 8px; flex-wrap: wrap">
                                                    @if (sit.Situation == "peremption")
                                                    {
                                                        <span class="detail" style="flex-basis: 100%">Vérifié par le logiciel : ce lot périme avant le lot @sit.LotDelaisse.</span>
                                                        <button type="button" class="btn btn-principal" @onclick="() => ChoisirRaisonAsync(l, RaisonPeremption)">Valider : péremption plus proche</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="detail" style="flex-basis: 100%">Pourquoi servir ce lot ?</span>
                                                    }
                                                    <button type="button" class="btn" @onclick="() => ChoisirRaisonAsync(l, RaisonIntrouvable)">Boîte de l’ancien lot introuvable</button>
                                                    <button type="button" class="btn" @onclick="() => ChoisirRaisonAsync(l, RaisonAbimee)">Boîte abîmée</button>
                                                    <button type="button" class="btn" @onclick="() => ChoisirRaisonAsync(l, RaisonDemandeClient)">Demande du client</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button" class="lien-bouton" @onclick="() => ChoisirRaisonAsync(l, null)">Changer la raison</button>
                                            }
                                        </div>
                                    }
                                    <div class="quantite">
                                        <button type="button" class="btn btn-icone" aria-label="Retirer une boîte" @onclick="() => ChangerAsync(l, -1)">−</button>
                                        <span>× @l.Quantite</span>
                                        <button type="button" class="btn btn-icone" aria-label="Ajouter une boîte" disabled="@(l.Quantite >= lot.Quantite)" @onclick="() => ChangerAsync(l, +1)">+</button>
                                    </div>
                                    @if (l.Reduction is { Montant: > 0 } red)
                                    {
                                        @* Remise par produit (2026-11-14) : montant initial barré, pourcentage, net ; « don » sur un médicament *@
                                        <span class="montant montant-reduit" title="@(red.DonPartiel ? "Don partiel du reste à charge" : "Remise")">
                                            <s>@Libelles.Dinars(l.Prix * l.Quantite, 2)</s>
                                            <span class="reduction">@(red.DonPartiel ? "don" : "remise") −@red.PctApplique.ToString("0") %@(red.RemiseAutoPct > 0 ? " (auto)" : "")</span>
                                            <strong>@Libelles.Dinars(l.Prix * l.Quantite - red.Montant, 2)</strong>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="montant">@Libelles.Dinars(l.Prix * l.Quantite, 2)</span>
                                    }
                                    @if (l.QuantiteDemandee > l.Quantite)
                                    {
                                        <div class="manque">
                                            <span class="alerte-rupture">Stock insuffisant : il manque @(l.QuantiteDemandee - l.Quantite) boîte(s), aucun autre lot vendable de ce produit.</span>
                                            @foreach (var alt in l.Alternatives.Take(1))
                                            {
                                                <div class="alternative">
                                                    <span>@LibelleEquivalent(alt)</span>
                                                    <button type="button" class="btn btn-principal" @onclick="() => CompleterAsync(l, alt)">Compléter avec @(l.QuantiteDemandee - l.Quantite)</button>
                                                </div>
                                            }
                                            @if (l.Alternatives.Count == 0) { <span class="detail">Aucun équivalent de même DCI en stock.</span> }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="panier-ligne rupture" data-ligne="@lignes.IndexOf(l)">
                                    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px">
                                        <div class="panier-produit">
                                            <span>@l.Nom</span>
                                            <span class="alerte-rupture">Rupture de stock</span>
                                            @if (l.Ecartes.Count > 0)
                                            {
                                                <span class="detail">@string.Join(", ", l.Ecartes.Select(e => $"lot {e.NumeroLot} {(e.Raison == "bloque" ? "bloqué" : "périmé")}")) : à retirer du stock</span>
                                            }
                                        </div>
                                        <button type="button" class="btn" @onclick="() => RetirerAsync(l)">Retirer</button>
                                    </div>
                                    @foreach (var alt in l.Alternatives.Take(3))
                                    {
                                        <div class="alternative">
                                            <span>@LibelleEquivalent(alt)</span>
                                            <button type="button" class="btn btn-principal" @onclick="() => RemplacerAsync(l, alt)">Remplacer</button>
                                        </div>
                                    }
                                    @if (l.Alternatives.Count == 0) { <span class="detail">Aucun équivalent de même DCI en stock.</span> }
                                </div>
                            }
                        }
                    </div>
                }

                <!-- 2 · Client et ordonnance -->
                <section class="panneau bloc-client" aria-label="Client et ordonnance">
                    <div class="bloc-client-entete">
                        <strong>2 · Client et ordonnance</strong>
                        @* Bloc réduit : pas d'étiquette (le résumé dit ce qui manque) ; titre et boutons sur une rangée *@
                        @if (ClientResume) { }
                        else if (OrdonnanceObligatoire)
                        {
                            <span class="indice requis">psychotrope : ordonnance obligatoire (médecin, patient)</span>
                        }
                        else if (TiersSansPart && medecin is null && jetonScan is null)
                        {
                            <span class="indice" role="note">
                                @(Session.A("caisse.vendre_sans_ordonnance")
                                    ? "L’organisme ne paie rien : médecin facultatif ; sans ordonnance, vente permise par votre droit (inscrite au journal)"
                                    : "L’organisme ne paie rien : médecin facultatif ; sans ordonnance, validation du titulaire ou d’un ayant droit (son code) à l’encaissement")
                            </span>
                        }
                        else if (SansOrdonnanceListe)
                        {
                            <span class="indice" role="note" data-champ="sans_ordonnance">
                                @(Session.A("caisse.vendre_sans_ordonnance")
                                    ? "Liste I ou II : médecin attendu ; sans ordonnance, vente permise par votre droit (inscrite au journal)"
                                    : "Liste I ou II : médecin attendu ; sans ordonnance, validation du titulaire ou d’un ayant droit (son code) à l’encaissement")
                            </span>
                        }
                        else if (!ClientOuvert)
                        {
                            <span class="detail">aucun patient, aucune ordonnance exigée</span>
                        }
                        <span class="espace"></span>
                        @if (ClientOuvert && !ClientResume && !nouveauPatient && nouveauMedecin is null)
                        {
                            <button type="button" class="lien-bouton" title="Résumer le bloc en une ligne ; « Modifier » le rouvre" @onclick="ReduireClient">Réduire ▴</button>
                        }
                        <div class="filtres" role="group" aria-label="Type de vente">
                            <button type="button" class="puce" aria-pressed="@(!tiersPayant ? "true" : "false")" @onclick="() => ChoisirTiersPayantAsync(false)">Vente libre</button>
                            <button type="button" class="puce" aria-pressed="@(tiersPayant ? "true" : "false")" @onclick="() => ChoisirTiersPayantAsync(true)">Tiers payant</button>
                        </div>
                    </div>

                    @if (!ClientOuvert)
                    {
                        <div class="bloc-client-reduit">
                            <button type="button" class="lien-bouton" data-raccourci="patient" @onclick="() => clientDeplie = true">Ajouter un patient (F6)</button>
                            <span class="espace"></span>
                            <span class="detail">Ordonnance :</span>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ScannerOrdonnanceAsync">Scanner</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="OuvrirCameraAsync">Caméra</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ImporterOrdonnanceAsync">Fichier</button>
                            @if (lectureEnCours) { <span class="sous-titre" role="status">Lecture de l’ordonnance…</span> }
                        </div>
                    }
                    else if (ClientResume)
                    {
                        @* Tout ce qu'il faut est saisi (2026-11-15) : une ligne, le panier garde la place ; « Modifier » rouvre le bloc *@
                        <div class="bloc-client-reduit resume-client">
                            <span><strong>@(patient is null ? "Aucun patient" : $"{patient.Nom} {patient.Prenom}".Trim())</strong>@(tiersPayant ? $" · {OrganismeCode} {(resteSaisi is { } r ? $"reste {Libelles.Dinars(r, 2)}" : $"{taux} %")}" : "")@(medecin is not null ? $" · {medecin.Nom}" : "")@(medecin is not null || jetonScan is not null ? $" · ordonnance{(string.IsNullOrWhiteSpace(numeroOrdonnance) ? "" : " " + numeroOrdonnance.Trim())} du {datePrescription:dd/MM/yyyy}" : "")</span>
                            @if (ManqueClient is { } manque) { <span class="texte-attention">à compléter : @manque</span> }
                            <span class="espace"></span>
                            <button type="button" class="lien-bouton" @onclick="ModifierClient">Modifier ▾</button>
                        </div>
                    }
                    else
                    {

                        <div class="bloc-client-grille @(AfficherMedecin ? "deux" : null)">
                            <!-- Patient -->
                            <div class="champ recherche">
                                @* « Nouveau patient » à droite du libellé (2026-11-15) : une ligne de moins dans la colonne de paiement *@
                                <div class="etiquette-ligne">
                                    <span class="etiquette-champ @(PatientObligatoire ? "requis" : null)">Patient @(PatientObligatoire ? "(obligatoire)" : "(facultatif)") <span class="detail">F6</span></span>
                                    @if (patient is null && !nouveauPatient)
                                    {
                                        <button type="button" class="lien-bouton" @onclick="OuvrirNouveauPatient">Nouveau patient</button>
                                    }
                                </div>
                                @if (patient is not null)
                                {
                                    <div class="choix">
                                        <div>
                                            <strong><LienContact Type="patient" Id="patient.Id" Nom="@($"{patient.Nom} {patient.Prenom}".Trim())" /></strong><br />
                                            <span class="detail">
                                                @(patient.NumAssure is null ? "sans n° d’assuré" : $"Assuré {patient.NumAssure}")@if (patient.Organisme is { } org) { <text> · </text><LienContact Type="organisme" Id="patient.OrganismeId" Nom="@org" /> }
                                                · crédit @Libelles.Dinars(patient.SoldeCredit) / plafond @Libelles.Dinars(patient.PlafondCredit)
                                            </span>
                                        </div>
                                        <button type="button" class="lien-bouton" @onclick="RetirerPatientAsync">Changer</button>
                                    </div>
                                }
                                else if (!nouveauPatient)
                                {
                                    <input type="search" data-raccourci="patient" aria-label="Rechercher un patient" placeholder="Nom, téléphone ou n° d’assuré" autocomplete="off"
                                           class="@Obligatoire.Classe(PatientManquant && !patientTouche)" aria-invalid="@Obligatoire.Aria(PatientManquant && alerterPatient)" @onfocus="() => patientTouche = true"
                                           @bind="patientTexte" @bind:event="oninput" @bind:after="RechercherPatientsAsync" />
                                    @if (patients.Count > 0)
                                    {
                                        <ul class="suggestions" aria-label="Patients trouvés">
                                            @foreach (var p in patients)
                                            {
                                                <li><button type="button" @onclick="() => ChoisirPatientAsync(p)"><span><strong>@p.Nom @p.Prenom</strong><br /><span class="detail">@p.Telephone @p.NumAssure</span></span></button></li>
                                            }
                                        </ul>
                                    }
                                }
                                else
                                {
                                    <div class="sous-formulaire">
                                        <input type="text" aria-label="Nom (obligatoire)" data-champ="nom_patient" placeholder="Nom *" @ref="champNomPatient" @bind="np.Nom" @bind:event="oninput"
                                               class="@Obligatoire.Classe(NomPatientManquant)" aria-invalid="@Obligatoire.Aria(NomPatientManquant)" />
                                        @if (NomPatientManquant) { <span class="message-champ">Le nom du patient est obligatoire.</span> }
                                        <input type="text" aria-label="Prénom" placeholder="Prénom" @bind="np.Prenom" />
                                        <input type="text" aria-label="Téléphone" data-champ="telephone" placeholder="Téléphone" @bind="np.Telephone" />
                                        <input type="email" aria-label="E-mail (facultatif)" data-champ="email" placeholder="E-mail" maxlength="120" @bind="np.Email" />
                                        <input type="text" aria-label="N° d’assuré" placeholder="N° d’assuré" @bind="np.NumAssure" />
                                        <select class="selection" aria-label="Organisme" @bind="np.OrganismeId">
                                            <option value="0">Sans organisme</option>
                                            @foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }
                                        </select>
                                        <input type="number" min="0" aria-label="Plafond de crédit (DA)" data-champ="plafond" placeholder="Plafond de crédit (DA)" @bind="np.Plafond" />
                                        <div class="actions">
                                            <button type="button" class="btn btn-principal" @onclick="CreerPatientAsync">Créer</button>
                                            <button type="button" class="btn" @onclick="() => (nouveauPatient, controlePatient) = (false, false)">Annuler</button>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (AfficherMedecin)
                            {
                                <div class="champ recherche">
                                    <span class="etiquette-champ @(MedecinObligatoire ? "requis" : null)" title="@(OrdonnanceObligatoire ? "Psychotrope ou stupéfiant : ordonnance obligatoire" : MedecinParLeTaux ? "Tiers payant : l’organisme paie une partie du médicament" : null)">Médecin@(MedecinObligatoire ? " (obligatoire)" : jetonScan is not null ? " (ordonnance scannée)" : "") <span class="detail">F5</span></span>
                                    @if (medecin is not null)
                                    {
                                        @* Médecin choisi sur une ligne : nom et « Changer » ; la spécialité au survol *@
                                        <div class="choix medecin-choisi" title="@(string.IsNullOrWhiteSpace(medecin.Specialite) ? medecin.Nom : $"{medecin.Nom} · {medecin.Specialite}")">
                                            <strong>@medecin.Nom</strong>
                                            <button type="button" class="lien-bouton" @onclick="() => medecin = null">Changer</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="search" data-raccourci="medecin" aria-label="Rechercher le médecin prescripteur" data-champ="nom_medecin" placeholder="Nom du médecin" autocomplete="off" aria-invalid="@Obligatoire.Aria(MedecinManquant && !medecinTouche)" @onfocus="() => medecinTouche = true"
                                               @bind="medecinTexte" @bind:event="oninput" @bind:after="RechercherMedecinsAsync" />
                                        @if (medecins.Count > 0)
                                        {
                                            <ul class="suggestions" aria-label="Médecins trouvés">
                                                @foreach (var m in medecins)
                                                {
                                                    <li><button type="button" @onclick="() => (medecin, medecins, medecinTexte, clientEdition) = (m, [], m.Nom, true)"><span><strong>@m.Nom</strong> <span class="detail">@m.Specialite</span></span></button></li>
                                                }
                                            </ul>
                                        }
                                        @if (nouveauMedecin is not null)
                                        {
                                            <span class="detail">Nouveau médecin : complétez sa fiche ci-dessous.</span>
                                        }
                                        else if (medecinTexte.Trim().Length >= 2)
                                        {
                                            <button type="button" class="lien-bouton" style="align-self: flex-start" @onclick="OuvrirNouveauMedecin">Créer le médecin « @medecinTexte.Trim() »</button>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        @if (nouveauMedecin is { } nm)
                        {
                            @* Fiche du nouveau médecin (2026-11-15) : nom obligatoire ; spécialité, téléphone, e-mail, adresse, n° d'ordre et
                               code CNAS facultatifs *@
                            <div class="sous-formulaire fiche-medecin large" role="group" aria-label="Nouveau médecin">
                                <input type="text" aria-label="Nom du médecin (obligatoire)" data-champ="nom_medecin" placeholder="Nom *" maxlength="120" @bind="nm.Nom" />
                                <input type="text" aria-label="Spécialité" data-champ="specialite" placeholder="Spécialité" maxlength="120" @bind="nm.Specialite" />
                                <input type="text" aria-label="Téléphone" data-champ="telephone" placeholder="Téléphone" maxlength="30" @bind="nm.Telephone" />
                                <input type="email" aria-label="E-mail" data-champ="email" placeholder="E-mail" maxlength="120" @bind="nm.Email" />
                                <input type="text" aria-label="Adresse" data-champ="adresse_medecin" placeholder="Adresse" maxlength="300" @bind="nm.Adresse" />
                                <input type="text" aria-label="N° d’inscription à l’Ordre" data-champ="numero_ordre" placeholder="N° d’ordre" maxlength="30" @bind="nm.NumeroOrdre" />
                                <input type="text" aria-label="Code CNAS (Chifa)" data-champ="code_cnas" placeholder="Code CNAS" maxlength="30" @bind="nm.CodeCnas" />
                                @if (erreurMedecin is not null) { <div class="erreur" role="alert">@erreurMedecin</div> }
                                <div class="actions">
                                    <button type="button" class="btn btn-principal" disabled="@creationMedecin" @onclick="CreerMedecinAsync">Créer</button>
                                    <button type="button" class="btn" @onclick="() => (nouveauMedecin, erreurMedecin) = (null, null)">Annuler</button>
                                </div>
                            </div>
                        }
                        @if (PsychotropeInterdit)
                        {
                            <div class="erreur" role="alert">@MessagePsychotrope</div>
                        }

                        <div class="bloc-client-ordonnance">
                            @if (AfficherMedecin)
                            {
                                <div class="champ">
                                    <label for="date-prescription">Date de prescription</label>
                                    <input id="date-prescription" type="date" @bind="datePrescription" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="champ">
                                    <label for="numero-ordonnance">N° d’ordonnance</label>
                                    <input id="numero-ordonnance" type="text" @bind="numeroOrdonnance" />
                                </div>
                            }
                            <span class="espace"></span>
                            <span class="detail">Ordonnance :</span>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ScannerOrdonnanceAsync">Scanner</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="OuvrirCameraAsync">Caméra</button>
                            <button type="button" class="lien-bouton" disabled="@lectureEnCours" @onclick="ImporterOrdonnanceAsync">Fichier</button>
                            @if (lectureEnCours) { <span class="sous-titre" role="status">Lecture…</span> }
                        </div>
                        <!-- Porteur différent du patient : inscrit au registre (arrêté du 29 juin 2013, art. 7) -->
                        @if (apercu?.OrdonnanceRequise == true)
                        {
                            <!-- Porteur différent du patient : inscrit au registre (arrêté du 29 juin 2013, art. 7) -->
                            <label class="case"><input type="checkbox" @bind="porteurAutre" /><span>Le porteur de l’ordonnance n’est pas le patient</span></label>
                            @if (porteurAutre)
                            {
                                <input type="text" aria-label="Nom et prénom du porteur" placeholder="Nom et prénom du porteur *" @bind="porteurNom" @bind:event="oninput"
                                       class="@Obligatoire.Classe(PorteurNomManque)" aria-invalid="@Obligatoire.Aria(PorteurNomManque)" />
                                <input type="text" aria-label="Adresse du porteur" placeholder="Adresse du porteur *" @bind="porteurAdresse" @bind:event="oninput"
                                       class="@Obligatoire.Classe(PorteurAdresseManque)" aria-invalid="@Obligatoire.Aria(PorteurAdresseManque)" />
                                <input type="text" aria-label="Pièce d’identité du porteur" placeholder="Pièce d’identité (type et n°) *" @bind="porteurPiece" @bind:event="oninput"
                                       class="@Obligatoire.Classe(PorteurPieceManque)" aria-invalid="@Obligatoire.Aria(PorteurPieceManque)" />
                            }
                        }
                    }
                </section>
            </section>

            <!-- 3 · Paiement -->
            <aside class="panneau colonne-laterale reglement" aria-label="Paiement">
                <strong>3 · Paiement</strong>
                @if (tiersPayant)
                {
                    @* Tiers payant (2026-11-15) : organisme, taux et reste à charge dans le paiement, au-dessus de la part de l'organisme *@
                    <div class="tiers-payant-paiement" role="group" aria-label="Tiers payant">
                        <div class="champ champ-ligne">
                            <label for="org">Organisme</label>
                            <select id="org" class="selection" @bind="organismeId" @bind:after="RecalculerAsync">
                                @foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }
                            </select>
                        </div>
                        <div class="champ champ-ligne">
                            <span class="etiquette-champ">Taux</span>
                            <div class="filtres" role="group" aria-label="Taux de remboursement">
                                <button type="button" class="puce" aria-pressed="@(taux == 80 ? "true" : "false")" @onclick="() => ChoisirTauxAsync(80)">80 %</button>
                                <button type="button" class="puce" aria-pressed="@(taux == 100 ? "true" : "false")" @onclick="() => ChoisirTauxAsync(100)">100 %</button>
                            </div>
                        </div>
                        <div class="champ champ-ligne">
                            <label for="reste-saisi">Reste à charge (DA)</label>
                            <input id="reste-saisi" data-champ="reste_a_charge" type="number" min="0" step="0.01" placeholder="Selon le taux"
                                   title="Laissez vide pour appliquer le taux de prise en charge" @bind="resteSaisi" @bind:after="RecalculerAsync" />
                        </div>
                        @if (resteSaisi is not null)
                        {
                            <p class="detail" style="margin: 0">Reste à charge saisi : le taux n’est pas appliqué, la part de l’organisme est la différence. Videz la case pour revenir au taux.</p>
                        }
                    </div>
                    <div class="separateur"></div>
                }
                <ValidationProduitBloque Produits="@(apercu?.ProduitsBloques ?? [])" Operation="à la vente" Id="caisse" Accord="accordBlocage" OnChange="StateHasChanged" />
                @if (erreurCalcul is not null) { <div class="erreur" role="alert">@erreurCalcul</div> }
                <div class="ligne-total"><span>Total</span><span>@Libelles.Dinars(apercu?.MontantBrut ?? 0, 2)</span></div>
                @if (apercu is { } ap && ap.MontantBrut - ap.TotalMedicaments > 0)
                {
                    <div class="ligne-total detail"><span>Médicaments · autres</span><span style="white-space: nowrap">@Libelles.Dinars(ap.TotalMedicaments, 2) · @Libelles.Dinars(ap.MontantBrut - ap.TotalMedicaments, 2)</span></div>
                }
                @if ((apercu?.Shp ?? 0) > 0)
                {
                    <div class="ligne-total detail"><span>dont SHP (honoraire du pharmacien)</span><span>@Libelles.Dinars(apercu!.Shp, 2)</span></div>
                }
                @if (tiersPayant)
                {
                    <div class="ligne-total"><span>Part @(organismes.FirstOrDefault(o => o.Id == organismeId)?.Code ?? "organisme")</span><span>@Libelles.Dinars(apercu?.PartOrganisme ?? 0, 2)</span></div>
                }
                @* Remises et don partiel : une ligne chacun ; la part automatique est rappelée sur la première (colonne fixe, sans défilement) *@
                @if ((apercu?.MontantRemise ?? 0) > 0)
                {
                    <div class="ligne-total"><span>Remises@(apercu!.ReductionsAuto > 0 ? $" (dont auto {Libelles.Dinars(apercu.ReductionsAuto, 2)})" : "")</span><span>− @Libelles.Dinars(apercu.MontantRemise, 2)</span></div>
                }
                @if ((apercu?.MontantDon ?? 0) > 0)
                {
                    <div class="ligne-total"><span>Don partiel@(apercu!.MontantRemise == 0 && apercu.ReductionsAuto > 0 ? $" (dont auto {Libelles.Dinars(apercu.ReductionsAuto, 2)})" : "")</span><span>− @Libelles.Dinars(apercu.MontantDon, 2)</span></div>
                }
                <div class="a-payer"><span>@(tiersPayant ? "À payer par le patient" : "À payer")</span><span>@Libelles.Dinars(apercu?.PartPatient ?? 0, 2)</span></div>

                <div class="filtres modes-paiement" role="group" aria-label="Mode de paiement">
                    @foreach (var (code, libelle) in Modes)
                    {
                        <button type="button" class="puce" aria-pressed="@(mode == code ? "true" : "false")" @onclick="() => mode = code">@libelle</button>
                    }
                    @* Crédit : un mode comme les autres (2026-11-15), grisé sans patient ; la raison au survol *@
                    <button type="button" class="puce" aria-pressed="@(mode == "credit" ? "true" : "false")" disabled="@(patient is null)"
                            title="@(patient is null ? "Choisissez d’abord le patient à qui la vente est accordée" : "Mettre la vente au crédit du patient")" @onclick="@(() => mode = "credit")">Crédit</button>
                </div>
                @if (mode == "credit" && patient is not null)
                {
                    <div class="credit-resume" role="status">
                        <span>Mis au crédit de <strong>@($"{patient.Nom} {patient.Prenom}".Trim())</strong> : <strong>@Libelles.Dinars(apercu?.PartPatient ?? 0, 2)</strong></span>
                        <span class="detail">Après la vente : @Libelles.Dinars(patient.SoldeCredit + (apercu?.PartPatient ?? 0), 2) / plafond @Libelles.Dinars(patient.PlafondCredit)</span>
                        @if (patient.SoldeCredit + (apercu?.PartPatient ?? 0) > patient.PlafondCredit)
                        {
                            <span class="texte-attention">Au-delà du plafond : le droit de dépasser le plafond (ou le code d’un collègue qui l’a) sera demandé.</span>
                        }
                        @if (!Session.A("credit.accorder"))
                        {
                            <span class="detail">L’autorisation d’un employé qui a ce droit sera demandée (son code comptoir).</span>
                        }
                    </div>
                }
                else if (mode == "especes")
                {
                    @* Rendu mis en avant (2026-11-14), à côté du montant reçu : montant de cette vente seulement (aucun cumul :
                       comptage aveugle de la caisse) *@
                    <div class="paiement-especes">
                        <div class="champ">
                            <label for="recu">Montant reçu (DA)</label>
                            <input id="recu" type="number" min="0" step="1" @bind="montantRecu" @bind:event="oninput" placeholder="Appoint exact" />
                        </div>
                        <div class="champ">
                            <span class="etiquette-champ">Rendu</span>
                            <strong class="rendu-caisse @(Rendu > 0 ? "a-rendre" : null)" role="status" aria-live="polite">@Libelles.Dinars(Rendu, 2)</strong>
                        </div>
                    </div>
                }

                @* « + Remise » (2026-11-15) : le champ s'ouvre à la demande, ou de lui-même quand une remise est saisie *@
                @if (!RemiseOuverte)
                {
                    <button type="button" class="lien-bouton" style="align-self: flex-start" @onclick="OuvrirRemiseAsync" title="Sur un produit de parapharmacie : une remise ; sur un médicament : un don partiel du reste à charge">+ Remise ou don</button>
                }
                else
                {
                    @* Remise du vendeur (2026-11-14) : proposée à tout vendeur ; au-delà de son maximum (réglé par le titulaire) ou sans le droit,
                       le code d'un collègue dont le maximum la couvre est demandé à l'encaissement. Sur un médicament, c'est un don partiel du
                       reste à charge (droit de don, sinon code d'un collègue qui l'a). Entier de 0 à 100 ; le 0 s'efface dès qu'on tape ;
                       champ vidé : 0. *@
                    <div class="champ champ-ligne">
                        <label for="remise" title="Sur la part du patient, hors SHP (honoraire du pharmacien) : remise sur la parapharmacie, don partiel sur un médicament">Remise ou don (%, hors SHP)</label>
                        <input id="remise" data-champ="remise" @ref="champRemise" type="text" inputmode="numeric" maxlength="3" autocomplete="off" value="@RemiseTexte"
                               onfocus="this.select()" onbeforeinput="@CodeComptoirSaisie.FiltreChiffres"
                               @oninput="SaisieRemiseAsync" @onchange="RecalculerAsync" />
                        @if (remisePct > 0 && apercu?.Reductions?.Any(r => r.RemiseAutoPct > 0) == true)
                        {
                            <label class="case" title="Coché : votre remise s’ajoute à la remise automatique. Décoché : elle ne vaut que pour les produits sans remise automatique.">
                                <input type="checkbox" checked="@remiseAdditionnee" @onchange="ChoisirAdditionAsync" /><span>+ remise auto</span></label>
                        }
                    </div>
                    @if (remisePct > 0 && !Session.A("caisse.remise") && !Session.A("stock.donner"))
                    {
                        <p class="sous-titre">Le code d’un collègue qui en a le droit vous sera demandé à l’encaissement.</p>
                    }
                }

                @if (erreurEncaissement is not null) { <div class="erreur" role="alert">@erreurEncaissement</div> }
                <span class="espace"></span>
                <button type="button" class="btn btn-principal btn-large" disabled="@(!PeutEncaisserMode)" title="@RaisonBlocageMode" @onclick="() => EncaisserAsync(mode)">
                    @(mode == "credit" ? "Mettre en crédit (F12)" : "Encaisser (F12)")
                </button>
            </aside>
        </div>
        }
        </div>
    }
</div>

@code {
