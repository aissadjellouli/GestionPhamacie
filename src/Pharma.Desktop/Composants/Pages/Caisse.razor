    private VoletChifaDto? assureConflit;
    private static string Chiffres(string? s) => new((s ?? "").Where(char.IsAsciiDigit).ToArray());

    private async Task PrendreAssureVoletAsync()
    {
        if (assureConflit is not { } v) return;
