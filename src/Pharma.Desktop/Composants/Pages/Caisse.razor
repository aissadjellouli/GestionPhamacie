    private void CocherDu(long produitId, bool coche)
    {
        if (coche) produitsDus.Add(produitId); else produitsDus.Remove(produitId);
    }

    /// <summary>Le panier et le règlement en cours de saisie partent sur le serveur, avec le motif choisi ; la caisse est libérée.</summary>
    private async Task MettreEnAttenteAsync()
    {
        // Double clic : une seule mise en attente (sinon deux ventes en attente identiques)
        if (enCours) return;
        // Contrôles aussi faits par le serveur (motif actif, « Autre » avec texte, produits dus)
        if (motifAttente == "") { erreurMotifAttente = "Choisissez le motif de la mise en attente."; return; }
        if (motifAttente == "autre" && string.IsNullOrWhiteSpace(texteAttente)) { erreurMotifAttente = "Motif « Autre » : précisez le motif."; return; }
        if (motifAttente == "produit_manquant" && produitsDus.Count == 0) { erreurMotifAttente = "Cochez le ou les produits dus au patient."; return; }
        var dus = motifAttente != "produit_manquant" ? null
            : lignes.Where(l => produitsDus.Contains(l.ProduitId)).GroupBy(l => l.ProduitId)
                .Select(g => new ProduitDuDto(g.Key, g.First().Nom, g.Sum(l => l.Quantite))).ToList();
        enCours = true;
        try
        {
            await MettreDeCoteAsync(DemandeAttente() with { MotifCode = motifAttente, MotifTexte = texteAttente, ProduitsDus = dus });
            if (erreurAttente is not null) (erreurMotifAttente, erreurAttente) = (erreurAttente, null);
            else motifAttenteOuvert = false;
        }
        finally { enCours = false; }
    }

    /// <summary>
    /// Tout ce qui a été saisi part avec le panier : boîtes scannées (rattachées à la vente), raisons de lot, reste à charge,
    /// porteur de l'ordonnance ; rien n'est à ressaisir à la reprise.
    /// </summary>
    /// <summary>Panier en requête de mise en attente, calculée sans attendre (utilisable au moment même d'un changement d'utilisateur).</summary>
    private MiseEnAttenteRequete DemandeAttente(string? precision = null)
    {
        var panier = new PanierAttenteDto(
            lignes.Select(l => new LignePanierAttenteDto(l.ProduitId, l.Nom, l.Prix, l.Lot, l.Quantite, l.BoiteScannee, l.StockProduit,
                l.Boites.ToList(), l.RaisonLot, l.LotConseilleServi, l.TypePrestationId, l.TauxTva)).ToList(),
            tiersPayant, organismeId, taux, patient, medecin, datePrescription, numeroOrdonnance, remisePct, jetonScan, texteReconnu, voletBrut,
            resteSaisi, porteurAutre, porteurNom, porteurAdresse, porteurPiece, remiseAdditionnee, remiseProcheId, remiseProcheNom, remiseAutre ? remiseNom : null,
            ChoixChifaAttente.Garder(voletBrut, choixChifa), dureeTraitement);
        var libelle = (patient is { } p ? $"{p.Nom} {p.Prenom}".Trim() : $"Vente de {DateTime.Now:HH:mm}") + precision;
        var total = apercu?.MontantTotal ?? lignes.Sum(l => l.Prix * l.Quantite);
        return new MiseEnAttenteRequete(libelle, lignes.Count, total, System.Text.Json.JsonSerializer.Serialize(panier));
    }

    private async Task MettreDeCoteAsync(MiseEnAttenteRequete? demande = null)
    {
        if (lignes.Count == 0) return;
        // Pas de mise en attente d'un panier dont l'encaissement a été interrompu par la panne (décision du titulaire, 2026-11-25) :
        // la vente est peut-être enregistrée, et une reprise lui donnerait une nouvelle clé (risque de double encaissement)
        if (cleEnDoute) { erreurAttente = MessageAttenteRefusee; return; }
        erreurAttente = null;
        var (id, e) = await Api.MettreEnAttenteAsync(demande ?? DemandeAttente());
        if (e is not null) { erreurAttente = e; return; }
        derniereMiseEnAttente = id;
        venteFaite = null;
        ViderPanier();
        await ChargerAttentesAsync();
        Afficheur.Accueil();   // le panier mis de côté ne reste pas affiché devant le client suivant
    }

    /// <summary>Reprise : le panier en cours (s'il y en a un) part d'abord en attente, rien n'est perdu.</summary>
    private async Task ReprendreAsync(VenteEnAttenteDto v)
    {
        // Double clic, ou clic sur une seconde vente avant la réponse : une seule reprise (sinon un panier serait perdu)
        if (enCours) return;
        enCours = true;
        try { await ReprendreVenteAsync(v); }
        finally { enCours = false; }
    }

    private async Task ReprendreVenteAsync(VenteEnAttenteDto v)
    {
        erreurAttente = null;
        if (lignes.Count > 0) { await MettreDeCoteAsync(); if (erreurAttente is not null) return; }
        var (json, e) = await Api.ReprendreVenteEnAttenteAsync(v.Id);
        if (e is not null) { erreurAttente = e; await ChargerAttentesAsync(); return; }
        PanierAttenteDto? p;
        try { p = System.Text.Json.JsonSerializer.Deserialize<PanierAttenteDto>(json!); }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or NotSupportedException) { p = null; }
        if (p?.Lignes is null)
        {
            // Contenu illisible (format d'une ancienne version) : la vente est remise en attente telle quelle au lieu d'être perdue
            await Api.MettreEnAttenteAsync(new MiseEnAttenteRequete(v.Libelle, v.Lignes, v.Total, json!));
            erreurAttente = "Cette vente en attente n’a pas pu être reprise (contenu illisible) : elle reste dans la liste, ressaisissez-la.";
            await ChargerAttentesAsync();
            return;
        }
        ViderPanier();
        venteFaite = null;
        foreach (var l in p.Lignes)
        {
            var ligne = new LignePanier { ProduitId = l.ProduitId, Nom = l.Nom, Prix = l.Prix, Lot = l.Lot, Quantite = l.Quantite, BoiteScannee = l.BoiteScannee,
                StockProduit = l.StockProduit, RaisonLot = l.RaisonLot, LotConseilleServi = l.LotConseilleServi,
                TypePrestationId = l.TypePrestationId, TauxTva = l.TauxTva };
            ligne.Boites.AddRange(l.Boites ?? []);
            lignes.Add(ligne);
        }
        (tiersPayant, organismeId, taux, patient, medecin) = (p.TiersPayant, p.OrganismeId, p.Taux, p.Patient, p.Medecin);
        (datePrescription, numeroOrdonnance, remisePct, jetonScan, texteReconnu) = (p.DatePrescription, p.NumeroOrdonnance, p.RemisePct, p.JetonScan, p.TexteReconnu);
        (resteSaisi, porteurAutre, porteurNom, porteurAdresse, porteurPiece) = (p.ResteSaisi, p.PorteurAutre, p.PorteurNom, p.PorteurAdresse, p.PorteurPiece);
        remiseAdditionnee = p.RemiseAdditionnee;
        dureeTraitement = p.DureeTraitementJours;   // durée du traitement gardée avec la vente (2026-11-16)
        (remiseProcheId, remiseProcheNom, remiseAutre, remiseNom) = (p.RemiseProcheId, p.RemiseProcheNom, p.RemiseNom is not null, p.RemiseNom);
        if (remiseProcheId is { } rp && proches.All(x => x.Id != rp)) proches = [.. proches, new ProchePatientDto(rp, remiseProcheNom ?? "", null, null)];
        if (medecin is not null) medecinTexte = medecin.Nom;
        cleSaisieClient++;   // champs patient et médecin recréés avec la vente reprise
        if (p.VoletChifa is { } brut && (await Api.LireVoletChifaAsync(brut)).Item1 is { } vr) (volet, voletBrut) = (vr, brut);
        // Choix de prix Chifa gardés avec la vente (2026-11-15) : rétablis sans les refaire, revérifiés par le serveur à l'encaissement
        choixChifa = ChoixChifaAttente.Restaurer(p, voletBrut is not null);
        await ChargerAttentesAsync();
        await RecalculerAsync();   // prix et parts recalculés par le serveur
    }

    private async Task AbandonnerAsync(VenteEnAttenteDto v)
    {
        aAbandonner = null;
        erreurAttente = await Api.SupprimerVenteEnAttenteAsync(v.Id);
        await ChargerAttentesAsync();
    }

    /// <summary>
    /// Panier et règlement remis à zéro (après une vente ou une mise en attente) : rien du client précédent ne reste (patient,
    /// formulaire de nouveau patient, médecin, ordonnance), taux et organisme reviennent à ceux de l'ouverture de la caisse, et le
    /// nouveau panier a sa propre clé d'encaissement. L'afficheur client n'est pas touché (écran « Payé » après un encaissement).
    /// </summary>
    private void ViderPanier()
    {
        lignes.Clear();
        cleEncaissement = Guid.NewGuid();
        cleEnDoute = false;
        (apercu, bandeau, erreur, montantRecu, remisePct, remiseAdditionnee) = (null, null, null, null, 0, false);
        erreurRemise = null;
        (patient, medecin, medecinTexte, numeroOrdonnance, tiersPayant, mode, resteSaisi) = (null, null, "", null, false, "especes", null);
        (nouveauPatient, np, controlePatient, patientTexte, patients, alerterPatient) = (false, new(), false, "", [], false);
        cleSaisieClient++;
        (clientDeplie, remiseDemandee, attentesOuvertes, nouveauMedecin, erreurMedecin, clientEdition, reduitDemande) = (false, false, false, null, null, false, false);
        alerterMedecin = false;
        if (mode == "credit") mode = "especes";
        (datePrescription, erreurScan, taux, organismeId) = (DateOnly.FromDateTime(DateTime.Today), null, TauxParDefaut, OrganismeParDefaut);
        (volet, voletBrut, codesAAssocier, choixChifa) = (null, null, [], []);
        (factureeChifa, numeroFactureChifa, patientExistant, alerterChifa) = (false, null, null, false);
        (motifSansVolet, texteSansVolet) = (null, null);
        (utiliserAvoir, montantAvoirSaisi, soldeAvoirPatient, avoirPatientId) = (false, null, 0, null);
        accordBlocage.Effacer();
        (image, jetonScan, texteReconnu, lignesOrdonnance, lignesIgnorees, imageAgrandie) = (null, null, null, [], 0, false);
        lectureAjouts.Clear();
        (motifSaisieManuelle, lectureSansResultat) = (null, null);
        (porteurAutre, porteurNom, porteurAdresse, porteurPiece, alerterPorteur, focaliserPorteur) = (false, null, null, null, false, false);
        (dureeTraitement, alerterDuree) = (null, false);
        (remiseProcheId, remiseProcheNom, remiseAutre, remiseNom) = (null, null, false, null);
    }

    // Panier non encaissé ni mis en attente, perdu en quittant la caisse (autre écran, déconnexion, changement d'utilisateur,
    // inactivité) : signalé comme boîtes retirées, sinon quitter contournerait la surveillance « lignes retirées ». À la
    // déconnexion, appelé juste avant que le jeton soit effacé (SessionPoste.AvantFermeture).
    private void PanierAbandonne()
    {
        // Encaissement interrompu par la panne : ni attente ni « retiré » (la vente est peut-être enregistrée) ; gardé en mémoire
        if (cleEnDoute && lignes.Any(l => l.Quantite > 0)) { GarderPanierEnDoute(); return; }
        // « Changer d'utilisateur » : le panier est déjà parti en attente, réponse attendue (LaisserAuSuivantAsync, appelé par
        // l'en-tête avant de fermer la session ; un échec arrête le changement). Filet si un panier est encore là malgré tout :
        // la vente part en attente sans attendre la réponse (rien n'est signalé « retiré »).
        if (Session.ChangementUtilisateur && lignes.Any(l => l.Quantite > 0))
        {
            var quitte = Session.NomComplet ?? "l’employé précédent";
            var envoi = Api.MettreEnAttenteAsync(DemandeAttente($" · laissée par {quitte}"));
            lignes.Clear();
            _ = RetenirPourLeSuivantAsync(envoi, quitte);
            return;
        }
        foreach (var l in lignes.Where(l => l.Quantite > 0).ToList()) SignalerRetrait(l, l.Quantite);
        lignes.Clear();
    }

    /// <summary>
    /// Écran détruit panier encore rempli (2026-11-15). Quitter par le menu met déjà la vente en attente (QuitterAsync) et la
    /// déconnexion passe par PanierAbandonne : un panier encore là vient d'une erreur imprévue (l'écran est remplacé par le
    /// message d'erreur) ou de la fermeture de la fenêtre. Il part en attente « sauvée après une erreur » au lieu d'être perdu
    /// et signalé ligne par ligne comme retiré ; si la mise en attente échoue, les boîtes sont signalées retirées comme avant.
    /// </summary>
    private void SauverPanierRestant()
    {
        var restantes = lignes.Where(l => l.Quantite > 0).ToList();
        if (restantes.Count == 0) { lignes.Clear(); return; }
        if (cleEnDoute) { GarderPanierEnDoute(); return; }   // jamais en attente : gardé en mémoire avec sa clé
        var demande = DemandeAttente(" · sauvée après une erreur de l’écran");
        lignes.Clear();
        _ = MettreEnAttenteOuSignalerAsync(demande, restantes);
    }

    private async Task MettreEnAttenteOuSignalerAsync(MiseEnAttenteRequete demande, List<LignePanier> restantes)
    {
        string? e;
        try { (_, e) = await Api.MettreEnAttenteAsync(demande); }
        catch (Exception ex) { e = ex.Message; }
        if (e is null) return;
        foreach (var l in restantes) SignalerRetrait(l, l.Quantite);
    }

    public async ValueTask DisposeAsync()
    {
        Session.AvantFermeture -= PanierAbandonne;
        Bascule.Change -= SurBascule;
        Panier.Desabonner(MettreDeCoteBasculeAsync);
        Session.OublierAvantChangement(LaisserAuSuivantAsync);
        // Actualisation du bandeau « produit redevenu disponible » arrêtée (2026-11-16)
        arretAlertesDispo.Cancel();
        arretAlertesDispo.Dispose();
        arretAttenteEncaissement.Cancel();
        arretAttenteEncaissement.Dispose();
        // Caisse quittée pendant un encaissement en suspens : renvoi automatique abandonné, panier traité comme d'habitude
        ArreterRenvoi();
        Historique.Oublier("caisse");
        SauverPanierRestant();
        // Écran quitté : l'afficheur client revient à l'accueil, la caméra s'éteint (même si elle était encore en train de démarrer)
        Afficheur.Accueil();
        try { await JS.InvokeVoidAsync("pharma.arreterF12"); }
        catch (JSDisconnectedException) { }
        try { await JS.InvokeVoidAsync("pharma.camera.arreter"); }
        catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
}
