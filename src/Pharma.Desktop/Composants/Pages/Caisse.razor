    private async Task ChoisirRaisonAsync(LignePanier l, string? raison)
    {
        l.RaisonLot = raison;
        ligneAVoir = derniereAjoutee;   // l'encadré change de hauteur : la dernière ligne ajoutée reste dans le cadre
        await RecalculerAsync();
    }

    private async Task RecalculerAsync()
    {
        var numero = ++requeteCalcul;
        if (!lignes.Any(l => l.Envoyee))
        {
            (apercu, erreurCalcul) = (null, null);
            Afficheur.Accueil();
            if (lignes.Count == 0) (cleEncaissement, cleEnDoute) = (Guid.NewGuid(), false);   // panier vidé : le prochain panier est une autre vente
            return;
        }
        var (resultat, err) = await Api.CalculerVenteAsync(Commande("especes"));
        if (numero != requeteCalcul) return;
        (apercu, erreurCalcul) = (resultat, err);
        // Prix de chaque boîte calculé par le serveur : PPA du lot (ou prix du catalogue) plus le SHP
        // Lot plus ancien en stock : raison à choisir, ou péremption plus proche vérifiée par le serveur (à valider)
        if (resultat?.Situations is { } situations)
        {
            var lignesLot = lignes.Where(l => l.Envoyee).ToList();   // même ordre que les lignes envoyées (prestations comprises)
            for (var i = 0; i < lignesLot.Count && i < situations.Count; i++)
            {
                var l = lignesLot[i];
                if (l.Situation?.Situation != situations[i].Situation || l.Situation?.LotId != situations[i].LotId) l.RaisonLot = null;
                l.Situation = situations[i];
            }
        }
        if (resultat?.PrixLignes is { } prix)
        {
            var avecLot = lignes.Where(l => l.Envoyee).ToList();
            for (var i = 0; i < avecLot.Count && i < prix.Count; i++) avecLot[i].Prix = prix[i];
            for (var i = 0; i < avecLot.Count; i++) avecLot[i].Reduction = resultat.Reductions is { } r && i < r.Count ? r[i] : null;
        }
        // Afficheur client : lignes du panier et part à payer par le patient
        Afficheur.Panier(lignes.Where(l => l.Envoyee).Select(l => (l.Nom, l.Quantite, l.Prix * l.Quantite)).ToList(), apercu?.PartPatient ?? 0);
    }

    // Ticket de la dernière vente, imprimé par Windows (imprimante du poste ou imprimante par défaut)
    private bool impressionEnCours, ticketImprime;
    private string? messageTicket;

    private async Task ImprimerTicketAsync()
    {
        // Vente gardée ici : le caissier peut scanner le produit suivant pendant l'impression (venteFaite repasse alors à null)
        if (venteFaite is not { } vente) return;
        (impressionEnCours, messageTicket) = (true, null);
        try
        {
            var rendu = vente.Mode == "especes" ? vente.Rendu : (decimal?)null;
            if (Tickets.ImprimanteFichier)
            {
                // Imprimante qui enregistre un fichier (PDF…) : le ticket s'ouvre à l'écran, sans fenêtre « Enregistrer sous » (2026-11-15)
                var (pdf, nom, ePdf) = await Api.TicketPdfAsync(vente.VenteId, rendu, Tickets.LargeurMm);
                if (ePdf is null) Documents.OuvrirSurCePoste("Tickets", nom ?? $"ticket_{vente.Numero}.pdf", pdf!);
                ticketImprime = ePdf is null;
                messageTicket = ePdf ?? $"Ticket {vente.Numero} ouvert à l’écran (l’imprimante de ce poste enregistre un fichier au lieu d’imprimer).";
                return;
            }
            var (ticket, e) = await Api.TicketAsync(vente.VenteId);
            e ??= await Tickets.ImprimerAsync(ticket!, rendu);
            ticketImprime = e is null;
            messageTicket = e ?? $"Ticket {vente.Numero} envoyé à l’imprimante{(Tickets.NomDeclare is { } n ? $" « {n} »" : " par défaut")}.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Une imprimante en panne ne fait jamais perdre le panier en cours
            messageTicket = $"Ticket {vente.Numero} non imprimé : {ex.Message}";
        }
        finally { impressionEnCours = false; }
    }

    // ---- Alertes du registre des psychotropes (lot 8) ----
    private ControleDelivranceDto? controlePsy;
    private DelivrancePsychotropeDto? delivrancePsy;
    private string modePsy = "especes";
    private bool alertesPsyForcees;

    private void AbandonnerPsy() => (controlePsy, delivrancePsy) = (null, null);

    private async Task PsyForceesAsync()
    {
        (controlePsy, delivrancePsy, alertesPsyForcees) = (null, null, true);
        await EncaisserAsync(modePsy);
    }

    private async Task EncaisserAsync(string modePaiement)
    {
        if (!PeutEncaisser || Bascule.VentesSuspendues) return;
        messageTicket = null;
        venteRenvoyee = false;
        enCours = true;
        erreurEncaissement = null;
        // Registre renforcé (lot 8) : produit sous registre, alertes contrôlées avant l'encaissement (avertissement ; « Forcer » avec motif)
        if (apercu?.OrdonnanceRequise == true && !alertesPsyForcees)
        {
            var c = Commande(modePaiement);
            var d = new DelivrancePsychotropeDto(c.PatientId, c.Ordonnance?.MedecinId, c.Ordonnance?.Numero, c.Ordonnance?.DatePrescription,
                c.Lignes.Where(l => l.ProduitId is not null).Select(l => new LignePsychotropeDto(l.ProduitId!.Value, l.Quantite)).ToList(),
                c.Ordonnance?.DureeTraitementJours);
            var (controle, _) = await Api.ControlerDelivrancePsychotropeAsync(d);   // erreur : l'encaissement contrôle de nouveau
            if (controle is { Alertes.Count: > 0 })
            {
                (controlePsy, delivrancePsy, modePsy, enCours) = (controle, d, modePaiement, false);
                return;
            }
        }
        alertesPsyForcees = false;
        // Choix de prix Chifa demandé sans le droit : la fenêtre « Faire autoriser » montre au valideur chaque ligne et le choix (2026-11-15)
        if (voletBrut is not null && !Session.A("prix.modifier"))
            Api.DetaillerProchaineAutorisation(DetailAutorisationChifa.Construire(apercu?.EcartsChifa, choixChifa, m => Libelles.Dinars(m, 2)));
        var commande = Commande(modePaiement);
        var (vente, err) = await Api.EncaisserAsync(commande);
        enCours = false;
        // Panne du serveur sur un poste qui a un 2e serveur (Q25) : la commande est gardée et renvoyée une fois, avec la même clé,
        // dès que le poste a basculé (la promotion arrive 1 à 2 minutes après la panne) ou retrouvé son serveur
        var panne = err == ApiClient.Injoignable || err == ApiClient.MessageDelaiDepasse;
        // Panne pendant l'encaissement (un ou deux serveurs) : la vente est peut-être enregistrée, ce panier ne part plus en attente
        if (panne) cleEnDoute = true;
        if (err is not null && RenvoiEncaissement.APlacer(Bascule.Active, panne))
        {
            MettreEnSuspens(new RenvoiEncaissement(commande, modePaiement, Bascule.Generation, DateTime.UtcNow));
            return;
        }
        await TerminerEncaissementAsync(vente, err);
    }

    // ---- Encaissement en suspens après une panne du serveur (Q25, corrigé le 2026-11-25) ----
    private RenvoiEncaissement? renvoi;
    private CancellationTokenSource? arretRenvoi;
    private bool venteRenvoyee;
    /// <summary>
    /// Encaissement de ce panier interrompu par la panne : la vente est peut-être enregistrée sous sa clé. Jusqu'à un nouveau panier
    /// (vente réussie, panier vidé), jamais de mise en attente (une reprise changerait la clé) : gardé en mémoire avec sa clé.
    /// </summary>
    private bool cleEnDoute;

    internal const string MessageAttenteRefusee =
        "Mise en attente impossible : l’encaissement de ce panier a été interrompu par la panne du serveur et la vente est peut-être déjà "
        + "enregistrée. Encaissez-le de nouveau sans rien changer (il ne sera jamais encaissé deux fois), ou videz le panier.";

    internal const string MessagePanierEnDouteRendu =
        "Vente reprise : son encaissement avait été interrompu par la panne du serveur. Encaissez-la de nouveau sans rien changer : "
        + "elle ne sera jamais encaissée deux fois.";

    private void MettreEnSuspens(RenvoiEncaissement r)
    {
        ArreterRenvoi();
        cleEnDoute = true;
        (renvoi, erreurEncaissement) = (r, null);
        arretRenvoi = new CancellationTokenSource();
        _ = SuivreRenvoiAsync(r, arretRenvoi.Token);
    }

    private void ArreterRenvoi()
    {
        arretRenvoi?.Cancel();
        arretRenvoi?.Dispose();
        (arretRenvoi, renvoi) = (null, null);
    }

    /// <summary>« Annuler le renvoi automatique » : le panier redevient modifiable, sa clé est gardée (un nouvel essai ne crée jamais de double).</summary>
    private void AnnulerRenvoi()
    {
        ArreterRenvoi();
        erreurEncaissement = RenvoiEncaissement.MessageAnnule;
    }

    private async Task SuivreRenvoiAsync(RenvoiEncaissement r, CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(RenvoiEncaissement.Cadence, ct);
                var basculee = Bascule.Generation != r.Generation;
                var joint = !basculee && await Api.ServeurJoignableAsync();
                if (ct.IsCancellationRequested) return;
                switch (r.Etape(DateTime.UtcNow, Bascule.Generation, joint, Session.EstConnecte, Bascule.VentesSuspendues))
                {
                    case EtapeRenvoi.Renvoyer:
                        await InvokeAsync(() => RenvoyerAsync(r));
                        return;
                    case EtapeRenvoi.Expire:
                        await InvokeAsync(() =>
                        {
                            if (renvoi != r) return;
                            ArreterRenvoi();
                            erreurEncaissement = RenvoiEncaissement.MessageExpire;
                            StateHasChanged();
                        });
                        return;
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    /// <summary>Renvoi unique de la commande gardée (même clé) : un nouvel échec est affiché tel quel, sans nouvelle mise en suspens.</summary>
    private async Task RenvoyerAsync(RenvoiEncaissement r)
    {
        if (renvoi != r) return;
        ArreterRenvoi();
        enCours = true;
        StateHasChanged();
        var (vente, err) = await Api.EncaisserAsync(r.Commande);
        enCours = false;
        venteRenvoyee = err is null;
        await TerminerEncaissementAsync(vente, err);
        StateHasChanged();
    }

    private async Task TerminerEncaissementAsync(VenteEncaisseeDto? vente, string? err)
    {
        if (err is not null)
        {
            // Réponse trop lente : la vente est peut-être enregistrée. La clé du panier est gardée : un nouvel essai rend la vente
            // déjà enregistrée au lieu d'en créer une seconde
            erreurEncaissement = err == ApiClient.MessageDelaiDepasse
                ? "Le serveur met trop de temps à répondre : la vente est peut-être déjà enregistrée. Vérifiez les dernières ventes, "
                  + "ou encaissez de nouveau sans rien changer au panier : il ne sera jamais encaissé deux fois."
                : err;
            return;
        }

        venteFaite = vente;
        // Vente à crédit : rien n'est payé au comptoir, l'afficheur client remercie sans montant
        Afficheur.Paiement(vente!.PartPatient, vente.Mode == "especes" ? montantRecu : null, vente.Mode == "especes" ? vente.Rendu : 0,
            credit: vente.Mode == "credit");
        // Réglage du poste : ticket imprimé sans clic après chaque vente
        if (Tickets.Automatique) _ = InvokeAsync(async () => { await ImprimerTicketAsync(); StateHasChanged(); });
        // Fin de droits lue sur Chifa, saisie sous la carte du patient (facultative) : enregistrée sur la fiche avec la vente (journal patient_modifie)
        (long Id, DateOnly Date)? finDroit = EtatDroitsPatient == EtatDroits.Absente && patient is { } pf && finDroitSaisiePatient == pf.Id
            && finDroitSaisie is { } fd ? (pf.Id, fd) : null;
        ViderPanier();
        (finDroitSaisie, finDroitSaisiePatient, majFinDroitPatient) = (null, null, null);
        if (finDroit is { } f && await Api.FinDroitPatientAsync(f.Id, f.Date) is { } errFin)
            erreurEncaissement = $"Vente enregistrée, mais la date de fin de droits n’a pas été enregistrée sur la fiche : {errFin}";
    }

