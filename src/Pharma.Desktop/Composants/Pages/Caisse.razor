    protected override async Task OnAfterRenderAsync(bool premierAffichage)
    {
        // Case « porteur » cochée : curseur dans le nom du porteur, une fois les champs affichés
        if (focaliserPorteur && porteurAutre)
        {
            focaliserPorteur = false;
            try { await champPorteurNom.FocusAsync(); }
            catch (Exception e) when (e is InvalidOperationException or Microsoft.JSInterop.JSException) { }   // champ retiré entre-temps
        }
        // Patient choisi ou changé : membres de sa famille (script 090) chargés pour « Remis à » / « Pour »
        if (patient?.Id != prochesDe)
        {
            prochesDe = patient?.Id;
            var charges = prochesDe is { } pid ? (await Api.ProchesPatientAsync(pid)).Item1 ?? [] : [];
            if (patient?.Id == prochesDe)
            {
                proches = charges;
                if (remiseProcheId is { } rid && proches.All(p => p.Id != rid)) (remiseProcheId, remiseProcheNom) = (null, null);
                StateHasChanged();
            }
        }
        // Flèches dans la liste du panier : le bouton mis en avant reste visible (seule la liste défile)
        if (voirOptionScan)
        {
            voirOptionScan = false;
            if (ActifScan >= 0) await JS.InvokeVoidAsync("pharma.voirOption", $"scan-opt-{ActifScan}");
        }
        // Produit ajouté ou scanné : sa ligne est amenée dans le cadre du panier (les autres restent au-dessus ou au-dessous)
        if (ligneAVoir is { } aVoir)
        {
            ligneAVoir = null;
            var index = lignes.IndexOf(aVoir);
            if (index >= 0) await JS.InvokeVoidAsync("pharma.voirLigne", index);
        }
        if (premierAffichage)
        {
            reference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pharma.ecouterF12", reference);
        }
        if (focusLecture && imageAgrandie)
        {
            focusLecture = false;
            await champLecture.FocusAsync();
        }
        if (PsychotropeInterdit && detenteursPsychotropes is null)
        {
            (detenteursPsychotropes, _) = await Api.DelivrancePsychotropesAsync();
            StateHasChanged();
        }
    }

