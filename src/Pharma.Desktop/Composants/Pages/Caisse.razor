    /// <summary>Patient, organisme et date d'ordonnance repris du volet.</summary>
    private async Task AppliquerAssureVoletAsync(VoletChifaDto v)
    {
        if (v.PatientId is { } pid)
        {
            patientTexte = v.PatientNumAssure ?? v.Assure;   // la recherche compare le n° d'assuré à l'identique
            (patients, _) = await Api.RechercherPatientsAsync(patientTexte);
            if (patients.FirstOrDefault(x => x.Id == pid) is { } trouve) await ChoisirPatientVoletAsync(trouve);
            else (patients, patientTexte) = ([], "");
        }
        if (v.OrganismeId is { } org) organismeId = org;
        // Volet Chifa : CNAS ou CASNOS seulement (2026-11-15) ; un autre organisme repris de la fiche du patient est remplacé
        if (!OrganismeAdmis(organismeId)) organismeId = OrganismesPaiement.FirstOrDefault()?.Id ?? organismeId;
        // Date de l'ordonnance : seconde date du QR (sens à confirmer, docs/chifa.md), jamais dans le futur
        if (v.DateSecondaire is { } dateOrd && dateOrd <= DateOnly.FromDateTime(DateTime.Today)) datePrescription = dateOrd;
        // Assuré inconnu : petite fenêtre du nom du patient (volet prérempli, 2026-11-15)
        if (patient is null)
            (patientVoletOuvert, nomPatientVolet, erreurPatientVolet, lienPatientVolet, principalPatientVolet) = (true, "", null, "", v.AssurePrincipalProposeId);
    }

