    private void OuvrirNouveauPatient()
    {
        // Plafond de crédit proposé : réglé par le titulaire (Administration › Caisse), 0 par défaut
        np = new NouveauPatientSaisie { Nom = patientTexte.Trim(), OrganismeId = tiersPayant ? organismeId : 0, Plafond = etat?.PlafondCreditDefaut ?? 0 };
        nouveauPatient = true;
        controlePatient = false;
