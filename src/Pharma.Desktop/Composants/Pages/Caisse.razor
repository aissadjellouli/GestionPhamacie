    private async Task ChangerWilayaMedecinAsync(ChangeEventArgs e)
    {
        if (medecin is not { } m || enregistrementWilaya) return;
        var choisie = e.Value?.ToString() is { Length: > 0 } w ? w : null;
        if (choisie == m.Wilaya) return;
        enregistrementWilaya = true;
        try
        {
            // Fiche relue juste avant : seule la wilaya change (une correction faite ailleurs depuis la recherche ou la mise en attente
            // n'est pas écrasée par la copie gardée dans la caisse)
            var (relue, erreurLecture) = await Api.MedecinAsync(m.Id);
            if (erreurLecture is not null || relue is not { } fiche)
            {
                RefuserWilaya(m, erreurLecture ?? "Fiche du médecin introuvable : wilaya non enregistrée. Rouvrez la fiche depuis Factures › Médecins.");
                return;
            }
            var refus = await Api.ModifierMedecinAsync(fiche.Id, new NouveauMedecinDto(fiche.Nom, fiche.Specialite, fiche.Telephone, fiche.Adresse, fiche.Email,
                fiche.NumeroOrdre, fiche.CodeCnas, choisie));
            if (refus is null)
            {
                medecin = fiche with { Wilaya = choisie };
                messageWilaya = choisie is null ? "Wilaya retirée de la fiche du médecin." : $"Wilaya enregistrée dans la fiche du médecin ({wilayas.FirstOrDefault(x => x.Code == choisie)?.Nom ?? choisie}).";
            }
            else RefuserWilaya(fiche, refus);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            RefuserWilaya(m, "Serveur injoignable : wilaya non enregistrée.");
        }
        finally
        {
            enregistrementWilaya = false;
        }
    }

