    internal static string TexteDisponibilite(AlertesDisponibiliteDto ad)
    {
        var parties = new List<string>();
        if (ad.Patients.Count > 0)
            parties.Add(ad.Patients.Count == 1 ? "1 patient à prévenir" : $"{ad.Patients.Count} patients à prévenir");
        if (ad.VentesEnAttente.Count == 1 && ad.VentesEnAttente[0] is { } du)
            parties.Add($"{du.Produit} × {du.Quantite} dû à la vente en attente « {du.Libelle} »");
        else if (ad.VentesEnAttente.Count > 1)
            parties.Add($"{ad.VentesEnAttente.Count} produits dus de ventes en attente");
        return string.Join(", ", parties);
    }
