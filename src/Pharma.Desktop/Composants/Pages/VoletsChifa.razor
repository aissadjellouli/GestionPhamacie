@page "/chifa"
@inject ApiClient Api
@inject HistoriqueNavigation Historique
@inject SessionPoste Session
@inject RemboursementsTiroir Remboursements
@inject NavigationManager Nav
@using Pharma.Desktop.Composants.Caisse

@* Circuit « la caisse d'abord » (règle du titulaire, 2026-11-15) : ventes Chifa encaissées qui attendent leur volet (ancienneté), et
   volets rattachés malgré des différences (motif, différences, écart de part organisme). Listes filtrées et paginées par le serveur ;
   écran fixe, seul le tableau défile. Le rattachement se fait à la caisse, en scannant le QR du volet. *@
<div class="page avec-menu">
    <NavDomaine Libelle="Écrans des finances" />
    <div class="contenu-rubrique">
        <div class="titre-page">
            <div>
                <h1>Chifa<AideEcran Cle="chifa" /></h1>
                <p class="sous-titre">Ventes encaissées en attente de leur volet Chifa, volets rattachés avec écart. Pour rattacher un volet : scannez son QR à la caisse, panier vide.</p>
            </div>
        </div>

        <div class="filtres" role="tablist" aria-label="Listes Chifa">
            <button type="button" role="tab" class="puce" aria-selected="@(onglet == "attente" ? "true" : "false")" @onclick="@(() => ChoisirAsync("attente"))">Ventes en attente de volet</button>
            <button type="button" role="tab" class="puce" aria-selected="@(onglet == "ecart" ? "true" : "false")" @onclick="@(() => ChoisirAsync("ecart"))">Volets avec écart</button>
            <button type="button" role="tab" class="puce" aria-selected="@(onglet == "ventes" ? "true" : "false")" @onclick="@(() => ChoisirAsync("ventes"))">Ventes Chifa</button>
            <button type="button" role="tab" class="puce" aria-selected="@(onglet == "exclues" ? "true" : "false")" @onclick="@(() => ChoisirAsync("exclues"))">Ventes exclues</button>
            @* Retour partiel d'une vente en tiers payant (script 155) : la facture Chifa signée se corrige dans CHIFA-Officine *@
            <button type="button" role="tab" class="puce" aria-selected="@(onglet == "retours" ? "true" : "false")" @onclick="@(() => ChoisirAsync("retours"))">Retours à corriger dans CHIFA-Officine</button>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

        <div class="filtres-liste" role="search" aria-label="Filtrer la liste">
            <div class="champ" style="flex: 1 1 260px"><label for="vc-q">N° de vente, patient ou n° d’assuré@(onglet != "attente" ? ", n° de facture Chifa" : "")</label>
                <input id="vc-q" data-champ="recherche" type="search" autocomplete="off" @bind="recherche" @bind:event="oninput" @bind:after="() => ChargerAsync(1, taille)" /></div>
            @if (onglet is "ventes" or "exclues")
            {
                @* Un bordereau par centre payeur (D-2) : filtre par centre *@
                <div class="champ" style="flex: 0 1 280px"><label for="vc-centre">Centre payeur</label>
                    <select id="vc-centre" data-champ="centre_payeur" @bind="centreId" @bind:after="() => ChargerAsync(1, taille)">
                        <option value="">Tous</option>
                        @foreach (var c in centres) { <option value="@c.Id">@c.OrganismeCode · @c.Code · @c.Nom@(c.Actif ? "" : " (désactivé)")</option> }
                    </select></div>
            }
            else if (onglet == "retours")
            {
                <div class="champ" style="flex: 0 1 220px"><label for="vc-etat">État</label>
                    <select id="vc-etat" data-champ="etat" @bind="etatRetours" @bind:after="() => ChargerAsync(1, taille)">
                        <option value="a_corriger">À corriger</option>
                        <option value="corriges">Corrigés</option>
                        <option value="tous">Tous</option>
                    </select></div>
            }
        </div>
        @if (message is not null) { <div class="info-bandeau" role="status">@message</div> }

        <div class="tableau-cadre">
            @if (onglet == "attente")
            {
                <table class="tableau" style="min-width: 900px">
                    <thead><tr><th scope="col">Vente</th><th scope="col">Encaissée le</th><th scope="col">Ancienneté</th><th scope="col">Patient</th><th scope="col">Organisme</th><th scope="col" class="nombre">Total</th><th scope="col" class="nombre">Part organisme</th><th scope="col">Motif sans n°</th><th scope="col">Vendeur</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                        @if (attente is null) { <tr><td colspan="10"><Chargement /></td></tr> }
                        else
                        {
                            @foreach (var v in attente.Lignes)
                            {
                                var jours = Anciennete(v.Date);
                                <tr>
                                    <td>@v.Numero</td>
                                    <td>@Libelles.DateHeureLocale(v.Date)</td>
                                    <td class="@(v.EnRetard ? "texte-urgent" : null)">@(jours == 0 ? "aujourd’hui" : jours == 1 ? "1 jour" : $"{jours} jours")@(v.EnRetard ? " · en retard" : "")</td>
                                    <td>@(v.Patient ?? "—")@if (v.NumAssure is { } n) { <br /><span class="detail">@n</span> }</td>
                                    <td>@v.Organisme</td>
                                    <td class="nombre">@v.Total.ToString("N2")</td>
                                    <td class="nombre">@v.PartOrganisme.ToString("N2")</td>
                                    <td>@(v.Motif ?? "—")</td>
                                    <td>@v.Vendeur</td>
                                    <td>
                                        <button type="button" class="lien-bouton" @onclick="() => infos = (v.Id, v.Numero)">Infos Chifa</button>
                                        @if (Session.A("chifa.exclure")) { <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => exclusion = (v.Id, v.Numero)">Exclure du traitement</button> }
                                    </td>
                                </tr>
                            }
                            @if (attente.Lignes.Count == 0) { <tr><td colspan="10" class="vide">Aucune vente Chifa en attente de volet.</td></tr> }
                        }
                    </tbody>
                </table>
            }
            else if (onglet == "retours")
            {
                @* Retours avec part organisme (script 155) : à reporter dans CHIFA-Officine (facture signée), puis marquer « corrigé » *@
                <table class="tableau" style="min-width: 1000px">
                    <thead><tr><th scope="col">Vente</th><th scope="col">Retour</th><th scope="col">Patient</th><th scope="col">Facture Chifa</th><th scope="col">Produits rendus</th><th scope="col" class="nombre">Part organisme retirée</th><th scope="col">État</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                        @if (retours is null) { <tr><td colspan="8"><Chargement /></td></tr> }
                        else
                        {
                            @foreach (var r in retours.Lignes)
                            {
                                <tr>
                                    <td>@r.Numero<br /><span class="detail">@Libelles.DateHeureLocale(r.DateVente)</span></td>
                                    <td>@Libelles.DateHeureLocale(r.RetourLe)<br /><span class="detail">@r.RetourPar</span></td>
                                    <td>@(r.Patient ?? "—")@if (r.NumAssure is { } n) { <br /><span class="detail">@n</span> }</td>
                                    <td>@(r.FactureChifa ?? "—")</td>
                                    <td>@r.Produits</td>
                                    <td class="nombre">@r.PartOrganisme.ToString("N2")</td>
                                    <td>
                                        @if (r.CorrigeLe is { } le) { <span class="pastille ok">corrigé</span><br /><span class="detail">@Libelles.DateHeureLocale(le) · @r.CorrigePar</span> }
                                        else { <span class="pastille attention">à corriger</span> }
                                        @if (r.Deposee) { <br /><span class="detail texte-urgent">vente déposée depuis</span> }
                                    </td>
                                    <td>
                                        @if (r.CorrigeLe is null)
                                        {
                                            <button type="button" class="lien-bouton" disabled="@enCours" @onclick="() => MarquerCorrigeAsync(r)">Corrigé dans CHIFA-Officine</button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (retours.Lignes.Count == 0) { <tr><td colspan="8" class="vide">@(etatRetours == "a_corriger" ? "Aucun retour à corriger dans CHIFA-Officine." : "Aucun retour.")</td></tr> }
                        }
                    </tbody>
                </table>
            }
            else if (onglet is "ventes" or "exclues")
            {
                @* Ventes Chifa (informations Chifa) et ventes exclues du traitement (script 100) *@
                <table class="tableau" style="min-width: 1100px">
                    <thead><tr><th scope="col">Vente</th><th scope="col">Patient</th><th scope="col">Organisme · centre</th><th scope="col">Facture Chifa</th>
                        @if (onglet == "ventes") { <th scope="col">Date des soins</th><th scope="col">Saisi par</th><th scope="col" class="nombre">Part organisme</th> }
                        else { <th scope="col">Exclue le</th><th scope="col">Motif</th><th scope="col" class="nombre">Part organisme</th> }
                        <th scope="col">Actions</th></tr></thead>
                    <tbody>
                        @if (ventes is null) { <tr><td colspan="8"><Chargement /></td></tr> }
                        else
                        {
                            @foreach (var v in ventes.Lignes)
                            {
                                <tr>
                                    <td>@v.Numero<br /><span class="detail">@Libelles.DateHeureLocale(v.Date)@(v.Statut == "annulee" ? " · annulée" : "")</span></td>
                                    <td>@(v.Patient ?? "—")@if (v.NumAssure is { } n) { <br /><span class="detail">@n</span> }</td>
                                    <td>@(v.Organisme ?? "—")@if (v.CentrePayeur is { } c) { <br /><span class="detail">@c</span> }</td>
                                    <td>@(v.FactureChifa ?? "—")</td>
                                    @if (onglet == "ventes")
                                    {
                                        <td>@(v.DateSoins is { } d ? Libelles.Date(d) : "—")</td>
                                        <td>@(v.SaisiPar ?? v.Vendeur)</td>
                                    }
                                    else
                                    {
                                        <td>@(v.ExclueLe is { } le ? Libelles.DateHeureLocale(le) : "—")<br /><span class="detail">@v.ExcluePar</span></td>
                                        <td>@v.Exclusion</td>
                                    }
                                    <td class="nombre">@v.PartOrganismeTotale.ToString("N2")@if (v.MajorationMontant > 0) { <br /><span class="detail">dont majoration @v.MajorationMontant.ToString("N2")</span> }</td>
                                    <td>
                                        @if (v.Statut == "validee" && !v.DansBordereau)
                                        {
                                            @if (onglet == "ventes")
                                            {
                                                <button type="button" class="lien-bouton" @onclick="() => infos = (v.Id, v.Numero)">Infos Chifa</button>
                                                @if (Session.A("chifa.exclure")) { <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => exclusion = (v.Id, v.Numero)">Exclure du traitement</button> }
                                            }
                                            else if (Session.A("chifa.exclure"))
                                            {
                                                <button type="button" class="lien-bouton" disabled="@enCours" @onclick="() => RetablirAsync(v)">Rétablir</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            @if (ventes.Lignes.Count == 0) { <tr><td colspan="8" class="vide">@(onglet == "ventes" ? "Aucune vente Chifa." : "Aucune vente Chifa exclue du traitement.")</td></tr> }
                        }
                    </tbody>
                </table>
            }
            else
            {
                @* Volets avec écart : même cadre, pagination sous le cadre *@
                <table class="tableau" style="min-width: 1000px">
                    <thead><tr><th scope="col">Vente</th><th scope="col">Volet</th><th scope="col">Rattaché</th><th scope="col">Patient</th><th scope="col">Motif</th><th scope="col">Différences</th><th scope="col" class="nombre">Écart part organisme</th><th scope="col">Régularisation</th></tr></thead>
                    <tbody>
                        @if (ecarts is null) { <tr><td colspan="8"><Chargement /></td></tr> }
                        else
                        {
                            @foreach (var e in ecarts.Lignes)
                            {
                                <tr>
                                    <td>@e.Numero<br /><span class="detail">@Libelles.DateHeureLocale(e.DateVente)</span></td>
                                    <td>@e.NumeroFacture</td>
                                    <td>@(e.RattacheLe is { } le ? Libelles.DateHeureLocale(le) : "—")<br /><span class="detail">@e.RattachePar</span></td>
                                    <td>@(e.Patient ?? "—")</td>
                                    <td>@e.Motif</td>
                                    <td class="texte-urgent">@e.Detail</td>
                                    <td class="nombre">@(e.EcartPartOrganisme is { } x ? x.ToString("N2") : "—")</td>
                                    <td>@(e.Regularisation ?? "—")
                                        @* Trop-payé « à rendre » (D4) : rendu par le tiroir, bon lié à la régularisation *@
                                        @if (e.ARendre > 0)
                                        {
                                            @if (e.BonRendu is { } bon) { <br /><span class="pastille ok">rendu (bon @bon)</span> }
                                            else
                                            {
                                                <br /><span class="pastille attention">à rendre @Libelles.Dinars(e.ARendre, 2)</span>
                                                @if (e.PatientId is { } pid && Session.A("caisse.ouvrir_tiroir"))
                                                {
                                                    <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => Rembourser(e, pid)">Rembourser</button>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            @if (ecarts.Lignes.Count == 0) { <tr><td colspan="8" class="vide">Aucun volet rattaché avec écart.</td></tr> }
                        }
                    </tbody>
                </table>
            }
        </div>
        @if (onglet == "attente")
        {
            <Pagination Total="@(attente?.Total ?? 0)" Numero="@(attente?.Numero ?? 1)" Taille="taille" Occupe="enCours"
                        Libelle="Pages des ventes en attente de volet" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
        else if (onglet == "retours")
        {
            <Pagination Total="@(retours?.Total ?? 0)" Numero="@(retours?.Numero ?? 1)" Taille="taille" Occupe="enCours"
                        Libelle="Pages des retours à corriger" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
        else if (onglet is "ventes" or "exclues")
        {
            <Pagination Total="@(ventes?.Total ?? 0)" Numero="@(ventes?.Numero ?? 1)" Taille="taille" Occupe="enCours"
                        Libelle="Pages des ventes Chifa" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
        else
        {
            <Pagination Total="@(ecarts?.Total ?? 0)" Numero="@(ecarts?.Numero ?? 1)" Taille="taille" Occupe="enCours"
                        Libelle="Pages des volets avec écart" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
    </div>
</div>

@if (infos is { } inf)
{
    <FenetreInfosChifa VenteId="inf.Id" Numero="@inf.Numero" OnFerme="() => infos = null" OnEnregistre="ApresActionAsync" />
}
@if (exclusion is { } ex)
{
    <FenetreExclusionChifa VenteId="ex.Id" Numero="@ex.Numero" OnFerme="() => exclusion = null" OnExclue="ApresActionAsync" />
}

@code {
    private string onglet = "attente", recherche = "";
    private PageDto<VenteAttenteVoletDto>? attente;
    private PageDto<VoletAvecEcartDto>? ecarts;
    private PageDto<VenteChifaDto>? ventes;
    // Retours à corriger dans CHIFA-Officine (script 155) : état a_corriger (défaut), corriges, tous
    private PageDto<RetourACorrigerChifaDto>? retours;
    private string etatRetours = "a_corriger";
    private string? message;
    private List<CentrePayeurDto> centres = [];
    private long? centreId;
    private (long Id, string Numero)? infos, exclusion;
    private int taille = Pagination.TailleParDefaut;
    private bool enCours;
    private string? erreur;

    private int? NumeroCourant => onglet switch { "attente" => attente?.Numero, "ecart" => ecarts?.Numero, "retours" => retours?.Numero, _ => ventes?.Numero };

    /// <summary>« Corrigé dans CHIFA-Officine » : la facture signée a été corrigée dans le logiciel de la CNAS ; date et auteur gardés, journalisé.</summary>
    private async Task MarquerCorrigeAsync(RetourACorrigerChifaDto r)
    {
        (enCours, message) = (true, null);
        erreur = await Api.MarquerRetourCorrigeChifaAsync(r.RetourId);
        enCours = false;
        if (erreur is null)
        {
            message = $"Retour de la vente {r.Numero} marqué corrigé dans CHIFA-Officine.";
            await ChargerAsync(NumeroCourant ?? 1, taille);
        }
    }

    private async Task ApresActionAsync()
    {
        (infos, exclusion) = (null, null);
        await ChargerAsync(NumeroCourant ?? 1, taille);
    }

    /// <summary>« Rétablir » : la vente revient dans le traitement Chifa (en attente de volet si elle n'en a pas) ; journalisé.</summary>
    private async Task RetablirAsync(VenteChifaDto v)
    {
        enCours = true;
        erreur = await Api.RetablirVenteChifaAsync(v.Id);
        enCours = false;
        if (erreur is null) await ChargerAsync(NumeroCourant ?? 1, taille);
    }

    protected override Task OnInitializedAsync()
    {
        Historique.Suivre("chifa", e => { e.Mettre("onglet", onglet); e.Mettre("texte", recherche); e.Mettre("page", NumeroCourant ?? 1); e.Mettre("taille", taille); e.Mettre("etat", etatRetours); });
        var numero = 1;
        if (Historique.Restaurer("chifa") is { } h)
        {
            (onglet, recherche, numero, taille) = (h.Texte("onglet") is "ecart" or "ventes" or "exclues" or "retours" ? h.Texte("onglet")! : "attente", h.Texte("texte") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
            etatRetours = h.Texte("etat") is "corriges" or "tous" ? h.Texte("etat")! : "a_corriger";
        }
        return ChargerAsync(numero, taille);
    }

    private Task ChoisirAsync(string o)
    {
        if (o == onglet) return Task.CompletedTask;
        (onglet, message) = (o, null);
        return ChargerAsync(1, taille);
    }

    private async Task ChargerAsync(int numero, int t)
    {
        enCours = true;
        taille = t;
        var q = recherche.Trim() == "" ? null : recherche.Trim();
        if (onglet == "attente") (attente, erreur) = await Api.VentesAttenteVoletAsync(q, numero, t);
        else if (onglet == "ecart") (ecarts, erreur) = await Api.VoletsAvecEcartAsync(q, numero, t);
        else if (onglet == "retours") (retours, erreur) = await Api.RetoursACorrigerChifaAsync(q, etatRetours, numero, t);
        else
        {
            if (centres.Count == 0)
            {
                var (c, _) = await Api.CentresPayeursAsync(null, null, null, 1, 200);
                centres = c?.Lignes.ToList() ?? [];
            }
            (ventes, erreur) = await Api.VentesChifaAsync(q, centreId, onglet == "exclues" ? "oui" : "non", numero, t);
        }
        enCours = false;
    }

    /// <summary>« Rembourser » : la caisse s'ouvre avec la sortie « Remboursement d'un client » pré-remplie et liée à la régularisation.</summary>
    private void Rembourser(VoletAvecEcartDto e, long patientId)
    {
        Remboursements.Deposer(new RemboursementsTiroir.Demande(e.VenteId, e.Numero, patientId, e.Patient ?? "Patient", e.ARendre));
        Nav.NavigateTo("caisse");
    }

    private static int Anciennete(DateTime date) =>
        Math.Max(0, DateOnly.FromDateTime(DateTime.Now).DayNumber - DateOnly.FromDateTime(date.Kind == DateTimeKind.Utc ? date.ToLocalTime() : date).DayNumber);
}
