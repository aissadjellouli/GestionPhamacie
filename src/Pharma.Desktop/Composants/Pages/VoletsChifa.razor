@page "/chifa"
@inject ApiClient Api
@inject HistoriqueNavigation Historique
@inject SessionPoste Session
@inject RemboursementsTiroir Remboursements
@inject NavigationManager Nav

@* Circuit « la caisse d'abord » (règle du titulaire, 2026-11-15) : ventes Chifa encaissées qui attendent leur volet (ancienneté), et
   volets rattachés malgré des différences (motif, différences, écart de part organisme). Listes filtrées et paginées par le serveur ;
   écran fixe, seul le tableau défile. Le rattachement se fait à la caisse, en scannant le QR du volet. *@
<div class="page avec-menu">
    <NavDomaine Libelle="Écrans des finances" />
    <div class="contenu-rubrique">
        <div class="titre-page">
            <div>
                <h1>Chifa</h1>
                <p class="sous-titre">Ventes encaissées en attente de leur volet Chifa, volets rattachés avec écart. Pour rattacher un volet : scannez son QR à la caisse, panier vide.</p>
            </div>
        </div>

        <div class="filtres" role="tablist" aria-label="Listes Chifa">
            <button type="button" role="tab" class="puce" aria-selected="@(onglet == "attente" ? "true" : "false")" @onclick="@(() => ChoisirAsync("attente"))">Ventes en attente de volet</button>
            <button type="button" role="tab" class="puce" aria-selected="@(onglet == "ecart" ? "true" : "false")" @onclick="@(() => ChoisirAsync("ecart"))">Volets avec écart</button>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

        <div class="filtres-liste" role="search" aria-label="Filtrer la liste">
            <div class="champ" style="flex: 1 1 260px"><label for="vc-q">N° de vente, patient ou n° d’assuré@(onglet == "ecart" ? ", n° de facture Chifa" : "")</label>
                <input id="vc-q" data-champ="recherche" type="search" autocomplete="off" @bind="recherche" @bind:event="oninput" @bind:after="() => ChargerAsync(1, taille)" /></div>
        </div>

        <div class="tableau-cadre">
            @if (onglet == "attente")
            {
                <table class="tableau" style="min-width: 900px">
                    <thead><tr><th scope="col">Vente</th><th scope="col">Encaissée le</th><th scope="col">Ancienneté</th><th scope="col">Patient</th><th scope="col">Organisme</th><th scope="col" class="nombre">Total</th><th scope="col" class="nombre">Part organisme</th><th scope="col">Motif sans n°</th><th scope="col">Vendeur</th></tr></thead>
                    <tbody>
                        @if (attente is null) { <tr><td colspan="9"><Chargement /></td></tr> }
                        else
                        {
                            @foreach (var v in attente.Lignes)
                            {
                                var jours = Anciennete(v.Date);
                                <tr>
                                    <td>@v.Numero</td>
                                    <td>@Libelles.DateHeureLocale(v.Date)</td>
                                    <td class="@(v.EnRetard ? "texte-urgent" : null)">@(jours == 0 ? "aujourd’hui" : jours == 1 ? "1 jour" : $"{jours} jours")@(v.EnRetard ? " · en retard" : "")</td>
                                    <td>@(v.Patient ?? "—")@if (v.NumAssure is { } n) { <br /><span class="detail">@n</span> }</td>
                                    <td>@v.Organisme</td>
                                    <td class="nombre">@v.Total.ToString("N2")</td>
                                    <td class="nombre">@v.PartOrganisme.ToString("N2")</td>
                                    <td>@(v.Motif ?? "—")</td>
                                    <td>@v.Vendeur</td>
                                </tr>
                            }
                            @if (attente.Lignes.Count == 0) { <tr><td colspan="9" class="vide">Aucune vente Chifa en attente de volet.</td></tr> }
                        }
                    </tbody>
                </table>
            }
            else
            {
                @* Volets avec écart : même cadre, pagination sous le cadre *@
                <table class="tableau" style="min-width: 1000px">
                    <thead><tr><th scope="col">Vente</th><th scope="col">Volet</th><th scope="col">Rattaché</th><th scope="col">Patient</th><th scope="col">Motif</th><th scope="col">Différences</th><th scope="col" class="nombre">Écart part organisme</th><th scope="col">Régularisation</th></tr></thead>
                    <tbody>
                        @if (ecarts is null) { <tr><td colspan="8"><Chargement /></td></tr> }
                        else
                        {
                            @foreach (var e in ecarts.Lignes)
                            {
                                <tr>
                                    <td>@e.Numero<br /><span class="detail">@Libelles.DateHeureLocale(e.DateVente)</span></td>
                                    <td>@e.NumeroFacture</td>
                                    <td>@(e.RattacheLe is { } le ? Libelles.DateHeureLocale(le) : "—")<br /><span class="detail">@e.RattachePar</span></td>
                                    <td>@(e.Patient ?? "—")</td>
                                    <td>@e.Motif</td>
                                    <td class="texte-urgent">@e.Detail</td>
                                    <td class="nombre">@(e.EcartPartOrganisme is { } x ? x.ToString("N2") : "—")</td>
                                    <td>@(e.Regularisation ?? "—")
                                        @* Trop-payé « à rendre » (D4) : rendu par le tiroir, bon lié à la régularisation *@
                                        @if (e.ARendre > 0)
                                        {
                                            @if (e.BonRendu is { } bon) { <br /><span class="pastille ok">rendu (bon @bon)</span> }
                                            else
                                            {
                                                <br /><span class="pastille attention">à rendre @Libelles.Dinars(e.ARendre, 2)</span>
                                                @if (e.PatientId is { } pid && Session.A("caisse.ouvrir_tiroir"))
                                                {
                                                    <button type="button" class="lien-bouton" style="margin-left: 8px" @onclick="() => Rembourser(e, pid)">Rembourser</button>
                                                }
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            @if (ecarts.Lignes.Count == 0) { <tr><td colspan="8" class="vide">Aucun volet rattaché avec écart.</td></tr> }
                        }
                    </tbody>
                </table>
            }
        </div>
        @if (onglet == "attente")
        {
            <Pagination Total="@(attente?.Total ?? 0)" Numero="@(attente?.Numero ?? 1)" Taille="taille" Occupe="enCours"
                        Libelle="Pages des ventes en attente de volet" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
        else
        {
            <Pagination Total="@(ecarts?.Total ?? 0)" Numero="@(ecarts?.Numero ?? 1)" Taille="taille" Occupe="enCours"
                        Libelle="Pages des volets avec écart" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
        }
    </div>
</div>

@code {
    private string onglet = "attente", recherche = "";
    private PageDto<VenteAttenteVoletDto>? attente;
    private PageDto<VoletAvecEcartDto>? ecarts;
    private int taille = Pagination.TailleParDefaut;
    private bool enCours;
    private string? erreur;

    protected override Task OnInitializedAsync()
    {
        Historique.Suivre("chifa", e => { e.Mettre("onglet", onglet); e.Mettre("texte", recherche); e.Mettre("page", (onglet == "attente" ? attente?.Numero : ecarts?.Numero) ?? 1); e.Mettre("taille", taille); });
        var numero = 1;
        if (Historique.Restaurer("chifa") is { } h)
            (onglet, recherche, numero, taille) = (h.Texte("onglet") is "ecart" ? "ecart" : "attente", h.Texte("texte") ?? "", h.Entier("page") ?? 1, h.Entier("taille") ?? taille);
        return ChargerAsync(numero, taille);
    }

    private Task ChoisirAsync(string o)
    {
        if (o == onglet) return Task.CompletedTask;
        onglet = o;
        return ChargerAsync(1, taille);
    }

    private async Task ChargerAsync(int numero, int t)
    {
        enCours = true;
        taille = t;
        var q = recherche.Trim() == "" ? null : recherche.Trim();
        if (onglet == "attente") (attente, erreur) = await Api.VentesAttenteVoletAsync(q, numero, t);
        else (ecarts, erreur) = await Api.VoletsAvecEcartAsync(q, numero, t);
        enCours = false;
    }

    /// <summary>« Rembourser » : la caisse s'ouvre avec la sortie « Remboursement d'un client » pré-remplie et liée à la régularisation.</summary>
    private void Rembourser(VoletAvecEcartDto e, long patientId)
    {
        Remboursements.Deposer(new RemboursementsTiroir.Demande(e.VenteId, e.Numero, patientId, e.Patient ?? "Patient", e.ARendre));
        Nav.NavigateTo("caisse");
    }

    private static int Anciennete(DateTime date) =>
        Math.Max(0, DateOnly.FromDateTime(DateTime.Now).DayNumber - DateOnly.FromDateTime(date.Kind == DateTimeKind.Utc ? date.ToLocalTime() : date).DayNumber);
}
