@page "/stock"
@inject ApiClient Api
@inject SessionPoste Session
@inject HistoriqueNavigation Historique
@inject NavigationManager Nav

@* Écran fixe : menu vertical à gauche ; le tableau des produits défile dans son cadre. Rubrique dans l'adresse (stock?rubrique=…) *@
<div class="page avec-menu">
    <nav class="nav-laterale" aria-label="Rubriques du stock">
        @foreach (var r in Rubriques.Where(r => r.Permis))
        {
            <a href="@($"stock?rubrique={r.Id}")" class="@(r.Id == rubrique ? "active" : null)" aria-current="@(r.Id == rubrique ? "page" : null)">@r.Libelle</a>
        }
        <span class="nav-groupe-titre">Autres écrans du stock</span>
        <a href="tracabilite" class="sous-rubrique">Traçabilité et rappel de lot</a>
        @if (Session.A("psychotropes.registre")) { <a href="stock/registre" class="sous-rubrique">Registre des psychotropes</a> }
        <a href="inventaire" class="sous-rubrique">Inventaire</a>
        <a href="achats?onglet=etiquettes" class="sous-rubrique">Imprimer des étiquettes</a>
        @if (etat is not null)
        {
            <div class="nav-resume"><span class="detail">Valeur du stock</span><strong>@Libelles.Dinars(etat.Indicateurs.ValeurAchat)</strong></div>
        }
    </nav>

    <div class="contenu-rubrique">
    <div class="titre-page">
        <div>
            <h1>Stock · @RubriqueCourante.Libelle</h1>
            <p class="sous-titre">@RubriqueCourante.SousTitre</p>
        </div>
    </div>

    @if (rubrique == "nouveau")
    {
        <FicheNouveauProduit OnCree="ProduitCreeAsync" OnAnnule="@(() => Nav.NavigateTo("stock"))" />
    }
    @if (messageCreation is not null)
    {
        <div class="succes" role="status">@messageCreation</div>
    }
    @if (erreurRangement is not null)
    {
        <div class="erreur" role="alert">@erreurRangement</div>
    }

    @if (erreur is not null)
    {
        <div class="erreur" role="alert">@erreur</div>
    }
    else if (etat is null)
    {
        <Chargement Texte="Chargement du stock…" />
    }
    else if (rubrique == "ensemble")
    {
        <section class="tuiles" aria-label="Indicateurs">
            <div class="tuile">
                <span class="tuile-libelle">Références en stock</span>
                <span class="tuile-valeur petite">@etat.Indicateurs.ReferencesEnStock.ToString("N0")</span>
            </div>
            <div class="tuile">
                <span class="tuile-libelle">Valeur du stock (prix d’achat)</span>
                <span class="tuile-valeur petite">@Libelles.Dinars(etat.Indicateurs.ValeurAchat)</span>
                <span class="tuile-note">hors lots périmés</span>
            </div>
            <div class="tuile">
                <span class="tuile-libelle">Lots à date à vérifier</span>
                <span class="tuile-valeur petite @(etat.Indicateurs.LotsDateAVerifier > 0 ? "attention" : null)">@etat.Indicateurs.LotsDateAVerifier</span>
                <span class="tuile-note">issus de l’ancien logiciel</span>
            </div>
        </section>
    }
    else if (rubrique == "produits")
    {
        <div class="filtres-liste" role="search" aria-label="Filtrer les produits">
            <div class="champ" style="flex: 999 1 320px">
                <label for="rech">Rechercher (nom, DCI, code-barres, lot)</label>
                @* Aide à la saisie : propositions du stock (noms, DCI, lots, emplacements) dès 2 caractères *@
                <input id="rech" type="search" list="stock-suggestions" autocomplete="off" placeholder="Ex. amlodipine" data-champ="q"
                       value="@recherche" @oninput="RechercheSaisieAsync" />
                <datalist id="stock-suggestions">
                    @foreach (var s in etat.Suggestions) { <option value="@s"></option> }
                </datalist>
            </div>
            <div class="champ" style="flex: 0 0 200px">
                <label for="f-rayon">Rayon</label>
                <select id="f-rayon" class="selection" data-champ="rayon" @bind="rayon" @bind:after="FiltrerAsync">
                    <option value="">Tous les rayons</option>
                    <option value="-">Non rangés</option>
                    @foreach (var r in emplacements.Where(e => e.Zone == "vente").GroupBy(e => e.Rayon))
                    {
                        <option value="@r.Key">Rayon @r.Key</option>
                    }
                </select>
            </div>
            <div class="filtres" role="group" aria-label="Filtrer">
                @foreach (var (id, libelle) in Filtres)
                {
                    <button type="button" class="puce" aria-pressed="@(id == filtre ? "true" : "false")"
                            @onclick="() => ChoisirFiltreAsync(id)">@libelle</button>
                }
            </div>
            @if (FiltreActif) { <button type="button" class="btn" @onclick="ToutAfficherAsync">Tout afficher</button> }
        </div>

        <section class="tableau-cadre" aria-label="Liste des produits">
            <table class="tableau">
                <thead>
                    <tr>
                        <th scope="col">Produit</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Couverture</th>
                        <th scope="col">1re péremption</th>
                        <th scope="col">Grossistes</th>
                        <th scope="col">Emplacement</th>
                        <th scope="col">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @* Une page à la fois, filtrée par le serveur : l’écran reste fluide avec des milliers de produits *@
                    @foreach (var l in lignes)
                    {
                        <tr>
                            <td>
                                <span class="nom">@l.NomCommercial</span><br />
                                <span class="detail">@Detail(l)</span>
                            </td>
                            <td>@l.Stock</td>
                            <td>@Couverture(l)</td>
                            <td>@(l.PremierePeremption is { } d ? Libelles.MoisAnnee(d) : "—")</td>
                            <td>@(l.Grossistes.Count > 0 ? string.Join(", ", l.Grossistes) : "—")</td>
                            <td>
                                @if (enRangement == l.ProduitId)
                                {
                                    <div style="display: flex; flex-direction: column; gap: 6px; min-width: 200px">
                                        <select class="selection" aria-label="Emplacement de vente de @l.NomCommercial" @bind="choixVente">
                                            <option value="0">Non rangé</option>
                                            @foreach (var e in emplacements.Where(e => e.Zone == "vente" && e.Actif)) { <option value="@e.Id">@e.Code@(e.Libelle is null ? "" : $" · {e.Libelle}")</option> }
                                        </select>
                                        <select class="selection" aria-label="Réserve de @l.NomCommercial" @bind="choixReserve">
                                            <option value="0">Pas de réserve</option>
                                            @foreach (var e in emplacements.Where(e => e.Zone == "reserve" && e.Actif)) { <option value="@e.Id">@e.Code@(e.Libelle is null ? "" : $" · {e.Libelle}")</option> }
                                        </select>
                                        <div style="display: flex; gap: 6px">
                                            <button type="button" class="btn btn-principal" @onclick="() => RangerAsync(l)">Enregistrer</button>
                                            <button type="button" class="btn" @onclick="() => enRangement = null">Annuler</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @if (l.Emplacement is not null) { <span class="code-emplacement">@l.Emplacement</span> } else { <span class="detail">non rangé</span> }
                                    @if (l.Reserve is not null) { <br /><span class="detail">réserve @l.Reserve</span> }
                                    @if (Session.A("stock.ajuster"))
                                    {
                                        <br /><button type="button" class="lien" @onclick="() => OuvrirRangement(l)">Ranger</button>
                                    }
                                }
                            </td>
                            <td><span class="pastille @Libelles.ClasseStatutStock(l.Statut)">@Libelles.StatutStock(l.Statut)</span></td>
                        </tr>
                    }
                    @if (lignes.Count == 0)
                    {
                        <tr><td colspan="7" class="vide">@(FiltreActif ? "Aucun produit pour ces filtres." : "Aucun produit en stock.")</td></tr>
                    }
                </tbody>
            </table>
        </section>
        <Pagination Total="total" Numero="page" Taille="taille" Libelle="Pages du stock" OnChange="p => ChargerAsync(p.Numero, p.Taille)" />
    }

    @if (rubrique == "modifier") { <ModificationProduit /> }
    @if (rubrique == "sortie") { <SortieStock LotInitial="Sortie" /> }
    @if (rubrique == "blocage") { <BlocageProduits /> }
    </div>
</div>

@code {
    /// <summary>Lot à sortir du stock, proposé depuis l'alerte « Retirer du stock ».</summary>
    [SupplyParameterFromQuery(Name = "sortie")] public long? Sortie { get; set; }
    /// <summary>Produit à ranger, proposé depuis l'alerte « Mettre en avant » (stock dormant).</summary>
    [SupplyParameterFromQuery(Name = "ranger")] public long? Ranger { get; set; }
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }

    private sealed record RubriqueStock(string Id, string Libelle, string SousTitre, bool Permis = true);
    private RubriqueStock[] Rubriques =>
    [
        new("produits", "Produits", "Par produit, avec lots, péremptions, grossistes et emplacement"),
        new("ensemble", "Vue d’ensemble", "Références, valeur du stock et lots à date à vérifier"),
        new("nouveau", "Nouveau produit", "Ajouter un produit au catalogue", Session.A("catalogue.creer")),
        new("modifier", "Modifier un produit", "Nom, DCI, dosage, forme, code-barres, prix, TVA, remboursement, activation", Session.A("catalogue.creer")),
        new("sortie", "Sortie de stock", "Périmés, boîtes cassées, dons et échantillons"),
        new("blocage", "Blocage des produits", "Produits bloqués à l’achat ou à la vente")
    ];
    private string rubrique = "produits";
    private RubriqueStock RubriqueCourante => Rubriques.First(r => r.Id == rubrique);

    protected override void OnParametersSet()
    {
        // Lot à sortir (depuis une alerte) : rubrique Sortie ; produit à ranger : rubrique Produits
        var voulue = Rubrique ?? (Sortie is not null ? "sortie" : "produits");
        var avant = rubrique;
        rubrique = Rubriques.FirstOrDefault(r => r.Id == voulue && r.Permis)?.Id ?? "produits";
        if (avant != rubrique) (messageCreation, erreurRangement) = (null, null);
    }

    // Tableau paginé et filtré par le serveur (recherche, filtre, rayon), comme les autres listes ; la recherche propose
    // des valeurs du stock pendant la saisie (noms, DCI, lots, emplacements)
    private StockPageDto? etat;
    private List<LigneStockDto> lignes = [];
    private int total, page = 1, taille = Pagination.TailleParDefaut;
    private string? erreur;
    private string recherche = "";
    private string filtre = "tous";
    private bool FiltreActif => recherche.Trim().Length > 0 || filtre != "tous" || rayon != "";
    private int requeteRecherche;
    // ---- Emplacements ----
    private List<EmplacementDto> emplacements = [];
    private string rayon = "";
    private long? enRangement;
    private long choixVente, choixReserve;
    private string? erreurRangement;

    private async Task ChargerAsync(int numero, int nouvelleTaille)
    {
        var (p, e) = await Api.StockPageAsync(numero, nouvelleTaille, recherche.Trim(), filtre, rayon);
        if (e is not null) { erreur = e; return; }
        // Page au-delà de la fin (filtre plus étroit, produit sorti) : retour à la première
        if (p!.Page.Lignes.Count == 0 && numero > 1) { await ChargerAsync(1, nouvelleTaille); return; }
        (etat, lignes, total, page, taille, erreur) = (p, p.Page.Lignes.ToList(), p.Page.Total, p.Page.Numero, p.Page.Taille, null);
    }

    private Task FiltrerAsync() => ChargerAsync(1, taille);
    private Task ChoisirFiltreAsync(string id) { filtre = id; return FiltrerAsync(); }
    private Task ToutAfficherAsync() { (recherche, filtre, rayon) = ("", "tous", ""); return FiltrerAsync(); }

    /// <summary>Saisie de la recherche : rechargement après une courte pause (pas à chaque touche).</summary>
    private async Task RechercheSaisieAsync(ChangeEventArgs e)
    {
        recherche = e.Value?.ToString() ?? "";
        var n = ++requeteRecherche;
        await Task.Delay(250);
        if (n == requeteRecherche) await FiltrerAsync();
    }

    private void OuvrirRangement(LigneStockDto l) =>
        (enRangement, choixVente, choixReserve) = (l.ProduitId, l.EmplacementId ?? 0, l.ReserveId ?? 0);

    private async Task RangerAsync(LigneStockDto l)
    {
        var e = await Api.RangerProduitAsync(l.ProduitId, choixVente == 0 ? null : choixVente, choixReserve == 0 ? null : choixReserve);
        if (e is not null) { erreurRangement = e; return; }
        (enRangement, messageCreation, erreurRangement) = (null, $"« {l.NomCommercial} » rangé.", null);
        await ChargerAsync(page, taille);
        (emplacements, _) = await Api.EmplacementsAsync();
    }

    private string? messageCreation;

    private async Task ProduitCreeAsync((long Id, string Nom) p)
    {
        messageCreation = ($"« {p.Nom} » ajouté au catalogue. Il sera vendable après sa première réception (Achats, Réceptions).");
        await ChargerAsync(page, taille);
        (emplacements, _) = await Api.EmplacementsAsync();
    }

    private static readonly (string, string)[] Filtres =
        [("tous", "Tous"), ("commander", "À commander"), ("peremption", "Péremption proche"), ("psychotropes", "Psychotropes")];

    protected override async Task OnInitializedAsync()
    {
        // « ← Retour » : recherche, filtre, rayon et page retrouvés tels qu'ils étaient
        Historique.Suivre("stock", e =>
        {
            e.Mettre("recherche", recherche); e.Mettre("filtre", filtre); e.Mettre("rayon", rayon); e.Mettre("page", page); e.Mettre("taille", taille);
        });
        var r = Historique.Restaurer("stock");
        if (r is not null) (recherche, filtre, rayon) = (r.Texte("recherche") ?? "", r.Texte("filtre") ?? "tous", r.Texte("rayon") ?? "");
        var lieux = Api.EmplacementsAsync();
        await ChargerAsync(r?.Entier("page") ?? 1, r?.Entier("taille") ?? taille);
        (emplacements, _) = await lieux;
        // Depuis l'alerte : le produit est cherché et son rangement ouvert
        if (Ranger is { } id && (await Api.StockAsync()).Item1?.Lignes.FirstOrDefault(l => l.ProduitId == id) is { } produit)
        {
            (recherche, filtre, rayon) = (produit.NomCommercial, "tous", "");
            await FiltrerAsync();
            if (lignes.FirstOrDefault(l => l.ProduitId == id) is { } ligne) OuvrirRangement(ligne);
        }
    }

    private static string Detail(LigneStockDto l)
    {
        var lots = l.NombreLots switch { 0 => "aucun lot", 1 => "1 lot", var n => $"{n} lots" };
        var registre = Libelles.EstSousRegistre(l.Classe) ? " · registre" : "";
        return $"{l.Dci ?? "DCI non renseignée"} · {lots}{registre}";
    }

    private static string Couverture(LigneStockDto l) =>
        l.CouvertureJours is { } j ? $"{j} j" : l.Stock > 0 ? "aucune vente" : "—";
}
