@page "/admin/sauvegardes"
@inject ApiClient Api
@inject HistoriqueNavigation Historique

<div class="page admin">
    <NavAdmin Actif="admin/sauvegardes" Rubrique="@Rubrique" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Sauvegardes · @NavAdmin.Libelle("admin/sauvegardes", Rubrique)</h1>
                <p class="sous-titre">Copie quotidienne de la base sur un disque externe ; le titulaire est prévenu par SMS en cas de problème.</p>
            </div>
            <div class="actions">
                <button type="button" class="btn" disabled="@(r is null || enCours)" @onclick="LancerAsync">Sauvegarder maintenant</button>
                <button type="button" class="btn btn-principal" disabled="@(r is null || enCours)" @onclick="EnregistrerAsync">Enregistrer</button>
            </div>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (r is not null)
        {
            @if (rubrique == "reglages")
            {
            @if (baseSauvegardee is not null)
            {
                <div class="info-bandeau" role="status">Base de données sauvegardée : <strong>@baseSauvegardee</strong>@(serveurBase is { } sv ? $" · serveur {sv}" : "")</div>
            }
            @if (sansDisqueEnRetard)
            {
                <div class="bandeau-attention" role="status">Aucune sauvegarde réussie sur le disque externe depuis plus de @alerteSansDisqueEnregistree jour(s) : branchez le disque de sauvegarde. Le titulaire est prévenu.</div>
            }
            <section class="panneau" aria-labelledby="t-reg">
                <h2 id="t-reg">Réglages</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 2 1 280px"><label for="s-dossier" class="@(r.Actif ? "requis" : null)">Dossier sur le disque externe</label><input id="s-dossier" data-champ="dossier" type="text" placeholder="ex. E:\SauvegardesPharmacie" @ref="champDossier" @bind="r.Dossier" @bind:event="oninput"
                        class="@Obligatoire.Classe(DossierManque)" aria-invalid="@Obligatoire.Aria(DossierManque)" /></div>
                    <div class="champ" style="flex: 0 0 150px"><label for="s-heure">Heure</label><input id="s-heure" type="time" @bind="r.Heure" /></div>
                    <div class="champ" style="flex: 0 0 200px"><label for="s-garde">Sauvegardes conservées</label><input id="s-garde" data-champ="conservation" type="number" min="1" max="365" @bind="r.Conservation" /></div>
                </div>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 260px"><label for="s-ged-jours">Copie de la base dans la GED : gardée (jours)</label>
                        <input id="s-ged-jours" data-champ="retention_ged" type="number" min="1" max="365" placeholder="@($"{retentionParDefaut} (réglage du serveur)")" @bind="r.RetentionGedJours" /></div>
                    <div class="champ" style="flex: 1 1 260px"><label for="s-ged-ans">Nettoyage de la GED : documents de plus de (années)</label>
                        <input id="s-ged-ans" data-champ="nettoyage_ged" type="number" min="1" max="100" placeholder="jamais (la GED est gardée)" @bind="r.NettoyageGedAnnees" /></div>
                    <div class="champ" style="flex: 1 1 260px"><label for="s-sans-disque">Alerte si aucune sauvegarde sur le disque depuis (jours)</label>
                        <input id="s-sans-disque" data-champ="alerte_sans_disque" type="number" min="1" max="90" @bind="r.AlerteSansDisqueJours" /></div>
                </div>
                <label class="case"><input type="checkbox" @bind="r.Actif" /><span>Sauvegarde automatique chaque jour</span></label>
                <p class="detail" style="margin: 0">Chaque sauvegarde copie la base sur le disque externe et dans la GED du serveur@(dossierGed is { } dg ? $" ({dg}\\Sauvegardes)" : ""), et les documents de la GED (ordonnances, factures, rapports…) sur le disque externe, dans son dossier GED.</p>
                <p class="detail" style="margin: 0">Format pg_dump (restauration avec pg_restore). Dernière sauvegarde automatique : @(derniere is { } d ? Libelles.Date(d) : "jamais") · dernière sauvegarde réussie sur le disque : @(derniereReussie is { } dr ? Libelles.DateHeureLocale(dr) : "aucune").</p>
                <p class="detail" style="margin: 0">Sans 2e serveur : deux disques externes en rotation, dont un toujours hors de l’officine (obligatoire). Le titulaire est prévenu si aucune sauvegarde n’a réussi sur le disque pendant le délai réglé, même sauvegarde automatique désactivée.</p>
            </section>
            }
        }

        @if (rubrique == "secours" && secours is not null)
        {
        @* PC de secours (2026-11-16) : seconde copie vérifiée de chaque sauvegarde réussie, gardée dans l'officine, non chiffrée *@
        @if (secours.EnRetard)
        {
            <div class="bandeau-attention" role="status">La dernière copie de secours a plus de @secours.AlerteHeures h : vérifiez le second emplacement. Le titulaire est prévenu.</div>
        }
        <section class="panneau" aria-labelledby="t-secours">
            <h2 id="t-secours">Copie de secours (PC de secours, clé USB, autre disque)</h2>
            <div class="achats-ligne">
                <div class="champ" style="flex: 2 1 320px"><label for="s-secours">Second emplacement</label>
                    <input id="s-secours" data-champ="dossier_secours" type="text" placeholder="ex. F:\CopieSecours ou \\PC-SECOURS\Sauvegardes" @bind="dossierSecours" @bind:event="oninput" /></div>
                <div class="champ" style="flex: 0 0 240px"><label for="s-alerte">Alerte si la dernière copie a plus de (heures)</label>
                    <input id="s-alerte" data-champ="alerte_heures" type="number" min="1" max="720" @bind="alerteHeures" /></div>
            </div>
            <p class="detail" style="margin: 0">Après chaque sauvegarde réussie, le fichier est copié à cet emplacement, puis vérifié (taille et empreinte SHA-256) ; vide : pas de copie de secours. Les copies restent dans l’officine.</p>
            <p class="detail" style="margin: 0">Dernière copie : @(secours.DerniereCopie is { } dc ? $"{Libelles.DateHeureLocale(dc)} · {secours.Fichier}" : "aucune")@(secours.Sha256 is { } h ? $" · SHA-256 {h[..Math.Min(16, h.Length)]}…" : "")</p>
            @if (secours.DernierEchec is { } de)
            {
                <p class="detail" style="margin: 0">Dernier échec : @Libelles.DateHeureLocale(de) · @secours.MessageEchec</p>
            }
            <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center">
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerSecoursAsync">Enregistrer l’emplacement</button>
                <button type="button" class="btn" disabled="@(enCours || secours.DerniereCopie is null)" @onclick="TesterRestaurationAsync">Tester la restauration de la dernière copie</button>
                <span class="detail">Réservé au titulaire : restauration dans une base temporaire, vérifiée puis supprimée ; la base en service n’est pas touchée.</span>
            </div>
            <p class="detail" style="margin: 0">Dernier test : @(secours.DernierTest is { } dt ? $"{Libelles.DateHeureLocale(dt)} · {(secours.DernierTestReussi == true ? "réussi" : "échoué")} · {secours.MessageTest}" : "jamais")</p>
            <p class="detail" style="margin: 0">PC serveur en panne : procédure « PC serveur en panne » de docs/mise-en-production.md (script scripts\basculer-pc-secours.ps1 sur le PC de secours).</p>
        </section>
        }

        @if (rubrique == "journal")
        {
        @* Journal complet, filtré et paginé par le serveur (règle des listes) *@
        <div class="filtres-liste" role="search" aria-label="Filtrer le journal des sauvegardes">
            <div class="champ" style="flex: 0 0 200px"><label for="fj-statut">Résultat</label>
                <select id="fj-statut" @bind="fStatut" @bind:after="PremierePageAsync">
                    <option value="">Tous</option>
                    <option value="reussie">Réussie</option>
                    <option value="echouee">Échouée</option>
                    <option value="disque_absent">Disque absent</option>
                </select></div>
            <div class="champ" style="flex: 0 0 160px"><label for="fj-du">Du</label><input id="fj-du" type="date" @bind="fDu" @bind:after="PremierePageAsync" /></div>
            <div class="champ" style="flex: 0 0 160px"><label for="fj-au">Au</label><input id="fj-au" type="date" @bind="fAu" @bind:after="PremierePageAsync" /></div>
            @if (FiltreActif) { <button type="button" class="btn" @onclick="ToutAfficherAsync">Tout afficher</button> }
        </div>
        <section class="tableau-cadre" aria-label="Journal des sauvegardes">
            <table class="tableau" style="min-width: 760px">
                <thead><tr><th scope="col">Date</th><th scope="col">Déclenchement</th><th scope="col">Résultat</th><th scope="col">Fichier</th><th scope="col">Détail</th></tr></thead>
                <tbody>
                    @foreach (var j in journal)
                    {
                        <tr>
                            <td>@Libelles.DateHeureLocale(j.Debut)</td>
                            <td>@(j.Declenchement == "manuel" ? $"Manuel{(j.Utilisateur is null ? "" : $" · {j.Utilisateur}")}" : "Automatique")</td>
                            <td><span class="pastille @(j.Statut == "reussie" ? "ok" : "urgent")">@(j.Statut switch { "reussie" => "Réussie", "disque_absent" => "Disque absent", _ => "Échouée" })</span></td>
                            <td class="detail">@(j.Fichier ?? "—")</td>
                            <td class="detail">@j.Message</td>
                        </tr>
                    }
                    @if (journal.Count == 0) { <tr><td colspan="5" class="vide">@(FiltreActif ? "Aucune sauvegarde pour ces filtres." : "Aucune sauvegarde.")</td></tr> }
                </tbody>
            </table>
        </section>
        <Pagination Total="totalJournal" Numero="pageJournal" Taille="tailleJournal" Libelle="Pages du journal des sauvegardes" OnChange="p => ChargerJournalAsync(p.Numero, p.Taille)" />
        }
    </div>
</div>

@code {
    /// <summary>Sous-rubrique dans l'adresse (admin/sauvegardes?rubrique=…) : une partie à la fois, l'écran reste fixe.</summary>
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => NavAdmin.RubriqueCourante("admin/sauvegardes", Rubrique);

    private sealed class Reglages
    {
        public bool Actif { get; set; }
        public string? Dossier { get; set; }
        public TimeOnly Heure { get; set; } = new(22, 0);
        public int Conservation { get; set; } = 14;
        public int? RetentionGedJours { get; set; }
        public int? NettoyageGedAnnees { get; set; }
        public int AlerteSansDisqueJours { get; set; } = 7;
    }
    private int retentionParDefaut = 7;
    private string? dossierGed;

    private Reglages? r;
    private DateOnly? derniere;
    private DateTime? derniereReussie;
    private bool sansDisqueEnRetard;
    private int alerteSansDisqueEnregistree = 7;
    private List<EntreeSauvegardeDto> journal = [];
    private bool enCours;
    private string? erreur, message, baseSauvegardee, serveurBase;

    // Journal : page et filtres appliqués par le serveur ; « ← Retour » les retrouve
    private int totalJournal, pageJournal = 1, tailleJournal = Pagination.TailleParDefaut;
    private string fStatut = "";
    private DateOnly? fDu, fAu;
    private bool FiltreActif => fStatut != "" || fDu is not null || fAu is not null;
    private Task PremierePageAsync() => ChargerJournalAsync(1, tailleJournal);
    private Task ToutAfficherAsync() { (fStatut, fDu, fAu) = ("", null, null); return PremierePageAsync(); }

    private async Task ChargerJournalAsync(int numero, int taille)
    {
        var (p, e) = await Api.JournalSauvegardesAsync(fStatut, fDu, fAu, numero, taille);
        if (p is null) { erreur ??= e; return; }
        if (p.Lignes.Count == 0 && numero > 1) { await ChargerJournalAsync(1, taille); return; }
        (journal, totalJournal, pageJournal, tailleJournal, journalAJour) = (p.Lignes.ToList(), p.Total, p.Numero, p.Taille, true);
    }

    // Journal lu seulement quand sa rubrique est affichée ; après une sauvegarde ou un réglage, relu à la prochaine visite
    private bool journalAJour;
    private async Task ChargerJournalSiAfficheAsync()
    {
        if (rubrique == "journal" && !journalAJour) await ChargerJournalAsync(pageJournal, tailleJournal);
    }

    protected override Task OnParametersSetAsync() => r is null ? Task.CompletedTask : ChargerJournalSiAfficheAsync();

    protected override async Task OnInitializedAsync()
    {
        Historique.Suivre("sauvegardes", e => { e.Mettre("statut", fStatut); e.Mettre("du", fDu); e.Mettre("au", fAu); e.Mettre("page", pageJournal); e.Mettre("taille", tailleJournal); });
        var h = Historique.Restaurer("sauvegardes");
        if (h is not null) (fStatut, fDu, fAu, pageJournal, tailleJournal) = (h.Texte("statut") ?? "", h.Date("du"), h.Date("au"), h.Entier("page") ?? 1, h.Entier("taille") ?? tailleJournal);
        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        var (etat, e) = await Api.SauvegardesAsync();
        if (e is not null) { erreur = e; return; }
        r = new Reglages { Actif = etat!.Reglages.Actif, Dossier = etat.Reglages.Dossier, Heure = etat.Reglages.Heure, Conservation = etat.Reglages.Conservation,
            RetentionGedJours = etat.Reglages.RetentionGedJours, NettoyageGedAnnees = etat.Reglages.NettoyageGedAnnees,
            AlerteSansDisqueJours = etat.Reglages.AlerteSansDisqueJours };
        (derniereReussie, sansDisqueEnRetard, alerteSansDisqueEnregistree) = (etat.DerniereReussie, etat.SansDisqueEnRetard, etat.Reglages.AlerteSansDisqueJours);
        (retentionParDefaut, dossierGed) = (etat.Reglages.RetentionGedParDefaut, etat.Reglages.DossierGed);
        derniere = etat.Reglages.DerniereExecution;
        (baseSauvegardee, serveurBase) = (etat.Base, etat.Serveur);
        journalAJour = false;
        await ChargerJournalSiAfficheAsync();   // journal complet, par page (et non les 30 dernières)
        await ChargerSecoursAsync();
    }

    // ---- Copie de secours ----
    private CopieSecoursDto? secours;
    private string? dossierSecours;
    private int alerteHeures = 26;

    private async Task ChargerSecoursAsync()
    {
        var (c, e) = await Api.CopieSecoursAsync();
        if (c is null) { erreur ??= e; return; }
        (secours, dossierSecours, alerteHeures) = (c, c.Dossier, c.AlerteHeures);
    }

    private Task EnregistrerSecoursAsync() => Executer(async () =>
    {
        var e = await Api.ModifierCopieSecoursAsync(new ReglagesCopieSecoursDto(dossierSecours, alerteHeures));
        if (e is not null) return e;
        message = string.IsNullOrWhiteSpace(dossierSecours) ? "Copie de secours désactivée." : "Second emplacement enregistré : la prochaine sauvegarde y sera copiée.";
        await ChargerSecoursAsync();
        return null;
    });

    private Task TesterRestaurationAsync() => Executer(async () =>
    {
        var (res, e) = await Api.TesterRestaurationCopieAsync();
        if (e is not null) return e;
        await ChargerSecoursAsync();
        if (res!.Reussi) { message = res.Message; return null; }
        return res.Message;
    });

    // Dossier obligatoire pour activer la sauvegarde automatique ou sauvegarder maintenant : en rouge s'il manque
    private bool controleEnregistrer, controleLancer;
    private ElementReference champDossier;
    private bool DossierManque => r is not null && string.IsNullOrWhiteSpace(r.Dossier) && ((controleEnregistrer && r.Actif) || controleLancer);

    private async Task EnregistrerAsync()
    {
        (controleEnregistrer, controleLancer) = (true, false);
        if (DossierManque)
        {
            (erreur, message) = ("Choisissez le dossier avant d’activer les sauvegardes.", null);
            await champDossier.FocusAsync();
            return;
        }
        await Executer(async () =>
        {
            var e = await Api.ModifierReglagesSauvegardeAsync(new ReglagesSauvegardeDto(r!.Actif, r.Dossier, r.Heure, r.Conservation, null, r.RetentionGedJours, 7, r.NettoyageGedAnnees,
                null, r.AlerteSansDisqueJours));
            if (e is not null) return e;
            message = "Réglages enregistrés.";
            controleEnregistrer = false;
            await ChargerAsync();
            return null;
        });
    }

    private async Task LancerAsync()
    {
        (controleLancer, controleEnregistrer) = (true, false);
        if (DossierManque)
        {
            (erreur, message) = ("Choisissez d’abord le dossier de sauvegarde (disque externe).", null);
            await champDossier.FocusAsync();
            return;
        }
        controleLancer = false;
        await LancerSauvegardeAsync();
    }

    private async Task LancerSauvegardeAsync() => await Executer(async () =>
    {
        var (res, e) = await Api.LancerSauvegardeAsync();
        if (e is not null) return e;
        await ChargerAsync();
        if (res!.Statut == "reussie") message = res.Message;
        else return res.Message + " Le titulaire est prévenu.";
        return null;
    });

    private async Task Executer(Func<Task<string?>> action)
    {
        (enCours, erreur, message) = (true, null, null);
        try { erreur = await action(); }
        finally { enCours = false; }
    }
}
