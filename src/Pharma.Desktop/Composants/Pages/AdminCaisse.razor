@page "/admin/caisse"
@inject ApiClient Api
@inject HistoriqueNavigation Historique

<div class="page admin">
    <NavAdmin Actif="admin/caisse" Rubrique="@Rubrique" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Caisse et contrôle · @NavAdmin.Libelle("admin/caisse", Rubrique)</h1>
                <p class="sous-titre">Règles de caisse et journal des actions sensibles</p>
            </div>
            <button type="button" class="btn btn-principal" disabled="@(parametres is null || enCours)" @onclick="EnregistrerAsync">Enregistrer</button>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (parametres is not null)
        {
            @if (rubrique == "regles")
            {
            <section class="panneau" aria-labelledby="t-regles">
                <h2 id="t-regles">Règles</h2>
                <label class="case"><input type="checkbox" @bind="parametres.ComptageAveugle" /><span>Clôture en comptage aveugle obligatoire</span></label>
                <p class="detail" style="margin: 0">Ticket imprimé pour chaque vente : se règle pour chaque poste dans <a href="admin/imprimantes">Imprimantes et étiquettes</a>.</p>
                <label class="case" title="Une action refusée faute de droit peut être autorisée sur place par le code comptoir d’un employé qui a ce droit (inscrit au journal)">
                    <input type="checkbox" @bind="parametres.AutorisationParCode" /><span>Une action non autorisée peut être autorisée par le code comptoir d’un employé qui a le droit</span></label>
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px">
                    <label class="case"><input type="checkbox" checked="@(parametres.DeconnexionMinutes > 0)" @onchange="BasculerDeconnexion" /><span>Déconnexion automatique du poste après</span></label>
                    <input type="number" min="1" max="240" style="width: 90px" aria-label="Minutes d’inactivité" data-champ="deconnexion"
                           disabled="@(parametres.DeconnexionMinutes <= 0)" @bind="parametres.DeconnexionMinutes" />
                    <span>minutes d’inactivité</span>
                </div>
                <div class="tuiles" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
                    <div class="champ"><label for="fond">Fond de caisse (DA)</label><input id="fond" data-champ="fond_caisse" type="number" min="0" @bind="parametres.FondCaisseDefaut" /></div>
                    <div class="champ"><label for="seuil">Alerte si écart supérieur à (DA)</label><input id="seuil" type="number" min="0" @bind="parametres.SeuilEcart" /></div>
                    <div class="champ" title="Proposé à la création d’un patient ; 0 : pas de crédit tant qu’il n’est pas accordé">
                        <label for="plafond-defaut">Plafond de crédit d’un nouveau patient (DA)</label>
                        <input id="plafond-defaut" data-champ="plafond_defaut" type="number" min="0" @bind="parametres.PlafondCreditDefaut" />
                    </div>
                    <div class="champ" title="0 : pas d’alerte. Au-delà, le titulaire est prévenu (journal et notification).">
                        <label for="annul">Alerte au-delà de N annulations par session</label>
                        <input id="annul" data-champ="seuil_annulations" type="number" min="0" max="100" @bind="parametres.SeuilAnnulations" />
                    </div>
                </div>
                <fieldset class="champ" style="border: 0; padding: 0; margin: 0">
                    <legend class="etiquette-champ">À la clôture d’une caisse, l’argent compté part au coffre :</legend>
                    <label class="case"><input type="radio" name="versement" checked="@(parametres.VersementCloture == "manuel")" @onchange="@(() => parametres.VersementCloture = "manuel")" />
                        <span>À la main : le versement se saisit dans Trésorerie (caisses à verser)</span></label>
                    <label class="case"><input type="radio" name="versement" checked="@(parametres.VersementCloture == "automatique")" @onchange="@(() => parametres.VersementCloture = "automatique")" />
                        <span>Automatiquement : le compté moins le fond de caisse (@Libelles.Dinars(parametres.FondCaisseDefaut)), qui reste dans le tiroir ; pas à la relève d’équipe</span></label>
                </fieldset>
            </section>
            }
        }

        @if (rubrique == "journal")
        {
        <section class="panneau" aria-labelledby="t-journal">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px">
                <h2 id="t-journal">Journal des actions sensibles</h2>
                <span class="pastille info">Non modifiable</span>
            </div>
            <div class="achats-ligne" style="align-items: flex-end">
                <div class="champ" style="flex: 0 0 160px"><label for="j-du">Du</label><input id="j-du" type="date" @bind="journalDu" @bind:after="() => ChargerJournalAsync(1)" /></div>
                <div class="champ" style="flex: 0 0 160px"><label for="j-au">Au</label><input id="j-au" type="date" @bind="journalAu" @bind:after="() => ChargerJournalAsync(1)" /></div>
                <div class="champ" style="flex: 0 0 240px"><label for="j-employe">Employé</label>
                    <select id="j-employe" data-champ="employe" @bind="journalEmploye" @bind:after="() => ChargerJournalAsync(1)">
                        <option value="">Tous</option>
                        @foreach (var e in employesJournal) { <option value="@e">@e</option> }
                        @if (!string.IsNullOrEmpty(journalEmploye) && !employesJournal.Contains(journalEmploye)) { <option value="@journalEmploye">@journalEmploye</option> }
                    </select></div>
                <div class="champ" style="flex: 0 0 260px"><label for="j-categorie">Actions</label>
                    <select id="j-categorie" @bind="journalCategorie" @bind:after="() => ChargerJournalAsync(1)">
                        <option value="">Toutes les actions</option>
                        <option value="modifications">Modifications (prix, fiches, réglages, droits)</option>
                        <option value="autorisations">Autorisations par code et blocages</option>
                    </select></div>
                @if (journalDu is not null || journalAu is not null || !string.IsNullOrWhiteSpace(journalEmploye) || journalCategorie != "")
                {
                    <button type="button" class="btn" @onclick="EffacerFiltresJournalAsync">Tout afficher</button>
                }
            </div>
            @if (erreurJournal is not null) { <div class="erreur" role="alert">@erreurJournal</div> }
            <div class="tableau-cadre">
                <table class="tableau" style="min-width: 720px">
                    <thead>
                        <tr><th scope="col">Date</th><th scope="col">Employé</th><th scope="col">Action</th><th scope="col">Détail</th><th scope="col" style="white-space: nowrap">Autorisé par</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var j in journal)
                        {
                            <tr>
                                <td style="white-space: nowrap">@Libelles.DateHeureLocale(j.Date)</td>
                                <td style="white-space: nowrap"><LienContact Type="employe" Id="j.EmployeId" Nom="@j.Employe" /></td>
                                <td>@Libelles.ActionJournal(j.Action)</td>
                                <td style="white-space: pre-line">@Libelles.DetailJournal(j.Action, j.Details)</td>
                                <td><LienContact Type="employe" Id="j.AutoriseParId" Nom="@(j.AutorisePar ?? "—")" /></td>
                            </tr>
                        }
                        @if (journal.Count == 0) { <tr><td colspan="5" class="vide">Aucune action sensible pour ces filtres.</td></tr> }
                    </tbody>
                </table>
            </div>
            <Pagination Total="journalTotal" Numero="journalPage" Taille="journalTaille" Libelle="Pages du journal" OnChange="p => ChargerJournalAsync(p.Numero, p.Taille)" />
        </section>
        }
    </div>
</div>

@code {
    /// <summary>Sous-rubrique dans l'adresse (admin/caisse?rubrique=…) : une partie à la fois, l'écran reste fixe.</summary>
    [SupplyParameterFromQuery(Name = "rubrique")] public string? Rubrique { get; set; }
    private string rubrique => NavAdmin.RubriqueCourante("admin/caisse", Rubrique);

    private sealed class Saisie
    {
        public bool ComptageAveugle { get; set; }
        public decimal FondCaisseDefaut { get; set; }
        public decimal SeuilEcart { get; set; }
        public int DeconnexionMinutes { get; set; }
        public string VersementCloture { get; set; } = "manuel";
        public decimal PlafondCreditDefaut { get; set; }
        public int SeuilAnnulations { get; set; }
        public bool AutorisationParCode { get; set; } = true;
    }

    private Saisie? parametres;
    private List<EntreeJournalDto> journal = [];
    // Journal paginé et filtré : période et employé
    private int journalTotal, journalPage = 1, journalTaille = Pagination.TailleParDefaut;
    private DateOnly? journalDu, journalAu;
    private string? journalEmploye, erreurJournal;
    // Liste préremplie du filtre « Employé » : les employés présents dans le journal
    private List<string> employesJournal = [];
    private string journalCategorie = "";

    private async Task ChargerJournalAsync(int page, int? taille = null)
    {
        journalTaille = taille ?? journalTaille;
        var (p, e) = await Api.JournalAsync(journalDu, journalAu, journalEmploye, page, journalTaille, journalCategorie == "" ? null : journalCategorie);
        erreurJournal = e;
        if (p is null) return;
        // Page au-delà de la fin (filtre resserré) : retour à la première
        if (p.Lignes.Count == 0 && page > 1) { await ChargerJournalAsync(1); return; }
        (journal, journalTotal, journalPage) = (p.Lignes.ToList(), p.Total, p.Numero);
    }

    private Task EffacerFiltresJournalAsync()
    {
        (journalDu, journalAu, journalEmploye, journalCategorie) = (null, null, null, "");
        return ChargerJournalAsync(1);
    }
    private string? erreur, message;
    private bool enCours;

    // Arrivée depuis la fiche contact d'un employé : journal filtré sur lui
    [SupplyParameterFromQuery(Name = "employe")] public string? Employe { get; set; }
    private string? employeApplique;
    private bool initialise;

    protected override async Task OnParametersSetAsync()
    {
        if (!initialise || Employe == employeApplique) return;
        (journalEmploye, employeApplique) = (Employe, Employe);
        await ChargerJournalAsync(1);
    }

    protected override async Task OnInitializedAsync()
    {
        (journalEmploye, employeApplique) = (Employe, Employe);
        initialise = true;
        // « ← Retour » : filtres et page du journal des actions retrouvés tels qu'ils étaient
        Historique.Suivre("journal", e =>
        {
            e.Mettre("employe", journalEmploye); e.Mettre("categorie", journalCategorie); e.Mettre("du", journalDu); e.Mettre("au", journalAu);
            e.Mettre("page", journalPage); e.Mettre("taille", journalTaille);
        });
        var retour = Historique.Restaurer("journal");
        if (retour is not null)
            (journalEmploye, journalCategorie, journalDu, journalAu) = (retour.Texte("employe"), retour.Texte("categorie") ?? "", retour.Date("du"), retour.Date("au"));
        var (p, err) = await Api.ParametresCaisseAsync();
        erreur = err;
        if (p is not null)
            parametres = new Saisie
            {
                ComptageAveugle = p.ComptageAveugle, FondCaisseDefaut = p.FondCaisseDefaut,
                SeuilEcart = p.SeuilEcart, DeconnexionMinutes = p.DeconnexionMinutes, VersementCloture = p.VersementCloture ?? "manuel", PlafondCreditDefaut = p.PlafondCreditDefaut,
                SeuilAnnulations = p.SeuilAnnulations, AutorisationParCode = p.AutorisationParCode
            };
        (employesJournal, _) = await Api.EmployesJournalAsync();
        await ChargerJournalAsync(retour?.Entier("page") ?? 1, retour?.Entier("taille"));
    }

    private void BasculerDeconnexion(ChangeEventArgs e)
    {
        if (parametres is null) return;
        parametres.DeconnexionMinutes = e.Value is true ? Math.Max(parametres.DeconnexionMinutes, 5) : 0;
    }

    private async Task EnregistrerAsync()
    {
        if (parametres is null) return;
        enCours = true;
        message = null;
        erreur = await Api.ModifierParametresCaisseAsync(new ParametresCaisseDto(
            parametres.ComptageAveugle, parametres.FondCaisseDefaut, parametres.SeuilEcart, parametres.DeconnexionMinutes, parametres.VersementCloture, parametres.PlafondCreditDefaut,
            parametres.SeuilAnnulations, parametres.AutorisationParCode));
        enCours = false;
        if (erreur is not null) return;
        message = "Paramètres enregistrés (inscrits au journal). La déconnexion automatique s’applique à la prochaine connexion.";
        await ChargerJournalAsync(1);
    }
}
