@page "/accueil"
@inject ApiClient Api
@inject SessionPoste Session

@* Accueil (navigation en deux niveaux, docs/navigation.md) : ce qui attend l'employé aujourd'hui. Chaque tuile ouvre l'écran concerné
   et n'apparaît que si l'employé peut l'ouvrir. Écran d'arrivée de qui a des droits de gestion (Domaines.Accueil) ;
   le vendeur arrive directement sur la Caisse. *@
<div class="page avec-menu">
    <NavDomaine Libelle="Accueil">
        <span class="nav-groupe-titre">Accueil</span>
        <a href="accueil" class="active" aria-current="page">Tableau de bord</a>
    </NavDomaine>

    <div class="contenu-rubrique">
        <div class="titre-page">
            <div>
                <h1>Bonjour @Session.NomComplet<AideEcran Cle="accueil" /></h1>
                <p class="sous-titre">Ce qui vous attend aujourd’hui. Chaque tuile ouvre l’écran concerné.</p>
            </div>
        </div>

        @if (nonEnvoyees is { Nombre: > 0 } ne)
        {
            @* Titulaire : alertes qui n'ont pas pu partir (aucun destinataire vérifié, mise en file impossible, envoi abandonné) *@
            <div class="bandeau-attention" role="alert" style="margin-bottom: 16px">
                <strong>@ne.Nombre alerte(s) n’ont pas pu être envoyées :</strong>
                <ul style="margin: 6px 0">
                    @foreach (var a in ne.Dernieres)
                    {
                        <li>@a.CreeLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @a.Objet : @a.Raison</li>
                    }
                </ul>
                @if (ne.Nombre > ne.Dernieres.Count) { <div class="detail">… et @(ne.Nombre - ne.Dernieres.Count) plus ancienne(s).</div> }
                <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px">
                    <button type="button" class="btn" disabled="@marquage" @onclick="MarquerVuesAsync">Marquer comme vues</button>
                    <a href="admin/notifications" class="btn">Vérifier les destinataires</a>
                </div>
                @if (erreurNonEnvoyees is not null) { <div class="erreur" role="alert">@erreurNonEnvoyees</div> }
            </div>
        }

        @if (charge)
        {
            <div class="tuiles-accueil">
                <a href="./?rubrique=urgent" class="tuile tuile-lien @(urgentes > 0 ? "tuile-urgente" : null)">
                    <span class="tuile-libelle">Alertes urgentes</span>
                    <span class="tuile-valeur">@urgentes</span>
                    <span class="tuile-aller">Voir les alertes →</span>
                </a>
                @if (peremption is { } p)
                {
                    <a href="./?rubrique=peremption" class="tuile tuile-lien">
                        <span class="tuile-libelle">Lots périmant dans les @(p.Jours / 30) mois</span>
                        <span class="tuile-valeur">@p.Lots</span>
                        <span class="detail">@p.Boites boîte(s)@if (p.Valeur is { } valeurPeremption) { <text> · @Libelles.Dinars(valeurPeremption, 2)</text> }</span>
                        <span class="tuile-aller">Voir les alertes →</span>
                    </a>
                }
                @if (receptionsEnAttente is { } r)
                {
                    <a href="achats?onglet=receptions&vue=attente" class="tuile tuile-lien">
                        <span class="tuile-libelle">Réceptions en attente</span>
                        <span class="tuile-valeur">@r</span>
                        <span class="detail">@(r == 0 ? "Aucune livraison en cours" : "Livraisons commencées, à reprendre")</span>
                        <span class="tuile-aller">Reprendre →</span>
                    </a>
                }
                @if (ecartsAValider is { } e)
                {
                    <a href="inventaire?rubrique=ecarts" class="tuile tuile-lien">
                        <span class="tuile-libelle">Écarts d’inventaire à valider</span>
                        <span class="tuile-valeur">@e</span>
                        <span class="detail">@(e == 0 ? "Rien à valider" : "En attente du titulaire")</span>
                        <span class="tuile-aller">Inventaire →</span>
                    </a>
                }
            </div>
        }
        else
        {
            <Chargement />
        }
    </div>
</div>

@code {
    private bool charge;
    private int urgentes;
    private HorizonPeremptionDto? peremption;
    private int? receptionsEnAttente, ecartsAValider;

    protected override async Task OnInitializedAsync()
    {
        var (compte, _) = await Api.AlertesUrgentesAsync();
        urgentes = compte?.Nombre ?? 0;
        // Horizon le plus long des indicateurs de péremption (6 mois aujourd'hui)
        var (ind, _) = await Api.IndicateursAlertesAsync();
        peremption = ind?.Peremption.OrderByDescending(h => h.Jours).FirstOrDefault();
        if (Session.A("achats.receptionner"))
        {
            var (attentes, err) = await Api.ReceptionsEnAttenteAsync();
            receptionsEnAttente = err is null ? attentes.Count : null;
        }
        var (tableau, _) = await Api.TableauInventaireAsync();
        ecartsAValider = tableau?.EcartsAValider.Count;
        if (Session.A("role.titulaire")) (nonEnvoyees, _) = await Api.AlertesNonEnvoyeesAsync();
        charge = true;
    }

    // ---- Alertes non envoyées (titulaire) ----
    private AlertesNonEnvoyeesDto? nonEnvoyees;
    private string? erreurNonEnvoyees;
    private bool marquage;

    private async Task MarquerVuesAsync()
    {
        if (nonEnvoyees is not { Dernieres.Count: > 0 } ne) return;
        marquage = true;
        // Jusqu'à la plus récente affichée : une alerte arrivée entre-temps reste signalée
        var (_, err) = await Api.MarquerAlertesNonEnvoyeesVuesAsync(ne.Dernieres.Max(a => a.Id));
        erreurNonEnvoyees = err;
        if (err is null) (nonEnvoyees, _) = await Api.AlertesNonEnvoyeesAsync();
        marquage = false;
    }
}
