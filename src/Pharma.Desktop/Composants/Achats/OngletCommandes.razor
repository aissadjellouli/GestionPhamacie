@inject ApiClient Api
@inject SessionPoste Session
@inject NavigationManager Nav
@inject HistoriqueNavigation Historique

@if (message is not null)
{
    <div class="succes" role="status">@message</div>
}
@if (erreur is not null)
{
    <div class="erreur" role="alert">@erreur</div>
}

@* Vue « a-commander » : ajout et suggestions ; vue « bons » : liste des bons et détail (écran fixe : une partie à la fois) *@
@* Rien n'est montré avant la première lecture : l'écran apparaît d'un coup, déjà rempli (pas de tableau vide qui se remplit sous les yeux) *@
<div class="@(Vue == "a-commander" ? "liste" : "achats-grille")" style="@(premiereLecture ? null : "visibility: hidden")">
    <div class="liste">
        @if (PeutCommander && Vue != "bons")
        {
            <section class="panneau" aria-labelledby="t-ajout">
                <h2 id="t-ajout">Ajouter un produit à commander</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 1 1 200px; min-width: 0">
                        <label for="c-gros" class="requis">Grossiste</label>
                        <select id="c-gros" data-champ="grossiste" @ref="champGrossiste" @bind="fournisseurId" class="@Obligatoire.Classe(GrossisteManque)" aria-invalid="@Obligatoire.Aria(GrossisteManque)">
                            @foreach (var f in fournisseurs.Where(x => x.Actif || x.Id == fournisseurId))
                            {
                                <option value="@f.Id">@f.RaisonSociale</option>
                            }
                        </select>
                    </div>
                    <ChoixProduit @ref="choixProduit" Id="c-prod" Style="flex: 3 1 260px" Requis="true" OnChoisi="Choisir" OnEfface="() => produitChoisi = null" />
                    <div class="champ" style="flex: 0 0 110px; min-width: 0">
                        <label for="c-qte" class="requis">Quantité</label>
                        <input id="c-qte" type="number" min="1" @ref="champQuantite" @bind="quantite" class="@Obligatoire.Classe(QuantiteInvalide)" aria-invalid="@Obligatoire.Aria(QuantiteInvalide)" />
                    </div>
                    <div class="champ" style="flex: 0 0 150px; min-width: 0">
                        <label for="c-prix">Prix HT (DA)</label>
                        <input id="c-prix" type="number" min="0" step="0.01" placeholder="dernier prix" @bind="prix" />
                    </div>
                </div>
                @if (produitChoisi is not null)
                {
                    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap">
                        <span>Choisi : <strong>@produitChoisi.NomCommercial</strong> · stock @produitChoisi.Stock</span>
                        <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => AjouterAsync(produitChoisi.Id)">Ajouter au bon</button>
                    </div>
                }
                <p class="detail" style="margin: 0">Ajouté au bon en brouillon du grossiste (créé au besoin) ; sans prix, le dernier prix d’achat est repris.</p>
            </section>

            <h2 id="t-sugg" style="margin: 0">À commander (ruptures et stocks critiques)</h2>
            <div class="filtres-liste" role="search" aria-label="Filtrer les produits à commander">
                <div class="champ" style="flex: 1 1 240px"><label for="fs-recherche">Produit</label>
                    <input id="fs-recherche" type="search" autocomplete="off" placeholder="Ex. amlodipine" value="@sRecherche" @oninput="RechercheSuggestionsAsync" /></div>
                <div class="champ" style="flex: 0 0 160px"><label for="fs-etat">État</label>
                    <select id="fs-etat" @bind="sStatut" @bind:after="PremierePageSuggestionsAsync">
                        <option value="">Tous</option>
                        <option value="rupture">Rupture</option>
                        <option value="critique">Critique</option>
                    </select></div>
                <div class="champ" style="flex: 0 0 220px"><label for="fs-grossiste">Dernier grossiste</label>
                    <select id="fs-grossiste" @bind="sGrossiste" @bind:after="PremierePageSuggestionsAsync">
                        <option value="">Tous</option>
                        @foreach (var g in grossistesSuggestions) { <option value="@g.Code">@g.Libelle</option> }
                        @if (sansAchat) { <option value="0">Jamais acheté</option> }
                    </select></div>
                @if (FiltreSuggestionsActif) { <button type="button" class="btn" @onclick="EffacerFiltresSuggestionsAsync">Tout afficher</button> }
            </div>
            <section class="tableau-cadre" aria-labelledby="t-sugg">
                <table class="tableau" style="min-width: 0">
                    <thead><tr><th scope="col">Produit</th><th scope="col">État</th><th scope="col">Stock</th><th scope="col">Suggéré</th><th scope="col">Dernier achat</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var s in suggestions)
                        {
                            <tr>
                                <td><span class="nom">@s.Produit</span></td>
                                <td><span class="pastille @(s.Statut == "rupture" ? "urgent" : "attention")">@(s.Statut == "rupture" ? "Rupture" : "Critique")</span></td>
                                <td>@s.Stock</td>
                                <td>@Math.Max(1, s.QteSuggeree)</td>
                                <td>@(s.DernierPrixHt is { } p ? $"{Libelles.Dinars(p, 2)} · {s.DernierFournisseur}" : "aucun")</td>
                                <td><button type="button" class="btn" disabled="@enCours" @onclick="() => AjouterSuggestionAsync(s)">Ajouter</button></td>
                            </tr>
                        }
                        @if (suggestions.Count == 0)
                        {
                            <tr><td colspan="6" class="vide">@(FiltreSuggestionsActif ? "Aucun produit à commander pour ces filtres." : "Aucune rupture ni stock critique : rien à commander.")</td></tr>
                        }
                    </tbody>
                </table>
            </section>
            <Pagination Total="totalSuggestions" Numero="pageSuggestions" Taille="tailleSuggestions" Libelle="Pages des produits à commander" OnChange="p => ChargerSuggestionsAsync(p.Numero, p.Taille)" />
        }
        @if (Vue == "a-commander" && !PeutCommander) { <p class="vide">Droit « achats.commander » nécessaire pour ajouter des produits à commander.</p> }

        @if (Vue != "a-commander")
        {
        <div class="filtres-liste" role="search" aria-label="Filtrer les bons de commande">
            <div class="champ" style="flex: 1 1 120px; min-width: 0"><label for="fc-grossiste">Grossiste</label>
                <select id="fc-grossiste" @bind="fFournisseur" @bind:after="PremierePageAsync">
                    <option value="0">Tous</option>
                    @foreach (var g in fournisseurs) { <option value="@g.Id">@g.RaisonSociale</option> }
                </select>
            </div>
            <div class="champ" style="flex: 0 0 130px; min-width: 0"><label for="fc-statut">Statut</label>
                <select id="fc-statut" @bind="fStatut" @bind:after="PremierePageAsync">
                    <option value="">Tous</option>
                    @foreach (var s in StatutsCommande) { <option value="@s">@Libelles.StatutCommande(s)</option> }
                </select>
            </div>
            <div class="champ" style="flex: 0 0 150px; min-width: 0"><label for="fc-du">Du</label><input id="fc-du" type="date" @bind="fDu" @bind:after="PremierePageAsync" /></div>
            <div class="champ" style="flex: 0 0 150px; min-width: 0"><label for="fc-au">Au</label><input id="fc-au" type="date" @bind="fAu" @bind:after="PremierePageAsync" /></div>
            @if (FiltreActif) { <button type="button" class="btn" @onclick="EffacerFiltresAsync">Tout afficher</button> }
        </div>
        <section class="tableau-cadre" aria-label="Bons de commande">
            <table class="tableau" style="min-width: 0">
                <thead><tr><th scope="col">Bon</th><th scope="col">Grossiste</th><th scope="col">Date</th><th scope="col">Montant HT</th><th scope="col">Statut</th></tr></thead>
                <tbody>
                    @foreach (var c in commandes)
                    {
                        <tr class="ligne-cliquable @(detail?.Entete.Id == c.Id ? "choisie" : null)" @onclick="() => OuvrirAsync(c.Id)">
                            <td><button type="button" class="lien" @onclick="() => OuvrirAsync(c.Id)" @onclick:stopPropagation="true">@c.Numero</button><br /><span class="detail">@c.NombreLignes ligne(s)</span></td>
                            <td><LienContact Type="grossiste" Id="c.FournisseurId" Nom="@c.Fournisseur" /></td>
                            <td>@Libelles.DateLocale(c.Date)</td>
                            <td>@Libelles.Dinars(c.MontantHt, 2)</td>
                            <td><span class="pastille @Libelles.ClasseStatutCommande(c.Statut)">@Libelles.StatutCommande(c.Statut)</span></td>
                        </tr>
                    }
                    @if (commandes.Count == 0)
                    {
                        <tr><td colspan="5" class="vide">@(FiltreActif ? "Aucun bon de commande pour ces filtres." : "Aucun bon de commande.")</td></tr>
                    }
                </tbody>
            </table>
        </section>
        <Pagination Total="total" Numero="page" Taille="taille" Libelle="Pages des bons de commande" OnChange="p => AllerPageAsync(p.Numero, p.Taille)" />
        }
    </div>

    @if (Vue != "a-commander")
    {
    <aside class="panneau cadre-defilant" aria-label="Détail du bon">
        @if (detail is null)
        {
            <p class="vide">Choisissez un bon pour le voir, le modifier ou l’émettre.</p>
        }
        else
        {
            var brouillon = detail.Entete.Statut == "brouillon";
            <div style="display: flex; justify-content: space-between; gap: 8px; align-items: center">
                <h2>Bon @detail.Entete.Numero</h2>
                <span class="pastille @Libelles.ClasseStatutCommande(detail.Entete.Statut)">@Libelles.StatutCommande(detail.Entete.Statut)</span>
            </div>
            <p class="detail" style="margin: 0"><LienContact Type="grossiste" Id="detail.Entete.FournisseurId" Nom="@detail.Entete.Fournisseur" /> · @Libelles.DateLocale(detail.Entete.Date)</p>
            <table class="tableau" style="min-width: 0">
                <thead><tr><th scope="col">Produit</th><th scope="col">Qté</th><th scope="col">Prix HT</th>@if (!brouillon){<th scope="col">Reçu</th>}</tr></thead>
                <tbody>
                    @foreach (var l in lignesEdition)
                    {
                        <tr>
                            <td>@l.Produit</td>
                            @if (brouillon && PeutCommander)
                            {
                                <td><input type="number" min="0" style="width: 64px" aria-label="Quantité de @l.Produit" @bind="l.Quantite" @bind:after="() => EnregistrerLigneAsync(l)" /></td>
                                <td><input type="number" min="0" step="0.01" style="width: 90px" aria-label="Prix HT de @l.Produit" @bind="l.Prix" @bind:after="() => EnregistrerLigneAsync(l)" /></td>
                            }
                            else
                            {
                                <td>@l.Quantite</td>
                                <td>@Libelles.Dinars(l.Prix, 2)</td>
                                <td>@l.Recue / @l.Quantite</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <p style="margin: 0; font-weight: 600">Total HT : @Libelles.Dinars(lignesEdition.Sum(l => l.Quantite * l.Prix), 2)</p>
            @if (brouillon)
            {
                <p class="detail" style="margin: 0">Quantité 0 : la ligne est retirée.</p>
            }
            <div style="display: flex; flex-wrap: wrap; gap: 8px">
                @if (brouillon && PeutCommander)
                {
                    <button type="button" class="btn btn-principal" disabled="@(enCours || lignesEdition.Count == 0)" @onclick="EmettreAsync">Émettre le bon (PDF)</button>
                }
                else
                {
                    <button type="button" class="btn" disabled="@enCours" @onclick="ImprimerAsync">Imprimer le bon</button>
                }
                @if (detail.Entete.Statut is "envoyee" or "recue_partielle" && Session.A("achats.receptionner"))
                {
                    <button type="button" class="btn btn-principal" @onclick="@(() => Nav.NavigateTo($"achats?onglet=receptions&commande={detail.Entete.Id}"))">Réceptionner</button>
                }
                @if (detail.Entete.Statut is "brouillon" or "envoyee" && PeutCommander && detail.Lignes.All(l => l.QteRecue == 0))
                {
                    <button type="button" class="btn" disabled="@enCours" @onclick="AnnulerAsync">Annuler le bon</button>
                }
            </div>
        }
    </aside>
    }
</div>

@code {
    /// <summary>Partie affichée : « a-commander » (ajout et suggestions), « bons » (liste et détail), vide (tout).</summary>
    [Parameter] public string Vue { get; set; } = "";
    [Parameter] public long? ProduitAAjouter { get; set; }
    [Parameter] public long? CommandeOuverte { get; set; }
    [Parameter] public string? NomProduit { get; set; }
    /// <summary>Liste des bons filtrée sur ce grossiste (depuis sa fiche contact).</summary>
    [Parameter] public long? Grossiste { get; set; }
    private long? grossisteApplique;
    private bool initialise, premiereLecture;

    protected override async Task OnParametersSetAsync()
    {
        if (!initialise || Grossiste == grossisteApplique) return;
        (fFournisseur, grossisteApplique) = (Grossiste ?? 0, Grossiste);
        await PremierePageAsync();
    }

    private sealed class LigneEdition(LigneCommandeAchatDto l)
    {
        public long Id { get; } = l.Id;
        public string Produit { get; } = l.Produit;
        public int Quantite { get; set; } = l.QteCommandee;
        public decimal Prix { get; set; } = l.PrixAchatHt;
        public int Recue { get; } = l.QteRecue;
    }

    private List<FournisseurDto> fournisseurs = [];
    private List<CommandeAchatDto> commandes = [];
    private int total, page = 1, taille = Pagination.TailleParDefaut;
    private Task AllerPageAsync(int numero, int nouvelleTaille) { (page, taille) = (numero, nouvelleTaille); return RechargerAsync(); }

    // Filtres de la liste des bons : appliqués par le serveur, le total et les pages les suivent
    private static readonly string[] StatutsCommande = ["brouillon", "envoyee", "recue_partielle", "recue", "annulee"];
    private long fFournisseur;
    private string fStatut = "";
    private DateOnly? fDu, fAu;
    private bool FiltreActif => fFournisseur > 0 || fStatut != "" || fDu is not null || fAu is not null;
    private Task PremierePageAsync() { page = 1; return RechargerAsync(); }
    private Task EffacerFiltresAsync() { (fFournisseur, fStatut, fDu, fAu) = (0, "", null, null); return PremierePageAsync(); }
    // Produits à commander : page et filtres appliqués par le serveur (règle des listes)
    private List<SuggestionCommandeDto> suggestions = [];
    private List<CodeLibelleDto> grossistesSuggestions = [];
    private bool sansAchat;
    private int totalSuggestions, pageSuggestions = 1, tailleSuggestions = Pagination.TailleParDefaut, requeteSuggestions;
    private string sRecherche = "", sStatut = "", sGrossiste = "";
    private bool FiltreSuggestionsActif => sRecherche.Trim().Length > 0 || sStatut != "" || sGrossiste != "";
    private Task PremierePageSuggestionsAsync() => ChargerSuggestionsAsync(1, tailleSuggestions);
    private Task EffacerFiltresSuggestionsAsync() { (sRecherche, sStatut, sGrossiste) = ("", "", ""); return PremierePageSuggestionsAsync(); }

    /// <summary>Saisie : rechargement après une courte pause (pas à chaque touche).</summary>
    private async Task RechercheSuggestionsAsync(ChangeEventArgs e)
    {
        sRecherche = e.Value?.ToString() ?? "";
        var n = ++requeteSuggestions;
        await Task.Delay(250);
        if (n == requeteSuggestions) await PremierePageSuggestionsAsync();
    }

    private async Task ChargerSuggestionsAsync(int numero, int nouvelleTaille)
    {
        var (r, e) = await Api.SuggestionsCommandePageAsync(sRecherche, sStatut, long.TryParse(sGrossiste, out var g) ? g : null, numero, nouvelleTaille);
        if (r is null) { erreur ??= e; return; }
        // Page au-delà de la fin (produits commandés entre-temps) : retour à la première
        if (r.Page.Lignes.Count == 0 && numero > 1) { await ChargerSuggestionsAsync(1, nouvelleTaille); return; }
        (suggestions, totalSuggestions, pageSuggestions, tailleSuggestions) = (r.Page.Lignes.ToList(), r.Page.Total, r.Page.Numero, r.Page.Taille);
        (grossistesSuggestions, sansAchat) = (r.Grossistes.ToList(), r.SansAchat);
    }
    private CommandeAchatDetailDto? detail;
    private List<LigneEdition> lignesEdition = [];
    private long fournisseurId;
    private ChoixProduit? choixProduit;

    // Grossiste et quantité (RegleAchats) : en rouge après un premier essai d'ajout ; le produit est déjà choisi quand le bouton apparaît
    private bool controle;
    private ElementReference champGrossiste, champQuantite;
    private bool GrossisteManque => Obligatoire.Manque(controle, fournisseurId);
    private bool QuantiteInvalide => controle && quantite is <= 0 or > 10_000;
    private ProduitDto? produitChoisi;
    private int quantite = 1;
    private decimal? prix;
    private bool enCours;
    private string? erreur, message;

    private bool PeutCommander => Session.A("achats.commander");

    protected override async Task OnInitializedAsync()
    {
        (fournisseurs, erreur) = await Api.FournisseursAsync();
        fournisseurId = fournisseurs.FirstOrDefault()?.Id ?? 0;
        (fFournisseur, grossisteApplique, initialise) = (Grossiste ?? 0, Grossiste, true);
        // « ← Retour » : filtres, page et bon ouvert retrouvés tels qu'ils étaient
        Historique.Suivre("commandes", e =>
        {
            e.Mettre("grossiste", fFournisseur > 0 ? fFournisseur : null); e.Mettre("statut", fStatut); e.Mettre("du", fDu); e.Mettre("au", fAu);
            e.Mettre("page", page); e.Mettre("taille", taille); e.Mettre("bon", detail?.Entete.Id);
            e.Mettre("s_recherche", sRecherche); e.Mettre("s_etat", sStatut); e.Mettre("s_grossiste", sGrossiste);
            e.Mettre("s_page", pageSuggestions); e.Mettre("s_taille", tailleSuggestions);
        });
        var r = Historique.Restaurer("commandes");
        if (r is not null)
        {
            (fFournisseur, fStatut, fDu, fAu) = (r.Long("grossiste") ?? 0, r.Texte("statut") ?? "", r.Date("du"), r.Date("au"));
            (page, taille) = (r.Entier("page") ?? 1, r.Entier("taille") ?? taille);
            (sRecherche, sStatut, sGrossiste) = (r.Texte("s_recherche") ?? "", r.Texte("s_etat") ?? "", r.Texte("s_grossiste") ?? "");
            (pageSuggestions, tailleSuggestions) = (r.Entier("s_page") ?? 1, r.Entier("s_taille") ?? tailleSuggestions);
        }
        await RechargerAsync();
        if (r?.Long("bon") is { } bon) await OuvrirAsync(bon);
        if (PeutCommander && Vue != "bons") await ChargerSuggestionsAsync(pageSuggestions, tailleSuggestions);
        premiereLecture = true;

        // Arrivée depuis une alerte « Commander » : produit présélectionné, grossiste et quantité suggérés
        if (ProduitAAjouter is { } pid && PeutCommander)
        {
            var (toutes, _) = await Api.SuggestionsCommandeAsync();
            var connu = toutes.FirstOrDefault(s => s.ProduitId == pid);
            if (connu is not null)
            {
                fournisseurId = connu.DernierFournisseurId ?? fournisseurId;
                quantite = Math.Max(1, connu.QteSuggeree);
            }
            var nom = connu?.Produit ?? NomProduit;
            if (nom is not null)
            {
                produitChoisi = new ProduitDto(pid, nom, null, null, null, 0, connu?.Stock ?? 0, "");
            }
        }
        if (CommandeOuverte is { } cid) await OuvrirAsync(cid);
    }

    // Produit présélectionné depuis une alerte : son nom s'affiche dans le champ
    private bool nomAffiche;
    protected override void OnAfterRender(bool premierRendu)
    {
        if (nomAffiche || choixProduit is null || produitChoisi is null) return;
        nomAffiche = true;
        choixProduit.Afficher(produitChoisi.NomCommercial);
    }

    private async Task RechargerAsync()
    {
        string? e;
        (var p, e) = await Api.CommandesAchatAsync(page, taille, fFournisseur > 0 ? fFournisseur : null, fStatut, fDu, fAu);
        if (p is { Lignes.Count: 0 } && page > 1) { page--; await RechargerAsync(); return; }
        if (p is not null) (commandes, total, page) = (p.Lignes.ToList(), p.Total, p.Numero);
        erreur ??= e;
    }

    private void Choisir(ProduitDto p) => produitChoisi = p;

    private async Task AjouterAsync(long produitId)
    {
        controle = true;
        if (GrossisteManque) { erreur = "Choisissez un grossiste."; await champGrossiste.FocusAsync(); return; }
        if (QuantiteInvalide) { erreur = "Quantité à commander entre 1 et 10 000."; await champQuantite.FocusAsync(); return; }
        await Executer(async () =>
        {
            var (r, e) = await Api.AjouterACommandeAsync(fournisseurId, produitId, quantite, prix);
            if (e is not null) return e;
            message = $"Ajouté au bon de {fournisseurs.First(f => f.Id == fournisseurId).RaisonSociale}.";
            (produitChoisi, quantite, prix) = (null, 1, null);
            controle = false;
            choixProduit?.Afficher(null);
            await RechargerAsync();
            await OuvrirAsync(r!.Id);
            return null;
        });
    }

    private async Task AjouterSuggestionAsync(SuggestionCommandeDto s)
    {
        if (s.DernierFournisseurId is null && fournisseurId == 0) { erreur = Api.SignalerChamp("grossiste", "Choisissez un grossiste."); return; }
        await Executer(async () =>
        {
            var gros = s.DernierFournisseurId ?? fournisseurId;
            var (r, e) = await Api.AjouterACommandeAsync(gros, s.ProduitId, Math.Max(1, s.QteSuggeree), null);
            if (e is not null) return e;
            message = $"{s.Produit} : {Math.Max(1, s.QteSuggeree)} boîte(s) ajoutée(s) au bon de {s.DernierFournisseur ?? "ce grossiste"}.";
            suggestions.Remove(s);
            totalSuggestions--;
            await RechargerAsync();
            await OuvrirAsync(r!.Id);
            return null;
        });
    }

    private async Task OuvrirAsync(long id)
    {
        var (d, e) = await Api.CommandeAchatAsync(id);
        if (e is not null) { erreur = e; return; }
        detail = d;
        lignesEdition = d!.Lignes.Select(l => new LigneEdition(l)).ToList();
    }

    private async Task EnregistrerLigneAsync(LigneEdition l) => await Executer(async () =>
    {
        var e = await Api.ModifierLigneCommandeAsync(detail!.Entete.Id, l.Id, Math.Max(0, l.Quantite), l.Prix);
        if (e is not null) return e;
        await RechargerAsync();
        await OuvrirAsync(detail.Entete.Id);
        return null;
    });

    private async Task EmettreAsync() => await Executer(async () =>
    {
        var (pdf, nom, e) = await Api.EmettreCommandeAsync(detail!.Entete.Id);
        if (e is not null) return e;
        var doc = await Documents.RangerAsync(Api, "Commandes", nom!, pdf!);
        Documents.Ouvrir(doc.CheminLocal);
        message = $"Bon {detail.Entete.Numero} émis : PDF rangé ({doc.Emplacement}), à transmettre au grossiste.";
        if (doc.Erreur is not null) message += " " + doc.Erreur;
        await RechargerAsync();
        await OuvrirAsync(detail.Entete.Id);
        return null;
    });

    private async Task ImprimerAsync() => await Executer(async () =>
    {
        var (pdf, nom, e) = await Api.BonCommandeAsync(detail!.Entete.Id);
        if (e is not null) return e;
        var doc = await Documents.RangerAsync(Api, "Commandes", nom!, pdf!);
        Documents.Ouvrir(doc.CheminLocal);
        return doc.Erreur;
    });

    private async Task AnnulerAsync() => await Executer(async () =>
    {
        var e = await Api.AnnulerCommandeAsync(detail!.Entete.Id);
        if (e is not null) return e;
        message = $"Bon {detail.Entete.Numero} annulé.";
        await RechargerAsync();
        await OuvrirAsync(detail.Entete.Id);
        return null;
    });

    private async Task Executer(Func<Task<string?>> action)
    {
        (enCours, erreur, message) = (true, null, null);
        try { erreur = await action(); }
        finally { enCours = false; }
    }
}
