@implements IDisposable
@inject ApiClient Api
@inject SessionPoste Session
@inject DemandesAutorisation Demandes

@* Fiche de création d'un produit absent du catalogue (droit catalogue.creer) *@
<section class="panneau fiche-produit" aria-labelledby="t-nouveau-produit">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px">
        <h2 id="t-nouveau-produit">Nouveau produit</h2>
        <button type="button" class="btn" @onclick="OnAnnule">Annuler</button>
    </div>
    <p class="detail" style="margin: 0">Le produit est créé sans stock : il sera vendable après une réception. La création est inscrite au journal.</p>
    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }

    @* Écran fixe (charte) : le formulaire défile dans son cadre, « Créer le produit » reste visible en dessous *@
    <div class="cadre-defilant fiche-produit-champs">

    @* Catégorie en premier (2026-11-20) : parapharmacie (catégorie non médicament) = DCI, dosage et forme facultatifs, classe libre, TVA 19 % proposée.
       Sur la même ligne que la recherche dans la nomenclature : la fiche ne grandit pas *@
    <div class="achats-ligne">
    <div class="champ" style="flex: 0 1 260px">
        <label for="p-cat">Catégorie</label>
        <select id="p-cat" data-champ="categorie" @bind="categorie" @bind:after="CategorieChangee">
            @foreach (var cat in categories) { <option value="@cat.Code">@cat.Libelle@(cat.Medicament ? "" : " (parapharmacie)")</option> }
        </select>
    </div>
    @* Nomenclature nationale : propositions pendant la frappe (composant commun), au clavier ; un médicament déjà au catalogue est signalé *@
    <ChampSuggestions TItem="MedicamentNomenclatureDto" @ref="champNomenclature" Id="p-nomenclature" Rechercher="RechercherNomenclatureAsync"
                      TexteDe="TexteNomenclature" DetailDe="DetailNomenclature" LibelleAucun="médicament"
                      ComplementAucun="@AucunMedicament" Style="flex: 1 1 360px"
                      LibelleListe="Médicaments de la nomenclature" Libelle="Chercher dans la nomenclature nationale (nom, DCI ou n° d’enregistrement)"
                      OnChoisi="Choisir" placeholder="ex. lyrica, prégabaline, 595/15 A 068/06/22">
        <Complement Context="m">
            <span style="display: flex; flex-direction: column; align-items: flex-end; gap: 4px">
                @if (m.DejaAuCatalogue) { <span class="pastille info">Déjà au catalogue</span> }
                else if (m.Situation != "en_vigueur") { <span class="pastille attention">@Libelles.SituationNomenclature(m.Situation)</span> }
                @if (Libelles.EstSousRegistre(m.ClasseProposee)) { <span class="pastille urgent">@Libelles.Classe(m.ClasseProposee)</span> }
            </span>
        </Complement>
    </ChampSuggestions>
    </div>
    @if (!Medicament)
    {
        <div class="info-bandeau" role="status">Parapharmacie : DCI, dosage et forme facultatifs, classe « Libre » ; TVA : taux par défaut de la catégorie (modifiable). À la caisse, une remise (et non un don).</div>
    }
    @if (choisi is not null)
    {
        <div class="@(choisi.Situation == "en_vigueur" ? "info-bandeau" : "erreur")" role="status">
            Fiche remplie depuis la nomenclature : n° @choisi.NumEnregistrement · @choisi.Laboratoire (@choisi.Pays) · @Libelles.SituationNomenclature(choisi.Situation).
            @if (choisi.Situation != "en_vigueur") { <text> Vérifiez avant de le référencer.</text> }
            Complétez le prix public.
        </div>
    }

    <div class="achats-ligne">
        <div class="champ" style="flex: 2 1 240px"><label for="p-nom" class="requis">Nom commercial</label><input id="p-nom" data-champ="nom_commercial" type="text" @ref="champNom" @bind="nom" @bind:event="oninput" placeholder="ex. Sintrom 4 mg cp"
            class="@Obligatoire.Classe(NomManque)" aria-invalid="@Obligatoire.Aria(NomManque)" /></div>
        <ChampSuggestions TItem="string" @ref="champDci" Id="p-dci" Mode="ModeSuggestions.ValeurLibre" Rechercher="Api.DciAsync" TexteDe="d => d"
                          Libelle="DCI" Requis="Medicament" Invalide="DciManque" LibelleListe="DCI existantes" Style="flex: 2 1 220px" @bind-Valeur="dci"
                          placeholder="ex. acénocoumarol" class="@Obligatoire.Classe(DciManque)" />
    </div>
    <div class="achats-ligne">
        <div class="champ" style="flex: 1 1 120px"><label for="p-dosage" class="@(Medicament ? "requis" : null)">Dosage</label><input id="p-dosage" type="text" @ref="champDosage" @bind="dosage" @bind:event="oninput" placeholder="ex. 4 mg"
            class="@Obligatoire.Classe(DosageManque)" aria-invalid="@Obligatoire.Aria(DosageManque)" /></div>
        @* Forme : formes déjà saisies au catalogue, puis les formes usuelles (fusion sans doublon) ; texte libre accepté *@
        <ValeursSaisies @ref="champForme" Id="p-forme" Champ="forme_produit" Libelle="Forme" Requis="Medicament" Invalide="FormeManque" Style="flex: 1 1 140px"
                        ValeursDeDepart="FormesUsuelles" @bind-Valeur="forme" placeholder="ex. comprimé" class="@Obligatoire.Classe(FormeManque)" />
        <div class="champ" style="flex: 1 1 140px@(PrixDebloque ? null : "; opacity: .6")" title="@(PrixDebloque ? null : MentionPrix)"><label for="p-prix" class="@(PeutPrix ? "requis" : null)">Prix public (DA)@(PrixDebloque ? null : " : à faire valider par un ayant droit")</label><input id="p-prix" disabled="@(!PrixDebloque)" data-champ="prix_public" type="number" min="0" step="0.01" @ref="champPrix" @bind="prix"
            class="@Obligatoire.Classe(PrixManque)" aria-invalid="@Obligatoire.Aria(PrixManque)" /></div>
        <div class="champ" style="flex: 1 1 160px">
            <label for="p-classe" class="requis">Classe</label>
            <select data-champ="classe" id="p-classe" @bind="classe" disabled="@(!Medicament)" title="@(Medicament ? null : "Parapharmacie : classe « Libre » seulement")">
                <option value="libre">Libre</option><option value="liste_i">Liste I</option><option value="liste_ii">Liste II</option>
                <option value="psychotrope">Psychotrope</option><option value="stupefiant">Stupéfiant</option>
            </select>
        </div>
        @if (classe == "psychotrope")
        {
            <div class="champ" style="flex: 1 1 180px">
                <label for="p-liste">Liste du psychotrope (SHP)</label>
                <select id="p-liste" data-champ="liste_psychotrope" @bind="listePsychotrope">
                    <option value="">À indiquer (SHP 0)</option><option value="liste_i">Liste I (2,50 DA)</option><option value="liste_ii">Liste II (1,50 DA)</option>
                </select>
            </div>
        }
    </div>
    <div class="achats-ligne">
        <div class="champ" style="flex: 1 1 180px"><label for="p-cb">Code-barres (facultatif)</label><input id="p-cb" data-champ="code_barre" type="text" inputmode="numeric" @bind="codeBarre" /></div>
        <div class="champ" style="flex: 1 1 160px@(PrixDebloque ? null : "; opacity: .6")" title="@(PrixDebloque ? null : MentionPrix)"><label for="p-tarif" class="@(remboursable ? "requis" : null)">Tarif de référence (DA)@(PrixDebloque ? null : " : à faire valider par un ayant droit")</label><input id="p-tarif" disabled="@(!PrixDebloque)" data-champ="tarif_reference" type="number" min="0" step="0.01" @ref="champTarif" @bind="tarif"
            class="@Obligatoire.Classe(TarifManque)" aria-invalid="@Obligatoire.Aria(TarifManque)" /></div>
        <div class="champ" style="flex: 0 0 110px"><label for="p-tva">TVA</label><ChoixTauxTva Id="p-tva" @bind-Value="tva" /></div>
        <div class="champ" style="flex: 0 0 200px"><label for="p-min">Seuil d’alerte (boîtes)</label><input id="p-min" data-champ="stock_minimum" type="number" min="0" placeholder="automatique" @bind="stockMin" /></div>
        <label class="case" style="align-self: center@(PrixDebloque ? null : "; opacity: .6")" title="@(PrixDebloque ? null : MentionPrix)"><input type="checkbox" disabled="@(!PrixDebloque)" @bind="remboursable" /><span>Remboursable@(PrixDebloque ? null : " (à faire valider par un ayant droit)")</span></label>
    </div>
    @if (!PeutPrix)
    {
        @if (accordPrix is { } a)
        {
            <div class="info-bandeau" role="status">Prix débloqués : autorisation de @a.Nom, jointe à la création du produit.</div>
        }
        else
        {
            <div class="achats-ligne" style="align-items: center">
                <div class="detail" role="note" style="flex: 1 1 320px">@MentionPrix</div>
                <button type="button" class="btn" disabled="@enCours" @onclick="FaireAutoriserPrixAsync">Faire autoriser</button>
            </div>
        }
    }
    </div>
    <div><button type="button" class="btn btn-principal" disabled="@enCours" @onclick="CreerAsync">Créer le produit</button></div>
</section>

@code {
    [Parameter] public string? CodeBarreInitial { get; set; }
    [Parameter] public string? NomInitial { get; set; }
    /// <summary>Produit créé ; Information : message du serveur à afficher (classe imposée, produit à vérifier), sinon null.</summary>
    [Parameter] public EventCallback<(long Id, string Nom, string? Information)> OnCree { get; set; }
    [Parameter] public EventCallback OnAnnule { get; set; }

    private string? nom, dci, dosage, forme, codeBarre;
    private decimal prix;
    private decimal? tarif;
    private decimal tva;
    private int? stockMin;
    private bool remboursable;
    private string classe = "libre";
    private string categorie = "medicament";
    private string listePsychotrope = "";
    private List<CategorieProduitDto> categories = [new("medicament", "Médicament", true)];
    private bool enCours;
    private string? erreur;

    // Champs obligatoires (RegleProduit) : en rouge après un premier essai de création
    private bool controle;
    private ElementReference champNom, champDosage, champPrix, champTarif;
    private ChampSuggestions<string>? champDci;
    private ValeursSaisies? champForme;
    private ChampSuggestions<MedicamentNomenclatureDto>? champNomenclature;

    /// <summary>Formes usuelles proposées quand le catalogue n'en donne pas encore (fusionnées sans doublon avec les formes déjà saisies).</summary>
    public static readonly IReadOnlyList<string> FormesUsuelles = ["comprimé", "gélule", "sirop", "ampoule", "injectable", "pommade", "collyre", "sachet", "stylo"];
    private bool NomManque => Obligatoire.Manque(controle, nom);
    // DCI, dosage et forme : obligatoires pour un médicament seulement (parapharmacie : facultatifs, RegleProduit)
    private bool DciManque => Medicament && Obligatoire.Manque(controle, dci);
    private bool DosageManque => Medicament && Obligatoire.Manque(controle, dosage);
    private bool FormeManque => Medicament && Obligatoire.Manque(controle, forme);

    /// <summary>Catégorie choisie : médicament (vrai par défaut, catégorie inconnue comprise) ou parapharmacie.</summary>
    private bool Medicament => categories.FirstOrDefault(c => c.Code == categorie)?.Medicament ?? true;
    /// <summary>Taux de TVA (script 171) : taux proposé par catégorie (Administration › Réglages fiscaux).</summary>
    private ListeTauxTvaDto? tauxTva;

    /// <summary>
    /// Parapharmacie : classe libre. TVA : le taux par défaut de la catégorie (Administration › Réglages fiscaux, script 171) remplace la
    /// TVA ; catégorie sans taux par défaut : la TVA saisie est gardée.
    /// </summary>
    private void CategorieChangee()
    {
        if (!Medicament) (classe, listePsychotrope) = ("libre", "");
        if (tauxTva?.Categories.FirstOrDefault(c => c.Code == categorie)?.Taux is { } defaut) tva = defaut;
    }
    // Un seul droit pour toute saisie de prix (prix.modifier, décision du titulaire du 2026-11-15) : sans ce droit, les champs de prix
    // sont grisés ; laissés vides, le produit est créé sans prix (invendable jusqu'à ce qu'un ayant droit fixe son prix) ; remplis,
    // le serveur refuse et la fenêtre « Faire autoriser » s'ouvre à l'enregistrement.
    private bool PeutPrix => Session.A("prix.modifier");
    // « Faire autoriser » (décision du titulaire, 2026-11-15) : un ayant droit donne son code, les champs de prix se débloquent et
    // l'autorisation est jointe à la création (X-Pharma-Autorise-Par) ; un code faux rouvre la fenêtre à l'enregistrement
    private (string Identifiant, string Code, string Nom)? accordPrix;
    private bool PrixDebloque => PeutPrix || accordPrix is not null;

    // Fiche fermée (« Annuler » de la page, autre écran) : la fenêtre « Faire autoriser » qu'elle a ouverte se ferme avec elle
    private Task<(string Identifiant, string Code)?>? demandePrix;
    public void Dispose() => Demandes.Abandonner(demandePrix);

    private async Task FaireAutoriserPrixAsync()
    {
        var r = await (demandePrix = Demandes.DemanderAsync("Saisir le prix public, le tarif de référence et le remboursement du nouveau produit demande le droit « modifier un prix de vente ».", "prix.modifier"));
        demandePrix = null;
        if (r is not { } a) return;
        var (valideurs, _) = await Api.ValideursAsync("prix.modifier", null);
        accordPrix = (a.Identifiant, a.Code, valideurs.FirstOrDefault(v => v.Reference == a.Identifiant)?.NomComplet ?? "l’ayant droit");
    }
    private const string MentionPrix = "Prix public, tarif de référence et remboursement : à faire valider par un ayant droit (droit « modifier un prix de vente »). Laissés vides, le produit est créé sans prix et reste invendable jusqu’à ce qu’un ayant droit fixe son prix.";
    private bool PrixManque => controle && (PeutPrix ? prix <= 0 : prix < 0);
    private bool TarifManque => controle && remboursable && tarif is null;

    protected override async Task OnInitializedAsync()
    {
        (codeBarre, nom) = (CodeBarreInitial, NomInitial);
        if ((await Api.CategoriesProduitsAsync()) is ({ Count: > 0 } liste, null)) categories = liste;
        (tauxTva, _) = await Api.TauxTvaAsync();
        CategorieChangee();
    }

    // Nomenclature nationale : la fiche est remplie depuis le médicament choisi
    private MedicamentNomenclatureDto? choisi;
    private bool nomenclatureVide;
    private bool? nomenclatureImportee;

    private string AucunMedicament =>
        $" dans la nomenclature{(nomenclatureVide ? " (pas encore importée : Administration, Nomenclature nationale)" : "")} : saisissez la fiche à la main";

    private static string TexteNomenclature(MedicamentNomenclatureDto m) => m.Marque ?? m.Dci ?? m.NumEnregistrement ?? "";

    private static string DetailNomenclature(MedicamentNomenclatureDto m) =>
        $"{string.Join(" · ", new[] { m.Dosage, m.Forme, m.Conditionnement }.Where(t => !string.IsNullOrWhiteSpace(t)))} — {string.Join(" · ", new[] { m.Dci, m.Laboratoire }.Where(t => !string.IsNullOrWhiteSpace(t)))}";

    private async Task<(List<MedicamentNomenclatureDto>, string?)> RechercherNomenclatureAsync(string q)
    {
        var (liste, e) = await Api.RechercherNomenclatureAsync(q);
        // Rien trouvé : la nomenclature est-elle seulement importée ? (message « Aucun médicament … »)
        if (liste.Count == 0 && e is null)
        {
            // Lu une fois : la recherche ne répond rien sous 2 lettres (l'ancien essai avec « a » concluait toujours « pas importée »)
            if (nomenclatureImportee is null)
            {
                var (oui, erreurEtat) = await Api.NomenclatureImporteeAsync();
                nomenclatureImportee = erreurEtat is null ? oui : true;   // état illisible : pas de message trompeur
            }
            nomenclatureVide = nomenclatureImportee == false;
            StateHasChanged();
        }
        return (liste, e);
    }

    private void Choisir(MedicamentNomenclatureDto m)
    {
        champNomenclature?.Afficher("");
        // Médicament déjà au catalogue : rien n'est rempli (on ne le crée pas deux fois)
        if (m.DejaAuCatalogue) { erreur = $"« {TexteNomenclature(m)} » est déjà au catalogue : cherchez-le dans le catalogue."; return; }
        erreur = null;
        choisi = m;
        nom = m.Marque;
        dci = m.Dci;
        dosage = m.Dosage;
        forme = m.Forme;
        classe = m.ClasseProposee;
        // Médicament de la nomenclature : jamais de la parapharmacie
        categorie = "medicament";
        CategorieChangee();
    }

    private async Task CreerAsync()
    {
        (erreur, controle) = (null, true);
        // Premier champ manquant : message et curseur dessus, sans appel au serveur
        (Func<ValueTask> Focus, string Message)? manquant =
            NomManque ? (() => champNom.FocusAsync(), "Nom commercial obligatoire.")
            : DciManque ? (() => champDci?.FocusAsync() ?? ValueTask.CompletedTask, "DCI obligatoire.")
            : DosageManque ? (() => champDosage.FocusAsync(), "Dosage obligatoire.")
            : FormeManque ? (() => champForme?.FocusAsync() ?? ValueTask.CompletedTask, "Forme obligatoire.")
            : PrixManque ? (() => champPrix.FocusAsync(), "Le prix public doit être supérieur à 0.")
            : TarifManque ? (() => champTarif.FocusAsync(), "Un produit remboursable a besoin d’un tarif de référence.")
            : null;
        if (manquant is { } m) { erreur = m.Message; await m.Focus(); return; }

        enCours = true;
        try
        {
            if (!PeutPrix && accordPrix is { } a) Api.AutoriserProchaineAction(a.Identifiant, a.Code, "prix.modifier");
            var (r, e) = await Api.CreerProduitAsync(new NouveauProduitDto(nom, dci, dosage, forme, prix, classe, codeBarre, tarif, remboursable, tva, stockMin,
                choisi?.NumEnregistrement, categorie, string.IsNullOrEmpty(listePsychotrope) ? null : listePsychotrope));
            if (e is not null) { erreur = e; return; }
            controle = false;
            await OnCree.InvokeAsync((r!.Id, nom!.Trim(), r.Information));
            Vider();
        }
        finally { enCours = false; }
    }

    /// <summary>Produit créé : formulaire vidé, prêt pour le suivant (les valeurs initiales ne sont pas reprises : elles ont servi).</summary>
    private void Vider()
    {
        (nom, dci, dosage, forme, codeBarre, prix, tarif, tva, stockMin, remboursable) = (null, null, null, null, null, 0, null, 0, null, false);
        (classe, categorie, listePsychotrope, choisi, erreur, controle) = ("libre", "medicament", "", null, null, false);
        (nomenclatureVide, accordPrix) = (false, null);
        if (tauxTva?.Categories.FirstOrDefault(c => c.Code == categorie)?.Taux is { } defaut) tva = defaut;   // taux par défaut (script 171)
        champNomenclature?.Afficher("");
    }
}
