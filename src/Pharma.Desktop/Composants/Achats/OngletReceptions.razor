    /// <summary>Planche PDF ouverte (toute imprimante) et envoi ZPL si une imprimante thermique est déclarée.</summary>
    private async Task ImprimerEtiquettesAsync(long receptionId)
    {
        (impression, infoEtiquettes) = (true, null);
        try
        {
            var (e, err) = await Api.EtiquettesReceptionAsync(receptionId);
            if (err is not null) { (infoEtiquettes, erreur) = (null, err); return; }
            var doc = await Documents.RangerAsync(Api, "Etiquettes", $"etiquettes_reception_{receptionId}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf", Convert.FromBase64String(e!.PdfBase64));
            erreur = doc.Erreur;
            infoEtiquettes = $"{e.Codes.Count} étiquette(s) ({e.Codes[0]} à {e.Codes[^1]}) : planche PDF ouverte.";
            if (Imprimante.EstConfiguree)
                infoEtiquettes += await Imprimante.EnvoyerAsync(e.Zpl) is { } echec ? $" {echec}" : " Envoyées à l’imprimante thermique.";
            Documents.Ouvrir(doc.CheminLocal);
        }
        finally { impression = false; }
    }

    /// <summary>« Nouvelle réception » après validation, ou « Abandonner » : dans ce cas les scans du mobile reviennent en attente.</summary>
    private async Task Nouvelle()
    {
        var aRemettre = resultat is null ? lignes.SelectMany(l => l.ScansMobile).ToList() : [];
        lignes.Clear();
        (resultat, commandeId, numeroBl, numeroFacture, infoScan, erreur, infoEtiquettes) = (null, 0, null, null, null, null, null); dateFacture = null;
        (dejaRecues, timbre) = ([], 0);
        (aFacturer, ecartFacture, aRecompter, empreinteInitiale) = (null, null, null, null);
        await ChargerComptagesAsync();
        accordBlocage.Effacer();
        controle = false;
        await RemettreScansAsync(aRemettre);
        Nav.NavigateTo("achats?onglet=receptions");
    }

    // ---- Réceptions en attente : saisie mise de côté sur le serveur (bouton, départ de l'écran, déconnexion), reprise partout ----
    [System.Reflection.Obfuscation(Exclude = true, ApplyToMembers = true)]
    private sealed record LigneMiseDeCote(long ProduitId, string Nom, string NumeroLot, DateOnly? Peremption, int Quantite, decimal Prix, decimal RemisePct,
        int Ug, bool UgCoutReparti, bool RemplacerPrixCatalogue, decimal? Ppa, decimal? Shp, int? Commandee, string? Gtin, List<string> Series,
        int SansSerie, int? QuantiteSaisie, int? QuantiteMobile, List<long> ScansMobile, bool LotSepare, bool EntrerBloque);
    [System.Reflection.Obfuscation(Exclude = true, ApplyToMembers = true)]
    private sealed record ReceptionMiseDeCote(long FournisseurId, long CommandeId, string? NumeroBl, string? NumeroFacture, decimal Timbre,
        ComptageAFacturerDto? AFacturer, ComptageAFacturerDto? ARecompter, List<LigneMiseDeCote> Lignes);

    private List<ReceptionEnAttenteDto> attentes = [];
    // Réceptions en attente : filtres et page (liste courte, traitée sur le poste)
    private string faTexte = "", faMode = "", faEmploye = "";
    private int pageAttentes = 1, tailleAttentes = Pagination.TailleParDefaut;
    private bool FiltreAttentesActif => faTexte.Trim() != "" || faMode != "" || faEmploye != "";
    private List<ReceptionEnAttenteDto> AttentesFiltrees => attentes.Where(a =>
        (faMode == "" || a.Mode == faMode) && (faEmploye == "" || a.Employe == faEmploye)
        && RechercheTexte.Contient(faTexte, a.Libelle)).ToList();
    private List<ReceptionEnAttenteDto> AttentesPage =>
        AttentesFiltrees.Skip((Math.Min(pageAttentes, Math.Max(1, (AttentesFiltrees.Count + tailleAttentes - 1) / tailleAttentes)) - 1) * tailleAttentes).Take(tailleAttentes).ToList();
    /// <summary>Reprise depuis « En attente » : la saisie s'affiche dans « Réceptionner » (même onglet, rien n'est mis en attente).</summary>
    private void AllerSaisie() { if (Vue is "attente" or "historique") Nav.NavigateTo("achats?onglet=receptions&vue=saisie"); }

    private void EffacerFiltresAttentes() => (faTexte, faMode, faEmploye, pageAttentes) = ("", "", "", 1);
    private string? erreurAttente, messageAttente;
    private long? aAbandonner, receptionMiseDeCoteEnPartant;

    /// <summary>Une livraison est en cours de saisie (pas encore validée) : à mettre en attente plutôt qu'à perdre.</summary>
    // Facture validée avec un écart (ecartFacture) : la saisie est terminée, rien à mettre en attente en quittant l'écran (2026-11-15)
    // Facture ou recompte d'un BL compté ouvert puis laissé tel quel : rien à mettre en attente (pas de réception fantôme, 2026-11-15)
    private bool SaisieEnCours => resultat is null && ecartFacture is null && (lignes.Count > 0 || aFacturer is not null || aRecompter is not null)
        && !(empreinteInitiale is not null && Empreinte() == empreinteInitiale);

    // État de la saisie juste après l'ouverture d'un BL compté (« Saisir la facture », « Recompter ») ; null sinon
    private string? empreinteInitiale;
    private string Empreinte() => System.Text.Json.JsonSerializer.Serialize(new
    {
        fournisseurId, numeroBl, numeroFacture, timbre, commandeId,
        Lignes = lignes.Select(l => new
        {
            l.ProduitId, l.NumeroLot, l.Peremption, l.Quantite, l.Prix, l.RemisePct, l.Ug, l.UgCoutReparti, l.RemplacerPrixCatalogue,
            l.Ppa, l.Shp, Series = l.Series.Count, l.SansSerie, l.QuantiteSaisie, l.QuantiteMobile, Scans = l.ScansMobile.Count, l.LotSepare
        })
    });

    private string ModeSaisie => aRecompter is not null ? "recompte" : aFacturer is not null ? "facture" : Comptage ? "comptage" : "reception";

    private static string LibelleMode(string mode) => mode switch
    {
        "recompte" => "Recompte", "facture" => "Facture d’un BL compté", "comptage" => "Comptage à l’aveugle", _ => "Réception"
    };

    private async Task ChargerAttentesAsync() => (attentes, _) = await Api.ReceptionsEnAttenteAsync();

    /// <summary>Saisie de l'écran en requête de mise en attente (calculée sans attendre : utilisable juste avant une déconnexion).</summary>
    private MiseEnAttenteReceptionRequete Demande()
    {
        var bl = numeroBl ?? aFacturer?.NumeroBl ?? aRecompter?.NumeroBl;
        var grossiste = fournisseurs.FirstOrDefault(f => f.Id == (fournisseurId > 0 ? fournisseurId : aFacturer?.FournisseurId ?? aRecompter?.FournisseurId ?? 0))?.RaisonSociale;
        var libelle = string.Join(" · ", new[] { LibelleMode(ModeSaisie), bl is null ? null : $"BL {bl}", grossiste }.Where(x => x is not null));
        var contenu = new ReceptionMiseDeCote(fournisseurId, commandeId, numeroBl, numeroFacture, timbre, aFacturer, aRecompter,
            lignes.Select(l => new LigneMiseDeCote(l.ProduitId, l.Nom, l.NumeroLot, l.Peremption, l.Quantite, l.Prix, l.RemisePct, l.Ug, l.UgCoutReparti,
                l.RemplacerPrixCatalogue, l.Ppa, l.Shp, l.Commandee, l.Gtin, l.Series.ToList(), l.SansSerie, l.QuantiteSaisie, l.QuantiteMobile,
                l.ScansMobile.ToList(), l.LotSepare, l.EntrerBloque)).ToList());
        return new MiseEnAttenteReceptionRequete(libelle, ModeSaisie, lignes.Count, System.Text.Json.JsonSerializer.Serialize(contenu),
            lignes.SelectMany(l => l.ScansMobile).Distinct().ToList());
    }

    /// <summary>Écran vidé après une mise en attente : les scans du mobile restent avec la réception en attente (pas de remise).</summary>
    private void ViderSaisie()
    {
        lignes.Clear();
        (resultat, commandeId, numeroBl, numeroFacture, infoScan, erreur, infoEtiquettes) = (null, 0, null, null, null, null, null); dateFacture = null;
        (dejaRecues, timbre) = ([], 0);
        (aFacturer, ecartFacture, aRecompter, empreinteInitiale) = (null, null, null, null);
        accordBlocage.Effacer();
        controle = false;
    }

    /// <summary>Met la saisie en attente ; renvoie son numéro, ou null (erreur affichée).</summary>
    private async Task<long?> MettreDeCoteAsync()
    {
        erreurAttente = null;
        if (!SaisieEnCours) return null;
        var (id, e) = await Api.MettreReceptionEnAttenteAsync(Demande());
        if (e is not null) { erreurAttente = e; return null; }
        ViderSaisie();
        await ChargerAttentesAsync();
        return id;
    }

    private async Task MettreEnAttenteAsync()
    {
        if (enCours) return;
        enCours = true;
        try { if (await MettreDeCoteAsync() is not null) messageAttente = "Réception mise en attente : reprenez-la dans « Réceptions en attente », depuis n’importe quel poste."; }
        finally { enCours = false; }
    }

    /// <summary>Reprise : la saisie en cours (s'il y en a une) part d'abord en attente, rien n'est perdu.</summary>
    private async Task ReprendreAsync(long id)
    {
        if (enCours) return;
        enCours = true;
        try
        {
            (erreurAttente, messageAttente) = (null, null);
            if (SaisieEnCours && await MettreDeCoteAsync() is null) return;
            var (json, e) = await Api.ReprendreReceptionEnAttenteAsync(id);
            if (e is not null) { erreurAttente = e; await ChargerAttentesAsync(); return; }
            var r = System.Text.Json.JsonSerializer.Deserialize<ReceptionMiseDeCote>(json!)!;
            ViderSaisie();
            (fournisseurId, commandeId, numeroBl, numeroFacture, timbre, aFacturer, aRecompter) =
                (r.FournisseurId, r.CommandeId, r.NumeroBl, r.NumeroFacture, r.Timbre, r.AFacturer, r.ARecompter);
            foreach (var l in r.Lignes)
            {
                // Infos d'achat (TVA, SHP, prix public) rechargées à l'affichage, comme pour une ligne ajoutée
                var ligne = new Ligne
                {
                    ProduitId = l.ProduitId, Nom = l.Nom, NumeroLot = l.NumeroLot, Peremption = l.Peremption, Quantite = l.Quantite, Prix = l.Prix,
                    RemisePct = l.RemisePct, Ug = l.Ug, UgCoutReparti = l.UgCoutReparti, RemplacerPrixCatalogue = l.RemplacerPrixCatalogue, Ppa = l.Ppa,
                    Shp = l.Shp, Commandee = l.Commandee, Gtin = l.Gtin, SansSerie = l.SansSerie, QuantiteSaisie = l.QuantiteSaisie,
                    QuantiteMobile = l.QuantiteMobile, LotSepare = l.LotSepare, EntrerBloque = l.EntrerBloque
                };
                ligne.Series.AddRange(l.Series);
                ligne.ScansMobile.AddRange(l.ScansMobile);
                lignes.Add(ligne);
            }
            await ChargerAttentesAsync();
            AllerSaisie();
        }
        finally { enCours = false; }
    }

    /// <summary>Abandon d'une réception en attente : ses scans du mobile reviennent en attente d'import (serveur), inscrit au journal.</summary>
    private async Task AbandonnerAsync(long id)
    {
        if (enCours) return;
        enCours = true;
        try
        {
            (erreurAttente, messageAttente, aAbandonner) = (await Api.AbandonnerReceptionEnAttenteAsync(id), null, null);
            await ChargerAttentesAsync();
            await CompterScansMobileAsync();
        }
        finally { enCours = false; }
    }

    /// <summary>
    /// Avant de quitter l'onglet (autre onglet d'Achats, autre écran, « Retour ») : la saisie en cours part en attente.
    /// Si la mise en attente échoue, ou pendant un enregistrement, on reste sur l'écran avec le message.
    /// </summary>
    private async Task<bool> QuitterAsync(string cible)
    {
        if (HistoriqueNavigation.Chemin(cible) == "achats" && HistoriqueNavigation.Parametre(cible, "onglet") == "receptions") return true;
        receptionMiseDeCoteEnPartant = null;
        if (!SaisieEnCours) return true;
        if (enCours) { erreurAttente = "Enregistrement en cours : attendez la fin avant de quitter la réception."; await InvokeAsync(StateHasChanged); return false; }
        enCours = true;
        try { receptionMiseDeCoteEnPartant = await MettreDeCoteAsync(); }
        finally { enCours = false; }
        if (receptionMiseDeCoteEnPartant is null)
        {
            erreurAttente ??= "La réception n’a pas pu être mise en attente : l’écran reste affiché pour ne pas perdre la saisie.";
            await InvokeAsync(StateHasChanged);
            return false;
        }
        return true;
    }

    /// <summary>Déconnexion (bouton, changement d'utilisateur, inactivité) : la saisie en cours part en attente, rien n'est perdu.</summary>
    private void MettreDeCoteADeconnexion()
    {
        if (!SaisieEnCours) return;
        // Requête préparée et envoyée tout de suite : le jeton est lu avant que la session ne soit fermée
        var demande = Demande();
        var envoi = Api.MettreReceptionEnAttenteAsync(demande);
        ViderSaisie();
        // « Changer d'utilisateur » : le suivant la voit dans le bandeau des tâches laissées et la reprend d'un clic
        if (Session.ChangementUtilisateur) _ = SignalerAuSuivantAsync(envoi, demande, Session.NomComplet ?? "l’employé précédent");
    }

    private async Task SignalerAuSuivantAsync(Task<(long? Id, string? Erreur)> envoi, MiseEnAttenteReceptionRequete demande, string quitte)
    {
        var (id, _) = await envoi;
        if (id is { } v)
            Taches.Ajouter(new TacheLaissee("reception", demande.Libelle ?? "Réception", quitte, "achats.receptionner",
                v.ToString(System.Globalization.CultureInfo.InvariantCulture), DateTime.Now, demande.Mode is "comptage" or "recompte"));
    }

    /// <summary>Retour sur l'onglet : la réception mise en attente en partant est reprise, si personne ne l'a reprise entre-temps.</summary>
    private async Task ReprendreAuRetourAsync(long id)
    {
        if (attentes.All(a => a.Id != id))
        {
            messageAttente = "La réception mise en attente en quittant l’écran a déjà été reprise ou abandonnée.";
            return;
        }
        await ReprendreAsync(id);
        if (erreurAttente is null) messageAttente = "Réception reprise : elle avait été mise en attente quand vous avez quitté l’écran.";
    }

    public void Dispose()
    {
        Session.AvantFermeture -= MettreDeCoteADeconnexion;
        Historique.Oublier("receptions");
    }
}
