    // ---- Pied de facture, calculé comme sur les factures des grossistes (RegleFactureAchat côté serveur) ----
    private decimal timbre;

    private (decimal Ht, decimal Remise, decimal Tva, decimal Ppa, decimal Shp) Totaux
    {
        get
        {
            var actives = lignes.Where(l => l.Quantite > 0).ToList();
            static decimal A(decimal v) => Math.Round(v, 2, MidpointRounding.AwayFromZero);
            // Boîtes facturées seulement : les unités gratuites ne sont pas facturées
            var ht = actives.Sum(l => A(l.Facturees * l.Prix));
            var remise = A(actives.Sum(l => l.Facturees * l.Prix * l.RemisePct / 100m));
            var tva = A(actives.Sum(l => l.Facturees * l.Prix * (1 - l.RemisePct / 100m) * (l.Info?.TauxTva ?? 0) / 100m));
            return (ht, remise, tva, A(actives.Sum(l => l.Facturees * (l.Ppa ?? 0))), A(actives.Sum(l => l.Facturees * (l.Shp ?? 0))));
        }
    }

    // Lignes ajoutées (saisie, commande, scan, mobile) : infos d'achat chargées une fois, SHP proposé selon la liste du produit
    protected override async Task OnAfterRenderAsync(bool premierRendu)
    {
        var aCharger = lignes.Where(l => l.Info is null && !l.InfoDemandee).ToList();
        if (aCharger.Count == 0) return;
        aCharger.ForEach(l => l.InfoDemandee = true);
        var (infos, _) = await Api.InfosAchatAsync(aCharger.Select(l => l.ProduitId));
        foreach (var l in aCharger)
            if (infos.FirstOrDefault(i => i.ProduitId == l.ProduitId) is { } info)
            {
                l.Info = info;
                l.Shp ??= info.ShpParBoite;
            }
        StateHasChanged();
    }

    // N° de BL ou de facture saisi ou scanné : réceptions de ce grossiste qui le portent déjà (avertissement seulement)
    private List<ReceptionResumeDto> dejaRecues = [];
    private int requeteDocument;

    private async Task DocumentSaisiAsync()
    {
        var n = ++requeteDocument;
        await Task.Delay(300);   // la douchette tape le numéro caractère par caractère : on attend la fin
        if (n != requeteDocument) return;
        var trouvees = new List<ReceptionResumeDto>();
        foreach (var (valeur, mettre) in new (string?, Action<string>)[] { (numeroBl, v => numeroBl = v), (numeroFacture, v => numeroFacture = v) })
        {
            if (fournisseurId == 0 || string.IsNullOrWhiteSpace(valeur)) continue;
            var (r, _) = await Api.DocumentReceptionAsync(fournisseurId, valeur);
            if (r is null || n != requeteDocument) continue;
            if (r.Numero is { } relu && relu != valeur.Trim()) mettre(relu);   // scan fait en clavier QWERTY : remis en chiffres
            trouvees.AddRange(r.DejaRecues.Where(x => trouvees.All(t => t.Id != x.Id)));
        }
        if (n == requeteDocument) dejaRecues = trouvees;
    }

    /// <summary>Reprend les lignes du bon (reste à recevoir et prix commandé), à compléter avec le lot et la péremption.</summary>
    private async Task ChargerCommandeAsync()
    {
        if (aFacturer is not null) return;   // facture d'une livraison comptée : la commande est seulement rattachée
        lignes.Clear();
        if (commandeId == 0) return;
        var (d, e) = await Api.CommandeAchatAsync(commandeId);
        if (e is not null) { erreur = e; return; }
        foreach (var l in d!.Lignes.Where(l => l.QteRecue < l.QteCommandee))
            lignes.Add(new Ligne { ProduitId = l.ProduitId, Nom = l.Produit, Quantite = l.QteCommandee - l.QteRecue, Prix = l.PrixAchatHt ?? 0, Commandee = l.QteCommandee - l.QteRecue });
    }

