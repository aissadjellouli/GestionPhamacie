    protected override async Task OnInitializedAsync()
    {
        (fournisseurs, erreur) = await Api.FournisseursAsync();
        aveugle = await Api.ReceptionAveugleAsync();
        await ChargerComptagesAsync();
        await ChargerCommandesARecevoirAsync();
        // « ← Retour » : filtres et page de la liste des réceptions retrouvés tels qu'ils étaient
        Historique.Suivre("receptions", e =>
        {
            e.Mettre("grossiste", fFournisseur > 0 ? fFournisseur : null); e.Mettre("du", fDu); e.Mettre("au", fAu); e.Mettre("recherche", fRecherche);
            e.Mettre("page", pageReceptions); e.Mettre("taille", tailleReceptions); e.Mettre("attente", receptionMiseDeCoteEnPartant);
            e.Mettre("fa_texte", faTexte); e.Mettre("fa_mode", faMode); e.Mettre("fa_employe", faEmploye); e.Mettre("fa_page", pageAttentes); e.Mettre("fa_taille", tailleAttentes);
        });
        // Quitter l'onglet ou se déconnecter avec une livraison en cours de saisie : elle part en attente (rien n'est perdu)
        Historique.AvantDeQuitter("receptions", QuitterAsync);
        Session.AvantFermeture += MettreDeCoteADeconnexion;
        await ChargerAttentesAsync();
        var r = Historique.Restaurer("receptions");
        if (r is not null) (fFournisseur, fDu, fAu, fRecherche) = (r.Long("grossiste") ?? 0, r.Date("du"), r.Date("au"), r.Texte("recherche"));
        if (r is not null) (faTexte, faMode, faEmploye, pageAttentes, tailleAttentes) = (r.Texte("fa_texte") ?? "", r.Texte("fa_mode") ?? "", r.Texte("fa_employe") ?? "", r.Entier("fa_page") ?? 1, r.Entier("fa_taille") ?? tailleAttentes);
        await ChargerReceptionsAsync(r?.Entier("page") ?? 1, r?.Entier("taille"));
        await CompterScansMobileAsync();
        // Réception à l'aveugle : le bon de commande (et ses quantités) ne s'ouvre pas au comptage
        if (!Comptage && CommandeId is { } cid && commandes.FirstOrDefault(c => c.Id == cid) is { } c)
        {
            (fournisseurId, commandeId) = (c.FournisseurId, c.Id);
            await ChargerCommandeAsync();
        }
        // « ← Retour » : la réception mise en attente en partant est reprise
        if (r?.Long("attente") is { } enAttente) await ReprendreAuRetourAsync(enAttente);
        // Bandeau « tâches laissées » : réception laissée par l'employé précédent, reprise sans rien refaire
        else if (Taches.PrendreChoisie("reception") is { } t && long.TryParse(t.Contenu, out var laissee))
        {
            await ReprendreAsync(laissee);
            if (erreurAttente is null) messageAttente = $"Réception reprise : {t.LaisseePar} l’a laissée en changeant d’utilisateur.";
        }
    }

    /// <summary>
    /// Bons à recevoir (envoyés ou reçus en partie) : filtrés par le serveur et lus page après page jusqu'au total,
    /// pour qu'aucun bon en cours ne manque, si ancien soit-il. La liste proposée ne garde que ceux du grossiste choisi.
    /// </summary>
    private async Task ChargerCommandesARecevoirAsync()
    {
        var aRecevoir = new List<CommandeAchatDto>();
        foreach (var statut in new[] { "envoyee", "recue_partielle" })
        {
            for (var numero = 1; ; numero++)
            {
                var (p, e) = await Api.CommandesAchatAsync(numero, 200, statut: statut);
                if (p is null) { erreur ??= e; break; }
                aRecevoir.AddRange(p.Lignes);
                if (p.Lignes.Count == 0 || numero * p.Taille >= p.Total) break;
            }
        }
        commandes = aRecevoir.OrderByDescending(c => c.Date).ToList();
    }

