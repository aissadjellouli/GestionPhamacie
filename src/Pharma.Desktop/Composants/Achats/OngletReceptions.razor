@implements IDisposable
@inject ApiClient Api
@inject SessionPoste Session
@inject NavigationManager Nav
@inject HistoriqueNavigation Historique
@inject TachesLaissees Taches
@inject ImprimanteEtiquettes Imprimante

@if (erreur is not null)
{
    <div class="erreur" role="alert">@erreur</div>
}
@if (infoComptage is not null)
{
    <div class="succes" role="status">@infoComptage</div>
}

@* Vues (écran fixe, une partie à la fois) : « attente » (réceptions en attente, livraisons comptées), « saisie » (réception en cours), « historique » *@
@if (Vue is "" or "attente")
{
@* Réception à l'aveugle : livraisons comptées dont la facture reste à saisir, et écarts à valider *@
@* Réceptions mises en attente (bouton, départ de l'écran, déconnexion) : reprises depuis n'importe quel poste *@
@if (erreurAttente is not null) { <div class="erreur" role="alert">@erreurAttente</div> }
@if (messageAttente is not null) { <div class="info-bandeau" role="status">@messageAttente</div> }
@* Écran fixe (recette 2026-11-15) : avec des réceptions en attente ET des livraisons comptées, une seule liste à la fois, choisie par deux pastilles *@
@if (DeuxListesAttente)
{
    <div class="filtres" role="group" aria-label="Liste affichée">
        <button type="button" class="puce" aria-pressed="@(partieAttente == "receptions" ? "true" : "false")" @onclick="@(() => partieAttente = "receptions")">Réceptions en attente (@attentes.Count)</button>
        <button type="button" class="puce" aria-pressed="@(partieAttente == "comptees" ? "true" : "false")" @onclick="@(() => partieAttente = "comptees")">Livraisons comptées (@comptages.Count)</button>
    </div>
}
@if ((attentes.Count > 0 || Vue == "attente") && !(DeuxListesAttente && partieAttente == "comptees"))
{
    <section class="panneau" aria-labelledby="t-attente-rec">
        <h2 id="t-attente-rec">Réceptions en attente (@attentes.Count)</h2>
        @* Liste courte (20 au plus, règle métier) : filtrée et paginée sur le poste ; filtres pris dans les réceptions en attente *@
        <div class="filtres-liste" role="search" aria-label="Filtrer les réceptions en attente">
            <div class="champ" style="flex: 1 1 220px"><label for="fa-texte">Grossiste ou n° de BL</label>
                <input id="fa-texte" type="search" autocomplete="off" @bind="faTexte" @bind:event="oninput" @bind:after="() => pageAttentes = 1" /></div>
            <div class="champ" style="flex: 0 0 200px"><label for="fa-mode">Mode</label>
                <select id="fa-mode" @bind="faMode" @bind:after="() => pageAttentes = 1">
                    <option value="">Tous</option>
                    @foreach (var m in attentes.Select(a => a.Mode).Distinct()) { <option value="@m">@LibelleMode(m)</option> }
                </select></div>
            <div class="champ" style="flex: 0 0 220px"><label for="fa-employe">Mise en attente par</label>
                <select id="fa-employe" @bind="faEmploye" @bind:after="() => pageAttentes = 1">
                    <option value="">Tous</option>
                    @foreach (var n in attentes.Select(a => a.Employe).Distinct().Order()) { <option value="@n">@n</option> }
                </select></div>
            @if (FiltreAttentesActif) { <button type="button" class="btn" @onclick="EffacerFiltresAttentes">Tout afficher</button> }
        </div>
        <div class="tableau-cadre" data-hauteur-min="140">
            <table class="tableau" style="min-width: 0">
                <thead><tr><th scope="col">Réception</th><th scope="col" class="nombre">Lignes</th><th scope="col">Mise en attente par</th><th scope="col">Le</th><th scope="col"></th></tr></thead>
                <tbody>
                    @if (AttentesFiltrees.Count == 0)
                    {
                        <tr><td colspan="5" class="vide">@(FiltreAttentesActif ? "Aucune réception en attente pour ces filtres." : "Aucune réception en attente.")
                            @if (!FiltreAttentesActif) { <ActionSuivante Libelle="Réceptionner une livraison" Lien="achats?onglet=receptions&vue=saisie" Droits='["achats.receptionner"]' /> }</td></tr>
                    }
                    @foreach (var a in AttentesPage)
                    {
                        // Comptage à l'aveugle : repris par qui l'a compté ou par qui décide des écarts (le serveur le revérifie)
                        var reserve = a.Mode is "comptage" or "recompte" && a.Employe != Session.NomComplet && !Session.A("achats.valider_ecart");
                        <tr>
                            <td>@a.Libelle</td>
                            <td class="nombre">@a.Lignes</td>
                            <td>@a.Employe<span class="detail">@(string.IsNullOrEmpty(a.Poste) ? "" : $" · {a.Poste}")</span></td>
                            <td style="white-space: nowrap">@a.CreeLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="white-space: nowrap">
                                @if (reserve)
                                {
                                    <span class="detail">Réservée à @a.Employe</span>
                                }
                                else if (aAbandonner == a.Id)
                                {
                                    <span>Abandonner cette réception ? </span>
                                    <button type="button" class="btn btn-danger" disabled="@enCours" @onclick="() => AbandonnerAsync(a.Id)">Abandonner</button>
                                    <button type="button" class="btn" @onclick="() => aAbandonner = null">Garder</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-contour" disabled="@enCours" @onclick="() => ReprendreAsync(a.Id)"
                                            title="@(SaisieEnCours ? "La saisie en cours part d’abord en attente" : null)">Reprendre</button>
                                    <button type="button" class="btn" disabled="@enCours" @onclick="() => aAbandonner = a.Id">Abandonner</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pagination Total="AttentesFiltrees.Count" Numero="pageAttentes" Taille="tailleAttentes" Libelle="Pages des réceptions en attente" OnChange="p => (pageAttentes, tailleAttentes) = (p.Numero, p.Taille)" />
        <p class="detail" style="margin: 0">Une réception quittée en cours de saisie (autre écran, déconnexion) arrive ici. Abandonnée, ses boîtes scannées sur le mobile reviennent dans la liste d’import.</p>
    </section>
}

@if (aFacturer is null && aRecompter is null && resultat is null && comptages.Count > 0 && !(DeuxListesAttente && partieAttente == "receptions"))
{
    <section class="panneau" aria-labelledby="t-comptages">
        <div>
            <h2 id="t-comptages">Livraisons comptées</h2>
            <p class="sous-titre">La facture se saisit sans voir les boîtes comptées, de préférence par une autre personne que celle qui a compté.</p>
        </div>
        @* Livraisons comptées : filtrées et paginées à l'écran (règle des listes) *@
        <div class="filtres-liste" role="search" aria-label="Filtrer les livraisons comptées">
            <div class="champ" style="flex: 1 1 220px"><label for="fc-texte">Grossiste ou n° de BL</label>
                <input id="fc-texte" type="search" autocomplete="off" @bind="fcTexte" @bind:event="oninput" @bind:after="() => pageComptages = 1" /></div>
            <div class="champ" style="flex: 0 0 200px"><label for="fc-etat">État</label>
                <select id="fc-etat" @bind="fcEtat" @bind:after="() => pageComptages = 1">
                    <option value="">Tous</option>
                    <option value="compte">Facture à saisir</option>
                    <option value="ecart">Écart à valider</option>
                    <option value="a_recompter">À recompter</option>
                </select></div>
            @if (fcTexte.Trim() != "" || fcEtat != "") { <button type="button" class="btn" @onclick="() => (fcTexte, fcEtat, pageComptages) = (string.Empty, string.Empty, 1)">Tout afficher</button> }
        </div>
        <div class="tableau-cadre" data-hauteur-min="140">
            <table class="tableau" style="min-width: 0">
                <thead><tr><th scope="col">Grossiste</th><th scope="col">BL</th><th scope="col">Comptée par</th><th scope="col">État</th><th scope="col"></th></tr></thead>
                <tbody>
                    @foreach (var c in ComptagesFiltres.Skip((pageComptages - 1) * tailleComptages).Take(tailleComptages))
                    {
                        <tr>
                            <td>@c.Fournisseur</td>
                            <td>@c.NumeroBl<br /><span class="detail">@c.NombreLots lot(s)</span></td>
                            <td>@c.Compteur<br /><span class="detail">@Libelles.DateHeureLocale(c.CompteLe)</span></td>
                            <td>
                                @if (c.Statut == "ecart")
                                {
                                    <span class="pastille @(c.BoitesManquantes > 0 ? "urgent" : "attention")">Écart à valider</span>
                                    @if (c.BoitesManquantes is { } manq)
                                    {
                                        <br /><span class="detail">Facture saisie par @c.Factureur : @manq boîte(s) manquante(s) (@Libelles.Dinars(c.ValeurManquante ?? 0, 2)), @c.BoitesEnTrop en trop.</span>
                                        @foreach (var e in c.Ecarts)
                                        {
                                            <br /><span class="detail">@e.Nom, lot @e.NumeroLot : facturé @e.Facture, compté @e.Compte</span>
                                        }
                                    }
                                    else
                                    {
                                        <br /><span class="detail">Facture saisie par @c.Factureur : @c.Ecarts.Count lot(s) en écart, en attente de décision.</span>
                                    }
                                }
                                else if (c.Statut == "a_recompter")
                                {
                                    <span class="pastille attention">À recompter</span>
                                    <br /><span class="detail">Comptez de nouveau les boîtes, sans regarder le BL : le logiciel compare avec la facture déjà saisie.</span>
                                }
                                else
                                {
                                    <span>Facture à saisir</span>
                                }
                            </td>
                            <td style="white-space: nowrap">
                                @if (c.Statut == "compte" && Session.A("achats.receptionner") && !SaisitPrix)
                                {
                                    <span class="detail">Facture à saisir par un ayant droit « modifier un prix ».</span>
                                    <button type="button" class="btn" disabled="@enCours" @onclick="() => AnnulerComptageAsync(c)">Annuler</button>
                                }
                                else if (c.Statut == "compte" && Session.A("achats.receptionner"))
                                {
                                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => SaisirFactureAsync(c.Id)">Saisir la facture</button>
                                    <button type="button" class="btn" disabled="@enCours" @onclick="() => AnnulerComptageAsync(c)">Annuler</button>
                                }
                                else if (c.Statut == "a_recompter" && Session.A("achats.receptionner"))
                                {
                                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => RecompterAsync(c.Id)">Recompter</button>
                                }
                                else if (c.Statut == "ecart" && Session.A("achats.valider_ecart"))
                                {
                                    <button type="button" class="btn btn-principal" disabled="@enCours" title="Le stock prend les boîtes comptées, la dette suit la facture ; les boîtes manquantes sont à réclamer au grossiste"
                                            @onclick="() => DeciderEcartAsync(c, true)">Valider l’écart</button>
                                    <button type="button" class="btn" disabled="@enCours" @onclick="() => DeciderEcartAsync(c, false)">Faire recompter</button>
                                    <button type="button" class="btn" disabled="@enCours" title="Mauvais BL ou mauvais grossiste : rien n'entre en stock" @onclick="() => AnnulerComptageAsync(c)">Annuler</button>
                                }
                                else if (c.Statut == "ecart")
                                {
                                    <span class="detail">En attente du pharmacien (ou d’une personne habilitée).</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (ComptagesFiltres.Count == 0) { <tr><td colspan="5" class="vide">Aucune livraison comptée pour ces filtres.</td></tr> }
                </tbody>
            </table>
        </div>
        <Pagination Total="ComptagesFiltres.Count" Numero="pageComptages" Taille="tailleComptages" Libelle="Pages des livraisons comptées" OnChange="p => (pageComptages, tailleComptages) = (p.Numero, p.Taille)" />
    </section>
}

@if (Vue == "attente" && attentes.Count == 0 && comptages.Count == 0)
{
    <p class="vide">Aucune réception en attente, aucune livraison comptée à facturer.</p>
    <ActionSuivante Libelle="Réceptionner une livraison" Lien="achats?onglet=receptions&vue=saisie" Droits='["achats.receptionner"]' />
}
}

@if (Vue is "" or "saisie")
{
@if (ecartFacture is not null)
{
    <section class="panneau" aria-labelledby="t-ecart">
        <h2 id="t-ecart">Écart avec le comptage</h2>
        <div class="bandeau-attention" role="alert">
            La facture ne correspond pas aux boîtes comptées : rien n’est entré en stock. La réception attend la validation du pharmacien
            (ou d’une personne habilitée), qui est prévenu.
            @foreach (var e in ecartFacture.Ecarts)
            {
                <br /><span>@e.Nom, lot @e.NumeroLot@(e.Facture is { } fa ? $" : facturé {fa}, compté {e.Compte}" : "").</span>
            }
        </div>
        <div><button type="button" class="btn" @onclick="Nouvelle">Nouvelle réception</button></div>
    </section>
}
else if (resultat is not null)
{
    <section class="panneau" aria-labelledby="t-recue">
        <h2 id="t-recue">Livraison enregistrée</h2>
        <div class="succes" role="status">
            @resultat.Lots.Count lot(s), @resultat.Lots.Sum(l => l.Quantite) boîte(s) entrées en stock · @Libelles.Dinars(resultat.MontantTtc, 2) TTC ajoutés à la dette du grossiste.
        </div>
        @foreach (var e in resultat.EcartsShp ?? [])
        {
            <p class="texte-attention" style="margin: 0">@e</p>
        }
        @foreach (var l in resultat.Lots.Where(l => l.LotExistant))
        {
            <p class="detail" style="margin: 0">@l.Produit, lot @l.NumeroLot : déjà en stock chez ce grossiste, les @l.Quantite boîte(s) ont été ajoutées au même lot.</p>
        }
        @if (resultat.Lots.Sum(l => l.Etiquettes) is var nbEtiquettes and > 0)
        {
            <p style="margin: 0"><strong>@nbEtiquettes étiquette(s) interne(s) créée(s)</strong> pour les boîtes sans Data Matrix : collez-les avant la mise en rayon. Chaque boîte est ainsi reliée à son lot, son grossiste et ce bon de livraison.</p>
            @if (infoEtiquettes is not null) { <p class="detail" role="status" style="margin: 0">@infoEtiquettes</p> }
        }
        <div style="display: flex; gap: 8px; flex-wrap: wrap">
            @if (resultat.Lots.Sum(l => l.Etiquettes) > 0)
            {
                <button type="button" class="btn btn-principal" disabled="@impression" @onclick="() => ImprimerEtiquettesAsync(resultat.ReceptionId)">Réimprimer les étiquettes</button>
            }
            <button type="button" class="btn" @onclick="Nouvelle">Nouvelle réception</button>
        </div>
    </section>
}
else
{
    @* Écran fixe (2026-11-15) : la saisie (facture longue, 12 colonnes) défile dans son panneau, jamais l'écran *@
    <section class="panneau cadre-defilant" aria-labelledby="t-recep">
        <h2 id="t-recep">@(aRecompter is { } ar ? $"Recompter le BL {ar.NumeroBl}" : Comptage ? "Compter une livraison" : aFacturer is { } af ? $"Saisir la facture du BL {af.NumeroBl}" : "Réceptionner une livraison")</h2>
        @if (Comptage)
        {
            @if (aveugle || aRecompter is not null)
            {
                <p class="detail" style="margin: 0">Réception à l’aveugle : comptez les boîtes du carton (scan ou saisie) sans regarder le bon de livraison. La facture se saisit ensuite, de préférence par une autre personne, et le logiciel compare.</p>
            }
            else
            {
                <p class="detail" style="margin: 0">Comptez les boîtes du carton (scan ou saisie). Les prix de la facture sont saisis ensuite par une personne qui a le droit de voir les prix d’achat, et le logiciel compare.</p>
            }
        }
        else if (aFacturer is not null)
        {
            <p class="detail" style="margin: 0">Livraison comptée par @aFacturer.Compteur. Saisissez chaque ligne comme sur la facture (boîtes facturées, UG comprises, et prix) ; le logiciel compare avec le comptage. Un lot compté laissé à 0 compte comme non facturé.</p>
        }
        <div class="achats-ligne">
            <div class="champ" style="flex: 1 1 200px">
                <label for="r-gros" class="requis">Grossiste</label>
                <select data-champ="grossiste" id="r-gros" @bind="fournisseurId" @bind:after="ChoisirFournisseurAsync" disabled="@(lignes.Count > 0 || aFacturer is not null)">
                    <option value="0">Choisir…</option>
                    @foreach (var f in fournisseurs.Where(x => x.Actif || x.Id == fournisseurId))
                    {
                        <option value="@f.Id">@f.RaisonSociale</option>
                    }
                </select>
            </div>
            @if (!Comptage)
            {
                <div class="champ" style="flex: 1 1 200px">
                    <label for="r-cmd">Bon de commande</label>
                    <select id="r-cmd" @bind="commandeId" @bind:after="ChargerCommandeAsync" disabled="@(lignes.Count > 0 && aFacturer is null)">
                        <option value="0">Livraison sans commande</option>
                        @foreach (var c in commandes.Where(c => c.FournisseurId == fournisseurId))
                        {
                            <option value="@c.Id">@c.Numero (@Libelles.StatutCommande(c.Statut))</option>
                        }
                    </select>
                </div>
            }
            <div class="champ" style="flex: 1 1 160px">
                <label for="r-bl" class="requis">N° du bon de livraison</label>
                <input id="r-bl" data-champ="numero_bl" type="text" @ref="champBl" @bind="numeroBl" @bind:event="oninput" @bind:after="DocumentSaisiAsync" class="@(BlInvalide ? "champ-invalide" : null)"
                       readonly="@(aFacturer is not null)" aria-invalid="@(BlInvalide ? "true" : "false")" aria-describedby="@(BlInvalide ? "r-bl-erreur" : null)" />
                @if (BlInvalide) { <span id="r-bl-erreur" class="message-champ">Indiquez le numéro du bon de livraison.</span> }
            </div>
            @if (!Comptage)
            {
                <div class="champ" style="flex: 1 1 160px">
                    <label for="r-fact">N° de facture (facultatif)</label>
                    <input id="r-fact" type="text" @bind="numeroFacture" @bind:event="oninput" @bind:after="DocumentSaisiAsync" />
                </div>
                <div class="champ" style="flex: 0 0 170px">
                    @* Date de la facture du grossiste (facultative) : ni dans le futur, ni plus de 90 jours avant la livraison (serveur) *@
                    <label for="r-date-fact">Date de facture</label>
                    <input id="r-date-fact" data-champ="date_facture" type="date" @bind="dateFacture" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
            }
        </div>
        <p class="detail" style="margin: 0">Le QR code d’une facture contient son numéro (BL ou facture selon le grossiste) : cliquez dans la case, puis scannez-le avec la douchette.</p>
        @if (dejaRecues.Count > 0)
        {
            <div class="bandeau-attention" role="alert">
                <strong>Document déjà réceptionné ?</strong>
                @foreach (var d in dejaRecues)
                {
                    <br /><span>Le @Libelles.DateHeureLocale(d.Date) : BL @(d.NumeroBl ?? "—")@(d.NumeroFacture is { } nf ? $", facture {nf}" : "")@(d.MontantTtc > 0 ? $", {Libelles.Dinars(d.MontantTtc, 2)} TTC" : "").</span>
                }
                <br /><span>Vérifiez qu’il ne s’agit pas de la même livraison avant d’enregistrer (une facture peut toutefois couvrir plusieurs livraisons).</span>
            </div>
        }

        @if (fournisseurId != 0)
        {
            <div class="achats-ligne">
                @if (aFacturer is null)
                {
                    <div class="champ" style="flex: 1 1 280px">
                        <label for="r-scan">Scanner une boîte (Data Matrix)</label>
                        <input id="r-scan" type="text" autocomplete="off" placeholder="Le lot, la péremption et la série sont lus" @bind="scan" @onkeydown="ToucheScanAsync" />
                    </div>
                }
                <ChoixProduit @ref="choixProduit" Id="r-prod" Libelle="@(aFacturer is null ? "Ou ajouter un produit (boîtes sans Data Matrix)" : "Ajouter un produit facturé non compté")" Style="flex: 1 1 280px"
                              OnChoisi="p => AjouterProduit(p.Id, p.NomCommercial)" OnTexte="t => texteProduit = t" />
            </div>
            @if (aFacturer is null)
            {
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap">
                    <button type="button" class="btn btn-contour" disabled="@(enCours || scansMobile == 0)" @onclick="ImporterScansMobileAsync">
                        Importer les scans du mobile (@scansMobile)
                    </button>
                    <button type="button" class="lien" @onclick="CompterScansMobileAsync">Actualiser</button>
                    <span class="detail">Boîtes scannées au déballage avec le téléphone (page /mobile du serveur).</span>
                </div>
            }
            @if (infoScan is not null)
            {
                <p class="detail" role="status" style="margin: 0">@infoScan</p>
            }
            @if (Session.A("catalogue.creer") && creation is null)
            {
                <div><button type="button" class="lien" @onclick="() => creation = (gtinInconnu, texteProduit.Trim().Length > 1 ? texteProduit.Trim() : null)">Produit absent du catalogue ? Le créer@(gtinInconnu is null ? "" : $" (code {gtinInconnu})")</button></div>
            }
            @if (creation is { } c)
            {
                <FicheNouveauProduit CodeBarreInitial="@c.Code" NomInitial="@c.Nom" OnCree="ProduitCree" OnAnnule="() => creation = null" />
            }
        }

        @if (lignes.Count > 0)
        {
            <div class="tableau-cadre">
                <table class="tableau" style="min-width: @(Comptage ? "0" : "1400px")">
                    <thead><tr><th scope="col">Produit</th><th scope="col"><span class="etiquette-champ requis" style="font-size: inherit; color: inherit">N° de lot</span></th><th scope="col"><span class="etiquette-champ requis" style="font-size: inherit; color: inherit">Péremption</span></th>
                        <th scope="col">@(Comptage ? "Boîtes comptées" : aFacturer is not null ? "Boîtes facturées" : "Boîtes reçues")</th>
                        @if (!Comptage)
                        {
                            <th scope="col" title="Unités gratuites, comprises dans les boîtes reçues">UG</th><th scope="col">Prix HT</th><th scope="col">Remise %</th><th scope="col" title="Prix d'achat TTC d'une boîte : prix HT net de remise, TVA du produit comprise">PA TTC</th><th scope="col">PPA</th><th scope="col" title="Prix de vente HT : PPA hors TVA du produit">PV HT</th><th scope="col">SHP</th><th scope="col">Marge</th>
                        }
                        @if (aFacturer is null)
                        {
                            <th scope="col">Data Matrix</th>
                        }
                        <th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var l in lignes)
                        {
                            <tr>
                                <td><span class="nom">@l.Nom</span>@if (l.Commandee is { } q){<br /><span class="detail">commandé : @q</span>}
                                    @if (l.Info is { BloqueAchat: true } infoBloque)
                                    {
                                        <br /><span class="pastille urgent">Bloqué à l’achat@(infoBloque.MotifBlocage is { } mb ? $" : {mb}" : "")</span>
                                    }
                                    @if (l.EcartShp is { } shpAttendu)
                                    {
                                        <br /><span class="texte-attention">SHP facture @Libelles.Dinars(l.Shp!.Value, 2) ≠ SHP attendue @Libelles.Dinars(shpAttendu, 2) pour un produit @(l.Info!.LibelleClasseShp ?? l.Info.Classe) : vérifier la classe du produit ou la facture</span>
                                    }
                                    @if (l.EcartPpa is { } prixCatalogue)
                                    {
                                        <br /><span class="texte-attention">PPA facturé @Libelles.Dinars(l.Ppa!.Value, 2) ≠ prix public du catalogue @Libelles.Dinars(prixCatalogue, 2)</span>
                                        <br /><select class="selection" style="font-size: 12px; margin-top: 4px" aria-label="Prix de vente de @l.Nom" @bind="l.RemplacerPrixCatalogue">
                                            <option value="False">Garder ce PPA sur le lot (vendu à ce prix)</option>
                                            @if (Session.A("prix.modifier"))
                                            {
                                                <option value="True">Remplacer le prix du catalogue par ce PPA</option>
                                            }
                                        </select>
                                    }</td>
                                <td><input type="text" style="width: 120px" aria-label="Numéro de lot de @l.Nom" @bind="l.NumeroLot" @bind:event="oninput" @bind:after="l.Reinitialiser"
                                           class="@(LotInvalide(l) ? "champ-invalide" : null)" aria-invalid="@(LotInvalide(l) ? "true" : "false")" /></td>
                                <td><SaisiePeremption Libelle="@($"Péremption de {l.Nom} (MM/AA ou JJ/MM/AAAA)")" @bind-Value="l.Peremption" @bind-Value:after="l.Reinitialiser"
                                                      Erreur="DateInvalide(l)" /></td>
                                <td><input type="number" min="0" style="width: 80px" aria-label="@(Comptage ? $"Boîtes comptées de {l.Nom}" : $"Boîtes reçues de {l.Nom} (UG comprises)")" @bind="l.Quantite" /></td>
                                @if (!Comptage)
                                {
                                <td>
                                    <input type="number" min="0" style="width: 60px" aria-label="Unités gratuites de @l.Nom" @bind="l.Ug" />
                                    @if (l.Ug > 0)
                                    {
                                        <select class="selection" style="display: block; margin-top: 4px; font-size: 12px" aria-label="Coût des unités gratuites de @l.Nom" @bind="l.UgCoutReparti">
                                            <option value="False">UG à 0 DA</option>
                                            <option value="True">Coût réparti</option>
                                        </select>
                                    }
                                </td>
                                <td><input type="number" min="0" step="0.01" style="width: 100px" aria-label="Prix HT de @l.Nom (avant remise)" @bind="l.Prix" /></td>
                                <td><input type="number" min="0" max="100" step="0.01" style="width: 70px" aria-label="Remise en % de @l.Nom" @bind="l.RemisePct" /></td>
                                <td style="white-space: nowrap">@(l.PaTtc is { } pa ? Libelles.Dinars(pa, 2) : "—")</td>
                                <td><input type="number" min="0" step="0.01" style="width: 100px" aria-label="PPA facturé de @l.Nom" @bind="l.Ppa" /></td>
                                <td style="white-space: nowrap">@(l.PvHt is { } pv ? Libelles.Dinars(pv, 2) : "—")</td>
                                <td><input type="number" min="0" step="0.01" style="width: 70px@(l.EcartShp is not null ? "; border-color: var(--avert-bord); background: var(--avert-fond)" : "")" aria-label="SHP par boîte de @l.Nom" title="@(l.Info is { } inf ? $"Proposé selon la liste du produit ({Libelles.Classe(inf.Classe)})" : null)" @bind="l.Shp" /></td>
                                <td style="white-space: nowrap">@(l.MargePct is { } m ? $"{m:0.00} %" : "—")</td>
                                }
                                @if (aFacturer is null)
                                {
                                    <td>@(l.Series.Count > 0 ? $"{l.Series.Count} scannée(s)" : "—")</td>
                                }
                                <td><button type="button" class="btn btn-icone" aria-label="Retirer @l.Nom" title="Retirer" @onclick="() => RetirerLigneAsync(l)">×</button></td>
                            </tr>
                            @if (l.QuantiteMobile is { } qm && l.QuantiteSaisie is { } qs)
                            {
                                <tr class="ligne-conflit">
                                    <td colspan="14">
                                        <div class="conflit-lot" role="alert">
                                            <span>Cette ligne était déjà saisie (@qs boîte(s)) et le mobile en a scanné @qm pour le même lot. Quelle quantité retenir ?</span>
                                            <div class="choix-conflit">
                                                <button type="button" class="btn" @onclick="() => ChoisirQuantite(l, qs)">La saisie : @qs</button>
                                                <button type="button" class="btn" @onclick="() => ChoisirQuantite(l, qm)">Le mobile : @qm</button>
                                                <button type="button" class="btn" @onclick="() => ChoisirQuantite(l, qs + qm)">Additionner : @(qs + qm)</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var c in l.Conflits)
                            {
                                <tr class="ligne-conflit">
                                    <td colspan="14">
                                        <div class="conflit-lot" role="alert">
                                            <span>@c.Message</span>
                                            @if (c.Type == "date_differente")
                                            {
                                                @if (l.LotSepare)
                                                {
                                                    <span class="choix-fait">Choix : lot séparé avec la péremption du @Libelles.Date(l.Peremption!.Value).
                                                        <button type="button" class="lien" @onclick="() => l.LotSepare = false">Changer</button></span>
                                                }
                                                else
                                                {
                                                    <div class="choix-conflit">
                                                        <button type="button" class="btn" @onclick="() => CorrigerDate(l)">Corriger la date</button>
                                                        <button type="button" class="btn btn-principal" @onclick="() => l.LotSepare = true">Créer un lot séparé (péremption du @Libelles.Date(l.Peremption!.Value))</button>
                                                    </div>
                                                }
                                            }
                                            else if (l.EntrerBloque)
                                            {
                                                <span class="choix-fait">Choix : boîtes entrées en stock, bloquées (vente interdite), à retourner au grossiste.
                                                    <button type="button" class="lien" @onclick="() => l.EntrerBloque = false">Changer</button></span>
                                            }
                                            else
                                            {
                                                <div class="choix-conflit">
                                                    <button type="button" class="btn" @onclick="() => RetirerLigneAsync(l)">Mettre de côté (ne pas entrer)</button>
                                                    <button type="button" class="btn btn-principal" @onclick="() => l.EntrerBloque = true">Entrer en stock bloqué</button>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (Comptage)
            {
                <div style="display: flex; gap: 8px">
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="TerminerComptageAsync">Terminer le comptage</button>
                    <button type="button" class="btn" disabled="@enCours" @onclick="MettreEnAttenteAsync" title="Mettre ce comptage de côté et le reprendre plus tard">⏸ Mettre en attente</button>
                    <button type="button" class="btn" disabled="@enCours" @onclick="Nouvelle">Abandonner</button>
                </div>
            }
            else
            {
            var t = Totaux;
            <div class="pied-facture-achat">
                <dl class="fiche-infos">
                    <dt>Total HT</dt><dd>@Libelles.Dinars(t.Ht, 2)</dd>
                    <dt>Remise</dt><dd>@Libelles.Dinars(t.Remise, 2)</dd>
                    <dt>Net HT</dt><dd>@Libelles.Dinars(t.Ht - t.Remise, 2)</dd>
                    <dt>TVA</dt><dd>@Libelles.Dinars(t.Tva, 2)</dd>
                    <dt><label for="r-timbre">Timbre</label></dt>
                    <dd><input id="r-timbre" data-champ="timbre" type="number" min="0" step="0.01" style="width: 120px" @bind="timbre" /></dd>
                    <dt><strong>Net à payer</strong></dt><dd><strong>@Libelles.Dinars(t.Ht - t.Remise + t.Tva + timbre, 2)</strong></dd>
                </dl>
                <dl class="fiche-infos">
                    <dt>Total PPA</dt><dd>@Libelles.Dinars(t.Ppa, 2)</dd>
                    <dt>Total SHP</dt><dd>@Libelles.Dinars(t.Shp, 2)</dd>
                </dl>
            </div>
            <p class="detail" style="margin: 0">Saisissez chaque ligne comme sur la facture : prix HT avant remise et remise en % ; le coût du stock est le prix net de remise. UG : unités gratuites comprises dans les boîtes reçues, à 0 DA ou au coût réparti (montant facturé ÷ boîtes reçues). Un PPA facturé différent du catalogue est gardé sur le lot : la caisse vend ce lot à ce prix. Le net à payer fait la dette du grossiste (TVA du catalogue). Le SHP, proposé selon la liste du produit, et le PPA sont indiqués à part : ils ne sont pas dus au grossiste. Une ligne à 0 boîte (non livrée) est ignorée.</p>
            <ValidationProduitBloque Produits="ProduitsBloques" Operation="à l’achat" Id="rec" Accord="accordBlocage" />
            <div style="display: flex; gap: 8px">
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="ValiderAsync">@(aFacturer is null ? "Valider la réception" : "Valider la facture")</button>
                <button type="button" class="btn" disabled="@(enCours || !SaisieEnCours)" @onclick="MettreEnAttenteAsync" title="Mettre cette livraison de côté et la reprendre plus tard, depuis n’importe quel poste">⏸ Mettre en attente</button>
                <button type="button" class="btn" disabled="@enCours" @onclick="Nouvelle">Abandonner</button>
            </div>
            }
        }
    </section>
}

}

@if (Vue is "" or "historique")
{
<div class="filtres-liste" role="search" aria-label="Filtrer les réceptions">
            <div class="champ" style="flex: 1 1 200px"><label for="fr-grossiste">Grossiste</label>
                <select id="fr-grossiste" @bind="fFournisseur" @bind:after="PremierePageAsync">
                    <option value="0">Tous</option>
                    @foreach (var g in fournisseurs) { <option value="@g.Id">@g.RaisonSociale</option> }
                </select>
            </div>
            <div class="champ" style="flex: 0 0 160px"><label for="fr-du">Du</label><input id="fr-du" type="date" @bind="fDu" @bind:after="PremierePageAsync" /></div>
            <div class="champ" style="flex: 0 0 160px"><label for="fr-au">Au</label><input id="fr-au" type="date" @bind="fAu" @bind:after="PremierePageAsync" /></div>
            <div class="champ" style="flex: 1 1 220px"><label for="fr-q">N° de BL, de facture ou de bon</label><input id="fr-q" type="search" @bind="fRecherche" @bind:after="PremierePageAsync" /></div>
            @if (FiltreActif) { <button type="button" class="btn" @onclick="EffacerFiltresAsync">Tout afficher</button> }
</div>
<section class="tableau-cadre" aria-label="Dernières réceptions">
    <table class="tableau" style="min-width: 0">
        <thead><tr><th scope="col">Date</th><th scope="col">Grossiste</th><th scope="col">BL</th><th scope="col">Commande</th><th scope="col">Lots</th><th scope="col">Boîtes</th><th scope="col">Montant TTC</th><th scope="col"></th></tr></thead>
        <tbody>
            @foreach (var r in historique)
            {
                <tr>
                    <td>@Libelles.DateHeureLocale(r.Date)</td>
                    <td><LienContact Type="grossiste" Id="r.FournisseurId" Nom="@r.Fournisseur" /></td>
                    <td>@(r.NumeroBl ?? "—")@if (r.NumeroFacture is not null || r.DateFacture is not null){<br /><span class="detail">facture @(r.NumeroFacture ?? "")@(r.DateFacture is { } df ? $" du {Libelles.Date(df)}" : "")</span>}</td>
                    <td>@(r.NumeroCommande ?? "sans")</td>
                    <td>@r.NombreLots</td>
                    <td>@(r.NombreBoites > 0 ? r.NombreBoites.ToString() : "—")</td>
                    <td>@(r.MontantTtc > 0 ? Libelles.Dinars(r.MontantTtc, 2) : "—")</td>
                    <td><button type="button" class="btn btn-contour" disabled="@impression" title="Réimprimer les étiquettes internes de cette livraison encore en stock" @onclick="() => ImprimerEtiquettesAsync(r.Id)">Étiquettes</button></td>
                </tr>
            }
            @if (historique.Count == 0)
            {
                <tr><td colspan="8" class="vide">@(FiltreActif ? "Aucune réception pour ces filtres." : "Aucune réception.")</td></tr>
            }
        </tbody>
    </table>
</section>
<Pagination Total="totalReceptions" Numero="pageReceptions" Taille="tailleReceptions" Libelle="Pages des réceptions" OnChange="p => ChargerReceptionsAsync(p.Numero, p.Taille)" />
}

@code {
    // En attente : une liste à la fois quand les deux en ont (écran fixe) ; les écarts à valider d'abord s'il y en a
    private string? partieChoisie;
    // Aucune réception en attente mais des livraisons comptées (2026-11-16) : les deux pastilles restent, « Livraisons comptées » d'abord
    // (la liste vide des réceptions et celle des livraisons empilées faisaient défiler la page)
    private string partieAttente { get => partieChoisie ?? (attentes.Count == 0 || comptages.Any(c => c.Statut == "ecart") ? "comptees" : "receptions"); set => partieChoisie = value; }
    private bool DeuxListesAttente => Vue == "attente" && comptages.Count > 0 && resultat is null
        // Facture déjà validée avec un écart : la livraison n'est plus « en saisie », les deux pastilles restent proposées (2026-11-15)
        && (ecartFacture is not null || (aFacturer is null && aRecompter is null));

    /// <summary>Partie affichée : « saisie », « attente », « historique », vide (tout).</summary>
    [Parameter] public string Vue { get; set; } = "";
    [Parameter] public long? CommandeId { get; set; }

    private sealed class Ligne
    {
        public long ProduitId { get; init; }
        public string Nom { get; init; } = "";
        public string NumeroLot { get; set; } = "";
        public DateOnly? Peremption { get; set; }
        public int Quantite { get; set; }
        public decimal Prix { get; set; }
        public decimal RemisePct { get; set; }
        /// <summary>Unités gratuites, comprises dans Quantite (boîtes reçues).</summary>
        public int Ug { get; set; }
        public bool UgCoutReparti { get; set; }
        public bool RemplacerPrixCatalogue { get; set; }
        public int Facturees => Math.Max(Quantite - Ug, 0);
        public decimal? Ppa { get; set; }
        public decimal? Shp { get; set; }
        /// <summary>Liste du produit, prix public du catalogue, TVA et SHP proposé (chargés à l'ajout de la ligne).</summary>
        public InfoAchatProduitDto? Info { get; set; }
        public bool InfoDemandee { get; set; }
        /// <summary>Marge sur le prix d'achat, comme la colonne « MGE » des factures : PPA ÷ prix HT − 1.</summary>
        /// <summary>Prix d'achat TTC d'une boîte : prix HT net de remise, plus la TVA du produit (connue une fois les infos d'achat chargées).</summary>
        public decimal? PaTtc => Info is { } i && Prix > 0 ? Math.Round(Prix * (1 - RemisePct / 100m) * (1 + i.TauxTva / 100m), 2, MidpointRounding.AwayFromZero) : null;
        /// <summary>Prix de vente HT : PPA facturé hors TVA du produit.</summary>
        public decimal? PvHt => Info is { } i && Ppa is > 0 ? Math.Round(Ppa.Value / (1 + i.TauxTva / 100m), 2, MidpointRounding.AwayFromZero) : null;
        public decimal? MargePct => Ppa is > 0 && Prix > 0 ? Math.Round((Ppa.Value / Prix - 1) * 100, 2, MidpointRounding.AwayFromZero) : null;
        /// <summary>Prix public du catalogue quand le PPA facturé en diffère (à vérifier : le prix de vente n'est pas changé).</summary>
        /// <summary>SHP attendu pour la classe du produit quand le SHP saisi (celui de la facture) en diffère : ligne signalée, non bloquant.</summary>
        public decimal? EcartShp => Shp is { } s && Info is { } i && Math.Abs(i.ShpParBoite - s) >= 0.01m ? i.ShpParBoite : null;
        public decimal? EcartPpa => Ppa is > 0 && Info is { PrixPublic: > 0 } i && Math.Abs(i.PrixPublic - Ppa.Value) >= 0.01m ? i.PrixPublic : null;
        public int? Commandee { get; init; }
        public string? Gtin { get; set; }
        public List<string> Series { get; } = [];
        /// <summary>Boîtes scannées sur le poste dont le Data Matrix ne porte pas de numéro de série : comptées une à une.</summary>
        public int SansSerie { get; set; }
        /// <summary>Import du mobile sur une ligne déjà saisie : les deux quantités attendent le choix de l'utilisateur.</summary>
        public int? QuantiteSaisie { get; set; }
        public int? QuantiteMobile { get; set; }
        public bool ChoixQuantiteManquant => QuantiteMobile is not null;
        /// <summary>Scans du mobile repris dans cette ligne (remis en attente si la ligne est retirée ou la réception abandonnée).</summary>
        public List<long> ScansMobile { get; } = [];
        /// <summary>Conflits signalés par le serveur (date différente, lot bloqué) et choix de l'utilisateur.</summary>
        public List<ConflitReceptionDto> Conflits { get; set; } = [];
        public bool LotSepare { get; set; }
        public bool EntrerBloque { get; set; }
        public bool ChoixManquant => Conflits.Any(c => c.Type == "date_differente" && !LotSepare || c.Type == "lot_bloque" && !EntrerBloque);

        /// <summary>Le lot ou la date a changé : conflits et choix sont à revoir.</summary>
        public void Reinitialiser() => (Conflits, LotSepare, EntrerBloque) = ([], false, false);
    }

    private List<FournisseurDto> fournisseurs = [];
    private List<CommandeAchatDto> commandes = [];
    private List<ReceptionResumeDto> historique = [];
    private int totalReceptions, pageReceptions = 1, tailleReceptions = Pagination.TailleParDefaut;

    // Filtres de la liste des réceptions : appliqués par le serveur, le total et les pages les suivent
    private long fFournisseur;
    private DateOnly? fDu, fAu;
    private string? fRecherche;
    private bool FiltreActif => fFournisseur > 0 || fDu is not null || fAu is not null || !string.IsNullOrWhiteSpace(fRecherche);
    private Task PremierePageAsync() => ChargerReceptionsAsync(1);
    private Task EffacerFiltresAsync() { (fFournisseur, fDu, fAu, fRecherche) = (0, null, null, null); return PremierePageAsync(); }

    private async Task ChargerReceptionsAsync(int numero, int? taille = null)
    {
        tailleReceptions = taille ?? tailleReceptions;
        var (p, _) = await Api.ReceptionsAsync(numero, tailleReceptions, fFournisseur > 0 ? fFournisseur : null, fDu, fAu, fRecherche);
        if (p is null) return;
        (historique, totalReceptions, pageReceptions) = (p.Lignes.ToList(), p.Total, p.Numero);
    }
    private readonly List<Ligne> lignes = [];
    private long fournisseurId, commandeId;
    private string? numeroBl, numeroFacture, scan, infoScan, erreur;
    private DateOnly? dateFacture;
    private string texteProduit = "";
    private ChoixProduit? choixProduit;
    private ReceptionEnregistreeDto? resultat;

    // Classe du produit dans le contrôle du SHP : libellé envoyé par le serveur (RegleShp.LibelleClasse, InfoAchatProduitDto.LibelleClasseShp)
    private bool enCours;

    // ---- Réception à l'aveugle : comptage (Comptage), puis facture saisie sur ce comptage (aFacturer) ----
    private bool aveugle;
    private ComptageAFacturerDto? aFacturer;
    /// <summary>Livraison à recompter : comptage à l'aveugle des lots de la livraison, comparé à la facture déjà saisie.</summary>
    private ComptageAFacturerDto? aRecompter;
    // Prix facturés saisis seulement par un ayant droit prix.modifier (un seul droit pour toute saisie de prix, titulaire compris ;
    // le serveur le revérifie) : sans ce droit, l'employé compte la livraison et la facture est saisie par un ayant droit (décision du 2026-11-15)
    private bool SaisitPrix => Session.A("prix.modifier");
    private bool Comptage => (aveugle || !SaisitPrix || aRecompter is not null) && aFacturer is null;
    private List<ComptageResumeDto> comptages = [];
    // Livraisons comptées : filtres et page à l'écran
    private string fcTexte = "", fcEtat = "";
    private int pageComptages = 1, tailleComptages = Pagination.TailleParDefaut;
    private List<ComptageResumeDto> ComptagesFiltres => comptages.Where(c => RechercheTexte.Contient(fcTexte, c.Fournisseur, c.NumeroBl)
        && (fcEtat == "" || c.Statut == fcEtat)).ToList();
    private ResultatFacturationDto? ecartFacture;
    private string? infoComptage;

    private async Task ChargerComptagesAsync()
    {
        // Toujours chargés, même mode aveugle désactivé : les comptages en cours restent à traiter
        if (!(Session.A("achats.receptionner") || Session.A("achats.valider_ecart"))) { comptages = []; return; }
        (comptages, _) = await Api.ComptagesReceptionAsync();
    }

    /// <summary>Boîtes comptées enregistrées : la facture se saisira ensuite sur ce comptage, sans voir le compté.</summary>
    private async Task TerminerComptageAsync()
    {
        (erreur, infoComptage, controle) = (null, null, true);
        var aEnvoyer = lignes.Where(l => l.Quantite > 0).ToList();
        if (BlInvalide) { erreur = "Indiquez le numéro du bon de livraison."; await champBl.FocusAsync(); return; }
        if (lignes.FirstOrDefault(l => l.ChoixQuantiteManquant) is { } aChoisir)
        {
            erreur = $"{aChoisir.Nom} : choisissez la quantité à retenir (saisie, mobile ou les deux additionnées).";
            return;
        }
        if (aEnvoyer.FirstOrDefault(l => string.IsNullOrWhiteSpace(l.NumeroLot)) is { } sansLot) { erreur = $"{sansLot.Nom} : indiquez le numéro de lot."; return; }
        if (aEnvoyer.FirstOrDefault(l => l.Peremption is null) is { } sansDate) { erreur = $"{sansDate.Nom} : indiquez la date de péremption."; return; }
        enCours = true;
        try
        {
            var lignesComptees = aEnvoyer.Select(l => new LigneCompteeDto(l.ProduitId, l.Nom, l.NumeroLot, l.Peremption!.Value, l.Quantite, l.Gtin,
                l.Series.Count > 0 ? l.Series : null)).ToList();
            if (aRecompter is { } ar)
            {
                var (n, er) = await Api.RecompterLivraisonAsync(ar.Id, lignesComptees);
                if (er is not null) { erreur = er; return; }
                lignes.Clear();
                await Nouvelle();
                infoComptage = $"BL {ar.NumeroBl} recompté : " + (n!.Nombre == 0 ? "conforme à la facture, " : $"{n.Nombre} lot(s) encore en écart, ") + "en attente de la décision du pharmacien ou d'une personne habilitée.";
                return;
            }
            var (id, e) = await Api.CompterLivraisonAsync(new CompterLivraisonRequete(fournisseurId, numeroBl, lignesComptees,
                lignes.SelectMany(l => l.ScansMobile).ToList()));
            if (e is not null) { erreur = e; return; }
            var bl = numeroBl;
            lignes.Clear();   // scans du mobile gardés par le comptage : pas de remise en attente
            await Nouvelle();
            infoComptage = $"Comptage du BL {bl} enregistré ({aEnvoyer.Count} lot(s)) : la facture se saisit ensuite dans « Livraisons comptées », de préférence par une autre personne.";
        }
        finally { enCours = false; }
    }

