<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MiseEnPage)" />
    </Found>
    <NotFound>
        @* Une mise en page reçoit son contenu par LayoutView (pas en enfant direct : le poste plantait sur une adresse inconnue) *@
        <LayoutView Layout="@typeof(MiseEnPage)"><p class="page">Page introuvable.</p></LayoutView>
    </NotFound>
</Router>
