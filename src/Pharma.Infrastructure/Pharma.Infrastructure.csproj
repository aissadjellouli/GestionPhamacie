<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pharma.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Data.Odbc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pharma.Application\Pharma.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logo imprimé en tête des documents PDF -->
    <EmbeddedResource Include="Impression\Ressources\logo.png" LogicalName="Pharma.Logo.png" />
    <!-- Polices des PDF hors Windows : Liberation Sans 2.1.5, licence SIL OFL 1.1 (Impression\Ressources\Polices\OFL-LiberationSans.txt) -->
    <EmbeddedResource Include="Impression\Ressources\Polices\*.ttf" LogicalName="Pharma.Polices.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
