<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Écrans du serveur central (lot S7.1, docs/ecrans-central.md) : Blazor en rendu serveur STATIQUE (formulaires classiques,
       aucune interactivité), processus et port distincts du serveur central. Jamais la clé de l'autorité : seul le certificat
       public (autorite.crt) est lu, pour l'épinglage du code d'activation. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pharma.Cloud.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="BCrypt.Net-Next" />
    <!-- Codes de second facteur par e-mail : compte SMTP du central (mêmes variables PHARMA_CLOUD_SMTP_*) -->
    <PackageReference Include="MailKit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pharma.Shared\Pharma.Shared.csproj" />
    <!-- Lot S7.4 : liste fermée et bornes des réglages communs (Pharma.Domain n'a aucune dépendance) -->
    <ProjectReference Include="..\Pharma.Domain\Pharma.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Réglages SMTP et envoi : même fichier que le serveur central (aucune autre dépendance au serveur central) -->
    <Compile Include="..\Pharma.Cloud.Api\Depart\CourrielSmtp.cs" Link="Codes\CourrielSmtp.cs" />
  </ItemGroup>
</Project>
