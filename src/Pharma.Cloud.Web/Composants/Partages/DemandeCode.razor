@* Demande d'un code de confirmation (second facteur exigé à chaque action sensible) *@
<form method="post" action="actions/code-action" class="formulaire-ligne">
    <AntiforgeryToken />
    <input type="hidden" name="retour" value="@Retour" />
    <button type="submit" class="btn btn-contour" title="Valable 5 minutes, usage unique.">Recevoir un code de confirmation</button>
    <span class="detail">Valable 5 minutes, usage unique.</span>
</form>

@code {
    [Parameter, EditorRequired] public string Retour { get; set; } = "/officines";
}
