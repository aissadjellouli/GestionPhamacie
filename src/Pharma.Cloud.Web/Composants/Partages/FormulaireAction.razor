@* Action sensible : code de confirmation (second facteur), motif obligatoire, confirmation par ressaisie ; journalisée *@
<div class="page page-serree">
    <div class="titre-page">
        <div>
            <h1>@Titre</h1>
            <p class="sous-titre">@Explication</p>
        </div>
        <div class="actions">
            <a class="btn btn-contour" href="@Annuler">Annuler</a>
        </div>
    </div>
    <Message Erreur="@Erreur" Ok="@Ok" />
    <section class="panneau" aria-labelledby="t-etape-1">
        <h2 id="t-etape-1">1. Code de confirmation</h2>
        <DemandeCode Retour="@Retour" />
    </section>
    <section class="panneau" aria-labelledby="t-etape-2">
        <h2 id="t-etape-2">2. @Etape2</h2>
        <form method="post" action="@Action" class="formulaire-action">
            <AntiforgeryToken />
            @ChildContent
            <div class="champ">
                <label for="motif" class="requis">Motif (5 à 300 caractères, noté au journal de sécurité)</label>
                <input id="motif" name="motif" required minlength="5" maxlength="300" autocomplete="off" />
            </div>
            <div class="champ">
                <label for="confirmation" class="requis">@ConfirmationLibelle</label>
                <input id="confirmation" name="confirmation" required maxlength="200" autocomplete="off" />
            </div>
            <div class="champ">
                <label for="code" class="requis">Code de confirmation reçu</label>
                <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required />
            </div>
            <div class="actions">
                <button type="submit" class="btn @(Danger ? "btn-danger" : "btn-principal")">@Bouton</button>
            </div>
        </form>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public string Titre { get; set; } = "";
    [Parameter, EditorRequired] public string Explication { get; set; } = "";
    [Parameter] public string Etape2 { get; set; } = "Action";
    [Parameter, EditorRequired] public string Action { get; set; } = "";
    [Parameter, EditorRequired] public string Retour { get; set; } = "";
    [Parameter, EditorRequired] public string Annuler { get; set; } = "";
    [Parameter, EditorRequired] public string ConfirmationLibelle { get; set; } = "";
    [Parameter, EditorRequired] public string Bouton { get; set; } = "";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public string? Erreur { get; set; }
    [Parameter] public string? Ok { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
