@inherits LayoutComponentBase

@* En-tête de la charte (docs/charte-graphique.md) : logo et nom à gauche, écrans au centre, compte et déconnexion à droite *@
@* Script central 040 : session ouverte : secondes avant la déconnexion après inactivité (échéance glissante lue en base), lues par
   ecrans.js (bandeau « Rester connecté » une minute avant, puis déconnexion d'elle-même) *@
<header class="entete" data-session-restant="@(Ouverte ? ActionsImportComptes.SecondesRestantes(Session!, DateTime.UtcNow).ToString(System.Globalization.CultureInfo.InvariantCulture) : null)">
    <div class="entete-interieur">
        <a class="marque" href="@(Ouverte ? Accueil : "connexion")" title="Tracodex Réseau · écrans du central">
            <img class="logo" src="img/logo.svg" alt="" aria-hidden="true" />
            <div class="marque-textes">
                <span class="marque-nom">Tracodex Réseau</span>
                <span class="marque-poste">Écrans du central@(Session is { Editeur: true } ? " · éditeur" : Session is { Titulaire: true } ? " · titulaire" : "")</span>
            </div>
        </a>
        @if (Ouverte && Session!.Editeur)
        {
            <nav class="nav" aria-label="Navigation des écrans du central">
                <a href="officines" class="@Actif("officines")" aria-current="@Courant("officines")">Officines</a>
                <a href="envoi-codes" class="@Actif("envoi-codes")" aria-current="@Courant("envoi-codes")">Envoi des codes</a>
                <a href="comptes" class="@Actif("comptes")" aria-current="@Courant("comptes")">Comptes</a>
                <a href="mon-journal" class="@Actif("mon-journal")" aria-current="@Courant("mon-journal")">Mon journal des accès</a>
            </nav>
        }
        else if (Ouverte && Session!.Titulaire)
        {
            <nav class="nav" aria-label="Navigation des écrans du titulaire">
                <a href="mes-officines" class="@Actif("mes-officines")" aria-current="@Courant("mes-officines")">Mes officines</a>
                <a href="rattacher" class="@Actif("rattacher")" aria-current="@Courant("rattacher")">Rattacher une officine</a>
                <a href="mon-journal" class="@Actif("mon-journal")" aria-current="@Courant("mon-journal")">Mon journal des accès</a>
            </nav>
        }
        @if (Session is not null)
        {
            <div class="utilisateur">
                <span title="@Session.Identifiant">@Session.Nom</span>
                @if (Ouverte)
                {
                    <a class="lien-bouton" href="mot-de-passe">Mot de passe</a>
                }
                <form method="post" action="actions/theme" class="formulaire-ligne">
                    <AntiforgeryToken />
                    <input type="hidden" name="retour" value="@Retour" />
                    <label for="theme" class="visuellement-cache">Affichage</label>
                    <select id="theme" name="theme" class="choix-theme">
                        <option value="auto" selected="@(Theme is null)">Automatique</option>
                        <option value="clair" selected="@(Theme == "clair")">Clair</option>
                        <option value="sombre" selected="@(Theme == "sombre")">Sombre</option>
                    </select>
                    @* Pas de bouton « Appliquer » : ecrans.js envoie le formulaire dès que le choix change *@
                </form>
                <form method="post" action="actions/deconnexion" class="formulaire-ligne" id="form-deconnexion">
                    <AntiforgeryToken />
                    <input type="hidden" name="motif" value="" />
                    <button type="submit" class="lien-bouton">Se déconnecter</button>
                </form>
                @if (Ouverte)
                {
                    @* Signal d'activité (script central 040) : envoyé par ecrans.js seulement après une action de l'utilisateur *@
                    <form method="post" action="actions/activite" id="form-activite" hidden>
                        <AntiforgeryToken />
                    </form>
                }
            </div>
        }
    </div>
</header>
@if (Ouverte)
{
    <div class="bandeau-inactivite" id="bandeau-inactivite" role="alertdialog" aria-labelledby="bandeau-inactivite-texte" hidden>
        <span id="bandeau-inactivite-texte">Vous allez être déconnecté dans 60 s</span>
        <button type="button" class="btn btn-principal" data-rester-connecte>Rester connecté</button>
    </div>
}
<main>
    @Body
</main>

@code {
    [CascadingParameter] private HttpContext? Contexte { get; set; }

    private SessionEcran? Session => Contexte?.Session();
    private bool Ouverte => Session is { Ouverte: true };
    private string Chemin => Contexte?.Request.Path.Value?.Trim('/') ?? "";
    private string Accueil => Session is { Titulaire: true } ? "mes-officines" : "officines";
    private string Retour => Contexte is null ? "/" + Accueil : Contexte.Request.Path + Contexte.Request.QueryString;
    private string? Theme => Contexte?.Request.Cookies[Jetons.CookieTheme] is "clair" or "sombre" ? Contexte.Request.Cookies[Jetons.CookieTheme] : null;

    private bool EstActif(string ecran) => Chemin == ecran || Chemin.StartsWith(ecran + "/", StringComparison.Ordinal) || (ecran == Accueil && Chemin == "");
    private string? Actif(string ecran) => EstActif(ecran) ? "active" : null;
    private string? Courant(string ecran) => EstActif(ecran) ? "page" : null;
}
