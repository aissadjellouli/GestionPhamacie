@page "/officines/{Id:guid}/code-affiche"
@inject CodesAffiches Codes

<PageTitle>Code d'activation · écrans du central</PageTitle>

<div class="page page-serree">
    <div class="titre-page">
        <div>
            <h1>Code d'activation</h1>
            <p class="sous-titre">Affiché UNE seule fois : copiez-le maintenant et transmettez-le au titulaire par un canal sûr.</p>
        </div>
        <div class="actions">
            <a class="btn btn-contour" href="@($"officines/{Id}?rubrique=codes")">Fiche de l'officine</a>
        </div>
    </div>
    @if (Affiche is { } a)
    {
        <section class="panneau" aria-labelledby="t-code">
            <h2 id="t-code">Serveur @(a.Serveur == "second" ? "second" : "principal") · valable 24 heures, usage unique</h2>
            <p class="code-activation" id="code-activation">@a.Code</p>
            <div class="actions">
                <button type="button" class="btn btn-principal" data-copier="code-activation">Copier</button>
                <span class="detail" data-copie-faite="code-activation" hidden>Copié.</span>
            </div>
            <p class="detail">À coller dans l'écran « Administration › Synchronisation » du poste de l'officine (onglet Activation). Le central n'en garde que l'empreinte.</p>
        </section>
    }
    else
    {
        <div class="avertissement" role="status">Ce code a déjà été affiché (ou plus de 2 minutes ont passé) : il n'est plus visible. S'il a été perdu, créez-en un nouveau depuis la fiche de l'officine.</div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext? Contexte { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] private string? Reference { get; set; }

    private (Guid Officine, string Serveur, string Code)? Affiche { get; set; }

    protected override void OnInitialized()
    {
        if (Contexte?.Session() is { } s && Codes.Prendre(Reference, s.Id) is { } a && a.Officine == Id
            && a.Serveur != CodesAffiches.MotDePasse) Affiche = a;   // jamais un mot de passe provisoire (script central 038) sur cette page
    }
}
