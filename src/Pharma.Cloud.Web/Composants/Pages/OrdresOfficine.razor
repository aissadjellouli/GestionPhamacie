@page "/mes-officines/{Id:guid}/ordres"
@inject DepotEcrans Depot

<PageTitle>Ordres à distance · écrans du central</PageTitle>

@* Lot S7.3 : ordres du titulaire à une officine (droit « ordres », accordé seulement depuis le poste de l'officine). Liste fermée
   (essai, sauvegarde, vérification d'intégrité : aucun ne modifie une vente, un stock, un prix ni un compte), code de confirmation
   à usage unique, 24 heures ; statut : en attente, à confirmer sur le poste, appliqué, refusé, expiré, annulé. *@
<div class="page page-serree">
    <div class="titre-page">
        <div>
            <h1>Ordres à distance</h1>
            <p class="sous-titre">Demandes envoyées à l'officine par la voie habituelle du serveur central ; l'officine les relève, les contrôle et les applique elle-même.</p>
        </div>
        <div class="actions">
            <a class="btn btn-contour" href="@($"mes-officines/{Id}")">Tableau de bord</a>
            <a class="btn btn-contour" href="mes-officines">Mes officines</a>
        </div>
    </div>
    <Message Erreur="@Erreur" Ok="@Ok" />
    @if (Refuse)
    {
        <Message Erreur="ordre_refuse" />
    }
    else
    {
        <section class="panneau" aria-labelledby="t-nouvel-ordre">
            <h2 id="t-nouvel-ordre">Nouvel ordre</h2>
            <DemandeCode Retour="@($"/mes-officines/{Id}/ordres")" />
            <form method="post" action="@($"actions/mes-officines/{Id}/ordre")" class="formulaire-action">
                <AntiforgeryToken />
                <div class="champ">
                    <label for="type" class="requis">Ordre</label>
                    <select id="type" name="type" required>
                        @foreach (var (type, libelle, _) in Rubriques.OrdresTitulaire)
                        {
                            <option value="@type">@libelle</option>
                        }
                    </select>
                </div>
                <div class="champ">
                    <label for="code" class="requis">Code de confirmation reçu</label>
                    <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required />
                </div>
                <div class="actions">
                    <button type="submit" class="btn btn-principal">Envoyer l'ordre</button>
                </div>
            </form>
            <p class="detail">
                @foreach (var (_, libelle, explication) in Rubriques.OrdresTitulaire)
                {
                    <span>« @libelle » : @explication </span>
                }
                Un ordre non traité dans les 24 heures expire ; un seul ordre du même type à la fois.
            </p>
        </section>
        <TableauEcran Table="@Table" Vide="Aucun ordre envoyé à cette officine depuis les écrans." />
        <PaginationEcran Page="@PageCourante" Taille="@Taille" Total="@Table.Total" Base="@($"mes-officines/{Id}/ordres")" />
    }
</div>

@code {
    private const int Taille = 10;

    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext? Contexte { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private int? Numero { get; set; }
    [SupplyParameterFromQuery(Name = "erreur")] private string? Erreur { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }

    private TableEcran Table { get; set; } = TableEcran.Vide;
    private int PageCourante => Math.Clamp(Numero ?? 1, 1, 100_000);

    // La base ne rend aucune ligne si l'ouverture est refusée (rattachement retiré, droit « ordres » absent : noté au journal) ;
    // la colonne « total » n'existe alors pas dans la réponse
    private bool Refuse => Table.Lignes.Count == 0 && PageCourante == 1 && !Ouverte;
    private bool Ouverte { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Contexte?.EmpreinteJeton() is not { } jeton) return;
        Table = await Depot.TitulaireOrdresAsync(jeton, Id, PageCourante, Taille, Contexte.RequestAborted);
        Ouverte = Table.Lignes.Count > 0 || await Depot.TitulaireDroitAsync(jeton, Id, "ordres", Contexte.RequestAborted);
    }
}
