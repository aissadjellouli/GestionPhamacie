@page "/mes-officines/{Id:guid}/ordres"
@using Pharma.Domain.Reglages
@inject DepotEcrans Depot

<PageTitle>Ordres à distance · écrans du central</PageTitle>

@* Lot S7.3 : ordres du titulaire à une officine (droit « ordres », accordé seulement depuis le poste de l'officine). Liste fermée
   (essai, sauvegarde, vérification d'intégrité : aucun ne modifie une vente, un stock, un prix ni un compte), code de confirmation
   à usage unique, 24 heures ; statut : en attente, à confirmer sur le poste, appliqué, refusé, expiré, annulé.
   Script central 038 : message à afficher sur les postes (texte simple, 200 caractères, 1 à 7 jours). *@
<div class="page page-serree">
    <div class="titre-page titre-actions-cote">
        <div>
            <h1>Ordres à distance</h1>
            <p class="sous-titre">L'officine relève, contrôle et applique elle-même chaque demande.</p>
        </div>
        <div class="actions">
            @* Code de confirmation dans la ligne du titre : une ligne de moins, panneaux et historique sans défilement à 1 366 × 768 *@
            @if (!Refuse)
            {
                <DemandeCode Retour="@($"/mes-officines/{Id}/ordres")" />
            }
            <a class="btn btn-contour" href="@($"mes-officines/{Id}")">Tableau de bord</a>
            <a class="btn btn-contour" href="mes-officines">Mes officines</a>
        </div>
    </div>
    <Message Erreur="@Erreur" Ok="@Ok" />
    @if (Refuse)
    {
        <Message Erreur="ordre_refuse" />
    }
    else
    {
        <div class="ordres-titulaire">
            <section class="panneau" aria-labelledby="t-nouvel-ordre">
                <h2 id="t-nouvel-ordre">Nouvel ordre</h2>
                <form method="post" action="@($"actions/mes-officines/{Id}/ordre")" class="formulaire-action">
                    <AntiforgeryToken />
                    <div class="champ">
                        <label for="type" class="requis">Ordre</label>
                        <select id="type" name="type" required>
                            @foreach (var (type, libelle, _) in Rubriques.OrdresTitulaire)
                            {
                                <option value="@type">@libelle</option>
                            }
                        </select>
                    </div>
                    <div class="champ">
                        <label for="code" class="requis">Code de confirmation reçu</label>
                        <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required />
                    </div>
                    <div class="actions">
                        <button type="submit" class="btn btn-principal">Envoyer l'ordre</button>
                    </div>
                </form>
                @* Explications repliées : les deux panneaux et l'historique tiennent sans défilement à 1 366 × 768 *@
                <details class="detail explication-repliee">
                    <summary>Ce que fait chaque ordre</summary>
                    @foreach (var (_, libelle, explication) in Rubriques.OrdresTitulaire)
                    {
                        <span>« @libelle » : @explication </span>
                    }
                    Un ordre non traité dans les 24 heures expire ; un seul ordre du même type à la fois.
                </details>
            </section>
            @* Script central 038 : message à afficher sur les postes (liste fermée S7.3) ; texte simple contrôlé ici, par la base et par le poste *@
            <section class="panneau" aria-labelledby="t-message">
                <h2 id="t-message">Message sur les postes</h2>
                <form method="post" action="@($"actions/mes-officines/{Id}/message")" class="formulaire-action">
                    <AntiforgeryToken />
                    <div class="champ champ-large">
                        <label for="texte" class="requis">Message (@MessagePostes.LongueurMax caractères au plus, texte simple sur une ligne, sans lien)</label>
                        <input id="texte" name="texte" type="text" maxlength="@MessagePostes.LongueurMax" autocomplete="off" required />
                    </div>
                    <div class="champ">
                        <label for="jours" class="requis">Durée d'affichage</label>
                        @* 2026-11-22 : plus d'heure calculée ici (horloge du serveur des écrans, qui n'a pas le fuseau de l'officine) : la base
                           fixe la fin à l'envoi, même heure N jours plus tard ; le poste l'affiche à l'heure de l'officine *@
                        <select id="jours" name="jours" required>
                            @for (var n = MessagePostes.JoursMin; n <= MessagePostes.JoursMax; n++)
                            {
                                <option value="@n">@Rubriques.DureeMessage(n)</option>
                            }
                        </select>
                    </div>
                    <div class="champ">
                        <label for="code-message" class="requis">Code de confirmation reçu</label>
                        <input id="code-message" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required />
                    </div>
                    <div class="actions">
                        <button type="submit" class="btn btn-principal">Envoyer le message</button>
                    </div>
                </form>
                <details class="detail explication-repliee">
                    <summary>Où et combien de temps il s'affiche</summary>
                    Montré dans la barre d'état de tous les postes de l'officine pendant la durée choisie (7 jours au plus), jusqu'à la même
                    heure que l'envoi : l'heure exacte de fin est fixée à l'envoi et affichée sur les postes à l'heure de l'officine ; le titulaire de
                    l'officine peut le fermer. Un nouveau message remplace le précédent. « Appliqué » = affiché.
                </details>
            </section>
        </div>
        @* Historique : 100 px au moins (au lieu de 140) pour que les deux formulaires et l'historique tiennent à 1 366 × 768 *@
        <div data-hauteur-min="100">
            <TableauEcran Table="@Table" Vide="Aucun ordre envoyé à cette officine depuis les écrans." />
        </div>
        <PaginationEcran Page="@PageCourante" Taille="@Taille" Total="@Table.Total" Base="@($"mes-officines/{Id}/ordres")" />
    }
</div>

@code {
    private const int Taille = 10;

    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext? Contexte { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private int? Numero { get; set; }
    [SupplyParameterFromQuery(Name = "erreur")] private string? Erreur { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] private string? Ok { get; set; }

    private TableEcran Table { get; set; } = TableEcran.Vide;
    private int PageCourante => Math.Clamp(Numero ?? 1, 1, 100_000);

    // La base ne rend aucune ligne si l'ouverture est refusée (rattachement retiré, droit « ordres » absent : noté au journal) ;
    // la colonne « total » n'existe alors pas dans la réponse
    private bool Refuse => Table.Lignes.Count == 0 && PageCourante == 1 && !Ouverte;
    private bool Ouverte { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Contexte?.EmpreinteJeton() is not { } jeton) return;
        Table = await Depot.TitulaireOrdresAsync(jeton, Id, PageCourante, Taille, Contexte.RequestAborted);
        Ouverte = Table.Lignes.Count > 0 || await Depot.TitulaireDroitAsync(jeton, Id, "ordres", Contexte.RequestAborted);
    }
}
