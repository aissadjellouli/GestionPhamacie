@page "/comptes/mot-de-passe-affiche"
@inject CodesAffiches Codes

<PageTitle>Mot de passe provisoire · écrans du central</PageTitle>

@* Script central 038 : mot de passe provisoire d'un compte remis à zéro par l'éditeur. Gardé en MÉMOIRE seulement (2 minutes, même
   session) et montré UNE seule fois ; jamais en base (empreinte BCrypt seulement), dans un journal, une adresse ni un e-mail. *@
<div class="page page-serree">
    <div class="titre-page">
        <div>
            <h1>Mot de passe provisoire</h1>
            <p class="sous-titre">Affiché UNE seule fois : transmettez-le de vive voix, après avoir vérifié l'identité de la personne.</p>
        </div>
        <div class="actions">
            <a class="btn btn-contour" href="@(Compte is { } c ? $"comptes?compte={c}&action=mot-de-passe" : "comptes")">Comptes</a>
        </div>
    </div>
    @if (Affiche is { } a)
    {
        <section class="panneau" aria-labelledby="t-mdp">
            <h2 id="t-mdp">@(Cree ? "Compte créé · mot de passe à changer à la première connexion" : "Mot de passe remis à zéro · à changer à la prochaine connexion")</h2>
            <p class="mot-de-passe-provisoire" id="mot-de-passe-provisoire">@a</p>
            <div class="actions">
                <button type="button" class="btn btn-principal" data-copier="mot-de-passe-provisoire">Copier</button>
                <span class="detail" data-copie-faite="mot-de-passe-provisoire" hidden>Copié.</span>
            </div>
            <p class="detail">@(Cree ? "" : "Les sessions ouvertes du compte sont fermées. ")À la connexion, le code de confirmation part sur le contact du compte ;
                le nouveau mot de passe est ensuite exigé. Le central n'en garde que l'empreinte : ce mot de passe ne pourra plus être réaffiché.</p>
        </section>
    }
    else
    {
        <Message Erreur="mdp_affiche" />
    }
</div>

@code {
    [CascadingParameter] private HttpContext? Contexte { get; set; }
    [SupplyParameterFromQuery(Name = "ref")] private string? Reference { get; set; }
    [SupplyParameterFromQuery(Name = "compte")] private Guid? Compte { get; set; }
    /// <summary>Script central 039 : compte qui vient d'être créé (et non remis à zéro).</summary>
    [SupplyParameterFromQuery(Name = "cree")] private string? CreeTexte { get; set; }
    private bool Cree => CreeTexte == "1";

    private string? Affiche { get; set; }

    protected override void OnInitialized()
    {
        if (Contexte?.Session() is { Editeur: true } s && Codes.Prendre(Reference, s.Id) is { } a && a.Serveur == CodesAffiches.MotDePasse
            && (Compte is null || a.Officine == Compte))
            Affiche = a.Code;
    }
}
