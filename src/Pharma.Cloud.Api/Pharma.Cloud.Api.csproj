<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pharma.Cloud.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <!-- Jetons ES256 (création et vérification) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Archive de départ d'une officine : zip chiffré AES-256 (WinZip AE-2) -->
    <PackageReference Include="SharpZipLib" />
    <!-- Mot de passe de l'archive de départ envoyé au titulaire par le compte SMTP de l'éditeur (TLS obligatoire) -->
    <PackageReference Include="MailKit" />
    <!-- Comptes distants des écrans (lot S7.1) : mot de passe provisoire, empreinte BCrypt coût 12 -->
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pharma.Shared\Pharma.Shared.csproj" />
    <!-- Règles métier des réglages mutualisés : même validation que la saisie locale (lot M6) -->
    <ProjectReference Include="..\Pharma.Domain\Pharma.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scripts de la base centrale livrés avec l'API centrale -->
    <None Include="..\..\database\cloud\*.sql" Link="database\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
