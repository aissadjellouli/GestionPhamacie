<?xml version="1.0" encoding="utf-8"?>
<!-- PharmaOfficine : seule la source publique nuget.org est utilisée.
     Les sources déclarées pour l'utilisateur (autres projets du poste) sont ignorées ici. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
