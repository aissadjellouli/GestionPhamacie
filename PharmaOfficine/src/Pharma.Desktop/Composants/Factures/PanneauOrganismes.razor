@inject ApiClient Api

@* Organismes payeurs (tiers payant et factures) : CNAS, CASNOS, organisme des militaires… Modification réservée au titulaire. *@
<section class="panneau" aria-labelledby="t-organismes">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px">
        <div>
            <h2 id="t-organismes">Organismes payeurs</h2>
            <p class="sous-titre">Proposés au tiers payant de la caisse et destinataires des factures. Adresse et NIF sont imprimés sur leurs factures.</p>
        </div>
        <button type="button" class="btn" @onclick="() => edition = new Edition()">Ajouter un organisme</button>
    </div>
    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }
    @if (edition is { } e)
    {
        <div class="achats-ligne">
            <div class="champ" style="flex: 0 0 120px"><label for="o-code" class="requis">Sigle</label><input id="o-code" type="text" maxlength="20" @bind="e.Code" /></div>
            <div class="champ" style="flex: 1 1 260px"><label for="o-nom" class="requis">Nom</label><input id="o-nom" type="text" @bind="e.Nom" /></div>
            <div class="champ" style="flex: 1 1 220px"><label for="o-adr">Adresse</label><input id="o-adr" type="text" @bind="e.Adresse" /></div>
            <div class="champ" style="flex: 0 0 180px"><label for="o-nif">NIF</label><input id="o-nif" type="text" @bind="e.Nif" /></div>
        </div>
        <label class="case"><input type="checkbox" @bind="e.Actif" /><span>Actif (proposé à la caisse)</span></label>
        <div class="filtres">
            <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">Enregistrer</button>
            <button type="button" class="btn" @onclick="() => edition = null">Annuler</button>
        </div>
    }
    <div class="tableau-cadre">
        <table class="tableau">
            <thead><tr><th scope="col">Sigle</th><th scope="col">Nom</th><th scope="col">Adresse</th><th scope="col">NIF</th><th scope="col">État</th><th scope="col"><span class="visuellement-cache">Action</span></th></tr></thead>
            <tbody>
                @foreach (var o in organismes)
                {
                    <tr>
                        <td><strong>@o.Code</strong></td><td>@o.Nom</td><td>@(o.Adresse ?? "—")</td><td>@(o.Nif ?? "—")</td>
                        <td>@(o.Actif ? "Actif" : "Inactif")</td>
                        <td><button type="button" class="lien-bouton" @onclick="() => Modifier(o)">Modifier</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private sealed class Edition
    {
        public long? Id { get; init; }
        public string Code { get; set; } = "";
        public string Nom { get; set; } = "";
        public string? Adresse { get; set; }
        public string? Nif { get; set; }
        public bool Actif { get; set; } = true;
    }

    private List<OrganismeFicheDto> organismes = [];
    private Edition? edition;
    private string? erreur, message;
    private bool enCours;

    protected override async Task OnInitializedAsync() => (organismes, erreur) = await Api.OrganismesFichesAsync();

    private void Modifier(OrganismeFicheDto o) =>
        edition = new Edition { Id = o.Id, Code = o.Code, Nom = o.Nom, Adresse = o.Adresse, Nif = o.Nif, Actif = o.Actif };

    private async Task EnregistrerAsync()
    {
        if (edition is not { } e) return;
        (enCours, erreur, message) = (true, null, null);
        var (_, err) = await Api.EnregistrerOrganismeAsync(new OrganismeFicheDto(e.Id, e.Code, e.Nom, e.Adresse, e.Nif, e.Actif));
        enCours = false;
        if (err is not null) { erreur = err; return; }
        message = $"Organisme « {e.Code} » enregistré.";
        edition = null;
        (organismes, erreur) = await Api.OrganismesFichesAsync();
    }
}
