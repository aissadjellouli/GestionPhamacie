@inject ApiClient Api

@* Seuil d'alerte de stock par produit : saisi par le pharmacien, sinon calculé automatiquement. Enregistré tout de suite. *@

<section class="panneau" aria-labelledby="t-seuil-produit">
    <div>
        <h2 id="t-seuil-produit">Seuil d’alerte de stock par produit</h2>
        <p class="sous-titre">
            Sans réglage, le seuil est automatique : ventes moyennes par jour × (délai de livraison + stock de sécurité).
            Un seuil saisi le remplace ; 0 = pas d’alerte de stock pour ce produit. Les alertes sont recalculées aussitôt.
        </p>
    </div>

    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }

    <div class="achats-ligne">
        <ChoixProduit @ref="choix" Id="sp-produit" Style="flex: 1 1 320px" OnChoisi="ChoisirAsync" OnEfface="() => courant = null" />
    </div>

    @if (courant is { } c)
    {
        <div class="carte" style="display: flex; flex-direction: column; gap: 10px">
            <strong>@c.Nom</strong>
            <span class="detail">
                Stock @c.Stock · ventes @c.VentesParJour.ToString("0.##") / jour · seuil automatique <strong>@c.SeuilAuto</strong>
                · appliqué : <strong>@c.SeuilApplique</strong> (@(c.SeuilManuel is null ? "automatique" : "saisi")) · @LibelleStatut(c.Statut)
            </span>
            <div class="achats-ligne">
                <div class="champ" style="flex: 0 0 220px">
                    <label for="sp-seuil">Seuil saisi (boîtes)</label>
                    <input id="sp-seuil" type="number" min="0" placeholder="@($"automatique ({c.SeuilAuto})")" @bind="saisie" />
                </div>
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="() => EnregistrerAsync(c.ProduitId, saisie)">Enregistrer</button>
                @if (c.SeuilManuel is not null)
                {
                    <button type="button" class="btn" disabled="@enCours" @onclick="() => EnregistrerAsync(c.ProduitId, null)">Revenir à l’automatique</button>
                }
            </div>
        </div>
    }

    <div class="tableau-cadre">
        <table class="tableau" style="min-width: 0">
            <thead><tr><th scope="col">Produit</th><th scope="col">Stock</th><th scope="col">Seuil saisi</th><th scope="col">Automatique</th><th scope="col">État</th><th scope="col"></th></tr></thead>
            <tbody>
                @foreach (var s in manuels)
                {
                    <tr>
                        <td class="nom">@s.Nom</td>
                        <td>@s.Stock</td>
                        <td><strong>@s.SeuilManuel</strong>@(s.SeuilManuel == 0 ? " (pas d’alerte)" : "")</td>
                        <td>@s.SeuilAuto</td>
                        <td>@LibelleStatut(s.Statut)</td>
                        <td><button type="button" class="lien" disabled="@enCours" @onclick="() => EnregistrerAsync(s.ProduitId, null)">Revenir à l’automatique</button></td>
                    </tr>
                }
                @if (manuels.Count == 0)
                {
                    <tr><td colspan="6" class="vide">Aucun seuil saisi : tous les produits sont en seuil automatique.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private ChoixProduit? choix;
    private SeuilStockDto? courant;
    private List<SeuilStockDto> manuels = [];
    private int? saisie;
    private bool enCours;
    private string? erreur, message;

    protected override async Task OnInitializedAsync() => await ChargerManuelsAsync();

    private async Task ChargerManuelsAsync()
    {
        string? e;
        (manuels, e) = await Api.SeuilsStockManuelsAsync();
        erreur ??= e;
    }

    private async Task ChoisirAsync(ProduitDto p)
    {
        (erreur, message) = (null, null);
        var (s, e) = await Api.SeuilStockAsync(p.Id);
        (courant, erreur, saisie) = (s, e, s?.SeuilManuel);
    }

    private async Task EnregistrerAsync(long produitId, int? seuil)
    {
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var (s, e) = await Api.DefinirSeuilStockAsync(produitId, seuil);
            if (e is not null) { erreur = e; return; }
            message = s!.SeuilManuel is null
                ? $"{s.Nom} : seuil automatique ({s.SeuilAuto}). Alertes recalculées."
                : $"{s.Nom} : seuil fixé à {s.SeuilManuel} boîte(s). Alertes recalculées.";
            if (courant?.ProduitId == produitId) (courant, saisie) = (s, s.SeuilManuel);
            await ChargerManuelsAsync();
        }
        finally { enCours = false; }
    }

    private static string LibelleStatut(string s) => s switch
    {
        "rupture" => "rupture", "critique" => "stock critique", "dormant" => "dormant", "surstock" => "surstock", _ => "normal"
    };
}
