@page "/admin/sauvegardes"
@inject ApiClient Api

<div class="page admin">
    <NavAdmin Actif="admin/sauvegardes" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Sauvegardes</h1>
                <p class="sous-titre">Copie quotidienne de la base sur un disque externe ; le titulaire est prévenu par SMS en cas de problème.</p>
            </div>
            <div class="actions">
                <button type="button" class="btn" disabled="@(r is null || enCours)" @onclick="LancerAsync">Sauvegarder maintenant</button>
                <button type="button" class="btn btn-principal" disabled="@(r is null || enCours)" @onclick="EnregistrerAsync">Enregistrer</button>
            </div>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (r is not null)
        {
            <section class="panneau" aria-labelledby="t-reg">
                <h2 id="t-reg">Réglages</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 2 1 280px"><label for="s-dossier">Dossier sur le disque externe</label><input id="s-dossier" type="text" placeholder="ex. E:\SauvegardesPharmacie" @bind="r.Dossier" /></div>
                    <div class="champ" style="flex: 0 0 150px"><label for="s-heure">Heure</label><input id="s-heure" type="time" @bind="r.Heure" /></div>
                    <div class="champ" style="flex: 0 0 200px"><label for="s-garde">Sauvegardes conservées</label><input id="s-garde" type="number" min="1" max="365" @bind="r.Conservation" /></div>
                </div>
                <label class="case"><input type="checkbox" @bind="r.Actif" /><span>Sauvegarde automatique chaque jour</span></label>
                <p class="detail" style="margin: 0">Format pg_dump (restauration avec pg_restore). Dernière sauvegarde automatique : @(derniere is { } d ? Libelles.Date(d) : "jamais").</p>
            </section>
        }

        <section class="tableau-cadre" aria-label="Journal des sauvegardes">
            <table class="tableau" style="min-width: 760px">
                <thead><tr><th scope="col">Date</th><th scope="col">Déclenchement</th><th scope="col">Résultat</th><th scope="col">Fichier</th><th scope="col">Détail</th></tr></thead>
                <tbody>
                    @foreach (var j in journal)
                    {
                        <tr>
                            <td>@Libelles.DateHeureLocale(j.Debut)</td>
                            <td>@(j.Declenchement == "manuel" ? $"Manuel{(j.Utilisateur is null ? "" : $" · {j.Utilisateur}")}" : "Automatique")</td>
                            <td><span class="pastille @(j.Statut == "reussie" ? "ok" : "urgent")">@(j.Statut switch { "reussie" => "Réussie", "disque_absent" => "Disque absent", _ => "Échouée" })</span></td>
                            <td class="detail">@(j.Fichier ?? "—")</td>
                            <td class="detail">@j.Message</td>
                        </tr>
                    }
                    @if (journal.Count == 0) { <tr><td colspan="5" class="vide">Aucune sauvegarde.</td></tr> }
                </tbody>
            </table>
        </section>
    </div>
</div>

@code {
    private sealed class Reglages
    {
        public bool Actif { get; set; }
        public string? Dossier { get; set; }
        public TimeOnly Heure { get; set; } = new(22, 0);
        public int Conservation { get; set; } = 14;
    }

    private Reglages? r;
    private DateOnly? derniere;
    private List<EntreeSauvegardeDto> journal = [];
    private bool enCours;
    private string? erreur, message;

    protected override Task OnInitializedAsync() => ChargerAsync();

    private async Task ChargerAsync()
    {
        var (etat, e) = await Api.SauvegardesAsync();
        if (e is not null) { erreur = e; return; }
        r = new Reglages { Actif = etat!.Reglages.Actif, Dossier = etat.Reglages.Dossier, Heure = etat.Reglages.Heure, Conservation = etat.Reglages.Conservation };
        derniere = etat.Reglages.DerniereExecution;
        journal = etat.Journal.ToList();
    }

    private async Task EnregistrerAsync() => await Executer(async () =>
    {
        var e = await Api.ModifierReglagesSauvegardeAsync(new ReglagesSauvegardeDto(r!.Actif, r.Dossier, r.Heure, r.Conservation, null));
        if (e is not null) return e;
        message = "Réglages enregistrés.";
        await ChargerAsync();
        return null;
    });

    private async Task LancerAsync() => await Executer(async () =>
    {
        var (res, e) = await Api.LancerSauvegardeAsync();
        if (e is not null) return e;
        await ChargerAsync();
        if (res!.Statut == "reussie") message = res.Message;
        else return res.Message + " Le titulaire est prévenu.";
        return null;
    });

    private async Task Executer(Func<Task<string?>> action)
    {
        (enCours, erreur, message) = (true, null, null);
        try { erreur = await action(); }
        finally { enCours = false; }
    }
}
