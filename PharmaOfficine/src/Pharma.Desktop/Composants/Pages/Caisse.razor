    private CommandeVenteDto Commande(string modePaiement) => new(
        lignes.Where(l => l.Lot is not null).Select(l => new LigneCommandeDto(l.ProduitId, l.Lot!.LotId, l.Quantite)).ToList(),
        tiersPayant, tiersPayant ? organismeId : null, tiersPayant ? taux : null,
        patient?.Id,
        jetonScan is not null || (apercu?.OrdonnanceRequise == true && medecin is not null)
            ? new OrdonnanceDto(medecin?.Id, datePrescription, string.IsNullOrWhiteSpace(numeroOrdonnance) ? null : numeroOrdonnance.Trim(),
                jetonScan, texteReconnu,
                PorteurDemande ? porteurNom?.Trim() : null, PorteurDemande ? porteurAdresse?.Trim() : null, PorteurDemande ? porteurPiece?.Trim() : null)
            : null,
        remisePct, modePaiement, modePaiement == "especes" ? montantRecu : null);

    /// <summary>Les totaux viennent du serveur : mêmes règles que l'encaissement (tiers payant, remise).</summary>
    private async Task RecalculerAsync()
    {
        var numero = ++requeteCalcul;
        if (!lignes.Any(l => l.Lot is not null)) { (apercu, erreurCalcul) = (null, null); Afficheur.Accueil(); return; }
        var (resultat, err) = await Api.CalculerVenteAsync(Commande("especes"));
        if (numero != requeteCalcul) return;
        (apercu, erreurCalcul) = (resultat, err);
        // Afficheur client : lignes du panier et part à payer par le patient
        Afficheur.Panier(lignes.Where(l => l.Lot is not null).Select(l => (l.Nom, l.Quantite, l.Prix * l.Quantite)).ToList(), apercu?.PartPatient ?? 0);
    }

    // Ticket de la dernière vente, imprimé par Windows (imprimante du poste ou imprimante par défaut)
    private bool impressionEnCours, ticketImprime;
    private string? messageTicket;

    private async Task ImprimerTicketAsync()
    {
        if (venteFaite is null) return;
        (impressionEnCours, messageTicket) = (true, null);
        try
        {
            var (ticket, e) = await Api.TicketAsync(venteFaite.VenteId);
            e ??= await Tickets.ImprimerAsync(ticket!, venteFaite.Mode == "especes" ? venteFaite.Rendu : null);
            ticketImprime = e is null;
            messageTicket = e ?? $"Ticket {venteFaite.Numero} envoyé à l’imprimante{(Tickets.NomDeclare is { } n ? $" « {n} »" : " par défaut")}.";
        }
        finally { impressionEnCours = false; }
    }

    private async Task EncaisserAsync(string modePaiement)
    {
        if (!PeutEncaisser) return;
        messageTicket = null;
        enCours = true;
        erreurEncaissement = null;
        var (vente, err) = await Api.EncaisserAsync(Commande(modePaiement));
        enCours = false;
        if (err is not null) { erreurEncaissement = err; return; }

        venteFaite = vente;
        Afficheur.Paiement(vente!.PartPatient, vente.Mode == "especes" ? montantRecu : null, vente.Mode == "especes" ? vente.Rendu : 0);
        // Réglage du poste : ticket imprimé sans clic après chaque vente
        if (Tickets.Automatique) _ = InvokeAsync(async () => { await ImprimerTicketAsync(); StateHasChanged(); });
        ViderPanier();
    }

