    // Champs obligatoires : patient (tiers payant, ordonnance), médecin (psychotrope), nom du nouveau patient
    private bool PatientManquant => PatientObligatoire && patient is null && !nouveauPatient;
    private bool MedecinManquant => apercu?.OrdonnanceRequise == true && medecin is null;
    private bool controlePatient;
    private ElementReference champNomPatient;
    private bool NomPatientManquant => Obligatoire.Manque(controlePatient, np.Nom);

    private async Task CreerPatientAsync()
    {
        controlePatient = true;
        if (NomPatientManquant)
        {
            erreurEncaissement = "Le nom du patient est obligatoire.";
            await champNomPatient.FocusAsync();
            return;
        }
        var saisie = new NouveauPatientDto(np.Nom, np.Prenom, np.Telephone, np.NumAssure,
            np.OrganismeId > 0 ? np.OrganismeId : null, np.Plafond);
        var (cree, err) = await Api.CreerPatientAsync(saisie);
        if (err is not null) { erreurEncaissement = err; return; }
        var organisme = organismes.FirstOrDefault(o => o.Id == np.OrganismeId);
        nouveauPatient = false;
        erreurEncaissement = null;
        controlePatient = false;
        await ChoisirPatientAsync(new PatientDto(cree!.Id, saisie.Nom.Trim(), saisie.Prenom, saisie.Telephone, saisie.NumAssure,
            saisie.OrganismeId, organisme?.Code, saisie.PlafondCredit, 0));
    }

