    // ---- Ventes en attente (poste) ----
    private List<VenteEnAttenteDto> attentes = [];
    private long? aAbandonner;
    private string? erreurAttente;

    private async Task ChargerAttentesAsync()
    {
        var (liste, e) = await Api.VentesEnAttenteAsync();
        (attentes, erreurAttente) = (liste, e);
    }

    /// <summary>Le panier et le règlement en cours de saisie partent sur le serveur ; la caisse est libérée.</summary>
    private async Task MettreEnAttenteAsync()
    {
        if (lignes.Count == 0) return;
        erreurAttente = null;
        var panier = new PanierAttenteDto(
            lignes.Select(l => new LignePanierAttenteDto(l.ProduitId, l.Nom, l.Prix, l.Lot, l.Quantite, l.BoiteScannee, l.StockProduit)).ToList(),
            tiersPayant, organismeId, taux, patient, medecin, datePrescription, numeroOrdonnance, remisePct, jetonScan, texteReconnu);
        var libelle = patient is { } p ? $"{p.Nom} {p.Prenom}".Trim() : $"Vente de {DateTime.Now:HH:mm}";
        var total = apercu?.MontantTotal ?? lignes.Sum(l => l.Prix * l.Quantite);
        var e = await Api.MettreEnAttenteAsync(new MiseEnAttenteRequete(libelle, lignes.Count, total,
            System.Text.Json.JsonSerializer.Serialize(panier)));
        if (e is not null) { erreurAttente = e; return; }
        venteFaite = null;
        ViderPanier();
        await ChargerAttentesAsync();
    }

    /// <summary>Reprise : le panier en cours (s'il y en a un) part d'abord en attente, rien n'est perdu.</summary>
    private async Task ReprendreAsync(VenteEnAttenteDto v)
    {
        erreurAttente = null;
        if (lignes.Count > 0) { await MettreEnAttenteAsync(); if (erreurAttente is not null) return; }
        var (json, e) = await Api.ReprendreVenteEnAttenteAsync(v.Id);
        if (e is not null) { erreurAttente = e; await ChargerAttentesAsync(); return; }
        var p = System.Text.Json.JsonSerializer.Deserialize<PanierAttenteDto>(json!)!;
        ViderPanier();
        venteFaite = null;
        foreach (var l in p.Lignes)
            lignes.Add(new LignePanier { ProduitId = l.ProduitId, Nom = l.Nom, Prix = l.Prix, Lot = l.Lot, Quantite = l.Quantite, BoiteScannee = l.BoiteScannee, StockProduit = l.StockProduit });
        (tiersPayant, organismeId, taux, patient, medecin) = (p.TiersPayant, p.OrganismeId, p.Taux, p.Patient, p.Medecin);
        (datePrescription, numeroOrdonnance, remisePct, jetonScan, texteReconnu) = (p.DatePrescription, p.NumeroOrdonnance, p.RemisePct, p.JetonScan, p.TexteReconnu);
        if (medecin is not null) medecinTexte = medecin.Nom;
        await ChargerAttentesAsync();
        await RecalculerAsync();   // prix et parts recalculés par le serveur
    }

    private async Task AbandonnerAsync(VenteEnAttenteDto v)
    {
        aAbandonner = null;
        erreurAttente = await Api.SupprimerVenteEnAttenteAsync(v.Id);
        await ChargerAttentesAsync();
    }

    /// <summary>Panier et règlement remis à zéro (après une vente ou une mise en attente).</summary>
    private void ViderPanier()
    {
        lignes.Clear();
        (apercu, bandeau, erreur, montantRecu, remisePct) = (null, null, null, null, 0);
        (patient, medecin, medecinTexte, numeroOrdonnance, tiersPayant, mode) = (null, null, "", null, false, "especes");
        (image, jetonScan, texteReconnu, lignesOrdonnance, lignesIgnorees, imageAgrandie) = (null, null, null, [], 0, false);
        lectureAjouts.Clear();
        (motifSaisieManuelle, lectureSansResultat) = (null, null);
        (porteurAutre, porteurNom, porteurAdresse, porteurPiece) = (false, null, null, null);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("pharma.arreterF12"); }
        catch (JSDisconnectedException) { }
        reference?.Dispose();
    }
