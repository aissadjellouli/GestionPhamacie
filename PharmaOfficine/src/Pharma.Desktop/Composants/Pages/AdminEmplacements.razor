@page "/admin/emplacements"
@inject ApiClient Api

<div class="page admin">
    <NavAdmin Actif="admin/emplacements" />

    <div class="admin-contenu">
        <div class="titre-page">
            <div>
                <h1>Emplacements</h1>
                <p class="sous-titre">Rayons, étagères et tiroirs de la pharmacie, et la réserve. Les produits se rangent depuis l’écran Stock.</p>
            </div>
            <button type="button" class="btn btn-principal" @onclick="() => fiche = new()">Ajouter un emplacement</button>
        </div>

        @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
        @if (message is not null) { <div class="succes" role="status">@message</div> }

        @if (fiche is not null)
        {
            <section class="panneau" aria-labelledby="t-fiche-empl">
                <h2 id="t-fiche-empl">@(fiche.Id is null ? "Nouvel emplacement" : $"Modifier {fiche.CodeInitial}")</h2>
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 110px"><label for="e-rayon">Rayon *</label><input id="e-rayon" type="text" maxlength="10" placeholder="A" @bind="fiche.Rayon" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 0 0 110px"><label for="e-etagere">Étagère</label><input id="e-etagere" type="text" maxlength="10" placeholder="02" @bind="fiche.Etagere" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 0 0 110px"><label for="e-tiroir">Tiroir</label><input id="e-tiroir" type="text" maxlength="10" placeholder="3" @bind="fiche.Tiroir" @bind:event="oninput" /></div>
                    <div class="champ" style="flex: 2 1 240px"><label for="e-libelle">Libellé</label><input id="e-libelle" type="text" placeholder="ex. Antibiotiques, Réfrigérateur" @bind="fiche.Libelle" /></div>
                    <div class="champ" style="flex: 0 0 160px">
                        <label for="e-zone">Zone</label>
                        <select id="e-zone" @bind="fiche.Zone"><option value="vente">Vente</option><option value="reserve">Réserve</option></select>
                    </div>
                </div>
                <p class="detail" style="margin: 0">Code : <strong>@Apercu</strong></p>
                @if (fiche.Id is not null)
                {
                    <label class="case"><input type="checkbox" @bind="fiche.Actif" /><span>Emplacement utilisé (décoché : il n’est plus proposé pour ranger un produit)</span></label>
                }
                <div style="display: flex; gap: 8px">
                    <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerAsync">@(fiche.Id is null ? "Créer" : "Enregistrer")</button>
                    <button type="button" class="btn" @onclick="() => fiche = null">Annuler</button>
                </div>
            </section>
        }

        @foreach (var groupe in emplacements.GroupBy(e => e.Zone))
        {
            <section class="tableau-cadre" aria-label="@(groupe.Key == "vente" ? "Zone de vente" : "Réserve")">
                <table class="tableau" style="min-width: 0">
                    <thead><tr><th scope="col">@(groupe.Key == "vente" ? "Zone de vente" : "Réserve")</th><th scope="col">Libellé</th><th scope="col">Produits rangés</th><th scope="col">État</th><th scope="col"></th></tr></thead>
                    <tbody>
                        @foreach (var e in groupe)
                        {
                            <tr>
                                <td><span class="code-emplacement">@e.Code</span></td>
                                <td>@(e.Libelle ?? "—")</td>
                                <td>@e.NombreProduits</td>
                                <td><span class="pastille @(e.Actif ? "ok" : "info")">@(e.Actif ? "Utilisé" : "Désactivé")</span></td>
                                <td><button type="button" class="btn" @onclick="() => Editer(e)">Modifier</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
        @if (emplacements.Count == 0 && erreur is null)
        {
            <p class="vide">Aucun emplacement : commencez par les rayons (A, B, C…) puis la réserve.</p>
        }
    </div>
</div>

@code {
    private sealed class Fiche
    {
        public long? Id { get; init; }
        public string? CodeInitial { get; init; }
        public string? Rayon { get; set; }
        public string? Etagere { get; set; }
        public string? Tiroir { get; set; }
        public string? Libelle { get; set; }
        public string Zone { get; set; } = "vente";
        public bool Actif { get; set; } = true;
    }

    private List<EmplacementDto> emplacements = [];
    private Fiche? fiche;
    private bool enCours;
    private string? erreur, message;

    private string Apercu => fiche is null ? "" : string.Join('-', new[] { fiche.Rayon, fiche.Etagere, fiche.Tiroir }
        .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!.Trim().ToUpperInvariant())) is { Length: > 0 } c ? c : "—";

    protected override Task OnInitializedAsync() => ChargerAsync();

    private async Task ChargerAsync()
    {
        string? e;
        (emplacements, e) = await Api.EmplacementsAsync();
        erreur ??= e;
    }

    private void Editer(EmplacementDto e) => fiche = new Fiche
    {
        Id = e.Id, CodeInitial = e.Code, Rayon = e.Rayon, Etagere = e.Etagere, Tiroir = e.Tiroir, Libelle = e.Libelle, Zone = e.Zone, Actif = e.Actif
    };

    private async Task EnregistrerAsync()
    {
        (enCours, erreur, message) = (true, null, null);
        try
        {
            var (_, e) = await Api.EnregistrerEmplacementAsync(fiche!.Id,
                new SaisieEmplacementDto(fiche.Rayon, fiche.Etagere, fiche.Tiroir, fiche.Libelle, fiche.Zone, fiche.Actif));
            if (e is not null) { erreur = e; return; }
            message = $"Emplacement {Apercu} enregistré.";
            fiche = null;
            await ChargerAsync();
        }
        finally { enCours = false; }
    }
}
