@page "/tresorerie"
@inject ApiClient Api
@inject ConfigurationPoste Config

<div class="page">
    <div class="titre-page">
        <div>
            <h1>Trésorerie</h1>
            <p class="sous-titre">Coffre et banques : dépenses, versements des caisses et des organismes, chèques à remettre, transferts</p>
        </div>
        <button type="button" class="btn" @onclick="NouvelleBanque">Ajouter une banque</button>
    </div>

    @if (erreur is not null) { <div class="erreur" role="alert">@erreur</div> }
    @if (message is not null) { <div class="succes" role="status">@message</div> }

    <!-- Comptes et soldes -->
    <div class="tuiles" style="grid-template-columns: repeat(auto-fill, minmax(230px, 1fr))">
        @foreach (var c in comptes)
        {
            <div class="carte @(c.Id == compteVu ? "carte-choisie" : null)" style="display: grid; gap: 4px; @(c.Actif ? null : "opacity: .6")">
                <span class="detail">@(c.Type == "coffre" ? "Coffre" : c.Banque ?? "Banque")@(c.RecoitCarte ? " · reçoit les cartes" : "")@(c.Actif ? "" : " · inactif")</span>
                <strong>@c.Nom</strong>
                <span class="tresorerie-solde @(c.Solde < 0 ? "montant-du" : null)">@Libelles.Dinars(c.Solde, 2)</span>
                <span class="detail">depuis le @c.DateInitiale.ToString("dd/MM/yyyy") (départ @Libelles.Dinars(c.SoldeInitial, 2))</span>
                <div class="filtres">
                    <button type="button" class="lien-bouton" @onclick="() => VoirAsync(c.Id)">Mouvements</button>
                    <button type="button" class="lien-bouton" @onclick="() => Modifier(c)">Modifier</button>
                </div>
            </div>
        }
    </div>

    @if (edition is { } e)
    {
        <section class="panneau" aria-labelledby="t-compte">
            <h2 id="t-compte">@(e.Id is null ? "Nouvelle banque" : $"Modifier « {e.Nom} »")</h2>
            <div class="achats-ligne">
                <div class="champ" style="flex: 1 1 200px"><label for="c-nom" class="requis">Nom du compte</label><input id="c-nom" type="text" @bind="e.Nom" placeholder="Ex. CPA agence centre" /></div>
                @if (e.Type != "coffre")
                {
                    <div class="champ" style="flex: 1 1 160px"><label for="c-banque">Banque</label><input id="c-banque" type="text" @bind="e.Banque" placeholder="CPA, BNA, BADR, CCP…" /></div>
                    <div class="champ" style="flex: 1 1 200px"><label for="c-num">N° de compte (RIB)</label><input id="c-num" type="text" @bind="e.NumeroCompte" /></div>
                }
                <div class="champ" style="flex: 0 0 170px"><label for="c-solde">Solde de départ (DA)</label><input id="c-solde" type="number" step="0.01" @bind="e.SoldeInitial" /></div>
                <div class="champ" style="flex: 0 0 170px"><label for="c-date">À la date du</label><input id="c-date" type="date" @bind="e.DateInitiale" /></div>
            </div>
            @if (e.Type != "coffre")
            {
                <label class="case"><input type="checkbox" @bind="e.RecoitCarte" /><span>Reçoit les paiements par carte (une seule banque)</span></label>
                <label class="case"><input type="checkbox" @bind="e.Actif" /><span>Compte actif</span></label>
            }
            <p class="detail" style="margin: 0">Le solde compte les mouvements à partir de cette date : indiquez le solde réel (relevé bancaire, coffre compté) à ce jour.</p>
            <div class="filtres">
                <button type="button" class="btn btn-principal" disabled="@enCours" @onclick="EnregistrerCompteAsync">Enregistrer</button>
                <button type="button" class="btn" @onclick="() => edition = null">Annuler</button>
            </div>
        </section>
    }

    <div class="colonnes">
        <!-- Argent à verser -->
        <section class="panneau colonne-laterale" aria-labelledby="t-averser">
            <h2 id="t-averser">À verser</h2>

            <h3 class="sous-titre-panneau">Caisses clôturées</h3>
            @if (aVerser?.Caisses is not { Count: > 0 } caisses)
            {
                <p class="vide" style="margin: 0">Aucune caisse en attente de versement.</p>
            }
            else
            {
                @foreach (var c in caisses)
                {
                    <div class="carte" style="display: grid; gap: 6px">
                        <span><strong>@c.Poste</strong> · clôturée le @Libelles.DateHeureLocale(c.FermeeLe)<br /><span class="detail">ouverte par @c.OuvertePar · comptée @Libelles.Dinars(c.Compte, 2)</span></span>
                        <div class="achats-ligne" style="align-items: flex-end">
                            <div class="champ" style="flex: 0 0 150px"><label for="@($"v-{c.SessionId}")">Versé (DA)</label>
                                <input id="@($"v-{c.SessionId}")" type="number" min="0.01" step="0.01" value="@Versement(c)" @onchange="ev => versements[c.SessionId] = Nombre(ev)" /></div>
                            <button type="button" class="btn" disabled="@enCours" @onclick="() => VerserAsync(c)">Verser au coffre</button>
                        </div>
                    </div>
                }
                <p class="detail" style="margin: 0">Proposé : le compté moins le fond de caisse qui reste dans le tiroir.</p>
            }

            <h3 class="sous-titre-panneau">Caisse de ce poste</h3>
            <div class="achats-ligne" style="align-items: flex-end">
                <div class="champ" style="flex: 0 0 150px"><label for="v-poste">Montant (DA)</label><input id="v-poste" type="number" min="0.01" step="0.01" @bind="prelevement" /></div>
                <button type="button" class="btn" disabled="@(enCours || prelevement <= 0)" @onclick="PreleverAsync">Porter au coffre</button>
            </div>
            <p class="detail" style="margin: 0">Pendant la journée : l’argent sort du tiroir ouvert de « @Config.Poste », son attendu de clôture diminue d’autant.</p>

            <h3 class="sous-titre-panneau">Chèques à remettre en banque</h3>
            @if (aVerser?.Cheques is not { Count: > 0 } cheques)
            {
                <p class="vide" style="margin: 0">Aucun chèque en attente.</p>
            }
            else
            {
                @foreach (var q in cheques)
                {
                    <label class="case">
                        <input type="checkbox" checked="@chequesChoisis.Contains(q.PaiementId)" @onchange="ev => Cocher(q.PaiementId, ev)" />
                        <span>@Libelles.Dinars(q.Montant, 2) · @q.Origine@(q.Patient is { } p ? $" · {p}" : "") <span class="detail">(@Libelles.DateHeureLocale(q.Date))</span></span>
                    </label>
                }
                <div class="achats-ligne" style="align-items: flex-end">
                    <div class="champ" style="flex: 1 1 150px">
                        <label for="q-banque">Banque</label>
                        <select id="q-banque" @bind="banqueRemise">
                            @foreach (var b in Banques) { <option value="@b.Id">@b.Nom</option> }
                        </select>
                    </div>
                    <div class="champ" style="flex: 1 1 120px"><label for="q-ref">N° du bordereau de remise</label><input id="q-ref" type="text" @bind="referenceRemise" /></div>
                </div>
                <button type="button" class="btn" disabled="@(enCours || chequesChoisis.Count == 0 || !Banques.Any())" @onclick="RemettreAsync">
                    Remettre @chequesChoisis.Count chèque(s) · @Libelles.Dinars(cheques.Where(q => chequesChoisis.Contains(q.PaiementId)).Sum(q => q.Montant), 2)
                </button>
                @if (!Banques.Any()) { <p class="detail" style="margin: 0">Ajoutez d’abord une banque.</p> }
            }
        </section>

        <!-- Saisie d'un mouvement -->
        <section class="panneau colonne-principale" aria-labelledby="t-saisie">
            <h2 id="t-saisie">Saisir un mouvement</h2>
            <div class="filtres" role="tablist" aria-label="Type de mouvement">
                @foreach (var (code, libelle) in Types)
                {
                    <button type="button" role="tab" class="puce" aria-selected="@(nature == code ? "true" : "false")" aria-pressed="@(nature == code ? "true" : "false")"
                            @onclick="() => nature = code">@libelle</button>
                }
            </div>
            <div class="achats-ligne">
                @if (nature == "transfert")
                {
                    <div class="champ" style="flex: 1 1 170px"><label for="m-de" class="requis">De</label>
                        <select id="m-de" @bind="compteDe">@foreach (var c in Actifs) { <option value="@c.Id">@c.Nom (@Libelles.Dinars(c.Solde))</option> }</select></div>
                    <div class="champ" style="flex: 1 1 170px"><label for="m-vers" class="requis">Vers</label>
                        <select id="m-vers" @bind="compteVers">@foreach (var c in Actifs) { <option value="@c.Id">@c.Nom</option> }</select></div>
                }
                else
                {
                    <div class="champ" style="flex: 1 1 170px"><label for="m-compte" class="requis">@(nature == "depense" ? "Payé depuis" : "Versé sur")</label>
                        <select id="m-compte" @bind="compteSaisie">@foreach (var c in Actifs) { <option value="@c.Id">@c.Nom (@Libelles.Dinars(c.Solde))</option> }</select></div>
                }
                <div class="champ" style="flex: 0 0 160px"><label for="m-date" class="requis">Date</label><input id="m-date" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="dateSaisie" /></div>
                <div class="champ" style="flex: 0 0 160px"><label for="m-montant" class="requis">Montant (DA)</label><input id="m-montant" type="number" min="0.01" step="0.01" @bind="montant" /></div>
            </div>
            @if (nature == "depense")
            {
                <div class="champ"><label for="m-cat" class="requis">Catégorie</label>
                    <select id="m-cat" @bind="categorie"><option value="">— choisir —</option>@foreach (var c in categories) { <option value="@c.Code">@c.Libelle</option> }</select></div>
            }
            @if (nature == "versement_organisme")
            {
                <div class="achats-ligne">
                    <div class="champ" style="flex: 0 0 160px"><label for="m-org" class="requis">Organisme</label>
                        <select id="m-org" @bind="organismeId" @bind:after="() => bordereauId = 0"><option value="0">— choisir —</option>@foreach (var o in organismes) { <option value="@o.Id">@o.Code</option> }</select></div>
                    <div class="champ" style="flex: 1 1 220px"><label for="m-bord">Bordereau payé (facultatif)</label>
                        <select id="m-bord" @bind="bordereauId" @bind:after="ProposerMontantBordereau">
                            <option value="0">— aucun —</option>
                            @foreach (var b in (aVerser?.Bordereaux ?? []).Where(b => b.OrganismeId == organismeId)) { <option value="@b.Id">@b.Numero · @Libelles.Dinars(b.Montant, 2)</option> }
                        </select></div>
                    @if (bordereauId > 0)
                    {
                        <div class="champ" style="flex: 0 0 180px"><label for="m-statut">Bordereau</label>
                            <select id="m-statut" @bind="statutBordereau"><option value="paye">Payé en entier</option><option value="rejet_partiel">Rejet partiel</option></select></div>
                    }
                </div>
            }
            @if (nature != "transfert")
            {
                <div class="champ"><label for="m-lib" class="@(nature == "versement_organisme" ? null : "requis")">Libellé</label>
                    <input id="m-lib" type="text" maxlength="200" @bind="libelle" placeholder="@(nature == "depense" ? "Ex. Facture Sonelgaz octobre" : nature == "encaissement" ? "Ex. Apport du titulaire" : "Facultatif : « Versement CNAS » par défaut")" /></div>
            }
            @if (nature is "encaissement" or "versement_organisme" && FacturesProposees.Any())
            {
                <fieldset class="champ" style="border: 0; padding: 0; margin: 0">
                    <legend class="etiquette-champ">Factures soldées par cette entrée (facultatif, imputées dans l’ordre)</legend>
                    @foreach (var f in FacturesProposees)
                    {
                        <label class="case"><input type="checkbox" checked="@facturesChoisies.Contains(f.Id)" @onchange="e => CocherFacture(f, e)" />
                            <span>@f.Numero · @f.DestinataireNom · reste @Libelles.Dinars(f.Reste, 2)</span></label>
                    }
                </fieldset>
            }
            <div class="champ"><label for="m-ref">Référence (n° de chèque, de virement, de pièce)</label><input id="m-ref" type="text" maxlength="100" @bind="reference" /></div>
            <div><button type="button" class="btn btn-principal" disabled="@enCours" @onclick="SaisirAsync">Enregistrer</button></div>
        </section>
    </div>

    <!-- Mouvements du compte choisi -->
    @if (comptes.FirstOrDefault(c => c.Id == compteVu) is { } vu)
    {
        <section class="panneau" aria-labelledby="t-mouvements">
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px">
                <h2 id="t-mouvements">Mouvements · @vu.Nom</h2>
                <div class="achats-ligne" style="align-items: flex-end">
                    <div class="champ" style="flex: 0 0 160px"><label for="p-du">Du</label><input id="p-du" type="date" @bind="du" @bind:after="ChargerMouvementsAsync" /></div>
                    <div class="champ" style="flex: 0 0 160px"><label for="p-au">Au</label><input id="p-au" type="date" @bind="au" @bind:after="ChargerMouvementsAsync" /></div>
                </div>
            </div>
            <div class="tableau-cadre">
                <table class="tableau">
                    <thead><tr><th scope="col">Date</th><th scope="col">Libellé</th><th scope="col">Type</th><th scope="col" class="nombre">Entrée</th><th scope="col" class="nombre">Sortie</th><th scope="col">Référence</th><th scope="col">Employé</th></tr></thead>
                    <tbody>
                        @foreach (var m in mouvements)
                        {
                            <tr>
                                <td style="white-space: nowrap">@m.Date.ToString("dd/MM/yyyy")</td>
                                <td>@m.Libelle</td>
                                <td>@Nature(m)@(m.Origine == "calcule" ? " · auto" : "")</td>
                                <td class="nombre" style="white-space: nowrap">@(m.Sens == "entree" ? Libelles.Dinars(m.Montant, 2) : "")</td>
                                <td class="nombre" style="white-space: nowrap">@(m.Sens == "sortie" ? Libelles.Dinars(m.Montant, 2) : "")</td>
                                <td>@(m.Reference ?? "—")</td>
                                <td>@(m.Employe ?? "—")</td>
                            </tr>
                        }
                        @if (mouvements.Count == 0) { <tr><td colspan="7" class="vide">Aucun mouvement sur la période.</td></tr> }
                    </tbody>
                    @if (mouvements.Count > 0)
                    {
                        <tfoot><tr><th scope="row" colspan="3">Total de la période</th>
                            <td class="nombre"><strong>@Libelles.Dinars(mouvements.Where(m => m.Sens == "entree").Sum(m => m.Montant), 2)</strong></td>
                            <td class="nombre"><strong>@Libelles.Dinars(mouvements.Where(m => m.Sens == "sortie").Sum(m => m.Montant), 2)</strong></td>
                            <td colspan="2"></td></tr></tfoot>
                    }
                </table>
            </div>
            <p class="detail" style="margin: 0">« auto » : calculé sans saisie (paiements par carte du jour, remises de chèques, règlements des grossistes, remboursements par carte).</p>
        </section>
    }
</div>

@code {
    private sealed class EditionCompte
    {
        public long? Id { get; init; }
        public string Type { get; init; } = "banque";
        public string Nom { get; set; } = "";
        public string? Banque { get; set; }
        public string? NumeroCompte { get; set; }
        public bool RecoitCarte { get; set; }
        public bool Actif { get; set; } = true;
        public decimal SoldeInitial { get; set; }
        public DateOnly DateInitiale { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }

    private static readonly (string, string)[] Types =
        [("depense", "Dépense"), ("encaissement", "Encaissement divers"), ("versement_organisme", "Versement d’un organisme"), ("transfert", "Transfert entre comptes")];

    private List<CompteTresorerieDto> comptes = [];
    private List<CodeLibelleDto> categories = [];
    private List<OrganismeDto> organismes = [];
    private List<MouvementTresorerieDto> mouvements = [];
    private AVerserDto? aVerser;
    private EditionCompte? edition;
    private readonly Dictionary<long, decimal> versements = [];
    private readonly HashSet<long> chequesChoisis = [];
    private List<FactureResumeDto> facturesOuvertes = [];
    private readonly List<long> facturesChoisies = [];
    // Versement d'organisme : ses factures ; encaissement divers : factures des patients et entreprises
    private IEnumerable<FactureResumeDto> FacturesProposees => nature == "versement_organisme"
        ? facturesOuvertes.Where(f => f.OrganismeId == organismeId && organismeId > 0)
        : facturesOuvertes.Where(f => f.Destinataire != "organisme");

    private void CocherFacture(FactureResumeDto f, ChangeEventArgs e)
    {
        facturesChoisies.Remove(f.Id);
        if (e.Value is true) facturesChoisies.Add(f.Id);
        if (montant <= 0) montant = facturesOuvertes.Where(x => facturesChoisies.Contains(x.Id)).Sum(x => x.Reste);
    }
    private string nature = "depense", statutBordereau = "paye";
    private string? categorie, libelle, reference, referenceRemise, erreur, message;
    private long compteSaisie, compteDe, compteVers, organismeId, bordereauId, banqueRemise, compteVu;
    private decimal montant, prelevement;
    private DateOnly dateSaisie = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly du = new(DateTime.Today.Year, DateTime.Today.Month, 1), au = DateOnly.FromDateTime(DateTime.Today);
    private bool enCours;

    private IEnumerable<CompteTresorerieDto> Actifs => comptes.Where(c => c.Actif);
    private IEnumerable<CompteTresorerieDto> Banques => comptes.Where(c => c.Actif && c.Type == "banque");

    protected override async Task OnInitializedAsync()
    {
        // Listes indépendantes chargées en même temps
        var cat = Api.CategoriesDepensesAsync();
        var org = Api.OrganismesAsync();
        var charge = ChargerAsync();
        (categories, _) = await cat;
        (organismes, _) = await org;
        await charge;
        compteVu = comptes.FirstOrDefault()?.Id ?? 0;
        await ChargerMouvementsAsync();
    }

    private async Task ChargerAsync()
    {
        string? e1, e2;
        var tComptes = Api.ComptesTresorerieAsync();
        var tAVerser = Api.AVerserAsync();
        var tFactures = Api.FacturesAsync(null, null, "a_encaisser", null, null);
        (comptes, e1) = await tComptes;
        (aVerser, e2) = await tAVerser;
        erreur ??= e1 ?? e2;
        var actifs = Actifs.ToList();
        if (!actifs.Any(c => c.Id == compteSaisie)) compteSaisie = actifs.FirstOrDefault()?.Id ?? 0;
        if (!actifs.Any(c => c.Id == compteDe)) compteDe = actifs.FirstOrDefault(c => c.Type == "coffre")?.Id ?? 0;
        if (!actifs.Any(c => c.Id == compteVers) || compteVers == compteDe) compteVers = actifs.FirstOrDefault(c => c.Id != compteDe)?.Id ?? 0;
        if (!Banques.Any(b => b.Id == banqueRemise)) banqueRemise = Banques.FirstOrDefault(b => b.RecoitCarte)?.Id ?? Banques.FirstOrDefault()?.Id ?? 0;
        chequesChoisis.IntersectWith(aVerser?.Cheques.Select(q => q.PaiementId) ?? []);
        // Factures à encaisser (droit factures.gerer : sans lui, la liste reste vide)
        (facturesOuvertes, _) = await tFactures;
        facturesChoisies.RemoveAll(id => facturesOuvertes.All(f => f.Id != id));
    }

    private async Task ChargerMouvementsAsync()
    {
        if (compteVu == 0) return;
        string? e;
        (mouvements, e) = await Api.MouvementsTresorerieAsync(compteVu, du, au);
        erreur ??= e;
    }

    private async Task VoirAsync(long id) { compteVu = id; await ChargerMouvementsAsync(); }

    private void NouvelleBanque() => edition = new EditionCompte { RecoitCarte = !comptes.Any(c => c.RecoitCarte) };

    private void Modifier(CompteTresorerieDto c) => edition = new EditionCompte
    {
        Id = c.Id, Type = c.Type, Nom = c.Nom, Banque = c.Banque, NumeroCompte = c.NumeroCompte, RecoitCarte = c.RecoitCarte,
        Actif = c.Actif, SoldeInitial = c.SoldeInitial, DateInitiale = c.DateInitiale
    };

    private async Task EnregistrerCompteAsync()
    {
        if (edition is not { } e) return;
        await Executer(() => Api.EnregistrerCompteTresorerieAsync(e.Id, new CompteTresorerieRequete(e.Nom, e.Banque, e.NumeroCompte, e.RecoitCarte, e.SoldeInitial, e.DateInitiale, e.Actif)),
            $"Compte « {e.Nom} » enregistré.");
        if (erreur is null) edition = null;
    }

    private decimal Versement(CaisseAVerserDto c) => versements.TryGetValue(c.SessionId, out var v) ? v : c.Propose;

    private Task VerserAsync(CaisseAVerserDto c)
    {
        var m = Versement(c);
        return Executer(() => Api.VerserCaisseClotureeAsync(c.SessionId, m), $"{Libelles.Dinars(m, 2)} de « {c.Poste} » portés au coffre.");
    }

    private Task PreleverAsync()
    {
        var m = prelevement;
        return Executer(async () => { var e = await Api.VerserCaisseDuPosteAsync(m); if (e is null) prelevement = 0; return e; },
            $"{Libelles.Dinars(m, 2)} portés du tiroir au coffre.");
    }

    private void Cocher(long id, ChangeEventArgs e) { if (e.Value is true) chequesChoisis.Add(id); else chequesChoisis.Remove(id); }

    private Task RemettreAsync()
    {
        var n = chequesChoisis.Count;
        return Executer(async () =>
        {
            var e = await Api.RemettreChequesAsync(new RemiseChequesRequete(banqueRemise, null, referenceRemise, chequesChoisis.ToList()));
            if (e is null) { chequesChoisis.Clear(); referenceRemise = null; }
            return e;
        }, $"{n} chèque(s) remis en banque.");
    }

    private void ProposerMontantBordereau()
    {
        if ((aVerser?.Bordereaux ?? []).FirstOrDefault(b => b.Id == bordereauId) is { } b && montant <= 0) montant = b.Montant;
    }

    private Task SaisirAsync()
    {
        var m = montant;
        Func<Task<string?>> action = nature == "transfert"
            ? () => Api.TransfererAsync(new TransfertRequete(compteDe, compteVers, dateSaisie, m, reference))
            : () => Api.SaisirMouvementTresorerieAsync(new MouvementTresorerieRequete(compteSaisie, dateSaisie, nature, m,
                nature == "depense" && !string.IsNullOrEmpty(categorie) ? categorie : null, libelle, reference,
                organismeId > 0 ? organismeId : null, bordereauId > 0 ? bordereauId : null, bordereauId > 0 ? statutBordereau : null,
                FacturesProposees.Where(f => facturesChoisies.Contains(f.Id)).Select(f => f.Id).ToList()));
        return Executer(async () =>
        {
            var e = await action();
            if (e is null) { (montant, libelle, reference, bordereauId) = (0, null, null, 0); facturesChoisies.Clear(); }
            return e;
        }, $"{Types.First(t => t.Item1 == nature).Item2} de {Libelles.Dinars(m, 2)} enregistré(e).");
    }

    private async Task Executer(Func<Task<string?>> action, string succes)
    {
        (enCours, erreur, message) = (true, null, null);
        var e = await action();
        enCours = false;
        if (e is not null) { erreur = e; return; }
        message = succes;
        await ChargerAsync();
        await ChargerMouvementsAsync();
    }

    private string Nature(MouvementTresorerieDto m) => m.Nature switch
    {
        "depense" => categories.FirstOrDefault(c => c.Code == m.Categorie)?.Libelle ?? "Dépense",
        "encaissement" => "Encaissement divers",
        "versement_organisme" => "Versement d’un organisme",
        "transfert" => "Transfert",
        "versement_caisse" => "Versement de caisse",
        "carte" => "Paiements par carte",
        "remise_cheques" => "Remise de chèques",
        "reglement_grossiste" => "Règlement grossiste",
        "remboursement_carte" => "Remboursement par carte",
        _ => m.Nature
    };

    private static decimal Nombre(ChangeEventArgs e) =>
        decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0;
}
