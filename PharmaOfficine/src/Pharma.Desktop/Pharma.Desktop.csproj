<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Version de Windows explicite : WebView2 a besoin de Microsoft.Windows.SDK.NET (Windows 10 2004 minimum) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pharma.Desktop</RootNamespace>
    <!-- Icône de l'exécutable et de la fenêtre : croix verte avec coupe d'Hygie -->
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pharma.Shared\Pharma.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="logo.ico" />
  </ItemGroup>
</Project>
