# Modèle de deploy/demo/.env (démo cloud, étape 1 : docs/demo-cloud.md).
# Copier en deploy/demo/.env (fichier ignoré par git) et remplacer CHAQUE valeur A-REMPLACER.
# Une clé JWT laissée à A-REMPLACER fait refuser le démarrage de l'API (voulu).
#
# Génération (PowerShell), une valeur différente pour chaque ligne :
#   $o = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($o); -join ($o | ForEach-Object { $_.ToString('x2') })
# (96 caractères hexadécimaux : pas de « ; » ni de guillemet, qui casseraient la chaîne de connexion)

# Superutilisateur PostgreSQL du conteneur db
POSTGRES_MDP=A-REMPLACER-mot-de-passe-postgres

# Compte applicatif pharma_app (propriétaire de la base pharmacie_demo, utilisé par l'API)
PHARMA_APP_MDP=A-REMPLACER-mot-de-passe-pharma-app

# Clé de signature des jetons : 64 caractères au moins
JWT_CLE=A-REMPLACER-cle-jwt-aleatoire-de-64-caracteres-minimum

# Port de l'API sur le PC (lié à 127.0.0.1). 5080 = port de l'API de développement : en changer si elle tourne.
PORT_API_DEMO=5080

# Heure de la remise à zéro quotidienne de la base de démonstration (service reinit, fuseau Africa/Algiers), format HH:MM
REINIT_HEURE=04:00
