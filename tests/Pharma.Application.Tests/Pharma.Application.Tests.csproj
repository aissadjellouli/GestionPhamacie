    <Compile Include="..\..\src\Pharma.Desktop\Services\PanierBascule.cs" Link="Poste\PanierBascule.cs" />
    <Compile Include="..\..\src\Pharma.Desktop\Services\VigiePoste.cs" Link="Poste\VigiePoste.cs" />
    <Compile Include="..\..\src\Pharma.Desktop\Services\CreationCleAdministrateur.cs" Link="Poste\CreationCleAdministrateur.cs" />
